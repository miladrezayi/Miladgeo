  function applyTheme(t){
    document.documentElement.style.setProperty('--mg-user-bg',t.bg);document.documentElement.style.setProperty('--mg-user-btn',t.btn);document.documentElement.style.setProperty('--mg-user-btn-border',t.border);document.documentElement.style.setProperty('--mg-user-btn-text',t.text||'#ffffff');
    main.style.backgroundColor=t.bg;if(t.bgImage)main.style.backgroundImage=t.bgImage;else main.style.removeProperty('background-image');
    try{localStorage.setItem('miladgeo-main-theme-399',t.id)}catch(e){}
    Array.prototype.slice.call(panel.querySelectorAll('.mg-theme-choice')).forEach(function(b){b.setAttribute('aria-pressed',b.getAttribute('data-theme')===t.id?'true':'false')});
    panel.classList.remove('open');
  }
  themes.forEach(function(t){var b=document.createElement('button');b.type='button';b.className='mg-theme-choice';b.setAttribute('data-theme',t.id);b.setAttribute('aria-pressed','false');var dot=document.createElement('span');dot.className='mg-theme-dot';dot.style.background=t.btn;if(t.btnImage)dot.style.backgroundImage=t.btnImage;var label=document.createElement('span');label.textContent=t.label;b.appendChild(dot);b.appendChild(label);b.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();applyTheme(t)});panel.appendChild(b)});
  /* X4: font and size controls live inside the existing settings panel. */
  var fontHeading=document.createElement('div');fontHeading.className='mg-theme-heading';fontHeading.textContent='قلم فارسی';panel.appendChild(fontHeading);
  var fontChoices=[
    {id:'kufi',label:'نوتو سنس عربی (فارسی)'},
    {id:'vazirbold',label:'وزیرمتن ضخیم'},
    {id:'estedad',label:'استعداد'},
    {id:'estedadneon',label:'استعداد نئونی'},
    {id:'handwrite',label:'دست‌نویس'},
    {id:'tahoma',label:'قلم پیش‌فرض گوشی'}
  ];
  function applyFont(id){if(id==='vazir')id='vazirbold';if(id==='naskh')id='estedad';if(!fontChoices.some(function(x){return x.id===id}))id='tahoma';document.documentElement.setAttribute('data-mg-font',id);try{localStorage.setItem('miladgeo-font-choice-x4',id)}catch(e){}panel.querySelectorAll('.mg-font-choice').forEach(function(b){b.setAttribute('aria-pressed',b.getAttribute('data-font')===id?'true':'false')});}
  fontChoices.forEach(function(f){var b=document.createElement('button');b.type='button';b.className='mg-font-choice';b.textContent=f.label;b.setAttribute('data-font',f.id);b.setAttribute('aria-pressed','false');b.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();applyFont(f.id)});panel.appendChild(b)});
  var sizeHeading=document.createElement('div');sizeHeading.className='mg-theme-heading';sizeHeading.textContent='اندازه نوشته';panel.appendChild(sizeHeading);
  function applyFontSize(id){
    var valid=['normal','minus10'];
    if(!valid.includes(id)&&!/^manual-(?:-?\d+)$/.test(id))id='normal';
    if(id.indexOf('manual-')===0){var pct=parseInt(id.slice(7),10);if(!Number.isFinite(pct)||pct < -15||pct > 15)pct=0;document.documentElement.style.setProperty('--mg-manual-font-scale',String(1+pct/100));document.documentElement.style.setProperty('--mg-manual-font-base',document.documentElement.getAttribute('data-mg-font')==='estedadneon'?'16.2px':'18px');}
    document.documentElement.setAttribute('data-mg-font-size',id);try{localStorage.setItem('miladgeo-font-size-choice-x4',id)}catch(e){}panel.querySelectorAll('.mg-font-size-choice').forEach(function(b){b.setAttribute('aria-pressed',b.getAttribute('data-size')===id?'true':'false')});
  }
  [{id:'normal',label:'متن استاندارد'},{id:'minus10',label:'۱۰٪ کوچک‌تر'}].forEach(function(f){var b=document.createElement('button');b.type='button';b.className='mg-font-size-choice';b.textContent=f.label;b.setAttribute('data-size',f.id);b.setAttribute('aria-pressed','false');b.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();applyFontSize(f.id)});panel.appendChild(b)});
  var manualHeading=document.createElement('div');manualHeading.className='mg-theme-heading';manualHeading.textContent='تنظیم دستی اندازه';panel.appendChild(manualHeading);
  var manualRow=document.createElement('div');manualRow.style.cssText='grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:6px';panel.appendChild(manualRow);
  [{dir:'up',label:'افزایش +۲٪'},{dir:'down',label:'کاهش −۲٪'}].forEach(function(f){var b=document.createElement('button');b.type='button';b.className='mg-font-size-choice';b.textContent=f.label;b.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();var cur=document.documentElement.getAttribute('data-mg-font-size')||'normal';var pct=cur.indexOf('manual-')===0?parseInt(cur.slice(7),10):0;if(!Number.isFinite(pct))pct=0;pct=f.dir==='up'?Math.min(15,pct+2):Math.max(-15,pct-2);if(pct===14&&f.dir==='up')pct=15;if(pct===-14&&f.dir==='down')pct=-15;applyFontSize('manual-'+pct)});manualRow.appendChild(b)});
  var savedFont='estedadneon',savedFontSize='normal';try{savedFont=localStorage.getItem('miladgeo-font-choice-x4')||'estedadneon';savedFontSize=localStorage.getItem('miladgeo-font-size-choice-x4')||'normal'}catch(e){}applyFont(savedFont);applyFontSize(savedFontSize);
  var mgSettingsCloseTimer=null;
  gear.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();panel.classList.toggle('open');if(mgSettingsCloseTimer){clearTimeout(mgSettingsCloseTimer);mgSettingsCloseTimer=null;}if(panel.classList.contains('open')){mgSettingsCloseTimer=setTimeout(function(){panel.classList.remove('open');mgSettingsCloseTimer=null;},15000);}});
  panel.addEventListener('click',function(e){if(e.target.closest('.mg-font-choice')||e.target.closest('.mg-font-size-choice')){if(mgSettingsCloseTimer)clearTimeout(mgSettingsCloseTimer);mgSettingsCloseTimer=setTimeout(function(){panel.classList.remove('open');mgSettingsCloseTimer=null;},15000);}});
  wrap.appendChild(gear);
  var title=main.querySelector('.title');
  if(title&&title.parentNode){title.parentNode.insertBefore(wrap,title.nextSibling);title.parentNode.insertBefore(panel,wrap.nextSibling);}else{main.insertBefore(wrap,main.firstChild);main.insertBefore(panel,wrap.nextSibling);}
  var saved='fa';try{saved=localStorage.getItem('miladgeo-main-language-399')||'fa'}catch(e){}
  apply(saved);
  var chosenTheme=themes[0];try{var savedThemeId=localStorage.getItem('miladgeo-main-theme-399')||'original';chosenTheme=themes.find(function(t){return t.id===savedThemeId})||themes[0]}catch(e){}
  applyTheme(chosenTheme);
})();
</script>
<script id="m4p-root-runtime-live">
/* V444 — definitive Menu 4 runtime. No dependency on legacy menu-4 handlers. */
(function(){
'use strict';
function q(id){return document.getElementById(id)}
function fa(n){return Number(n||0).toLocaleString('fa-IR')}
function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function arr(){return Array.isArray(window.points)?window.points:[]}
function persist(){try{if(typeof saveJSON==='function')saveJSON(POINTS_KEY,window.points);else localStorage.setItem(POINTS_KEY,JSON.stringify(window.points));}catch(e){console.error('M4 persist',e)}}
function refresh(){try{if(typeof refreshPoints==='function')refreshPoints()}catch(e){}try{if(typeof updateAllUI==='function')updateAllUI()}catch(e){}try{if(typeof updateStakeSelect==='function')updateStakeSelect()}catch(e){}}

window.m4pTab=function(name){
  var tabs=document.querySelectorAll('.p4v8-tabs .v8-tab');
  for(var i=0;i<tabs.length;i++){
    var on=tabs[i].getAttribute('data-tab')===name;
    tabs[i].classList.toggle('active',on);
    tabs[i].setAttribute('aria-selected',on?'true':'false');
  }
  var panels=document.querySelectorAll('.p4v8-panel');
  for(var j=0;j<panels.length;j++){
    var show=panels[j].id==='m4p-'+name;
    panels[j].classList.toggle('active',show);
    panels[j].style.display=show?'block':'none';
  }
  if(name==='manage')window.m4pRender();
  if(name==='import')window.m4pLoadJob();
  if(name==='control'){window.m4pRenderControl();window.m4pRenderStats();}
  if(name==='output')window.m4pRenderOutput();
  return false;
};

window.m4pRender=function(){
 var a=arr(),box=q('m4pList'),search=q('m4pSearch'),term=search?String(search.value||'').trim().toLowerCase():'';
 if(q('m4pCount'))q('m4pCount').textContent=fa(a.length)+' POINT';
 if(q('pointsMenuState'))q('pointsMenuState').textContent=a.length+' POINTS';
 var f=a.filter(function(p){return !term||String(p.no||'').toLowerCase().indexOf(term)>=0||String(p.dp||'').toLowerCase().indexOf(term)>=0});
 if(!box)return;
 if(!f.length){box.innerHTML='<div class="v8-empty">'+(a.length?'نقطه‌ای با این جستجو پیدا نشد.':'هنوز نقطه‌ای ثبت نشده است.')+'</div>';return;}
 var h='<div class="p4-point-table-wrap"><table class="p4-point-table"><thead><tr><th>Point</th><th>Code</th><th>X</th><th>Y</th><th>Z</th><th>عملیات</th></tr></thead><tbody>';
 for(var i=0;i<f.length;i++){
   var p=f[i];
   h+='<tr><td><b>'+esc(p.no||'-')+'</b></td><td>'+esc(p.dp||'-')+'</td><td>'+Number(p.x||0).toFixed(3)+'</td><td>'+Number(p.y||0).toFixed(3)+'</td><td>'+Number(p.z||0).toFixed(3)+'</td><td class="p4-actions-cell"><button class="p4-mini-btn" type="button" data-edit="'+esc(p.id)+'">ویرایش</button><button class="p4-mini-btn danger" type="button" data-del="'+esc(p.id)+'">حذف</button></td></tr>';
 }
 h+='</tbody></table></div>';
 box.innerHTML=h;
 var edits=box.querySelectorAll('[data-edit]');for(i=0;i<edits.length;i++)edits[i].addEventListener('click',function(){window.m4pBeginEdit(this.getAttribute('data-edit'));});
 var dels=box.querySelectorAll('[data-del]');for(i=0;i<dels.length;i++)dels[i].addEventListener('click',function(){window.m4pDelete(this.getAttribute('data-del'));});
};
window.m4pClearSearch=function(){if(q('m4pSearch'))q('m4pSearch').value='';window.m4pRender();return false;};
window.m4pEditingId=null;
window.m4pBeginEdit=function(id){var a=arr(),p=null;for(var i=0;i<a.length;i++)if(String(a[i].id)===String(id)){p=a[i];break;}if(!p){showToast('نقطه پیدا نشد');return false;}window.m4pEditingId=p.id;q('manualPENZDNo').value=p.no||'';q('manualPENZDDP').value=p.dp||'';q('manualPENZDX').value=p.x;q('manualPENZDY').value=p.y;q('manualPENZDZ').value=p.z;var b=document.querySelector('[data-m4-save]');if(b)b.innerHTML='✓ ذخیره ویرایش';if(q('penzdInputStatus'))q('penzdInputStatus').textContent='در حال ویرایش '+(p.no||'')+' — ذخیره کن.';window.m4pTab('manage');setTimeout(function(){var e=q('manualPENZDNo');if(e&&e.scrollIntoView)e.scrollIntoView({behavior:'smooth',block:'center'});},60);return false;};
window.m4pCancelEdit=function(){window.m4pEditingId=null;var ids=['manualPENZDNo','manualPENZDDP','manualPENZDX','manualPENZDY','manualPENZDZ'];for(var i=0;i<ids.length;i++){var e=q(ids[i]);if(e)e.value='';}var b=document.querySelector('[data-m4-save]');if(b)b.innerHTML='＋ ثبت نقطه';if(q('penzdInputStatus'))q('penzdInputStatus').textContent='آماده ثبت نقطه جدید.';return false;};
window.m4pSavePoint=function(){
 var no=String(q('manualPENZDNo')?q('manualPENZDNo').value:'').trim(),dp=String(q('manualPENZDDP')?q('manualPENZDDP').value:'').trim();
 var x=parseFloat(q('manualPENZDX')?q('manualPENZDX').value:''),y=parseFloat(q('manualPENZDY')?q('manualPENZDY').value:''),z=parseFloat(q('manualPENZDZ')?q('manualPENZDZ').value:'');
 if(!no){showToast('شماره نقطه را وارد کن');return false;}if(!isFinite(x)||!isFinite(y)||!isFinite(z)){showToast('مختصات X / Y / Z را کامل وارد کن');return false;}
 var a=arr(),i,target=null;
 if(window.m4pEditingId!==null){for(i=0;i<a.length;i++)if(String(a[i].id)===String(window.m4pEditingId)){target=a[i];break;}if(!target){window.m4pEditingId=null;showToast('نقطه مورد نظر پیدا نشد');return false;}}
 for(i=0;i<a.length;i++){
   if(target&&a[i]===target)continue;
   if(String(a[i].no||'').trim().toUpperCase()===no.toUpperCase()){showToast('شماره نقطه تکراری است');return false;}
   if(Number(a[i].x).toFixed(6)===x.toFixed(6)&&Number(a[i].y).toFixed(6)===y.toFixed(6)&&Number(a[i].z).toFixed(6)===z.toFixed(6)){showToast('مختصات این نقطه تکراری است');return false;}
 }
 if(target){target.no=no;target.dp=dp;target.x=x;target.y=y;target.z=z;showToast(no+' ویرایش شد ✓');}
 else {a.push({id:Date.now()+Math.floor(Math.random()*100000),no:no,dp:dp,x:x,y:y,z:z,distance:null,azimuth:null,manual:true,penzd:true});showToast(no+' ثبت شد ✓');}
 window.points=a;persist();refresh();window.m4pEditingId=null;
 var b=document.querySelector('[data-m4-save]');if(b)b.innerHTML='＋ ثبت نقطه';
 if(q('penzdInputStatus'))q('penzdInputStatus').textContent=(target?'✓ ویرایش ذخیره شد.':'✓ '+no+' به Point List اضافه شد.');
 window.m4pRender();window.m4pRenderStats();return false;
};
window.m4pDelete=function(id){var a=arr(),idx=-1;for(var i=0;i<a.length;i++)if(String(a[i].id)===String(id)){idx=i;break;}if(idx<0){showToast('نقطه پیدا نشد');return false;}var p=a[idx];if(!confirm('نقطه '+(p.no||'')+' حذف شود؟'))return false;a.splice(idx,1);window.points=a;persist();refresh();window.m4pRender();window.m4pRenderStats();showToast((p.no||'نقطه')+' حذف شد ✓');return false;};
window.m4pLoadJob=function(){var a=arr();if(q('m4pJobImportStatus'))q('m4pJobImportStatus').textContent=a.length?'✓ '+fa(a.length)+' نقطه در JOB فعال موجود است.':'در جاب فعال نقطه‌ای وجود ندارد.';return false;};
window.m4pRenderControl=function(){var a=arr(),seenNo={},seenC={},dupNo=0,dupC=0,bad=0,empty=0;for(var i=0;i<a.length;i++){var p=a[i],n=String(p.no||'').trim().toUpperCase(),c=[Number(p.x),Number(p.y),Number(p.z)].join('|');if(!n)bad++;else if(seenNo[n])dupNo++;else seenNo[n]=1;if(seenC[c])dupC++;else seenC[c]=1;if(!isFinite(Number(p.x))||!isFinite(Number(p.y))||!isFinite(Number(p.z)))bad++;if(!String(p.dp||'').trim())empty++;}var g=q('m4pControlGrid');if(g)g.innerHTML=[['تعداد نقاط',a.length],['شماره تکراری',dupNo],['مختصات تکراری',dupC],['مختصات نامعتبر',bad],['کد خالی',empty]].map(function(x){return '<div class="v8-stat"><b>'+fa(x[1])+'</b><span>'+x[0]+'</span></div>';}).join('');var box=q('m4pControlPointScroll');if(box){if(!a.length){box.innerHTML='<div class="v8-empty">هنوز نقطه‌ای ثبت نشده است.</div>';}else{var h='<div class="m4p-control-table-wrap"><table class="m4p-control-table"><thead><tr><th>Point</th><th>Code</th><th>X</th><th>Y</th><th>Z</th></tr></thead><tbody>';for(var j=0;j<a.length;j++){var p=a[j];h+='<tr><td>'+esc(p.no||'-')+'</td><td>'+esc(p.dp||'-')+'</td><td>'+Number(p.x||0).toFixed(3)+'</td><td>'+Number(p.y||0).toFixed(3)+'</td><td>'+Number(p.z||0).toFixed(3)+'</td></tr>';}h+='</tbody></table></div>';box.innerHTML=h;}}};
window.m4pRenderStats=function(){var a=arr(),box=q('m4pStats');if(!box)return;if(!a.length){box.innerHTML='<div class="p4-empty">اطلاعات آماری پس از ورود نقاط نمایش داده می‌شود.</div>';return;}function mn(k){return Math.min.apply(null,a.map(function(p){return Number(p[k])}))}function mx(k){return Math.max.apply(null,a.map(function(p){return Number(p[k])}))}box.innerHTML=[['X min',mn('x').toFixed(3)],['X max',mx('x').toFixed(3)],['Y min',mn('y').toFixed(3)],['Y max',mx('y').toFixed(3)],['Z min',mn('z').toFixed(3)],['Z max',mx('z').toFixed(3)]].map(function(x){return '<div class="p4-stat"><b>'+x[1]+'</b><span>'+x[0]+'</span></div>'}).join('');};
window.m4pRunControl=function(){window.m4pRenderControl();window.m4pRenderStats();if(q('m4pControlResult'))q('m4pControlResult').innerHTML='✓ کنترل نقاط انجام شد.';return false;};
window.m4pRenderOutput=function(){var out=q('m4pOutputStatus');if(out)out.textContent=arr().length?'✓ '+fa(arr().length)+' نقطه آماده خروجی است.':'هنوز نقطه‌ای برای خروجی وجود ندارد.';};
window.m4pExportCSV=function(){var a=arr();if(!a.length){showToast('هنوز نقطه‌ای ثبت نشده است');return false;}var s='Point,Easting,Northing,Elevation,Description\r\n'+a.map(function(p){return [p.no,p.x,p.y,p.z,p.dp||''].map(function(v){return '"'+String(v==null?'':v).replace(/"/g,'""')+'"'}).join(',')}).join('\r\n');saveBlobLikeMenu17(sanitizeFileName(job.name)+'_POINTS.csv',new Blob(['\ufeff'+s],{type:'text/csv;charset=utf-8'}));showToast('CSV آماده شد ✓');return false;};
window.m4pExportTXT=function(){return typeof exportCodeTXT==='function'?exportCodeTXT():false;};
window.m4pExportExcel=function(){return typeof exportPointsXLSX==='function'?exportPointsXLSX():false;};
window.m4pExportPDF=function(){return typeof window.printPointsPDF==='function'?window.printPointsPDF():miladgeoPointListPDF();};
window.m4pExportDXF=function(){return typeof exportDXF==='function'?exportDXF():false;};
window.m4pExportKML=function(){return typeof exportKML==='function'?exportKML():false;};

/* Make tabs reliable even if an older runtime installed competing handlers. */
function bindTabs(){var tabs=document.querySelectorAll('.p4v8-tabs .v8-tab');for(var i=0;i<tabs.length;i++){(function(b){b.onclick=function(e){if(e)e.preventDefault();window.m4pTab(b.getAttribute('data-tab'));return false;};})(tabs[i]);}}
window.addEventListener('load',function(){bindTabs();window.m4pTab('manage');window.m4pRender();window.m4pRenderControl();window.m4pRenderStats();window.m4pRenderOutput();});
})();
</script>
<style id="m4-v450-fixes">
#points #m4p-import{overflow:hidden!important;min-width:0}
#points #v5ImportPreview{display:block!important;width:100%!important;max-width:none!important;box-sizing:border-box!important;overflow-x:auto!important;overflow-y:auto!important;white-space:pre!important;word-break:normal!important;overflow-wrap:normal!important;direction:ltr!important;-webkit-overflow-scrolling:touch!important}
#points .p4v8-preview{min-width:680px!important;width:max-content!important}
#points .p4v8-list{overflow-x:auto!important;overflow-y:auto!important;max-width:100%!important}
#points .p4-point-table-wrap{width:100%!important;max-width:100%!important;overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch!important}
#points .p4-point-table{min-width:590px!important;width:max-content!important}
#points .p4-point-table th,#points .p4-point-table td{white-space:nowrap!important;word-break:normal!important;overflow-wrap:normal!important}

/* V451: reliable horizontal scroll + visible point list in Control */
#points .m4p-import-preview-scroll{width:100%!important;max-width:100%!important;overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch!important;overscroll-behavior-x:contain!important;border-radius:10px}
#points .m4p-import-preview-scroll #v5ImportPreview{display:block!important;width:max-content!important;min-width:900px!important;max-width:none!important;box-sizing:border-box!important;margin:0!important;overflow:visible!important;white-space:pre!important;word-break:normal!important;overflow-wrap:normal!important;direction:ltr!important}
#points .m4p-control-point-scroll{width:100%!important;max-width:100%!important;overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch!important;overscroll-behavior-x:contain!important}
#points .m4p-control-table-wrap{min-width:100%!important;width:max-content!important}
#points .m4p-control-table{min-width:680px!important;border-collapse:collapse;width:max-content!important;font-size:12px;background:#f7faf6}
#points .m4p-control-table th,#points .m4p-control-table td{border:1px solid #8a9488;padding:7px 9px;text-align:center;white-space:nowrap}
#points .m4p-control-table th{background:#dfe7dc;font-weight:900}
</style>
<script id="m4-v450-runtime">
(function(){
'use strict';
function q(id){return document.getElementById(id)}
function A(){return Array.isArray(window.points)?window.points:[]}
function save(){try{if(typeof saveJSON==='function')saveJSON(POINTS_KEY,window.points);else localStorage.setItem(POINTS_KEY,JSON.stringify(window.points));}catch(e){console.error(e)}}
function redraw(){try{window.m4pRender&&window.m4pRender()}catch(e){}try{window.m4pRenderControl&&window.m4pRenderControl()}catch(e){}try{window.m4pRenderStats&&window.m4pRenderStats()}catch(e){}try{window.m4pRenderOutput&&window.m4pRenderOutput()}catch(e){}try{typeof refreshPoints==='function'&&refreshPoints()}catch(e){}try{typeof updateAllUI==='function'&&updateAllUI()}catch(e){}}
function findNo(no){var a=A();for(var i=0;i<a.length;i++)if(String(a[i].no||'').trim().toUpperCase()===String(no||'').trim().toUpperCase())return a[i];return null}
window.m4pOpRenumber=function(){var old=prompt('شماره فعلی نقطه را وارد کن:');if(old===null)return false;var p=findNo(old);if(!p){showToast('نقطه پیدا نشد');return false;}var n=prompt('شماره جدید را وارد کن:',p.no||'');if(n===null)return false;n=String(n).trim();if(!n){showToast('شماره جدید خالی است');return false;}var dup=findNo(n);if(dup&&dup!==p){showToast('شماره جدید تکراری است');return false;}p.no=n;save();redraw();showToast('شماره نقطه تغییر کرد ✓');return false;};
window.m4pOpCode=function(){var no=prompt('شماره نقطه را وارد کن:');if(no===null)return false;var p=findNo(no);if(!p){showToast('نقطه پیدا نشد');return false;}var code=prompt('کد / DP جدید:',p.dp||'');if(code===null)return false;p.dp=String(code).trim();save();redraw();showToast('کد نقطه تغییر کرد ✓');return false;};
window.m4pOpTranslate=function(){var dx=parseFloat(prompt('مقدار انتقال X را وارد کن:','0'));if(!isFinite(dx)){showToast('مقدار X نامعتبر است');return false;}var dy=parseFloat(prompt('مقدار انتقال Y را وارد کن:','0'));if(!isFinite(dy)){showToast('مقدار Y نامعتبر است');return false;}var dz=parseFloat(prompt('مقدار انتقال Z را وارد کن:','0'));if(!isFinite(dz)){showToast('مقدار Z نامعتبر است');return false;}var a=A();if(!a.length){showToast('هنوز نقطه‌ای وجود ندارد');return false;}if(!confirm('انتقال همه '+a.length+' نقطه انجام شود؟'))return false;for(var i=0;i<a.length;i++){a[i].x=Number(a[i].x)+dx;a[i].y=Number(a[i].y)+dy;a[i].z=Number(a[i].z)+dz;}window.points=a;save();redraw();showToast('انتقال مختصات انجام شد ✓');return false;};
})();
</script>
<style id="m4-v452-control-fix">
#points .m4p-control-point-scroll{display:block!important;width:100%!important;max-width:100%!important;overflow-x:auto!important;overflow-y:auto!important;-webkit-overflow-scrolling:touch!important}
#points .m4p-control-table-wrap{display:block!important;width:max-content!important;min-width:100%!important}
#points .m4p-control-table{display:table!important;width:max-content!important;min-width:720px!important;border-collapse:collapse!important}
</style>
<script id="m4-v452-control-fix">
(function(){
'use strict';
function q(id){return document.getElementById(id)}
function mainPoints(){
  try{if(typeof points!=='undefined' && Array.isArray(points))return points;}catch(e){}
  return Array.isArray(window.points)?window.points:[];
}
function fa(n){return Number(n||0).toLocaleString('fa-IR')}
function esc2(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
window.m4pRenderControl=function(){
  var a=mainPoints(),seenNo={},seenC={},dupNo=0,dupC=0,bad=0,empty=0;
  for(var i=0;i<a.length;i++){
    var p=a[i],n=String(p.no||'').trim().toUpperCase();
    var c=[Number(p.x),Number(p.y),Number(p.z)].join('|');
    if(!n)bad++;else if(seenNo[n])dupNo++;else seenNo[n]=1;
    if(seenC[c])dupC++;else seenC[c]=1;
    if(!isFinite(Number(p.x))||!isFinite(Number(p.y))||!isFinite(Number(p.z)))bad++;
    if(!String(p.dp||'').trim())empty++;
  }
  var g=q('m4pControlGrid');
  if(g)g.innerHTML=[['تعداد نقاط',a.length],['شماره تکراری',dupNo],['مختصات تکراری',dupC],['مختصات نامعتبر',bad],['کد خالی',empty]].map(function(x){return '<div class="v8-stat"><b>'+fa(x[1])+'</b><span>'+x[0]+'</span></div>';}).join('');
  var box=q('m4pControlPointScroll');
  if(!box)return;
  if(!a.length){box.innerHTML='<div class="v8-empty">هنوز نقطه‌ای ثبت نشده است.</div>';return;}
  var h='<div class="m4p-control-table-wrap"><table class="m4p-control-table"><thead><tr><th>Point</th><th>Code</th><th>X</th><th>Y</th><th>Z</th></tr></thead><tbody>';
  for(var j=0;j<a.length;j++){
    var p2=a[j];
    h+='<tr><td>'+esc2(p2.no||'-')+'</td><td>'+esc2(p2.dp||'-')+'</td><td>'+Number(p2.x||0).toFixed(3)+'</td><td>'+Number(p2.y||0).toFixed(3)+'</td><td>'+Number(p2.z||0).toFixed(3)+'</td></tr>';
  }
  h+='</tbody></table></div>';box.innerHTML=h;
};
window.m4pRunControl=function(){window.m4pRenderControl();if(window.m4pRenderStats)window.m4pRenderStats();var r=q('m4pControlResult');if(r)r.innerHTML='✓ کنترل نقاط انجام شد — '+fa(mainPoints().length)+' نقطه بررسی شد.';return false;};
window.addEventListener('load',function(){setTimeout(function(){window.m4pRenderControl&&window.m4pRenderControl();},80);});
})();
</script>
<script id="miladgeo-menu11-v2-runtime">

function m11v2EnsureXLSX(done){
  if(window.XLSX && window.XLSX.read && window.XLSX.utils){done(window.XLSX);return;}
  var old=document.getElementById('m11v2XlsxLoader');
  if(old){
    old.addEventListener('load',function(){done(window.XLSX||null)},{once:true});
    old.addEventListener('error',function(){done(null)},{once:true});
    return;
  }
  var sc=document.createElement('script');
  sc.id='m11v2XlsxLoader';
  sc.src='https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';
  sc.onload=function(){done(window.XLSX||null)};
  sc.onerror=function(){done(null)};
  document.head.appendChild(sc);
}
function m11v2NoXlsx(){m11v2Msg('m11v2ListStatus','موتور Excel در دسترس نیست. اتصال اینترنت را بررسی کن و دوباره فایل را انتخاب کن.');}


(function(){
'use strict';
var M={manual:[],list:[],headers:[],listRows:[],kml:[]};
function q(id){return document.getElementById(id)}
function n(v){var x=parseFloat(v);return Number.isFinite(x)?x:NaN}
function z(v){var x=parseInt(v,10);return Number.isInteger(x)&&x>=1&&x<=60?x:NaN}
function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function m11CogoTab(mode){
 var inv=q('m11CogoInv'),fwd=q('m11CogoFwd'),bi=q('m11cogoTabInv'),bf=q('m11cogoTabFwd');
 if(inv)inv.classList.toggle('active',mode==='inv'); if(fwd)fwd.classList.toggle('active',mode==='fwd');
 if(bi)bi.classList.toggle('active',mode==='inv'); if(bf)bf.classList.toggle('active',mode==='fwd');
}
function m11CogoFmt(v,d){return Number(v).toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});}
function m11CogoAz(dx,dy){var a=Math.atan2(dx,dy)*180/Math.PI;return (a+360)%360;}
function m11CogoInverse(){
 var x1=n(q('m11ciX1').value),y1=n(q('m11ciY1').value),x2=n(q('m11ciX2').value),y2=n(q('m11ciY2').value);
 if([x1,y1,x2,y2].some(function(v){return !Number.isFinite(v)}))return m11v2Msg('m11CogoInvResult','همه مختصات دو نقطه را وارد کن.');
 var dx=x2-x1,dy=y2-y1,d=Math.hypot(dx,dy),az=m11CogoAz(dx,dy);
 q('m11CogoInvResult').innerHTML='<div class="rline"><span>ΔX / اختلاف شرقی</span><b>'+m11CogoFmt(dx,3)+'</b></div><div class="rline"><span>ΔY / اختلاف شمالی</span><b>'+m11CogoFmt(dy,3)+'</b></div><div class="rline"><span>فاصله افقی</span><b>'+m11CogoFmt(d,3)+' متر</b></div><div class="rline"><span>آزیموت</span><b>'+m11CogoFmt(az,6)+' درجه</b></div>';
}
function m11CogoForward(){
 var x=n(q('m11cfX').value),y=n(q('m11cfY').value),az=n(q('m11cfAz').value),d=n(q('m11cfD').value);
 if([x,y,az,d].some(function(v){return !Number.isFinite(v)}))return m11v2Msg('m11CogoFwdResult','نقطه مبنا، آزیموت و فاصله را کامل وارد کن.');
 if(d<0)return m11v2Msg('m11CogoFwdResult','فاصله نمی‌تواند منفی باشد.');
 az=((az%360)+360)%360; var r=az*Math.PI/180,X=x+d*Math.sin(r),Y=y+d*Math.cos(r);
 q('m11CogoFwdResult').innerHTML='<div class="rline"><span>آزیموت</span><b>'+m11CogoFmt(az,6)+' درجه</b></div><div class="rline"><span>فاصله افقی</span><b>'+m11CogoFmt(d,3)+' متر</b></div><div class="rline"><span>نقطه جدید — X / شرقی</span><b>'+m11CogoFmt(X,3)+'</b></div><div class="rline"><span>نقطه جدید — Y / شمالی</span><b>'+m11CogoFmt(Y,3)+'</b></div>';
}
function m11CogoClear(mode){
 var ids=mode==='inv'?['m11ciX1','m11ciY1','m11ciX2','m11ciY2']:['m11cfX','m11cfY','m11cfAz','m11cfD'];
 ids.forEach(function(id){if(q(id))q(id).value='';});
 var out=q(mode==='inv'?'m11CogoInvResult':'m11CogoFwdResult'); if(out)out.textContent=mode==='inv'?'نتیجه اینجا نمایش داده می‌شود.':'مختصات نقطه جدید اینجا نمایش داده می‌شود.';
}
function m11v2Tab(i,btn){var ps=document.querySelectorAll('.m11v2-panel'),ts=document.querySelectorAll('.m11v2-tab');Array.prototype.forEach.call(ps,function(x,j){x.classList.toggle('active',j===i)});Array.prototype.forEach.call(ts,function(x,j){x.classList.toggle('active',j===i)});if(i===0&&q('m11v2ManualBody')&&!q('m11v2ManualBody').children.length)m11v2ClearManual();if(i===1)m11v2ListSystemChanged();}
function m11v2RunHelmertPanel(raw){
 var input=q('m11v2HelmertInput'),result=q('m11v2HelmertResult'),status=q('m11v2HelmertStatus');
 var command=String(raw==null?(input?input.value:''):raw).trim();
 if(input&&raw!=null)input.value=command;
 if(!command){if(status)status.textContent='ابتدا جفت نقاط کنترل را وارد کن.';if(result)result.style.display='none';return '';}
 if(typeof mgSurveyEngine183!=='function'){if(status)status.textContent='موتور محاسبات آفلاین هلمرت در دسترس نیست.';return '';}
 var solved=mgSurveyEngine183(command),report=typeof solved==='string'?solved:(solved&&solved.text?solved.text:'محاسبه‌ای انجام نشد. قالب نقاط کنترل را بررسی کن.');
 if(result){result.textContent=report;result.style.display='block';}
 if(status)status.textContent=report.indexOf('تعداد نقاط کنترل:')>=0?'✓ محاسبه با موتور آفلاین هلمرت انجام شد.':'ورودی نیاز به تکمیل یا اصلاح دارد.';
 return report;
}
function m11v2ClearHelmertPanel(){var i=q('m11v2HelmertInput'),r=q('m11v2HelmertResult'),s=q('m11v2HelmertStatus');if(i)i.value='';if(r){r.textContent='';r.style.display='none';}if(s)s.textContent='فرم هلمرت پاک شد. فرم انتقال نقاط دستی تغییری نکرد.';}

function m11v2LatLonToUtm(lat,lon,zone){
 var a=6378137,e=0.00669438,k=0.9996,ep=e/(1-e),lr=lat*Math.PI/180,N=a/Math.sqrt(1-e*Math.sin(lr)*Math.sin(lr)),T=Math.tan(lr)**2,C=ep*Math.cos(lr)**2,A=Math.cos(lr)*(lon-((zone-1)*6-180+3))*Math.PI/180;
 var M=a*((1-e/4-3*e*e/64-5*e*e*e/256)*lr-(3*e/8+3*e*e/32+45*e*e*e/1024)*Math.sin(2*lr)+(15*e*e/256+45*e**3/1024)*Math.sin(4*lr)-(35*e**3/3072)*Math.sin(6*lr));
 var E=k*N*(A+(1-T+C)*A**3/6+(5-18*T+T*T+72*C-58*ep)*A**5/120)+500000;
 var Y=k*(M+N*Math.tan(lr)*(A*A/2+(5-T+9*C+4*C*C)*A**4/24+(61-58*T+T*T+600*C-330*ep)*A**6/720));
 return {x:E,y:Y};
}
function m11v2UtmToLatLon(easting,northing,zone){
 var a=6378137,e=0.00669438,k=0.9996,ep=e/(1-e),e1=(1-Math.sqrt(1-e))/(1+Math.sqrt(1-e));
 var x=easting-500000,y=northing,M=y/k,mu=M/(a*(1-e/4-3*e*e/64-5*e**3/256));
 var p=mu+(3*e1/2-27*e1**3/32)*Math.sin(2*mu)+(21*e1*e1/16-55*e1**4/32)*Math.sin(4*mu)+(151*e1**3/96)*Math.sin(6*mu)+(1097*e1**4/512)*Math.sin(8*mu);
 var N=a/Math.sqrt(1-e*Math.sin(p)*Math.sin(p)),T=Math.tan(p)**2,C=ep*Math.cos(p)**2,R=a*(1-e)/Math.pow(1-e*Math.sin(p)*Math.sin(p),1.5),D=x/(N*k);
 var lat=p-(N*Math.tan(p)/R)*(D*D/2-(5+3*T+10*C-4*C*C-9*ep)*D**4/24+(61+90*T+298*C+45*T*T-252*ep-3*C*C)*D**6/720);
 var lon=((D-(1+2*T+C)*D**3/6+(5-2*C+28*T-3*C*C+8*ep+24*T*T)*D**5/120)/Math.cos(p));
 return {lat:lat*180/Math.PI,lon:(zone-1)*6-180+3+lon*180/Math.PI};
}
function m11v2ToGeo(x,y,sys,zone){if(sys==='geo')return {lat:y,lon:x};return m11v2UtmToLatLon(x,y,zone)}
function m11v2FromGeo(lat,lon,sys,zone){if(sys==='geo')return {x:lon,y:lat};return m11v2LatLonToUtm(lat,lon,zone)}
function m11v2Opposite(sys){return sys==='utm'?'geo':'utm'}
function m11v2GetSys(id){return q(id).value}
function m11v2SourceChanged(){var src=m11v2GetSys('m11v2MSrc'),sel=q('m11v2MDst');if(sel)sel.value=m11v2Opposite(src);m11v2RenderManual();}
function m11v2RenderManual(){var src=m11v2GetSys('m11v2MSrc'),sel=q('m11v2MDst'),dst=sel?sel.value:m11v2Opposite(src),sb=q('m11v2MSrcZone'),b1=q('m11v2MDstZoneBox');if(sb)sb.parentElement.style.display=src==='utm'?'block':'none';if(b1)b1.style.display=dst==='utm'?'block':'none';}
function m11v2ManualRow(i,r){r=r||{};return '<tr data-i="'+i+'"><td>'+(i+1)+'</td><td><input class="m11m-name" value="'+esc(r.name||'')+'" placeholder="P'+(i+1)+'"></td><td><input class="m11m-x" type="number" step="any" value="'+(r.x??'')+'"></td><td><input class="m11m-y" type="number" step="any" value="'+(r.y??'')+'"></td><td><input class="m11m-z" type="number" step="any" value="'+(r.z??'')+'"></td><td><input class="m11m-code" value="'+esc(r.code||'')+'" placeholder="PT"></td><td><button class="m11v2-btn light" type="button" onclick="m11v2RemoveManual('+i+')">×</button></td></tr>'}
function m11v2ReadManual(){var rows=[];Array.prototype.forEach.call(document.querySelectorAll('#m11v2ManualBody tr'),function(tr){rows.push({name:tr.querySelector('.m11m-name')?.value||'',x:n(tr.querySelector('.m11m-x')?.value),y:n(tr.querySelector('.m11m-y')?.value),z:n(tr.querySelector('.m11m-z')?.value),code:tr.querySelector('.m11m-code')?.value||''})});return rows}
function m11v2RenderManualBody(){q('m11v2ManualBody').innerHTML=M.manual.map(m11v2ManualRow).join('')}
function m11v2AddManualRow(){M.manual=m11v2ReadManual();M.manual.push({});m11v2RenderManualBody()}
function m11v2RemoveManual(i){M.manual=m11v2ReadManual();M.manual.splice(i,1);if(!M.manual.length)M.manual=[{}];m11v2RenderManualBody()}
function m11v2ClearManual(){M.manual=[{},{},{}];m11v2RenderManualBody();q('m11v2ManualStatus').textContent='۳ ردیف آماده ورود است.';if(q('m11v2ManualResult'))q('m11v2ManualResult').style.display='none';}
function m11v2TransferManual(){
 M.manual=m11v2ReadManual();
 var src=m11v2GetSys('m11v2MSrc'),dst=m11v2GetSys('m11v2MDst'),
     sz=z(q('m11v2MSrcZone').value),dz=z(q('m11v2MDstZone').value);
 if(src==='utm'&&!sz)return m11v2Msg('m11v2ManualStatus','زون مبدأ را بین ۱ تا ۶۰ وارد کن.');
 if(dst==='utm'&&!dz)return m11v2Msg('m11v2ManualStatus','زون مقصد را بین ۱ تا ۶۰ وارد کن.');

 var out=[],bad=0;
 M.manual.forEach(function(p){
   if(!Number.isFinite(p.x)||!Number.isFinite(p.y)){bad++;return}
   try{
     var g=m11v2ToGeo(p.x,p.y,src,sz),
         r=m11v2FromGeo(g.lat,g.lon,dst,dz);
     out.push({
       name:p.name||('P'+(out.length+1)),
       x:r.x,y:r.y,z:p.z,code:p.code||'',
       lat:g.lat,lon:g.lon,zone:(dst==='utm'?dz:'')
     });
   }catch(e){bad++}
 });
 M.list=out;

 var box=q('m11v2ManualResult'),
     head=q('m11v2ManualResultHead'),
     body=q('m11v2ManualResultBody');

 if(!out.length){
   if(box)box.style.display='none';
   return m11v2Msg('m11v2ManualStatus','هیچ نقطه معتبر برای انتقال پیدا نشد.');
 }

 var isUtm=(dst==='utm');
 head.innerHTML=isUtm
   ? '<tr><th>P</th><th>X / شرقی</th><th>Y / شمالی</th><th>زون</th><th>Z</th><th>کد</th></tr>'
   : '<tr><th>P</th><th>طول جغرافیایی</th><th>عرض جغرافیایی</th><th>Z</th><th>کد</th></tr>';

 body.innerHTML=out.map(function(r){
   return isUtm
     ? '<tr><td>'+esc(r.name)+'</td><td>'+Number(r.x).toFixed(3)+'</td><td>'+Number(r.y).toFixed(3)+'</td><td>'+r.zone+'</td><td>'+(Number.isFinite(r.z)?Number(r.z).toFixed(3):'')+'</td><td>'+esc(r.code)+'</td></tr>'
     : '<tr><td>'+esc(r.name)+'</td><td>'+Number(r.lon).toFixed(8)+'</td><td>'+Number(r.lat).toFixed(8)+'</td><td>'+(Number.isFinite(r.z)?Number(r.z).toFixed(3):'')+'</td><td>'+esc(r.code)+'</td></tr>';
 }).join('');

 if(box)box.style.display='block';
 q('m11v2ManualStatus').textContent=
   'انتقال انجام شد: '+out.length+' نقطه'+
   (bad?' | رد شده: '+bad:'')+
   '\nمبدأ: '+(src==='utm'?'UTM Zone '+sz:'WGS84')+
   '  ←  مقصد: '+(dst==='utm'?'UTM Zone '+dz:'WGS84');
}
function m11v2ManualSave(name,blob){
 try{
  if(!blob)return false;
  if(typeof window.miladgeoDirectSaveBlob==='function'){
   var r=window.miladgeoDirectSaveBlob(name,blob);
   return r===undefined?true:r;
  }
 }catch(e){console.error('M11 manual direct save bridge',e);}
 try{
  if(typeof saveBlobLikeMenu17==='function'){
   var r2=saveBlobLikeMenu17(name,blob);
   return r2===undefined?true:r2;
  }
 }catch(e){console.error('M11 manual save bridge',e);}
 try{
  var url=URL.createObjectURL(blob),a=document.createElement('a');
  a.href=url;a.download=name;a.rel='noopener';a.style.display='none';
  document.body.appendChild(a);a.click();
  setTimeout(function(){try{a.remove()}catch(e){}try{URL.revokeObjectURL(url)}catch(e){}},15000);
  return true;
 }catch(e){console.error('M11 manual browser save',e);try{showToast('خروجی ناموفق بود');}catch(x){}return false;}
}
function m11v2ManualExportRows(){
 var src=m11v2GetSys('m11v2MSrc'),dst=m11v2GetSys('m11v2MDst'),dz=z(q('m11v2MDstZone').value);
 return M.list.map(function(p){
   return dst==='utm'
    ? {Point:p.name,Easting:p.x,Northing:p.y,Zone:dz,Elevation:p.z??'',Description:p.code||''}
    : {Point:p.name,Longitude:p.x,Latitude:p.y,Elevation:p.z??'',Description:p.code||''};
 });
}
function m11v2ManualExportExcel(){
 if(!M.list.length)return m11v2Msg('m11v2ManualStatus','ابتدا انتقال نقاط را انجام بده.');
 m11v2EnsureXLSX(function(X){
  if(!X)return m11v2NoXlsx();
  try{
   var rows=m11v2ManualExportRows(),ws=X.utils.json_to_sheet(rows),wb=X.utils.book_new();
   X.utils.book_append_sheet(wb,ws,'نقاط انتقال یافته');
   var b64=X.write(wb,{bookType:'xlsx',type:'base64'}),bin=atob(b64),u=new Uint8Array(bin.length);
   for(var i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);
   m11v2ManualSave('MiladGeo_Manual_Transfer.xlsx',new Blob([u],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}));
  }catch(e){console.error('M11 manual Excel export',e);m11v2Msg('m11v2ManualStatus','خروجی Excel ناموفق بود.');}
 });
 return false;
}
function m11v2ManualExportTxt(){
 if(!M.list.length)return m11v2Msg('m11v2ManualStatus','ابتدا انتقال نقاط را انجام بده.');
 try{
  var dst=m11v2GetSys('m11v2MDst'),rows=m11v2ManualExportRows(),h=dst==='utm'?'Point\tEasting\tNorthing\tZone\tElevation\tDescription\n':'Point\tLongitude\tLatitude\tElevation\tDescription\n';
  var ss=h+rows.map(function(r){return Object.keys(r).map(function(k){return r[k]??''}).join('\t')}).join('\n');
  var ok=m11v2ManualSave('MiladGeo_Manual_Transfer.txt',new Blob(['\uFEFF'+ss],{type:'text/plain;charset=utf-8'}));
  if(ok!==false)m11v2Msg('m11v2ManualStatus','✓ خروجی TXT آماده شد.');
 }catch(e){console.error('M11 manual TXT export',e);m11v2Msg('m11v2ManualStatus','خروجی TXT ناموفق بود.');}
 return false;
}
function m11v2ManualExportKml(){
 if(!M.list.length)return m11v2Msg('m11v2ManualStatus','ابتدا انتقال نقاط را انجام بده.');
 try{
  var dst=m11v2GetSys('m11v2MDst'),arr=M.list.map(function(p){var lon,lat;if(dst==='geo'){lon=p.x;lat=p.y}else{var g=m11v2UtmToLatLon(p.x,p.y,z(q('m11v2MDstZone').value));lon=g.lon;lat=g.lat}return '<Placemark><name>'+esc(p.name||'')+'</name><description>'+esc(p.code||'')+'</description><Point><coordinates>'+Number(lon).toFixed(8)+','+Number(lat).toFixed(8)+','+(Number.isFinite(p.z)?Number(p.z):0)+'</coordinates></Point></Placemark>'}).join('');
  var k='<?xml version="1.0" encoding="UTF-8"?><kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>MiladGeo Manual Transfer</name>'+arr+'</Document></kml>';
  var ok=m11v2ManualSave('MiladGeo_Manual_Transfer.kml',new Blob([k],{type:'application/vnd.google-earth.kml+xml;charset=utf-8'}));
  if(ok!==false)m11v2Msg('m11v2ManualStatus','✓ خروجی KML آماده شد.');
 }catch(e){console.error('M11 manual KML export',e);m11v2Msg('m11v2ManualStatus','خروجی KML ناموفق بود.');}
 return false;
}
function m11v2ManualExportPdf(){
 if(!M.list.length)return m11v2Msg('m11v2ManualStatus','ابتدا انتقال نقاط را انجام بده.');
 try{
  var src=m11v2GetSys('m11v2MSrc'),dst=m11v2GetSys('m11v2MDst'),rows=m11v2ManualExportRows(),W=1754,H=1240,margin=70,top=100,rowH=42;
  var canvas=document.createElement('canvas'),ctx=canvas.getContext('2d');canvas.width=W;canvas.height=H;
  var pages=[],per=Math.max(1,Math.floor((H-top-margin-80)/rowH)),count=Math.ceil(rows.length/per);
  function draw(pi){
   ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);ctx.direction='rtl';ctx.textAlign='right';ctx.fillStyle='#111';ctx.font='bold 30px Tahoma,Arial,sans-serif';ctx.fillText('MiladGeo — نتیجه انتقال نقاط',W-margin,55);
   ctx.font='bold 19px Tahoma,Arial,sans-serif';ctx.fillStyle='#e8f1df';ctx.fillRect(margin,top,W-margin*2,44);ctx.fillStyle='#111';
   var heads=dst==='utm'?['کد','ارتفاع','زون','Y / شمالی','X / شرقی','نقطه']:['کد','ارتفاع','عرض جغرافیایی','طول جغرافیایی','نقطه'];
   var xs=dst==='utm'?[W-margin-100,W-margin-300,W-margin-470,W-margin-700,W-margin-1000,W-margin-1300]:[W-margin-100,W-margin-300,W-margin-650,W-margin-1000,W-margin-1300];
   heads.forEach(function(h,i){ctx.fillText(h,xs[i],top+29)});
   ctx.font='18px Tahoma,Arial,sans-serif';
   var st=pi*per,en=Math.min(rows.length,st+per);
   for(var i=st;i<en;i++){
    var r=rows[i],y=top+78+(i-st)*rowH;ctx.fillStyle='#222';
    var vals=dst==='utm'?[r.Description,r.Elevation,r.Zone,r.Northing,r.Easting,r.Point]:[r.Description,r.Elevation,r.Latitude,r.Longitude,r.Point];
    vals.forEach(function(v,j){ctx.fillText(String(v??''),xs[j],y)});
    ctx.strokeStyle='#ddd';ctx.beginPath();ctx.moveTo(margin,y+9);ctx.lineTo(W-margin,y+9);ctx.stroke();
   }
   ctx.fillStyle='#666';ctx.font='14px Tahoma,Arial,sans-serif';ctx.textAlign='left';ctx.direction='ltr';ctx.fillText('MiladGeo | '+rows.length+' points | page '+(pi+1)+'/'+count,margin,H-25);
   var data=canvas.toDataURL('image/jpeg',0.9),b64=data.split(',')[1]||'',bin=atob(b64),u=new Uint8Array(bin.length);for(var k=0;k<bin.length;k++)u[k]=bin.charCodeAt(k);pages.push(u);
  }
  for(var pi=0;pi<count;pi++)draw(pi);
  var pdfBytes=m16BuildPdfFromJpegs(pages,W,H);if(!pdfBytes||!pdfBytes.length)throw new Error('PDF bytes empty');var ok=m11v2ManualSave('MiladGeo_Manual_Transfer.pdf',new Blob([pdfBytes],{type:'application/pdf'}));if(ok!==false)m11v2Msg('m11v2ManualStatus','✓ خروجی PDF آماده شد.');
 }catch(e){console.error('M11 manual PDF export',e);m11v2Msg('m11v2ManualStatus','خروجی PDF ناموفق بود.');}
 return false;
}
function m11v2Msg(id,t){if(q(id))q(id).textContent=t;return false}
function m11v2ListSystemChanged(){var src=q('m11v2LSrc')?.value||'utm',dst=m11v2Opposite(src),ds=q('m11v2LDst');if(ds)ds.value=dst;q('m11v2LSrcZone').parentElement.style.display=src==='utm'?'block':'none';q('m11v2LDstZone').parentElement.style.display=dst==='utm'?'block':'none';}
function m11v2PopulateCols(){var names=['m11v2ColName','m11v2ColX','m11v2ColY','m11v2ColZ'];names.forEach(function(id,idx){var s=q(id);if(!s)return;s.innerHTML='';M.headers.forEach(function(h,i){var o=document.createElement('option');o.value=i;o.textContent=h||('ستون '+(i+1));s.appendChild(o)});if(idx===0)s.value=m11v2Guess(['name','point','point name','id','نام','نقطه']);if(idx===1)s.value=m11v2Guess(['x','easting','lon','longitude','طول','x coordinate']);if(idx===2)s.value=m11v2Guess(['y','northing','lat','latitude','عرض','y coordinate']);if(idx===3)s.value=m11v2Guess(['z','elevation','height','ارتفاع']);});q('m11v2ListMap').classList.remove('m11v2-hidden')}
function m11v2Guess(words){var idx=0;for(var i=0;i<M.headers.length;i++){var h=String(M.headers[i]).toLowerCase();if(words.some(function(w){return h.indexOf(w.toLowerCase())>=0}))return i}return idx}
function m11v2ParseText(txt){var lines=txt.replace(/^\uFEFF/,'').split(/\r?\n/).filter(function(x){return x.trim()});if(!lines.length)return;var delim=lines[0].indexOf('\t')>=0?'\t':(lines[0].indexOf(';')>=0?';':',');var rows=lines.map(function(l){return l.split(delim).map(function(v){return v.trim().replace(/^['"]|['"]$/g,'')})});m11v2SetPenzdRows(rows,'TXT/CSV')}
function m11v2SetPenzdRows(rows,label){if(!rows||!rows.length)throw Error('فایل خالی است');var first=rows[0].map(function(v){return String(v||'').trim().toLowerCase()});var headWords=['point','point no','point number','p','easting','east','x','northing','north','y','elevation','height','z','description','desc','code','dp','نقطه','شرقی','شمالی','ارتفاع','توضیحات','کد'];var looksHeader=first.slice(0,5).some(function(v){return headWords.indexOf(v)>=0||/easting|northing|elevation|description|point|نقطه|شرقی|شمالی|ارتفاع|توضیحات|کد/.test(v)});var data=looksHeader?rows.slice(1):rows;M.headers=['Point','Easting','Northing','Elevation','Description'];M.listRows=data.map(function(r){return [r[0]??'',r[1]??'',r[2]??'',r[3]??'',r[4]??'']}).filter(function(r){return r.some(function(v){return String(v).trim()!==''})});if(!M.listRows.length)throw Error('هیچ ردیف PENZD پیدا نشد');m11v2Msg('m11v2ListStatus',label+' خوانده شد: '+M.listRows.length+' نقطه PENZD. ترتیب P,E,N,Z,D ثابت است.'); if(M.autoTransfer){M.autoTransfer=false; setTimeout(function(){m11v2TransferList()},30)}}
function m11v2HandleListFile(file){
 if(!file)return;
 M.listRows=[];M.list=[];m11v2RenderList();
 m11v2Msg('m11v2ListStatus','در حال خواندن فایل PENZD: '+file.name+' ...');
 var ext=(file.name.split('.').pop()||'').toLowerCase();
 if(ext==='xlsx'||ext==='xls'){
   m11v2EnsureXLSX(function(X){
     if(!X)return m11v2NoXlsx();
     var r=new FileReader();
     r.onload=function(e){try{
       var wb=X.read(e.target.result,{type:'array'}),ws=wb.Sheets[wb.SheetNames[0]],a=X.utils.sheet_to_json(ws,{header:1,defval:''});
       m11v2SetPenzdRows(a,'Excel');
     }catch(err){m11v2Msg('m11v2ListStatus','خطا در خواندن PENZD: '+err.message)}};
     r.readAsArrayBuffer(file);
   });
 }else{
   var r2=new FileReader();
   r2.onload=function(e){try{m11v2ParseText(e.target.result)}catch(err){m11v2Msg('m11v2ListStatus','خطا در خواندن PENZD: '+err.message)}};
   r2.readAsText(file,'UTF-8');
 }
}

function m11v2TransferList(){
 if(!M.listRows.length){
   var f=q('m11v2ListFile')?.files?.[0];
   if(f){M.autoTransfer=true;m11v2HandleListFile(f);return m11v2Msg('m11v2ListStatus','در حال خواندن PENZD و سپس تبدیل خودکار...');}
   return m11v2Msg('m11v2ListStatus','اول فایل PENZD را انتخاب کن.');
 }
 var src=q('m11v2LSrc').value,dst=m11v2Opposite(src),sz=z(q('m11v2LSrcZone').value),dz=z(q('m11v2LDstZone').value);
 if(src==='utm'&&!sz)return m11v2Msg('m11v2ListStatus','زون مبدأ معتبر نیست.');
 if(dst==='utm'&&!dz)return m11v2Msg('m11v2ListStatus','زون مقصد معتبر نیست.');
 var out=[],bad=0;
 M.listRows.forEach(function(row,ix){
   var name=String(row[0]||('P'+(ix+1))).trim(),x=n(row[1]),y=n(row[2]),zz=row[3]??'',desc=String(row[4]??'').trim();
   if(!Number.isFinite(x)||!Number.isFinite(y)){bad++;return;}
   try{var g=m11v2ToGeo(x,y,src,sz),r=m11v2FromGeo(g.lat,g.lon,dst,dz);out.push({name:name,x0:x,y0:y,x:r.x,y:r.y,z:zz,code:desc,desc:desc,lat:g.lat,lon:g.lon});}catch(e){bad++;}
 });
 M.list=out;m11v2RenderList();
 return m11v2Msg('m11v2ListStatus','✓ تبدیل PENZD انجام شد: '+out.length+' نقطه'+(bad?' | ردیف نامعتبر: '+bad:''));
}

function m11v2RenderList(){q('m11v2ListBody').innerHTML=M.list.length?M.list.map(function(p){return '<tr><td>'+esc(p.name)+'</td><td>'+m11f(p.x)+'</td><td>'+m11f(p.y)+'</td><td>'+esc(p.z)+'</td><td>'+esc(p.desc||p.code||'')+'</td></tr>'}).join(''):'<tr><td colspan="5">نتیجه‌ای وجود ندارد.</td></tr>'}
function m11f(v){return Number.isFinite(Number(v))?Number(v).toFixed(3):esc(v||'')}
function m11v2RowsForExport(){return M.list.map(function(p){return {Point:p.name,Easting:p.x,Northing:p.y,Elevation:p.z||'',Description:p.desc||p.code||''}})}
function m11v2DownloadBlob(blob,name){
  /* V520: Use the exact same Android save path as Manual Transfer.
     Manual Transfer is proven on Android to open the native DocumentsUI
     (folder list + filename + Save button). Keep List/KML on that path too. */
  try{
    return m11v2ManualSave(name,blob);
  }catch(e){
    console.error('MiladGeo M11 shared save path',e);
    return false;
  }
}

function m11v2DownloadExcel(){
 if(!M.list.length)return m11v2Msg('m11v2ListStatus','اول تبدیل PENZD را انجام بده.');
 m11v2EnsureXLSX(function(X){
  if(!X)return m11v2NoXlsx();
  try{
   var ws=X.utils.json_to_sheet(m11v2RowsForExport(),{header:['Point','Easting','Northing','Elevation','Description']});
   var wb=X.utils.book_new();X.utils.book_append_sheet(wb,ws,'PENZD');
   var bytes=X.write(wb,{bookType:'xlsx',type:'array'});
   m11v2DownloadBlob(new Blob([bytes],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}),'MiladGeo_PENZD.xlsx');
   m11v2Msg('m11v2ListStatus','✓ فایل Excel آماده شد.');
  }catch(e){console.error('MiladGeo M11 Excel export',e);m11v2Msg('m11v2ListStatus','خروجی Excel ناموفق بود.');}
 });
 return false;
}

function m11v2PrintRowsPdf(rows,title,statusId,fileName){
 if(!Array.isArray(rows)||!rows.length){m11v2Msg(statusId||'m11v2ListStatus','ابتدا نقاط را وارد و تبدیل کن.');return false;}
 var cols=Object.keys(rows[0]||{});
 var esc=function(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')};
 var headers={Point:'نام نقطه',Easting:'X / شرقی',Northing:'Y / شمالی',Longitude:'طول جغرافیایی',Latitude:'عرض جغرافیایی',Zone:'زون',Elevation:'ارتفاع',Description:'توضیحات',P:'نام نقطه',X:'X / شرقی',Y:'Y / شمالی',Z:'ارتفاع',D:'توضیحات'};
 var th=cols.map(function(c){return '<th>'+esc(headers[c]||c)+'</th>'}).join('');
 var body=rows.map(function(r){return '<tr>'+cols.map(function(c){return '<td>'+esc(r[c])+'</td>'}).join('')+'</tr>'}).join('');
 var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+esc(title)+'</title><style>@page{size:A4 landscape;margin:12mm}*{box-sizing:border-box}body{font-family:Tahoma,Arial,sans-serif;color:#18251c;margin:0;padding:18px}h1{font-size:20px;margin:0 0 8px}p{font-size:11px;color:#555;margin:0 0 14px}table{width:100%;border-collapse:collapse;font-size:10px;direction:rtl}th,td{border:1px solid #9ba99d;padding:6px 5px;text-align:center;overflow-wrap:anywhere}th{background:#e7f0e4;font-weight:bold}tr{break-inside:avoid}tfoot{display:table-footer-group}.foot{margin-top:12px;font-size:10px;color:#555}@media screen{body{max-width:1200px;margin:20px auto;background:#fff;box-shadow:0 0 10px #ddd} .actions{display:flex;gap:8px;margin:12px 0 18px}.actions button{padding:10px 18px;border:0;border-radius:8px;background:#246b42;color:white;font:inherit;cursor:pointer}}@media print{body{padding:0}.actions{display:none}}</style></head><body><div class="actions"><button onclick="window.focus();window.print()">چاپ / ذخیره PDF</button><button onclick="try{window.close()}catch(e){}">بستن</button></div><h1>'+esc(title)+'</h1><p>تاریخ تهیه: '+esc(new Intl.DateTimeFormat('fa-IR',{dateStyle:'full',timeStyle:'short'}).format(new Date()))+' — تعداد نقاط: '+rows.length+'</p><table><thead><tr>'+th+'</tr></thead><tbody>'+body+'</tbody></table><div class="foot">MiladGeo | خروجی منوی ۱۱</div><script>window.addEventListener("load",function(){setTimeout(function(){try{window.focus();window.print()}catch(e){}},500)});</scr'+'ipt></body></html>';
 try{
  if(typeof window.miladgeoM17PrintHtml==='function'){
   var ok=window.miladgeoM17PrintHtml(html,fileName||'MiladGeo_Menu11.pdf');
   if(ok!==false){m11v2Msg(statusId||'m11v2ListStatus','پیش‌نمایش چاپ باز شد؛ در پنجره چاپ گزینه «ذخیره به‌صورت PDF» را انتخاب کن.');return false;}
  }
 }catch(e){console.warn('M11 shared invoice print path',e)}
 var w=null;try{w=window.open('','_blank')}catch(e){}
 if(!w){m11v2Msg(statusId||'m11v2ListStatus','مرورگر پنجره چاپ را مسدود کرده است؛ اجازه بازشدن پنجره را بده و دوباره بزن.');return false;}
 try{w.document.open();w.document.write(html);w.document.close();m11v2Msg(statusId||'m11v2ListStatus','پنجره چاپ باز شد؛ مقصد را روی «ذخیره به‌صورت PDF» بگذار.')}catch(e){console.error('M11 print PDF',e);m11v2Msg(statusId||'m11v2ListStatus','ساخت پیش‌نمایش PDF ناموفق بود.')}return false;
}
function m11v2ManualExportPdf(){if(!M.list.length)return m11v2Msg('m11v2ManualStatus','ابتدا انتقال نقاط را انجام بده.');return m11v2PrintRowsPdf(m11v2ManualExportRows(),'MiladGeo — نتیجه انتقال نقاط','m11v2ManualStatus','MiladGeo_Manual_Transfer.pdf');}
function m11v2DownloadPdf(){if(!M.list.length)return m11v2Msg('m11v2ListStatus','ابتدا تبدیل PENZD را انجام بده.');return m11v2PrintRowsPdf(m11v2RowsForExport(),'MiladGeo — خروجی PENZD','m11v2ListStatus','MiladGeo_PENZD.pdf');}
function m11v2KmlToPdf(){if(!M.kml||!M.kml.length)return m11v2Msg('m11v2KmlStatus','اول استخراج مختصات را انجام بده.');var rows=M.kml.map(function(p){return {Point:p.name,Longitude:p.lon,Latitude:p.lat,Zone:p.zone,Easting:p.x,Northing:p.y,Elevation:p.z,Description:p.desc||''}});return m11v2PrintRowsPdf(rows,'MiladGeo — مختصات استخراج‌شده از KML','m11v2KmlStatus','MiladGeo_KML.pdf');}

function m11v2PdfFallback(name,blob){
  try{
    var url=URL.createObjectURL(blob),a=document.createElement('a');
    a.href=url;a.download=name;a.target='_blank';a.rel='noopener';a.style.position='fixed';a.style.left='-9999px';
    document.body.appendChild(a);a.click();
    setTimeout(function(){try{a.remove();URL.revokeObjectURL(url)}catch(_){}},20000);
    try{showToast('✓ PDF آماده ذخیره شد')}catch(_){}
    return true;
  }catch(e){
    console.error('M11 PDF save',e);
    try{
      var fr=new FileReader();fr.onload=function(){
        try{var w=window.open();if(w){w.location.href=fr.result;return}}catch(_){ }
        try{location.href=fr.result}catch(_){ }
      };fr.readAsDataURL(blob);
    }catch(e2){try{showToast('⚠️ ذخیره PDF در این محیط پشتیبانی نشد')}catch(_){} }
    return false;
  }
}
function m11v2Esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}

function m11v2DownloadTxt(){if(!M.list.length)return m11v2Msg('m11v2ListStatus','اول تبدیل PENZD را انجام بده.');var h='Point\tEasting\tNorthing\tElevation\tDescription\n';var ss=h+M.list.map(function(p){return [p.name,p.x,p.y,p.z||'',p.desc||p.code||''].join('\t')}).join('\n');m11v2DownloadBlob(new Blob(['\uFEFF'+ss],{type:'text/plain;charset=utf-8'}),'MiladGeo_PENZD.txt')}
function m11v2XmlEsc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;')}
function m11v2KmlString(){
 /* V975: export the converted list M.list, not the unrelated/empty M.kml array.
    KML coordinates are WGS84 decimal degrees in longitude,latitude,altitude order. */
 var points=Array.isArray(M.list)?M.list:[];
 var arr=points.filter(function(p){return Number.isFinite(Number(p.lon))&&Number.isFinite(Number(p.lat))&&Math.abs(Number(p.lat))<=90&&Math.abs(Number(p.lon))<=180;}).map(function(p){
  var name=m11v2XmlEsc(p.name||'Point');
  var desc=m11v2XmlEsc('X='+Number(p.x).toFixed(3)+' Y='+Number(p.y).toFixed(3)+(p.z!==''&&p.z!=null?' Z='+p.z:'')+(p.desc?' | '+p.desc:''));
  var lon=Number(p.lon).toFixed(8),lat=Number(p.lat).toFixed(8),alt=Number.isFinite(Number(p.z))&&String(p.z).trim()!==''?Number(p.z).toFixed(3):'0';
  return '<Placemark><name>'+name+'</name><description>'+desc+'</description><Point><altitudeMode>clampToGround</altitudeMode><coordinates>'+lon+','+lat+','+alt+'</coordinates></Point></Placemark>';
 }).join('');
 if(!arr)throw new Error('هیچ نقطه‌ای با طول و عرض جغرافیایی معتبر برای KML وجود ندارد. ابتدا فایل را تبدیل کن و سیستم مبدأ/زون را کنترل کن.');
 return '<?xml version="1.0" encoding="UTF-8"?>\n<kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>MiladGeo Converted Points</name><open>1</open>'+arr+'</Document></kml>';
}
function m11v2DownloadKml(){
 if(!M.list.length)return m11v2Msg('m11v2ListStatus','اول فایل را وارد و دکمه «انتقال لیست» را اجرا کن.');
 try{var kml=m11v2KmlString();m11v2DownloadBlob(new Blob([kml],{type:'application/vnd.google-earth.kml+xml;charset=UTF-8'}),'MiladGeo_Converted.kml');m11v2Msg('m11v2ListStatus','✓ فایل KML با '+(kml.match(/<Placemark>/g)||[]).length+' نقطه ساخته شد. در Google Earth از File > Open فایل KML را انتخاب کن.');}
 catch(e){m11v2Msg('m11v2ListStatus','خطا در ساخت KML: '+e.message);}
}
function m11v2DownloadKml(){if(!M.list.length)return m11v2Msg('m11v2ListStatus','اول انتقال لیست را انجام بده.');m11v2DownloadBlob(new Blob([m11v2KmlString()],{type:'application/vnd.google-earth.kml+xml'}),'MiladGeo_Converted.kml')}
function m11v2RenderQuick(){var t=q('m11v2QType')?.value||'utmgeo',zbox=q('m11v2QDstZoneBox');if(zbox)zbox.style.display=(t==='geoutm'||t==='utmzone')?'block':'none';q('m11v2QSrcZone').parentElement.style.display=(t==='geoutm')?'none':'block';}
function m11v2QuickConvert(){var t=q('m11v2QType').value,x=n(q('m11v2QX').value),y=n(q('m11v2QY').value),sz=z(q('m11v2QSrcZone').value),dz=z(q('m11v2QDstZone').value);if(!Number.isFinite(x)||!Number.isFinite(y))return m11v2Msg('m11v2QuickStatus','X و Y را وارد کن.');try{var g,r;if(t==='utmgeo'){if(!sz)return m11v2Msg('m11v2QuickStatus','زون ورودی را وارد کن.');g=m11v2UtmToLatLon(x,y,sz);r='عرض جغرافیایی: '+g.lat.toFixed(8)+'°\nطول جغرافیایی: '+g.lon.toFixed(8)+'°\nWGS84'}else if(t==='geoutm'){if(!dz)return m11v2Msg('m11v2QuickStatus','زون مقصد را وارد کن.');r=m11v2LatLonToUtm(y,x,dz);r='X / Easting: '+r.x.toFixed(3)+' m\nY / Northing: '+r.y.toFixed(3)+' m\nUTM Zone: '+dz}else{if(!sz||!dz)return m11v2Msg('m11v2QuickStatus','زون مبدأ و مقصد را وارد کن.');g=m11v2UtmToLatLon(x,y,sz);r=m11v2LatLonToUtm(g.lat,g.lon,dz);r='X مقصد: '+r.x.toFixed(3)+' m\nY مقصد: '+r.y.toFixed(3)+' m\nUTM Zone مقصد: '+dz}m11v2Msg('m11v2QuickStatus',r);return false}catch(e){console.error('MiladGeo M11 quick',e);return m11v2Msg('m11v2QuickStatus','خطا در تبدیل: '+e.message)}}
function m11v2CopyQuick(){var s=q('m11v2QuickStatus').textContent||'';if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(s).then(function(){if(typeof showToast==='function')showToast('نتیجه کپی شد ✓')});return false}
function m11v2KmlAutoZone(lon){
  var zc=Math.floor((Number(lon)+180)/6)+1;
  return Math.max(1,Math.min(60,zc));
}
function m11v2KmlSaveBlob(name,blob){
  /* V520: KML/KMZ outputs use the exact proven Manual Transfer save system. */
  try{
    return m11v2ManualSave(name,blob);
  }catch(e){
    console.error('M11 KML shared save path',e);
    return false;
  }
}

function m11v2ParseKmlText(text){
  var xml=new DOMParser().parseFromString(text,'application/xml');
  if(xml.getElementsByTagName('parsererror').length)throw new Error('KML معتبر نیست');
  var ps=Array.prototype.slice.call(xml.getElementsByTagName('Placemark')),out=[],seq=1;
  ps.forEach(function(pm){
    var nameNode=pm.getElementsByTagName('name')[0];
    var name=(nameNode&&String(nameNode.textContent||'').trim())||('P'+seq);
    var cs=Array.prototype.slice.call(pm.getElementsByTagName('coordinates'));
    cs.forEach(function(cnode){
      String(cnode.textContent||'').trim().split(/\s+/).forEach(function(c){
        var a=c.split(',');
        var lon=n(a[0]),lat=n(a[1]),alt=a.length>2?n(a[2]):'';
        if(Number.isFinite(lon)&&Number.isFinite(lat)){
          var zone=m11v2KmlAutoZone(lon),u=m11v2LatLonToUtm(lat,lon,zone);
          out.push({name:name,lon:lon,lat:lat,zone:zone,x:u.x,y:u.y,z:Number.isFinite(alt)?alt:''});
          seq++;
        }
      });
    });
  });
  M.kml=out;
  q('m11v2KmlBody').innerHTML=M.kml.length
    ? M.kml.map(function(p){
        return '<tr><td>'+esc(p.name)+'</td><td>'+m11f(p.lon)+'</td><td>'+m11f(p.lat)+'</td><td>'+p.zone+'</td><td>'+m11f(p.x)+'</td><td>'+m11f(p.y)+'</td><td>'+m11f(p.z)+'</td></tr>';
      }).join('')
    : '<tr><td colspan="7">مختصاتی پیدا نشد.</td></tr>';
}
function m11v2ProcessKml(){
  var f=q('m11v2KmlFile').files[0];
  if(!f)return m11v2Msg('m11v2KmlStatus','اول فایل KML یا KMZ را انتخاب کن.');
  var r=new FileReader();
  if(/\.kmz$/i.test(f.name)){
    r.onload=function(e){
      var go=function(JSZip){
        if(!JSZip)return m11v2Msg('m11v2KmlStatus','برای KMZ نیاز به اتصال اینترنت برای بارگذاری موتور ZIP است.');
        JSZip.loadAsync(e.target.result).then(function(zip){
          var names=Object.keys(zip.files),nm=names.find(function(x){return /(^|\/)doc\.kml$/i.test(x)||/\.kml$/i.test(x)});
          if(!nm)throw Error('KML داخل KMZ پیدا نشد');
          return zip.files[nm].async('string');
        }).then(function(t){m11v2ParseKmlText(t);}).catch(function(err){m11v2Msg('m11v2KmlStatus','خطا در KMZ: '+err.message)});
      };
      if(window.JSZip)go(window.JSZip);
      else{
        var sc=document.createElement('script');
        sc.src='https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js';
        sc.onload=function(){go(window.JSZip)};
        sc.onerror=function(){go(null)};
        document.head.appendChild(sc);
      }
    };
    r.readAsArrayBuffer(f);
  }else{
    r.onload=function(e){try{m11v2ParseKmlText(e.target.result)}catch(err){m11v2Msg('m11v2KmlStatus','خطا در KML: '+err.message)}};
    r.readAsText(f,'UTF-8');
  }
  return false;
}
function m11v2KmlToExcel(){
  if(!M.kml.length)return m11v2Msg('m11v2KmlStatus','اول استخراج مختصات را انجام بده.');
  var make=function(X){
    try{
      var rows=[['P','طول جغرافیایی','عرض جغرافیایی','زون','X / Easting','Y / Northing','Z']];
      M.kml.forEach(function(p){rows.push([p.name,p.lon,p.lat,p.zone,p.x,p.y,p.z]);});
      var ws=X.utils.aoa_to_sheet(rows),wb=X.utils.book_new();
      X.utils.book_append_sheet(wb,ws,'KML');
      var bytes=X.write(wb,{bookType:'xlsx',type:'array'});
      var blob=new Blob([bytes],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
      m11v2KmlSaveBlob('MiladGeo_KML.xlsx',blob);
      m11v2Msg('m11v2KmlStatus','✓ فایل Excel آماده شد.');
    }catch(e){console.error('M11 KML Excel',e);m11v2Msg('m11v2KmlStatus','خطا در ساخت Excel: '+(e.message||e));}
  };
  if(window.XLSX)return make(window.XLSX);
  if(typeof m11v2EnsureXLSX==='function')return m11v2EnsureXLSX(function(X){if(X)make(X);else m11v2Msg('m11v2KmlStatus','موتور Excel در دسترس نیست.');});
  return m11v2Msg('m11v2KmlStatus','موتور Excel در دسترس نیست.');
}
function m11v2KmlToTxt(){
  if(!M.kml.length)return m11v2Msg('m11v2KmlStatus','اول استخراج مختصات را انجام بده.');
  var s='P\\tطول جغرافیایی\\tعرض جغرافیایی\\tزون\\tX / Easting\\tY / Northing\\tZ\\n'+
    M.kml.map(function(p){return [p.name,p.lon,p.lat,p.zone,p.x,p.y,p.z].join('\\t')}).join('\\n');
  m11v2KmlSaveBlob('MiladGeo_KML.txt',new Blob(['\\uFEFF'+s],{type:'text/plain;charset=utf-8'}));
  return false;
}
function m11v2KmlToKml(){
  if(!M.kml.length)return m11v2Msg('m11v2KmlStatus','اول استخراج مختصات را انجام بده.');
  var arr=M.kml.map(function(p){
    return '<Placemark><name>'+esc(p.name)+'</name><description>Zone='+p.zone+' | X='+Number(p.x).toFixed(3)+' | Y='+Number(p.y).toFixed(3)+'</description><Point><coordinates>'+
      Number(p.lon).toFixed(8)+','+Number(p.lat).toFixed(8)+','+(Number.isFinite(Number(p.z))?Number(p.z):0)+'</coordinates></Point></Placemark>';
  }).join('');
  var k='<?xml version="1.0" encoding="UTF-8"?><kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>MiladGeo KML Coordinates</name>'+arr+'</Document></kml>';
  m11v2KmlSaveBlob('MiladGeo_KML.kml',new Blob([k],{type:'application/vnd.google-earth.kml+xml;charset=utf-8'}));
  return false;
}
function m11v2KmlToPdf(){if(!M.kml||!M.kml.length)return m11v2Msg('m11v2KmlStatus','اول استخراج مختصات را انجام بده.');var rows=M.kml.map(function(p){return {Point:p.name,Longitude:p.lon,Latitude:p.lat,Zone:p.zone,Easting:p.x,Northing:p.y,Elevation:p.z,Description:p.desc||''}});return m11v2PrintRowsPdf(rows,'MiladGeo — مختصات استخراج‌شده از KML','m11v2KmlStatus','MiladGeo_KML.pdf');}
window.m11v2Tab=m11v2Tab;window.m11v2RunHelmertPanel=m11v2RunHelmertPanel;window.m11v2ClearHelmertPanel=m11v2ClearHelmertPanel;window.m11v2ManualSave=m11v2ManualSave;window.m11v2ManualExportExcel=m11v2ManualExportExcel;window.m11v2ManualExportTxt=m11v2ManualExportTxt;window.m11v2ManualExportKml=m11v2ManualExportKml;window.m11v2ManualExportPdf=m11v2ManualExportPdf;window.m11v2AddManualRow=m11v2AddManualRow;window.m11v2RemoveManual=m11v2RemoveManual;window.m11v2ClearManual=m11v2ClearManual;window.m11v2TransferManual=m11v2TransferManual;window.m11v2RenderManual=m11v2RenderManual;window.m11v2TransferList=m11v2TransferList;window.m11v2DownloadExcel=m11v2DownloadExcel;window.m11v2DownloadTxt=m11v2DownloadTxt;window.m11v2DownloadKml=m11v2DownloadKml;window.m11v2ListSystemChanged=m11v2ListSystemChanged;window.m11v2QuickConvert=m11v2QuickConvert;window.m11v2CopyQuick=m11v2CopyQuick;window.m11v2RenderQuick=m11v2RenderQuick;window.m11v2ProcessKml=m11v2ProcessKml;window.m11v2KmlToExcel=m11v2KmlToExcel;window.m11v2KmlToTxt=m11v2KmlToTxt;window.m11v2KmlToPdf=m11v2KmlToPdf;window.m11v2KmlToKml=m11v2KmlToKml;
var kf=q('m11v2KmlFile');if(kf)kf.addEventListener('change',function(){});
setTimeout(function(){m11v2ClearManual();m11v2RenderManual();m11v2ListSystemChanged();m11v2RenderQuick()},0);
})();


</script>
<style id="u12-pro-css">
#units{overflow-x:hidden!important}.u12-shell{background:linear-gradient(145deg,#f7faf5,#e2eadf);border:2px solid #596756;border-radius:16px;padding:10px;box-shadow:0 5px 14px rgba(30,45,30,.12);color:#172018}.u12-head{padding:10px 11px;border-radius:12px;background:linear-gradient(145deg,#ffffff,#e5eee2);border:1px solid #aab7a5;text-align:center}.u12-title{font-size:18px;font-weight:1000}.u12-sub{font-size:10px;color:#647064;margin-top:3px}.u12-tabs{display:flex;gap:6px;overflow-x:auto;padding:8px 0 5px;scrollbar-width:none;-webkit-overflow-scrolling:touch}.u12-tabs::-webkit-scrollbar{display:none}.u12-tab{flex:0 0 auto;min-height:42px;padding:7px 12px;border:2px solid #667260;border-radius:11px;background:linear-gradient(145deg,#ffffff,#dfe8dc);color:#172018;font-weight:900;font-size:11px}.u12-tab.active{background:linear-gradient(145deg,#ffffff,#cfe3ca);border-color:#3f7444;box-shadow:inset 0 -3px 0 #4e8a52}.u12-card{margin-top:7px;padding:11px;border-radius:13px;background:#fff;border:1px solid #aeb9aa;box-shadow:0 2px 8px rgba(35,45,35,.08)}.u12-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.u12-field label{display:block;font-size:10px;font-weight:900;margin:0 0 4px}.u12-field input,.u12-field select{width:100%;height:43px;box-sizing:border-box;border:1px solid #b8c2b5;border-radius:9px;background:#fff;font-size:14px;padding:7px}.u12-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:9px}.u12-main{grid-column:1/-1;min-height:45px;border:2px solid #47764b;border-radius:10px;background:linear-gradient(145deg,#ffffff,#dcebd8);font-weight:1000;font-size:14px}.u12-secondary{min-height:40px;border:1px solid #8c9989;border-radius:9px;background:#f1f5ef;font-weight:800}.u12-result{margin-top:9px;padding:14px 9px;border:2px solid #527958;border-radius:11px;background:linear-gradient(145deg,#f6fbf4,#dfeee0);text-align:center}.u12-result small{display:block;font-size:9px;color:#697368;margin-bottom:4px}.u12-result b{display:block;font-size:22px;color:#174d20;word-break:break-word}.u12-tablewrap{overflow:auto;margin-top:9px;border:1px solid #aeb9aa;border-radius:10px}.u12-table{width:100%;min-width:520px;border-collapse:collapse;font-size:10px}.u12-table th,.u12-table td{padding:7px;border-bottom:1px solid #dce2d9;text-align:center;white-space:nowrap}.u12-table th{background:#dfe8dc;font-weight:1000}.u12-quick{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;margin-top:9px}.u12-quick button{padding:9px 6px;border:1px solid #a5b09f;border-radius:9px;background:#f5f8f3;font-size:10px;font-weight:800}.u12-note{margin-top:8px;font-size:9px;line-height:1.6;color:#667066;text-align:center}.u12-swap{min-width:70px}
@media(max-width:560px){.u12-shell{padding:8px}.u12-title{font-size:16px}.u12-row{grid-template-columns:1fr}.u12-tabs{margin-right:-2px;margin-left:-2px}.u12-tab{font-size:10px;padding:7px 10px}.u12-result b{font-size:19px}.u12-quick{grid-template-columns:1fr 1fr}}
</style>
<script id="u12-pro-js">
(function(){
'use strict';
var defs={
 length:{title:'طول و فاصله',units:{'میلی‌متر':0.001,'سانتی‌متر':0.01,'متر':1,'کیلومتر':1000,'اینچ':0.0254,'فوت':0.3048,'فوت نقشه‌برداری آمریکا':1200/3937,'یارد':0.9144,'مایل':1609.344},defaults:['متر','فوت']},
 area:{title:'مساحت',units:{'میلی‌متر مربع':1e-6,'سانتی‌متر مربع':1e-4,'متر مربع':1,'کیلومتر مربع':1e6,'هکتار':1e4,'آر':100,'آکر':4046.8564224,'فوت مربع':0.09290304,'فوت مربع نقشه‌برداری آمریکا':(1200/3937)**2},defaults:['متر مربع','هکتار']},
 volume:{title:'حجم',units:{'سانتی‌متر مکعب':1e-6,'لیتر':0.001,'متر مکعب':1,'فوت مکعب':0.028316846592,'گالن آمریکا':0.003785411784,'فوت مکعب نقشه‌برداری آمریکا':(1200/3937)**3},defaults:['متر مکعب','لیتر']},
 angle:{title:'زاویه',units:{'درجه':1,'گون':0.9,'رادیان':180/Math.PI,'دقیقه قوسی':1/60,'ثانیه قوسی':1/3600},defaults:['درجه','گون']},
 mass:{title:'جرم',units:{'میلی‌گرم':1e-6,'گرم':0.001,'کیلوگرم':1,'تن':1000,'پوند':0.45359237},defaults:['کیلوگرم','پوند']}
};
var current='length';
function esc(x){return String(x).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function opts(obj,sel){return Object.keys(obj).map(function(k){return '<option value="'+esc(k)+'" '+(k===sel?'selected':'')+'>'+esc(k)+'</option>';}).join('')}
function body(type){
 var b=document.getElementById('u12-body'); if(!b)return;
 if(type==='coord'){b.innerHTML='<div class="u12-card"><div class="u12-row"><div class="u12-field"><label>نوع تبدیل</label><select id="u12c-type"><option value="dms">درجه اعشاری ↔ درجه / دقیقه / ثانیه</option><option value="gon">درجه ↔ گون</option></select></div><div class="u12-field"><label>مقدار</label><input id="u12c-value" type="number" step="any" placeholder="مثلاً 35.6892"></div></div><div id="u12c-extra"></div><div class="u12-actions"><button class="u12-main" onclick="u12CoordConvert();return false;">تبدیل</button><button class="u12-secondary" onclick="u12Clear();return false;">پاکسازی</button><button class="u12-secondary" onclick="u12Copy();return false;">کپی نتیجه</button></div><div class="u12-result" id="u12-result"><small>نتیجه</small><b>مقدار تبدیل‌شده اینجا نمایش داده می‌شود</b></div><div class="u12-note">تبدیل‌های کاربردی برای داده‌های مختصاتی و زاویه‌ای نقشه‌برداری</div></div>'; document.getElementById('u12c-type').onchange=function(){u12CoordExtra();}; u12CoordExtra(); return;}
 if(type==='slope'){b.innerHTML='<div class="u12-card"><div class="u12-row"><div class="u12-field"><label>مقدار</label><input id="u12-value" type="number" step="any" placeholder="مثلاً 12.5"></div><div class="u12-field"><label>از واحد</label><select id="u12-from"><option value="percent">درصد (%)</option><option value="ratio">نسبت 1:n</option><option value="degree">درجه</option></select></div></div><div class="u12-row" style="margin-top:7px"><div class="u12-field"><label>به واحد</label><select id="u12-to"><option value="degree">درجه</option><option value="percent">درصد (%)</option><option value="ratio">نسبت 1:n</option></select></div><div></div></div><div class="u12-actions"><button class="u12-main" onclick="u12Convert();return false;">تبدیل</button><button class="u12-secondary" onclick="u12Swap();return false;">جابجایی</button><button class="u12-secondary" onclick="u12Clear();return false;">پاکسازی</button></div><div class="u12-result" id="u12-result"><small>نتیجه</small><b>نتیجه تبدیل اینجا نمایش داده می‌شود</b></div><div class="u12-quick"><button onclick="u12Set(10,&quot;percent&quot;,&quot;degree&quot;);return false;">۱۰٪ → درجه</button><button onclick="u12Set(45,&quot;degree&quot;,&quot;percent&quot;);return false;">۴۵° → درصد</button></div></div>'; return;}
 var d=defs[type], keys=Object.keys(d.units); b.innerHTML='<div class="u12-card"><div class="u12-row"><div class="u12-field"><label>مقدار</label><input id="u12-value" type="number" step="any" placeholder="مثلاً 125.50"></div><div class="u12-field"><label>از واحد</label><select id="u12-from">'+opts(d.units,d.defaults[0])+'</select></div></div><div class="u12-row" style="margin-top:7px"><div class="u12-field"><label>به واحد</label><select id="u12-to">'+opts(d.units,d.defaults[1])+'</select></div><div class="u12-field"><label>&nbsp;</label><button class="u12-secondary u12-swap" style="width:100%;height:43px" onclick="u12Swap();return false;">⇄ جابجایی</button></div></div><div class="u12-actions"><button class="u12-main" onclick="u12Convert();return false;">تبدیل</button><button class="u12-secondary" onclick="u12Clear();return false;">پاکسازی</button><button class="u12-secondary" onclick="u12Copy();return false;">کپی نتیجه</button></div><div class="u12-result" id="u12-result"><small>نتیجه</small><b>نتیجه تبدیل اینجا نمایش داده می‌شود</b></div><div class="u12-quick"><button onclick="u12Set(1,&quot;${d.defaults[0]}&quot;,&quot;${d.defaults[1]}&quot;);return false;">۱ ${d.defaults[0]} → ${d.defaults[1]}</button><button onclick="u12Set(100,&quot;${d.defaults[0]}&quot;,&quot;${d.defaults[1]}&quot;);return false;">۱۰۰ ${d.defaults[0]} → ${d.defaults[1]}</button></div></div>' .replace(/\$\{d\.defaults\[0\]\}/g, d.defaults[0]).replace(/\$\{d\.defaults\[1\]\}/g,d.defaults[1]);
}
function coordExtra(){var e=document.getElementById('u12c-extra');if(!e)return;var t=document.getElementById('u12c-type').value;e.innerHTML=t==='dms'?'<div class="u12-note" style="margin:8px 0">برای تبدیل DMS، مقدار را به صورت درجه اعشاری وارد کنید؛ خروجی درجه/دقیقه/ثانیه خواهد بود.</div>':''}
window.u12CoordExtra=coordExtra;
window.u12Tab=function(type){current=type;document.querySelectorAll('.u12-tab').forEach(function(x){x.classList.toggle('active',x.getAttribute('data-u12')===type)});body(type);};
window.u12Convert=function(){var v=parseFloat(document.getElementById('u12-value')?.value),f=document.getElementById('u12-from')?.value,t=document.getElementById('u12-to')?.value;if(!Number.isFinite(v)){alert('لطفاً مقدار را وارد کنید');return false}var r;if(current==='slope'){var deg=f==='percent'?Math.atan(v/100)*180/Math.PI:f==='ratio'?Math.atan(1/v)*180/Math.PI:v;r=t==='degree'?deg:t==='percent'?Math.tan(deg*Math.PI/180)*100:(Math.abs(Math.tan(deg*Math.PI/180))<1e-15?'∞':1/Math.tan(deg*Math.PI/180));}else{var d=defs[current].units;r=v*d[f]/d[t];}var out=typeof r==='number'?r.toLocaleString('fa-IR',{maximumFractionDigits:10}):r;document.getElementById('u12-result').innerHTML='<small>نتیجه تبدیل</small><b>'+esc(out)+' '+esc(t)+'</b>';return false;};
window.u12Set=function(v,f,t){var a=document.getElementById('u12-value'),b=document.getElementById('u12-from'),c=document.getElementById('u12-to');if(a)a.value=v;if(b)b.value=f;if(c)c.value=t;u12Convert();};
window.u12Swap=function(){var a=document.getElementById('u12-from'),b=document.getElementById('u12-to');if(!a||!b)return false;var x=a.value;a.value=b.value;b.value=x;u12Convert();return false;};
window.u12Clear=function(){var a=document.getElementById('u12-value');if(a)a.value='';var r=document.getElementById('u12-result');if(r)r.innerHTML='<small>نتیجه</small><b>نتیجه تبدیل اینجا نمایش داده می‌شود</b>';return false;};
window.u12Copy=function(){var r=document.querySelector('#u12-result b');if(!r)return false;var txt=r.textContent;navigator.clipboard?.writeText(txt).then(function(){if(typeof showToast==='function')showToast('نتیجه کپی شد ✓');});return false;};
window.u12CoordConvert=function(){var v=parseFloat(document.getElementById('u12c-value')?.value),t=document.getElementById('u12c-type')?.value,r=document.getElementById('u12-result');if(!Number.isFinite(v)){alert('لطفاً مقدار را وارد کنید');return false}var out='';if(t==='gon'){out=(v*10/9).toLocaleString('fa-IR',{maximumFractionDigits:10})+' گون';}else{var av=Math.abs(v),d=Math.floor(av),mFloat=(av-d)*60,m=Math.floor(mFloat),sec=(mFloat-m)*60;out=d+'° '+m+"′ "+sec.toLocaleString('fa-IR',{maximumFractionDigits:4})+'″'+(v<0?' غرب/منفی':'');}r.innerHTML='<small>نتیجه تبدیل</small><b>'+esc(out)+'</b>';return false;};
window.updateUnitConverter=function(){}; window.convertUnits=function(){return u12Convert()}; window.swapUnits=function(){return u12Swap()}; window.copyUnitResult=function(){return u12Copy()};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){u12Tab('length')});else u12Tab('length');
})();
</script>
<script id="m20-note-script">
(function(){
var KEY='miladgeo_menu20_v1';
var state={notes:[]};
function el(id){return document.getElementById(id)}
function esc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}
function job(){var h=el('headerStatus');return h&&h.textContent&&h.textContent.trim()&&h.textContent.trim()!=='JOB NAME'?h.textContent.trim():'بدون پروژه'}
function now(){return new Date().toLocaleString('fa-IR')}
function save(){try{localStorage.setItem(KEY,JSON.stringify(state.notes))}catch(e){alert('ذخیره یادداشت ناموفق بود.')}}
function load(){try{var a=JSON.parse(localStorage.getItem(KEY)||'[]');state.notes=Array.isArray(a)?a:[]}catch(e){state.notes=[]}}
function toastMsg(t){try{if(typeof showToast==='function')showToast(t);else alert(t)}catch(e){alert(t)}}
function scrollBody(){setTimeout(function(){var b=el('m20Body');if(b){var r=b.getBoundingClientRect();window.scrollTo({top:Math.max(0,window.scrollY+r.top-16),behavior:'smooth'})}},80)}

function typedEditor(id){
 var n=id?state.notes.find(function(x){return x.id===id}):null;
 el('m20Body').innerHTML='<h3>✍️ '+(n?'ویرایش یادداشت':'یادداشت جدید')+'</h3>'+ 
 '<div class="m20-row"><input id="m20Title" placeholder="عنوان یادداشت" value="'+esc(n?n.title:'')+'"><input id="m20Tag" placeholder="برچسب / محل" value="'+esc(n?n.tag:'')+'"></div>'+ 
 '<textarea id="m20TypedText" style="margin-top:8px;min-height:260px;line-height:2" placeholder="یادداشت خود را اینجا تایپ کنید...">'+esc(n?n.text:'')+'</textarea>'+ '<div style="display:grid;grid-template-columns:1fr;gap:6px;margin:7px 0 10px"><button class="btn primary" type="button" id="m20NoteSpeechBtn" onclick="m20NoteToggleSpeech()">🎙️ تایپ صوتی فارسی</button><div id="m20NoteSpeechStatus" role="status" aria-live="polite" style="font-size:11px;line-height:1.7;padding:7px;border:1px solid #687263;border-radius:6px;background:rgba(255,255,255,.35)">برای دیکته، روی دکمه بزن و اجازه میکروفون را بده.</div></div>'+ 
 '<div class="m20-btns"><button class="btn primary" type="button" onclick="m20SaveTyped('+(n?n.id:'null')+')">💾 ذخیره یادداشت</button><button class="btn primary" type="button" onclick="m20NoteExportWord()">📝 خروجی Word</button><button class="btn primary" type="button" onclick="m20NoteExportPDF()">📄 خروجی PDF</button><button class="btn gray" type="button" onclick="m20Open(\'notebooks\')">↩️ یادداشت‌های قبلی</button></div>'+ 
 '<div class="m20-meta">این بخش مخصوص یادداشت تایپی است. یادداشت‌های ذخیره‌شده در «یادداشت‌های قبلی» و «آرشیو» قابل دسترسی هستند.</div>';
 el('m20TypedText').focus();
}
window._m20NoteRecognition=null;window._m20NoteSpeechActive=false;
window.m20NoteToggleSpeech=function(){
 var field=el('m20TypedText'),btn=el('m20NoteSpeechBtn'),status=el('m20NoteSpeechStatus');if(!field||!btn||!status)return;
 if(window._m20NoteSpeechActive&&window._m20NoteRecognition){try{window._m20NoteRecognition.stop()}catch(e){}return;}
 var SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){status.textContent='این مرورگر قابلیت تشخیص گفتار را پشتیبانی نمی‌کند.';return;}
 try{var rec=new SR();window._m20NoteRecognition=rec;rec.lang='fa-IR';rec.continuous=true;rec.interimResults=true;rec.maxAlternatives=1;
 var base=field.value,finalParts=[];
 function normalize(s){return String(s||'').replace(/[\u200c\u200f\u200e]/g,' ').replace(/\s+/g,' ').trim();}
 function sameText(a,b){return normalize(a).toLocaleLowerCase('fa')===normalize(b).toLocaleLowerCase('fa');}
 function mergeFinalParts(parts){var out=[];for(var i=0;i<parts.length;i++){var p=normalize(parts[i]);if(!p)continue;if(!out.length){out.push(p);continue;}var prev=out[out.length-1];if(sameText(prev,p))continue;var a=prev.split(' '),b=p.split(' '),overlap=0;for(var n=Math.min(a.length,b.length);n>0;n--){if(a.slice(a.length-n).join(' ').toLocaleLowerCase('fa')===b.slice(0,n).join(' ').toLocaleLowerCase('fa')){overlap=n;break;}}var remainder=b.slice(overlap).join(' ');if(remainder)out[out.length-1]=prev+' '+remainder;}return out;}
 rec.onstart=function(){window._m20NoteSpeechActive=true;btn.textContent='⏹️ توقف تایپ صوتی';status.textContent='در حال شنیدن فارسی… صحبت کن. متن در همین کادر یادداشت وارد می‌شود.';};
 rec.onresult=function(event){for(var n=event.resultIndex||0;n<event.results.length;n++){var item=event.results[n],piece=normalize(item&&item[0]&&item[0].transcript);if(item&&item.isFinal)finalParts[n]=piece;}var finals=mergeFinalParts(finalParts),interim=[];for(var k=0;k<event.results.length;k++){var r=event.results[k];if(r&&!r.isFinal){var t=normalize(r[0]&&r[0].transcript);if(t)interim.push(t);}}var finalText=finals.join(' '),interimText=interim.join(' '),spoken=finalText+(finalText&&interimText?' ':'')+interimText;field.value=base+(base&&spoken&&!/\s$/.test(base)?' ':'')+spoken;field.dispatchEvent(new Event('input',{bubbles:true}));field.scrollTop=field.scrollHeight;};
 rec.onerror=function(event){var messages={'not-allowed':'مرورگر یا سرویس گفتار اجازه دسترسی نداد؛ مجوز میکروفون سایت را بررسی کن.','service-not-allowed':'سرویس تشخیص گفتار در این محیط مجاز نیست.','network':'ارتباط با سرویس آنلاین تشخیص گفتار برقرار نشد.','no-speech':'صدایی تشخیص داده نشد؛ دوباره شروع کن.','audio-capture':'میکروفون در دسترس نیست.','language-not-supported':'تشخیص گفتار فارسی پشتیبانی نمی‌شود.'};status.textContent=messages[event.error]||('خطای تشخیص گفتار: '+event.error+'.');};
 rec.onend=function(){var finalText=mergeFinalParts(finalParts).join(' ');field.value=base+(base&&finalText&&!/\s$/.test(base)?' ':'')+finalText;field.dispatchEvent(new Event('input',{bubbles:true}));window._m20NoteSpeechActive=false;btn.textContent='🎙️ تایپ صوتی فارسی';if(!/اجازه دسترسی|ارتباط با سرویس|میکروفون در دسترس|پشتیبانی نمی‌شود|خطای تشخیص/.test(status.textContent))status.textContent=finalText?'تایپ صوتی متوقف شد؛ متن نهایی در کادر یادداشت باقی مانده است.':'شنیدن متوقف شد. برای شروع دوباره روی دکمه بزن.';window._m20NoteRecognition=null;};rec.start();
 }catch(err){window._m20NoteSpeechActive=false;btn.textContent='🎙️ تایپ صوتی فارسی';status.textContent='شروع تایپ صوتی ناموفق بود: '+(err&&err.message?err.message:'خطای ناشناخته');}
};
window.m20NoteExportWord=function(){
 var title=(el('m20Title')&&el('m20Title').value||'یادداشت مهندسی').trim()||'یادداشت مهندسی',tag=(el('m20Tag')&&el('m20Tag').value||'').trim(),body=(el('m20TypedText')&&el('m20TypedText').value||'').trim();
 if(!body){toastMsg('ابتدا متن یادداشت را وارد کن.');return false;}
 var safe=function(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')};
 var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta http-equiv="Content-Type" content="text/html; charset=utf-8"><title>'+safe(title)+'</title><style>@page{size:A4;margin:18mm}*{box-sizing:border-box}body{font-family:Tahoma,Arial,sans-serif;direction:rtl;text-align:right;color:#17251b;line-height:2;font-size:13pt;margin:0}h1{font-size:19pt;text-align:center;margin:0 0 18px;color:#174f32}.meta{font-size:10pt;color:#526257;border:1px solid #d5e1d7;background:#f3f8f3;padding:9px 12px;border-radius:6px;margin-bottom:18px}.content{white-space:pre-wrap;overflow-wrap:anywhere}</style></head><body><h1>'+safe(title)+'</h1>'+(tag?'<div class="meta">'+safe(tag)+'</div>':'')+'<div class="content">'+safe(body)+'</div></body></html>';
 var fname=title.replace(/[\\/:*?"<>|]+/g,'_')||'یادداشت';
 if(typeof window.mgDownloadWordLikeAccountant==='function')return window.mgDownloadWordLikeAccountant(fname+'.doc',html);
 toastMsg('موتور ذخیره Word در دسترس نیست.');return false;
};
window.m20NoteExportPDF=function(){
 var title=(el('m20Title')&&el('m20Title').value||'یادداشت مهندسی').trim()||'یادداشت مهندسی',tag=(el('m20Tag')&&el('m20Tag').value||'').trim(),body=(el('m20TypedText')&&el('m20TypedText').value||'').trim();
 if(!body){toastMsg('ابتدا متن یادداشت را وارد کن.');return false;}
 var safe=function(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')};
 var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+safe(title)+'</title><style>@page{size:A4 portrait;margin:18mm}*{box-sizing:border-box}html,body{margin:0;padding:0;background:#fff}body{font-family:Tahoma,Arial,sans-serif;direction:rtl;text-align:right;color:#17251b;line-height:2;font-size:13pt}h1{font-size:19pt;text-align:center;margin:0 0 18px;color:#174f32}.meta{font-size:10pt;color:#526257;border:1px solid #d5e1d7;background:#f3f8f3;padding:9px 12px;border-radius:6px;margin-bottom:18px}.content{white-space:pre-wrap;overflow-wrap:anywhere}</style></head><body><h1>'+safe(title)+'</h1>'+(tag?'<div class="meta">'+safe(tag)+'</div>':'')+'<div class="content">'+safe(body)+'</div></body></html>';
 try{
  if(typeof window.miladgeoM17PrintHtml==='function'){
   var result=window.miladgeoM17PrintHtml(html,(title.replace(/[\\/:*?"<>|]+/g,'_')||'یادداشت')+'.pdf');
   if(result!==false)return false;
   return false;
  }
  if(window.AndroidBridge&&typeof window.AndroidBridge.printHtml==='function'){window.AndroidBridge.printHtml(html);return false;}
  toastMsg('موتور چاپ و ذخیره PDF منوی ۱۷ در دسترس نیست.');return false;
 }catch(e){console.error('M20_NOTE_PDF',e);toastMsg('ساخت PDF ناموفق بود: '+(e.message||e));return false;}
};
window.m20SaveTyped=function(id){
 var title=(el('m20Title')?.value||'یادداشت بدون عنوان').trim()||'یادداشت بدون عنوان';
 var tag=(el('m20Tag')?.value||'').trim();var text=(el('m20TypedText')?.value||'').trim();
 if(!text){toastMsg('متن یادداشت را وارد کن');return}
 if(id){var n=state.notes.find(function(x){return x.id===id});if(n){n.title=title;n.tag=tag;n.text=text;n.date=now();n.type='note'}}
 else state.notes.unshift({id:Date.now(),title:title,tag:tag,job:job(),date:now(),type:'note',image:'',text:text});
 state.notes=state.notes.slice(0,300);save();toastMsg('یادداشت ذخیره شد ✓');m20Open('notebooks')
}

function noteViewer(id){
 var n=state.notes.find(function(x){return x.id===id});if(!n)return;
 var html='<h3>📖 '+esc(n.title)+'</h3><div class="m20-note-item"><small>'+esc(n.job||'بدون پروژه')+' — '+esc(n.date)+' — '+esc(n.tag||'بدون برچسب')+'</small>';
 if(n.type==='note') html+='<div class="m20-preview" style="white-space:pre-wrap;font-size:16px;line-height:2;margin-top:10px">'+esc(n.text||'')+'</div>';
 else if(n.image) html+='<img src="'+n.image+'" style="width:100%;max-height:480px;object-fit:contain;border-radius:10px;margin-top:10px"><div class="m20-preview" style="white-space:pre-wrap">'+esc(n.text||'')+'</div>';
 else html+='<div class="m20-preview" style="white-space:pre-wrap">'+esc(n.text||'یادداشت دستی')+'</div>';
 html+='</div><div class="m20-btns">';
 if(n.type==='note') html+='<button class="btn primary" type="button" onclick="m20EditNote('+n.id+')">✏️ اصلاح یادداشت</button>';
 html+='<button class="btn gray" type="button" onclick="m20Open(\'notebooks\')">↩️ برگشت</button></div>';
 el('m20Body').innerHTML=html;scrollBody()
}
window.m20EditNote=function(id){load();typedEditor(id);scrollBody()}

function notebooks(){
 load();
 var list=state.notes.filter(function(n){return n.type==='note'});
 var html='<h3>📒 یادداشت‌های قبلی</h3><div class="m20-meta">محل نگهداری یادداشت‌های تایپی و یادداشت‌های دستی ذخیره‌شده است.</div>';
 if(!list.length){el('m20Body').innerHTML=html+'<div class="m20-meta">هنوز یادداشتی ثبت نشده است.</div>';return}
 html+='<div class="m20-note-list">'+list.slice(0,100).map(function(n){var icon='📝';return '<button class="m20-note-item" type="button" style="width:100%;text-align:right;border:0;cursor:pointer" onclick="m20ViewNote('+n.id+')"><b>'+icon+' '+esc(n.title||'بدون عنوان')+'</b><small>'+esc(n.job||'بدون پروژه')+' — '+esc(n.date||'')+' — '+esc(n.tag||'')+'</small>'+(n.type==='note'?'<div class="m20-preview">'+esc((n.text||'').slice(0,180))+'</div>':(n.image?'<img src="'+n.image+'" style="width:100%;max-height:150px;object-fit:contain;margin-top:6px;border-radius:7px">':'<div class="m20-preview">یادداشت دستی / کروکی</div>'))+'</button>'}).join('')+'</div>';
 el('m20Body').innerHTML=html
}
window.m20ViewNote=function(id){load();noteViewer(id)}

function archive(){
 load();var body=el('m20Body');body.innerHTML='<h3>🗃️ آرشیو نسخه‌های قابل ویرایش</h3><div class="m20-meta">در اینجا آخرین نسخه ذخیره‌شده هر بخش را می‌بینی؛ هر مورد را باز کن، ویرایش کن و دوباره خروجی بگیر. اطلاعات روی همین مرورگر و گوشی ذخیره می‌شود.</div><div class="m20-btns"><button class="btn primary" type="button" onclick="m20ExportArchive()">⬇️ پشتیبان‌گیری</button></div><input id="m20Search" placeholder="جستجو در آرشیو نسخه‌ها"><div id="m20ArchiveList" class="m20-note-list"></div>';el('m20Search').oninput=m20RenderArchive;m20RenderArchive()
}
window.m20ExportArchive=function(){try{var data={app:'دفتر مهندس',version:1,exportedAt:new Date().toISOString(),menuVersions:JSON.parse(localStorage.getItem('m20_menu_versions_v1')||'{}'),notes:state.notes.filter(function(n){return n.type!=='activity'})};var blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='دفتر-مهندس-نسخه-های-آرشیو.json';document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(url)},1500);toastMsg('پشتیبان نسخه‌های آرشیو آماده شد ✓')}catch(e){alert('تهیه پشتیبان ناموفق بود: '+e.message)}};
(function(){
 var STORE='m20_menu_versions_v1', current='archive', labels={businesscard:'کارت ویزیت مهندس',bankcard:'کارت اطلاعات بانکی',contract:'قرارداد نقشه‌برداری',invoice:'فاکتور نقشه‌برداری',letterhead:'سربرگ',sketch:'کروکی آزاد',photo:'آرشیو عکس‌ها',report:'سررسید و گزارش‌ها',accountant:'حسابداری',projectmanager:'مدیریت پروژه',note:'یادداشت جدید',notebooks:'یادداشت‌های قبلی'};
 function read(){try{return JSON.parse(localStorage.getItem(STORE)||'{}')}catch(e){return {}}}
 function write(o){try{localStorage.setItem(STORE,JSON.stringify(o));return true}catch(e){console.warn('archive version storage full',e);return false}}
 function capture(){if(!current||current==='archive'||current==='notebooks')return;var host=document.getElementById('m20Body');if(!host)return;var roots=[host];if(current==='invoice'){var ih=document.getElementById('m20InvoiceHolder');if(ih)roots.push(ih)}var fields={},canvases={};roots.forEach(function(root){root.querySelectorAll('input,select,textarea').forEach(function(x){if(!x.id||x.type==='file')return;fields[x.id]=x.type==='checkbox'?x.checked:x.value});root.querySelectorAll('canvas').forEach(function(c){if(c.id){try{canvases[c.id]=c.toDataURL('image/jpeg',.86)}catch(e){}}})});var h=host.querySelector('h2,h3,h4');var data=read();data[current]={kind:current,title:labels[current]||((h&&h.textContent)||current),savedAt:new Date().toISOString(),fields:fields,canvases:canvases};write(data);if(document.getElementById('m20ArchiveList'))window.m20RenderArchive();}
 window.m20SaveMenuVersion=capture;
 window.m20RestoreMenuVersion=function(kind){var item=read()[kind];if(!item)return;current=kind;window.m20Open(kind);setTimeout(function(){var host=document.getElementById('m20Body');if(!host)return;Object.keys(item.fields||{}).forEach(function(id){var x=document.getElementById(id);if(!x)return;if(x.type==='checkbox')x.checked=!!item.fields[id];else x.value=item.fields[id]});Object.keys(item.canvases||{}).forEach(function(id){var c=document.getElementById(id),src=item.canvases[id];if(!c||!src)return;var im=new Image();im.onload=function(){c.width=im.naturalWidth||1200;c.height=im.naturalHeight||700;var ctx=c.getContext('2d');ctx.clearRect(0,0,c.width,c.height);ctx.drawImage(im,0,0,c.width,c.height)};im.src=src});var preview={businesscard:'m20BusinessPreview',bankcard:'m20BankPreview'}[kind];if(preview&&typeof window[preview]==='function')window[preview]();Object.keys(item.canvases||{}).forEach(function(id){var c=document.getElementById(id),src=item.canvases[id];if(!c||!src)return;var im=new Image();im.onload=function(){c.width=im.naturalWidth||1200;c.height=im.naturalHeight||700;var cx=c.getContext('2d');cx.clearRect(0,0,c.width,c.height);cx.drawImage(im,0,0,c.width,c.height)};im.src=src});if(typeof scrollBody==='function')scrollBody()},220)};
 window.m20RenderArchive=function(){var host=document.getElementById('m20ArchiveList');if(!host)return;var q=(document.getElementById('m20Search')?.value||'').toLowerCase().trim(),data=read(),items=Object.keys(data).map(function(k){return data[k]}).filter(function(x){return x&&(!q||((x.title+' '+x.kind).toLowerCase().includes(q)))}).sort(function(a,b){return String(b.savedAt).localeCompare(String(a.savedAt))});if(!items.length){host.innerHTML='<div class="m20-meta">هنوز نسخه‌ای از منوها ذخیره نشده است. بعد از ساخت یا ویرایش هر مورد، نسخه آن به‌صورت خودکار اینجا قرار می‌گیرد.</div>';return}host.innerHTML=items.map(function(x){var date='';try{date=new Date(x.savedAt).toLocaleString('fa-IR')}catch(e){}return '<div class="m20-note-item"><b>📁 '+(x.title||labels[x.kind]||x.kind)+'</b><small>آخرین ذخیره: '+date+'</small><div class="m20-btns"><button class="btn primary" type="button" data-kind="'+x.kind+'" onclick="m20RestoreMenuVersion(this.dataset.kind)">باز کردن و ادامه ویرایش</button><button class="btn gray" type="button" data-kind="'+x.kind+'" onclick="m20DeleteMenuVersion(this.dataset.kind)">حذف نسخه</button></div></div>'}).join('')};
 window.m20DeleteMenuVersion=function(kind){if(!confirm('آخرین نسخه این بخش از آرشیو حذف شود؟'))return;var d=read();delete d[kind];write(d);window.m20RenderArchive()};
 document.addEventListener('input',function(e){if(e.target&&e.target.closest&&e.target.closest('#m20Body'))setTimeout(capture,500)},true);
 document.addEventListener('change',function(e){if(e.target&&e.target.closest&&e.target.closest('#m20Body'))setTimeout(capture,700)},true);
 document.addEventListener('click',function(e){var b=e.target&&e.target.closest?e.target.closest('#m20Body button'):null;if(!b)return;var txt=(b.textContent||'').trim();if(/باز کردن و ادامه|حذف نسخه|پشتیبان/.test(txt))return;setTimeout(capture,900)},true);
 window.m20SetArchiveCurrent=function(kind){current=kind||'archive'};
})();
window.m20DeleteNote=function(id){if(!confirm('این مورد حذف شود؟'))return;load();state.notes=state.notes.filter(function(n){return n.id!==id});save();m20RenderArchive()}

function sarresidPanel(){
 var body=el('m20Body');
 body.innerHTML='<h3>📅 سررسید مهندس ۱۴۰۵ تا ۱۴۲۰</h3><p class="m20-meta">قرارها، کارهای مهم، مهلت‌ها و یادداشت هر روز را در سررسید ثبت کن. اطلاعات سررسید در حافظهٔ همین مرورگر ذخیره می‌شود.</p><div id="m20SarresidHost" style="width:100%;overflow:hidden;border:1px solid #cbd8ce;border-radius:12px;background:#f5f8f4"></div>';
 var host=el('m20SarresidHost');
 var frame=document.createElement('iframe');
 frame.title='سررسید مهندس ۱۴۰۵ تا ۱۴۲۰';
 frame.style.cssText='display:block;width:100%;height:1250px;min-height:900px;border:0;background:#f5f8f4';
 frame.setAttribute('loading','eager');
 host.appendChild(frame);
 try{
  var bin=atob('');
  var bytes=new Uint8Array(bin.length);for(var i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);
  frame.srcdoc=new TextDecoder('utf-8').decode(bytes);
 }catch(e){host.innerHTML+='<p style="padding:12px">بارگذاری سررسید انجام نشد. لطفاً فایل را در مرورگر به‌روز باز کنید.</p>';}
}

function photoPanel(){
 var body=el('m20Body');if(!body)return;
 body.innerHTML='<h3>📸 عکس + دست‌نویس حرفه‌ای</h3><div class="m20-meta">عکس را از گالری انتخاب کن یا همان‌جا عکس بگیر؛ سپس مثل کروکی آزاد روی تصویر ترسیم و نشانه‌گذاری کن.</div><div class="m20-photo-box"><div class="m20-btns"><button class="btn primary" type="button" onclick="m20ChoosePhoto(false)">🖼️ انتخاب از گالری</button><button class="btn gray" type="button" onclick="m20ChoosePhoto(true)">📷 گرفتن عکس</button></div><div id="m20PhotoEditor" style="display:none"><div class="m20-sketch-pro-tools" style="margin-top:10px"><div class="m20-sketch-toolrow"><label>ابزار ترسیم</label><select id="m20PhotoTool"><option value="pen">✏️ قلم آزاد</option><option value="line">📏 خط مستقیم</option><option value="arrow">➜ پیکان</option><option value="rect">▭ مستطیل</option><option value="circle">◯ دایره</option><option value="text">T درج متن</option><option value="symbol">📍 علامت آماده</option><option value="eraser">پاک‌کن</option></select><label>رنگ</label><input id="m20PhotoColor" type="color" value="#e53935"><label>ضخامت</label><select id="m20PhotoWidth"><option value="2">نازک</option><option value="4" selected>معمولی</option><option value="7">ضخیم</option><option value="12">خیلی ضخیم</option></select></div><div class="m20-sketch-toolrow"><label>علامت آماده</label><select id="m20PhotoSymbol"><option value="point">● نقطه برداشت</option><option value="north">↑ شمال‌نما</option><option value="station">◎ ایستگاه نقشه‌برداری</option><option value="tree">♣ درخت</option><option value="building">⌂ ساختمان</option><option value="manhole">⊕ دریچه</option><option value="pole">┃ تیر برق</option><option value="benchmark">△ بنچ‌مارک</option><option value="road">═ مسیر / راه</option><option value="water">≈ آب</option><option value="cp">CP نقطه کنترل</option><option value="gnss">GNSS ایستگاه ماهواره‌ای</option><option value="traverse">TP نقطه پیمایش</option><option value="nail">میخ نقشه‌برداری</option><option value="tbm">TBM مبنای ارتفاعی موقت</option><option value="elev">Z نقطه ارتفاعی</option><option value="boundary">حد ملک</option><option value="hydrant">شیر آتش‌نشانی</option><option value="wvalve">شیر آب</option><option value="gvalve">شیر گاز</option><option value="meter">کنتور آب</option><option value="sewer">فاضلاب</option><option value="storm">آب‌های سطحی</option><option value="fence">فنس</option><option value="gate">دروازه</option><option value="wall">دیوار</option><option value="contour">خط تراز</option><option value="slope">جهت شیب</option></select></div></div><div class="m20-canvas-wrap" id="m20PhotoZoomWrap" style="overflow:hidden;max-height:65vh;background:#263238;touch-action:none"><canvas id="m20PhotoCanvas" style="display:block;width:100%;height:auto;touch-action:none;background:white;transform-origin:center center"></canvas></div><div class="m20-sketch-tools" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px"><button class="btn" type="button" onclick="m20PhotoZoomOut()">− زوم</button><button class="btn" type="button" onclick="m20PhotoZoomIn()">＋ زوم</button><button class="btn" type="button" onclick="m20PhotoZoomReset()">۱۰۰٪</button><button class="btn" type="button" onclick="m20PhotoUndo()">↶ بازگشت</button><button class="btn" type="button" style="grid-column:span 2" onclick="m20PhotoClearMarks()">🗑 پاک کردن</button><button class="btn" type="button" style="grid-column:span 2" onclick="m20PhotoDownload()">⬇️ دریافت عکس</button></div><input id="m20PhotoTitle" placeholder="عنوان عکس / محل پروژه" style="width:100%;margin-top:8px"><div class="m20-btns"><button class="btn primary" type="button" style="width:100%" onclick="m20SavePhotoNote()">💾 ذخیره در آرشیو عکس‌ها</button></div><div class="m20-meta">برای درج متن، ابزار T را انتخاب کن، متن را بنویس و با کشیدن انگشت اندازه آن را تعیین کن؛ سپس ابزار قلم آزاد خودکار فعال می‌شود. با انتخاب نوع علامت، ابزار علامت آماده خودکار فعال خواهد شد.</div></div><div id="m20PhotoPreview"></div></div>';
}
window._m20PhotoState=null;
window.m20ChoosePhoto=function(camera){var inp=el('m20PhotoInput');if(!inp)return;inp.removeAttribute('capture');if(camera)inp.setAttribute('capture','environment');inp.value='';inp.click()};
window.m20PhotoLoad=function(data){
 var p=el('m20PhotoPreview'),editor=el('m20PhotoEditor');if(!p||!editor)return;
 var img=new Image();img.onload=function(){var max=2000,scale=Math.min(1,max/Math.max(img.naturalWidth,img.naturalHeight)),w=Math.max(1,Math.round(img.naturalWidth*scale)),h=Math.max(1,Math.round(img.naturalHeight*scale));var c=el('m20PhotoCanvas');c.width=w;c.height=h;var ctx=c.getContext('2d');ctx.drawImage(img,0,0,w,h);window._m20PhotoState={base:data,img:img,w:w,h:h,items:[],current:null};if(window.m20PhotoZoomReset)window.m20PhotoZoomReset();p.innerHTML='';editor.style.display='block';m20PhotoDraw();};img.onerror=function(){alert('خواندن عکس ناموفق بود. یک عکس دیگر انتخاب کن.')};img.src=data;
};
window.m20PhotoDraw=function(){var st=window._m20PhotoState,c=el('m20PhotoCanvas');if(!st||!c)return;var x=c.getContext('2d');x.clearRect(0,0,c.width,c.height);x.drawImage(st.img,0,0,c.width,c.height);(st.items||[]).forEach(function(it){m20PhotoDrawItem(x,it)});if(st.current)m20PhotoDrawItem(x,st.current)};
window.m20PhotoDrawItem=function(x,it){x.save();x.strokeStyle=it.color||'#e53935';x.fillStyle=it.color||'#e53935';x.lineWidth=it.width||5;x.lineCap='round';x.lineJoin='round';if(it.type==='path'){x.beginPath();(it.points||[]).forEach(function(p,i){if(!i)x.moveTo(p.x,p.y);else x.lineTo(p.x,p.y)});x.stroke()}else if(it.type==='line'||it.type==='arrow'){x.beginPath();x.moveTo(it.a.x,it.a.y);x.lineTo(it.b.x,it.b.y);x.stroke();if(it.type==='arrow'){var a=Math.atan2(it.b.y-it.a.y,it.b.x-it.a.x),L=Math.max(16,(it.width||5)*4);x.beginPath();x.moveTo(it.b.x,it.b.y);x.lineTo(it.b.x-L*Math.cos(a-.48),it.b.y-L*Math.sin(a-.48));x.moveTo(it.b.x,it.b.y);x.lineTo(it.b.x-L*Math.cos(a+.48),it.b.y-L*Math.sin(a+.48));x.stroke()}}else if(it.type==='rect'){x.strokeRect(it.a.x,it.a.y,it.b.x-it.a.x,it.b.y-it.a.y)}else if(it.type==='circle'){var rx=(it.b.x-it.a.x)/2,ry=(it.b.y-it.a.y)/2;x.beginPath();x.ellipse(it.a.x+rx,it.a.y+ry,Math.max(1,Math.abs(rx)),Math.max(1,Math.abs(ry)),0,0,Math.PI*2);x.stroke()}else if(it.type==='text'){x.font='bold '+Math.max(18,it.fontSize||((it.width||5)*7))+'px Tahoma';x.direction='rtl';x.textAlign='right';x.fillText(it.text||'',it.a.x,it.a.y)}else if(it.type==='symbol'){var r=Math.max(24,(it.width||7)*4.8),cx=it.a.x,cy=it.a.y;x.lineWidth=Math.max(3,(it.width||5)*.8);x.strokeStyle=it.color||'#e53935';x.fillStyle=it.color||'#e53935';x.textAlign='center';x.textBaseline='middle';if(it.symbol==='point'){x.beginPath();x.arc(cx,cy,r*.38,0,Math.PI*2);x.fill();x.beginPath();x.arc(cx,cy,r,0,Math.PI*2);x.stroke()}else if(it.symbol==='north'){x.beginPath();x.moveTo(cx,cy-r*1.5);x.lineTo(cx-r*.7,cy+r*.6);x.lineTo(cx,cy+r*.2);x.lineTo(cx+r*.7,cy+r*.6);x.closePath();x.stroke();x.font='bold '+(r*.8)+'px Arial';x.fillText('N',cx,cy+r*1.25)}else if(it.symbol==='station'||it.symbol==='manhole'){x.beginPath();x.arc(cx,cy,r,0,Math.PI*2);x.stroke();x.beginPath();x.arc(cx,cy,r*.42,0,Math.PI*2);x.stroke();if(it.symbol==='manhole'){x.beginPath();x.moveTo(cx-r*1.2,cy);x.lineTo(cx+r*1.2,cy);x.moveTo(cx,cy-r*1.2);x.lineTo(cx,cy+r*1.2);x.stroke()}}else if(it.symbol==='tree'){x.beginPath();x.arc(cx,cy-r*.35,r*.7,0,Math.PI*2);x.fill();x.fillRect(cx-r*.12,cy+r*.2,r*.24,r*.8)}else if(it.symbol==='building'){x.strokeRect(cx-r,cy-r*.8,2*r,1.6*r);x.beginPath();x.moveTo(cx-r*1.2,cy-r*.8);x.lineTo(cx,cy-r*1.5);x.lineTo(cx+r*1.2,cy-r*.8);x.stroke()}else if(it.symbol==='pole'){x.beginPath();x.moveTo(cx,cy-r*1.4);x.lineTo(cx,cy+r*1.4);x.moveTo(cx-r*.8,cy-r*.8);x.lineTo(cx+r*.8,cy-r*.8);x.stroke()}else if(it.symbol==='benchmark'){x.beginPath();x.moveTo(cx,cy-r);x.lineTo(cx-r,cy+r);x.lineTo(cx+r,cy+r);x.closePath();x.stroke();x.beginPath();x.arc(cx,cy+r*.25,r*.18,0,Math.PI*2);x.fill()}else if(it.symbol==='road'||it.symbol==='water'){x.beginPath();for(var si=0;si<3;si++){var yy=cy+(si-1)*r*.55;x.moveTo(cx-r,yy);if(it.symbol==='road'){x.lineTo(cx+r,yy)}else{x.quadraticCurveTo(cx-r*.4,yy-r*.5,cx,yy);x.quadraticCurveTo(cx+r*.4,yy+r*.5,cx+r,yy)}}x.stroke()}else if(['cp','gnss','traverse','nail','tbm','elev','boundary','hydrant','wvalve','gvalve','meter','sewer','storm','fence','gate','wall','contour','slope'].indexOf(it.symbol)>=0){
 var labels={cp:'CP',gnss:'GNSS',traverse:'TP',nail:'✚',tbm:'TBM',elev:'Z',boundary:'حد',hydrant:'H',wvalve:'W',gvalve:'G',meter:'M',sewer:'S',storm:'D',fence:'╫',gate:'╬',wall:'▰',contour:'∿',slope:'↘'};
 x.beginPath();x.arc(cx,cy,r,0,Math.PI*2);x.stroke();
 x.font='bold '+Math.max(16,r*.85)+'px Tahoma';x.textAlign='center';x.textBaseline='middle';x.fillText(labels[it.symbol]||'•',cx,cy);
 if(it.symbol==='boundary'||it.symbol==='fence'||it.symbol==='wall'||it.symbol==='contour'){x.beginPath();x.moveTo(cx-r*1.7,cy+r*1.5);x.lineTo(cx+r*1.7,cy+r*1.5);x.stroke()}
 if(it.symbol==='slope'){x.beginPath();x.moveTo(cx-r,cy+r);x.lineTo(cx+r,cy-r);x.lineTo(cx+r*.35,cy-r);x.moveTo(cx+r,cy-r);x.lineTo(cx+r,cy-r*.35);x.stroke()}
 }}x.restore()};
(function(){
 var pts={},pinch=null,photoZoom=1,pendingPhotoText=null;
 function point(e){var c=el('m20PhotoCanvas'),r=c.getBoundingClientRect();return{x:(e.clientX-r.left)*c.width/r.width,y:(e.clientY-r.top)*c.height/r.height}}
 function opts(){return{tool:el('m20PhotoTool')?.value||'pen',color:el('m20PhotoColor')?.value||'#e53935',width:Number(el('m20PhotoWidth')?.value||4)}}
 // انتخاب علامت، ابزار را خودکار فعال می‌کند؛ انتخاب متن فقط یک‌بار متن را می‌گیرد و سپس به قلم آزاد برمی‌گردد.
 document.addEventListener('change',function(e){
  if(e.target&&e.target.id==='m20PhotoSymbol'){var t=el('m20PhotoTool');if(t)t.value='symbol';return}
  if(e.target&&e.target.id==='m20PhotoTool'&&e.target.value==='text'){
   var tool=e.target,txt=prompt('متن دلخواه را وارد کن:');
   if(txt&&txt.trim()) pendingPhotoText={text:txt.trim(),color:el('m20PhotoColor')?.value||'#e53935',width:Number(el('m20PhotoWidth')?.value||4)};
   else pendingPhotoText=null;
   tool.value='pen';
  }
 });
 function applyZoom(){var c=el('m20PhotoCanvas');if(c)c.style.transform='scale('+photoZoom+')'}
 window.m20PhotoZoomIn=function(){photoZoom=Math.min(4,photoZoom*1.25);applyZoom()};window.m20PhotoZoomOut=function(){photoZoom=Math.max(.5,photoZoom/1.25);applyZoom()};window.m20PhotoZoomReset=function(){photoZoom=1;applyZoom()};
 document.addEventListener('pointerdown',function(e){var c=e.target;if(!c||c.id!=='m20PhotoCanvas')return;var st=window._m20PhotoState;if(!st)return;e.preventDefault();c.setPointerCapture&&c.setPointerCapture(e.pointerId);pts[e.pointerId]={x:e.clientX,y:e.clientY};var ids=Object.keys(pts);if(ids.length>=2){st.current=null;c._m20Drawing=false;var a=pts[ids[0]],b=pts[ids[1]];pinch={d:Math.max(1,Math.hypot(a.x-b.x,a.y-b.y)),z:photoZoom};return}var o=opts(),pt=point(e);if(pendingPhotoText){var tx=pendingPhotoText;pendingPhotoText=null;c._m20TextSizing={text:tx.text,a:pt,color:tx.color,width:tx.width,startY:e.clientY};c._m20Drawing=true;st.current=null;return}if(o.tool==='eraser'){if(st.items.length)st.items.pop();m20PhotoDraw();return}if(o.tool==='text'){return}if(o.tool==='symbol'){var symSel=el('m20PhotoSymbol'),sym=(symSel&&symSel.value)||'point';var mark={type:'symbol',a:pt,symbol:sym,color:o.color,width:Math.max(o.width,7)};st.items.push(mark);st.current=null;m20PhotoDraw();return}st.current={type:(o.tool==='pen'?'path':o.tool),points:[pt],a:pt,b:pt,color:o.color,width:o.width};c._m20Drawing=true;
 });
 document.addEventListener('pointermove',function(e){var c=el('m20PhotoCanvas'),st=window._m20PhotoState;if(pts[e.pointerId])pts[e.pointerId]={x:e.clientX,y:e.clientY};var ids=Object.keys(pts);if(pinch&&ids.length>=2){var a=pts[ids[0]],b=pts[ids[1]],d=Math.max(1,Math.hypot(a.x-b.x,a.y-b.y));photoZoom=Math.max(.5,Math.min(4,pinch.z*d/pinch.d));applyZoom();e.preventDefault();return}if(!c||!c._m20Drawing||!st)return;e.preventDefault();if(c._m20TextSizing){var sz=Math.max(18,Math.min(120,Math.abs(e.clientY-c._m20TextSizing.startY)*1.8||30));c._m20TextSizing.fontSize=sz;st.current={type:'text',a:c._m20TextSizing.a,text:c._m20TextSizing.text,color:c._m20TextSizing.color,width:c._m20TextSizing.width,fontSize:sz};m20PhotoDraw();return}if(!st.current)return;var pt=point(e),it=st.current;if(it.type==='path')it.points.push(pt);else it.b=pt;m20PhotoDraw()});
 function finish(e){var c=el('m20PhotoCanvas'),st=window._m20PhotoState;delete pts[e.pointerId];if(Object.keys(pts).length<2)pinch=null;if(!c||!c._m20Drawing||!st)return;c._m20Drawing=false;if(c._m20TextSizing){var tx=c._m20TextSizing;c._m20TextSizing=null;st.current=null;st.items.push({type:'text',a:tx.a,text:tx.text,color:tx.color,width:tx.width,fontSize:tx.fontSize||30});var tool=el('m20PhotoTool');if(tool)tool.value='pen';m20PhotoDraw();return}if(st.current){if(st.current.type==='path'&&st.current.points.length===1)st.current.points.push(st.current.points[0]);st.items.push(st.current);st.current=null;m20PhotoDraw()}}
 document.addEventListener('pointerup',finish);document.addEventListener('pointercancel',finish);document.addEventListener('lostpointercapture',finish,true);
})();
window.m20PhotoUndo=function(){var s=window._m20PhotoState;if(s&&s.items.length){s.items.pop();m20PhotoDraw()}};
window.m20PhotoClearMarks=function(){var s=window._m20PhotoState;if(s&&confirm('همه نوشته‌ها و علامت‌ها پاک شوند؟')){s.items=[];m20PhotoDraw()}};
window.m20PhotoFlatten=function(){var c=el('m20PhotoCanvas');if(!c)return null;var out=document.createElement('canvas');out.width=c.width;out.height=c.height;out.getContext('2d').drawImage(c,0,0);return out};
window.m20PhotoDownload=function(){var c=m20PhotoFlatten();if(!c)return;var a=document.createElement('a');a.href=c.toDataURL('image/jpeg',.94);a.download='عکس-نشانه-گذاری-شده.jpg';a.click()};
window.m20SavePhotoNote=function(){var c=m20PhotoFlatten();if(!c)return;load();state.notes.unshift({id:Date.now(),title:(el('m20PhotoTitle')?.value||'عکس پروژه').trim()||'عکس پروژه',tag:'عکس + دست‌نویس',job:job(),date:now(),type:'photo',image:c.toDataURL('image/jpeg',.9),text:'عکس نشانه‌گذاری‌شده'});save();toastMsg('عکس و دست‌نویس در یادداشت‌های قبلی و آرشیو ذخیره شد ✓');m20Open('notebooks')};

function sketchPanel(){
 var body=el('m20Body');if(!body)return;
 body.innerHTML='<h3>🗺️ کروکی آزاد حرفه‌ای</h3><div class="m20-row"><input id="m20SketchTitle" placeholder="عنوان کروکی"><input id="m20SketchTag" placeholder="محل / برچسب"></div>'+ 
 '<div class="m20-sketch-pro-tools"><div class="m20-sketch-toolrow"><label>ابزار</label><select id="m20SketchTool"><option value="pen">✏️ قلم آزاد</option><option value="line">📏 خط مستقیم</option><option value="rect">▭ مستطیل</option><option value="circle">◯ دایره</option><option value="arrow">➜ پیکان</option><option value="pan">✋ جابجایی صفحه</option><option value="symbol">📍 درج علامت</option></select><label>رنگ قلم</label><input id="m20SketchColor" type="color" value="#202020"><label>ضخامت</label><select id="m20SketchWidth"><option value="2">نازک</option><option value="4" selected>معمولی</option><option value="7">ضخیم</option><option value="11">خیلی ضخیم</option></select></div>'+ 
 '<div class="m20-sketch-toolrow"><label>علامت آماده</label><select id="m20SketchSymbol"><option value="point">● نقطه برداشت</option><option value="north">↑ شمال‌نما</option><option value="station">◎ ایستگاه نقشه‌برداری</option><option value="tree">♣ درخت</option><option value="building">⌂ ساختمان</option><option value="manhole">⊕ دریچه</option><option value="pole">┃ تیر برق</option><option value="benchmark">△ بنچ‌مارک</option><option value="road">═ مسیر / راه</option><option value="water">≈ آب</option><option value="cp">CP نقطه کنترل</option><option value="gnss">GNSS ایستگاه ماهواره‌ای</option><option value="traverse">TP نقطه پیمایش</option><option value="nail">میخ نقشه‌برداری</option><option value="tbm">TBM مبنای ارتفاعی موقت</option><option value="elev">Z نقطه ارتفاعی</option><option value="boundary">حد ملک</option><option value="hydrant">شیر آتش‌نشانی</option><option value="wvalve">شیر آب</option><option value="gvalve">شیر گاز</option><option value="meter">کنتور آب</option><option value="sewer">فاضلاب</option><option value="storm">آب‌های سطحی</option><option value="fence">فنس</option><option value="gate">دروازه</option><option value="wall">دیوار</option><option value="contour">خط تراز</option><option value="slope">جهت شیب</option></select><label>زمینه</label><select id="m20SketchPaper"><option value="blank">سفید ساده</option><option value="grid">شبکه مربعی</option><option value="soil">خاکی</option><option value="dark">تیره</option><option value="darkgrid">تیره شبکه‌دار</option><option value="soilgrid">خاکی شبکه‌دار</option><option value="table">جدول‌بندی ریز</option><option value="sheet">شیت A4 مهندسی</option></select></div></div>'+ 
 '<div class="m20-canvas-wrap m20-infinite-wrap" id="m20SketchWrap"><canvas id="m20SketchCanvas" style="display:block;width:100%;height:100%;background:#fff;touch-action:none"></canvas><div class="m20-infinite-hint">فضای ترسیم نامحدود · دو انگشت برای زوم و حرکت · ابزار جابجایی برای کشیدن صفحه</div></div>'+ 
 '<div class="m20-sketch-tools"><button class="btn" type="button" id="m20SketchZoomOut" aria-label="کوچک‌نمایی">− زوم</button><button class="btn" type="button" id="m20SketchZoomIn" aria-label="بزرگ‌نمایی">＋ زوم</button><button class="btn" type="button" id="m20SketchZoomReset">نمای ۱۰۰٪</button><button class="btn" type="button" id="m20SketchUndo">↶ بازگشت</button><span id="m20SketchZoomReadout">۱۰۰٪</span></div>'+ 
 '<div class="m20-btns"><button class="btn primary" type="button" onclick="m20SaveSketch()">💾 ذخیره کروکی</button><button class="btn primary" type="button" onclick="m20ExportSketchPdf()">📄 خروجی PDF</button><button class="btn gray" type="button" onclick="m20ClearSketch()">🗑️ پاک‌کردن ترسیم</button></div><div class="m20-meta">در حالت شیت A4، کادر و جدول مشخصات مهندسی نمایش داده می‌شود. حالت جدول‌بندی برای ترسیم دقیق و مرتب مناسب است.</div>';
 var c=el('m20SketchCanvas'),wrap=el('m20SketchWrap'),ctx=c&&c.getContext('2d');if(!c||!wrap||!ctx)return;
 var strokes=[],current=null,pointers={},zoom=1,camX=0,camY=0,start=null,panStart=null,gesture=null;
 function size(){var r=wrap.getBoundingClientRect(),w=Math.max(320,Math.round(r.width)),h=Math.max(300,Math.round(r.height));if(c.width!==w||c.height!==h){c.width=w;c.height=h;draw()}}
 function val(id,def){var x=el(id);return x&&x.value!==''?x.value:def}
 function world(p){return{x:(p.x-camX)/zoom,y:(p.y-camY)/zoom}}
 function screen(e){var r=c.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top}}
 function symbol(ctx,s,x,y,color){ctx.save();ctx.translate(x,y);ctx.strokeStyle=color;ctx.fillStyle=color;ctx.lineWidth=3/zoom;ctx.font=(22/zoom)+'px Arial';ctx.textAlign='center';ctx.textBaseline='middle';var chars={point:'●',north:'↑',station:'◎',tree:'♣',building:'⌂',manhole:'⊕',pole:'┃',benchmark:'△',road:'═',water:'≈',cp:'CP',gnss:'GNSS',traverse:'TP',nail:'✚',tbm:'TBM',elev:'Z',boundary:'┄',hydrant:'H',wvalve:'W',gvalve:'G',meter:'M',sewer:'S',storm:'D',fence:'╫',gate:'╬',wall:'▰',contour:'∿',slope:'↘'};ctx.fillText(chars[s]||'●',0,0);ctx.restore()}
 function drawGrid(){var mode=val('m20SketchPaper','blank');if(mode==='blank'||mode==='soil'||mode==='dark')return;var left=-camX/zoom,top=-camY/zoom,right=(c.width-camX)/zoom,bottom=(c.height-camY)/zoom,step=mode==='table'?80:40;ctx.save();ctx.strokeStyle=(mode==='darkgrid')?'rgba(220,232,238,.19)':(mode==='soilgrid'?'rgba(86,66,39,.22)':(mode==='table'?'#d5dce8':'#e4e9e3'));ctx.lineWidth=1/zoom;ctx.beginPath();for(var x=Math.floor(left/step)*step;x<right;x+=step){ctx.moveTo(x,top);ctx.lineTo(x,bottom)}for(var y=Math.floor(top/step)*step;y<bottom;y+=step){ctx.moveTo(left,y);ctx.lineTo(right,y)}ctx.stroke();if(mode==='table'){ctx.strokeStyle='#b9c8dc';ctx.lineWidth=1.3/zoom;var major=step*5;ctx.beginPath();for(var xx=Math.floor(left/major)*major;xx<right;xx+=major){ctx.moveTo(xx,top);ctx.lineTo(xx,bottom)}for(var yy=Math.floor(top/major)*major;yy<bottom;yy+=major){ctx.moveTo(left,yy);ctx.lineTo(right,yy)}ctx.stroke()}ctx.restore();if(mode==='sheet'){ctx.save();ctx.translate(-560,-395);ctx.strokeStyle='#293b55';ctx.lineWidth=3/zoom;ctx.strokeRect(0,0,1120,790);ctx.lineWidth=1.5/zoom;ctx.strokeRect(12,12,1096,766);ctx.beginPath();ctx.moveTo(0,700);ctx.lineTo(1120,700);ctx.moveTo(720,700);ctx.lineTo(720,790);ctx.moveTo(920,700);ctx.lineTo(920,790);ctx.stroke();ctx.fillStyle='#293b55';ctx.font=(18/zoom)+'px Tahoma';ctx.fillText('عنوان کروکی: '+(el('m20SketchTitle')?.value||''),735,730);ctx.font=(13/zoom)+'px Tahoma';ctx.fillText('تهیه‌کننده: دفتر مهندس',735,760);ctx.fillText('تاریخ: '+(new Date().toLocaleDateString('fa-IR')),935,745);ctx.restore()}}
 function drawItem(it){ctx.save();ctx.strokeStyle=it.color||'#202020';ctx.fillStyle=it.color||'#202020';ctx.lineWidth=(it.width||4)/zoom;ctx.lineCap='round';ctx.lineJoin='round';var a=it.a,b=it.b;if(it.type==='path'&&it.points.length){ctx.beginPath();ctx.moveTo(it.points[0].x,it.points[0].y);for(var i=1;i<it.points.length;i++)ctx.lineTo(it.points[i].x,it.points[i].y);ctx.stroke()}else if(it.type==='line'||it.type==='arrow'){ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();if(it.type==='arrow'){var ang=Math.atan2(b.y-a.y,b.x-a.x),len=15/zoom;ctx.beginPath();ctx.moveTo(b.x,b.y);ctx.lineTo(b.x-len*Math.cos(ang-.5),b.y-len*Math.sin(ang-.5));ctx.moveTo(b.x,b.y);ctx.lineTo(b.x-len*Math.cos(ang+.5),b.y-len*Math.sin(ang+.5));ctx.stroke()}}else if(it.type==='rect'){ctx.strokeRect(a.x,a.y,b.x-a.x,b.y-a.y)}else if(it.type==='circle'){var dx=b.x-a.x,dy=b.y-a.y;ctx.beginPath();ctx.ellipse(a.x,a.y,Math.abs(dx),Math.abs(dy),0,0,Math.PI*2);ctx.stroke()}else if(it.type==='symbol'){symbol(ctx,it.symbol,a.x,a.y,it.color||'#202020')}ctx.restore()}
 function draw(){if(!ctx)return;ctx.setTransform(1,0,0,1,0,0);var paper=val('m20SketchPaper','blank');ctx.fillStyle=paper==='soil'||paper==='soilgrid'?'#c8b38b':(paper==='dark'||paper==='darkgrid'?'#202a32':'#fff');ctx.fillRect(0,0,c.width,c.height);ctx.save();ctx.translate(camX,camY);ctx.scale(zoom,zoom);drawGrid();for(var i=0;i<strokes.length;i++)drawItem(strokes[i]);if(current)drawItem(current);ctx.restore();var z=el('m20SketchZoomReadout');if(z)z.textContent=Math.round(zoom*100)+'٪';}
 function setZoom(n,px,py){var p=px==null?{x:c.width/2,y:c.height/2}:px,wx=(p.x-camX)/zoom,wy=(p.y-camY)/zoom;zoom=Math.max(.08,Math.min(30,n));camX=p.x-wx*zoom;camY=p.y-wy*zoom;draw()}
 function down(e){e.preventDefault();c.setPointerCapture&&c.setPointerCapture(e.pointerId);var p=screen(e);pointers[e.pointerId]=p;var keys=Object.keys(pointers);if(keys.length>=2){current=null;var p1=pointers[keys[0]],p2=pointers[keys[1]];gesture={d:Math.hypot(p2.x-p1.x,p2.y-p1.y)||1,zoom:zoom,mid:{x:(p1.x+p2.x)/2,y:(p1.y+p2.y)/2},camX:camX,camY:camY};return}var tool=val('m20SketchTool','pen');if(tool==='pan'){panStart={p:p,cx:camX,cy:camY};return}var w=world(p),color=val('m20SketchColor','#202020'),width=Number(val('m20SketchWidth','4'));if(tool==='symbol'){current={type:'symbol',a:w,b:w,symbol:val('m20SketchSymbol','point'),color:color,width:width};strokes.push(current);current=null;draw();return}if(tool==='pen')current={type:'path',points:[w],color:color,width:width};else current={type:tool,a:w,b:w,color:color,width:width};start=w;draw()}
 function move(e){if(!pointers[e.pointerId])return;e.preventDefault();pointers[e.pointerId]=screen(e);var keys=Object.keys(pointers);if(keys.length>=2&&gesture){var p1=pointers[keys[0]],p2=pointers[keys[1]],mid={x:(p1.x+p2.x)/2,y:(p1.y+p2.y)/2},d=Math.hypot(p2.x-p1.x,p2.y-p1.y)||1,ratio=d/gesture.d;zoom=Math.max(.08,Math.min(30,gesture.zoom*ratio));var wx=(gesture.mid.x-gesture.camX)/gesture.zoom,wy=(gesture.mid.y-gesture.camY)/gesture.zoom;camX=mid.x-wx*zoom;camY=mid.y-wy*zoom;draw();return}if(!current)return;var pt=world(pointers[e.pointerId]);if(current.type==='path')current.points.push(pt);else current.b=pt;draw()}
 function up(e){delete pointers[e.pointerId];if(Object.keys(pointers).length<2)gesture=null;if(current){if(current.type==='path'&&current.points.length===1)current.points.push(current.points[0]);strokes.push(current);current=null;draw()}panStart=null}
 c.onpointerdown=down;c.onpointermove=function(e){if(panStart&&pointers[e.pointerId]){var p=screen(e);camX=panStart.cx+(p.x-panStart.p.x);camY=panStart.cy+(p.y-panStart.p.y);pointers[e.pointerId]=p;draw();return}move(e)};c.onpointerup=up;c.onpointercancel=up;c.addEventListener('wheel',function(e){e.preventDefault();var p=screen(e);setZoom(zoom*(e.deltaY<0?1.18:.85),p)},{passive:false});
 el('m20SketchZoomOut').onclick=function(){setZoom(zoom*.75)};el('m20SketchZoomIn').onclick=function(){setZoom(zoom*1.33)};el('m20SketchZoomReset').onclick=function(){zoom=1;camX=c.width/2;camY=c.height/2;draw()};el('m20SketchUndo').onclick=function(){if(strokes.length){strokes.pop();draw();toastMsg('آخرین ترسیم برگشت داده شد ✓')}};el('m20SketchPaper').onchange=draw;el('m20SketchSymbol').onchange=function(){var t=el('m20SketchTool');if(t)t.value='symbol';var h=wrap.querySelector('.m20-infinite-hint');if(h)h.textContent='علامت انتخاب شد؛ حالا روی محل دلخواه در صفحه بزن تا درج شود.'};el('m20SketchTool').onchange=function(){var h=wrap.querySelector('.m20-infinite-hint');if(h)h.textContent=this.value==='symbol'?'علامت آماده را انتخاب کن و روی محل دلخواه صفحه بزن.':(this.value==='pan'?'برای جابجایی، صفحه را بکش. برای زوم از دو انگشت استفاده کن.':'فضای ترسیم نامحدود · دو انگشت برای زوم و حرکت · ابزار جابجایی برای کشیدن صفحه')};el('m20SketchTitle').oninput=function(){if(val('m20SketchPaper','')==='sheet')draw()};
 window.m20SketchClear=function(){strokes=[];current=null;zoom=1;camX=c.width/2;camY=c.height/2;draw()};window.m20SketchUndo=function(){if(strokes.length){strokes.pop();draw()}};size();camX=c.width/2;camY=c.height/2;draw();if(window.ResizeObserver){var ro=new ResizeObserver(size);ro.observe(wrap)}
}

window.m20ClearSketch=function(){if(window.m20SketchClear)window.m20SketchClear()}
window.m20ExportSketchPdf=function(){
 var c=el('m20SketchCanvas');if(!c)return false;
 try{
  var title=(el('m20SketchTitle')?.value||'کروکی آزاد').trim()||'کروکی آزاد';
  var tag=(el('m20SketchTag')?.value||'').trim();
  var image=c.toDataURL('image/png');
  var safe=function(v){return String(v).replace(/[&<>"']/g,function(ch){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]})};
  var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+safe(title)+'</title><style>@page{size:A4 portrait;margin:8mm}*{box-sizing:border-box}html,body{margin:0;padding:0;font-family:Tahoma,Arial,sans-serif;color:#17212b}body{height:281mm;display:flex;flex-direction:column;overflow:hidden}.head{flex:0 0 auto;border-bottom:1px solid #87939b;padding:0 0 5px;margin:0 0 6px}.head h2{font-size:15px;margin:0 0 4px}.meta{font-size:9px;color:#59636b}.drawing{width:100%;flex:1 1 auto;min-height:0;height:auto;display:flex;align-items:center;justify-content:center;overflow:hidden}.drawing img{display:block;width:auto;height:auto;max-width:100%;max-height:100%;object-fit:contain;border:1px solid #c6cdd1}.actions{text-align:center;margin:12px 0}.actions button{font:bold 14px Tahoma;padding:10px 22px;border:0;border-radius:8px;background:#145b38;color:white}@media print{html,body{width:194mm;height:281mm;margin:0!important;padding:0!important;overflow:hidden;-webkit-print-color-adjust:exact;print-color-adjust:exact}.actions{display:none}.drawing{flex:1 1 auto;height:auto;min-height:0;break-inside:avoid;page-break-inside:avoid}.drawing img{max-width:100%;max-height:100%;object-fit:contain}}</style></head><body><div class="head"><h2>'+safe(title)+'</h2><div class="meta">'+(tag?'محل / برچسب: '+safe(tag)+'　 |　 ':'')+'تاریخ تهیه: '+safe(new Date().toLocaleDateString('fa-IR'))+'　 |　 دفتر مهندس</div></div><div class="drawing"><img src="'+image+'" alt="کروکی پروژه"></div><div class="actions"><button onclick="window.focus();window.print()">چاپ / ذخیره PDF</button></div><script>window.onload=function(){setTimeout(function(){window.focus()},250)};<\/script></body></html>';
  /* Use the exact same native Android/PDF print route as the invoice first. */
  if(typeof window.miladgeoM17PrintHtml==='function'){
   var printed=window.miladgeoM17PrintHtml(html,title+'.pdf');
   if(printed!==false){if(typeof toastMsg==='function')toastMsg('پیش‌نمایش چاپ باز شد؛ برای PDF گزینه «ذخیره به‌صورت PDF» را انتخاب کن.');return false;}
  }
  /* Browser fallback mirrors the invoice print flow. */
  var w=null;try{w=window.open('','_blank')}catch(e){}
  if(!w){alert('مرورگر پنجره چاپ را مسدود کرد؛ اجازه بازشدن پنجره را بده و دوباره امتحان کن.');return false;}
  w.document.open();w.document.write(html);w.document.close();
  setTimeout(function(){try{w.focus();w.print()}catch(e){}},700);
  return false;
 }catch(e){console.error('M20 sketch PDF export',e);alert('ساخت پیش‌نمایش PDF ناموفق بود: '+(e&&e.message?e.message:e));return false;}
};
window.m20SaveSketch=function(){var c=el('m20SketchCanvas');if(!c)return;load();state.notes.unshift({id:Date.now(),title:(el('m20SketchTitle')?.value||'کروکی آزاد').trim()||'کروکی آزاد',tag:(el('m20SketchTag')?.value||'').trim(),job:job(),date:now(),type:'sketch',image:c.toDataURL('image/png'),text:'کروکی دستی'});save();toastMsg('کروکی در یادداشت‌های قبلی و آرشیو ذخیره شد ✓');m20Open('notebooks')}

function letterheadPanel(){
 var b=el('m20Body');if(!b)return;
 b.innerHTML='<div class="m20-panel" dir="rtl"><h3 style="font-size:20px">📄 سازنده سربرگ شرکت</h3><div class="m20-meta">لوگو، مشخصات نامه در سربرگ سمت چپ، متن نامه و مهر را تنظیم کن؛ سپس چاپ یا ذخیره PDF را بزن.</div>'+
 '<div class="m20-row"><div><label>نام شرکت</label><input id="m20lhCompany" placeholder="نام شرکت / سازمان"></div><div><label>شماره نامه</label><input id="m20lhNo" placeholder="شماره"></div></div><div class="m20-row"><div><label>تاریخ</label><input id="m20lhDate" placeholder="۱۴۰۵/۰۱/۰۱"></div><div><label>گیرنده</label><input id="m20lhTo" placeholder="مدیریت محترم ..."></div></div>'+
 '<label>موضوع نامه</label><input id="m20lhSubject" placeholder="موضوع نامه"><label>لوگوی شرکت</label><input id="m20lhLogo" type="file" accept="image/*"><div class="m20-row"><div><label>جای لوگو</label><select id="m20lhLogoPos"><option value="center" selected>دقیقاً وسط صفحه</option><option value="right">بالا سمت راست</option></select></div><div><label>نوع فونت متن اصلی</label><select id="m20lhFont"><option value="Tahoma">Tahoma</option><option value="Arial">Arial</option><option value="Times New Roman">Times New Roman</option><option value="Vazirmatn">Vazirmatn</option><option value="Courier New">Courier New</option></select></div></div><div class="m20-row"><div><label>اندازه فونت متن (px)</label><select id="m20lhSize"><option>12</option><option>14</option><option selected>16</option><option>18</option><option>20</option><option>22</option><option>24</option><option>28</option><option>32</option></select></div><div><label>نشانی و تلفن شرکت</label><input id="m20lhAddress" placeholder="نشانی | تلفن"></div></div><div class="m20-row"><div><label>حاشیهٔ کامل دور برگه</label><select id="m20lhVLine"><option value="none">بدون خط</option><option value="simple">ساده</option><option value="double">دوبل</option><option value="dashed">خط‌چین</option></select></div><div><label>فاصله خط از لبه (میلی‌متر)</label><select id="m20lhVGap"><option>5</option><option selected>10</option><option>15</option><option>20</option><option>25</option></select></div></div><label>متن اصلی نامه</label><textarea id="m20lhText" style="min-height:220px" placeholder="متن نامه را اینجا بنویس..."></textarea><input id="m20lhWordImportFile" type="file" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document,.doc,application/msword" style="display:none"><div style="display:grid;grid-template-columns:1fr;gap:6px;margin:7px 0 6px"><button class="btn primary" type="button" id="m20lhImportWordBtn" onclick="m20lhPickWordFile()">📂 باز کردن فایل Word</button></div><div style="display:grid;grid-template-columns:1fr;gap:6px;margin:7px 0 10px"><button class="btn primary" type="button" id="m20lhSpeechBtn" onclick="m20lhToggleSpeech()">🎙️ تایپ صوتی فارسی</button><div id="m20lhSpeechStatus" role="status" aria-live="polite" style="font-size:11px;line-height:1.7;padding:7px;border:1px solid #687263;border-radius:6px;background:rgba(255,255,255,.35)">برای دیکته، روی دکمه بزن و اجازه میکروفون را بده.</div></div><div><label>مهر شرکت (تصویر، اختیاری)</label><input id="m20lhStamp" type="file" accept="image/*"></div><div class="m20-btns"><button class="btn primary" type="button" onclick="m20lhPreview()">👁️ پیش‌نمایش A4</button><button class="btn primary" type="button" onclick="m20lhWord()">📝 خروجی Word (.docx)</button><button class="btn primary" type="button" onclick="m20lhPrint()">🖨️ چاپ / ذخیره PDF</button><button class="btn gray" type="button" onclick="m20Open(\'archive\')">↩️ بازگشت به آرشیو</button></div><div id="m20lhPreview" style="margin-top:10px"></div></div>';
 // وارد کردن متن از فایل Word در کادر متن اصلی نامه
 window.m20lhPickWordFile=function(){var f=el('m20lhWordImportFile');if(f){f.value='';f.click()}};
 (function(){var f=el('m20lhWordImportFile');if(!f)return;f.onchange=function(){var file=f.files&&f.files[0];if(!file)return;var field=el('m20lhText');if(!field)return;var name=String(file.name||'').toLowerCase();if(!name.endsWith('.docx')){toastMsg('فعلاً فقط فایل Word با پسوند .docx پشتیبانی می‌شود. فایل را در Word با قالب .docx ذخیره کن و دوباره انتخاب کن.');f.value='';return;}if(field.value.trim()&&!confirm('متن فعلی نامه با متن فایل Word جایگزین شود؟')){f.value='';return;}var reader=new FileReader();reader.onerror=function(){toastMsg('خواندن فایل Word ناموفق بود. دوباره تلاش کن.');f.value=''};reader.onload=function(ev){var data=ev.target.result;var parse=function(JSZip){if(!JSZip){toastMsg('برای خواندن فایل Word اتصال اینترنت لازم است؛ موتور فایل باز نشد.');f.value='';return;}JSZip.loadAsync(data).then(function(zip){var doc=zip.file('word/document.xml');if(!doc)throw new Error('محتوای اصلی Word پیدا نشد');return doc.async('string')}).then(function(xml){var parsed=new DOMParser().parseFromString(xml,'application/xml');if(parsed.getElementsByTagName('parsererror').length)throw new Error('ساختار فایل قابل خواندن نیست');var paragraphs=Array.prototype.slice.call(parsed.getElementsByTagNameNS('http://schemas.openxmlformats.org/wordprocessingml/2006/main','p'));var lines=paragraphs.map(function(p){var out='';Array.prototype.forEach.call(p.childNodes,function(n){if(n.localName==='r'||n.localName==='hyperlink'||n.localName==='sdt'){Array.prototype.forEach.call(n.getElementsByTagNameNS('http://schemas.openxmlformats.org/wordprocessingml/2006/main','t'),function(t){out+=t.textContent||''});Array.prototype.forEach.call(n.getElementsByTagNameNS('http://schemas.openxmlformats.org/wordprocessingml/2006/main','tab'),function(){out+='\t'});Array.prototype.forEach.call(n.getElementsByTagNameNS('http://schemas.openxmlformats.org/wordprocessingml/2006/main','br'),function(){out+='\n'})}});return out}).filter(function(x){return x.trim()});var text=lines.join('\n');if(!text.trim()){toastMsg('متن قابل استخراجی در فایل Word پیدا نشد.');return;}field.value=text;field.dispatchEvent(new Event('input',{bubbles:true}));field.dispatchEvent(new Event('change',{bubbles:true}));toastMsg('متن فایل Word وارد کادر نامه شد ✓')}).catch(function(err){console.error('M20 Word import',err);toastMsg('خواندن فایل Word ناموفق بود. مطمئن شو فایل سالم و با قالب .docx است.');}).finally(function(){f.value=''});};if(window.JSZip){parse(window.JSZip);return;}var urls=['https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js','https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js'];var tryNext=function(i){if(i>=urls.length){parse(null);return;}var sc=document.createElement('script');sc.src=urls[i];sc.onload=function(){if(window.JSZip)parse(window.JSZip);else tryNext(i+1)};sc.onerror=function(){tryNext(i+1)};document.head.appendChild(sc)};tryNext(0)};reader.readAsArrayBuffer(file)}})();
 // تاریخ پیش‌فرض از تاریخ محلی گوشی گرفته می‌شود (تقویم شمسی).
 // تایپ صوتی فارسی فقط برای فیلد متن اصلی نامه
 window._m20lhRecognition = null;
 window._m20lhSpeechActive = false;
 window.m20lhToggleSpeech = function(){
   var field=el('m20lhText'), btn=el('m20lhSpeechBtn'), status=el('m20lhSpeechStatus');
   if(!field||!btn||!status)return;
   if(window._m20lhSpeechActive && window._m20lhRecognition){try{window._m20lhRecognition.stop()}catch(e){}return;}
   var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
   if(!SR){status.textContent='این مرورگر قابلیت تشخیص گفتار را پشتیبانی نمی‌کند.';return;}
   try{
     var rec=new SR(); window._m20lhRecognition=rec;
     rec.lang='fa-IR'; rec.continuous=true; rec.interimResults=true; rec.maxAlternatives=1;
     var base=field.value, finalParts=[];
     function normalize(s){return String(s||'').replace(/[\u200c\u200f\u200e]/g,' ').replace(/\s+/g,' ').trim();}
     function sameText(a,b){return normalize(a).toLocaleLowerCase('fa')===normalize(b).toLocaleLowerCase('fa');}
     // Speech services sometimes repeat a previous phrase as a new final result.
     // Merge adjacent chunks by removing only their overlapping word sequence.
     function mergeFinalParts(parts){
       var out=[];
       for(var i=0;i<parts.length;i++){
         var p=normalize(parts[i]); if(!p)continue;
         if(!out.length){out.push(p);continue;}
         var prev=out[out.length-1];
         if(sameText(prev,p))continue;
         var a=prev.split(' '), b=p.split(' '), overlap=0;
         for(var n=Math.min(a.length,b.length);n>0;n--){
           var left=a.slice(a.length-n).join(' ').toLocaleLowerCase('fa');
           var right=b.slice(0,n).join(' ').toLocaleLowerCase('fa');
           if(left===right){overlap=n;break;}
         }
         var remainder=b.slice(overlap).join(' ');
         if(remainder)out[out.length-1]=prev+' '+remainder;
       }
       return out;
     }
     rec.onstart=function(){window._m20lhSpeechActive=true;btn.textContent='⏹️ توقف تایپ صوتی';status.textContent='در حال شنیدن فارسی… صحبت کن. متن در همین کادر نامه وارد می‌شود.';};
     rec.onresult=function(event){
       // results is a session-wide list: update indexed final chunks instead of appending each event.
       for(var n=event.resultIndex||0;n<event.results.length;n++){
         var item=event.results[n], piece=normalize(item&&item[0]&&item[0].transcript);
         if(item&&item.isFinal){finalParts[n]=piece;} 
       }
       var finals=mergeFinalParts(finalParts), interim=[];
       for(var k=0;k<event.results.length;k++){
         var r=event.results[k];
         if(r&&!r.isFinal){var t=normalize(r[0]&&r[0].transcript);if(t)interim.push(t);}
       }
       var finalText=finals.join(' '), interimText=interim.join(' ');
       // Preview is rebuilt from the stable base each time, so interim hypotheses never accumulate.
       var spoken=finalText+(finalText&&interimText?' ':'')+interimText;
       field.value=base+(base&&spoken&&!/\s$/.test(base)?' ':'')+spoken;
       field.dispatchEvent(new Event('input',{bubbles:true}));field.scrollTop=field.scrollHeight;
     };
     rec.onerror=function(event){var messages={
       'not-allowed':'مرورگر یا سرویس گفتار اجازه دسترسی نداد (not-allowed). مجوز میکروفون سایت را بررسی کن؛ ممکن است سرویس در این مرورگر/WebView مسدود باشد.',
       'service-not-allowed':'سرویس تشخیص گفتار در این محیط مجاز نیست.','network':'ارتباط با سرویس آنلاین تشخیص گفتار برقرار نشد.',
       'no-speech':'صدایی تشخیص داده نشد؛ دوباره شروع کن.','audio-capture':'میکروفون در دسترس نیست.','language-not-supported':'تشخیص گفتار فارسی پشتیبانی نمی‌شود.'};
       status.textContent=messages[event.error]||('خطای تشخیص گفتار: '+event.error+'.');
     };
     rec.onend=function(){
       // Drop any interim hypothesis on stop; retain only finalized chunks.
       var finals=mergeFinalParts(finalParts), finalText=finals.join(' ');
       field.value=base+(base&&finalText&&!/\s$/.test(base)?' ':'')+finalText;
       field.dispatchEvent(new Event('input',{bubbles:true}));
       window._m20lhSpeechActive=false;btn.textContent='🎙️ تایپ صوتی فارسی';
       if(!/خطای|اجازه دسترسی|ارتباط با سرویس|میکروفون در دسترس|پشتیبانی نمی‌شود/.test(status.textContent)) status.textContent=finalText?'تایپ صوتی متوقف شد؛ متن نهایی در کادر نامه باقی مانده است.':'شنیدن متوقف شد. برای شروع دوباره روی دکمه بزن.';
       window._m20lhRecognition=null;
     };
     rec.start();
   }catch(err){window._m20lhSpeechActive=false;btn.textContent='🎙️ تایپ صوتی فارسی';status.textContent='شروع تایپ صوتی ناموفق بود: '+(err&&err.message?err.message:'خطای ناشناخته');}
 };

 var dateField=el('m20lhDate');
 function m20lhPhoneDate(){try{return new Intl.DateTimeFormat('fa-IR-u-ca-persian',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date())}catch(e){return new Date().toLocaleDateString()}}
 if(dateField&&!dateField.value)dateField.value=m20lhPhoneDate();
 window.m20lhPreview=function(){
 var g=function(id){var x=el(id);return x?x.value:''};
 var dateInput=el('m20lhDate');if(dateInput&&!dateInput.value)dateInput.value=m20lhPhoneDate();
 var esc=function(v){return String(v||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')};
 var logo=window._m20lhLogo||'',stamp=window._m20lhStamp||'';
 var recipient=g('m20lhTo').trim(),subject=g('m20lhSubject').trim();
 var vtype=g('m20lhVLine')||'none',vgap=Math.max(0,Math.min(40,Number(g('m20lhVGap')||10))),vborder=vtype==='double'?'3px double #222':vtype==='dashed'?'1px dashed #222':vtype==='simple'?'1px solid #222':'0';
 var vlines=vtype==='none'?'':'<div aria-hidden="true" style="position:absolute;top:'+vgap+'mm;bottom:'+vgap+'mm;left:'+vgap+'mm;right:'+vgap+'mm;border:'+vborder+';box-sizing:border-box;pointer-events:none"></div>';
 var html='<article id="m20lhPaper" style="position:relative;background:white;color:#111;direction:rtl;text-align:right;width:100%;max-width:794px;min-height:1123px;margin:auto;padding:70px;box-sizing:border-box;font-family:'+esc(g('m20lhFont')||'Tahoma')+';border:1px solid #bbb">'+
 vlines+'<header style="position:relative;min-height:145px;border-bottom:1px solid #aaa;padding-bottom:12px;display:flex;direction:ltr;align-items:flex-start;justify-content:flex-start">'+
 '<div style="direction:ltr;text-align:left;position:absolute;left:0;top:0;font-family:Arial,sans-serif;font-size:12px;line-height:2;min-width:120px"><div>Letter No.: '+esc(g('m20lhNo'))+'</div><div>Date: '+esc(g('m20lhDate'))+'</div></div>'+
 '<div style="position:absolute;left:50%;top:0;transform:translateX(-50%);width:65%;text-align:center;direction:rtl">'+(logo?'<img src="'+logo+'" style="display:block;margin:0 auto;max-width:130px;max-height:80px;object-fit:contain">':'')+'<h2 style="text-align:center;margin:6px 0 0;font-size:18px">'+esc(g('m20lhCompany')||'نام شرکت')+'</h2></div></header>'+
 (recipient?'<p style="margin:14px 0">گیرنده: '+esc(recipient)+'</p>':'')+
 (subject?'<p style="margin:14px 0"><b>موضوع: '+esc(subject)+'</b></p>':'')+
 '<div style="font-family:'+esc(g('m20lhFont')||'Tahoma')+';font-size:'+Number(g('m20lhSize')||16)+'px;line-height:1.9;white-space:pre-wrap;min-height:620px;margin-top:18px">'+esc(g('m20lhText'))+'</div>'+
 (stamp?'<div style="position:absolute;left:38px;bottom:95px;width:145px;min-height:95px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:flex-end"><img src="'+stamp+'" style="max-width:105px;max-height:85px;object-fit:contain"><div style="font-size:11px;margin-top:5px">محل مهر و امضا مدیرعامل</div></div>':'<div style="position:absolute;left:38px;bottom:95px;width:145px;height:70px;text-align:center;border-top:1px solid #aaa;padding-top:7px;font-size:11px">محل مهر و امضا مدیرعامل</div>')+
 '<div style="position:absolute;bottom:38px;left:38px;right:38px;border-top:1px solid #ccc;padding-top:8px;text-align:center;font-size:11px">'+esc(g('m20lhAddress'))+'</div></article>';
 el('m20lhPreview').innerHTML=html;
 };
 window.m20lhWord=function(){
  try{
   window.m20lhPreview();
   var paper=el('m20lhPaper');
   if(!paper){toastMsg('ابتدا پیش‌نمایش سربرگ ساخته نشد؛ دوباره تلاش کن.');return false;}
   var company=(el('m20lhCompany')&&el('m20lhCompany').value||'MiladGeo').trim()||'MiladGeo';
   var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta http-equiv="Content-Type" content="text/html; charset=utf-8"><title>'+company.replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})+'</title><style>@page{size:A4;margin:0}html,body{margin:0;padding:0;background:#fff}body{font-family:Tahoma,Arial,sans-serif;direction:rtl}#m20lhPaper{width:210mm!important;min-height:297mm!important;max-width:none!important;margin:0!important;box-sizing:border-box!important;page-break-after:avoid}#m20lhPaper *{box-sizing:border-box}</style></head><body>'+paper.outerHTML+'</body></html>';
   var fname=company.replace(/[\\/:*?"<>|]+/g,'_')+'_Letterhead.doc';
   return window.mgDownloadWordLikeAccountant(fname,html);
  }catch(e){console.error('M20 LETTERHEAD WORD',e);toastMsg('خروجی Word سربرگ ناموفق بود: '+(e.message||e));return false;}
 };
 window.m20lhPrint=function(){
  window.m20lhPreview();
  var paper=el('m20lhPaper');if(!paper)return false;
  /* Use Menu 17's shared Android PrintManager/PDF route, not a separate window.open flow. */
  var html='<!doctype html><html lang="fa"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>سربرگ شرکت</title><style>@page{size:A4;margin:0}html,body{margin:0!important;padding:0!important;width:210mm;min-height:297mm;background:#fff;-webkit-print-color-adjust:exact;print-color-adjust:exact}#m20lhPaper{position:relative!important;display:block!important;width:210mm!important;height:297mm!important;min-height:297mm!important;max-width:none!important;box-sizing:border-box!important;margin:0!important;padding:18mm!important;border:0!important;box-shadow:none!important;overflow:hidden!important;page-break-after:avoid!important;break-after:avoid!important}#m20lhPaper *{box-sizing:border-box}img{max-width:100%}</style></head><body>'+paper.outerHTML+'</body></html>';
  if(typeof window.miladgeoM17PrintHtml==='function'){
    var ok=window.miladgeoM17PrintHtml(html,'MiladGeo Company Letterhead PDF');
    if(ok!==false)return false;
  }
  try{if(window.AndroidBridge&&typeof window.AndroidBridge.printHtml==='function'){window.AndroidBridge.printHtml(html);return false;}}catch(e){console.error('M20 letterhead native PDF',e)}
  toastMsg('موتور خروجی PDF منوی ۱۷ در دسترس نیست');return false;
};
 [['m20lhLogo','_m20lhLogo'],['m20lhStamp','_m20lhStamp']].forEach(function(pair){var input=el(pair[0]);if(input)input.onchange=function(){var f=input.files&&input.files[0];if(!f)return;var r=new FileReader();r.onload=function(){window[pair[1]]=r.result;};r.readAsDataURL(f)}});
 scrollBody();
}
/* MILADGEO ACCOUNTING MODULE v1 — isolated local project ledger */
(function(){
 var KEY='miladgeo_accounting_projects_v1_'+(typeof MILADGEO_ACCOUNT_KEY!=='undefined'?MILADGEO_ACCOUNT_KEY:'default');
 function read(){try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){return []}}
 function write(a){try{localStorage.setItem(KEY,JSON.stringify(a));return true}catch(e){if(typeof showToast==='function')showToast('فضای ذخیره‌سازی کافی نیست؛ اطلاعات ذخیره نشد.');return false}}
 function today(){try{return new Intl.DateTimeFormat('fa-IR-u-ca-persian',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date())}catch(e){return new Date().toLocaleDateString('fa-IR')}}
 function escA(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
 function nA(v){var s=String(v||'').replace(/[۰-۹]/g,function(c){return '۰۱۲۳۴۵۶۷۸۹'.indexOf(c)}).replace(/[٠-٩]/g,function(c){return '٠١٢٣٤٥٦٧٨٩'.indexOf(c)}).replace(/[٬،,\s]/g,'');var n=Number(s);return Number.isFinite(n)&&n>0?n:0}
 function faA(n){return Number(n||0).toLocaleString('fa-IR')}
 function qtyA(x){return Math.max(1,Math.floor(nA(x&&x.quantity)||1))}
 function lineTotalA(x){return nA(x&&x.amount)*qtyA(x)}
 function catA(x){return String(x&&x.category||'عمومی')}
 var CATS=['عمومی','مصالح ساختمانی','دستمزد و حقوق','تجهیزات نقشه‌برداری','اجاره تجهیزات و دستگاه‌ها','سوخت و حمل‌ونقل','تعمیرات و نگهداری','لوازم مصرفی و ابزار','پیمانکار جزء و خدمات تخصصی','آزمایشگاه و کنترل کیفیت','طراحی و محاسبات مهندسی','مجوزها و عوارض','ایمنی و بهداشت کار','اقامت و غذا','هزینه‌های اداری و ارتباطات','بیمه و مالیات','تجهیز و برچیدن کارگاه','نظافت و جمع‌آوری پسماند','سایر هزینه‌ها'];
 function projects(){return read()}
 function saveAll(a){return write(a)}
 function active(){var b=document.getElementById('m20Body');return b&&b.dataset.accountProject||''}
 function getProject(id){return read().find(function(p){return p.id===id})}
 function addGreenStyle(){
  if(document.getElementById('m20AccountingGreenStyle'))return;
  var st=document.createElement('style');st.id='m20AccountingGreenStyle';
  st.textContent='#m20Body button{background:linear-gradient(180deg,#b9e98b 0%,#79c64e 100%)!important;border:2px solid #438333!important;color:#173b22!important;border-radius:10px!important;font-weight:800!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.65)}#m20Body button:active{background:linear-gradient(180deg,#79c64e,#58a934)!important}#m20Body input{accent-color:#65b943}#m20Body .m20-meta{color:#435b48}#m20Body table button{padding:6px 10px}';
  document.head.appendChild(st);
 }
 window.m20AccRename=function(id){
  var a=read(),p=a.find(function(x){return x.id===id});if(!p)return;
  var name=prompt('نام جدید پروژه را وارد کن:',p.name||'');if(name===null)return;name=name.trim();
  if(!name){alert('نام پروژه نمی‌تواند خالی باشد.');return;}
  p.name=name;if(write(a))renderList();
 };
 window.m20AccDeleteProject=function(id){
  var a=read(),p=a.find(function(x){return x.id===id});if(!p)return;
  if(!confirm('پروژه «'+p.name+'» و تمام هزینه‌های ثبت‌شده داخل آن حذف شود؟ این کار قابل بازگشت نیست.'))return;
  if(write(a.filter(function(x){return x.id!==id})))renderList();
 };
 function renderList(){var a=read(),b=document.getElementById('m20Body');if(!b)return;addGreenStyle();b.dataset.accountProject='';b.innerHTML='<div class="m20-meta">دفتر هزینه‌های پروژه‌ها · ذخیره خودکار روی همین دستگاه</div><section style="border:1px solid #d5e3d6;border-radius:16px;padding:15px;background:#f5faf5;margin:12px 0"><h3 style="margin:0 0 10px">＋ تعریف پروژه جدید</h3><label style="display:block;font-weight:800;margin-bottom:6px">نام پروژه</label><input id="accNewName" type="text" maxlength="120" placeholder="مثلاً پروژه برداشت زمین ..." style="width:100%;box-sizing:border-box;padding:13px;border:1px solid #b8cbbb;border-radius:10px;font-size:16px;background:white;color:#183323"><button type="button" class="btn primary" onclick="window.m20AccCreate()" style="width:100%;margin-top:10px">ساخت کارت پروژه</button></section><h3>📁 پروژه‌های ثبت‌شده ('+faA(a.length)+')</h3><div id="accProjectList">'+(a.length?a.slice().reverse().map(function(p){var total=(p.items||[]).reduce(function(s,x){return s+lineTotalA(x)},0);return '<div style="background:#fafff8;border:2px solid #4f8b42;border-radius:14px;padding:10px;margin:9px 0;color:#173a26"><button type="button" onclick="window.m20AccOpen(\''+escA(p.id)+'\')" style="display:block;width:100%;text-align:right;background:linear-gradient(#b9e78e,#76bf50);border:2px solid #438333;border-radius:10px;padding:13px;color:#173a26;font-weight:800"><b>📂 '+escA(p.name)+'</b><div style="font-size:13px;margin-top:5px">'+faA((p.items||[]).length)+' هزینه · جمع کل: '+faA(total)+' تومان</div><div style="font-size:12px;margin-top:5px">برای ورود به پروژه بزن</div></button><div style="display:flex;gap:8px;margin-top:8px"><button type="button" onclick="window.m20AccRename(\''+escA(p.id)+'\')" style="flex:1;background:#8bd45f;border:2px solid #438333;border-radius:9px;padding:9px;font-weight:800;color:#173a26">✏️ ویرایش نام</button><button type="button" onclick="window.m20AccDeleteProject(\''+escA(p.id)+'\')" style="flex:1;background:#c4e8a8;border:2px solid #438333;border-radius:9px;padding:9px;font-weight:800;color:#173a26">🗑️ حذف پروژه</button></div></div>'}).join(''):'<div class="m20-meta">هنوز پروژه‌ای ثبت نشده است. نام پروژه را وارد کن تا کارت آن ساخته شود.</div>')+'</div>';}
 window.m20AccCreate=function(){var el=document.getElementById('accNewName'),name=(el&&el.value||'').trim();if(!name){if(typeof showToast==='function')showToast('ابتدا نام پروژه را وارد کن.');else alert('ابتدا نام پروژه را وارد کن.');return}var a=read(),p={id:'p_'+Date.now()+'_'+Math.random().toString(36).slice(2,7),name:name,createdAt:today(),items:[]};a.push(p);if(!write(a))return;window.m20AccOpen(p.id)};
 window.m20AccOpen=function(id){var p=getProject(id),b=document.getElementById('m20Body');if(!p||!b)return;addGreenStyle();b.dataset.accountProject=id;var total=(p.items||[]).reduce(function(s,x){return s+lineTotalA(x)},0);b.innerHTML='<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:space-between"><h3 style="margin:4px 0">🧮 '+escA(p.name)+'</h3><button class="btn gray" type="button" onclick="window.m20AccList()">↩ پروژه‌ها</button></div><div class="m20-meta">تاریخ ایجاد: '+escA(p.createdAt||'—')+' · ذخیره خودکار</div><section style="border:1px solid #d4e2d5;background:#f6faf6;padding:13px;border-radius:15px;margin:12px 0"><h4 style="margin:0 0 10px">ثبت هزینه جدید</h4><label style="display:block;font-weight:800;margin:8px 0 5px">۱. عنوان هزینه‌کرد</label><input id="accTitle" maxlength="250" placeholder="مثلاً خرید لوازم، ایاب‌وذهاب..." style="width:100%;box-sizing:border-box;padding:12px;border:1px solid #b8cbbb;border-radius:9px;font-size:15px;background:#fff;color:#172b1d"><label style="display:block;font-weight:800;margin:10px 0 5px">۲. مبلغ هر واحد (تومان)</label><input id="accAmount" type="text" inputmode="decimal" placeholder="مبلغ به تومان" style="width:100%;box-sizing:border-box;padding:12px;border:1px solid #b8cbbb;border-radius:9px;font-size:16px;background:#fff;color:#172b1d"><label style="display:block;font-weight:800;margin:10px 0 5px">۳. تعداد</label><input id="accQuantity" type="number" inputmode="numeric" min="1" step="1" value="1" placeholder="تعداد اقلام خریداری‌شده" style="width:100%;box-sizing:border-box;padding:12px;border:1px solid #b8cbbb;border-radius:9px;font-size:16px;background:#fff;color:#172b1d"><label style="display:block;font-weight:800;margin:10px 0 5px">۴. دسته‌بندی هزینه</label><select id="accCategory" aria-label="دسته‌بندی هزینه" style="display:block;width:100%;height:56px;min-height:56px;box-sizing:border-box;padding:8px 12px;border:1px solid #b8cbbb;border-radius:9px;font-size:16px;line-height:1.5;background:#fff;color:#172b1d;direction:rtl;text-align:right;appearance:auto;-webkit-appearance:menulist;overflow:visible">'+CATS.map(function(c){return '<option style="background:#fff;color:#172b1d" value="'+escA(c)+'"'+(c==='عمومی'?' selected':'')+'>'+escA(c)+'</option>'}).join('')+'</select><label style="display:block;font-weight:800;margin:10px 0 5px">۵. تاریخ هزینه</label><input id="accDate" type="text" value="'+escA(today())+'" placeholder="تاریخ شمسی" style="width:100%;box-sizing:border-box;padding:12px;border:1px solid #b8cbbb;border-radius:9px;font-size:16px;background:#fff;color:#172b1d"><div class="m20-meta">مبلغ نهایی هر ردیف از ضرب مبلغ هر واحد در تعداد محاسبه می‌شود. تاریخ امروز به‌صورت پیش‌فرض درج شده است.</div><button type="button" class="btn primary" onclick="window.m20AccAdd()" style="width:100%;margin-top:10px">＋ ثبت و ذخیره هزینه</button></section><div style="border-radius:14px;background:#174f32;color:white;padding:15px;margin:12px 0"><div style="font-size:13px">جمع کل هزینه‌های پروژه</div><strong id="accGrandTotal" style="font-size:25px">'+faA(total)+' تومان</strong><div style="font-size:12px;opacity:.9">تعداد هزینه‌ها: '+faA((p.items||[]).length)+'</div></div><section style="border:1px solid #c9ddc9;border-radius:12px;background:#f3f9f2;padding:12px;margin:12px 0"><h4 style="margin:0 0 10px">🔎 تنظیمات خروجی</h4><label style="display:block;font-weight:800;margin:8px 0 5px">دسته‌بندی موردنظر</label><select id="accExportCategory" style="display:block;width:100%;height:48px;box-sizing:border-box;padding:8px 12px;border:1px solid #b8cbbb;border-radius:9px;font-size:15px;background:#fff;color:#172b1d;direction:rtl;text-align:right"><option value="همه">همه دسته‌بندی‌ها</option>'+CATS.map(function(c){return '<option value="'+escA(c)+'">'+escA(c)+'</option>'}).join('')+'</select><label style="display:block;font-weight:800;margin:10px 0 5px">بازه زمانی</label><select id="accExportPeriod" onchange="window.m20AccToggleDateRange()" style="display:block;width:100%;height:48px;box-sizing:border-box;padding:8px 12px;border:1px solid #b8cbbb;border-radius:9px;font-size:15px;background:#fff;color:#172b1d;direction:rtl"><option value="all">همه تاریخ‌ها</option><option value="today">امروز</option><option value="month">این ماه</option><option value="custom">بازه دلخواه</option></select><div id="accExportDateRange" style="display:none;gap:8px;margin-top:8px"><div style="flex:1"><label style="display:block;font-size:13px;margin-bottom:4px">از تاریخ</label><input id="accExportFrom" type="text" placeholder="۱۴۰۵/۰۸/۰۱" style="width:100%;box-sizing:border-box;padding:10px;border:1px solid #b8cbbb;border-radius:8px;background:#fff;color:#172b1d"></div><div style="flex:1"><label style="display:block;font-size:13px;margin-bottom:4px">تا تاریخ</label><input id="accExportTo" type="text" placeholder="۱۴۰۵/۰۸/۳۰" style="width:100%;box-sizing:border-box;padding:10px;border:1px solid #b8cbbb;border-radius:8px;background:#fff;color:#172b1d"></div></div><div class="m20-meta" style="margin-top:8px">این فیلترها فقط روی فایل خروجی اعمال می‌شوند؛ هزینه‌های ثبت‌شده و جمع کل کارت پروژه تغییر نمی‌کنند. تنظیمات مشترک برای اکسل و PDF است.</div></section><div style="display:flex;gap:8px;flex-wrap:wrap;margin:12px 0"><button type="button" class="btn primary" onclick="window.m20AccExcel()" style="flex:1;min-width:130px">📊 خروجی اکسل</button><button type="button" class="btn gray" onclick="window.m20AccPDF()" style="flex:1;min-width:130px">📄 خروجی PDF</button><button type="button" class="btn gray" onclick="window.m20AccWord()" style="flex:1;min-width:130px">📝 Word</button><button type="button" class="btn gray" onclick="window.m20AccFull()" style="flex:1;min-width:130px">📦 خروجی کامل</button></div><h4>📋 فهرست هزینه‌ها</h4><div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;min-width:440px;background:#fff"><thead><tr style="background:#e7f1e8"><th style="padding:8px;border:1px solid #c9d8cb">ردیف</th><th style="padding:8px;border:1px solid #c9d8cb">عنوان هزینه</th><th style="padding:8px;border:1px solid #c9d8cb">دسته‌بندی</th><th style="padding:8px;border:1px solid #c9d8cb">تعداد</th><th style="padding:8px;border:1px solid #c9d8cb">تاریخ</th><th style="padding:8px;border:1px solid #c9d8cb">مبلغ (تومان)</th><th style="padding:8px;border:1px solid #c9d8cb">📎</th><th style="padding:8px;border:1px solid #c9d8cb">حذف</th></tr></thead><tbody>'+(p.items||[]).map(function(x,i){return '<tr><td style="padding:7px;border:1px solid #d5e0d6;text-align:center">'+faA(i+1)+'</td><td style="padding:7px;border:1px solid #d5e0d6">'+escA(x.title)+'</td><td style="padding:7px;border:1px solid #d5e0d6;text-align:center">'+escA(catA(x))+'</td><td style="padding:7px;border:1px solid #d5e0d6;text-align:center">'+faA(qtyA(x))+'</td><td style="padding:7px;border:1px solid #d5e0d6;text-align:center">'+escA(x.date)+'</td><td style="padding:7px;border:1px solid #d5e0d6;text-align:center;white-space:nowrap">'+faA(lineTotalA(x))+'</td><td style="padding:4px;border:1px solid #d5e0d6;text-align:center"><button type="button" title="افزودن یا دیدن عکس فاکتور" style="padding:4px 7px!important;min-width:30px" onclick="window.m20AccReceipt(\''+escA(p.id)+'\',\''+escA(x.id)+'\')">'+(x.receipt?'📎📷':'📎')+'</button></td><td style="padding:7px;border:1px solid #d5e0d6;text-align:center"><button type="button" onclick="window.m20AccDelete(\''+escA(p.id)+'\',\''+escA(x.id)+'\')">حذف</button></td></tr>'}).join('')+((p.items||[]).length?'':'<tr><td colspan="8" style="padding:15px;text-align:center">هنوز هزینه‌ای ثبت نشده است.</td></tr>')+'</tbody><tfoot><tr style="background:#e7f1e8;font-weight:900"><td colspan="5" style="padding:9px;border:1px solid #c9d8cb">جمع کل</td><td colspan="3" style="padding:9px;border:1px solid #c9d8cb">'+faA(total)+' تومان</td></tr></tfoot></table></div>';try{var body=document.getElementById('m20Body'),heads=body?Array.prototype.slice.call(body.querySelectorAll('h4')):[],tableHead=heads.find(function(h){return /فهرست هزینه‌ها/.test(h.textContent)}),tableWrap=tableHead&&tableHead.nextElementSibling,exportHead=heads.find(function(h){return /تنظیمات خروجی/.test(h.textContent)}),exportSection=exportHead&&exportHead.parentElement,exportButtons=exportSection&&exportSection.nextElementSibling;if(tableHead&&tableWrap&&exportSection){exportSection.parentNode.insertBefore(tableHead,exportSection);exportSection.parentNode.insertBefore(tableWrap,exportSection);if(exportButtons&&exportButtons.querySelector('button'))exportSection.parentNode.insertBefore(exportButtons,exportSection.nextSibling)}}catch(moveErr){console.warn('ACCOUNTING_LAYOUT_MOVE',moveErr)}}
 window.m20AccAdd=function(){var id=active(),p=getProject(id);if(!p)return;var title=(document.getElementById('accTitle').value||'').trim(),amount=nA(document.getElementById('accAmount').value),quantityEl=document.getElementById('accQuantity'),quantity=Math.floor(nA(quantityEl&&quantityEl.value)),category=(document.getElementById('accCategory')&&document.getElementById('accCategory').value)||'عمومی',date=(document.getElementById('accDate').value||'').trim()||today();if(!title){alert('عنوان هزینه‌کرد را وارد کن.');return}if(!(amount>0)){alert('مبلغ معتبر را وارد کن.');return}if(!(quantity>0)){alert('تعداد را به‌صورت عدد صحیح و بیشتر از صفر وارد کن.');return}p.items=p.items||[];p.items.push({id:'e_'+Date.now()+'_'+Math.random().toString(36).slice(2,5),title:title,amount:String(amount),quantity:quantity,category:category||'عمومی',date:date});var a=read().map(function(x){return x.id===p.id?p:x});if(write(a))window.m20AccOpen(id)};
 window.m20AccReceipt=function(pid,eid){var p=getProject(pid),x=p&&(p.items||[]).find(function(v){return v.id===eid});if(!x)return;if(x.receipt){var choice=prompt('عکس فاکتور ثبت‌شده است.\n۱ = مشاهده عکس\n۲ = تغییر عکس\n۳ = حذف عکس','1');if(choice===null)return;if(choice==='1'){var b=document.getElementById('m20Body');if(b){b.innerHTML='<div style="display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin:5px 0 12px"><b>📎 عکس فاکتور: '+escA(x.title)+'</b><button class="btn gray" type="button" onclick="window.m20AccOpen(\''+escA(pid)+'\')">↩ بازگشت به حسابدار</button></div><div style="text-align:center;background:#fff;padding:8px;border-radius:10px"><img alt="عکس فاکتور" src="'+x.receipt+'" style="display:block;max-width:100%;height:auto;margin:auto"></div><button class="btn primary" type="button" style="width:100%;margin-top:12px" onclick="window.m20AccOpen(\''+escA(pid)+'\')">↩ بازگشت به حسابدار</button>';b.scrollIntoView({behavior:'smooth',block:'start'});}return}else if(choice==='3'){delete x.receipt;var aa=read().map(function(v){return v.id===pid?p:v});if(write(aa))window.m20AccOpen(pid);return}else if(choice!=='2')return}var inp=document.createElement('input');inp.type='file';inp.accept='image/*';inp.setAttribute('capture','environment');inp.onchange=function(){var f=inp.files&&inp.files[0];if(!f)return;if(!/^image\//.test(f.type)){alert('لطفاً یک عکس انتخاب کن.');return}if(f.size>20*1024*1024){alert('حجم عکس باید کمتر از ۲۰ مگابایت باشد.');return}var rd=new FileReader();rd.onload=function(){var im=new Image();im.onload=function(){try{var max=1400,scale=Math.min(1,max/Math.max(im.naturalWidth||im.width,im.naturalHeight||im.height)),w=Math.max(1,Math.round((im.naturalWidth||im.width)*scale)),h=Math.max(1,Math.round((im.naturalHeight||im.height)*scale)),canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;var ctx=canvas.getContext('2d');if(!ctx)throw new Error('canvas unavailable');ctx.fillStyle='#fff';ctx.fillRect(0,0,w,h);ctx.drawImage(im,0,0,w,h);var compact=canvas.toDataURL('image/jpeg',0.68);x.receipt=compact;var aa=read().map(function(v){return v.id===pid?p:v});if(write(aa)){window.m20AccOpen(pid)}else{delete x.receipt;alert('فضای ذخیره‌سازی مرورگر پر شده است. عکس‌های فاکتور قبلی را کم یا حذف کن و دوباره امتحان کن.')}}catch(err){alert('فشرده‌سازی عکس ناموفق بود. یک عکس دیگر امتحان کن.')}};im.onerror=function(){alert('بازکردن عکس ناموفق بود. لطفاً عکس دیگری انتخاب کن.')};im.src=rd.result};rd.onerror=function(){alert('خواندن عکس ناموفق بود. دوباره تلاش کن.')};rd.readAsDataURL(f)};inp.click();return false;};
 window.m20AccDelete=function(pid,eid){if(!confirm('این هزینه حذف شود؟'))return;var a=read(),p=a.find(function(x){return x.id===pid});if(!p)return;p.items=(p.items||[]).filter(function(x){return x.id!==eid});if(write(a))window.m20AccOpen(pid)};
 window.m20AccList=function(){renderList()};
 window.m20AccToggleDateRange=function(){var mode=document.getElementById('accExportPeriod'),box=document.getElementById('accExportDateRange');if(box)box.style.display=mode&&mode.value==='custom'?'flex':'none'};
 function normDateA(v){return String(v||'').replace(/[۰-۹]/g,function(c){return '۰۱۲۳۴۵۶۷۸۹'.indexOf(c)}).replace(/[٠-٩]/g,function(c){return '٠١٢٣٤٥٦٧٨٩'.indexOf(c)}).replace(/[.\-]/g,'/').replace(/\s/g,'').replace(/\/+ /g,'/').replace(/^\/|\/$/g,'')}
 function filteredProjectA(p){var catEl=document.getElementById('accExportCategory'),periodEl=document.getElementById('accExportPeriod'),mode=periodEl?periodEl.value:'all',cat=catEl?catEl.value:'همه',fromEl=document.getElementById('accExportFrom'),toEl=document.getElementById('accExportTo'),from=normDateA(fromEl&&fromEl.value),to=normDateA(toEl&&toEl.value),now=normDateA(today()),month=now.slice(0,7);if(mode==='custom'&&((from&&!/^\d{4}\/\d{1,2}\/\d{1,2}$/.test(from))||(to&&!/^\d{4}\/\d{1,2}\/\d{1,2}$/.test(to)))){alert('تاریخ را به شکل سال/ماه/روز وارد کن؛ مثلاً ۱۴۰۵/۰۸/۰۱.');return null}if(mode==='custom'&&from&&to&&from>to){alert('تاریخ شروع نباید بعد از تاریخ پایان باشد.');return null}var items=(p.items||[]).filter(function(x){if(cat!=='همه'&&catA(x)!==cat)return false;var d=normDateA(x.date);if(mode==='today'&&d!==now)return false;if(mode==='month'&&d.slice(0,7)!==month)return false;if(mode==='custom'){if(from&&(!d||d<from))return false;if(to&&(!d||d>to))return false}return true});var cp={};Object.keys(p).forEach(function(k){cp[k]=p[k]});cp.items=items;cp.reportFilter={category:cat,period:mode,from:from,to:to};return cp}
 function reportSuffixA(p){var f=p.reportFilter||{},a=[];if(f.category&&f.category!=='همه')a.push(f.category);if(f.period==='today')a.push('امروز');else if(f.period==='month')a.push('این_ماه');else if(f.period==='custom')a.push((f.from||'ابتدا')+'_تا_'+(f.to||'انتها'));return a.length?'_'+a.join('_'):''}
 function exportRows(p){var rows=[['پروژه',p.name],['تاریخ ایجاد',p.createdAt||''],[],['ردیف','عنوان هزینه‌کرد','دسته‌بندی','تعداد','مبلغ هر واحد (تومان)','جمع ردیف (تومان)','تاریخ']];var total=0;(p.items||[]).forEach(function(x,i){var q=qtyA(x),line=lineTotalA(x);rows.push([i+1,x.title,catA(x),q,nA(x.amount),line,x.date]);total+=line});rows.push([],['','','','','','جمع کل',total]);return {rows:rows,total:total}}
 window.m20AccExcel=function(){
  var p=getProject(active());if(!p){if(typeof showToast==='function')showToast('ابتدا یک پروژه را باز کن.');return false;}
  p=filteredProjectA(p);if(!p)return false;var d=exportRows(p);
  function csvCell(v){var x=String(v==null?'':v);return '"'+x.replace(/"/g,'""')+'"';}
  var csv='\uFEFF'+d.rows.map(function(r){return r.map(csvCell).join(',');}).join('\r\n');
  var blob=new Blob([csv],{type:'text/csv;charset=utf-8;'});
  var safeName=String(p.name||'Project').replace(/[\\/:*?"<>|]+/g,'_');
  var name='Hisab_'+safeName+reportSuffixA(p)+'.csv';
  try{
   /* Same Android-aware save function used by Menu 17 exports. */
   if(typeof saveBlobLikeMenu17==='function')return saveBlobLikeMenu17(name,blob);
   if(typeof saveBlobFile==='function')return saveBlobFile(name,blob);
   if(typeof window.miladgeoExportBlob==='function')return window.miladgeoExportBlob(name,blob);
   var url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.rel='noopener';a.style.display='none';document.body.appendChild(a);a.click();
   setTimeout(function(){URL.revokeObjectURL(url);if(a.parentNode)a.parentNode.removeChild(a);},10000);return true;
  }catch(e){console.error('ACCOUNTING_EXCEL_EXPORT',e);if(typeof showToast==='function')showToast('خروجی اکسل ناموفق بود.');else alert('خروجی اکسل ناموفق بود.');return false;}
 };
 function accountingReportHtmlA(p,includeImages){var d=exportRows(p),rows=(p.items||[]).map(function(x,i){var row='<tr><td>'+faA(i+1)+'</td><td>'+escA(x.title)+'</td><td>'+escA(catA(x))+'</td><td>'+faA(qtyA(x))+'</td><td>'+faA(nA(x.amount))+'</td><td>'+faA(lineTotalA(x))+'</td><td>'+escA(x.date)+'</td></tr>';if(includeImages&&x.receipt)row+='<tr class="receipt-row"><td colspan="7"><div class="receipt"><b>عکس فاکتور: '+escA(x.title)+' · '+escA(x.date)+'</b><br><img src="'+x.receipt+'" style="max-width:100%;max-height:650px;height:auto"></div></td></tr>';return row}).join('');return '<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>گزارش هزینه '+escA(p.name)+'</title><style>body{font-family:Tahoma,Arial,sans-serif;color:#17251b;direction:rtl;font-size:12px;margin:20px}h1{text-align:center;color:#17643d;font-size:20px}.meta{padding:10px;background:#edf5ee;border:1px solid #ccdccc;margin:12px 0}table{width:100%;border-collapse:collapse}th,td{border:1px solid #9bad9f;padding:7px;text-align:center}th{background:#e5f0e6}td:nth-child(2){text-align:right}.total{margin-top:14px;padding:13px;background:#e5f0e6;border:2px solid #39734b;font-size:16px;font-weight:bold}.receipt{page-break-inside:avoid;margin:12px 0;padding:8px;border:1px solid #ccc}.receipt img{max-width:100%;max-height:650px}</style></head><body><h1>گزارش هزینه‌های پروژه</h1><div class="meta"><b>نام پروژه:</b> '+escA(p.name)+'<br><b>تاریخ ایجاد:</b> '+escA(p.createdAt||'—')+'<br><b>تاریخ گزارش:</b> '+escA(today())+'<br><b>دسته‌بندی:</b> '+escA((p.reportFilter&&p.reportFilter.category)||'همه')+'</div><table><thead><tr><th>ردیف</th><th>عنوان هزینه‌کرد</th><th>دسته‌بندی</th><th>تعداد</th><th>مبلغ واحد</th><th>جمع ردیف</th><th>تاریخ</th>'+'</tr></thead><tbody>'+rows+'</tbody></table><div class="total">جمع کل هزینه‌ها: '+faA(d.total)+' تومان</div></body></html>'}
 function downloadAccountingTextA(name,content,mime){try{var blob=new Blob([content],{type:mime||'application/octet-stream'});if(window.AndroidBridge&&typeof window.AndroidBridge.saveFile==='function'&&typeof window.miladgeoDirectSaveBlob==='function'){window.miladgeoDirectSaveBlob(name,blob);return true;}if(typeof saveBlobLikeMenu17==='function'){var r=saveBlobLikeMenu17(name,blob);if(r!==false)return r;}if(typeof browserSaveBlob==='function')return browserSaveBlob(name,blob,false);var url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.rel='noopener';a.style.display='block';a.style.position='fixed';a.style.left='8px';a.style.bottom='8px';a.style.zIndex='2147483647';a.textContent='دریافت فایل: '+name;document.body.appendChild(a);a.click();setTimeout(function(){try{URL.revokeObjectURL(url)}catch(e){}},30000);if(typeof showToast==='function')showToast('اگر دانلود خودکار شروع نشد، روی پیوند دریافت فایل بزن.');return true}catch(e){console.error('ACCOUNTING_DOWNLOAD',e);if(typeof showToast==='function')showToast('ساخت یا ذخیره فایل ناموفق بود: '+(e.message||e));else alert('ساخت یا ذخیره فایل ناموفق بود.');return false}}
 window.m20AccWord=function(){var p=getProject(active());if(!p)return false;p=filteredProjectA(p);if(!p)return false;var html=accountingReportHtmlA(p,false),name='Hisab_'+String(p.name||'Project').replace(/[\\/:*?"<>|]+/g,'_')+reportSuffixA(p)+'.doc';return downloadAccountingTextA(name,'\ufeff'+html,'application/msword;charset=utf-8')};
 window.m20AccFull=function(){var p=getProject(active());if(!p)return false;p=filteredProjectA(p);if(!p)return false;var html=accountingReportHtmlA(p,true),name='Hisab_Kamel_'+String(p.name||'Project').replace(/[\\/:*?"<>|]+/g,'_')+reportSuffixA(p)+'.html';return downloadAccountingTextA(name,'\ufeff'+html,'text/html;charset=utf-8')};
 window.m20AccPDF=function(){var p=getProject(active());if(!p)return;p=filteredProjectA(p);if(!p)return;var d=exportRows(p),body=(p.items||[]).map(function(x,i){return '<tr><td>'+faA(i+1)+'</td><td>'+escA(x.title)+'</td><td>'+escA(catA(x))+'</td><td>'+faA(qtyA(x))+'</td><td>'+faA(nA(x.amount))+'</td><td>'+faA(lineTotalA(x))+'</td><td>'+escA(x.date)+'</td></tr>'}).join('');var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>گزارش هزینه '+escA(p.name)+'</title><style>@page{size:A4 portrait;margin:12mm}body{font-family:Tahoma,Arial,sans-serif;color:#17251b;direction:rtl;font-size:12px}h1{text-align:center;color:#17643d;font-size:20px}.meta{padding:10px;background:#edf5ee;border:1px solid #ccdccc;border-radius:7px;margin:12px 0}table{width:100%;border-collapse:collapse}th,td{border:1px solid #9bad9f;padding:8px;text-align:center}th{background:#e5f0e6}td:nth-child(2){text-align:right}.total{margin-top:14px;padding:13px;background:#e5f0e6;border:2px solid #39734b;font-size:16px;font-weight:bold}.foot{text-align:center;color:#69766c;font-size:9px;margin-top:25px}</style></head><body><h1>گزارش هزینه‌های پروژه</h1><div class="meta"><b>نام پروژه:</b> '+escA(p.name)+'<br><b>تاریخ ایجاد:</b> '+escA(p.createdAt||'—')+'<br><b>تاریخ گزارش:</b> '+escA(today())+'</div><table><thead><tr><th>ردیف</th><th>عنوان هزینه‌کرد</th><th>دسته‌بندی</th><th>تعداد</th><th>مبلغ واحد</th><th>جمع ردیف</th><th>تاریخ</th></tr></thead><tbody>'+body+'</tbody></table><div class="total">جمع کل هزینه‌ها: '+faA(d.total)+' تومان</div><div class="foot">تهیه‌شده با حسابدار مهندس · MiladGeo</div></body></html>';var name='Hisab_'+p.name.replace(/[\\/:*?"<>|]/g,'_')+reportSuffixA(p)+'.pdf';try{if(typeof window.miladgeoM17PrintHtml==='function'){var ok=window.miladgeoM17PrintHtml(html,name);if(ok!==false)return false}var w=window.open('','_blank');if(!w){alert('مرورگر پنجره چاپ را مسدود کرده است. اجازه بازشدن پنجره را بده.');return false}w.document.open();w.document.write(html);w.document.close();setTimeout(function(){try{w.focus();w.print()}catch(e){}},700)}catch(e){console.error('ACCOUNTING_PDF',e);alert('ساخت پیش‌نمایش PDF ناموفق بود.')}return false};
 window.m20AccountantPanel=function(){try{renderList();}catch(e){console.error('ACCOUNTING_PANEL_OPEN',e);var b=document.getElementById('m20Body');if(b)b.innerHTML='<div class="m20-meta">باز کردن حسابداری ناموفق بود. یک‌بار به منوی اصلی برگرد و دوباره وارد شو.</div>';}};
 // Re-apply green styling after each panel redraw and ensure project controls remain available.
 document.addEventListener('click',function(e){var b=e.target&&e.target.closest?e.target.closest('#m20Body button'):null;if(b&&b.closest('#m20Body'))addGreenStyle();},true);

})();


/* MENU 20 — Project Management v104 comprehensive module */
(function(){
 var KEY='miladgeo_survey_projects_v104';
 var TYPES=['برداشت','تفکیک','جانمایی و میخ‌کوبی','خدمات UTM و امور ثبتی','خدمات ساختمانی','خدمات راه‌سازی','خدمات نوین نقشه‌برداری','ترازیابی','پیاده‌سازی','نقشه‌برداری توپوگرافی','کاداستر و ثبتی','GIS و نقشه‌سازی','پایش و کنترل سازه','As-Built / چون‌ساخت','سایر'];
 var SERVICES=['برداشت زمینی','GNSS / RTK','توتال استیشن','ترازیابی','پیاده‌سازی نقاط','تهیه نقشه','محاسبات و پردازش','UTM','تفکیک','جانمایی','نقشه‌برداری ساختمان','نقشه‌برداری راه','کنترل و نظارت','سایر'];
 function esc(x){return String(x==null?'':x).replace(/[&<>"']/g,function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]})}
 function read(){try{var a=JSON.parse(localStorage.getItem(KEY)||'[]');return Array.isArray(a)?a:[]}catch(e){return []}}
 function save(a){try{localStorage.setItem(KEY,JSON.stringify(a));return true}catch(e){alert('فضای ذخیره‌سازی مرورگر کافی نیست.');return false}}
 function id(){return 'p'+Date.now()+Math.random().toString(36).slice(2,7)}
 function points(){try{var keys=[];for(var i=0;i<localStorage.length;i++){var k=localStorage.key(i);if(k&&k.indexOf('miladgeo_points_v85_')===0)keys.push(k)}var k=keys[0];if(!k)return [];var a=JSON.parse(localStorage.getItem(k)||'[]');return Array.isArray(a)?a:[]}catch(e){return []}}
 function opt(arr,val,ph){return '<option value="">'+ph+'</option>'+arr.map(function(x){return '<option value="'+esc(x)+'" '+(x===val?'selected':'')+'>'+esc(x)+'</option>'}).join('')}
 function field(label,name,value,type){return '<label style="font-weight:900;margin-top:9px">'+label+'</label><input data-pm="'+name+'" type="'+(type||'text')+'" value="'+esc(value||'')+'">'}
 function form(p){p=p||{};return '<div style="padding:4px 0;direction:rtl">'
 +'<div style="font-size:17px;font-weight:1000;margin:4px 0 8px">📁 پرونده جامع پروژه نقشه‌برداری</div>'
 +field('نام پروژه','name',p.name)+ '<label>نوع پروژه</label><select data-pm="type">'+opt(TYPES,p.type||'','انتخاب کنید')+'</select>'
 +'<label>خدمات پروژه</label><select data-pm="service">'+opt(SERVICES,p.service||'','انتخاب کنید')+'</select>'
 +'<div class="card" style="padding:9px;margin:10px 0"><b>📍 موقعیت پروژه و Google Earth</b>'+field('آدرس / موقعیت پروژه','location',p.location)+'<div class="row">'+field('عرض جغرافیایی Latitude','lat',p.lat,'number')+field('طول جغرافیایی Longitude','lon',p.lon,'number')+'</div><div class="btn-row"><button class="btn" type="button" id="pmEarth">🌍 باز کردن موقعیت در Google Earth</button><button class="btn" type="button" id="pmKml">🗺️ خروجی KML پروژه</button></div><small>مختصات را می‌توان از Google Earth وارد کرد؛ دکمه Earth موقعیت ثبت‌شده را برای مشاهده باز می‌کند.</small></div>'
 +'<div class="row">'+field('تاریخ شروع','start',p.start,'date')+field('تاریخ تحویل','due',p.due,'date')+'</div>'
 +'<div class="row">'+field('مبلغ قرارداد (تومان)','budget',p.budget,'number')+field('درصد پیشرفت','progress',p.progress||0,'number')+'</div>'
 +'<div class="row">'+field('نام کارفرما','client',p.client)+field('شماره تماس','phone',p.phone,'tel')+'</div>'
 +field('مسئول پروژه / سرپرست اکیپ','manager',p.manager)+field('اعضای اکیپ','team',p.team)+field('تجهیزات موردنیاز','equipment',p.equipment)
 +'<label>وضعیت پروژه</label><select data-pm="status">'+opt(['فعال','در انتظار','متوقف','تکمیل شده'],p.status||'فعال','انتخاب وضعیت')+'</select>'
 +'<label>یادداشت و نکات فنی</label><textarea data-pm="notes" style="width:100%;min-height:85px;padding:8px;border:2px solid #4a5147;border-radius:5px">'+esc(p.notes||'')+'</textarea>'
 +'<button class="btn primary" type="button" id="pmSave" style="margin-top:10px">💾 ذخیره پروژه</button></div>'}
 function dashboard(){var a=read(),active=a.filter(function(x){return x.status==='فعال'}).length,done=a.filter(function(x){return x.status==='تکمیل شده'}).length;return '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:8px 0"><div class="card" style="text-align:center;padding:8px"><b style="font-size:20px">'+a.length+'</b><br><small>کل پروژه‌ها</small></div><div class="card" style="text-align:center;padding:8px"><b style="font-size:20px">'+active+'</b><br><small>فعال</small></div><div class="card" style="text-align:center;padding:8px"><b style="font-size:20px">'+done+'</b><br><small>تکمیل‌شده</small></div></div>'}
 function renderList(){var b=document.getElementById('m20Body');if(!b)return;var a=read();b.innerHTML='<div class="m20-meta"><b style="font-size:16px">📊 مدیریت پروژه‌های نقشه‌برداری</b><br>پرونده یکپارچه پروژه، موقعیت، نقاط جاب، عملیات، مالی و اسناد.</div>'+dashboard()+'<button class="btn primary" id="pmNew" type="button">＋ ایجاد پروژه جدید</button><div id="pmList" style="margin-top:9px">'+(a.length?a.map(function(p){return '<div class="card" style="margin-top:7px"><b>'+esc(p.name||'بدون نام')+'</b><div style="font-size:10px;margin:5px 0">'+esc(p.type||'نوع مشخص نشده')+' · '+esc(p.service||'خدمات مشخص نشده')+'</div><div style="font-size:10px">📍 '+esc(p.location||'موقعیت ثبت نشده')+' · 📌 '+((p.points||[]).length)+' نقطه · 🧾 '+((p.invoices||[]).length)+' سند</div><div style="height:8px;background:#7f8b78;border-radius:8px;overflow:hidden;margin-top:5px"><div style="height:100%;width:'+Math.max(0,Math.min(100,Number(p.progress)||0))+'%;background:#2f7a43"></div></div><div class="btn-row"><button class="btn" type="button" data-pm-open="'+p.id+'">باز کردن پرونده</button><button class="btn danger" type="button" data-pm-del="'+p.id+'">حذف</button><button class="mg-saved-project-pin" type="button" data-saved-project-pin="survey" data-project-id="'+p.id+'" aria-label="سنجاق پروژه" title="سنجاق به صفحه اصلی">＋</button></div></div>'}).join(''):'<div class="empty">هنوز پروژه‌ای ثبت نشده است.</div>')+'</div>';
 document.getElementById('pmNew').onclick=function(){edit({id:id(),status:'فعال',progress:0,points:[],tasks:[],reports:[],invoices:[]})};b.querySelectorAll('[data-pm-open]').forEach(function(x){x.onclick=function(){var p=read().find(function(z){return z.id===x.dataset.pmOpen});if(p)edit(p)}});b.querySelectorAll('[data-pm-del]').forEach(function(x){x.onclick=function(){if(confirm('این پروژه حذف شود؟')){save(read().filter(function(z){return z.id!==x.dataset.pmDel}));renderList()}}})}
 function saveProject(o){var a=read(),i=a.findIndex(function(z){return z.id===o.id});if(i<0)a.unshift(o);else a[i]=o;return save(a)}
 function edit(p){var b=document.getElementById('m20Body');p.points=p.points||[];p.tasks=p.tasks||[];p.reports=p.reports||[];p.invoices=p.invoices||[];b.innerHTML='<button class="btn gray" type="button" id="pmBack">↩ بازگشت به پروژه‌ها</button><div class="card" style="margin-top:8px">'+form(p)+'</div><div id="pmWorkspace"></div>';document.getElementById('pmBack').onclick=renderList;
 function collect(){var o={id:p.id,createdAt:p.createdAt||new Date().toLocaleDateString('fa-IR'),points:p.points,tasks:p.tasks,reports:p.reports,invoices:p.invoices};b.querySelectorAll('[data-pm]').forEach(function(el){o[el.dataset.pm]=el.value});return o}
 document.getElementById('pmSave').onclick=function(){if(saveProject(collect())){alert('پروژه ذخیره شد.');edit(collect())}};
 document.getElementById('pmEarth').onclick=function(){var o=collect(),q=o.lat&&o.lon?(o.lat+','+o.lon):o.location;if(!q){alert('ابتدا آدرس یا مختصات پروژه را وارد کن.');return}window.open('https://earth.google.com/web/search/'+encodeURIComponent(q),'_blank')};
 document.getElementById('pmKml').onclick=function(){var o=collect();if(!o.lat||!o.lon){alert('برای KML عرض و طول جغرافیایی را وارد کن.');return}var k='<?xml version="1.0" encoding="UTF-8"?><kml xmlns="http://www.opengis.net/kml/2.2"><Placemark><name>'+esc(o.name||'MiladGeo Project')+'</name><Point><coordinates>'+o.lon+','+o.lat+',0</coordinates></Point></Placemark></kml>';var u=URL.createObjectURL(new Blob([k],{type:'application/vnd.google-earth.kml+xml'})),a=document.createElement('a');a.href=u;a.download=(o.name||'project')+'.kml';a.click();setTimeout(function(){URL.revokeObjectURL(u)},2000)};
 workspace(p,collect);
 }
 function workspace(p,collect){var w=document.getElementById('pmWorkspace');if(!w)return;var jp=points();w.innerHTML='<div class="card" style="margin-top:9px"><h3>📌 نقاط پروژه از جاب</h3><div class="m20-meta">نقاط انتخاب‌شده همراه پرونده پروژه ذخیره می‌شوند.</div><select id="pmJobPoint"><option value="">انتخاب نقطه از جاب فعال</option>'+jp.map(function(x,i){return '<option value="'+i+'">'+esc(x.no||x.name||('P'+(i+1)))+' — X:'+esc(x.x)+' Y:'+esc(x.y)+' Z:'+esc(x.z||'')+'</option>'}).join('')+'</select><button class="btn" id="pmAddPoint" type="button">＋ افزودن نقطه به پروژه</button><div id="pmPointList">'+(p.points||[]).map(function(x,i){return '<div class="m20-meta">📍 '+esc(x.no||x.name||('P'+(i+1)))+' | X:'+esc(x.x)+' Y:'+esc(x.y)+' <button type="button" data-pm-rmpt="'+i+'">حذف</button></div>'}).join('')+'</div></div>'
 +'<div class="card" style="margin-top:9px"><h3>☑️ وظایف و برنامه کار</h3><input id="pmTaskTitle" placeholder="مثلاً برداشت روز اول، پردازش، کنترل..."><input id="pmTaskDue" type="date"><button class="btn" id="pmTaskAdd" type="button">＋ ثبت وظیفه</button><div>'+p.tasks.map(function(t,i){return '<div class="m20-meta">'+(t.done?'✅':'⬜')+' '+esc(t.title)+' '+esc(t.due||'')+' <button data-pm-done="'+i+'">تغییر وضعیت</button></div>'}).join('')+'</div></div>'
 +'<div class="card" style="margin-top:9px"><h3>🧭 گزارش عملیات صحرایی</h3><textarea id="pmReportText" placeholder="فعالیت امروز، شرایط، مشکلات، نتیجه و نکات فنی..."></textarea><button class="btn" id="pmReportAdd" type="button">💾 ذخیره گزارش روزانه</button><div>'+p.reports.slice().reverse().map(function(r){return '<div class="m20-meta"><b>'+esc(r.date)+'</b><br>'+esc(r.text)+'</div>'}).join('')+'</div></div>'
 +'<div class="card" style="margin-top:9px"><h3>🧾 فاکتور و صورت‌وضعیت</h3><div class="m20-meta">فاکتور منوی ۸ دفتر مهندس را با انتخاب این پروژه باز کن؛ سپس یک نسخه از اطلاعات فاکتور داخل پرونده پروژه ذخیره می‌شود.</div><button class="btn primary" id="pmOpenInvoice" type="button">🧾 ایجاد فاکتور برای این پروژه</button><div>'+p.invoices.map(function(x,i){return '<div class="m20-meta">🧾 '+esc(x.number||('سند '+(i+1)))+' · '+esc(x.date||'')+' · '+esc(x.final||'')+'</div>'}).join('')+'</div></div>';
 var add=function(){var sel=document.getElementById('pmJobPoint'),idx=Number(sel.value);if(!Number.isInteger(idx)||!jp[idx])return;var o=collect();o.points=o.points||[];if(!o.points.some(function(x){return String(x.id||x.no)===String(jp[idx].id||jp[idx].no)}))o.points.push(jp[idx]);saveProject(o);edit(o)};document.getElementById('pmAddPoint').onclick=add;
 w.querySelectorAll('[data-pm-rmpt]').forEach(function(b){b.onclick=function(){var o=collect();o.points.splice(Number(b.dataset.pmRmpt),1);saveProject(o);edit(o)}});
 document.getElementById('pmTaskAdd').onclick=function(){var title=document.getElementById('pmTaskTitle').value.trim();if(!title)return;var o=collect();o.tasks.push({title:title,due:document.getElementById('pmTaskDue').value,done:false});saveProject(o);edit(o)};
 w.querySelectorAll('[data-pm-done]').forEach(function(b){b.onclick=function(){var o=collect(),i=Number(b.dataset.pmDone);o.tasks[i].done=!o.tasks[i].done;saveProject(o);edit(o)}});
 document.getElementById('pmReportAdd').onclick=function(){var t=document.getElementById('pmReportText').value.trim();if(!t)return;var o=collect();o.reports.push({date:new Date().toLocaleDateString('fa-IR'),text:t});saveProject(o);edit(o)};
 document.getElementById('pmOpenInvoice').onclick=function(){localStorage.setItem('miladgeo_invoice_project_v1',p.id);if(window.m20Open)window.m20Open('invoice');setTimeout(function(){var f=document.getElementById('m16InvProject');if(f)f.value=p.name||'';window.scrollTo({top:0,behavior:'smooth'})},300)};
 }
 window.m20ProjectManagerPanel=renderList;
 window.miladgeoSaveInvoiceToProject=function(){var pid=localStorage.getItem('miladgeo_invoice_project_v1');if(!pid){alert('ابتدا پروژه را از مدیریت پروژه‌ها انتخاب کن.');return false}var a=read(),p=a.find(function(x){return x.id===pid});if(!p){alert('پروژه انتخاب‌شده پیدا نشد.');return false}var g=function(id){var e=document.getElementById(id);return e?e.value:''};p.invoices=p.invoices||[];p.invoices.push({id:Date.now(),number:g('m16InvNumber'),date:g('m16InvDate'),project:g('m16InvProject'),final:(document.getElementById('m16InvFinal')||{}).textContent||'',savedAt:new Date().toLocaleDateString('fa-IR')});save(a);alert('اطلاعات فاکتور داخل پرونده پروژه ذخیره شد ✓');return true};
})();

window.m20BusinessCardPanel=function(){var b=document.getElementById('m20Body');if(!b)return;b.innerHTML='<div class="m20-panel"><h3>🪪 مرکز رزومه و کارت معرفی مهندس</h3><div class="m20-meta">یک کارت معرفی حرفه‌ای برای انتشار در گروه‌های نقشه‌برداری بسازید. اطلاعات تماس، تخصص، سوابق و نمونه خدمات را وارد کنید و تصویر آماده انتشار بگیرید.</div><label>نام و نام خانوادگی</label><input id="bcName" placeholder="نام و نام خانوادگی" oninput="m20BusinessPreview()"><label>عنوان و تخصص</label><input id="bcTitle" value="مهندس نقشه‌برداری" oninput="m20BusinessPreview()"><label>شماره تماس</label><input id="bcPhone" inputmode="tel" placeholder="09xxxxxxxxx" oninput="m20BusinessPreview()"><label>ایمیل یا شناسه ارتباطی</label><input id="bcEmail" placeholder="ایمیل / شناسه پیام‌رسان (اختیاری)" oninput="m20BusinessPreview()"><label>شهر و محدوده فعالیت</label><input id="bcCity" placeholder="مثلاً تهران و استان البرز" oninput="m20BusinessPreview()"><label>خدمات تخصصی</label><textarea id="bcServices" rows="2" placeholder="UTM، تفکیک، جانمایی، پیاده‌سازی، برداشت وضع موجود..." oninput="m20BusinessPreview()"></textarea><label>سوابق یا معرفی کوتاه</label><textarea id="bcExperience" rows="2" placeholder="مثلاً ۱۰ سال سابقه فعالیت در پروژه‌های عمرانی و ثبتی" oninput="m20BusinessPreview()"></textarea><label>شماره عضویت / پروانه (اختیاری)</label><input id="bcLicense" placeholder="فقط در صورت داشتن شماره معتبر" oninput="m20BusinessPreview()"><label>اندازه شماره تماس</label><select id="bcPhoneSize" onchange="m20BusinessPreview()"><option value="34">معمولی</option><option value="42" selected>بزرگ</option><option value="50">خیلی بزرگ</option></select><label>چیدمان کارت</label><select id="bcLayout" onchange="m20BusinessPreview()"><option value="executive">افقی لوکس – عکس کوچک گوشه</option><option value="portrait">پرتره عمودی – عکس بزرگ</option><option value="split">دو بخشی – عکس بزرگ سمت چپ</option><option value="blueprint">نقشه فنی – قاب عکس مستطیلی</option><option value="minimal">مینیمال – عکس کوچک دایره‌ای</option><option value="member">کارت عضویت مهندسی – الهام‌گرفته از کارت نظام مهندسی</option></select><label>رنگ و هویت بصری</label><select id="bcTheme" onchange="m20BusinessPreview()"><option value="navy">سرمه‌ای و طلایی</option><option value="emerald">زمردی حرفه‌ای</option><option value="graphite">گرافیتی و نقره‌ای</option><option value="blueprint">آبی نقشه فنی</option><option value="white">سفید مینیمال</option><option value="bronze">برنز لوکس</option><option value="teal">فیروزه‌ای مدرن</option><option value="purple">بنفش پرستیژ</option></select><label>المان نقشه‌برداری</label><select id="bcShape" onchange="m20BusinessPreview()"><option value="totalstation">دوربین نقشه‌برداری</option><option value="gnss">GNSS و ماهواره</option><option value="tripod">سه‌پایه و منشور</option><option value="contour">خطوط تراز</option><option value="grid">شبکه مختصات</option><option value="road">راه و روسازی</option></select><label>عکس مهندس (اختیاری)</label><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><input id="bcPhoto" type="file" accept="image/*" style="flex:1;min-width:180px"><button class="btn" type="button" onclick="m20BusinessRemovePhoto()" style="background:#f3dddd;color:#8b1e1e;border:1px solid #b96a6a">🗑️ حذف عکس</button></div><canvas id="bcCanvas" style="display:block;width:100%;height:auto;margin-top:12px;border-radius:16px;border:1px solid #657060;box-shadow:0 12px 28px #0002"></canvas><div class="m20-btns"><button class="btn primary" type="button" onclick="m20BusinessPreview()">👁️ به‌روزرسانی پیش‌نمایش</button><button class="btn primary" type="button" onclick="m20BusinessJPEG()">📥 ذخیره تصویر JPEG</button><button class="btn" type="button" onclick="m20BusinessVCard()">📇 ذخیره مخاطب مهندس</button></div><div class="m20-meta">نکته: قالب «کارت عضویت مهندسی» صرفاً طرح معرفی شخصی است و کارت رسمی سازمان نظام مهندسی یا مدرک احراز صلاحیت محسوب نمی‌شود.</div></div>';var f=document.getElementById('bcPhoto');if(f)f.addEventListener('change',window.m20BusinessPreview);window.m20BusinessPreview();};
window.m20BusinessPreview=function(){var c=document.getElementById('bcCanvas');if(!c)return;var val=function(id,d){var e=document.getElementById(id);return e&&e.value?e.value:d||''};var layout=val('bcLayout','executive'),theme=val('bcTheme','navy'),name=val('bcName','نام و نام خانوادگی'),title=val('bcTitle','مهندس نقشه‌برداری'),phone=val('bcPhone','شماره تماس'),email=val('bcEmail',''),city=val('bcCity',''),services=val('bcServices','خدمات نقشه‌برداری و امور مهندسی'),experience=val('bcExperience',''),license=val('bcLicense',''),shape=val('bcShape','totalstation'),phoneSize=+val('bcPhoneSize','42');var vertical=layout==='portrait'||layout==='member';c.width=vertical?900:1400;c.height=vertical?1400:850;var x=c.getContext('2d'),W=c.width,H=c.height;var P={navy:['#10243c','#071321','#d9b76b','#f7f4eb'],emerald:['#0d5948','#082f2a','#d7c58b','#ffffff'],graphite:['#343b45','#111820','#c5d0d9','#ffffff'],blueprint:['#0a477d','#06294c','#79d7ff','#ffffff'],white:['#f7f8f6','#e4e9e8','#16735c','#1d2c35'],bronze:['#69452e','#241b18','#e5bd83','#fff8ec'],teal:['#087d82','#06424e','#a5eee3','#ffffff'],purple:['#49316e','#1d1837','#e6c2ff','#ffffff']}[theme]||['#10243c','#071321','#d9b76b','#fff'];var light=theme==='white';function rr(a,b,w,h,r){x.beginPath();x.moveTo(a+r,b);x.arcTo(a+w,b,a+w,b+h,r);x.arcTo(a+w,b+h,a,b+h,r);x.arcTo(a,b+h,a,b,r);x.arcTo(a,b,a+w,b,r);x.closePath()}var grad=x.createLinearGradient(0,0,W,H);grad.addColorStop(0,P[0]);grad.addColorStop(1,P[1]);x.fillStyle=grad;rr(0,0,W,H,vertical?42:48);x.fill();x.save();rr(0,0,W,H,vertical?42:48);x.clip();
// subtle technical pattern
x.strokeStyle=light?'rgba(10,70,60,.10)':'rgba(255,255,255,.10)';x.lineWidth=2;if(theme==='blueprint'||shape==='grid'){for(var i=0;i<W;i+=42){x.beginPath();x.moveTo(i,0);x.lineTo(i,H);x.stroke()}for(i=0;i<H;i+=42){x.beginPath();x.moveTo(0,i);x.lineTo(W,i);x.stroke()}}else{for(i=0;i<8;i++){x.beginPath();x.ellipse(W*.78,H*.5,160+i*65,70+i*38,-.45,0,Math.PI*2);x.stroke()}}x.restore();
var ink=P[3],accent=P[2];x.fillStyle=accent;if(layout==='split'){x.fillRect(0,0,440,H)}else if(vertical){x.fillRect(0,0,W,22)}else{x.fillRect(0,0,18,H)}
// drawing emblem / surveying motif
function emblem(cx,cy,s){x.save();x.translate(cx,cy);x.strokeStyle=accent;x.fillStyle=accent;x.lineWidth=Math.max(5,s*.045);if(shape==='totalstation'){rr(-s*.22,-s*.34,s*.44,s*.34,s*.05);x.stroke();x.beginPath();x.moveTo(0,0);x.lineTo(-s*.32,s*.55);x.moveTo(0,0);x.lineTo(0,s*.62);x.moveTo(0,0);x.lineTo(s*.32,s*.55);x.stroke()}else if(shape==='gnss'){x.beginPath();x.arc(0,-s*.22,s*.18,0,Math.PI*2);x.stroke();for(var a=0;a<3;a++){x.beginPath();x.arc(0,-s*.22,s*(.34+a*.13),Math.PI*1.15,Math.PI*1.85);x.stroke()}x.beginPath();x.moveTo(0,0);x.lineTo(0,s*.55);x.stroke()}else if(shape==='tripod'){x.beginPath();x.moveTo(0,-s*.35);x.lineTo(-s*.35,s*.55);x.moveTo(0,-s*.35);x.lineTo(0,s*.6);x.moveTo(0,-s*.35);x.lineTo(s*.35,s*.55);x.arc(0,-s*.4,s*.12,0,Math.PI*2);x.stroke()}else{for(a=0;a<5;a++){x.beginPath();x.ellipse(0,0,s*(.2+a*.13),s*(.12+a*.09),-.35,0,Math.PI*2);x.stroke()}}x.restore()}
var photoRect;if(layout==='portrait')photoRect={x:225,y:95,w:450,h:430,r:44,shape:'round'};else if(layout==='member')photoRect={x:275,y:115,w:350,h:350,r:175,shape:'circle'};else if(layout==='split')photoRect={x:55,y:155,w:330,h:440,r:34,shape:'round'};else if(layout==='blueprint')photoRect={x:80,y:215,w:330,h:390,r:22,shape:'round'};else if(layout==='minimal')photoRect={x:95,y:105,w:170,h:170,r:85,shape:'circle'};else photoRect={x:W-300,y:100,w:190,h:190,r:95,shape:'circle'};
// frame background, image load handled below for crisp image in exported canvas
x.save();if(photoRect.shape==='circle'){x.beginPath();x.arc(photoRect.x+photoRect.w/2,photoRect.y+photoRect.h/2,photoRect.w/2,0,Math.PI*2)}else rr(photoRect.x,photoRect.y,photoRect.w,photoRect.h,photoRect.r);x.fillStyle=light?'#dce5e1':'rgba(255,255,255,.13)';x.fill();x.strokeStyle=accent;x.lineWidth=10;x.stroke();x.restore();
var f=document.getElementById('bcPhoto'),drawText=function(){x.direction='rtl';x.textBaseline='alphabetic';if(layout==='member'||layout==='portrait'){x.textAlign='center';x.fillStyle=ink;x.font='bold 39px Tahoma,Arial';x.fillText(layout==='member'?'کارت معرفی مهندس':'معرفی تخصصی مهندس',450,layout==='member'?555:590);x.font='bold 56px Tahoma,Arial';x.fillText(name,450,layout==='member'?650:680);x.font='33px Tahoma,Arial';x.fillText(title,450,layout==='member'?710:735);x.fillStyle=accent;x.fillRect(150,layout==='member'?755:775,600,5);x.fillStyle=ink;x.font='bold 30px Tahoma,Arial';x.fillText('شماره تماس: '+phone,450,layout==='member'?830:850);if(email){x.font='25px Arial';x.direction='ltr';x.fillText(email,450,layout==='member'?905:925);x.direction='rtl'}if(license)x.font='27px Tahoma,Arial',x.fillText('شماره عضویت / پروانه: '+license,450,layout==='member'?970:985);if(city)x.font='28px Tahoma,Arial',x.fillText(city,450,layout==='member'?1030:1040);if(services){x.font='27px Tahoma,Arial';wrap(services,450,layout==='member'?1090:1100,720,42,true)}if(experience){x.font='24px Tahoma,Arial';wrap(experience,450,layout==='member'?1215:1210,720,36,true)}if(layout==='member'){x.font='bold 22px Tahoma,Arial';x.fillText('طرح نمونه غیررسمی • فاقد اعتبار شناسایی سازمانی',450,1320)}}else{var left=layout==='split'?470:layout==='blueprint'?480:layout==='minimal'?320:90;var right=layout==='executive'?W-340:W-80;var align=layout==='minimal'?'right':'right';x.textAlign=align;x.fillStyle=ink;x.font='bold '+(layout==='minimal'?49:60)+'px Tahoma,Arial';x.fillText(name,right,layout==='minimal'?155:175);x.font='bold 34px Tahoma,Arial';x.fillText(title,right,layout==='minimal'?215:235);x.fillStyle=accent;x.fillRect(left,layout==='minimal'?250:275,Math.max(160,right-left),6);x.fillStyle=ink;x.font='bold '+phoneSize+'px Arial';x.direction='ltr';x.textAlign='left';x.fillText(phone,left,layout==='minimal'?350:390);x.direction='rtl';x.textAlign='right';var yy=layout==='minimal'?420:470;if(city){x.font='27px Tahoma,Arial';x.fillText(city,right,yy);yy+=52}if(email){x.font='25px Arial';x.direction='ltr';x.textAlign='left';x.fillText(email,left,yy);x.direction='rtl';x.textAlign='right';yy+=48}if(services){x.font='27px Tahoma,Arial';wrap(services,right,yy,Math.max(300,right-left),42,false);yy+=Math.min(125,Math.ceil(services.length/34)*42+12)}if(experience){x.font='23px Tahoma,Arial';wrap(experience,right,yy,Math.max(300,right-left),37,false)}if(license){x.font='22px Tahoma,Arial';x.fillText('عضویت / پروانه: '+license,right,H-95)}x.textAlign='left';x.direction='ltr';x.fillStyle=ink;x.globalAlpha=.78;x.font='bold 22px Arial';x.fillText('MILADGEO • SURVEYING & ENGINEERING',55,H-42);x.globalAlpha=1;}}
function wrap(txt,xx,yy,max,lineH,center){var words=String(txt).split(/\s+/),line='',lines=[];for(var z=0;z<words.length;z++){var test=line?line+' '+words[z]:words[z];if(x.measureText(test).width>max&&line){lines.push(line);line=words[z]}else line=test}if(line)lines.push(line);for(var z=0;z<Math.min(lines.length,3);z++){if(center)x.textAlign='center';x.fillText(lines[z],xx,yy+z*lineH)}}
function finish(){drawText();if(layout==='member'){x.strokeStyle='rgba(255,255,255,.5)';x.lineWidth=4;rr(8,8,W-16,H-16,38);x.stroke();x.fillStyle=accent;x.font='bold 20px Arial';x.textAlign='center';x.direction='ltr';x.fillText('ENGINEERING PROFILE • SAMPLE DESIGN',450,1370)}else{x.strokeStyle=light?'rgba(10,40,35,.2)':'rgba(255,255,255,.25)';x.lineWidth=3;rr(3,3,W-6,H-6,46);x.stroke()} }
if(f&&f.files&&f.files[0]){var reader=new FileReader();reader.onload=function(ev){var im=new Image();im.onload=function(){x.save();if(photoRect.shape==='circle'){x.beginPath();x.arc(photoRect.x+photoRect.w/2,photoRect.y+photoRect.h/2,photoRect.w/2-5,0,Math.PI*2)}else rr(photoRect.x+5,photoRect.y+5,photoRect.w-10,photoRect.h-10,Math.max(8,photoRect.r-5));x.clip();var scale=Math.max(photoRect.w/im.width,photoRect.h/im.height),dw=im.width*scale,dh=im.height*scale;x.drawImage(im,photoRect.x+(photoRect.w-dw)/2,photoRect.y+(photoRect.h-dh)/2,dw,dh);x.restore();x.save();x.strokeStyle=accent;x.lineWidth=10;if(photoRect.shape==='circle'){x.beginPath();x.arc(photoRect.x+photoRect.w/2,photoRect.y+photoRect.h/2,photoRect.w/2-4,0,Math.PI*2)}else rr(photoRect.x+4,photoRect.y+4,photoRect.w-8,photoRect.h-8,photoRect.r);x.stroke();x.restore();finish()};im.src=ev.target.result};reader.readAsDataURL(f.files[0])}else finish();};
window.m20BusinessRemovePhoto=function(){var f=document.getElementById('bcPhoto');if(f){f.value='';window.m20BusinessPreview()}};
window.m20BusinessJPEG=function(){window.m20BusinessPreview();setTimeout(function(){var c=document.getElementById('bcCanvas');if(!c)return;var a=document.createElement('a');a.download='کارت-معرفی-مهندس.jpg';a.href=c.toDataURL('image/jpeg',.96);a.click()},450)};
window.m20BusinessVCard=function(){var g=function(id){var e=document.getElementById(id);return e?e.value.trim():''},escv=function(s){return String(s||'').replace(/\\/g,'\\\\').replace(/\n/g,'\\n').replace(/,/g,'\\,').replace(/;/g,'\\;')};var v=['BEGIN:VCARD','VERSION:3.0','FN:'+escv(g('bcName')),'TITLE:'+escv(g('bcTitle')),'TEL;TYPE=CELL:'+escv(g('bcPhone'))];if(g('bcEmail'))v.push('EMAIL:'+escv(g('bcEmail')));if(g('bcCity'))v.push('ADR;TYPE=WORK:;;'+escv(g('bcCity')));if(g('bcServices'))v.push('NOTE:'+escv(g('bcServices')+' | '+g('bcExperience')));v.push('END:VCARD');var blob=new Blob([v.join('\r\n')],{type:'text/vcard;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='مخاطب-مهندس.vcf';a.click();setTimeout(function(){URL.revokeObjectURL(a.href)},1000)};

window.m20BankCardPanel=function(){var b=document.getElementById('m20Body');if(!b)return;b.innerHTML='<div class="m20-panel"><h3>💳 طراحی کارت بانکی</h3><div class="m20-meta">کارت شیک و حرفه‌ای با الهام از طراحی کارت‌های بانکی بین‌المللی؛ مناسب ارسال برای کارفرما.</div><label>نام بانک</label><select id="bkBank" onchange="m20BankPreview()"><option>ملی ایران</option><option>ملت</option><option>تجارت</option><option>صادرات ایران</option><option>پاسارگاد</option><option>سامان</option><option>پارسیان</option><option>کشاورزی</option><option>مسکن</option><option>رفاه کارگران</option><option>شهر</option><option>بلو</option><option>مهر ایران</option><option>رسالت</option><option>آینده</option></select><label>شماره کارت</label><input id="bkNumber" inputmode="numeric" maxlength="19" placeholder="xxxx-xxxx-xxxx-xxxx" oninput="m20BankPreview()"><label>نام و نام خانوادگی</label><input id="bkName" placeholder="نام و نام خانوادگی" oninput="m20BankPreview()"><label>رنگ و طرح کارت</label><select id="bkTheme" onchange="m20BankPreview()"><option value="obsidian">مشکی آبسیدین • لوکس</option><option value="aurora">شفق قطبی • فانتزی</option><option value="royal">آبی سلطنتی • پریمیوم</option><option value="platinum">پلاتینیوم • نقره‌ای</option><option value="emerald">زمردی • لوکس</option><option value="nebula">کهکشانی • بنفش</option><option value="cyber">نئون سایبر • مدرن</option><option value="marble">سنگ مرمر • کلاسیک</option><option value="topo">توپوگرافی • مهندسی</option><option value="sunset">غروب • گرم</option><option value="minimal">مینیمال • سفید</option><option value="ocean">اقیانوسی • آبی فیروزه‌ای</option></select><canvas id="bkCanvas" style="display:block;width:100%;height:auto;margin-top:14px;border-radius:22px;border:1px solid #9ba7a0;box-shadow:0 12px 30px #0003"></canvas><div class="m20-btns"><button class="btn primary" type="button" onclick="m20BankPreview()">👁️ ساخت پیش‌نمایش</button><button class="btn primary" type="button" onclick="m20BankJPEG()">📥 خروجی JPEG</button></div></div>';window.m20BankPreview();};
window.m20BankPreview=function(){var c=document.getElementById('bkCanvas');if(!c)return;c.width=1200;c.height=750;var x=c.getContext('2d'),theme=document.getElementById('bkTheme').value,bank=document.getElementById('bkBank').value,num=(document.getElementById('bkNumber').value||'0000 0000 0000 0000').replace(/\D/g,'').slice(0,16).replace(/(.{4})/g,'$1 ').trim(),name=document.getElementById('bkName').value||'نام و نام خانوادگی';var themes={obsidian:['#292d35','#080a10','#d9bd83','#f7f4ed'],aurora:['#075b69','#18204e','#80f5d1','#ffffff'],royal:['#1c4c91','#091b43','#a9d8ff','#ffffff'],platinum:['#e9edf1','#8795a4','#344252','#17212c'],emerald:['#08765b','#063c37','#d7c18b','#ffffff'],nebula:['#7134a6','#17123e','#f4b7ff','#ffffff'],cyber:['#111a2d','#080c18','#35f2e2','#f6ffff'],marble:['#d9d5cf','#777c83','#927a5b','#20242a'],topo:['#244b40','#102b2b','#d8c58d','#ffffff'],sunset:['#d56a42','#582d58','#ffd38b','#ffffff'],minimal:['#f8fafc','#dfe6ed','#23415b','#162b3e'],ocean:['#087f91','#063d61','#a6f3ed','#ffffff']};var p=themes[theme]||themes.obsidian,light=theme==='platinum'||theme==='marble'||theme==='minimal';
// زمینه و گوشه‌های گرد
x.clearRect(0,0,1200,750);function rr(ctx,a,b,w,h,r){ctx.beginPath();ctx.moveTo(a+r,b);ctx.arcTo(a+w,b,a+w,b+h,r);ctx.arcTo(a+w,b+h,a,b+h,r);ctx.arcTo(a,b+h,a,b,r);ctx.arcTo(a,b,a+w,b,r);ctx.closePath();}
var bg=x.createLinearGradient(0,0,1200,750);bg.addColorStop(0,p[0]);bg.addColorStop(1,p[1]);x.fillStyle=bg;rr(x,0,0,1200,750,54);x.fill();x.save();rr(x,0,0,1200,750,54);x.clip();
// نقش‌های اختصاصی هر تم
if(theme==='topo'||theme==='marble'){x.strokeStyle=theme==='topo'?'rgba(226,213,160,.25)':'rgba(255,255,255,.38)';x.lineWidth=2;for(var k=0;k<13;k++){x.beginPath();for(var q=0;q<=24;q++){var xx=650+q*30, yy=110+k*45+Math.sin(q*.45+k*.7)*28+Math.cos(q*.2+k)*12;q?x.lineTo(xx,yy):x.moveTo(xx,yy);}x.stroke();}}
else if(theme==='aurora'||theme==='nebula'||theme==='sunset'){for(var j=0;j<8;j++){var rg=x.createRadialGradient(850+j*40,100+j*70,5,850+j*40,100+j*70,300);rg.addColorStop(0,j%2?'rgba(255,255,255,.18)':'rgba(100,255,220,.22)');rg.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=rg;x.fillRect(500,0,700,750);}x.lineWidth=3;x.strokeStyle='rgba(255,255,255,.15)';for(j=0;j<7;j++){x.beginPath();x.ellipse(930,370,180+j*36,65+j*19,-.5,0,Math.PI*2);x.stroke();}}
else if(theme==='cyber'||theme==='royal'||theme==='ocean'){x.strokeStyle='rgba(255,255,255,.13)';x.lineWidth=2;for(j=0;j<12;j++){x.beginPath();x.moveTo(700+j*55,0);x.lineTo(350+j*70,750);x.stroke();}for(j=0;j<9;j++){x.beginPath();x.arc(1000,330,70+j*36,0,Math.PI*2);x.stroke();}}
else{for(j=0;j<7;j++){x.strokeStyle='rgba(255,255,255,.07)';x.lineWidth=20;x.beginPath();x.arc(1030,320,100+j*48,0,Math.PI*2);x.stroke();}}
x.restore();
// نوار ظریف بالایی و نام برند
x.fillStyle=p[2];x.globalAlpha=.95;rr(x,64,62,1072,7,4);x.fill();x.globalAlpha=1;x.fillStyle=light?'#253447':'#ffffff';x.textAlign='right';x.direction='rtl';x.font='bold 43px Tahoma,Arial';x.fillText('بانک '+bank,1090,145);x.font='bold 27px Tahoma,Arial';x.textAlign='right';x.direction='rtl';x.fillText('جهت واریز وجه خدمات مهندسی',1090,198);x.font='bold 23px Arial';x.textAlign='left';x.direction='ltr';x.fillText('MILAD GEO',75,125);x.font='15px Arial';x.globalAlpha=.75;x.fillText('PREMIUM PAYMENT CARD',76,154);x.globalAlpha=1;
// چیپ فلزی با جزئیات
var cg=x.createLinearGradient(0,0,0,130);cg.addColorStop(0,'#fff0bd');cg.addColorStop(.45,'#c6a96b');cg.addColorStop(1,'#80663e');x.fillStyle=cg;rr(x,82,235,150,112,18);x.fill();x.strokeStyle='#5f513c';x.lineWidth=3;rr(x,94,247,126,88,13);x.stroke();x.beginPath();x.moveTo(157,248);x.lineTo(157,335);x.moveTo(95,291);x.lineTo(219,291);x.moveTo(125,248);x.lineTo(125,291);x.moveTo(190,291);x.lineTo(190,335);x.stroke();
// نماد بدون تماس
x.strokeStyle=light?'#34485b':'rgba(255,255,255,.9)';x.lineWidth=7;for(j=0;j<3;j++){x.beginPath();x.arc(285,290,22+j*20,-.85,.85);x.stroke();}x.fillStyle=light?'#34485b':'#fff';x.beginPath();x.arc(278,290,7,0,Math.PI*2);x.fill();
// شماره کارت
x.fillStyle=light?'#172b40':'#ffffff';x.textAlign='left';x.direction='ltr';x.shadowColor='#0005';x.shadowBlur=8;x.font='bold 72px Arial, sans-serif';x.fillText(num,82,490);x.shadowBlur=0;
// مشخصات دارنده
x.globalAlpha=.78;x.font='20px Arial';x.fillText('CARD HOLDER',84,566);x.globalAlpha=1;x.direction='rtl';x.textAlign='left';x.font='bold 44px Tahoma,Arial';x.fillText(name,84,628);
// لوگوی پرداخت عمومی و نشان اختصاصی
x.textAlign='right';x.direction='ltr';x.font='italic bold 49px Arial';x.fillStyle=light?'#263b50':'#ffffff';x.fillText('GEO',1100,640);x.font='14px Arial';x.globalAlpha=.8;x.fillText('SECURE • SIMPLE • PROFESSIONAL',1098,674);x.globalAlpha=1;
// قاب براق
x.strokeStyle=light?'rgba(30,50,70,.22)':'rgba(255,255,255,.3)';x.lineWidth=3;rr(x,2,2,1196,746,52);x.stroke();};
window.m20BankJPEG=function(){window.m20BankPreview();var a=document.createElement('a');a.download='شماره-کارت.jpg';a.href=document.getElementById('bkCanvas').toDataURL('image/jpeg',.95);a.click();};
/* M20 DOCX engine: creates a genuine Office Open XML .docx without CDN/JSZip dependencies. */
window.mgBuildDocxBlob=function(paragraphs){
 function xml(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;')}
 var body=(paragraphs||[]).map(function(p){p=typeof p==='string'?{text:p}:p;var text=String(p.text||'').split(/\r?\n/);return text.map(function(t){return '<w:p><w:pPr><w:bidi/><w:jc w:val="'+(p.center?'center':'both')+'"/><w:spacing w:after="'+(p.after==null?100:p.after)+'"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>'+(p.bold?'<w:b/>':'')+(p.size?'<w:sz w:val="'+p.size+'"/>':'')+'</w:rPr><w:t xml:space="preserve">'+xml(t||' ')+'</w:t></w:r></w:p>'}).join('')}).join('');
 var doc='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body>'+body+'<w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="850" w:right="850" w:bottom="850" w:left="850"/><w:bidi/></w:sectPr></w:body></w:document>';
 var files={'[Content_Types].xml':'<?xml version="1.0" encoding="UTF-8"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/><Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/></Types>','_rels/.rels':'<?xml version="1.0" encoding="UTF-8"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/></Relationships>','word/document.xml':doc,'word/styles.xml':'<?xml version="1.0" encoding="UTF-8"?><w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:docDefaults><w:rPrDefault><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:lang w:val="fa-IR" w:bidi="fa-IR"/></w:rPr></w:rPrDefault><w:pPrDefault><w:pPr><w:bidi/></w:pPr></w:pPrDefault></w:docDefaults></w:styles>'};
 var enc=new TextEncoder(),parts=[],central=[],offset=0;
 function crc32(a){var c=-1;for(var i=0;i<a.length;i++){c^=a[i];for(var j=0;j<8;j++)c=(c>>>1)^((c&1)?0xEDB88320:0)}return (c^(-1))>>>0}
 function u16(n){return [n&255,(n>>>8)&255]} function u32(n){return [n&255,(n>>>8)&255,(n>>>16)&255,(n>>>24)&255]}
 Object.keys(files).forEach(function(name){var nb=enc.encode(name),data=enc.encode(files[name]),crc=crc32(data),local=new Uint8Array([0x50,0x4b,3,4].concat(u16(20),u16(0x0800),u16(0),u16(0),u16(0),u32(crc),u32(data.length),u32(data.length),u16(nb.length),u16(0),Array.from(nb),Array.from(data)));parts.push(local);var cen=new Uint8Array([0x50,0x4b,1,2].concat(u16(20),u16(20),u16(0x0800),u16(0),u16(0),u16(0),u32(crc),u32(data.length),u32(data.length),u16(nb.length),u16(0),u16(0),u16(0),u16(0),u32(0),u32(offset),Array.from(nb)));central.push(cen);offset+=local.length});
 var csize=central.reduce(function(n,x){return n+x.length},0),end=new Uint8Array([0x50,0x4b,5,6].concat(u16(0),u16(0),u16(central.length),u16(central.length),u32(csize),u32(offset),u16(0)));return new Blob(parts.concat(central,[end]),{type:'application/vnd.openxmlformats-officedocument.wordprocessingml.document'});
};
window.mgDownloadDocx=function(name,paragraphs){try{var blob=window.mgBuildDocxBlob(paragraphs);saveBlobLikeMenu17(name,blob);return true}catch(e){console.error('DOCX writer',e);if(typeof toastMsg==='function')toastMsg('ساخت فایل Word ناموفق بود: '+(e.message||e));return false}};
/* Shared Word export: follows Accountant's Android-aware .doc download flow. */
window.mgDownloadWordLikeAccountant=function(name,html){
 try{
  name=String(name||'MiladGeo_Word.doc').replace(/[\\/:*?"<>|]+/g,'_');
  if(!/\.doc$/i.test(name))name=name.replace(/\.[^.]+$/,'')+'.doc';
  var blob=new Blob(['\ufeff',String(html||'')],{type:'application/msword;charset=utf-8'});
  if(window.AndroidBridge&&typeof window.AndroidBridge.saveFile==='function'&&typeof window.miladgeoDirectSaveBlob==='function'){
   window.miladgeoDirectSaveBlob(name,blob);return true;
  }
  if(typeof saveBlobLikeMenu17==='function'){
   var saved=saveBlobLikeMenu17(name,blob);if(saved!==false)return saved;
  }
  if(typeof browserSaveBlob==='function')return browserSaveBlob(name,blob,false);
  var url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.rel='noopener';a.style.display='block';a.style.position='fixed';a.style.left='8px';a.style.bottom='8px';a.style.zIndex='2147483647';a.textContent='دریافت فایل Word: '+name;document.body.appendChild(a);a.click();
  setTimeout(function(){try{URL.revokeObjectURL(url)}catch(e){}},30000);
  if(typeof showToast==='function')showToast('اگر دانلود خودکار شروع نشد، روی پیوند دریافت فایل بزن.');return true;
 }catch(e){console.error('MILADGEO_WORD_EXPORT',e);if(typeof showToast==='function')showToast('ساخت یا ذخیره فایل Word ناموفق بود: '+(e.message||e));else alert('ساخت یا ذخیره فایل Word ناموفق بود.');return false;}
};
window.m20ContractPanel=function(){
 var b=document.getElementById('m20Body');if(!b)return;
 function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
 function val(id){var e=document.getElementById(id);return e?e.value.trim():''}
 b.innerHTML='<div style="direction:rtl;text-align:right;color:#203528">'+
 '<div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap"><h3 style="margin:4px 0">📑 قرارداد خدمات نقشه‌برداری</h3><button class="btn gray" type="button" onclick="m20Open(\'archive\')">↩ بازگشت</button></div>'+
 '<p class="m20-meta">مشخصات طرفین و شرایط پروژه را وارد کن؛ متن قرارداد بر اساس اطلاعات واردشده آماده دریافت Word یا چاپ و ذخیره PDF می‌شود.</p>'+
 '<div class="m20-card" style="display:block;margin:9px 0;padding:12px"><b>۱. مشخصات طرفین</b>'+ 
 '<label style="display:block;margin-top:8px">نام و نام خانوادگی کارفرما<input id="m20CtrEmployer" class="m20-contract-input" placeholder="نام کامل کارفرما"></label>'+
 '<label style="display:block;margin-top:8px">شماره تماس کارفرما<input id="m20CtrEmployerPhone" type="tel" placeholder="شماره تماس"></label>'+
 '<label style="display:block;margin-top:8px">نام و نام خانوادگی نقشه‌بردار / پیمانکار<input id="m20CtrSurveyor" placeholder="نام کامل نقشه‌بردار"></label>'+
 '<label style="display:block;margin-top:8px">شماره تماس نقشه‌بردار<input id="m20CtrSurveyorPhone" type="tel" placeholder="شماره تماس"></label></div>'+
 '<div class="m20-card" style="display:block;margin:9px 0;padding:12px"><b>۲. مشخصات پروژه و مبلغ</b>'+
 '<label style="display:block;margin-top:8px">عنوان پروژه<input id="m20CtrProject" placeholder="عنوان یا نام پروژه"></label>'+
 '<label style="display:block;margin-top:8px">محل اجرای پروژه<input id="m20CtrLocation" placeholder="شهر، نشانی یا محدوده پروژه"></label>'+
 '<label style="display:block;margin-top:8px">موضوع و شرح خدمات نقشه‌برداری<textarea id="m20CtrScope" rows="3" placeholder="مثلاً برداشت وضع موجود، تهیه نقشه، پیاده‌سازی و ..."></textarea></label>'+
 '<label style="display:block;margin-top:8px">مبلغ کل قرارداد (تومان)<input id="m20CtrAmount" inputmode="numeric" placeholder="مبلغ به تومان"></label>'+
 '<label style="display:block;margin-top:8px">نحوه پرداخت<textarea id="m20CtrPayment" rows="2" placeholder="مثلاً پیش‌پرداخت و تسویه پس از تحویل"></textarea></label>'+
 '<label style="display:block;margin-top:8px">مدت انجام کار<input id="m20CtrDuration" placeholder="مثلاً ۱۰ روز کاری از تاریخ تحویل محل"></label>'+
 '<label style="display:block;margin-top:8px">تاریخ قرارداد<input id="m20CtrDate" placeholder="انتخاب تاریخ شمسی" readonly inputmode="none"><small style="display:block;color:#55745e;margin-top:4px">برای انتخاب تاریخ، روی کادر بزن.</small></label></div>'+
 '<div class="m20-card" style="display:block;margin:9px 0;padding:12px"><b>۳. توضیحات و توافق‌های تکمیلی</b><textarea id="m20CtrNotes" rows="3" placeholder="موارد خاص، نحوه تحویل، مسئولیت دسترسی به محل و سایر توافق‌ها"></textarea></div>'+
 '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0"><button class="btn primary" type="button" onclick="window.m20ContractExport(\'word\')">📝 دریافت فایل Word</button><button class="btn primary" type="button" onclick="window.m20ContractExport(\'pdf\')">📄 چاپ / ذخیره PDF</button></div>'+
 '<div class="m20-meta">این متن یک الگوی قابل ویرایش است. پیش از امضا، مشخصات، مبلغ، دامنه خدمات، زمان‌بندی و شروط را با توافق واقعی طرفین تطبیق دهید.</div></div>';
};
window.m20ContractExport=function(format){
 function v(id){var e=document.getElementById(id);return e?e.value.trim():''}
 function esc(x){return String(x||'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
 function line(label,id){var x=v(id);return '<p><b>'+label+' :</b> '+(esc(x)||'................................')+'</p>'}
 var employer=v('m20CtrEmployer'),surveyor=v('m20CtrSurveyor'),project=v('m20CtrProject');
 var html='<!doctype html><html lang="fa"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>قرارداد خدمات نقشه‌برداری</title><style>@page{size:A4;margin:16mm}*{box-sizing:border-box}body{font-family:Tahoma,Arial,sans-serif;direction:rtl;text-align:justify;line-height:1.9;color:#17251b;margin:0;background:#fff}.page{max-width:190mm;margin:0 auto;padding:12mm;border:2px solid #315c40;outline:1px solid #b7c8ba;outline-offset:-6px}.topline{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #9aaf9e;padding-bottom:8px;font-size:10px;color:#315c40}.docno{white-space:nowrap}h1{text-align:center;font-size:21px;margin:18px 0 3px;color:#1d4930}.subtitle{text-align:center;font-size:12px;color:#65766a;margin-bottom:18px}.intro,.article{border:1px solid #d5dfd7;border-radius:5px;padding:9px 12px;margin:8px 0;font-size:12px}h2{font-size:14px;color:#244d34;background:#edf3ee;border-right:4px solid #315c40;padding:6px 9px;margin:16px 0 7px}p{margin:5px 0}.details{width:100%;border-collapse:collapse;font-size:11px;margin:7px 0}.details th,.details td{border:1px solid #aebcaf;padding:7px;text-align:right;vertical-align:top}.details th{background:#f0f4f0;width:18%;white-space:nowrap}.sign{display:flex;justify-content:space-between;gap:16px;margin:32px 0 18px;break-inside:avoid}.sign div{width:50%;min-height:105px;border:1px solid #aebcaf;border-radius:5px;padding:10px;text-align:center;line-height:2}.sign strong{display:block;color:#244d34;border-bottom:1px solid #d5dfd7;margin-bottom:7px}.muted{font-size:9px;color:#66736a;border-top:1px solid #d5dfd7;padding-top:8px}.footer{text-align:center;font-size:9px;color:#65766a;margin-top:12px}@media print{body{background:#fff}.page{max-width:none;border:2px solid #315c40;outline:1px solid #b7c8ba;outline-offset:-6px;margin:0;padding:10mm;box-shadow:none}h2,.details th{-webkit-print-color-adjust:exact;print-color-adjust:exact}.sign,.details tr{break-inside:avoid} }</style></head><body><main class="page">'+ 
 '<div class="topline"><span>MiladGeo | خدمات مهندسی نقشه‌برداری</span><span class="docno">شماره قرارداد: ................</span></div>'+ 
 '<h1>قرارداد ارائه خدمات نقشه‌برداری</h1><div class="subtitle">سند توافق و تعهدات طرفین</div>'+ 
 '<div class="intro">این قرارداد در تاریخ <b>'+esc(v('m20CtrDate')||'................')+'</b>، با توافق و رضایت طرفین زیر و مطابق مفاد مندرج در این سند تنظیم می‌شود.</div>'+ 
 '<h2>ماده ۱ ـ مشخصات طرفین قرارداد</h2><table class="details"><tr><th>کارفرما</th><td>'+ (esc(employer)||'................................')+'</td><th>شماره تماس</th><td>'+(esc(v('m20CtrEmployerPhone'))||'................')+'</td></tr><tr><th>نقشه‌بردار / پیمانکار</th><td>'+(esc(surveyor)||'................................')+'</td><th>شماره تماس</th><td>'+(esc(v('m20CtrSurveyorPhone'))||'................')+'</td></tr></table>'+ 
 '<h2>ماده ۲ ـ موضوع و محل اجرای قرارداد</h2><table class="details"><tr><th>عنوان پروژه</th><td colspan="3">'+(esc(project)||'................................')+'</td></tr><tr><th>محل اجرا</th><td colspan="3">'+(esc(v('m20CtrLocation'))||'................................')+'</td></tr><tr><th>شرح خدمات</th><td colspan="3">'+(esc(v('m20CtrScope'))||'................................')+'</td></tr></table>'+ 
 '<h2>ماده ۳ ـ مبلغ و شرایط پرداخت</h2><table class="details"><tr><th>مبلغ کل قرارداد</th><td>'+(esc(v('m20CtrAmount'))||'................')+' تومان</td></tr><tr><th>نحوه پرداخت</th><td>'+(esc(v('m20CtrPayment'))||'................................')+'</td></tr></table>'+ 
 '<h2>ماده ۴ ـ مدت اجرای خدمات</h2><div class="article">مدت انجام خدمات: <b>'+(esc(v('m20CtrDuration'))||'................................')+'</b>. شروع عملیات و برنامه تحویل با هماهنگی طرفین و فراهم بودن شرایط دسترسی به محل پروژه خواهد بود.</div>'+ 
 '<h2>ماده ۵ ـ تعهدات طرفین</h2><div class="article"><p><b>۵-۱. تعهدات نقشه‌بردار:</b> اجرای خدمات در محدوده توافق‌شده با رعایت اصول فنی و حرفه‌ای؛ اطلاع‌رسانی درباره موانع مؤثر بر کار؛ و تحویل خروجی‌های توافق‌شده.</p><p><b>۵-۲. تعهدات کارفرما:</b> ارائه اطلاعات و مدارک لازم، فراهم‌کردن دسترسی متعارف و ایمن به محل، معرفی نماینده پاسخ‌گو در صورت نیاز و پرداخت مبالغ طبق توافق.</p><p><b>۵-۳. تغییرات:</b> هرگونه تغییر در موضوع، حجم خدمات، مبلغ یا زمان‌بندی باید با توافق طرفین ثبت شود.</p><p><b>۵-۴. تحویل:</b> قالب، تعداد نسخه‌ها و زمان تحویل نقشه‌ها و فایل‌ها مطابق شرح خدمات مورد توافق طرفین خواهد بود.</p></div>'+ 
 '<h2>ماده ۶ ـ توضیحات و توافق‌های تکمیلی</h2><div class="article">'+(esc(v('m20CtrNotes'))||'موردی درج نشده است.')+'</div>'+ 
 '<h2>ماده ۷ ـ نسخ قرارداد و امضا</h2><div class="article">این قرارداد در دو نسخه با اعتبار یکسان تنظیم می‌شود. طرفین پس از مطالعه مفاد و بررسی مشخصات، آن را امضا می‌کنند و هر نسخه نزد یکی از طرفین باقی می‌ماند.</div>'+ 
 '<div class="sign"><div><strong>کارفرما</strong>نام: '+(esc(employer)||'........................')+'<br>امضا و اثر انگشت:<br><br>تاریخ: ................</div><div><strong>نقشه‌بردار / پیمانکار</strong>نام: '+(esc(surveyor)||'........................')+'<br>امضا و اثر انگشت:<br><br>تاریخ: ................</div></div>'+ 
 '<div class="muted">این سند یک الگوی عمومی قابل ویرایش است. پیش از امضا، جزئیات فنی، مالی، حدود مسئولیت‌ها و الزامات قانونی متناسب با پروژه بررسی و تکمیل شود.</div><div class="footer">MiladGeo — قرارداد خدمات نقشه‌برداری</div></main></body></html>';
 if(format==='word'){
  return window.mgDownloadWordLikeAccountant('قرارداد-نقشه-برداری.doc',html);
 }else{
  if(typeof window.miladgeoM17PrintHtml==='function'){window.miladgeoM17PrintHtml(html,'قرارداد خدمات نقشه‌برداری');}
  else {try{window.print()}catch(e){alert('چاپ/ذخیره PDF در این دستگاه در دسترس نیست: '+e.message)}}
 }
};
window.m20Open=function(kind){load();if(kind==='contract'){var ih=document.getElementById('m20InvoiceHolder');if(ih)ih.style.display='none';if(window.m20ContractPanel)window.m20ContractPanel();scrollBody();return;}if(kind==='invoice'){var inv=document.getElementById('m16lib-invoice'),holder=document.getElementById('m20InvoiceHolder');if(inv&&holder){holder.style.display='block';if(inv.parentNode!==holder)holder.appendChild(inv);inv.classList.add('show');var body=document.getElementById('m20Body');if(body)body.innerHTML='<div class="m20-meta">فاکتور نقشه‌برداری و صورت‌وضعیت — برای بازگشت، دکمه فاکتور را دوباره بزن یا از منو استفاده کن.</div>';setTimeout(function(){holder.scrollIntoView({behavior:'smooth',block:'start'});},80);}return;}var holder=document.getElementById('m20InvoiceHolder');if(holder)holder.style.display='none';if(kind==='letterhead')letterheadPanel();else if(kind==='businesscard'){if(window.m20BusinessCardPanel)window.m20BusinessCardPanel();}else if(kind==='bankcard'){if(window.m20BankCardPanel)window.m20BankCardPanel();}else if(kind==='note')typedEditor();else if(kind==='notebooks')notebooks();else if(kind==='sketch')sketchPanel();else if(kind==='photo')photoPanel();else if(kind==='report')sarresidPanel();else if(kind==='accountant'){if(window.m20AccountantPanel)window.m20AccountantPanel();}else if(kind==='projectmanager'){if(window.m20ProjectManagerPanel)window.m20ProjectManagerPanel();}else archive();scrollBody()}
var _m20OpenCore=window.m20Open;window.m20Open=function(kind){if(window.m20SetArchiveCurrent)window.m20SetArchiveCurrent(kind||'archive');var result=_m20OpenCore.apply(this,arguments);setTimeout(function(){if(window.m20SaveMenuVersion)window.m20SaveMenuVersion()},1200);return result};

window.m20Init=function(){load()};
var inp=el('m20PhotoInput');if(inp)inp.addEventListener('change',function(){var f=this.files&&this.files[0];if(!f)return;var r=new FileReader();r.onload=function(){m20PhotoLoad(r.result)};r.readAsDataURL(f)});
})();
</script>
<script id="m10-v599-js">
(function(){
'use strict';
var st={ents:[],scale:1,ox:0,oy:0,pointers:{},drag:false,lastX:0,lastY:0,pinchStart:0,pinchScale:1,base:null,measureMode:'none',measurePts:[],measureResult:'',pointLabels:false,xyMode:false,plineMode:false,plineLastTap:0,results:[],markups:[]};
function q(id){return document.getElementById(id)}
function status(id,t){var e=q(id);if(e)e.textContent=t}
function esc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function scrollToId(id){var e=q(id);if(!e)return false;document.querySelectorAll('.m10-new-panel').forEach(function(p){p.classList.remove('m10-open')});document.querySelectorAll('.m10-new-card').forEach(function(c){c.classList.remove('m10-active')});e.classList.add('m10-open');var cards=document.querySelectorAll('.m10-new-card');var map={m10PdfCard:0,m10ReaderCard:1,m10DxfCard:2,m10WordReaderCard:3,m10ExcelReaderCard:4,m10MapReaderCard:5};var idx=Object.prototype.hasOwnProperty.call(map,id)?map[id]:0;if(cards[idx])cards[idx].classList.add('m10-active');setTimeout(function(){e.scrollIntoView({behavior:'smooth',block:'start'})},40);return false}
window.m10Scroll=scrollToId;
function readFile(file,cb,statusId){if(!file){status(statusId,'فایل انتخاب نشده است.');return false}var r=new FileReader();r.onload=function(){try{cb(String(r.result||''))}catch(e){console.error('M10_READ_PARSE',e);status(statusId,'خواندن یا پردازش فایل ناموفق بود.')}};r.onerror=function(){status(statusId,'خواندن فایل ناموفق بود.')};r.readAsText(file);return true}
function m10Pairs(text){var a=String(text||'').replace(/\r/g,'').split('\n'),out=[];for(var i=0;i+1<a.length;i+=2)out.push({c:a[i].trim(),v:a[i+1].trim()});return out}
function m10Parse(text){
 var p=m10Pairs(text),out=[],cur=null,poly=null,vertex=null;
 function finish(){if(cur){if(cur.pts&&cur.pts.length)out.push(cur);else if((cur.type==='TEXT'||cur.type==='MTEXT'||cur.type==='INSERT'||cur.type==='CIRCLE'||cur.type==='ARC')&&Number.isFinite(cur.cx)&&Number.isFinite(cur.cy))out.push(cur)}cur=null}
 function addVertex(){if(poly&&vertex&&Number.isFinite(vertex.x)&&Number.isFinite(vertex.y)){poly.pts.push(vertex)}vertex=null}
 for(var i=0;i<p.length;i++){
  var c=p[i].c,v=p[i].v;
  if(c==='0'){
   if(v==='SECTION'||v==='ENDSEC'||v==='EOF')continue;
   if(v==='SEQEND'){addVertex();if(poly){if(poly.pts.length)out.push(poly);poly=null}cur=null;continue}
   if(v==='VERTEX'){if(poly){addVertex();vertex={x:null,y:null,z:0};cur=poly}continue}
   if(v==='LINE'){finish();cur={type:'LINE',pts:[],layer:''}}
   else if(v==='POINT'){finish();cur={type:'POINT',pts:[],layer:''}}
   else if(v==='LWPOLYLINE'){finish();cur={type:'LWPOLYLINE',pts:[],closed:false,layer:'',pendingX:null}}
   else if(v==='POLYLINE'){finish();poly={type:'POLYLINE',pts:[],closed:false,layer:''};cur=poly}
   else if(v==='CIRCLE'){finish();cur={type:'CIRCLE',cx:null,cy:null,r:0,layer:''}}
   else if(v==='ARC'){finish();cur={type:'ARC',cx:null,cy:null,r:0,a1:0,a2:0,layer:''}}
   else if(v==='TEXT'||v==='MTEXT'){finish();cur={type:v,cx:null,cy:null,text:'',layer:''}}
   else if(v==='INSERT'){finish();cur={type:'INSERT',cx:null,cy:null,cz:0,block:'',layer:''}}
   else if(v==='3DFACE'){finish();cur={type:'LWPOLYLINE',pts:[],closed:true,layer:'',pendingX:null}}
   else {cur=null}
   continue;
  }
  if(!cur)continue;
  if(c==='8'){cur.layer=v}
  else if(c==='10'){
   var vx=parseFloat(v);
   if(cur.type==='POLYLINE'&&vertex){vertex.x=vx}
   else if(cur.type==='LINE')cur._x=vx;
   else if(cur.type==='POINT')cur._x=vx;
   else if(cur.type==='LWPOLYLINE')cur.pendingX=vx;
   else if(cur.type==='CIRCLE'||cur.type==='ARC'||cur.type==='TEXT'||cur.type==='MTEXT')cur.cx=vx;
  }
  else if(c==='20'){
   var vy=parseFloat(v);
   if(cur.type==='POLYLINE'&&vertex){vertex.y=vy}
   else if(cur.type==='LINE'){cur._y=vy;cur.pts=[{x:cur._x,y:vy,z:0}]}
   else if(cur.type==='POINT'){cur.pts=[{x:cur._x,y:vy,z:0}]}
   else if(cur.type==='LWPOLYLINE'&&Number.isFinite(cur.pendingX)){cur.pts.push({x:cur.pendingX,y:vy,z:0});cur.pendingX=null}
   else if(cur.type==='CIRCLE'||cur.type==='ARC'||cur.type==='TEXT'||cur.type==='MTEXT')cur.cy=vy;
  }
  else if(c==='30'){
   var vz=parseFloat(v);
   if(cur.type==='POLYLINE'&&vertex)vertex.z=vz;
   else if(cur.type==='POINT'&&cur.pts[0])cur.pts[0].z=vz;
   else if(cur.type==='LWPOLYLINE'&&cur.pts.length)cur.pts[cur.pts.length-1].z=vz;
   else if(cur.type==='INSERT')cur.cz=vz;
  }
  else if(c==='11'&&cur.type==='LINE')cur._x2=parseFloat(v);
  else if(c==='21'&&cur.type==='LINE'){cur._y2=parseFloat(v);cur.pts=[{x:cur._x,y:cur._y,z:0},{x:cur._x2,y:cur._y2,z:0}]}
  else if(c==='70'&&(cur.type==='LWPOLYLINE'||cur.type==='POLYLINE'))cur.closed=((parseInt(v)||0)&1)!==0;
  else if(c==='40'&&(cur.type==='CIRCLE'||cur.type==='ARC'))cur.r=parseFloat(v)||0;
  else if(c==='50'&&cur.type==='ARC')cur.a1=parseFloat(v)||0;
  else if(c==='51'&&cur.type==='ARC')cur.a2=parseFloat(v)||0;
  else if((c==='1'||c==='3')&&(cur.type==='TEXT'||cur.type==='MTEXT'))cur.text+=(cur.text?'\n':'')+v;
  else if(c==='2'&&cur.type==='INSERT')cur.block=v;
 }
 addVertex();if(poly&&poly.pts.length)out.push(poly);else finish();
 return out.filter(function(e){if((e.type==='CIRCLE'||e.type==='ARC')&&Number.isFinite(e.cx)&&Number.isFinite(e.cy))return true;if((e.type==='TEXT'||e.type==='MTEXT'||e.type==='INSERT')&&Number.isFinite(e.cx)&&Number.isFinite(e.cy))return true;return e.pts&&e.pts.length&&e.pts.every(function(pt){return Number.isFinite(pt.x)&&Number.isFinite(pt.y)})})
}
function bounds(ents){var xs=[],ys=[];function add(x,y){if(Number.isFinite(x)&&Number.isFinite(y)){xs.push(x);ys.push(y)}}ents.forEach(function(e){if(e.type==='CIRCLE'||e.type==='ARC'){add(e.cx-e.r,e.cy-e.r);add(e.cx+e.r,e.cy+e.r)}else if(e.type==='TEXT'||e.type==='MTEXT'||e.type==='INSERT')add(e.cx,e.cy);else (e.pts||[]).forEach(function(p){add(p.x,p.y)})});if(!xs.length)return null;var minX=Math.min.apply(null,xs),maxX=Math.max.apply(null,xs),minY=Math.min.apply(null,ys),maxY=Math.max.apply(null,ys);if(minX===maxX){minX-=1;maxX+=1}if(minY===maxY){minY-=1;maxY+=1}return{minX:minX,maxX:maxX,minY:minY,maxY:maxY}}
function svg(ents){var b=bounds(ents);if(!b)return '';var W=800,H=520,pad=35,sc=Math.min((W-2*pad)/(b.maxX-b.minX),(H-2*pad)/(b.maxY-b.minY));function X(x){return pad+(x-b.minX)*sc}function Y(y){return H-pad-(y-b.minY)*sc}var s='<rect width="800" height="520" fill="#eef2ed"/>';ents.forEach(function(e){if(e.type==='POINT'){(e.pts||[]).forEach(function(p){s+='<circle cx="'+X(p.x)+'" cy="'+Y(p.y)+'" r="3" fill="#1f6530"/>'})}else if(e.type==='LINE'){s+='<line x1="'+X(e.pts[0].x)+'" y1="'+Y(e.pts[0].y)+'" x2="'+X(e.pts[1].x)+'" y2="'+Y(e.pts[1].y)+'" stroke="#1b3d23" stroke-width="1.5"/>'}else if(e.type==='CIRCLE'){s+='<circle cx="'+X(e.cx)+'" cy="'+Y(e.cy)+'" r="'+Math.max(1,e.r*sc)+'" fill="none" stroke="#1b3d23" stroke-width="1.4"/>'}else if(e.type==='ARC'){var pts=[],n=40,a1=e.a1*Math.PI/180,a2=e.a2*Math.PI/180;if(a2<a1)a2+=Math.PI*2;for(var k=0;k<=n;k++){var a=a1+(a2-a1)*k/n;pts.push(X(e.cx+e.r*Math.cos(a))+','+Y(e.cy+e.r*Math.sin(a)))}s+='<polyline points="'+pts.join(' ')+'" fill="none" stroke="#1b3d23" stroke-width="1.4"/>'}else if(e.type==='TEXT'||e.type==='MTEXT'){s+='<text x="'+X(e.cx)+'" y="'+Y(e.cy)+'" font-size="12" fill="#17351e">'+esc(e.text||'')+'</text>'}else if(e.type==='INSERT'){s+='<circle cx="'+X(e.cx)+'" cy="'+Y(e.cy)+'" r="4" fill="#1f6530"/><path d="M'+(X(e.cx)-7)+' '+Y(e.cy)+' L'+(X(e.cx)+7)+' '+Y(e.cy)+' M'+X(e.cx)+' '+(Y(e.cy)-7)+' L'+X(e.cx)+' '+(Y(e.cy)+7)+'" stroke="#1f6530" stroke-width="1"/>'}else if(e.pts&&e.pts.length>=2){var ps=e.pts.map(function(p){return X(p.x)+','+Y(p.y)}).join(' ');if(e.closed)ps+=' '+X(e.pts[0].x)+','+Y(e.pts[0].y);s+='<polyline points="'+ps+'" fill="none" stroke="#1b3d23" stroke-width="1.5"/>'}});return s}
function canvas(ents){var c=document.createElement('canvas'),W=1600,H=1040,pad=70,b=bounds(ents);c.width=W;c.height=H;var ctx=c.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);if(!b)return c.toDataURL('image/png');var sc=Math.min((W-2*pad)/(b.maxX-b.minX),(H-2*pad)/(b.maxY-b.minY)),ox=pad+(W-2*pad-(b.maxX-b.minX)*sc)/2,oy=pad+(H-2*pad-(b.maxY-b.minY)*sc)/2;function X(x){return ox+(x-b.minX)*sc}function Y(y){return H-(oy+(y-b.minY)*sc)}ctx.strokeStyle='#d9e6d9';ctx.fillStyle='#d9e6d9';ctx.lineWidth=2;ctx.lineCap='round';ctx.lineJoin='round';ents.forEach(function(e){if(e.type==='POINT'){(e.pts||[]).forEach(function(p){ctx.beginPath();ctx.arc(X(p.x),Y(p.y),5,0,Math.PI*2);ctx.fill()})}else if(e.type==='LINE'){ctx.beginPath();ctx.moveTo(X(e.pts[0].x),Y(e.pts[0].y));ctx.lineTo(X(e.pts[1].x),Y(e.pts[1].y));ctx.stroke()}else if(e.type==='CIRCLE'){ctx.beginPath();ctx.arc(X(e.cx),Y(e.cy),Math.max(1,e.r*sc),0,Math.PI*2);ctx.stroke()}else if(e.type==='ARC'){ctx.beginPath();var a1=e.a1*Math.PI/180,a2=e.a2*Math.PI/180;if(a2<a1)a2+=Math.PI*2;ctx.arc(X(e.cx),Y(e.cy),Math.max(1,e.r*sc),-a2,-a1);ctx.stroke()}else if(e.type==='INSERT'){ctx.beginPath();ctx.arc(X(e.cx),Y(e.cy),4,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.moveTo(X(e.cx)-7,Y(e.cy));ctx.lineTo(X(e.cx)+7,Y(e.cy));ctx.moveTo(X(e.cx),Y(e.cy)-7);ctx.lineTo(X(e.cx),Y(e.cy)+7);ctx.stroke()}else if(e.type==='TEXT'||e.type==='MTEXT'){ctx.font='18px Arial';ctx.fillText(String(e.text||''),X(e.cx),Y(e.cy))}else if(e.pts&&e.pts.length>=2){ctx.beginPath();ctx.moveTo(X(e.pts[0].x),Y(e.pts[0].y));for(var j=1;j<e.pts.length;j++)ctx.lineTo(X(e.pts[j].x),Y(e.pts[j].y));if(e.closed)ctx.closePath();ctx.stroke()}});return c.toDataURL('image/png')}
function setEntities(ents){st.ents=ents||[];window.__m10PdfEnts=st.ents;try{window.cadEntities=st.ents}catch(e){}return st.ents}
window.m10LoadDxfForPdf=function(){var f=q('m10PdfFile')&&q('m10PdfFile').files[0];if(!f){status('m10PdfStatus','ابتدا فایل DXF را انتخاب کن.');return false}if(!/\.dxf$/i.test(f.name)){status('m10PdfStatus','فقط فایل DXF انتخاب کن.');return false}status('m10PdfStatus','در حال خواندن و پردازش DXF...');readFile(f,function(txt){var ents=m10Parse(txt);setEntities(ents);q('m10PdfPreview').innerHTML=ents.length?svg(ents):'';m10PdfPreviewZoom(0);q('m10PdfSettings').style.display=ents.length?'block':'none';status('m10PdfStatus',ents.length?'✓ '+ents.length+' عارضه خوانده شد. خروجی‌ها فعال شدند.':'✗ هیچ عارضه قابل نمایش در فایل پیدا نشد.');if(ents.length)scrollToId('m10PdfCard')},'m10PdfStatus');return false}
/* Menu 10 PDF outputs share Menu 17's print pipeline and Android/browser fallback. */
window.m10SendHtmlThroughMenu17=function(html,title,successMessage){
 try{
  if(typeof window.miladgeoM17PrintHtml==='function'){
   var result=window.miladgeoM17PrintHtml(html,title||'MiladGeo');
   if(result!==false){
    if(successMessage)showToast(successMessage);
    return true;
   }
  }
 }catch(e){console.error('M10_M17_PRINT',e);}
 try{
  if(window.AndroidBridge&&typeof window.AndroidBridge.printHtml==='function'){
   var nativeResult=window.AndroidBridge.printHtml(html);
   if(nativeResult!==false){
    if(successMessage)showToast(successMessage);
    return true;
   }
  }
 }catch(e2){console.error('M10_ANDROID_PRINT',e2);}
 try{
  var w=window.open('','_blank');
  if(!w){showToast('موتور چاپ در دسترس نیست؛ اجازه بازشدن پنجره چاپ را بررسی کن');return false;}
  w.document.open();w.document.write(html);w.document.close();
  setTimeout(function(){try{w.focus();w.print();}catch(e3){console.error('M10_BROWSER_PRINT',e3);}},700);
  if(successMessage)showToast(successMessage);
  return true;
 }catch(e4){console.error('M10_PRINT_FALLBACK',e4);showToast('ارسال خروجی به چاپ ناموفق بود');return false;}
}
/* Milad Dastyar chat: shared local DXF parser -> vector PDF print pipeline. */
window.m10ChatPrepareCadPdf=function(dxfText,fileName){
 var ents=m10Parse(String(dxfText||''));
 if(!ents||!ents.length)throw new Error('فایل باز شد اما عارضه قابل تبدیل پیدا نشد؛ نسخه DXF را بررسی کن.');
 var art=svg(ents).replace('fill="#eef2ed"','fill="#ffffff"');
 if(!art)throw new Error('از عارضه‌های فایل، پیش‌نمایش قابل ساخت نیست.');
 var drawing='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" preserveAspectRatio="xMidYMid meet">'+art+'</svg>';
 var title=String(fileName||'نقشه مهندسی').replace(/\.(dwg|dxf)$/i,'');
 var safeTitle=esc(title),date=new Date().toLocaleDateString('fa-IR');
 var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+safeTitle+' - MiladGeo PDF</title><style>@page{size:A4 landscape;margin:10mm}*{box-sizing:border-box}html,body{margin:0;padding:0;background:#fff;color:#111;font-family:Tahoma,Arial,sans-serif}.sheet{width:100%;height:100%;display:flex;flex-direction:column;gap:4mm}.head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid #333;padding-bottom:3mm}.head h1{font-size:15pt;margin:0 0 2mm}.meta{font-size:8pt;color:#444;margin:0}.brand{font-size:9pt;font-weight:bold;text-align:left}.drawing{width:100%;height:165mm;border:0.3mm solid #555;background:#fff}.drawing svg{width:100%;height:100%;display:block}.foot{display:flex;justify-content:space-between;font-size:7pt;color:#555;margin-top:auto}@media screen{body{padding:12px}.sheet{max-width:1100px;margin:auto}.drawing{height:auto;aspect-ratio:800/520}}@media print{.sheet{height:180mm}.drawing{height:155mm}}</style></head><body><main class="sheet"><header class="head"><div><h1>'+safeTitle+'</h1><p class="meta">تبدیل محلی فایل CAD با میلاد دستیار | تعداد عارضه: '+ents.length+' | تاریخ: '+esc(date)+'</p></div><div class="brand">MILADGEO<br>ENGINEERING</div></header><section class="drawing">'+drawing+'</section><footer class="foot"><span>خروجی برداری از فایل نقشه‌برداری</span><span>A4 افقی • تهیه‌شده با MiladGeo</span></footer></main><script>window.addEventListener("load",function(){setTimeout(function(){try{window.focus();window.print()}catch(e){}},350)});</scr'+'ipt></body></html>';
 return {count:ents.length,svg:drawing,html:html};
};
window.m10ChatPrintCadPdf=function(html,title){return window.m10SendHtmlThroughMenu17(html,title||'MiladGeo CAD PDF','✓ فایل برای چاپ و ذخیره PDF آماده شد');};

window.m10PrintPdf=function(){
 var ents=st.ents;
 if(!ents.length){showToast('ابتدا DXF را بخوان');return false}
 var title=(q('m10PdfTitle')&&q('m10PdfTitle').value)||'MILADGEO SURVEY MAP';
 var project=(q('m10PdfProject')&&q('m10PdfProject').value)||'';
 var author=(q('m10PdfAuthor')&&q('m10PdfAuthor').value)||'';
 var drawingNo=(q('m10PdfDrawingNo')&&q('m10PdfDrawingNo').value)||'';
 var paper=q('m10PdfPaper').value,ori=q('m10PdfOrient').value,scale=q('m10PdfScale').value;
 var margin=Math.max(0,Math.min(30,Number(q('m10PdfMargin')&&q('m10PdfMargin').value)||10));
 var paperDims={A5:[148,210],A4:[210,297],A3:[297,420]},dims=paperDims[paper]||paperDims.A4;
 var pageW=(ori==='landscape'?dims[1]:dims[0]),pageH=(ori==='landscape'?dims[0]:dims[1]);
 var art=svg(ents).replace('fill="#eef2ed"','fill="#ffffff"'); if(!art){showToast('نقشه قابل ترسیم نیست');return false}
 /* SVG geometry stays vector; viewBox keeps the complete drawing fitted and centered. */
 var drawingSvg='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" preserveAspectRatio="xMidYMid meet" role="img" aria-label="DXF drawing">'+art+'</svg>';
 var date=new Date().toLocaleDateString('fa-IR');
 var scaleLabel=scale==='fit'?'جای‌گیری خودکار':('۱ : '+scale);
 var meta=[project&&('پروژه: '+project),author&&('تهیه‌کننده: '+author),drawingNo&&('شماره نقشه: '+drawingNo),'کاغذ '+paper,ori==='landscape'?'افقی':'عمودی','مقیاس انتخابی: '+scaleLabel,'تاریخ: '+date].filter(Boolean).join(' | ');
 var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+esc(title)+'</title><style>'+
 '@page{size:'+paper+' '+ori+';margin:'+margin+'mm}*{box-sizing:border-box}html,body{margin:0;padding:0;background:#fff;color:#111;font-family:Tahoma,Arial,sans-serif}body{width:100%;-webkit-print-color-adjust:exact;print-color-adjust:exact}.sheet{width:100%;min-height:0;display:flex;flex-direction:column;gap:3mm}.head{display:flex;justify-content:space-between;align-items:flex-start;gap:6mm;border-bottom:0.35mm solid #333;padding-bottom:2mm}.head h1{font-size:15pt;margin:0 0 1mm;font-weight:700}.brand{font-size:8pt;color:#444;white-space:nowrap}.meta{font-size:7.5pt;line-height:1.7;color:#222;margin:0}.drawing{width:100%;height:auto;max-height:calc(100vh - 45mm);aspect-ratio:800/520;border:0.25mm solid #444;background:#fff;overflow:hidden}.drawing svg{display:block;width:100%;height:100%;max-height:100%;background:#fff}.titleblock{border:0.25mm solid #333;display:grid;grid-template-columns:2fr 1fr 1fr;font-size:7pt;min-height:12mm}.cell{padding:1.5mm;border-left:0.2mm solid #777;overflow-wrap:anywhere}.cell b{display:block;font-size:6pt;color:#555;margin-bottom:1mm}.foot{display:flex;justify-content:space-between;font-size:6.5pt;color:#555;margin-top:auto}@media screen{body{padding:10px}.sheet{max-width:1200px;margin:auto}.drawing{max-height:none}.titleblock{margin-top:2mm}}@media print{.sheet{break-inside:avoid}.drawing{max-height:none;height:auto;flex:1}.no-print{display:none!important}}'+
 '</style></head><body><main class="sheet"><header class="head"><div><h1>'+esc(title)+'</h1><p class="meta">'+esc(meta)+'</p></div><div class="brand">MILADGEO<br>ENGINEERING DRAWING</div></header><section class="drawing">'+drawingSvg+'</section><section class="titleblock"><div class="cell"><b>نام پروژه / PROJECT</b>'+esc(project||'—')+'</div><div class="cell"><b>شماره نقشه / DRAWING NO.</b>'+esc(drawingNo||'—')+'</div><div class="cell"><b>مقیاس / SCALE</b>'+esc(scaleLabel)+'</div><div class="cell"><b>تهیه‌کننده / PREPARED BY</b>'+esc(author||'—')+'</div><div class="cell"><b>تاریخ / DATE</b>'+esc(date)+'</div><div class="cell"><b>برگه / SHEET</b>1 / 1</div></section><footer class="foot"><span>تهیه‌شده با ابزارهای مهندسی میلادژئو</span><span>'+esc(paper)+' • '+(ori==='landscape'?'افقی':'عمودی')+' • حاشیه '+margin+' mm</span></footer></main><script>window.addEventListener("load",function(){setTimeout(function(){try{window.focus();window.print()}catch(e){}},350)});</scr'+'ipt></body></html>';
 window.m10SendHtmlThroughMenu17(html,title,'✓ PDF نقشه به مسیر خروجی منوی ۱۷ ارسال شد');return false
}
function m10PointRows(){
 var rows=[],i,j,e;
 for(i=0;i<st.ents.length;i++){
  e=st.ents[i];
  if(e.type==='POINT'){
   for(j=0;j<(e.pts||[]).length;j++)rows.push({no:'P'+String(rows.length+1).padStart(3,'0'),type:'POINT',layer:e.layer||'-',x:Number(e.pts[j].x)||0,y:Number(e.pts[j].y)||0,z:Number(e.pts[j].z)||0});
  }else if(e.type==='INSERT'){
   rows.push({no:'P'+String(rows.length+1).padStart(3,'0'),type:'INSERT',layer:e.layer||'-',x:Number(e.cx)||0,y:Number(e.cy)||0,z:Number(e.cz)||0});
  }
 }
 if(!rows.length){
  for(i=0;i<st.ents.length;i++){
   e=st.ents[i];
   if(e.type==='LWPOLYLINE'||e.type==='POLYLINE')for(j=0;j<(e.pts||[]).length;j++)rows.push({no:'V'+String(rows.length+1).padStart(3,'0'),type:'VERTEX',layer:e.layer||'-',x:Number(e.pts[j].x)||0,y:Number(e.pts[j].y)||0,z:Number(e.pts[j].z)||0});
  }
 }
 return rows;
}
window.m10PointPdf=function(){
 var pts=m10PointRows();
 if(!pts.length){showToast('هیچ نقطه یا رأس قابل خروجی پیدا نشد');return false}
 var rows=pts.map(function(p){return '<tr><td>'+esc(p.no)+'</td><td>'+esc(p.type)+'</td><td>'+esc(p.layer)+'</td><td>'+p.x.toFixed(4)+'</td><td>'+p.y.toFixed(4)+'</td><td>'+p.z.toFixed(4)+'</td></tr>'}).join('');
 var fileName=(q('m10PdfFile')&&q('m10PdfFile').files[0])?q('m10PdfFile').files[0].name:'DXF';
 var html='<!doctype html><html dir="rtl"><head><meta charset="utf-8"><title>MiladGeo - فهرست نقاط DXF</title><style>@page{size:A4 landscape;margin:10mm}body{font-family:Tahoma,Arial,sans-serif;margin:0;padding:12px;color:#111;background:#fff}h2{margin:0 0 6px;font-size:18px}.meta{font-size:10px;margin:0 0 12px;color:#444}table{border-collapse:collapse;width:100%;font-size:10px;direction:ltr}th,td{border:1px solid #666;padding:5px;text-align:center}th{background:#e8eee8} </style></head><body><h2>فهرست نقاط DXF — MiladGeo</h2><div class="meta">فایل: '+esc(fileName)+' | تعداد: '+pts.length+'</div><table><thead><tr><th>شماره</th><th>نوع</th><th>لایه</th><th>X</th><th>Y</th><th>Z</th></tr></thead><tbody>'+rows+'</tbody></table></body></html>';
 window.m10SendHtmlThroughMenu17(html,'MiladGeo DXF Point List','✓ فهرست نقاط به مسیر خروجی منوی ۱۷ ارسال شد');return false;
};
window.m10PointCsv=function(){
 var pts=m10PointRows();
 if(!pts.length){showToast('هیچ نقطه یا رأس قابل خروجی پیدا نشد');return false}
 var csv='No,Type,Layer,X,Y,Z\n'+pts.map(function(p){return [p.no,p.type,p.layer,p.x,p.y,p.z].map(function(v){return '"'+String(v).replace(/"/g,'""')+'"'}).join(',')}).join('\n');
 var base=((q('m10PdfFile')&&q('m10PdfFile').files[0])?q('m10PdfFile').files[0].name.replace(/\.[^.]+$/,''):'MILADGEO');
 if(typeof downloadTextFile==='function')downloadTextFile(base+'_POINT_LIST.csv','\ufeff'+csv,'text/csv;charset=utf-8');else{var a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download=base+'_POINT_LIST.csv';a.click()}
 showToast('✓ خروجی CSV نقاط آماده شد');return false;
};
var m10PdfPreviewZoomLevel=1;
window.m10PdfPreviewZoom=function(factor){var el=q('m10PdfPreview');if(!el)return false;m10PdfPreviewZoomLevel=factor===0?1:Math.max(.5,Math.min(5,m10PdfPreviewZoomLevel*factor));el.style.transform='scale('+m10PdfPreviewZoomLevel+')';var lab=q('m10PdfPreviewZoomLabel');if(lab)lab.textContent=Math.round(m10PdfPreviewZoomLevel*100)+'٪';return false};
window.m10FullPdf=function(){
 var ents=st.ents;if(!ents.length){showToast('ابتدا فایل DXF را بخوان');return false}
 var pts=m10PointRows(),rows=pts.map(function(p){return '<tr><td>'+esc(p.no)+'</td><td>'+esc(p.type)+'</td><td>'+esc(p.layer)+'</td><td>'+p.x.toFixed(4)+'</td><td>'+p.y.toFixed(4)+'</td><td>'+p.z.toFixed(4)+'</td></tr>'}).join('');
 var title=(q('m10PdfTitle')&&q('m10PdfTitle').value)||'نقشه مهندسی';
 var project=(q('m10PdfProject')&&q('m10PdfProject').value)||'—',author=(q('m10PdfAuthor')&&q('m10PdfAuthor').value)||'—',drawingNo=(q('m10PdfDrawingNo')&&q('m10PdfDrawingNo').value)||'—';
 var paper=q('m10PdfPaper').value,ori=q('m10PdfOrient').value,scale=q('m10PdfScale').value,margin=Math.max(0,Math.min(30,Number(q('m10PdfMargin')&&q('m10PdfMargin').value)||10));
 var dims={A5:[148,210],A4:[210,297],A3:[297,420]}[paper]||[210,297],pw=ori==='landscape'?dims[1]:dims[0],ph=ori==='landscape'?dims[0]:dims[1];
 var drawing=svg(ents).replace('fill="#eef2ed"','fill="#ffffff"'),date=new Date().toLocaleDateString('fa-IR'),scaleLabel=scale==='fit'?'جای‌گیری خودکار':'۱ : '+scale;
 var fname=(q('m10PdfFile')&&q('m10PdfFile').files[0])?q('m10PdfFile').files[0].name:'DXF';
 var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><title>'+esc(title)+' - PDF کامل</title><style>@page{size:'+paper+' '+ori+';margin:'+margin+'mm}*{box-sizing:border-box}body{font-family:Tahoma,Arial,sans-serif;color:#111;margin:0;background:#fff}.sheet{width:100%}.head{border-bottom:1px solid #333;padding-bottom:3mm;margin-bottom:3mm}.head h1{font-size:15pt;margin:0 0 2mm}.meta{font-size:8pt;line-height:1.8}.drawing{width:100%;height:46vh;min-height:70mm;max-height:125mm;border:0.3mm solid #555;overflow:hidden}.drawing svg{width:100%;height:100%;display:block;background:#fff}.block{margin-top:4mm}.block h2{font-size:11pt;margin:0 0 2mm;background:#e9eee9;padding:2mm;border:0.2mm solid #777}table{border-collapse:collapse;width:100%;direction:ltr;font-size:7.5pt}th,td{border:0.2mm solid #555;padding:1.5mm;text-align:center;white-space:nowrap}th{background:#e9eee9}.foot{font-size:7pt;margin-top:3mm;display:flex;justify-content:space-between}.empty{padding:8mm;text-align:center;border:1px dashed #777}@media screen{body{padding:12px}.sheet{max-width:1200px;margin:auto}.drawing{height:50vh}}@media print{.drawing{height:42vh;min-height:65mm}.block{break-inside:auto}tr{break-inside:avoid}}</style></head><body><main class="sheet"><header class="head"><h1>'+esc(title)+'</h1><div class="meta">فایل: '+esc(fname)+' | پروژه: '+esc(project)+' | تهیه‌کننده: '+esc(author)+' | شماره نقشه: '+esc(drawingNo)+'<br>کاغذ: '+paper+' | جهت: '+(ori==='landscape'?'افقی':'عمودی')+' | مقیاس: '+esc(scaleLabel)+' | تاریخ: '+esc(date)+'</div></header><section class="drawing">'+(drawing?'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" preserveAspectRatio="xMidYMid meet">'+drawing+'</svg>':'<div class="empty">نقشه‌ای برای نمایش وجود ندارد</div>')+'</section><section class="block"><h2>فهرست نقاط و مختصات</h2><div class="meta">تعداد ردیف‌ها: '+pts.length+' | ستون‌ها: شماره، نوع، لایه، X، Y، Z</div>'+(pts.length?'<table><thead><tr><th>شماره</th><th>نوع</th><th>لایه</th><th>X</th><th>Y</th><th>Z</th></tr></thead><tbody>'+rows+'</tbody></table>':'<div class="empty">نقطه یا رأس قابل استخراج در فایل پیدا نشد.</div>')+'</section><footer class="foot"><span>MiladGeo • خروجی مهندسی DXF</span><span>'+paper+' | '+(ori==='landscape'?'افقی':'عمودی')+' | '+pts.length+' نقطه/رأس</span></footer></main><script>window.addEventListener("load",function(){setTimeout(function(){try{window.focus()}catch(e){}},150)});<\\/script></body></html>';
 window.m10SendHtmlThroughMenu17(html,title+' PDF کامل','✓ PDF کامل به مسیر خروجی منوی ۱۷ ارسال شد');return false;
};
window.m10ResetPdf=function(){var f=q('m10PdfFile');if(f)f.value='';setEntities([]);q('m10PdfPreview').innerHTML='';m10PdfPreviewZoom(0);q('m10PdfSettings').style.display='none';status('m10PdfStatus','فایل DXF را انتخاب کن.');return false}
window.m10OpenPdf=function(){var f=q('m10PdfReaderFile')&&q('m10PdfReaderFile').files[0],b=q('m10PdfOpenExternal');if(!f)return false;if(!/\.pdf$/i.test(f.name)&&f.type!=='application/pdf'){status('m10PdfReaderStatus','فقط فایل PDF انتخاب کن.');return false}if(b){b.dataset.fileName=f.name||'MiladGeo.pdf';b.style.display='block'}status('m10PdfReaderStatus','✓ فایل PDF آماده است. دکمه بزرگ زیر را بزن.');scrollToId('m10ReaderCard');return false}
window.m10OpenPdfExternal=function(){var b=q('m10PdfOpenExternal'),input=q('m10PdfReaderFile'),f=input&&input.files&&input.files[0];if(!f){showToast('ابتدا فایل PDF را انتخاب کن');return false}try{if(window.AndroidBridge&&typeof window.AndroidBridge.openPdf==='function'){var r=new FileReader();r.onload=function(){try{var a=new Uint8Array(r.result),bin='',i;for(i=0;i<a.length;i+=8192)bin+=String.fromCharCode.apply(null,a.subarray(i,Math.min(i+8192,a.length)));var base64=btoa(bin);window.AndroidBridge.openPdf(base64,f.name||'MiladGeo.pdf')}catch(e){console.error('M10_NATIVE_PDF_BASE64',e);showToast('باز کردن PDF ناموفق بود')}};r.onerror=function(){showToast('خواندن فایل PDF ناموفق بود')};r.readAsArrayBuffer(f);return false}}catch(e){console.error('M10_NATIVE_PDF',e)}try{var url=URL.createObjectURL(f);var w=window.open(url,'_blank');if(!w)showToast('نمایشگر داخلی مرورگر در دسترس نیست')}catch(e2){showToast('باز کردن PDF ناموفق بود')}return false} 

window.m10ExportExcel=function(){
 if(!st.ents.length){showToast('ابتدا فایل DXF را بخوان');return false}
 try{
  var rows=[['شماره','نوع','لایه','X','Y','Z']];
  function csvCell(v){
   var x=String(v==null?'':v);
   if(/[",\r\n]/.test(x))x='"'+x.replace(/"/g,'""')+'"';
   return x;
  }
  st.ents.forEach(function(e){
   if(e.type==='POINT'){
    (e.pts||[]).forEach(function(p){rows.push(['P'+String(rows.length).padStart(3,'0'),'POINT',e.layer||'-',p.x,p.y,p.z||0])});
   }else if(e.type==='INSERT'){
    rows.push(['P'+String(rows.length).padStart(3,'0'),'INSERT',e.layer||'-',e.cx||0,e.cy||0,e.cz||0]);
   }else if(e.pts&&e.pts.length){
    e.pts.forEach(function(p){rows.push(['V'+String(rows.length).padStart(3,'0'),'VERTEX',e.layer||'-',p.x,p.y,p.z||0])});
   }else if(e.cx!=null&&e.cy!=null){
    rows.push(['P'+String(rows.length).padStart(3,'0'),e.type,e.layer||'-',e.cx,e.cy,e.cz||0]);
   }
  });
  st.results.forEach(function(r,i){
   rows.push(['R'+(i+1),r.type||'RESULT','نتایج',String(r.text||'').replace(/<br\s*\/?\s*>/gi,' | ').replace(/<[^>]*>/g,''),'','']);
  });
  var csv='\uFEFF'+rows.map(function(row){return row.map(csvCell).join(',')}).join('\r\n');
  var file=(q('m10DxfFile')&&q('m10DxfFile').files[0])||(q('m10PdfFile')&&q('m10PdfFile').files[0]);
  var base=(file&&file.name?file.name.replace(/\.(dxf|pdf)$/i,''):'MILADGEO');
  var blob=new Blob([csv],{type:'text/csv;charset=utf-8'});
  var saveResult=saveBlobLikeMenu17(base+'_MiladGeo.csv',blob);
  if(saveResult!==false)showToast('✓ خروجی Excel/CSV با روش ذخیره‌سازی منوی ۱۷ آماده شد');
 }catch(e){console.error('M10_CSV_EXPORT',e);showToast('ساخت خروجی Excel/CSV ناموفق بود')}
 return false
};;
window.m10ExportPDF=function(){
 if(!st.ents.length){showToast('ابتدا فایل DXF را بخوان');return false}
 var canvasEl=q('m10DxfCanvas'),img='';try{img=canvasEl.toDataURL('image/png')}catch(e){}
 var file=q('m10DxfFile')&&q('m10DxfFile').files[0],results=st.results.map(function(r){return '<tr><td>'+esc(String(r.text||'').replace(/<br\s*\/?\s*>/gi,' | ').replace(/<[^>]*>/g,''))+'</td></tr>'}).join('');
 var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>گزارش DXF - MiladGeo</title><style>@page{size:A4 landscape;margin:10mm}body{font-family:Tahoma,Arial,sans-serif;color:#18251b}h2{text-align:center}img{display:block;max-width:100%;max-height:65vh;margin:10px auto;border:1px solid #888;background:#050805}table{width:100%;border-collapse:collapse;margin-top:12px}td,th{border:1px solid #aaa;padding:7px}.meta{line-height:2}</style></head><body><h2>گزارش نقشه DXF - MiladGeo</h2><div class="meta">نام فایل: '+esc(file&&file.name||'DXF')+'<br>تعداد عارضه‌ها: '+m10Fmt(st.ents.length)+'<br>تعداد لایه‌ها: '+m10Fmt(Object.keys(st.ents.reduce(function(a,e){a[e.layer||'0']=1;return a},{})).length)+'</div>'+(img?'<img src="'+img+'">':'<p>تصویر نقشه در دسترس نیست.</p>')+'<h3>نتایج مختصات و اندازه‌گیری</h3><table><thead><tr><th>نتیجه</th></tr></thead><tbody>'+(results||'<tr><td>نتیجه‌ای ثبت نشده است.</td></tr>')+'</tbody></table></body></html>';
 try{
  if(typeof window.miladgeoM17PrintHtml==='function'){window.miladgeoM17PrintHtml(html,'MiladGeo DXF Report');return false}
  if(window.AndroidBridge&&typeof window.AndroidBridge.printHtml==='function'){window.AndroidBridge.printHtml(html);return false}
  showToast('موتور چاپ منوی ۱۷ در دسترس نیست؛ خروجی PDF انجام نشد');
 }catch(e){console.error('M10_PDF',e);showToast('ساخت PDF ناموفق بود')}
 return false
};
window.m10OpenPdfInternal=window.m10OpenPdfExternal
function m10Fmt(n){return Number(n).toLocaleString('fa-IR',{maximumFractionDigits:3})}
function m10UpdateDetails(file){var box=q('m10DxfDetails'),stats=q('m10DxfStats'),layers=q('m10DxfLayers');if(!box||!stats||!layers)return;var counts={},types={},pts=0;st.ents.forEach(function(e){var l=e.layer||'0 (بدون نام)';counts[l]=(counts[l]||0)+1;types[e.type]=(types[e.type]||0)+1;pts+=(e.pts||[]).length});var b=st.base;stats.innerHTML='<div>نام فایل: <b>'+esc(file&&file.name||'DXF')+'</b></div><div>تعداد عارضه‌ها: <b>'+m10Fmt(st.ents.length)+'</b> | تعداد رأس‌ها/نقاط: <b>'+m10Fmt(pts)+'</b></div><div>محدوده X: '+(b?m10Fmt(b.minX)+' تا '+m10Fmt(b.maxX):'—')+' | محدوده Y: '+(b?m10Fmt(b.minY)+' تا '+m10Fmt(b.maxY):'—')+'</div><div>نوع عارضه‌ها: '+Object.keys(types).map(function(k){return esc(k)+' ('+m10Fmt(types[k])+')'}).join('، ')+'</div><div>تعداد لایه‌ها: <b>'+m10Fmt(Object.keys(counts).length)+'</b></div>';layers.innerHTML=Object.keys(counts).sort().map(function(l){return '<div style="padding:7px 9px;border-radius:8px;background:#1a291c;display:flex;justify-content:space-between;gap:8px"><span>'+esc(l)+'</span><b>'+m10Fmt(counts[l])+' عارضه</b></div>'}).join('');box.style.display='block'}
function m10UpdateResults(){var host=q('m10ResultsList');if(!host)return;if(!st.results.length){host.innerHTML='<div style="font-size:12px;color:#aabbaa">هنوز نتیجه‌ای ثبت نشده است.</div>';return}host.innerHTML=st.results.map(function(r,i){return '<div style="display:flex;align-items:center;gap:5px;padding:7px;border:1px solid #344a35;border-radius:8px;background:#0b120c"><div style="flex:1;min-width:0;overflow-wrap:anywhere;font-size:12px;line-height:1.7">'+r.text+'</div><label style="display:flex;align-items:center;gap:3px;font-size:10px">رنگ<input aria-label="رنگ نتیجه" type="color" value="'+(r.color||'#00e5ff')+'" onchange="return m10SetResultColor('+i+',this.value)" style="width:27px;height:27px;padding:0;border:0;background:transparent"></label><button type="button" onclick="return m10CopyResult('+i+')" style="flex-shrink:0;padding:6px 8px;border:1px solid #789b79;border-radius:7px;background:#203a24;color:#fff">کپی</button><button type="button" onclick="return m10DeleteResult('+i+')" style="flex-shrink:0;padding:6px 8px;border:1px solid #a87575;border-radius:7px;background:#452323;color:#fff">×</button></div>'}).join('')}
function m10AddResult(text,pts,type){var color=type==='pline'?'#ff9800':(type==='area'?'#ff4dd2':'#00e5ff');st.results.push({text:text,pts:(pts||[]).map(function(p){return{x:p.x,y:p.y,z:p.z}}),type:type||'label',color:color});st.markups.push({text:text,pts:(pts||[]).map(function(p){return{x:p.x,y:p.y,z:p.z}}),type:type||'label',color:color});st.measureResult=text;if(q('m10MeasureResult'))q('m10MeasureResult').textContent=text;m10UpdateResults();draw()}
window.m10SetResultColor=function(i,color){var r=st.results[i];if(!r)return false;r.color=color;if(st.markups[i])st.markups[i].color=color;draw();return false};
window.m10CopyResult=function(i){var r=st.results[i];if(!r)return false;var t=String(r.text||'').replace(/<br\s*\/?\s*>/gi,'\n').replace(/<[^>]*>/g,'');if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(function(){showToast('نتیجه کپی شد')}).catch(function(){m10CopyFallback(t)})}else m10CopyFallback(t);return false};function m10CopyFallback(t){var a=document.createElement('textarea');a.value=t;a.style.position='fixed';a.style.opacity='0';document.body.appendChild(a);a.select();try{document.execCommand('copy');showToast('نتیجه کپی شد')}catch(e){showToast('کپی خودکار ممکن نشد؛ متن را انتخاب کن')}a.remove()}
window.m10DeleteResult=function(i){st.results.splice(i,1);st.markups.splice(i,1);m10UpdateResults();draw();return false}
window.m10MeasureMode=function(mode){if(!st.ents.length){showToast('ابتدا فایل DXF را بخوان');return false}st.measureMode=mode;st.xyMode=false;st.measurePts=[];m10ToolButtonState();if(q('m10MeasureResult'))q('m10MeasureResult').textContent=mode==='distance'?'فاصله: دو نقطه را روی نقشه لمس کن.':'حالت نقشه آماده است.';draw();return false}
window.m10ClearMeasure=function(){st.measurePts=[];st.measureMode='none';st.measureResult='';if(q('m10MeasureResult'))q('m10MeasureResult').textContent='';draw();return false}
window.m10FinishArea=function(){if(st.measureMode!=='area'||st.measurePts.length<3){showToast('برای مساحت حداقل سه رأس انتخاب کن');return false}var a=st.measurePts,sum=0,per=0;for(var i=0;i<a.length;i++){var j=(i+1)%a.length;sum+=a[i].x*a[j].y-a[j].x*a[i].y;per+=Math.hypot(a[j].x-a[i].x,a[j].y-a[i].y)}var area=Math.abs(sum)/2,pts=a.slice();st.measurePts=[];st.measureMode='none';m10ToolButtonState();m10AddResult('نقاط '+pts.map(function(p){return p.number}).join(' و ')+'<br>مساحت '+m10Fmt(area)+' مترمربع',pts,'area');return false}
window.m10AreaButton=function(){if(!st.ents.length){showToast('ابتدا فایل DXF را بخوان');return false}if(st.measureMode==='area'){return m10FinishArea()}st.xyMode=false;st.measureMode='area';st.measurePts=[];m10ToolButtonState();if(q('m10MeasureResult'))q('m10MeasureResult').textContent='حالت Area فعال؛ رأس‌های محدوده را به‌ترتیب لمس کن. برای پایان دوباره Area را بزن.';draw();return false}
window.m10ActivatePline=function(){if(!st.ents.length){showToast('ابتدا فایل DXF را بخوان');return false}if(st.plineMode){return window.m10FinishPline()}st.xyMode=false;st.measureMode='none';st.measurePts=[];st.plineMode=true;st.plineLastTap=0;m10ToolButtonState();if(q('m10MeasureResult'))q('m10MeasureResult').textContent='نقاط را به‌ترتیب لمس کن؛ برای ثبت خطوط، دوباره PLINE را بزن.';draw();return false};
window.m10FinishPline=function(){if(!st.plineMode||st.measurePts.length<2){showToast('برای رسم خط حداقل دو نقطه انتخاب کن');return false}var pts=st.measurePts.slice(),len=0;for(var i=1;i<pts.length;i++)len+=Math.hypot(pts[i].x-pts[i-1].x,pts[i].y-pts[i-1].y);st.measurePts=[];st.plineMode=false;m10ToolButtonState();m10AddResult('نقاط '+pts.map(function(p){return p.number}).join(' به ')+'<br>فاصله '+m10Fmt(len)+' متر',pts,'pline');if(q('m10MeasureResult'))q('m10MeasureResult').textContent='خط چندبخشی ثبت شد؛ می‌توانی رنگش را از کادر نتایج عوض کنی.';return false}
window.m10ClearDrawings=function(){st.markups=[];st.measurePts=[];st.measureMode='none';st.xyMode=false;st.plineMode=false;st.plineLastTap=0;st.measureResult='';m10ToolButtonState();if(q('m10MeasureResult'))q('m10MeasureResult').textContent='ترسیم‌ها و اندازه‌گیری‌های روی نقشه پاک شدند؛ کادر نتایج باقی ماند.';draw();return false};window.m10ClearResultsBox=function(){st.results=[];st.measureResult='';m10UpdateResults();if(q('m10MeasureResult'))q('m10MeasureResult').textContent='کادر نتایج پاک شد؛ نقشه و ترسیم‌ها تغییری نکردند.';return false};window.m10ClearAllResults=window.m10ClearDrawings;
function m10ToolButtonState(){var p=q('m10QuickPoint'),x=q('m10QuickXY'),m=q('m10QuickMeas'),a=q('m10QuickArea'),pl=q('m10QuickPline');if(pl){pl.style.background=st.plineMode?'#477b40':'#203a24';pl.style.borderColor=st.plineMode?'#d4f3c8':'#78a875'}if(p){p.style.background=st.pointLabels?'#477b40':'#203a24';p.style.borderColor=st.pointLabels?'#d4f3c8':'#78a875';p.querySelector('small').textContent=st.pointLabels?'دیسکریپشن روشن':'دیسکریپشن خاموش'}if(x){x.style.background=st.xyMode?'#477b40':'#203a24';x.style.borderColor=st.xyMode?'#d4f3c8':'#78a875'}if(m){var on=st.measureMode==='distance';m.style.background=on?'#477b40':'#203a24';m.style.borderColor=on?'#d4f3c8':'#78a875'}if(a){var ao=st.measureMode==='area';a.style.background=ao?'#477b40':'#203a24';a.style.borderColor=ao?'#d4f3c8':'#78a875'}}
window.m10TogglePointLabels=function(){if(!st.ents.length){showToast('ابتدا فایل DXF را بخوان');return false}st.pointLabels=!st.pointLabels;st.xyMode=false;if(st.measureMode==='distance')st.measureMode='none';m10ToolButtonState();draw();if(q('m10MeasureResult'))q('m10MeasureResult').textContent=st.pointLabels?'نمایش دیسکریپشن روشن شد؛ شماره‌ها ثابت هستند.':'نمایش دیسکریپشن خاموش شد؛ شماره‌ها ثابت هستند.';return false};
window.m10ActivateXY=function(){if(!st.ents.length){showToast('ابتدا فایل DXF را بخوان');return false}st.xyMode=true;st.measureMode='none';st.measurePts=[];m10ToolButtonState();if(q('m10MeasureResult'))q('m10MeasureResult').textContent='حالت X/Y فعال است؛ روی نقطه یا رأس نقشه لمس کن.';return false};
window.m10ActivateMeasure=function(){if(!st.ents.length){showToast('ابتدا فایل DXF را بخوان');return false}st.xyMode=false;st.measureMode='distance';st.measurePts=[];m10ToolButtonState();if(q('m10MeasureResult'))q('m10MeasureResult').textContent='MEAS فعال است؛ نقطه اول و سپس نقطه دوم را لمس کن.';draw();return false};
function m10NearestVertex(world,screen){var best=null,bestD=Infinity,pointNo=0,c=q('m10DxfCanvas'),b=st.base||bounds(st.ents);if(!c||!b)return null;var w=c.clientWidth,h=c.clientHeight,dx=Math.max(1e-9,b.maxX-b.minX),dy=Math.max(1e-9,b.maxY-b.minY),pad=45,fit=Math.min((w-2*pad)/dx,(h-2*pad)/dy),sc=fit*st.scale,ox=(w-dx*sc)/2+st.ox,oy=(h-dy*sc)/2+st.oy,codeTexts=st.ents.filter(function(te){return (te.type==='TEXT'||te.type==='MTEXT')&&String(te.text||'').trim()&&te.cx!=null&&te.cy!=null});function cleanCode(t){return String(t||'').replace(/\\P/g,' ').replace(/\[A-Za-z0-9]+/g,'').replace(/[{}]/g,'').trim()}function test(pt,no){if(!pt||!Number.isFinite(pt.x)||!Number.isFinite(pt.y))return;var sx=ox+(pt.x-b.minX)*sc,sy=h-(oy+(pt.y-b.minY)*sc),dd=Math.hypot(sx-screen.x,sy-screen.y);if(dd<bestD){bestD=dd;var label='',bd=24;codeTexts.forEach(function(te){var td=Math.hypot(ox+(te.cx-b.minX)*sc-screen.x,h-(oy+(te.cy-b.minY)*sc)-screen.y);if(td<bd){bd=td;label=cleanCode(te.text)}});best={x:pt.x,y:pt.y,z:pt.z,number:label&&label.length<=20?label:String(no)}}}st.ents.forEach(function(e){if(e.type==='TEXT'||e.type==='MTEXT')return;var arr=(e.pts||[]).slice();if(e.cx!=null&&e.cy!=null)arr.unshift({x:e.cx,y:e.cy,z:e.cz||0});arr.forEach(function(pt){pointNo++;test(pt,pointNo)})});return best&&bestD<=8?best:null}
function m10ScreenWorld(p){var c=q('m10DxfCanvas'),box=q('m10DxfViewer'),b=st.base||bounds(st.ents);if(!c||!box||!b)return{x:0,y:0};var w=box.clientWidth,h=box.clientHeight,dx=Math.max(1e-9,b.maxX-b.minX),dy=Math.max(1e-9,b.maxY-b.minY),pad=45,fit=Math.min((w-2*pad)/dx,(h-2*pad)/dy),sc=fit*st.scale,ox=(w-dx*sc)/2+st.ox,oy=(h-dy*sc)/2+st.oy;return{x:b.minX+(p.x-ox)/sc,y:b.minY+(h-p.y-oy)/sc}}
function draw(){var c=q('m10DxfCanvas'),box=q('m10DxfViewer');if(!c||!box)return;var ents=st.ents,w=box.clientWidth,h=box.clientHeight,dpr=window.devicePixelRatio||1;c.width=Math.max(1,w*dpr);c.height=Math.max(1,h*dpr);var ctx=c.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);ctx.fillStyle='#050805';ctx.fillRect(0,0,w,h);if(!ents.length){q('m10DxfEmpty').style.display='flex';return}q('m10DxfEmpty').style.display='none';var b=st.base||bounds(ents),dx=Math.max(1e-9,b.maxX-b.minX),dy=Math.max(1e-9,b.maxY-b.minY),pad=45,fit=Math.min((w-2*pad)/dx,(h-2*pad)/dy),sc=fit*st.scale,ox=(w-dx*sc)/2+st.ox,oy=(h-dy*sc)/2+st.oy;function X(x){return ox+(x-b.minX)*sc}function Y(y){return h-(oy+(y-b.minY)*sc)}ctx.strokeStyle='#d9e6d9';ctx.fillStyle='#d9e6d9';ctx.lineWidth=Math.max(.7,1.2*Math.min(2,st.scale));ctx.lineCap='round';ctx.lineJoin='round';ents.forEach(function(e){if(e.type==='POINT'){(e.pts||[]).forEach(function(p){ctx.beginPath();ctx.arc(X(p.x),Y(p.y),3.2,0,Math.PI*2);ctx.fill()})}else if(e.type==='LINE'){ctx.beginPath();ctx.moveTo(X(e.pts[0].x),Y(e.pts[0].y));ctx.lineTo(X(e.pts[1].x),Y(e.pts[1].y));ctx.stroke()}else if(e.type==='CIRCLE'){ctx.beginPath();ctx.arc(X(e.cx),Y(e.cy),Math.max(1,e.r*sc),0,Math.PI*2);ctx.stroke()}else if(e.type==='ARC'){var a1=e.a1*Math.PI/180,a2=e.a2*Math.PI/180;if(a2<a1)a2+=Math.PI*2;ctx.beginPath();ctx.arc(X(e.cx),Y(e.cy),Math.max(1,e.r*sc),-a2,-a1);ctx.stroke()}else if(e.type==='INSERT'){ctx.beginPath();ctx.arc(X(e.cx),Y(e.cy),4,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.moveTo(X(e.cx)-7,Y(e.cy));ctx.lineTo(X(e.cx)+7,Y(e.cy));ctx.moveTo(X(e.cx),Y(e.cy)-7);ctx.lineTo(X(e.cx),Y(e.cy)+7);ctx.stroke()}else if(e.type==='TEXT'||e.type==='MTEXT'){/* متون خام DXF عمداً نمایش داده نمی‌شوند؛ فقط برچسب‌های مدیریت‌شدهٔ زرد با گزینهٔ Point نمایش داده می‌شوند. */}else if(e.pts&&e.pts.length>=2){ctx.beginPath();ctx.moveTo(X(e.pts[0].x),Y(e.pts[0].y));for(var j=1;j<e.pts.length;j++)ctx.lineTo(X(e.pts[j].x),Y(e.pts[j].y));if(e.closed)ctx.closePath();ctx.stroke()}});{var pn=0;ctx.save();ctx.font='bold 11px Tahoma,Arial,sans-serif';ctx.textAlign='left';ctx.textBaseline='bottom';window.__m10SeenPointKeys={};var codeTexts=st.ents.filter(function(te){return (te.type==='TEXT'||te.type==='MTEXT')&&String(te.text||'').trim()&&Number.isFinite(te.cx)&&Number.isFinite(te.cy)});function pointCode(pt,px,py,pointIndex){var best='',bd=Infinity;codeTexts.forEach(function(te){var raw=String(te.text||'').replace(/\\P/g,' ').replace(/\\[A-Za-z0-9]+/g,' ').replace(/[{},]/g,' ').replace(/\s+/g,' ').trim();if(!raw)return;var dx=te.cx-pt.x,dy=te.cy-pt.y,wd=Math.hypot(dx,dy);if(wd<bd){bd=wd;best=raw}});if(!best||bd>0.05)return '';if(/^\d+$/.test(best))return 'Pt'+best;if(/^pt\s*\d+$/i.test(best))return best.replace(/\s+/g,'');return best;}st.ents.forEach(function(e){if(e.type==='TEXT'||e.type==='MTEXT')return;var arr=(e.pts||[]).slice();if(e.cx!=null&&e.cy!=null)arr.unshift({x:e.cx,y:e.cy});var seenLocal={};arr=arr.filter(function(pt){var k=Number(pt.x).toFixed(8)+','+Number(pt.y).toFixed(8);if(seenLocal[k])return false;seenLocal[k]=true;return true});arr.forEach(function(pt){var kGlobal=Number(pt.x).toFixed(8)+','+Number(pt.y).toFixed(8);if(window.__m10SeenPointKeys&&window.__m10SeenPointKeys[kGlobal])return;if(!window.__m10SeenPointKeys)window.__m10SeenPointKeys={};window.__m10SeenPointKeys[kGlobal]=true;pn++;var px=X(pt.x),py=Y(pt.y),code=pointCode(pt,px,py,pn),num=String(pn),nw=Math.max(18,num.length*7+6);ctx.fillStyle='#000';ctx.fillRect(px+4,py-16,nw,14);ctx.fillStyle='#ffeb3b';ctx.fillText(num,px+7,py-4);if(st.pointLabels&&code){ctx.font='bold 9.35px Tahoma,Arial,sans-serif';var lx=Math.max(2,Math.min(w-ctx.measureText(code).width-2,px+3));ctx.fillStyle='#ffeb3b';ctx.textBaseline='top';ctx.fillText(code,lx,py+2);ctx.textBaseline='bottom'}})});ctx.restore()}if(st.measurePts.length){ctx.save();ctx.strokeStyle='#ffca28';ctx.fillStyle='#ffca28';ctx.lineWidth=2;ctx.beginPath();var mb=st.base||bounds(ents),mdx=Math.max(1e-9,mb.maxX-mb.minX),mdy=Math.max(1e-9,mb.maxY-mb.minY),mpad=45,mfit=Math.min((w-2*mpad)/mdx,(h-2*mpad)/mdy),msc=mfit*st.scale,mox=(w-mdx*msc)/2+st.ox,moy=(h-mdy*msc)/2+st.oy;function MX(x){return mox+(x-mb.minX)*msc}function MY(y){return h-(moy+(y-mb.minY)*msc)}st.measurePts.forEach(function(pt,i){if(i===0)ctx.moveTo(MX(pt.x),MY(pt.y));else ctx.lineTo(MX(pt.x),MY(pt.y));ctx.fillRect(MX(pt.x)-4,MY(pt.y)-4,8,8)});if(st.measureMode==='area'&&st.measurePts.length>2)ctx.closePath();ctx.stroke();ctx.restore()}if(st.markups&&st.markups.length){ctx.save();ctx.font='bold 12px Tahoma,Arial,sans-serif';ctx.lineWidth=2;st.markups.forEach(function(m,mi){var pts=m.pts||[];if(!pts.length)return;ctx.strokeStyle=m.color||(m.type==='area'?'#ff4dd2':(m.type==='pline'?'#ff9800':'#00e5ff'));ctx.fillStyle=m.color||(m.type==='area'?'#ff4dd2':(m.type==='pline'?'#ff9800':'#00e5ff'));if(pts.length>1){ctx.beginPath();ctx.moveTo(X(pts[0].x),Y(pts[0].y));for(var k=1;k<pts.length;k++)ctx.lineTo(X(pts[k].x),Y(pts[k].y));if(m.type==='area')ctx.closePath();ctx.stroke()}pts.forEach(function(pt,j){ctx.beginPath();ctx.arc(X(pt.x),Y(pt.y),4,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';ctx.fillText(String(j+1),X(pt.x)+5,Y(pt.y)-5);ctx.fillStyle=m.color||(m.type==='area'?'#ff4dd2':(m.type==='pline'?'#ff9800':'#00e5ff'))});var mid=pts[0];if(m.type==='area'&&pts.length){var sx=0,sy=0;pts.forEach(function(pt){sx+=pt.x;sy+=pt.y});mid={x:sx/pts.length,y:sy/pts.length}}ctx.fillStyle='#000';var label=m.text;var tw=ctx.measureText(label).width;ctx.fillRect(X(mid.x)+6,Y(mid.y)+5,tw+10,19);ctx.fillStyle='#fff';ctx.fillText(label,X(mid.x)+11,Y(mid.y)+19)});ctx.restore()}q('m10ZoomText').textContent=Math.round(st.scale*100)+'٪'}
window.m10LoadDxfReader=function(){var f=q('m10DxfFile')&&q('m10DxfFile').files[0];if(!f){status('m10DxfStatus','ابتدا فایل DXF را انتخاب کن.');return false}if(!/\.dxf$/i.test(f.name)){status('m10DxfStatus','فقط فایل DXF انتخاب کن.');return false}status('m10DxfStatus','در حال خواندن و پردازش DXF...');readFile(f,function(txt){st.ents=m10Parse(txt);st.base=bounds(st.ents);st.scale=1;st.ox=0;st.oy=0;st.measureMode='none';st.measurePts=[];st.xyMode=false;st.plineMode=false;st.pointLabels=false;st.results=[];st.markups=[];m10UpdateResults();m10UpdateDetails(f);scrollToId('m10DxfCard');bindViewer();m10ToolButtonState();setTimeout(function(){draw()},80);setTimeout(function(){draw()},350);status('m10DxfStatus',st.ents.length?'✓ '+st.ents.length+' عارضه خوانده شد. نقشه و ابزارهای اندازه‌گیری آماده‌اند.':'✗ هیچ عارضه قابل نمایش در فایل پیدا نشد؛ فایل DXF را بررسی کن.');if(q('m10MeasureResult'))q('m10MeasureResult').textContent=st.ents.length?'فایل آماده است؛ ابزارهای زیر نقشه را انتخاب کن.':'فایلی با عارضه قابل اندازه‌گیری خوانده نشد.';},'m10DxfStatus');return false}
window.m10Zoom=function(f){if(!st.ents.length){showToast('ابتدا DXF را بخوان');return false}st.scale=Math.max(.15,Math.min(30,st.scale*f));draw();return false};window.m10ResetView=function(){if(!st.ents.length){return false}st.scale=1;st.ox=0;st.oy=0;draw();return false}
function pos(e,c){var r=c.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top}}
function dist(a,b){return Math.hypot(a.x-b.x,a.y-b.y)}
function bindViewer(){var c=q('m10DxfCanvas');if(!c||c.__m10Bound)return;c.__m10Bound=true;c.style.background='#050805';c.style.touchAction='none';
 c.addEventListener('pointerdown',function(e){if(!st.ents.length)return;e.preventDefault();if(st.xyMode){var sp=pos(e,c),raw=m10ScreenWorld(sp),wp=m10NearestVertex(raw,sp);if(!wp){showToast('برای انتخاب، دقیقاً روی نقطه یا رأس نقشه لمس کن؛ انتخاب اطراف نقطه پذیرفته نیست.');return}var txt='مختصات نقطه '+wp.number+'<br>X: '+m10Fmt(wp.x)+'<br>Y: '+m10Fmt(wp.y)+'<br>Z: '+m10Fmt(wp.z==null?0:wp.z);m10AddResult(txt,[wp],'xy');return}if(st.plineMode){var ps=pos(e,c),pr=m10ScreenWorld(ps),pw=m10NearestVertex(pr,ps);if(!pw){showToast('برای PLINE دقیقاً روی نقطه یا رأس لمس کن.');return}var now=Date.now(),last=st.measurePts[st.measurePts.length-1];if(last&&Math.hypot(last.x-pw.x,last.y-pw.y)<1e-9){showToast('این نقطه قبلاً انتخاب شده؛ نقطه بعدی را انتخاب کن یا دوباره PLINE را بزن.');return}st.measurePts.push(pw);st.plineLastTap=now;if(q('m10MeasureResult'))q('m10MeasureResult').textContent='نقطه '+st.measurePts.length+' وصل شد؛ پس از انتخاب نقاط، دوباره PLINE را بزن تا ثبت شود.';draw();return}if(st.measureMode==='distance'||st.measureMode==='area'){var sp=pos(e,c),raw=m10ScreenWorld(sp),wp=m10NearestVertex(raw,sp);if(!wp){showToast('نقطه‌ای انتخاب نشد؛ دقیقاً روی نقطه یا رأس نقشه لمس کن.');return}st.measurePts.push(wp);if(st.measureMode==='distance'&&st.measurePts.length>=2){var pp=st.measurePts.slice(0,2),d=Math.hypot(pp[1].x-pp[0].x,pp[1].y-pp[0].y);st.measurePts=[];st.measureMode='none';m10ToolButtonState();m10AddResult('نقطه '+pp[0].number+' به '+pp[1].number+'<br>'+m10Fmt(d)+' متر',pp,'distance')}else if(st.measureMode==='area'){if(q('m10MeasureResult'))q('m10MeasureResult').textContent='رأس '+st.measurePts.length+' ثبت شد؛ پس از آخرین رأس، دوباره Area را بزن.';draw()}else if(q('m10MeasureResult'))q('m10MeasureResult').textContent='نقطه اول ثبت شد؛ نقطه دوم را لمس کن.';draw();return}c.setPointerCapture&&c.setPointerCapture(e.pointerId);st.pointers[e.pointerId]=pos(e,c);var ks=Object.keys(st.pointers);if(ks.length===1){st.drag=true;st.lastX=st.pointers[e.pointerId].x;st.lastY=st.pointers[e.pointerId].y}else if(ks.length===2){var a=Object.values(st.pointers);st.pinchStart=dist(a[0],a[1])||1;st.pinchScale=st.scale;st.drag=false}},false);
 c.addEventListener('pointermove',function(e){if(!st.pointers[e.pointerId])return;e.preventDefault();var p=pos(e,c);st.pointers[e.pointerId]=p;var ks=Object.keys(st.pointers);if(ks.length===1&&st.drag){st.ox+=p.x-st.lastX;st.oy+=p.y-st.lastY;st.lastX=p.x;st.lastY=p.y;draw()}else if(ks.length>=2&&st.pinchStart){var a=Object.values(st.pointers);st.scale=Math.max(.15,Math.min(30,st.pinchScale*(dist(a[0],a[1])/(st.pinchStart||1))));draw()}},false);
 function end(e){delete st.pointers[e.pointerId];var ks=Object.keys(st.pointers);if(ks.length===0){st.drag=false;st.pinchStart=0}else if(ks.length===1){var a=st.pointers[ks[0]];st.drag=true;st.lastX=a.x;st.lastY=a.y;st.pinchStart=0}}
 c.addEventListener('pointerup',end,false);c.addEventListener('pointercancel',end,false);
 c.addEventListener('wheel',function(e){if(!st.ents.length)return;e.preventDefault();m10Zoom(e.deltaY<0?1.18:.847)}, {passive:false});
}
bindViewer();
window.addEventListener('resize',function(){if(st.ents.length){bindViewer();setTimeout(draw,20)}});
setTimeout(bindViewer,100);setTimeout(bindViewer,500);
})();
</script>
<!-- MiladGeo generic rating button: user will connect store-specific action later -->
<style id="miladgeo-rating-button-style">
#miladgeoRatingButton{position:static;display:inline-flex;flex:0 0 38px;width:38px;height:38px;min-width:38px;min-height:38px;align-items:center;justify-content:center;z-index:30;border:2px solid #3f6f3f;border-radius:50%;padding:0;background:#eef5dc;color:#24351d;font:700 20px Tahoma,Arial,sans-serif;box-shadow:0 2px 5px rgba(0,0,0,.25);margin:0;cursor:pointer;white-space:nowrap;box-sizing:border-box;line-height:1}
#miladgeoRatingButton:active{transform:scale(.96)}
@media(max-width:390px){#miladgeoRatingButton{flex-basis:34px;width:34px;height:34px;min-width:34px;min-height:34px;font-size:17px}}
</style>
<button aria-label="اخبار لحظه‌ای" id="miladgeoRatingButton" onclick="window.location.href='Miladnews64.html'" title="اخبار لحظه‌ای" type="button">📰</button>
<script id="miladgeo-rating-button-placement">
(function(){
 function placeRating(){
  var b=document.getElementById('miladgeoRatingButton');
  var wrap=document.querySelector('.miladgeo-lang-gear-wrap');
  var gear=wrap&&wrap.querySelector('.miladgeo-lang-gear');
  if(b&&wrap&&gear&&b.parentNode!==wrap){wrap.insertBefore(b,gear);}
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',placeRating);else placeRating();
 setTimeout(placeRating,250);
})();
</script>
<script id="miladgeo-top-actions-857">
(function(){
 'use strict';
 function init(){
  var wrap=document.querySelector('#main .miladgeo-lang-gear-wrap');
  if(!wrap||wrap.dataset.mgActionsReady==='1')return;
  wrap.dataset.mgActionsReady='1';
  function btn(id,icon,label,action){var b=document.createElement('button');b.type='button';b.id=id;b.className='mg-top-action';b.textContent=icon;b.setAttribute('aria-label',label);b.title=label;b.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();action();});return b;}
  var search=btn('mgTopSearch','⌕','جست‌وجوی ابزارها',openSearch);
  var map=btn('mgTopMap','🌍','نقشه',function(){if(typeof goPage==='function')goPage('menu17');else if(typeof showPage==='function')showPage('menu17');}); map.innerHTML='<span class="mg-earth-icon" aria-hidden="true">🌍</span>';
  var help=btn('mgTopLeica','📸','دوربین نقشه‌برداری لایکا',function(){window.location.href='indexv40.html';});
  // آیکون اختصاصی دستگاه نقشه‌برداری لایکا؛ فقط ظاهر دکمه تغییر می‌کند.
  help.innerHTML='<svg class="mg-leica-icon" viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="mgLeicaBody" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#f04435"/><stop offset="1" stop-color="#a70f17"/></linearGradient><linearGradient id="mgLeicaDark" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#4d5557"/><stop offset="1" stop-color="#171d20"/></linearGradient></defs><path d="M17 18h30l5 8v7H12v-7z" fill="url(#mgLeicaDark)" stroke="#111719" stroke-width="1.5"/><rect x="10" y="29" width="44" height="22" rx="5" fill="url(#mgLeicaBody)" stroke="#771016" stroke-width="1.5"/><rect x="19" y="9" width="26" height="13" rx="3" fill="#252d30" stroke="#737d80" stroke-width="2"/><rect x="23" y="12" width="18" height="6" rx="1" fill="#55c5df"/><circle cx="32" cy="39" r="9" fill="#252b2e" stroke="#d7dedf" stroke-width="2"/><circle cx="32" cy="39" r="5" fill="#168db8"/><circle cx="32" cy="39" r="2" fill="#a9f1ff"/><path d="M19 48h26l4 7H15z" fill="#343b3d" stroke="#111719"/><path d="M25 55v5m14-5v5" stroke="#252b2d" stroke-width="3" stroke-linecap="round"/><text x="32" y="27" font-size="5" text-anchor="middle" fill="white" font-weight="bold">LEICA</text></svg>';
  var threeD=btn('mgTop3D','3D','حجم سه‌بعدی',function(){window.location.href='Index3D51.html';});
  threeD.innerHTML='<svg class="mg-3d-cube" viewBox="0 0 64 64" aria-hidden="true"><path d="M32 5 56 18 32 31 8 18Z" fill="#e8f2e5" stroke="#31583a" stroke-width="2.5" stroke-linejoin="round"/><path d="M8 18 32 31 32 58 8 44Z" fill="#78a875" stroke="#31583a" stroke-width="2.5" stroke-linejoin="round"/><path d="M56 18 32 31 32 58 56 44Z" fill="#3e7049" stroke="#31583a" stroke-width="2.5" stroke-linejoin="round"/><text x="20" y="43" text-anchor="middle" font-size="17" font-weight="900" fill="#102e18">3</text><text x="44" y="43" text-anchor="middle" font-size="17" font-weight="900" fill="#000000">D</text></svg>';
  var inviteText='برای شروع گفتگو، آگهی استخدام و رزومه، جعبه ابزار نقشه‌بردار میلادژئو را از صفحه رسمی برنامه در مایکت دریافت کنید.';
  // همان رفتار دکمه «دعوت از دوستان» در ایندکس ۴۲: بازکردن پیامک با متن آماده
  // تا کاربر فقط مخاطب را انتخاب کند و ارسال را خودش تأیید کند.
  var support=btn('mgTopSupport','📤','ارسال دعوت',function(){
   var smsUrl='sms:?body='+encodeURIComponent(inviteText);
   try{window.location.href=smsUrl;}catch(e){alert(inviteText);}
  });
  var star=document.getElementById('miladgeoRatingButton');
  // The user asked for search at the far left; place actions in explicit left-to-right order.
  [search,map,help,threeD,support].forEach(function(b){wrap.insertBefore(b,wrap.firstChild);});
  // Since each new button is inserted at the front, reorder to keep search visually leftmost.
  [search,map,help,threeD,support].forEach(function(b){wrap.appendChild(b);});
  if(star)wrap.appendChild(star);
  var gear=wrap.querySelector('.miladgeo-lang-gear');if(gear)wrap.appendChild(gear);
  function showHelp(){
   var msg='راهنمای سریع MiladGeo\n\n⌕ جست‌وجو: نام ابزار را بنویس تا منوی مربوط پیدا شود.\n🗺 نقشه: بازکردن منوی ۱۷، گوگل ارث و ترسیم.\n📸 شبیه‌ساز لایکا: بازکردن دستگاه مجازی.\n3D: بازکردن ابزار حجم سه‌بعدی.\n⤴ اشتراک‌گذاری: ارسال پیام دعوت به مخاطبین.\n⭐ امتیازدهی: بازکردن پنجره امتیاز.\n⚙ تنظیمات: انتخاب زبان منوی اصلی.';
   alert(msg);
  }
  function openSearch(){
   if(document.getElementById('mgIncomingMusicOverlay')){var busyOverlay=document.getElementById('mgToolSearchOverlay');if(busyOverlay)busyOverlay.classList.remove('open');return;}
   var overlay=document.getElementById('mgToolSearchOverlay');if(!overlay){
    overlay=document.createElement('div');overlay.id='mgToolSearchOverlay';overlay.innerHTML='<div id="mgToolSearchCard" role="dialog" aria-modal="true" aria-label="جست‌وجوی ابزارها"><h3>جست‌وجوی ابزارها</h3><input id="mgToolSearchInput" type="search" placeholder="مثلاً سودوکو، بازی، حجم، ترازیابی…" autocomplete="off"><div id="mgToolSearchResults"></div><button id="mgToolSearchClose" type="button">بستن</button></div>';document.body.appendChild(overlay);
    overlay.addEventListener('click',function(e){if(e.target===overlay)overlay.classList.remove('open')});
    overlay.querySelector('#mgToolSearchClose').addEventListener('click',function(){overlay.classList.remove('open')});
    overlay.querySelector('#mgToolSearchInput').addEventListener('input',renderResults);
   }
   overlay.classList.add('open');var input=overlay.querySelector('#mgToolSearchInput');input.value='';renderResults();setTimeout(function(){input.focus()},40);
  }
  function renderResults(){
   var overlay=document.getElementById('mgToolSearchOverlay');if(!overlay)return;
   var input=overlay.querySelector('#mgToolSearchInput'),list=overlay.querySelector('#mgToolSearchResults');if(!input||!list)return;
   var raw=(input.value||'').trim();
   var norm=function(v){return String(v||'').toLocaleLowerCase().replace(/[ي]/g,'ی').replace(/[ك]/g,'ک').replace(/[ً-ٰٟ]/g,'').replace(/[ـ]/g,'').replace(/[‌\u200e\u200f]/g,' ').replace(/\s+/g,' ').trim();};
   var q=norm(raw);list.innerHTML='';
   if(!q){
    var tip=document.createElement('div');tip.textContent='نام هر ابزار، زیرمنو یا قابلیت را بنویس؛ مثل سودوکو، برداشت نقطه، واردکردن DXF، ترازیابی یا حجم دپو.';tip.style.cssText='padding:12px;line-height:1.8;opacity:.8';list.appendChild(tip);
    var chat=document.createElement('button');chat.type='button';chat.className='mg-search-result';chat.style.cssText='display:block;width:100%;text-align:right;padding:13px 12px;margin:6px 0;border:1px solid #8aa98a;border-radius:10px;background:#eaf5e9;color:#173c25;cursor:pointer;font:inherit';
    var chatTitle=document.createElement('div');chatTitle.textContent='🤖 چت جی پی تی';chatTitle.style.fontWeight='800';
    var chatDesc=document.createElement('small');chatDesc.textContent='ورود به ChatGPT داخل محیط برنامه';chatDesc.style.cssText='display:block;opacity:.78;margin-top:4px';
    chat.appendChild(chatTitle);chat.appendChild(chatDesc);chat.addEventListener('click',function(){window.location.href='https://chatgpt.com/';});list.appendChild(chat);
    var aiModels=[
     {name:'💎 Gemini',desc:'هوش مصنوعی گوگل',url:'https://gemini.google.com/'},
     {name:'🟠 Claude',desc:'دستیار هوشمند آنتروپیک',url:'https://claude.ai/'},
     {name:'🔷 Microsoft Copilot',desc:'دستیار هوشمند مایکروسافت',url:'https://copilot.microsoft.com/'},
     {name:'🔎 Perplexity',desc:'جست‌وجوی هوشمند با پاسخ و منبع',url:'https://www.perplexity.ai/'},
     {name:'🐋 DeepSeek',desc:'دستیار هوش مصنوعی DeepSeek',url:'https://chat.deepseek.com/'},
     {name:'✳️ Grok',desc:'دستیار هوش مصنوعی xAI',url:'https://grok.com/' },
     {name:'🗺️ Esri ArcGIS Docs Assistant',desc:'پرسش درباره ArcGIS و مستندات رسمی؛ امکانات ذخیره گفتگو ممکن است به حساب سازمانی نیاز داشته باشد',url:'https://doc.esri.com/en/arcgis-online/latest/reference/doc-assistant.html'},
     {name:'📐 Civil 3D AI Copilot',desc:'افزونه دستیار داخل Autodesk Civil 3D؛ نیازمند نصب نرم‌افزار و مجوز مربوط',url:'https://marketplace.autodesk.com/apps/495f090c-8645-4487-9f78-527f71bf7822'},
     {name:'📍 Aplitop tcpMDT 26 AI',desc:'دستیار هوشمند داخل tcpMDT 26؛ نیازمند نسخه دسکتاپ و قرارداد نگهداری فعال',url:'https://www.aplitop.com/tcpmdt26-upgrade-surveying-engineering-software'},
     {name:'🏗️ Bentley Copilot',desc:'دستیار داخلی MicroStation 2026؛ پیش‌نمایش فنی در نرم‌افزار دسکتاپ',url:'https://docs.bentley.com/LiveContent/web/MicroStation-v2026.0.2/Help/en/topics/Concept/new_and_changed_in_microstation_2026.html'},
     {name:'🧮 Wolfram Alpha',desc:'محاسبات مهندسی، معادلات، ماتریس، آمار و تبدیل واحد',url:'https://www.wolframalpha.com/'},
     {name:'🏢 Autodesk Forma AI',desc:'پلتفرم ابری طراحی سایت و ساخت‌وساز با قابلیت‌های هوش مصنوعی',url:'https://app.autodeskforma.com/'}
    ];
    aiModels.forEach(function(m){var b=document.createElement('button');b.type='button';b.className='mg-search-result';b.style.cssText='display:block;width:100%;text-align:right;padding:13px 12px;margin:6px 0;border:1px solid #c8d1e3;border-radius:10px;background:#f4f6fb;color:#202b40;cursor:pointer;font:inherit';var t=document.createElement('div');t.textContent=m.name;t.style.fontWeight='800';var d=document.createElement('small');d.textContent=m.desc;d.style.cssText='display:block;opacity:.78;margin-top:4px';b.appendChild(t);b.appendChild(d);b.addEventListener('click',function(){window.location.href=m.url;});list.appendChild(b);});return;
   }
   var aliases=[
    {terms:['لایکا','leica','شبیه ساز لایکا','شبیه‌ساز لایکا','منو ۱','منوی ۱','دستگاه مجازی'],title:'📸 شبیه‌ساز لایکا',desc:'منوی ۱ / شبیه‌ساز دستگاه',href:'indexv40.html'},
    {terms:['برداشت','برداشت نقطه','اندازه گیری','اندازه‌گیری','منو ۲','منوی ۲','real measure'],title:'📍 برداشت زمینی',desc:'منوی ۲ / برداشت واقعی',page:'realMeasure'},
    {terms:['پیاده سازی','پیاده‌سازی','stake out','استیک اوت','منو ۳','منوی ۳'],title:'🎯 پیاده‌سازی نقاط',desc:'منوی ۳',page:'realStake'},
    {terms:['ترازیابی','توپوگرافی','leveling','منو ۴','منوی ۴'],title:'📏 ترازیابی و توپوگرافی',desc:'منوی ۴',page:'leveling'},
    {terms:['نقطه','لیست نقاط','point txt','فهرست نقاط','منو ۵','منوی ۵'],title:'📌 نقاط و TXT',desc:'منوی ۵',page:'points'},
    {terms:['اکسل','excel','وارد کردن نقاط','خروجی نقاط','منو ۶','منوی ۶'],title:'📊 ورود و خروجی Excel',desc:'منوی ۶',page:'excel'},
    {terms:['مساحت','پلیگون','area','منو ۷','منوی ۷'],title:'📐 مساحت و پلیگون',desc:'منوی ۷',page:'area'},
    {terms:['حجم','حجم دپو','دپو','خاکبرداری','خاکریزی','cut fill','منو ۸','منوی ۸'],title:'🧊 محاسبه حجم سه‌بعدی',desc:'منوی ۸',href:'Index3D51.html'},
    {terms:['اتوکد','مینی اتوکد','mini autocad','minicad','dxf editor','منو ۹','منوی ۹'],title:'📐 Mini AutoCAD',desc:'منوی ۹',href:'Indexcad20.html'},
    {terms:['dxf pdf','تبدیل dxf به pdf','چاپ نقشه','منو ۱۰','منوی ۱۰'],title:'🖨️ DXF به PDF',desc:'منوی ۱۰',page:'cadpdf'},
    {terms:['تبدیل مختصات','مختصات','utm','پنزد','منو ۱۱','منوی ۱۱'],title:'🌐 تبدیل مختصات',desc:'منوی ۱۱',page:'converter'},
    {terms:['تبدیل واحد','واحد','طول','زاویه','منو ۱۲','منوی ۱۲'],title:'📏 مبدل واحدها',desc:'منوی ۱۲',page:'units'},
    {terms:['cogo','محاسبات نقشه برداری','محاسبات نقشه‌برداری','منو ۱۳','منوی ۱۳'],title:'🧮 محاسبات COGO',desc:'منوی ۱۳',page:'cogo'},
    {terms:['ماشین حساب','ماشین‌حساب','calculate','منو ۱۴','منوی ۱۴'],title:'🧮 ماشین‌حساب مهندسی',desc:'منوی ۱۴',page:'menu16'},
    {terms:['بازی','مرکز بازی','سرگرمی','بازی مهندس','منو ۱۵','منوی ۱۵','شطرنج','chess','سودوکو','sudoku','مین یاب','مین‌یاب','مین‌یابی','minesweeper','۲۰۴۸','2048','بیلیارد','دوز','دوز ۱۲ مهره','دوز دوازده مهره','مار نوکیا','snake','کبریت','بازی کبریت','ایرهاکی','air hockey','تخته نرد','پازل','بازی ریاضی'],title:'🎮 مرکز بازی‌ها',desc:'منوی ۱۵ / بازی‌های مهندسی و سرگرمی',href:'bazi_mohandes_v57.html'},
    {terms:['کتابخانه','آموزش','آزمون','فرمول','اصطلاحات','منو ۱۶','منوی ۱۶'],title:'📚 کتابخانه مهندسی',desc:'منوی ۱۶ / آموزش و آزمون',page:'training'},
    {terms:['گوگل ارث','google earth','نقشه آنلاین','ترسیم روی نقشه','منو ۱۷','منوی ۱۷'],title:'🗺️ گوگل ارث و ترسیم',desc:'منوی ۱۷',page:'menu17'},
    {terms:['جهت یابی','جهت‌یابی','قطب نما','قطب‌نما','آزیموت','منو ۱۸','منوی ۱۸'],title:'🧭 جهت‌یابی و قطب‌نما',desc:'منوی ۱۸',page:'menu18'},
