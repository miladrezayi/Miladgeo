  {terms:['منو ۱۷','منوی ۱۷','گوگل ارث','نقشه آنلاین','ساختمان'],page:'menu17'},
  {terms:['منو ۱۸','منوی ۱۸','جهت یابی','جهت‌یابی','قطب نما','قطب‌نما','فلزیاب','چراغ قوه','چراغ‌قوه','آزیموت'],page:'menu18'},
  {terms:['منو ۱۹','منوی ۱۹','دوربین نقشه برداری','دوربین نقشه‌برداری','گالری پروژه','ثبت عکس نقطه'],page:'menu19'},
  {terms:['منو ۲۰','منوی ۲۰','دفتر مهندس','سررسید','تقویم مهندس','یادداشت جدید','یادداشت قبلی','کروکی آزاد','فاکتور نقشه برداری','فاکتور مهندسی','حسابدار مهندس','سربرگ شرکت','آرشیو فعالیت‌ها'],page:'menu20'}
 ];
