    if(maxx-minx<=mw-100 && maxy-miny<=mh-140){fitZ=zz;var nn=Math.pow(2,zz)*TILE,cx=(minx+maxx)/2,cy=(miny+maxy)/2;fitCenterLat=180/Math.PI*Math.atan(Math.sinh(Math.PI*(1-2*cy/nn)));fitCenterLon=cx/nn*360-180;break;}
