/* Friendly local introduction: do not depend on the remote service for this common question. */if(/(?:چه\s*کار(?:ها)?یی|چیکار|چه\s*میتونی|چه\s*می\s*توانی|توانایی|قابلیت|معرفی\s*(?:دستیار|خودت)|سلام.*نقشه\s*برداری)/i.test(message)&&/(?:نقشه\s*برداری|نقشه\s*بردار|میتونی|می\s*توانی|توانایی|قابلیت|کار(?:ها)?یی|چیکار|خودت)/i.test(message)){var intro='سلام مهندس جان! 😊 من دستیار میلادژئو هستم؛ خوشحال می‌شم کمکت کنم.\n\n📁 تبدیل فایل: DWG/DXF به PDF و KML، KML به DXF، تصاویر به PDF، PDF به تصویر، ادغام و جداسازی PDF، Word به PDF و جدول‌های Excel/CSV/TXT به PDF یا فرمت‌های جدولی؛ پردازش‌های محلی تا جای ممکن آفلاین انجام می‌شوند. برای تبدیل، فایل را با دکمهٔ 📎 بفرست؛ پیش‌نمایش و دکمه ساخت PDF داخل همین گفتگو نمایش داده می‌شود.\n📍 مختصات و محاسبات: راهنمایی درباره مختصات جغرافیایی و یو‌تی‌ام، فاصله، آزیموت و مساحت.\n🧭 ابزارهای نقشه‌برداری: راهنمای استفاده از ابزارهای موجود برنامه.\n📄 گزارش و پروژه: کمک در آماده‌سازی گزارش، مرتب‌سازی داده‌ها و بررسی ستون‌ها و ردیف‌های ناقص.\n🗺️ فرمت‌های مکانی: راهنمای تبدیل و بررسی فایل‌های مکانی؛ برای تبدیل یو‌تی‌ام به کی‌ام‌ال باید زون و نیم‌کره درست مشخص باشه.\n\nهر فایلی رو که می‌فرستی، اطلاعاتش رو حدس نمی‌زنم؛ اگر چیزی مشخص نباشه ازت می‌پرسم. بگو از کجا شروع کنیم مهندس؟';add(message,'user');history.push({role:'user',content:message});add(intro,'bot');history.push({role:'assistant',content:intro});history=history.slice(-12);saveChat();input.value='';status.textContent='معرفی دستیار آماده است';msgs.scrollTop=msgs.scrollHeight;return;}/* Local file-conversion requests must not call the chat API; the converter runs from the attachment picker. */if((/(?:اکسل|excel|xlsx|xls|kml|کی\s*ام\s*ال|تکست|متن|txt|text|فایل|تبدیل|dwg|dxf|اتوکد|pdf|تصویر|عکس|png|jpg|jpeg|webp|docx)/i.test(message)) && (/(?:کن|کنش|بکن|بده|بساز|درست|تبدیل|خروجی|فایل|بفرست|بگیر|بخون|بخوان|بکش|به|از|اکسل|excel|xlsx|xls|kml|کی\s*ام\s*ال|تکست|متن|txt|text|dwg|dxf|اتوکد)/i.test(message))){var compact=message.toLowerCase().replace(/[\s\u200c\u200f\u200e،,.!؟?؛:()\[\]{}_-]+/g,'');var wantsPdfMerge=/(?:ادغام|یکی\s*کردن|ترکیب).{0,20}pdf|pdf.{0,20}(?:ادغام|یکی\s*کردن|ترکیب)/i.test(message);var wantsPdfSplit=/(?:جدا|تفکیک|تقسیم).{0,20}pdf|pdf.{0,20}(?:جدا|تفکیک|تقسیم)/i.test(message);var wantsPdfImage=/(?:pdf|پی.?دی.?اف).{0,25}(?:تصویر|عکس|png|jpg)|(?:تصویر|عکس).{0,25}(?:از|صفحات).{0,10}pdf/i.test(message);var wantsDocxPdf=/(?:word|docx).{0,25}(?:pdf|پی.?دی.?اف)|(?:pdf|پی.?دی.?اف).{0,25}(?:word|docx)/i.test(message);var wantsDxf=/(?:به\s*dxf|خروجی\s*dxf)/i.test(message);var wantsViewFile=/(?:نمایش|مشاهده|باز(?:کن|کردن)|بخوان|بازش کن)/i.test(message)&&/(?:pdf|پی.?دی.?اف|word|ورد|docx|اکسل|excel|xlsx|xls)/i.test(message);
var wantsCad=!wantsDxf&&/(?:dwg|dxf|اتوکد)/i.test(message);
