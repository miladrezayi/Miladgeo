#mgAboutDialog{display:none;position:fixed;inset:0;z-index:2147483005;background:rgba(12,25,18,.36);align-items:center;justify-content:center;padding:22px;backdrop-filter:blur(5px)}
#mgAboutDialog.open{display:flex}#mgFavoritesDialog{display:none;position:fixed;inset:0;z-index:2147483005;background:rgba(12,25,18,.36);align-items:center;justify-content:center;padding:22px;backdrop-filter:blur(5px)}#mgFavoritesDialog.open{display:flex}#mgFavoritesDialog .mg-about-card{width:min(420px,100%);max-height:80vh;overflow:auto;padding:24px 20px;border:1px solid rgba(255,255,255,.85);border-radius:24px;background:linear-gradient(145deg,rgba(255,255,255,.94),rgba(220,242,228,.94));box-shadow:0 18px 55px rgba(8,32,20,.32);color:#17452b;font:14px/1.9 Tahoma,Arial,sans-serif}#mgFavoritesDialog button{border:0;border-radius:10px;background:#24784a;color:white;padding:9px 18px;font:700 14px Tahoma,Arial,sans-serif}#mgFavoriteItems button{display:block;width:100%;margin:7px 0;text-align:right;background:rgba(255,255,255,.8)!important;color:#17452b!important;border:1px solid #b7d6c0!important}#mgAboutDialog .mg-about-card{width:min(420px,100%);padding:24px 20px;border:1px solid rgba(255,255,255,.85);border-radius:24px;background:linear-gradient(145deg,rgba(255,255,255,.94),rgba(220,242,228,.94));box-shadow:0 18px 55px rgba(8,32,20,.32);color:#17452b;font:14px/1.9 Tahoma,Arial,sans-serif}#mgAboutDialog h3{margin:0 0 8px;font-size:19px}#mgAboutDialog button{border:0;border-radius:10px;background:#24784a;color:white;padding:9px 18px;font:700 14px Tahoma,Arial,sans-serif}
</style>
<button aria-label="باز کردن منوی برنامه" id="mgLeftLauncher" title="منوی برنامه" type="button"></button>
<div aria-label="منوی برنامه" id="mgLeftMenu" role="menu">
<button aria-label="بستن منو" class="mg-left-close" type="button">×</button>
<button class="mg-left-option" data-left-action="market-create" type="button"><span>📝</span>ثبت آگهی فروش تجهیزات مهندسی</button>
<button class="mg-left-option" data-left-action="market-used" type="button"><span>🧰</span>فروشگاه تجهیزات کارکرده / نو</button>
<a class="mg-left-option" data-left-action="news" href="Miladnews64.html" style="text-decoration:none;box-sizing:border-box"><span>📰</span>اخبار لحظه‌ای نقشه‌برداری و عمران</a>
<button class="mg-left-option" data-left-action="invoice" type="button"><span>🧾</span>فاکتور مهندسی نقشه‌برداری PDF</button>
<button class="mg-left-option" data-left-action="letterhead" type="button"><span>📄</span>ساخت سربرگ شرکت برای مهندس</button>
<button class="mg-left-option" data-left-action="accountant" type="button"><span>🧮</span>حسابدار و مدیریت حساب مهندس</button>
</div>
<div aria-label="علاقه‌مندی‌ها" aria-modal="true" id="mgFavoritesDialog" role="dialog"><div class="mg-about-card"><h3>⭐ علاقه‌مندی‌ها</h3><p>ابزارهای پرکاربردت را از این فهرست سریع پیدا کن:</p><div id="mgFavoriteItems"></div><div style="text-align:center;margin-top:14px"><button id="mgFavoritesClose" type="button">بستن</button></div></div></div>
<div aria-label="دربارهٔ MiladGeo" aria-modal="true" id="mgAboutDialog" role="dialog"><div class="mg-about-card"><h3>درباره میلاد ژئو</h3><p>میلاد ژئو، دستیار مهندسان نقشه‌برداری است و ابزارهای محاسبات مهندسی، برداشت و پیاده‌سازی، توپوگرافی و ترازیابی، تبدیل مختصات، حجم عملیات خاکی، ترسیم و ابزارهای میدانی را در یک مجموعه گرد آورده است.</p><p><strong>میلاد رضایی</strong><br/>فارغ‌التحصیل رشته مهندسی نقشه‌برداری</p><div style="text-align:center;margin-top:14px"><button id="mgAboutClose" type="button">بستن</button></div></div></div>
<script id="mg-left-glass-menu-script">
(function(){
 var launcher=document.getElementById('mgLeftLauncher'),menu=document.getElementById('mgLeftMenu'),about=document.getElementById('mgAboutDialog'),favs=document.getElementById('mgFavoritesDialog');
 if(!launcher||!menu||launcher.dataset.ready)return;launcher.dataset.ready='1';
 function close(){menu.classList.remove('open');launcher.classList.remove('mg-left-open');launcher.setAttribute('aria-expanded','false')}
 launcher.setAttribute('aria-expanded','false');launcher.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();var was=menu.classList.contains('open');document.getElementById('mgEngineerMenu')?.classList.remove('open');document.getElementById('mgEngineerLauncher')?.classList.remove('mg-menu-is-open');menu.classList.toggle('open',!was);launcher.classList.toggle('mg-left-open',!was);launcher.setAttribute('aria-expanded',String(!was));});
 menu.querySelector('.mg-left-close').addEventListener('click',close);
 document.addEventListener('click',function(e){if(menu.classList.contains('open')&&!menu.contains(e.target)&&e.target!==launcher)close()});
 document.addEventListener('touchend',function(e){if(menu.classList.contains('open')&&!menu.contains(e.target)&&e.target!==launcher)close()},{passive:true});
 document.getElementById('mgAboutClose').addEventListener('click',function(){about.classList.remove('open')});about.addEventListener('click',function(e){if(e.target===about)about.classList.remove('open')});
 var favItems=[{name:'پیاده‌سازی',run:function(){return goPage('stake');}},{name:'ترازیابی و توپوگرافی',run:function(){return goPage('leveling');}},{name:'تبدیل واحد',run:function(){return goPage('units');}},{name:'حجم عملیات خاکی',run:function(){return goPage('volume');}},{name:'مینی اتوکد',run:function(){var b=document.getElementById('menu9MiniAutocadBtn');if(b){b.click();return true;}window.location.href='Indexcad20.html';return true;}},{name:'گوگل ارث و ترسیم',run:function(){return goPage('menu17');}}];var favBox=document.getElementById('mgFavoriteItems');favItems.forEach(function(item){var b=document.createElement('button');b.type='button';b.textContent='⭐ '+item.name;b.addEventListener('click',function(){favs.classList.remove('open');try{item.run();}catch(err){console.error('MiladGeo favorite navigation failed:',item.name,err);alert('بازکردن این ابزار انجام نشد. لطفاً از منوی اصلی وارد شوید.')}});favBox.appendChild(b)});document.getElementById('mgFavoritesClose').addEventListener('click',function(){favs.classList.remove('open')});favs.addEventListener('click',function(e){if(e.target===favs)favs.classList.remove('open')});
 menu.querySelectorAll('[data-left-action]').forEach(function(b){b.addEventListener('click',function(){var a=b.getAttribute('data-left-action');close();if(a==='market-create'){window.location.href='MiladmarketV58.html?open=create';return}if(a==='market-used'){window.location.href='MiladmarketV58.html?open=used';return}if(a==='telegram'){window.open('https://t.me/Miladgeobot','_blank','noopener');return}if(a==='news'){window.location.href='Miladnews64.html';return}if(a==='invoice'){goPage('menu20');setTimeout(function(){if(typeof window.m20Open==='function')window.m20Open('invoice');},120);return}if(a==='letterhead'){goPage('menu20');setTimeout(function(){if(typeof window.m20Open==='function')window.m20Open('letterhead');},250);return}if(a==='accountant'){goPage('menu20');setTimeout(function(){if(typeof window.m20Open==='function')window.m20Open('accountant');},250);return}if(a==='about'){about.classList.add('open');return}if(a==='favorites'){favs.classList.add('open');return}if(a==='exit'){if(confirm('از MiladGeo خارج می‌شوید؟')){try{window.close()}catch(e){} }return}})});
 document.addEventListener('keydown',function(e){if(e.key==='Escape'){close();about.classList.remove('open');favs.classList.remove('open')}});
})();
</script>
<script id="mg-safe-extra-menu-translations">
(function(){
'use strict';
var KEY='miladgeo-main-language-399';
var dict={
 en:{menu20:'Engineer Notebook',state20:'Notes / Sketches / Documentation',page20:'MENU 20 — Engineer Notebook ✍️',hero20:'✍️ Engineer Notebook',sub20:'Professional workspace for engineering notes, sketches, photos and reports',cards:[['✍️ New Note','Free page for writing with finger or S Pen, text and highlights'],['📒 Previous Notes','View, open and edit saved text notes'],['🗺️ Free Sketch','Blank page for quick site and project sketches'],['📸 Photo + Handwriting','Import a photo and add notes, arrows and marks'],['📝 Daily Report','Create a daily project report and save it to the archive'],['🗂️ Notes Archive','Search and manage all saved notes']],market:[['Online Engineering Jobs & Resumes','Internal chat, file sharing, jobs and resumes'],['Survey Equipment Marketplace','New, used and rental equipment by city'],['Online Construction Materials Prices','Online status — view prices']],right:['Publish Resume Online','Engineer ID','Received Messages','Engineer ID Finder','Engineer Activity Calendar 1405','Job Posting'],left:['Post Equipment for Sale','Used / New Equipment Store','Live Surveying & Civil Engineering News','Surveying Engineering Invoice PDF','Company Letterhead for Engineers','Engineer Accountant & Account Management'],close:'Close Menu',ariaRight:'Engineer menu',ariaLeft:'Application menu'},
 ar:{menu20:'دفتر المهندس',state20:'ملاحظات / مخططات / توثيق',page20:'القائمة 20 — دفتر المهندس ✍️',hero20:'✍️ دفتر المهندس',sub20:'مساحة احترافية لتسجيل الملاحظات الهندسية والمخططات والصور والتقارير',cards:[['✍️ ملاحظة جديدة','صفحة حرة للكتابة بالإصبع أو القلم، مع النص والتظليل'],['📒 الملاحظات السابقة','عرض الملاحظات النصية المحفوظة وفتحها وتعديلها'],['🗺️ مخطط حر','صفحة بيضاء لرسم مخطط سريع للموقع والمشروع'],['📸 صورة + كتابة يدوية','أضف صورة وارسم عليها الملاحظات والأسهم والعلامات'],['📝 تقرير يومي','سجّل التقرير اليومي للمشروع واحفظه في الأرشيف'],['🗂️ أرشيف الملاحظات','ابحث عن جميع الملاحظات المحفوظة وأدرها']],market:[['إعلانات التوظيف والسير الذاتية الهندسية','محادثة داخلية وإرسال الملفات والتوظيف والسير الذاتية'],['سوق أجهزة المساحة','أجهزة جديدة ومستعملة للإيجار حسب المدينة'],['سوق أسعار مواد البناء','حالة مباشرة — عرض الأسعار']],right:['نشر السيرة الذاتية','معرّف المهندس','الرسائل الواردة','البحث عن معرّف مهندس','تقويم أنشطة المهندس ۱۴۰۵','إعلان توظيف'],left:['نشر إعلان بيع معدات','متجر المعدات الجديدة والمستعملة','أخبار المساحة والهندسة المدنية لحظيًا','فاتورة هندسية للمساحة PDF','إنشاء ترويسة شركة للمهندس','محاسب وإدارة حسابات المهندس'],close:'إغلاق القائمة',ariaRight:'قائمة المهندس',ariaLeft:'قائمة التطبيق'},
 survey:{menu20:'دفتر مهندس',state20:'یادداشت / کروکی / مستندسازی',page20:'MENU 20 — دفتر مهندس ✍️',hero20:'✍️ دفتر مهندس',sub20:'یادداشت مهندسی، کروکی، عکس و گزارش',cards:[['📅 سررسید مهندس ۱۴۰۵ تا ۱۴۲۰','سررسید سال‌های ۱۴۰۵ تا ۱۴۱۰ برای قرارها، مهلت‌ها و یادداشت‌های روزانه'],['✍️ یادداشت جدید','صفحه آزاد برای نوشتن با انگشت یا S Pen، متن و هایلایت'],['📒 یادداشت قبلی','یادداشت‌های متنی ذخیره‌شده را ببین، باز کن و اصلاح کن'],['🗺️ کروکی آزاد','صفحه سفید برای کروکی سریع کارگاه و محل پروژه'],['📸 عکس + دست‌نویس','عکس را وارد کن و روی آن توضیح، فلش و علامت بکش'],['📄 ساخت سربرگ شرکت','ساخت نامه رسمی، تنظیم متن، لوگو، امضا و مهر، چاپ A4 و PDF']],market:[['آگهی استخدام و رزومه مهندسین','چت داخلی، ارسال فایل، استخدام و رزومه'],['مرکز خرید تجهیزات نقشه‌برداری','تجهیزات نو، کارکرده و اجاره به تفکیک شهر'],['بازار آنلاین قیمت مصالح','وضعیت آنلاین — مشاهده قیمت‌ها']],right:['انتشار آنلاین رزومه','شناسه مهندس','پیام‌های دریافتی','شناسه‌یاب مهندس','سررسید فعالیت مهندس ۱۴۰۵','آگهی استخدام'],left:['ثبت آگهی فروش تجهیزات مهندسی','فروشگاه تجهیزات کارکرده / نو','اخبار لحظه‌ای نقشه‌برداری و عمران','فاکتور مهندسی نقشه‌برداری PDF','ساخت سربرگ شرکت برای مهندس','حسابدار و مدیریت حساب مهندس'],close:'بستن منو',ariaRight:'منوی مهندس',ariaLeft:'منوی برنامه'},
 fa:{menu20:'دفتر مهندس',state20:'یادداشت / کروکی / مستندسازی',page20:'MENU 20 — دفتر مهندس ✍️',hero20:'✍️ دفتر مهندس',sub20:'محیط حرفه‌ای ثبت و مدیریت یادداشت‌های مهندسی، کروکی، عکس و گزارش',cards:[['📅 سررسید مهندس ۱۴۰۵ تا ۱۴۲۰','سررسید سال‌های ۱۴۰۵ تا ۱۴۱۰ برای قرارها، مهلت‌ها و یادداشت‌های روزانه'],['✍️ یادداشت جدید','صفحه آزاد برای نوشتن با انگشت یا S Pen، متن و هایلایت'],['📒 یادداشت قبلی','یادداشت‌های متنی ذخیره‌شده را ببین، باز کن و اصلاح کن'],['🗺️ کروکی آزاد','صفحه سفید برای کروکی سریع کارگاه و محل پروژه'],['📸 عکس + دست‌نویس','عکس را وارد کن و روی آن توضیح، فلش و علامت بکش'],['📄 ساخت سربرگ شرکت','ساخت نامه رسمی، تنظیم متن، لوگو، امضا و مهر، چاپ A4 و PDF']],market:[['آگهی‌های آنلاین استخدام و رزومه مهندسین میلاد ژئو','چت داخلی، ارسال فایل، استخدام، رزومه'],['مرکز خرید و فروش تجهیزات نقشه‌برداری میلادژئو','نو، کارکرده، اجاره به تفکیک شهر'],['بازار آنلاین قیمت مصالح','وضعیت آنلاین - مشاهده قیمت‌ها']],right:['انتشار آنلاین رزومه','آی‌دی مهندس','پیام‌های دریافتی','آی‌دی‌یاب مهندس','سررسید فعالیت مهندس ۱۴۰۵','آگهی استخدام'],left:['ثبت آگهی فروش تجهیزات مهندسی','فروشگاه تجهیزات کارکرده / نو','اخبار لحظه‌ای نقشه‌برداری و عمران','فاکتور مهندسی نقشه‌برداری PDF','ساخت سربرگ شرکت برای مهندس','حسابدار و مدیریت حساب مهندس'],close:'بستن منو',ariaRight:'دسترسی‌های مهندس',ariaLeft:'منوی برنامه'}
};
function setText(el,txt){if(el)el.textContent=txt}
function apply(){var lang='fa';try{lang=localStorage.getItem(KEY)||'fa'}catch(e){}var d=dict[lang]||dict.fa;
 var main=document.getElementById('main'); if(main){main.querySelectorAll('.menu-grid > .menu-btn').forEach(function(btn){var label=btn.querySelector('.menu-label');var is20=btn.matches('.menu-grid > .menu-btn[href*="menu20"], .menu-grid > .menu-btn[onclick*="menu20"]') || (label && /Engineer Notebook|دفتر مهندس|دفتر المهندس/.test(label.textContent||''));if(is20){var n=btn.querySelector('.menu-num');if(n)n.textContent=(lang==='en')?'20':(lang==='ar'?'٢٠':'۲۰');setText(label,d.menu20);setText(btn.querySelector('.menu-state'),d.state20);}});}
 var sec=document.getElementById('menu20');if(sec){setText(sec.querySelector('.title'),d.page20);setText(sec.querySelector('.m20-hero-title'),d.hero20);setText(sec.querySelector('.m20-hero-sub'),d.sub20);var cards=sec.querySelectorAll('.m20-grid .m20-card');d.cards.forEach(function(row,i){var c=cards[i];if(!c)return;var b=c.querySelector('b'),sp=c.querySelector('b .m20-num'),desc=c.querySelectorAll(':scope > span');if(b){var n=sp?sp.outerHTML:'';b.innerHTML=n+row[0].replace(/^[^ ]+ /,' '); } if(desc.length)setText(desc[0],row[1]);});}
 document.querySelectorAll('.market-mini-link').forEach(function(a,i){if(i>=3)return;var strong=a.querySelector('strong'),small=a.querySelector('small');setText(strong,d.market[i][0]);if(small){var dot=small.querySelector('.market-mini-dot');small.textContent='';if(dot)small.appendChild(dot);small.appendChild(document.createTextNode(' '+d.market[i][1]));}a.setAttribute('aria-label',d.market[i][0]);});
 var right=document.getElementById('mgEngineerMenu');if(right){var opts=right.querySelectorAll('.mg-engineer-option');d.right.forEach(function(t,i){var o=opts[i];if(!o)return;var sp=o.querySelector('span');o.textContent='';if(sp)o.appendChild(sp);o.appendChild(document.createTextNode(t));});right.setAttribute('aria-label',d.ariaRight);var close=right.querySelector('.mg-engineer-close');if(close)close.setAttribute('aria-label',d.close);}
 var left=document.getElementById('mgLeftMenu');if(left){var opts2=left.querySelectorAll('.mg-left-option');d.left.forEach(function(t,i){var o=opts2[i];if(!o)return;var sp=o.querySelector('span');o.textContent='';if(sp)o.appendChild(sp);o.appendChild(document.createTextNode(t));});left.setAttribute('aria-label',d.ariaLeft);var close2=left.querySelector('.mg-left-close');if(close2)close2.setAttribute('aria-label',d.close);}
}
function boot(){apply();var panel=document.querySelector('.miladgeo-lang-panel');if(panel)panel.querySelectorAll('button').forEach(function(b){b.addEventListener('click',function(){setTimeout(apply,0);setTimeout(apply,60);});});}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else boot();
})();
</script>
<style>
.m16-invoice-intro{background:#eaf3ec;border:1px solid #b7cdbb;border-radius:12px;padding:10px 12px;line-height:1.9;color:#30483a}
.m16-invoice-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}
.m16-invoice-tabs button{border:1px solid #9aaa9f;border-radius:12px;background:#f2f5f2;color:#263b2e;padding:12px 8px;font-weight:900;font-size:14px;min-height:48px}
.m16-invoice-tabs button.active{background:#245d40;color:#fff;border-color:#245d40}
.m16-inv-section{background:#fff;border:1px solid #d3ddd5;border-radius:14px;padding:12px;margin:10px 0;color:#26382d}
.m16-inv-section> b{display:block;font-size:16px;margin-bottom:8px}
.m16-inv-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.m16-inv-grid label,.m16-inv-notes-label{display:block;font-size:13px;font-weight:800;line-height:1.8}
.m16-inv-grid label.wide{grid-column:1/-1}
.m16-inv-grid input,.m16-inv-notes-label textarea,.m16-inv-edit-table input{box-sizing:border-box;width:100%;min-width:0;min-height:44px;border:1px solid #b7c4ba;border-radius:9px;background:#fff;color:#18291e;padding:9px;font-size:15px;font-family:Tahoma,Arial,sans-serif}
.m16-inv-notes-label textarea{margin-top:4px;resize:vertical}
.m16-inv-rowhead{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
.m16-inv-add{border:0;border-radius:10px;background:#e1f0e5;color:#1e603b;font-weight:900;padding:10px 12px;min-height:42px}
.m16-inv-table-wrap{width:100%;overflow-x:auto;border:1px solid #d5ded7;border-radius:10px}
.m16-inv-edit-table{width:100%;border-collapse:collapse;min-width:620px;font-size:13px}
.m16-inv-edit-table th,.m16-inv-edit-table td{border-bottom:1px solid #dce3de;padding:6px;text-align:center}
.m16-inv-edit-table th{background:#edf3ee;white-space:nowrap}
.m16-inv-edit-table input{min-height:40px;padding:6px}
.m16-inv-edit-table .m16-inv-desc{min-width:190px;text-align:right}
.m16-inv-del{border:0;border-radius:8px;background:#ffeded;color:#9a3030;padding:8px;font-weight:900;min-height:38px}
.m16-inv-adjust{margin-top:10px}
.m16-inv-total{display:grid;grid-template-columns:1fr auto;gap:7px 12px;align-items:center;background:#eff6f0;border:1px solid #b6d0bd;border-radius:12px;padding:12px;margin-top:12px;line-height:1.8}
.m16-inv-total strong{font-size:16px;color:#155b32;text-align:left;direction:rtl;white-space:nowrap}
.m16-inv-total span{font-size:13px;font-weight:800}
.m16-inv-stamp-tools{border:1px dashed #829087;border-radius:12px;padding:10px;margin-top:12px;background:#fbfcfb}.m16-inv-stamp-tools label{display:block;font-weight:900;font-size:13px;margin-bottom:6px}.m16-inv-stamp-tools input{max-width:100%;font-size:14px}.m16-inv-stamp-preview{min-height:82px;border:1px dashed #9aa99d;border-radius:8px;margin:8px 0;display:flex;align-items:center;justify-content:center;text-align:center;padding:8px;color:#68766b;font-size:12px}.m16-inv-stamp-preview img{max-width:100%;max-height:100px;object-fit:contain}.m16-inv-actions{display:grid;grid-template-columns:2fr 1fr;gap:8px;margin:12px 0}
.m16-inv-pdf,.m16-inv-secondary{border:0;border-radius:12px;min-height:52px;padding:10px;font-size:15px;font-weight:900}
.m16-inv-pdf{background:linear-gradient(135deg,#17643d,#258653);color:white}
.m16-inv-secondary{background:#e9eeea;color:#304238;border:1px solid #c7d2ca}
.m16-inv-hint{font-size:12px;line-height:1.9;color:#53645a;background:#f3f6f3;border-radius:10px;padding:10px}
@media(max-width:520px){.m16-inv-grid{grid-template-columns:1fr}.m16-inv-grid label.wide{grid-column:auto}.m16-invoice-tabs button{font-size:12px}.m16-inv-actions{grid-template-columns:1fr}.m16-inv-total strong{font-size:14px}}
</style>
<script>
(function(){
 'use strict';
 var mode='invoice', rowSeq=0, stampData='', logoData='', logoChoice='mg';
 function byId(id){return document.getElementById(id)}
 function num(v){var n=Number(String(v==null?'':v).replace(/[,٬\s]/g,''));return isFinite(n)?n:0}
 function faNum(n){try{return Math.round(n).toLocaleString('fa-IR')}catch(e){return String(Math.round(n))}}
 function esc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}
 function field(id){return byId(id)?byId(id).value.trim():''}
 function showMessage(t){if(typeof window.showToast==='function')window.showToast(t);else alert(t)}
 function normalizeBankDigits(v){return String(v||'').replace(/[۰-۹]/g,function(c){return String('۰۱۲۳۴۵۶۷۸۹'.indexOf(c))}).replace(/[٠-٩]/g,function(c){return String('٠١٢٣٤٥٦٧٨٩'.indexOf(c))})}
 function rows(){return Array.prototype.slice.call(document.querySelectorAll('#m16InvRows tr'))}
 function makeRow(desc,qty,rate){
  rowSeq++;var tr=document.createElement('tr');
  var middle=mode==='statement'?'<td><input class="m16-inv-prev" aria-label="مقدار قبلی" type="number" min="0" step="any" inputmode="decimal" value=""></td><td><input class="m16-inv-current" aria-label="مقدار این دوره" type="number" min="0" step="any" inputmode="decimal" value="'+(qty==null?'':esc(qty))+'"></td><td class="m16-inv-cumulative">۰</td>':'<td><input class="m16-inv-qty" aria-label="تعداد یا مقدار" type="number" min="0" step="any" inputmode="decimal" value="'+(qty==null?'':esc(qty))+'"></td>';
  tr.innerHTML='<td class="m16-inv-row-no"></td><td><input class="m16-inv-desc" aria-label="شرح خدمات" placeholder="شرح عملیات / خدمات" value="'+esc(desc||'')+'"></td>'+middle+'<td><input class="m16-inv-rate" aria-label="نرخ واحد" type="number" min="0" step="any" inputmode="decimal" value="'+(rate==null?'':esc(rate))+'"></td><td class="m16-inv-row-total">۰</td><td><button class="m16-inv-del" type="button" aria-label="حذف ردیف">حذف</button></td>';
  tr.querySelector('.m16-inv-del').addEventListener('click',function(){tr.remove();if(!rows().length)makeRow();recalc()});
  tr.querySelectorAll('input').forEach(function(inp){inp.addEventListener('input',recalc)});
  byId('m16InvRows').appendChild(tr);recalc();
 }
 function recalc(){var total=0;rows().forEach(function(tr,i){tr.querySelector('.m16-inv-row-no').textContent=faNum(i+1);var qty=mode==='statement'?(num(tr.querySelector('.m16-inv-current').value)):num(tr.querySelector('.m16-inv-qty').value);if(mode==='statement'){tr.querySelector('.m16-inv-cumulative').textContent=faNum(num(tr.querySelector('.m16-inv-prev').value)+qty)}var amount=qty*num(tr.querySelector('.m16-inv-rate').value);tr.querySelector('.m16-inv-row-total').textContent=faNum(amount);total+=amount;});var final=total;
  if(mode==='statement')final=total-num(byId('m16InvAdvance').value)+num(byId('m16InvAdjust').value)-num(byId('m16InvDeductions').value)+num(byId('m16InvTax').value);
  byId('m16InvSubtotal').textContent=faNum(total)+' ریال';byId('m16InvFinal').textContent=faNum(final)+' ریال';
 }
 window.m16InvAddRow=function(){makeRow('','','')};
 window.m16InvMode=function(next){mode=next==='statement'?'statement':'invoice';document.querySelectorAll('[data-inv-mode]').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-inv-mode')===mode)});byId('m16InvItemsTitle').textContent=mode==='invoice'?'کارهای انجام‌شده':'شرح عملیات و کارکرد این دوره';byId('m16InvSubtotalLabel').textContent=mode==='invoice'?'جمع کل خدمات':'جمع کارکرد این دوره';byId('m16InvFinalLabel').textContent=mode==='invoice'?'مبلغ نهایی فاکتور':'مبلغ قابل پرداخت پس از تعدیلات';byId('m16InvAdjustments').style.display=mode==='statement'?'grid':'none';byId('m16InvThead').innerHTML=mode==='invoice'?'<tr><th>ردیف</th><th>شرح خدمات</th><th>تعداد</th><th>قیمت واحد (ریال)</th><th>مبلغ (ریال)</th><th></th></tr>':'<tr><th>ردیف</th><th>شرح عملیات</th><th>مقدار قبلی</th><th>مقدار این دوره</th><th>مقدار تجمعی</th><th>نرخ واحد (ریال)</th><th>مبلغ این دوره (ریال)</th><th></th></tr>';var oldRows=rows().map(function(tr){return {d:tr.querySelector('.m16-inv-desc').value,q:mode==='statement'?(tr.querySelector('.m16-inv-qty')?tr.querySelector('.m16-inv-qty').value:tr.querySelector('.m16-inv-current').value):(tr.querySelector('.m16-inv-qty')?tr.querySelector('.m16-inv-qty').value:tr.querySelector('.m16-inv-current').value),r:tr.querySelector('.m16-inv-rate').value,p:tr.querySelector('.m16-inv-prev')?tr.querySelector('.m16-inv-prev').value:'0'}});byId('m16InvRows').innerHTML='';oldRows.forEach(function(o){makeRow(o.d,o.q,o.r);var tr=rows()[rows().length-1];if(mode==='statement')tr.querySelector('.m16-inv-prev').value=o.p||''});if(!oldRows.length)makeRow('',1,0);recalc()};
 window.m16InvReset=function(){['m16InvOrg','m16InvNumber','m16InvProject','m16InvProvider','m16InvNotes','m16InvCard','m16InvSheba'].forEach(function(id){byId(id).value=''});byId('m16InvDate').value=new Intl.DateTimeFormat('fa-IR-u-ca-persian',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());['m16InvAdvance','m16InvDeductions','m16InvAdjust','m16InvTax'].forEach(function(id){byId(id).value=''});byId('m16InvRows').innerHTML='';stampData='';if(byId('m16InvStampFile'))byId('m16InvStampFile').value='';if(byId('m16InvStampPreview'))byId('m16InvStampPreview').innerHTML='<span>محل مهر — در صورت نداشتن عکس، خالی بماند و دستی مهر بزنید</span>';makeRow('','','');makeRow('','','');recalc()};
 function pdfHtml(){var org=field('m16InvOrg')||'—',date=field('m16InvDate')||'—',no=field('m16InvNumber')||'—',project=field('m16InvProject')||'—',provider=field('m16InvProvider')||'—',card=field('m16InvCard').replace(/[^0-9۰-۹٠-٩]/g,''),sheba=field('m16InvSheba').toUpperCase().replace(/[^A-Z0-9۰-۹٠-٩]/g,''),notes=field('m16InvNotes'),total=0,body='';rows().forEach(function(tr,i){var desc=tr.querySelector('.m16-inv-desc').value.trim(),prev=mode==='statement'?num(tr.querySelector('.m16-inv-prev').value):0,qty=mode==='statement'?num(tr.querySelector('.m16-inv-current').value):num(tr.querySelector('.m16-inv-qty').value),cum=prev+qty,rate=num(tr.querySelector('.m16-inv-rate').value),amount=qty*rate;total+=amount;body+='<tr><td>'+faNum(i+1)+'</td><td class="desc">'+esc(desc||'—')+'</td>'+(mode==='statement'?'<td>'+esc(prev)+'</td><td>'+esc(qty)+'</td><td>'+esc(cum)+'</td>':'<td>'+esc(qty)+'</td>')+'<td>'+faNum(rate)+'</td><td>'+faNum(amount)+'</td></tr>'});var advance=mode==='statement'?num(byId('m16InvAdvance').value):0,deductions=mode==='statement'?num(byId('m16InvDeductions').value):0,adjust=num(byId('m16InvAdjust').value),tax=num(byId('m16InvTax').value),final=total-advance-deductions+adjust+tax;var title=mode==='invoice'?'فاکتور خدمات نقشه‌برداری':'صورت‌وضعیت نقشه‌برداری';
 return '<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+title+' - MiladGeo</title><style>@page{size:A4 portrait;margin:12mm}*{box-sizing:border-box}html,body{margin:0;padding:0;background:#fff;color:#17251b}body{font-family:Tahoma,Arial,sans-serif;font-size:11px;line-height:1.8;direction:rtl}.sheet{width:100%;max-width:190mm;margin:0 auto}.head{display:flex;direction:ltr;align-items:center;justify-content:space-between;border-bottom:3px solid #1c7044;padding:0 0 10px;margin-bottom:12px}.brand{width:32%;text-align:center;color:#17643d;font-family:Arial,sans-serif}.survey-logo{display:block;width:112px;height:78px;margin:0 auto;object-fit:contain}.brand .sub{font-size:8px;letter-spacing:2px;font-weight:900}.head-title{direction:rtl;text-align:right;flex:1}.head-title h1{font-size:20px;margin:0;color:#173d28}.head-title p{margin:2px 0;color:#506257;font-size:10px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:10px 0 14px}.meta div{border:1px solid #d2ddd5;border-radius:5px;padding:6px 8px;min-height:31px}.meta b{color:#286143}.payment-info{border:1px solid #b8cfc0;background:#f3f8f4;border-radius:6px;padding:8px 10px;margin:0 0 12px;direction:rtl}.payment-info>b{display:block;color:#205b39;margin-bottom:4px}.payment-info div{display:flex;justify-content:space-between;gap:8px;padding:3px 0;border-top:1px dotted #c5d4c9}.payment-info strong{font-family:Arial,Tahoma,sans-serif;letter-spacing:.4px;overflow-wrap:anywhere}.tabletitle{font-size:13px;font-weight:bold;margin:10px 0 5px}table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:10px}th,td{border:1px solid #aab8ae;padding:6px 4px;text-align:center;word-break:break-word}th{background:#e8f1e9;color:#183b27}td.desc{text-align:right;white-space:pre-wrap}.bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;direction:ltr;align-items:stretch;margin-top:12px}.sum{width:100%;margin:0;border:1px solid #aab8ae;border-radius:5px;padding:8px;direction:rtl}.stamp-box{direction:rtl;border:1.5px dashed #8d9b90;border-radius:6px;min-height:120px;padding:8px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#526257}.stamp-box img{max-width:100%;max-height:95px;object-fit:contain}.stamp-box .stamp-title{font-size:12px;font-weight:bold;color:#234d34}.stamp-box .stamp-note{font-size:9px;margin-top:5px}.sum div{display:flex;justify-content:space-between;gap:10px;padding:3px 0}.sum .final{border-top:2px solid #28764a;margin-top:4px;padding-top:7px;font-size:13px;font-weight:bold;color:#165a34}.notes{border:1px solid #d2ddd5;padding:8px;border-radius:5px;margin-top:12px;min-height:30px;white-space:pre-wrap}.sign{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:28px;text-align:center}.sign div{border-top:1px solid #89968c;padding-top:6px;font-size:9px}.transfer-note{border:1px solid #b8cfc0;background:#f3f8f4;border-radius:6px;padding:10px 12px;margin-top:18px;text-align:justify;line-height:2.1;page-break-inside:avoid;break-inside:avoid}.transfer-note>b{display:block;color:#205b39;margin-bottom:3px}.transfer-note .bank-value{direction:ltr;unicode-bidi:embed;font-family:Arial,Tahoma,sans-serif;font-weight:700;overflow-wrap:anywhere;white-space:normal}@media(max-width:700px){.bottom-grid{grid-template-columns:1fr}}.foot{border-top:1px solid #d2ddd5;text-align:center;color:#66746a;font-size:8px;margin-top:18px;padding-top:6px}@media print{.sheet{max-width:none}tr{break-inside:avoid;page-break-inside:avoid}}</style></head><body><main class="sheet"><header class="head"><div class="brand">'+(logoData?'<img class="survey-logo" src="'+logoData+'" alt="لوگو">':logoSvg(logoChoice))+ '<div class="sub">SURVEYING</div></div><div class="head-title"><h1>'+title+'</h1><p>سامانه خدمات مهندسی نقشه‌برداری میلاد ژئو</p></div></header><section class="meta"><div><b>نام سازمان / کارفرما:</b> '+esc(org)+'</div><div><b>تاریخ:</b> '+esc(date)+'</div><div><b>شماره سند:</b> '+esc(no)+'</div><div><b>نام پروژه:</b> '+esc(project)+'</div><div style="grid-column:1/-1"><b>تهیه‌کننده / پیمانکار:</b> '+esc(provider)+'</div></section>'+'<div class="tabletitle">'+(mode==='invoice'?'شرح خدمات انجام‌شده':'شرح عملیات و مقادیر کارکرد')+'</div><table><thead><tr><th style="width:7%">ردیف</th><th style="width:30%">شرح خدمات / عملیات</th>'+(mode==='statement'?'<th style="width:10%">قبلی</th><th style="width:10%">این دوره</th><th style="width:10%">تجمعی</th>':'<th style="width:13%">تعداد / مقدار</th>')+'<th style="width:16%">نرخ واحد (ریال)</th><th style="width:17%">مبلغ (ریال)</th></tr></thead><tbody>'+body+'</tbody></table><section class="bottom-grid"><div class="sum"><div><span>جمع خدمات</span><b>'+faNum(total)+' ریال</b></div>'+(mode==='statement'?'<div><span>پیش‌پرداخت</span><b>'+faNum(advance)+' ریال</b></div><div><span>کسورات</span><b>'+faNum(deductions)+' ریال</b></div>':'')+(adjust?'<div><span>تعدیلات / اضافه‌کار</span><b>'+faNum(adjust)+' ریال</b></div>':'')+(tax?'<div><span>مالیات / عوارض</span><b>'+faNum(tax)+' ریال</b></div>':'')+'<div class="final"><span>'+(mode==='invoice'?'مبلغ نهایی':'مبلغ قابل پرداخت')+'</span><b>'+faNum(mode==='invoice'?total:final)+' ریال</b></div></div><div class="stamp-box"><div class="stamp-title">محل مهر و امضا</div>'+(stampData?'<img src="'+stampData+'" alt="مهر">':'<div class="stamp-note">برای مهر دستی خالی گذاشته شده است</div>')+'</div></section>'+(notes?'<section class="notes"><b>توضیحات:</b><br>'+esc(notes)+'</section>':'')+'<section class="sign"><div>تهیه‌کننده / پیمانکار</div><div>کنترل و تأیید</div></section>'+(card||sheba?'<section class="transfer-note"><b>اطلاعات واریز</b><div>لطفاً مبلغ فوق به نام آقای '+esc(provider==='—'?'':provider)+'، '+(card?'به شماره کارت <span class="bank-value">'+esc(card.replace(/(.{4})/g,'$1 ').trim())+'</span>':'')+(card&&sheba?' یا ':'')+(sheba?'به شماره شبا <span class="bank-value">'+esc(sheba.replace(/(.{4})/g,'$1 ').trim())+'</span>':'')+' واریز کنید. با سپاس</div></section>':'')+'<footer class="foot">MILAD GEO • سند تهیه‌شده توسط ابزار فاکتور مهندسی</footer></main></body></html>';
 }

 function logoSvg(kind){
  if(kind==='camera')return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 70"><circle cx="50" cy="33" r="29" fill="#eef4ef" stroke="#236443" stroke-width="2"/><path d="M25 31h50v19H25z M36 31l5-8h18l5 8" fill="#2b6546" stroke="#173f2b" stroke-width="2"/><circle cx="50" cy="40" r="9" fill="#102e20" stroke="#a8d7b7" stroke-width="3"/><path d="M50 50v5L34 68 M50 55l16 13 M50 55v13" stroke="#8b6c36" stroke-width="3" fill="none"/></svg>';
  if(kind==='compass')return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 70"><circle cx="50" cy="35" r="29" fill="#f7f4e8" stroke="#987b36" stroke-width="2"/><path d="M50 10L57 33L50 60L43 37z" fill="#236443"/><path d="M20 35h60M50 7v56" stroke="#6d8975" stroke-width="1.5"/><circle cx="50" cy="35" r="5" fill="#c3a65b" stroke="#173f2b" stroke-width="2"/></svg>';
  if(kind==='theodolite')return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 70"><path d="M50 40L30 67M50 40L70 67M50 40v27" stroke="#987b36" stroke-width="3"/><rect x="30" y="19" width="40" height="24" rx="4" fill="#236443" stroke="#173f2b" stroke-width="2"/><circle cx="50" cy="31" r="8" fill="#102e20" stroke="#c4dfcb" stroke-width="3"/><path d="M40 19v-5h20v5" stroke="#987b36" stroke-width="3" fill="none"/></svg>';
  return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 150 104"><defs><linearGradient id="mgMetal" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e8f2e9"/><stop offset="1" stop-color="#47795a"/></linearGradient></defs><circle cx="75" cy="48" r="43" fill="#173f2b" stroke="#c3a65b" stroke-width="2.5"/><path d="M75 52L42 98M75 52L108 98M75 52v48" stroke="#c3a65b" stroke-width="3" fill="none"/><path d="M51 29l10-9h27l10 9v22H51z" fill="url(#mgMetal)" stroke="#e5f1e8" stroke-width="2"/><circle cx="75" cy="39" r="12" fill="#102e20" stroke="#b7d9c1" stroke-width="2"/><circle cx="75" cy="39" r="6" fill="#6fa6bd"/><text x="75" y="76" font-family="Arial" font-size="26" font-weight="900" fill="#fff" text-anchor="middle">MG</text><text x="75" y="89" font-family="Arial" font-size="8" font-weight="900" fill="#e9d9a6" text-anchor="middle">miladgeo</text></svg>';
 }
 window.m16InvChooseLogo=function(kind){logoChoice=kind||'mg';logoData='';document.querySelectorAll('.m16-logo-option').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-logo')===logoChoice)});if(byId('m16InvLogoFile'))byId('m16InvLogoFile').value='';if(byId('m16InvLogoPreview'))byId('m16InvLogoPreview').innerHTML=logoSvg(logoChoice)};
 window.m16InvResetLogo=function(){window.m16InvChooseLogo('mg')};
 window.m16InvClearStamp=function(){stampData='';if(byId('m16InvStampFile'))byId('m16InvStampFile').value='';if(byId('m16InvStampPreview'))byId('m16InvStampPreview').innerHTML='<span>محل مهر — در صورت نداشتن عکس، خالی بماند و دستی مهر بزنید</span>'};
 document.addEventListener('blur',function(ev){var t=ev.target;if(!t)return;if(t.id==='m16InvCard'){var v=normalizeBankDigits(t.value).replace(/\D/g,'').slice(0,16);t.value=v.replace(/(.{4})/g,'$1 ').trim()}else if(t.id==='m16InvSheba'){var v=normalizeBankDigits(t.value).toUpperCase().replace(/[^A-Z0-9]/g,'');if(v&&!v.startsWith('IR'))v='IR'+v.replace(/^IR/i,'');t.value=v.replace(/(.{4})/g,'$1 ').trim()}},true);
 document.addEventListener('change',function(ev){if(!ev.target||ev.target.id!=='m16InvLogoFile')return;var file=ev.target.files&&ev.target.files[0];if(!file)return;if(!/^image\//i.test(file.type)){showMessage('لطفاً یک فایل تصویری انتخاب کن.');return}var reader=new FileReader();reader.onload=function(){logoData=String(reader.result||'');logoChoice='custom';document.querySelectorAll('.m16-logo-option').forEach(function(b){b.classList.remove('active')});if(byId('m16InvLogoPreview'))byId('m16InvLogoPreview').innerHTML='<img src="'+logoData+'" alt="لوگوی انتخابی">'};reader.onerror=function(){showMessage('خواندن تصویر لوگو ناموفق بود.');};reader.readAsDataURL(file)});
 document.addEventListener('change',function(ev){if(!ev.target||ev.target.id!=='m16InvStampFile')return;var file=ev.target.files&&ev.target.files[0];if(!file)return;if(!/^image\//i.test(file.type)){showMessage('لطفاً یک فایل تصویری انتخاب کن.');return}var reader=new FileReader();reader.onload=function(){stampData=String(reader.result||'');if(byId('m16InvStampPreview'))byId('m16InvStampPreview').innerHTML='<img src="'+stampData+'" alt="پیش‌نمایش مهر">'};reader.onerror=function(){showMessage('خواندن تصویر مهر ناموفق بود.');};reader.readAsDataURL(file)});
 window.m16InvExportPDF=function(){try{var filled=rows().some(function(tr){return tr.querySelector('.m16-inv-desc').value.trim()||num(tr.querySelector('.m16-inv-rate').value)>0||(mode==='statement'&&num(tr.querySelector('.m16-inv-current').value)>0)});if(!filled){showMessage('حداقل شرح یک خدمت یا قیمت را وارد کن.');return false}var html=pdfHtml(),name=(mode==='invoice'?'MiladGeo_Invoice':'MiladGeo_SuratVaziyat')+'.pdf';if(typeof window.miladgeoM17PrintHtml==='function'){var ok=window.miladgeoM17PrintHtml(html,name);if(ok!==false){showMessage('پیش‌نمایش چاپ باز شد؛ برای PDF گزینه «ذخیره به‌صورت PDF» را انتخاب کن.');return false}}var w=window.open('','_blank');if(!w){showMessage('مرورگر پنجره چاپ را مسدود کرد؛ اجازه بازشدن پنجره را بده.');return false}w.document.open();w.document.write(html);w.document.close();setTimeout(function(){try{w.focus();w.print()}catch(e){}},700);return false}catch(e){console.error('M16_INVOICE_PDF',e);showMessage('ساخت پیش‌نمایش PDF ناموفق بود.');return false}};
 document.addEventListener('DOMContentLoaded',function(){var date=byId('m16InvDate');if(date&&!date.value)date.value=new Intl.DateTimeFormat('fa-IR-u-ca-persian',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());['m16InvAdvance','m16InvDeductions','m16InvAdjust','m16InvTax'].forEach(function(id){if(byId(id))byId(id).addEventListener('input',recalc)});if(byId('m16InvRows')&&!byId('m16InvRows').children.length){makeRow('','','');makeRow('','','')}window.m16InvMode('invoice');window.m16InvChooseLogo('mg')});
})();
</script>
<!-- MILAD AI playful Android-style orb: replaces the old center gem decoration -->
<style>
#miladBotOrb{position:fixed;left:50%;bottom:calc(2px + env(safe-area-inset-bottom));transform:translate(-50%,0);width:66px;height:66px;z-index:100;border:0;background:transparent;padding:0;cursor:pointer;filter:drop-shadow(0 5px 4px rgba(0,0,0,.42));animation:miladBotBob 2.6s ease-in-out infinite;transition:opacity .45s ease,visibility .45s ease,transform .45s ease;}
#miladBotOrb.mb-hidden{opacity:0;visibility:hidden;pointer-events:none;transform:translate(-50%,85px);}
#miladBotOrb.mb-peek{opacity:.55;visibility:visible;pointer-events:auto;transform:translate(-50%,38px);}

#miladBotOrb .mb-halo{position:absolute;inset:3px;border-radius:50%;background:linear-gradient(145deg,#b7f6a2,#3ca85b 48%,#155a31);border:3px solid #c4e3b9;box-shadow:inset 0 3px 5px #efffe6, inset 0 -5px 7px #164323,0 0 0 2px #335b3c;}
#miladBotOrb .mb-antenna{position:absolute;left:31px;top:-3px;width:4px;height:14px;border-radius:4px;background:#d7e6d1;transform:rotate(10deg);z-index:1}
#miladBotOrb .mb-antenna:after{content:'';position:absolute;width:9px;height:9px;left:-3px;top:-5px;border-radius:50%;background:radial-gradient(circle at 30% 25%,#fff,#ff5c6a 45%,#b7192d);box-shadow:0 0 3px #fff}
#miladBotOrb .mb-face{position:absolute;left:10px;right:10px;top:20px;height:27px;border-radius:14px;background:linear-gradient(#193e2a,#0d2619);border:2px solid rgba(224,255,213,.8);box-shadow:inset 0 2px 4px #06170c;}
#miladBotOrb .mb-ai{position:absolute;left:50%;top:-11px;transform:translateX(-50%);z-index:3;padding:1px 4px;border-radius:5px;background:linear-gradient(180deg,#e5fbff,#66d9ff);border:1px solid #d8fbff;color:#064c91;font:bold 8px/10px Arial,sans-serif;letter-spacing:.6px;text-shadow:0 0 3px #fff;box-shadow:0 0 5px #48cfff,0 0 9px #2196f3;}
#miladBotOrb .mb-eye{position:absolute;top:7px;width:7px;height:9px;border-radius:50%;background:#d9ff8c;box-shadow:0 0 5px #baff73}
@keyframes mbBlink{0%,42%,46%,100%{transform:scaleY(1)}44%{transform:scaleY(.08)}}#miladBotOrb .mb-eye{transform-origin:center;animation:mbBlink 4.8s infinite}#miladBotOrb .mb-eye.right{animation-delay:.12s}#miladBotOrb.mb-wink .mb-eye.right{transform:scaleY(.08)}@media(prefers-reduced-motion:reduce){#miladBotOrb .mb-eye{animation:none}}
#miladBotOrb .mb-eye.left{left:9px;transform:rotate(15deg)}#miladBotOrb .mb-eye.right{right:9px;transform:rotate(-15deg)}
#miladBotOrb .mb-mouth{position:absolute;left:50%;bottom:4px;width:13px;height:5px;border-bottom:2px solid #d9ffb7;border-radius:0 0 12px 12px;transform:translateX(-50%) rotate(-7deg)}
#miladBotOrb .mb-cheek{position:absolute;top:12px;width:5px;height:3px;border-radius:50%;background:#ff8c78;opacity:.95}.mb-cheek.left{left:3px}.mb-cheek.right{right:3px}
#miladBotOrb:active{transform:translate(-50%,2px) scale(.94)}
@keyframes miladBotBob{0%,100%{margin-bottom:0}50%{margin-bottom:5px}}
/* Robot3: surprise giant pop, quick boop, then stands upright */
#miladBotOrb.mb-giant-pop{animation:mbGiantBoop 1.25s cubic-bezier(.2,.8,.25,1) both!important;z-index:2147482000!important;transform-origin:50% 80%;}
@keyframes mbGiantBoop{0%{transform:translate(-50%,0) scale(1) rotate(0)}10%{transform:translate(-50%,-8px) scale(1.2) rotate(-8deg)}22%{transform:translate(-50%,-18px) scale(7) rotate(0)}34%{transform:translate(-50%,-18px) scale(6.5) rotate(0)}43%{transform:translate(-50%,-18px) scale(1.08) rotate(0)}52%{transform:translate(-50%,-18px) scale(1) rotate(0)}63%{transform:translate(-50%,-18px) scale(1.12) rotate(0)}76%{transform:translate(-50%,-18px) scale(1) rotate(0)}100%{transform:translate(-50%,0) scale(1) rotate(0)}}
@media(prefers-reduced-motion:reduce){#miladBotOrb.mb-giant-pop{animation:none!important;}}

#miladBotOrb.mb-runaway{left:0!important;bottom:calc(72px + env(safe-area-inset-bottom))!important;opacity:1!important;visibility:visible!important;pointer-events:none!important;animation:miladBotRunAcross 1.65s cubic-bezier(.25,.7,.45,1) forwards!important;z-index:100!important}
@keyframes miladBotRunAcross{0%{left:-72px;transform:translateX(0) rotate(-18deg)}15%{transform:translateX(8vw) rotate(12deg)}35%{transform:translateX(28vw) rotate(-15deg)}55%{transform:translateX(52vw) rotate(16deg)}75%{transform:translateX(76vw) rotate(-12deg)}100%{left:calc(100vw - 1px);transform:translateX(0) rotate(22deg);opacity:.1}}
@media(prefers-reduced-motion:reduce){#miladBotOrb{animation:none}}
</style>
<style id="miladBotChatStyles">
#miladBotChat{position:fixed;z-index:2147483000;left:12px;right:12px;bottom:82px;max-width:520px;margin:0 auto;height:min(65vh,520px);background:#e7eee2;color:#17291c;border:2px solid #497254;border-radius:20px;box-shadow:0 10px 35px #0008;display:none;overflow:hidden;font-family:inherit}
#miladBotChat.open{display:flex;flex-direction:column}#miladBotChatHead{padding:12px;background:linear-gradient(120deg,#174b2d,#80a96f);color:#fff;display:flex;align-items:center;gap:9px;font-weight:bold}#miladBotChatHead button{border:0;border-radius:10px;padding:5px 10px;font-size:16px;cursor:pointer}#miladBotChatHead #miladBotChatClose{margin-right:0;font-size:20px}#miladBotChatHead #miladBotChatNew{margin-right:auto;background:#e4f2df;color:#174b2d;font-size:12px;font-weight:bold}#miladBotQuick{display:flex;gap:6px;overflow-x:auto;padding:8px 10px;background:#edf4e9;border-bottom:1px solid #c7d8c2}#miladBotQuick button{flex:0 0 auto;border:1px solid #8bad87;border-radius:18px;padding:7px 10px;background:#fff;color:#205536;font:inherit;font-size:12px}#miladBotGreeting{position:fixed;z-index:99;left:50%;bottom:calc(76px + env(safe-area-inset-bottom));transform:translateX(-50%);background:#174b2d;color:#fff;border:1px solid #bce5ae;border-radius:16px;padding:8px 12px;box-shadow:0 4px 12px #0005;font: bold 13px Arial,Tahoma,sans-serif;white-space:nowrap;opacity:0;visibility:hidden;transition:opacity .25s;pointer-events:none}#miladBotGreeting.show{opacity:1;visibility:visible;pointer-events:auto}#miladBotGreeting button{border:0;background:transparent;color:inherit;font:inherit;padding:0;cursor:pointer}#miladBotChatMsgs{padding:12px;overflow:auto;flex:1;display:flex;flex-direction:column;gap:8px}.mg-file-viewer button:disabled{opacity:.45}.mg-file-viewer .docx-wrapper{max-width:100%;overflow:auto} .mb-chat-msg{max-width:88%;padding:10px 12px;border-radius:14px;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere;font-size:14px;direction:auto;unicode-bidi:plaintext;text-align:start;word-spacing:normal;letter-spacing:normal}.mb-chat-msg.bot{background:#fff;border:1px solid #c3d4c0;align-self:flex-start}.mb-chat-msg.user{background:#c5dfc4;align-self:flex-end}.mb-chat-actions{display:flex;align-items:center;align-self:flex-start;gap:2px;margin-top:-7px;margin-bottom:1px;margin-right:4px}.mb-chat-copy,.mb-chat-speak{display:inline-flex;align-items:center;justify-content:center;padding:1px 4px;border:0;background:transparent;color:#55715a;font-size:13px;line-height:1.2;min-width:22px;min-height:20px;cursor:pointer;opacity:.78;border-radius:6px;touch-action:manipulation}.mb-chat-copy:hover,.mb-chat-copy:focus,.mb-chat-speak:hover,.mb-chat-speak:focus{opacity:1;background:#e8f1e5;outline:1px solid #b7cbb2}.mb-chat-actions.user-copy{align-self:flex-end;margin-right:0;margin-left:4px}.mb-chat-status{font-size:11px;color:#4c6150;padding:0 12px 5px}#miladBotChatForm{display:flex;gap:7px;padding:9px;border-top:1px solid #b9cbb7;background:#f6f8f3}#miladBotChatInput{min-width:0;flex:1;border:1px solid #9bb49b;border-radius:12px;padding:10px;font:inherit;background:white;color:#17291c}#miladBotChatSend{border:0;border-radius:12px;background:#185333;color:white;padding:0 15px;font-weight:bold}#miladBotChatSend:disabled{opacity:.5}#miladBotProjectHint{font-size:11px;color:#47634b;padding:3px 10px;background:#edf4e9;display:none}#miladBotProjectHint.show{display:block}
</style>
<section aria-label="هوش مصنوعی میلاد ژئو" aria-modal="true" id="miladBotChat" role="dialog"><div id="miladBotChatHead"><span style="font-size:24px">🤖</span><span>هوش مصنوعی میلاد ژئو</span><button id="miladBotChatNew" type="button">گفت‌وگوی تازه</button><button aria-label="بستن چت" id="miladBotChatClose" type="button">×</button></div><div id="miladBotQuick"><button data-prompt="سلام! چه کارهایی می‌توانی برای نقشه‌برداری انجام بدهی؟" type="button">🤖 معرفی دستیار</button><button data-prompt="مساحت یک قطعه را چطور محاسبه کنم؟" type="button">📐 محاسبه مساحت</button><button data-prompt="برای تبدیل مختصات چه اطلاعاتی لازم است؟" type="button">📍 مختصات</button><button data-prompt="یک گزارش نقشه‌برداری خوب چه بخش‌هایی دارد؟" type="button">📄 گزارش‌ساز</button><button data-prompt="یه جوک بگو" type="button">😄 جوک</button><button data-prompt="یک شعر کوتاه فارسی بگو" type="button">📝 شعر</button><button data-prompt="برام فال حافظ بگیر" type="button">📜 فال حافظ</button><button data-prompt="چند کتاب معتبر نقشه‌برداری معرفی کن" type="button">📚 کتاب‌ها</button><button data-prompt="آموزش نقشه‌برداری را از پایه و مرحله‌به‌مرحله شروع کن" type="button">🎓 آموزش</button><button data-prompt="روش محاسبه خطای بست پیمایش بسته را با مثال توضیح بده" type="button">🧭 پیمایش</button><button data-prompt="چرا گیرنده GNSS فیکس نمی‌شود؟ برای عیب‌یابی چه اطلاعاتی لازم داری؟" type="button">🛰️ دستگاه‌ها</button><button data-prompt="دو تجهیز نقشه‌برداری را با جدول مشخصات فنی، دقت، کاربرد، مزایا و معایب و قیمت روزِ دارای منبع مقایسه کن؛ اگر مدل‌ها مشخص نیستند، اول نام دقیق دو مدل را از من بپرس." type="button">⚖️ مقایسه تجهیزات</button><button data-prompt="حجم خاک‌برداری را با داده‌های لازم و فرمول محاسبه توضیح بده" type="button">🏗️ عمران</button><button data-prompt="برای تحلیل فایل مختصات CSV چه ستون‌ها و کنترل‌هایی لازم است؟" type="button">📂 فایل مختصات</button><button data-prompt="یک گزارش حرفه‌ای برداشت توپوگرافی با جای خالی اطلاعات پروژه آماده کن" type="button">📝 گزارش</button><button data-prompt="آموزش Civil 3D برای نقشه‌برداری را از مقدماتی شروع کن" type="button">💻 نرم‌افزار</button><button data-prompt="برای عملیات نقشه‌برداری یک چک‌لیست میدانی مرحله‌به‌مرحله تهیه کن؛ قبل از نهایی‌کردن، نوع عملیات و شرایط پروژه را از من بپرس." type="button">☑️ چک‌لیست میدانی</button><button data-prompt="مثل یک معلم هوشمند نقشه‌برداری عمل کن. سطح من را کوتاه مشخص کن و آموزش را از پایه، مرحله‌به‌مرحله با مثال و تمرین شروع کن." type="button">🎓 معلم نقشه‌برداری</button><button data-prompt="می‌خواهم یک نقشه یا عکس فنی را بررسی کنم. راهنمایی کن چه تصویری و چه اطلاعاتی بفرستم و فقط چیزهایی را که واقعاً از تصویر قابل تشخیص است توضیح بده؛ ابعاد و نوشته‌های ناخوانا را حدس نزن." type="button">🗺️ دستیار نقشه و عکس</button><button id="miladBotProjects" type="button">🗂️ حافظه پروژه‌ها</button><button id="miladBotAnalyzeFile" type="button">🧠 تحلیل هوشمند فایل نقشه‌برداری</button><input accept=".txt,.csv,.tsv,.dxf,.dwg,.xyz,.pts,.prn,.asc,.dat,.log,.gsi,.penzd,.nez,.xlsx,.xls,.kml,.kmz,.gpx,.geojson,.json,.pdf,.jpg,.jpeg,.png,.webp,.tif,.tiff,.docx" id="miladBotFileInput" multiple="" style="display:none" type="file"/></div><div id="miladBotChatMsgs"><div class="mb-chat-msg bot">سلام مهندس! 😊 خوش اومدی به میلادژئو. دوست داری با چه اسمی صدات کنم؟ اسمت رو بگو تا برای گفتگوهای بعدی همین‌جا به خاطر بسپارم.</div></div><div id="miladBotProjectHint"></div><div class="mb-chat-status" id="miladBotChatStatus">برای گفتگو پیام خود را بنویس.</div><form id="miladBotChatForm"><input autocomplete="off" id="miladBotChatInput" maxlength="2000" placeholder="پیامت رو بنویس…"/><button aria-label="انتخاب فایل" id="miladBotAttach" style="flex:0 0 30px;width:30px;min-width:30px;height:30px;padding:0;border:1px solid #8bad87;border-radius:50%;background:#edf4e9;color:#205536;font-size:15px;line-height:1" title="انتخاب فایل برای تحلیل" type="button">📎</button><button id="miladBotChatSend" type="submit">ارسال</button></form></section>
<script id="miladBotChatRuntime">(function(){
'use strict';
var API='https://milad-dastyar-api.miladgeomatic.workers.dev/';
var panel=document.getElementById('miladBotChat'),msgs=document.getElementById('miladBotChatMsgs'),form=document.getElementById('miladBotChatForm'),input=document.getElementById('miladBotChatInput'),send=document.getElementById('miladBotChatSend'),status=document.getElementById('miladBotChatStatus');
if(!panel||!form)return;function initExistingMessageCopy(){var nodes=msgs.querySelectorAll('.mb-chat-msg');for(var i=0;i<nodes.length;i++)attachMessageCopy(nodes[i]);}initExistingMessageCopy();try{var storedProfile=JSON.parse(localStorage.getItem('miladgeo_dastyar_profile_v1')||'{}');var starter=msgs.querySelector('.mb-chat-msg.bot');if(storedProfile&&storedProfile.name){if(starter)starter.textContent='سلام '+storedProfile.name+' جان! 😊 خوش اومدی؛ خوشحالم دوباره می‌بینمت. امروز چطور می‌تونم کمکت کنم؟';var greetingButton=document.querySelector('#miladBotGreeting button');if(greetingButton)greetingButton.textContent='سلام '+storedProfile.name+' جان! 😊 خوش اومدی';}else{try{localStorage.setItem('miladgeo_dastyar_awaiting_name_v1','1')}catch(_e){}}}catch(e){}
// دکمه میکروفن فقط گفتار فارسی را به متن داخل کادر پیام تبدیل می‌کند؛ ارسال با خود کاربر است.
(function setupDictation(){var btn=document.getElementById('miladBotMic');if(!btn)return;var SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){btn.title='تشخیص گفتار در این مرورگر پشتیبانی نمی‌شود';btn.addEventListener('click',function(){status.textContent='تشخیص گفتار در این مرورگر در دسترس نیست؛ مرورگر یا WebView دیگری را امتحان کن.';});return;}var rec=null,listening=false,baseText='';btn.addEventListener('click',function(){if(listening){try{rec&&rec.stop()}catch(e){}return;}try{rec=new SR();baseText=input.value.trim();rec.lang='fa-IR';rec.continuous=false;rec.interimResults=true;rec.maxAlternatives=1;listening=true;btn.textContent='⏹';btn.style.background='#f7d9d9';status.textContent='گوش می‌دهم… فارسی صحبت کن.';var finalText='';rec.onresult=function(e){var interim='';for(var i=e.resultIndex;i<e.results.length;i++){var t=e.results[i][0].transcript||'';if(e.results[i].isFinal)finalText+=t;else interim+=t;}input.value=(baseText+(baseText?' ':'')+(finalText||interim)).slice(0,2000);};rec.onerror=function(e){status.textContent=e.error==='not-allowed'?'اجازه میکروفن داده نشد؛ دسترسی میکروفن سایت را فعال کن.':'تشخیص صدا ناموفق بود: '+e.error;};rec.onend=function(){listening=false;btn.textContent='🎙️';btn.style.background='#edf4e9';if(finalText){input.value=(baseText+(baseText?' ':'')+finalText).slice(0,2000);status.textContent='متن گفتار وارد شد؛ برای دریافت پاسخ دکمه ارسال را بزن.';}else if(status.textContent==='گوش می‌دهم… فارسی صحبت کن.')status.textContent='صدایی تشخیص داده نشد؛ دوباره روی میکروفن بزن.';input.focus();};rec.start();}catch(e){listening=false;btn.textContent='🎙️';btn.style.background='#edf4e9';status.textContent='شروع میکروفن ناموفق بود؛ اجازه میکروفن را بررسی کن.';}});})();

/* V974: real-time market lookup + trustworthy local Persian date */
function mgV974Today(){
 try {
  var now=new Date();
  var date=new Intl.DateTimeFormat('fa-IR-u-ca-persian',{weekday:'long',year:'numeric',month:'long',day:'numeric'}).format(now);
  var time=new Intl.DateTimeFormat('fa-IR',{hour:'2-digit',minute:'2-digit',hour12:false}).format(now);
  return '📅 تاریخ امروز بر اساس ساعت دستگاه شما: '+date+'\n🕒 ساعت محلی دستگاه: '+time+'\n\nاین تاریخ از تقویم واقعی دستگاه محاسبه شده است؛ تاریخ ثابت یا سال‌های گذشته نیست.';
 } catch(e) { return '📅 تاریخ امروز دستگاه: '+new Date().toLocaleDateString('fa-IR'); }
}
function mgV974Num(v, digits){
 var n=Number(v); if(!Number.isFinite(n))return 'نامشخص';
 return n.toLocaleString('fa-IR',{maximumFractionDigits:digits==null?2:digits});
}
async function mgV974Json(url, timeoutMs){
 var controller=typeof AbortController!=='undefined'?new AbortController():null;
 var timer=controller?setTimeout(function(){controller.abort()},timeoutMs||9000):null;
 try{
  var r=await fetch(url,{cache:'no-store',headers:{'Accept':'application/json'},signal:controller?controller.signal:undefined});
  if(!r.ok)throw Error('HTTP '+r.status);
  return await r.json();
 } finally {if(timer)clearTimeout(timer);}
}
