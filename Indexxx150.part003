  {terms:['استخراج مختصات KML','استخراج مختصات از KML','KML KMZ','تبدیل KML'],page:'converter',open:function(){var t=document.querySelector('#converter .m11v2-tab:nth-child(3)');if(typeof window.m11v2Tab==='function')window.m11v2Tab(2,t);}},
  {terms:['فلزیاب'],page:'menu18',selector:'[data-m18-open="m18PanelMetal"]'},
