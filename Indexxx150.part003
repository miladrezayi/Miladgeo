    for(var db=0;db<drawButtons.length;db++){(function(btn){btn.addEventListener('click',function(){var mode=btn.getAttribute('data-mode');if((mode==='line'||mode==='area')&&state.drawMode===mode&&state.drawPoints.length>=2){finishCurrentDrawing();return;}setDrawMode(mode);});})(drawButtons[db]);}
