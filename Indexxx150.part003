 }
 function mgPFAxisStep(label){
  var patterns=[
   new RegExp('(?:گام|فاصله|افزایش|مقدار\\s*افزایش|میزان\\s*اضافه|تغییر)\\s*(?:محور\\s*)?'+label+'\\s*(?:(?:را|رو|برابر(?:\\s*با)?|به|=|:)\\s*)?'+pfNum,'i'),
   new RegExp('(?:هر\\s*(?:بار|نقطه)\\s*)?'+pfNum+'\\s*(?:واحد\\s*)?(?:تا\\s*تا\\s*)?(?:به|برای)\\s*'+label+'\\s*(?:محور\\s*)?(?:اضافه|افزایش|زیاد)','i'),
   new RegExp(''+pfNum+'\\s*(?:واحد\\s*)?(?:به|برای)\\s*'+label,'i'),
   new RegExp('(?:هر\\s*(?:بار|نقطه)\\s*)?'+pfNum+'\\s*(?:واحد\\s*)?(?:به\\s*)?(?:جهت\\s*)?'+label+'(?:تر)?','i'),
   new RegExp(''+label+'\\s*(?:را|رو)?\\s*'+pfNum+'\\s*تا\\s*'+pfNum+'\\s*تا?\\s*(?:اضافه|افزایش|زیاد)','i'),
   new RegExp(''+label+'\\s*(?:(?:را|رو)\\s*)?(?:(?:هر\\s*بار|با\\s*گام|گام|به\\s*اندازه|به\\s*میزان)\\s*)?'+pfNum+'\\s*(?:تا\\s*تا\\s*)?(?:واحد\\s*)?(?:اضافه|افزایش|زیاد)','i'),
   new RegExp(''+label+'\\s*(?:با\\s*)?(?:گام|فاصله)\\s*'+pfNum,'i')
  ];
  for(var si=0;si<patterns.length;si++){var m=pf.match(patterns[si]);if(m){var n=Number(m[1]);if(Number.isFinite(n))return n;}}
  return null;
 }
 var xs=mgPFAxisStart(pfLabelX),ys=mgPFAxisStart(pfLabelY),zs=mgPFAxisStart(pfLabelZ);
 // Common surveying notation: starting coordinate written as (Easting, Northing).
 if(xs===null||ys===null){
  var pairStart=pf.match(/(?:مبدأ|مبدا|مختصات(?:\s*شروع)?|شروع(?:\s*از)?|نقطه\s*اول|first\s*point|start(?:ing)?\s*coordinate)\s*[:=]?\s*\(?\s*([+-]?(?:\d+\.?\d*|\.\d+))\s*[,،;]\s*([+-]?(?:\d+\.?\d*|\.\d+))\s*\)?/i)||pf.match(/\(\s*([+-]?(?:\d+\.?\d*|\.\d+))\s*[,،;]\s*([+-]?(?:\d+\.?\d*|\.\d+))\s*\)/);
  if(pairStart){if(xs===null)xs=Number(pairStart[1]);if(ys===null)ys=Number(pairStart[2]);}
 }
 var dx=mgPFAxisStep(pfLabelX),dy=mgPFAxisStep(pfLabelY);
 // Accept common informal wording such as "هر دو محور ده تا ده تا زیاد شوند".
 var commonStep=mgPFExtract(/(?:هر\s*(?:بار|نقطه)\s*)?(\d+(?:\.\d+)?)\s*(?:واحد\s*)?(?:تا\s*تا\s*)?(?:اضافه|افزایش|زیاد)\s*(?:شود|شه|بشه|کن|کنه)?\s*(?:برای\s*)?(?:هر\s*دو\s*)?(?:محور|مختصات|x\s*و\s*y)/i,pf);
 if(commonStep===null)commonStep=mgPFExtract(/(?:گام|فاصله|افزایش)\s*(?:هر\s*دو\s*)?(?:محورها|محور|مختصات)\s*(?:برابر\s*با|به|=|:)\s*(\d+(?:\.\d+)?)/i,pf);
 if(dx===null)dx=commonStep;
 if(dy===null)dy=commonStep;
 var defaulted=[];
 if(count!==null&&(!Number.isInteger(count)||count<1||count>10000))count=null;
 if(count===null){
  var askCount='تعداد نقطه‌ها را متوجه نشدم. چند نقطه در فایل بسازم؟ تعداد را با رقم یا حروف بنویس؛ مثلاً ۲۰ نقطه.';
  add(message,'user');history.push({role:'user',content:message});add(askCount,'bot');history.push({role:'assistant',content:askCount});history=history.slice(-12);saveChat();input.value='';status.textContent='تعداد نقاط لازم است';msgs.scrollTop=msgs.scrollHeight;return;
 }
 if(xs===null||ys===null){
  if(delegated){if(xs===null){xs=275000;defaulted.push('X شروع = 275000');}if(ys===null){ys=4065000;defaulted.push('Y شروع = 4065000');}}
  else{
   var askAxis='تعداد '+count+' نقطه را فهمیدم. برای اینکه مختصات واقعی پروژه را حدس نزنم، فقط مبدأهای X و Y را بفرست؛ یا بگو «X و Y دلخواه خودت» تا مختصات نمونه انتخاب کنم.';
   add(message,'user');history.push({role:'user',content:message});add(askAxis,'bot');history.push({role:'assistant',content:askAxis});history=history.slice(-12);saveChat();input.value='';status.textContent='مبدأ مختصات لازم است';msgs.scrollTop=msgs.scrollHeight;return;
  }
 }
 if(dx===null){dx=10;defaulted.push('گام X = 10');}
 if(dy===null){dy=10;defaulted.push('گام Y = 10');}
 if(zs===null){zs=0;defaulted.push('Z = 0');}
 if(!Number.isFinite(xs)||!Number.isFinite(ys)||!Number.isFinite(dx)||!Number.isFinite(dy)||!Number.isFinite(zs)){
