    function showMapLayers(){if(!layerControl)return;layerControl.classList.add('m17-layer-open');layerControl.setAttribute('aria-hidden','false');if(layerToggle)layerToggle.setAttribute('aria-expanded','true');if(layerHideTimer)clearTimeout(layerHideTimer);layerHideTimer=setTimeout(hideMapLayers,2000);}
    window.m17ShowIntroLayers=function(){showMapLayers();};
