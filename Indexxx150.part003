 if(count===null)count=mgPFNumberWords(pf);
 if(count===null){var endCount=pf.match(/(?:نقطه|پوینت|point|points)\s*(\d+)\b/i);if(endCount)count=Number(endCount[1]);}
 var delegated=/(?:دلخواه|به\s*انتخاب\s*خودت|خودت(?:\s*.{0,14})?(?:انتخاب|تعیین|مشخص|در\s*نظر|بذار|بگذار)|هر\s*چی\s*خودت|هرچی\s*خودت|فرقی\s*نداره|مهم\s*نیست|تصادفی|رندوم|نمونه|آزمایشی|فرضی|پیش\s*فرض|پیشفرض|اختیاری|up\s*to\s*you|choose\s*for\s*me|random|sample|dummy)/i.test(pf);
 var pfLabelX='(?:محور\\s*)?(?:ایکس|x|easting|east|شرق|شرقی)';
 var pfLabelY='(?:محور\\s*)?(?:وای|y|northing|north|شمال|شمالی)';
 var pfLabelZ='(?:محور\\s*)?(?:ارتفاع|الویشن|elevation|z)';
 function mgPFAxisStart(label){
  var patterns=[
   new RegExp(label+'\\s*(?:(?:رو|را)\\s*)?(?:(?:از|شروع(?:ش)?|مبدأ|مبدا|ابتدا|برابر(?:\\s*با)?|روی|بذار|بگذار|تنظیم\\s*کن(?:\\s*روی)?|=|:)\\s*)?'+pfNum,'i'),
   new RegExp('(?:مختصات|شروع|مبدأ|مبدا|ابتدا|از)\\s*'+label+'\\s*(?:(?:رو|را|از|برابر(?:\\s*با)?|روی)\\s*)?'+pfNum,'i'),
   new RegExp(pfNum+'\\s*(?:به\\s*عنوان\\s*(?:شروع|مبدأ|مبدا)\\s*)?(?:برای|روی|در)\\s*'+label,'i')
  ];
  for(var ai=0;ai<patterns.length;ai++){var m=pf.match(patterns[ai]);if(m){var n=Number(m[1]);if(Number.isFinite(n))return n;}}
