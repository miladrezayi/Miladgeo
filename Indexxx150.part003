  add(message,'user');history.push({role:'user',content:message});add(bad,'bot');history.push({role:'assistant',content:bad});history=history.slice(-12);saveChat();input.value='';status.textContent='بررسی اعداد ورودی';msgs.scrollTop=msgs.scrollHeight;return;
 }
 var pfWantsExcel=/(?:اکسل|excel|xlsx|xls|spreadsheet)/i.test(pf);
 var pfWantsText=/(?:تکست|متن|txt|csv|text)/i.test(pf);
 var pfBoth=/(?:هر\s*دو|هردو|هم\s*اکسل\s*هم\s*(?:تکست|متن)|(?:اکسل|excel)\s*(?:و|همراه\s*با|به\s*علاوه)\s*(?:تکست|متن|txt)|(?:تکست|متن|txt)\s*(?:و|همراه\s*با|به\s*علاوه)\s*(?:اکسل|excel))/i.test(pf);
 if(!pfWantsExcel&&!pfWantsText){pfWantsExcel=true;pfWantsText=true;}
 if(pfBoth){pfWantsExcel=true;pfWantsText=true;}
 // If the user used an alternative "Excel or text", giving both removes a needless follow-up.
 if(pfWantsExcel&&pfWantsText&&/(?:یا|یا اینکه|or)/i.test(pf))pfBoth=true;
 var rows=[['Point','Easting','Northing','Elevation','Description']];
 for(var pfi=0;pfi<count;pfi++)rows.push(['P'+(pfi+1),Number((xs+pfi*dx).toFixed(6)),Number((ys+pfi*dy).toFixed(6)),zs,'PT']);
 var txt=rows.slice(1).map(function(r){return r.join(',')}).join('\r\n')+'\r\n';
 var stem='MiladGeo_PENZD_'+count+'_Points';
 function mgPointDownload(name,blob){
  try{if(typeof window.miladgeoDirectSaveBlob==='function'){window.miladgeoDirectSaveBlob(name,blob);return;}if(typeof window.miladgeoExportBlob==='function'){window.miladgeoExportBlob(name,blob);return;}}catch(ex){console.warn('PENZD save bridge:',ex);}
  var u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download=name;a.style.display='none';document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(u)},30000);
