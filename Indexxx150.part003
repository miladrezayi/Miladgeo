     miniBtn.addEventListener('click',function(){overlay.remove();makeDock();});
     stopBtn.addEventListener('click',function(){audio.pause();audio.removeAttribute('src');audio.load();try{if(window.mgIncomingMusicObjectUrl)URL.revokeObjectURL(window.mgIncomingMusicObjectUrl);if('mediaSession' in navigator){navigator.mediaSession.metadata=null;navigator.mediaSession.playbackState='none';['play','pause','previoustrack','nexttrack','stop'].forEach(function(a){try{navigator.mediaSession.setActionHandler(a,null);}catch(e){}});}}catch(e){}window.mgIncomingMusicAudio=null;window.mgIncomingMusicObjectUrl='';overlay.remove();var d=document.getElementById('mgIncomingMusicDock');if(d)d.remove();});
     audio.addEventListener('error',function(){if(typeof toast==='function')toast('این فایل انتخاب شد، اما کدک آن در Android WebView گوشی پشتیبانی نمی‌شود. برای سازگاری بیشتر MP3 یا M4A را امتحان کن.');});
     setPlaying(true);return;
   }
   var old=document.getElementById('mgIncomingMediaOverlay');if(old)old.remove();
   var overlay=document.createElement('div');overlay.id='mgIncomingMediaOverlay';overlay.style.cssText='position:fixed;inset:0;z-index:2147483000;background:rgba(0,0,0,.94);display:flex;align-items:center;justify-content:center;padding:12px 14px calc(104px + env(safe-area-inset-bottom,0px));box-sizing:border-box;direction:rtl;';
   var panel=document.createElement('section');panel.style.cssText='width:min(100%,900px);max-height:calc(100dvh - 132px - env(safe-area-inset-bottom,0px));max-height:calc(100vh - 132px);overflow:auto;overscroll-behavior:contain;background:#111b13;border:2px solid #6b956c;border-radius:18px;padding:12px;color:#f2f6ef;box-sizing:border-box;box-shadow:0 12px 40px #0009;';
   var head=document.createElement('div');head.style.cssText='display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;';
   var title=document.createElement('b');title.textContent=(kind==='video'?'🎬 پخش‌کننده ویدئو':'🖼️ نمایش تصویر')+' — '+file.name;title.style.cssText='font:bold 14px Tahoma,Arial,sans-serif;overflow-wrap:anywhere;';
   var close=document.createElement('button');close.type='button';close.textContent='✕ بستن';close.style.cssText='border:1px solid #9ab79a;border-radius:10px;padding:9px 12px;background:#263d29;color:#fff;font-weight:bold;';head.append(title,close);panel.appendChild(head);
   var url=sourceUrl||URL.createObjectURL(file),media;
   if(kind==='image'){media=document.createElement('img');media.alt=file.name||'تصویر';media.src=url;media.style.cssText='display:block;max-width:100%;max-height:78vh;object-fit:contain;margin:auto;border-radius:10px;background:#080808;';}
   else{media=document.createElement('video');media.controls=true;media.autoplay=true;media.preload='metadata';media.playsInline=true;media.style.cssText='display:block;width:100%;max-height:72vh;background:#000;border-radius:12px;';media.src=url;}
   panel.appendChild(media);if(kind==='image'){var tools=document.createElement('div');tools.style.cssText='display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:12px;';var zoomOut=document.createElement('button'),zoomIn=document.createElement('button'),fit=document.createElement('button');[zoomOut,zoomIn,fit].forEach(function(b){b.type='button';b.style.cssText='border:1px solid #83cfff;border-radius:12px;padding:9px 14px;background:linear-gradient(135deg,#18294a,#442052);color:#fff;font-weight:900;';});zoomOut.textContent='−';zoomIn.textContent='＋';fit.textContent='اندازه مناسب';var scale=1;function applyZoom(){media.style.transform='scale('+scale+')';media.style.transformOrigin='center';}zoomOut.onclick=function(){scale=Math.max(.5,scale-.2);applyZoom();};zoomIn.onclick=function(){scale=Math.min(4,scale+.2);applyZoom();};fit.onclick=function(){scale=1;applyZoom();};tools.append(zoomOut,zoomIn,fit);panel.appendChild(tools);
   /* miladgeo-image-pdf-export-actions: export current image or multiple gallery images as a real multi-page PDF. */
   var pdfActions=document.createElement('div');pdfActions.id='mgImagePdfExportActions';pdfActions.style.cssText='display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:10px 0 2px;width:100%;';
   function pdfActionButton(label){var b=document.createElement('button');b.type='button';b.textContent=label;b.style.cssText='min-height:46px;border:1px solid #8ec39a;border-radius:12px;padding:10px 8px;background:linear-gradient(135deg,#155b36,#23834b);color:#fff;font:bold 12px Tahoma,Arial,sans-serif;box-shadow:0 3px 10px #0004;';return b;}
   var singlePdfBtn=pdfActionButton('📄 خروجی PDF');
   var multiPdfBtn=pdfActionButton('🖼️ چند تصویر به PDF');
   var galleryPicker=document.createElement('input');galleryPicker.type='file';galleryPicker.accept='image/*,.heic,.heif,.tif,.tiff,.bmp';galleryPicker.multiple=true;galleryPicker.style.cssText='display:none;';galleryPicker.setAttribute('aria-label','انتخاب چند تصویر از گالری');
   pdfActions.append(singlePdfBtn,multiPdfBtn);panel.append(pdfActions,galleryPicker);
   function mgImageToJpegBytes(img){
     return new Promise(function(resolve,reject){
       try{
         var iw=img.naturalWidth||img.videoWidth||img.width,ih=img.naturalHeight||img.videoHeight||img.height;
         if(!iw||!ih)throw new Error('ابعاد تصویر قابل تشخیص نیست.');
         var maxSide=3600,ratio=Math.min(1,maxSide/Math.max(iw,ih)),w=Math.max(1,Math.round(iw*ratio)),h=Math.max(1,Math.round(ih*ratio));
         var canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;
         var ctx=canvas.getContext('2d');if(!ctx)throw new Error('پردازش تصویر در این گوشی در دسترس نیست.');
         ctx.fillStyle='#ffffff';ctx.fillRect(0,0,w,h);ctx.drawImage(img,0,0,w,h);
         canvas.toBlob(function(blob){
           if(!blob){reject(new Error('تبدیل تصویر ناموفق بود.'));return;}
           blob.arrayBuffer().then(function(buffer){resolve({bytes:new Uint8Array(buffer),width:w,height:h});}).catch(reject);
         },'image/jpeg',0.91);
       }catch(err){reject(err);}
     });
   }
   function mgLoadGalleryImage(file){
     return new Promise(function(resolve,reject){
       var objectUrl=URL.createObjectURL(file),img=new Image(),done=false;
       function finish(err,value){if(done)return;done=true;URL.revokeObjectURL(objectUrl);if(err)reject(err);else resolve(value);}
       img.onload=function(){mgImageToJpegBytes(img).then(finish.bind(null,null)).catch(finish);};
       img.onerror=function(){finish(new Error('بازکردن تصویر «'+(file.name||'بدون نام')+'» ممکن نشد؛ قالب آن در نمایشگر گوشی پشتیبانی نمی‌شود.'));};
       img.src=objectUrl;
     });
   }
   function mgBuildImagePdfBlob(items){
     if(!items||!items.length)throw new Error('هیچ تصویری برای ساخت PDF انتخاب نشده است.');
     var enc=new TextEncoder(),chunks=[],offsets=[],total=0;
     function pushBytes(bytes){chunks.push(bytes);total+=bytes.length;}
     function pushText(text){pushBytes(enc.encode(text));}
     function startObj(n){offsets[n]=total;pushText(n+' 0 obj\n');}
     function endObj(){pushText('\nendobj\n');}
     var pageRefs=items.map(function(_,i){return (5+i*3)+' 0 R';});
     pushText('%PDF-1.4\n%MiladGeo Image PDF\n');
     startObj(1);pushText('<< /Type /Catalog /Pages 2 0 R >>');endObj();
     startObj(2);pushText('<< /Type /Pages /Kids ['+pageRefs.join(' ')+'] /Count '+items.length+' >>');endObj();
     items.forEach(function(item,i){
       var imageObj=3+i*3,contentObj=4+i*3,pageObj=5+i*3;
       var pw=item.width>=item.height?841.89:595.28,ph=item.width>=item.height?595.28:841.89,margin=24;
       var scale=Math.min((pw-margin*2)/item.width,(ph-margin*2)/item.height),dw=item.width*scale,dh=item.height*scale,x=(pw-dw)/2,y=(ph-dh)/2;
       var stream='q\n'+dw.toFixed(3)+' 0 0 '+dh.toFixed(3)+' '+x.toFixed(3)+' '+y.toFixed(3)+' cm\n/Im0 Do\nQ\n';
       var streamBytes=enc.encode(stream);
       startObj(imageObj);pushText('<< /Type /XObject /Subtype /Image /Width '+item.width+' /Height '+item.height+' /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length '+item.bytes.length+' >>\nstream\n');pushBytes(item.bytes);pushText('\nendstream');endObj();
       startObj(contentObj);pushText('<< /Length '+streamBytes.length+' >>\nstream\n');pushBytes(streamBytes);pushText('endstream');endObj();
       startObj(pageObj);pushText('<< /Type /Page /Parent 2 0 R /MediaBox [0 0 '+pw.toFixed(2)+' '+ph.toFixed(2)+'] /Resources << /XObject << /Im0 '+imageObj+' 0 R >> >> /Contents '+contentObj+' 0 R >>');endObj();
     });
     var size=3+items.length*3,xrefOffset=total;pushText('xref\n0 '+size+'\n0000000000 65535 f \n');
     for(var n=1;n<size;n++)pushText(String(offsets[n]).padStart(10,'0')+' 00000 n \n');
     pushText('trailer\n<< /Size '+size+' /Root 1 0 R >>\nstartxref\n'+xrefOffset+'\n%%EOF');
     return new Blob(chunks,{type:'application/pdf'});
   }
   function mgImagePdfName(name){return String(name||'MiladGeo_Image').replace(/\.[^.]+$/,'').replace(/[\\/:*?"<>|]+/g,'_').slice(0,90)||'MiladGeo_Image';}
   function mgImagePdfBase64(bytes){
     var binary='',chunk=0x8000;
     for(var i=0;i<bytes.length;i+=chunk){
       binary+=String.fromCharCode.apply(null,bytes.subarray(i,Math.min(i+chunk,bytes.length)));
     }
     return btoa(binary);
   }
   function mgBuildImagePdfHtml(items,name){
     if(!items||!items.length)throw new Error('هیچ تصویری برای ساخت PDF انتخاب نشده است.');
     var pages=items.map(function(item,index){
       var orientation=item.width>item.height?'landscape':'portrait';
       var src='data:image/jpeg;base64,'+mgImagePdfBase64(item.bytes);
       return '<section class="mg-image-pdf-page '+orientation+'"><img src="'+src+'" alt="تصویر '+(index+1)+'"></section>';
     }).join('');
     var safeTitle=String(name||'MiladGeo Images').replace(/[<>&"']/g,function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;'}[c];});
     return '<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+safeTitle+'</title><style>'+
       '@page{size:A4 portrait;margin:8mm}@page landscape{size:A4 landscape;margin:8mm}*{box-sizing:border-box}html,body{margin:0;padding:0;background:#fff;color:#111;font-family:Tahoma,Arial,sans-serif}.mg-image-pdf-page{height:281mm;width:100%;display:flex;align-items:center;justify-content:center;overflow:visible;break-after:page;page-break-after:always;break-inside:avoid;page-break-inside:avoid}.mg-image-pdf-page.landscape{page:landscape;height:194mm}.mg-image-pdf-page:last-child{break-after:auto;page-break-after:auto}.mg-image-pdf-page img{display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;flex:0 1 auto}@media print{html,body{width:auto!important;height:auto!important}.mg-image-pdf-page{margin:0!important;padding:0!important}.mg-image-pdf-page img{max-width:100%!important;max-height:100%!important}}@media screen{body{background:#ddd}.mg-image-pdf-page{background:#fff;margin:12px auto;max-width:190mm;box-shadow:0 2px 12px #0003;padding:4mm}}'+
       '</style></head><body>'+pages+'</body></html>';
   }
   async function mgSaveImagePdf(items,name){
     var printable=mgBuildImagePdfHtml(items,name);
     if(typeof window.miladgeoM17PrintHtml!=='function')throw new Error('موتور PDF منوی ۱۷ در دسترس نیست؛ منوی ۱۷ را یک‌بار باز کن و دوباره تلاش کن.');
     var result=window.miladgeoM17PrintHtml(printable,name||'MiladGeo_Images.pdf');
     if(result===false)throw new Error('موتور PDF منوی ۱۷ نتوانست پنجره خروجی را باز کند.');
     toast('✓ '+items.length+' تصویر به موتور PDF منوی ۱۷ ارسال شد؛ در پنجره چاپ «ذخیره به‌صورت PDF» را انتخاب کن.');
   }
   singlePdfBtn.addEventListener('click',async function(){
     if(singlePdfBtn.disabled)return;singlePdfBtn.disabled=true;var label=singlePdfBtn.textContent;singlePdfBtn.textContent='در حال ساخت PDF…';
     try{var item=await mgImageToJpegBytes(media);await mgSaveImagePdf([item],mgImagePdfName(file.name)+'.pdf');}
     catch(err){console.error('MILADGEO_SINGLE_IMAGE_PDF',err);toast('ساخت PDF ناموفق بود: '+(err.message||err));}
     finally{singlePdfBtn.disabled=false;singlePdfBtn.textContent=label;}
   });
   multiPdfBtn.addEventListener('click',function(){galleryPicker.value='';galleryPicker.click();});
   galleryPicker.addEventListener('change',async function(){
     var files=Array.from(galleryPicker.files||[]);if(!files.length)return;
     if(files.length>40){toast('برای هر PDF حداکثر ۴۰ تصویر انتخاب کن.');galleryPicker.value='';return;}
     var label=multiPdfBtn.textContent;multiPdfBtn.disabled=true;singlePdfBtn.disabled=true;multiPdfBtn.textContent='در حال آماده‌سازی ۰/'+files.length+'…';
     try{
       var pages=[];
       for(var i=0;i<files.length;i++){if(!/^image\//i.test(files[i].type||'')&&!/\.(jpe?g|png|webp|gif|bmp|tiff?|heic|heif)$/i.test(files[i].name||''))throw new Error('فایل «'+files[i].name+'» تصویر شناخته‌شده‌ای نیست.');pages.push(await mgLoadGalleryImage(files[i]));multiPdfBtn.textContent='در حال آماده‌سازی '+(i+1)+'/'+files.length+'…';}
       var stamp=new Date(),date=stamp.getFullYear()+String(stamp.getMonth()+1).padStart(2,'0')+String(stamp.getDate()).padStart(2,'0');await mgSaveImagePdf(pages,'MiladGeo_Images_'+date+'.pdf');
     }catch(err){console.error('MILADGEO_MULTI_IMAGE_PDF',err);toast('ساخت PDF تصاویر ناموفق بود: '+(err.message||err));}
     finally{multiPdfBtn.disabled=false;singlePdfBtn.disabled=false;multiPdfBtn.textContent=label;galleryPicker.value='';}
   });}else{var videoTools=document.createElement('div');videoTools.style.cssText='display:flex;justify-content:center;gap:9px;margin-top:10px;';var vfull=document.createElement('button');vfull.type='button';vfull.textContent='⛶ نمایش تمام‌صفحه';vfull.style.cssText='border:1px solid #83cfff;border-radius:12px;padding:10px 16px;background:linear-gradient(135deg,#18294a,#442052);color:#fff;font-weight:900;';vfull.onclick=function(){if(media.requestFullscreen)media.requestFullscreen().catch(function(){});};videoTools.appendChild(vfull);panel.appendChild(videoTools);}overlay.appendChild(panel);document.body.appendChild(overlay);
   function cleanup(){try{if(media.pause)media.pause();}catch(e){}media.removeAttribute('src');if(media.load)media.load();if(!sourceUrl)URL.revokeObjectURL(url);overlay.remove();}
   close.addEventListener('click',cleanup);overlay.addEventListener('click',function(e){if(e.target===overlay)cleanup();});
   media.addEventListener('error',function(){if(typeof toast==='function')toast(kind==='image'?'نمایش تصویر ناموفق بود یا قالب فایل پشتیبانی نمی‌شود.':'این قالب ویدئو در WebView پشتیبانی نمی‌شود؛ MP4 (H.264/AAC) را امتحان کن.');});
   if(kind==='video'){var play=media.play();if(play&&play.catch)play.catch(function(){});}
 }

 window.miladGeoOpenIncomingMediaUrl=function(name,mime,url){try{var ext=(name.split('.').pop()||'').toLowerCase(),mt=String(mime||'').toLowerCase(),kind=mt.indexOf('image/')===0||['jpg','jpeg','png','webp','gif','bmp','tif','tiff'].indexOf(ext)>=0?'image':(mt.indexOf('audio/')===0||['mp3','m4a','aac','wav','ogg','oga','opus','flac','amr','wma'].indexOf(ext)>=0?'audio':(mt.indexOf('video/')===0||['mp4','m4v','webm','mkv','3gp','mov','avi'].indexOf(ext)>=0?'video':'audio'));mediaPlayer({name:name},kind,url);return true;}catch(e){console.error('MILADGEO_NATIVE_MEDIA',e);toast('بازکردن رسانه ناموفق بود: '+(e.message||e));return false;}};
 /* INDEXXX9: Safe incoming HTML viewer and general ZIP archive browser. */
 window.mgOpenHtmlIncomingFile=function(file){
   try{
     var old=document.getElementById('mgIncomingHtmlOverlay');if(old)old.remove();
     var url=URL.createObjectURL(file),overlay=document.createElement('div');overlay.id='mgIncomingHtmlOverlay';
     overlay.style.cssText='position:fixed;inset:0;z-index:2147483001;background:#101710;display:flex;flex-direction:column;padding:10px;box-sizing:border-box;';
     var bar=document.createElement('div');bar.style.cssText='display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px;color:#fff;font: bold 14px Tahoma,Arial;';
     var name=document.createElement('span');name.textContent='🌐 '+(file.name||'HTML');name.style.cssText='overflow-wrap:anywhere;';
     var close=document.createElement('button');close.type='button';close.textContent='✕ بستن';close.style.cssText='padding:9px 14px;border:1px solid #8ca98d;border-radius:10px;background:#29452d;color:#fff;font-weight:bold;';
     var frame=document.createElement('iframe');frame.setAttribute('sandbox','allow-scripts allow-forms');frame.referrerPolicy='no-referrer';frame.style.cssText='flex:1;width:100%;border:1px solid #6c8c70;border-radius:10px;background:#fff;';frame.src=url;
     function cleanup(){frame.src='about:blank';URL.revokeObjectURL(url);overlay.remove();}
     close.onclick=cleanup;bar.append(name,close);overlay.append(bar,frame);document.body.appendChild(overlay);return true;
   }catch(e){if(typeof toast==='function')toast('نمایش HTML ناموفق بود: '+(e.message||e));return false;}
 };
 window.mgOpenZipArchive=function(file){
   if(!file)return false;
   function showArchive(JSZip){
     if(!JSZip){if(typeof toast==='function')toast('موتور ZIP آفلاین بارگذاری نشد.');return;}
     var reader=new FileReader();reader.onerror=function(){toast('خواندن فایل ZIP ناموفق بود.');};
     reader.onload=function(ev){
       JSZip.loadAsync(ev.target.result).then(function(zip){
         var names=Object.keys(zip.files).filter(function(n){return !zip.files[n].dir;}).sort(function(a,b){return a.localeCompare(b);});
         var old=document.getElementById('mgIncomingZipOverlay');if(old)old.remove();
         var overlay=document.createElement('div');overlay.id='mgIncomingZipOverlay';overlay.style.cssText='position:fixed;inset:0;z-index:2147483002;background:rgba(0,0,0,.88);display:flex;align-items:center;justify-content:center;padding:10px;box-sizing:border-box;direction:rtl;';
         var panel=document.createElement('section');panel.style.cssText='width:min(100%,900px);height:min(94vh,900px);display:flex;flex-direction:column;overflow:hidden;background:#f7faf7;border:2px solid #56845b;border-radius:16px;color:#17251b;box-shadow:0 12px 40px #0009;';
         var head=document.createElement('div');head.style.cssText='display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px;background:#183d25;color:#fff;';
         var title=document.createElement('b');title.textContent='🗜️ '+(file.name||'ZIP archive')+'  |  '+names.length+' فایل';title.style.cssText='overflow-wrap:anywhere;font: bold 13px Tahoma,Arial;';
         var close=document.createElement('button');close.type='button';close.textContent='✕';close.style.cssText='padding:8px 12px;border:1px solid #c6dfc9;border-radius:9px;background:#315c3b;color:#fff;font-weight:bold;';
         var body=document.createElement('div');body.style.cssText='overflow:auto;padding:10px;flex:1;';
         var preview=document.createElement('div');preview.style.cssText='display:none;position:absolute;inset:54px 10px 10px;background:#fff;border:2px solid #56845b;border-radius:12px;z-index:3;overflow:auto;';
         var mapFiles=names.some(function(n){return /\.(kml|shp)$/i.test(n);});
         function cleanup(){overlay.remove();}
         close.onclick=cleanup;head.append(title,close);panel.append(head);
         if(mapFiles){var mapBtn=document.createElement('button');mapBtn.type='button';mapBtn.textContent='🗺️ ورود اطلاعات نقشه از ZIP';mapBtn.style.cssText='margin:9px 10px 0;padding:11px;border:0;border-radius:10px;background:#dcefe0;color:#174b25;font-weight:bold;';mapBtn.onclick=function(){cleanup();if(typeof window.m17OpenExternalFile==='function'){if(typeof window.goPage==='function')window.goPage('menu17');setTimeout(function(){window.m17OpenExternalFile(file);},180);}else toast('ماژول نقشه آماده نیست.');};panel.appendChild(mapBtn);}
         panel.appendChild(body);
         function showEntry(name){
           var entry=zip.files[name];if(!entry)return;
           entry.async('blob').then(function(blob){
             var ext=(name.split('.').pop()||'').toLowerCase(),url=URL.createObjectURL(blob),view=document.createElement('div');view.style.cssText='position:fixed;inset:10px;z-index:2147483003;background:#fff;border:2px solid #56845b;border-radius:12px;display:flex;flex-direction:column;overflow:hidden;';
             var top=document.createElement('div');top.style.cssText='display:flex;justify-content:space-between;align-items:center;gap:8px;padding:9px;background:#183d25;color:#fff;font:bold 12px Tahoma;';
             var label=document.createElement('span');label.textContent=name;label.style.cssText='overflow-wrap:anywhere;';var back=document.createElement('button');back.type='button';back.textContent='بازگشت به ZIP';back.style.cssText='padding:8px 10px;border:1px solid #c6dfc9;border-radius:8px;background:#315c3b;color:#fff;';
             var content=document.createElement('div');content.style.cssText='flex:1;min-height:0;overflow:auto;';
             function done(){URL.revokeObjectURL(url);view.remove();}
             back.onclick=done;top.append(label,back);view.append(top,content);document.body.appendChild(view);
             if(['html','htm','xhtml'].indexOf(ext)>=0){var fr=document.createElement('iframe');fr.setAttribute('sandbox','allow-scripts allow-forms');fr.referrerPolicy='no-referrer';fr.style.cssText='width:100%;height:100%;border:0;';fr.src=url;content.appendChild(fr);}
             else if(['png','jpg','jpeg','gif','webp','bmp','svg'].indexOf(ext)>=0){var im=document.createElement('img');im.src=url;im.style.cssText='display:block;max-width:100%;max-height:100%;object-fit:contain;margin:auto;';content.appendChild(im);}
             else if(['txt','csv','json','xml','kml','gpx','geojson','css','js','md','yml','yaml','ini','log','prj','html','htm','xhtml'].indexOf(ext)>=0){blob.text().then(function(t){var pre=document.createElement('pre');pre.textContent=t;pre.style.cssText='white-space:pre-wrap;overflow-wrap:anywhere;direction:auto;text-align:left;padding:12px;font:13px monospace;';content.appendChild(pre);});}
             else{var msg=document.createElement('div');msg.style.cssText='padding:20px;text-align:center;font:14px Tahoma;';msg.textContent='پیش‌نمایش این قالب درون ZIP موجود نیست. می‌توانی فایل را استخراج کنی.';content.appendChild(msg);var dl=document.createElement('a');dl.href=url;dl.download=name.split('/').pop();dl.textContent='⬇️ استخراج این فایل';dl.style.cssText='display:block;margin:15px auto;padding:12px;width:max-content;background:#245c35;color:#fff;border-radius:9px;text-decoration:none;';content.appendChild(dl);}
           }).catch(function(e){toast('نمایش فایل داخل ZIP ناموفق بود: '+(e.message||e));});
         }
         if(!names.length){body.textContent='این فایل ZIP خالی است.';}
         names.forEach(function(n){var row=document.createElement('div');row.style.cssText='display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px;margin-bottom:7px;border:1px solid #d5e2d6;border-radius:10px;background:#fff;';var nm=document.createElement('span');nm.textContent='📄 '+n;nm.style.cssText='font:12px Tahoma;overflow-wrap:anywhere;flex:1;';var btn=document.createElement('button');btn.type='button';btn.textContent='بازکردن';btn.style.cssText='padding:8px 12px;border:0;border-radius:8px;background:#285b35;color:#fff;font-weight:bold;white-space:nowrap;';btn.onclick=function(){showEntry(n);};row.append(nm,btn);body.appendChild(row);});
         overlay.appendChild(panel);document.body.appendChild(overlay);
       }).catch(function(e){toast('فایل ZIP خراب یا نامعتبر است: '+(e.message||e));});
     };reader.readAsArrayBuffer(file);
   }
   function loadZipLib(done){
     if(window.JSZip&&typeof window.JSZip.loadAsync==='function'){done(window.JSZip);return;}
     var urls=['./jszip.min.js','file:///android_asset/jszip.min.js','https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js'],i=0;
     function next(){
       if(window.JSZip&&typeof window.JSZip.loadAsync==='function'){done(window.JSZip);return;}
       if(i>=urls.length){done(null);return;}
       var sc=document.createElement('script');sc.src=urls[i++];sc.async=true;
       sc.onload=function(){if(window.JSZip&&typeof window.JSZip.loadAsync==='function')done(window.JSZip);else next();};
       sc.onerror=next;document.head.appendChild(sc);
     }
     next();
   }
   loadZipLib(showArchive);
   return true;
 };
 window.miladGeoOpenIncomingFile=function(name,mime,base64){
   try{
     var raw=atob(base64),bytes=new Uint8Array(raw.length);for(var i=0;i<raw.length;i++)bytes[i]=raw.charCodeAt(i);
     var mimeLower=String(mime||'').toLowerCase(),ext=(name.split('.').pop()||'').toLowerCase(),isDxfMime=['application/dxf','application/x-dxf','image/vnd.dxf','application/vnd.dxf','application/x-autocad','application/acad','application/x-acad'].indexOf(mimeLower)>=0; if(isDxfMime&&ext!=='dxf'){name=(name||'drawing')+'.dxf';ext='dxf';} var file=new File([bytes],name,{type:mime||'application/octet-stream'});
     if(['jpg','jpeg','png','webp','gif','bmp','tif','tiff'].indexOf(ext)>=0||String(mime).indexOf('image/')===0){mediaPlayer(file,'image');return true;}
     if(String(mime).toLowerCase().indexOf('audio/')===0||['mp3','m4a','aac','wav','ogg','oga','opus','flac','amr','wma'].indexOf(ext)>=0){mediaPlayer(file,'audio');return true;}
     if(['mp4','m4v','webm','mkv','3gp','mov','avi'].indexOf(ext)>=0||String(mime).indexOf('video/')===0){mediaPlayer(file,'video');return true;}
     if(['html','htm','xhtml'].indexOf(ext)>=0||String(mime).toLowerCase().indexOf('text/html')===0||String(mime).toLowerCase().indexOf('application/xhtml+xml')===0){window.mgOpenHtmlIncomingFile(file);return true;}
     if(ext==='zip'||String(mime).toLowerCase()==='application/zip'||String(mime).toLowerCase()==='application/x-zip-compressed'){window.mgOpenZipArchive(file);return true;}
     if(['xml','css','js','md','yml','yaml','ini','log'].indexOf(ext)>=0){
       var textOverlay=document.createElement('div');textOverlay.style.cssText='position:fixed;inset:0;z-index:2147483000;background:#111b13;padding:12px;box-sizing:border-box;display:flex;flex-direction:column;';
       var textHead=document.createElement('div');textHead.style.cssText='display:flex;justify-content:space-between;align-items:center;color:#fff;padding:8px;font:bold 13px Tahoma;';
       var textTitle=document.createElement('span');textTitle.textContent='📄 '+name;var textClose=document.createElement('button');textClose.textContent='✕ بستن';textClose.style.cssText='padding:8px 12px;border-radius:9px;background:#29452d;color:#fff;border:1px solid #8ca98d;';
       var textPre=document.createElement('pre');textPre.style.cssText='flex:1;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;background:#fff;color:#17251b;padding:12px;border-radius:10px;direction:auto;text-align:left;font:13px monospace;';
       textClose.onclick=function(){textOverlay.remove();};textHead.append(textTitle,textClose);textOverlay.append(textHead,textPre);document.body.appendChild(textOverlay);file.text().then(function(t){textPre.textContent=t;});return true;
     }
     if(['kml','kmz','gpx','geojson','json'].indexOf(ext)>=0){
       if(typeof window.goPage==='function')window.goPage('menu17');
       waitFor(window.m17OpenExternalFile,function(fn){if(!fn){toast('ماژول منوی ۱۷ آماده نشد؛ صفحه را دوباره باز کن.');return;}try{fn(file);}catch(e){toast('بازکردن فایل نقشه ناموفق بود: '+(e.message||e));}});return true;
     }
     /* miladgeo-dxf-route-menu10: DXF files open in the dedicated Menu 10 DXF Reader.
        DWG and survey interchange text files continue through the Milad Assistant parser. */
     if(['dwg','xyz','pts','prn','tsv','log','gsi','penzd','nez'].indexOf(ext)>=0){
       var botInput=document.getElementById('miladBotFileInput');
       if(!botInput){toast('ورودی تحلیل فایل نقشه‌برداری آماده نیست.');return false;}
       if(typeof window.miladBotChatOpen==='function')window.miladBotChatOpen();
       try{setFile(botInput,file);botInput.dispatchEvent(new Event('change',{bubbles:true}));return true;}
       catch(e){toast('ارسال فایل به پردازشگر نقشه‌برداری ناموفق بود: '+(e.message||e));return false;}
     }
     if(ext==='txt'||ext==='asc'||ext==='dat'){
       if(typeof window.goPage==='function')window.goPage('points');
       waitFor(window.v5LoadTextFile,function(fn){if(!fn){toast('ماژول منوی ۵ آماده نشد؛ صفحه را دوباره باز کن.');return;}try{var input=document.getElementById('v5PointTextFile');setFile(input,file);fn(input);}catch(e){toast('بازکردن فایل متنی ناموفق بود: '+(e.message||e));}});return true;
     }
     var id='',handler='';
     if(ext==='pdf'){id='m10PdfReaderFile';handler='m10OpenPdf';}
     else if(ext==='docx'||ext==='pptx'){id='m10WordReaderFile';handler='m10LoadWordReader';}
     else if(['xlsx','xls','csv'].indexOf(ext)>=0){id='m10ExcelReaderFile';handler='m10LoadExcelReader';}
     /* DXF is intentionally opened with Menu 10's canvas reader. */ else if(ext==='dxf'){id='m10DxfFile';handler='m10LoadDxfReader';}
     else{toast('این نوع فایل در مهندس‌یار پشتیبانی نشده است: '+ext);return false;}
     /* V442 — Open incoming office/CAD files only after Menu 10 is visibly active.
        Android may deliver the intent while the WebView is still restoring its page.
        The previous router assigned the file and invoked the reader immediately;
        the user then had to tap Menu 10, which made the pending view appear.
        Navigate, verify visibility, wait for layout, then assign + invoke the reader. */
     function nextFrame(cb){if(window.requestAnimationFrame)window.requestAnimationFrame(function(){window.requestAnimationFrame(cb);});else setTimeout(cb,80);}
     function activateReaderPage(){
       var page=document.getElementById('cadpdf');
       if(typeof window.goPage==='function')window.goPage('cadpdf');
       else if(typeof window.showPage==='function')window.showPage('cadpdf');
       if(page&&!page.classList.contains('active')&&typeof window.showPage==='function')window.showPage('cadpdf');
       return page;
     }
     activateReaderPage();
     var tries=0;
     function launchWhenVisible(){
       var page=document.getElementById('cadpdf');
       var fn=window[handler];
       var input=document.getElementById(id);
       /* Wait for DOM, Menu 10, the target input and the actual reader function.
          Android may finish delivering ACTION_VIEW before the HTML app has booted. */
       if((!page||!page.classList.contains('active')||!input||typeof fn!=='function')&&tries<100){
         tries++;
         activateReaderPage();
         setTimeout(launchWhenVisible,120);
         return;
       }
       if(!input||typeof fn!=='function'){
         toast('نمایشگر فایل آماده نشد. فایل را دوباره از فایل‌منیجر باز کن.');
         return;
       }
       nextFrame(function(){
         try{
             var input=document.getElementById(id);
             if(!input)throw new Error('ورودی فایل منوی ۱۰ پیدا نشد: '+id);
             setFile(input,file);
             var cardId=(ext==='docx'||ext==='pptx')?'m10WordReaderCard':(['xlsx','xls','csv'].indexOf(ext)>=0?'m10ExcelReaderCard':(ext==='dxf'?'m10DxfCard':'m10ReaderCard'));
             /* V444 — Opening a panel is different from scrolling to it.
                The old router only scrolled to the hidden Word/Excel panel;
                the user still had to tap its menu card to add m10-open.
                Expand the correct panel first, then start its reader automatically. */
             if(typeof window.scrollToId==='function'){
               window.scrollToId(cardId);
             }else{
               var card=document.getElementById(cardId);
               if(card){card.classList.add('m10-open');if(card.scrollIntoView)card.scrollIntoView({behavior:'auto',block:'start'});}
             }
             var result=fn();
             if(ext==='pdf')setTimeout(function(){if(typeof window.m10OpenPdfExternal==='function')window.m10OpenPdfExternal();},300);
             /* Reader modules may finish asynchronously (DOCX/Excel load libraries).
                Keep the reader page active and bring its result/status into view. */
             /* V443 — Android startup can restore the home page after the incoming-file
                callback. Reassert Menu 10 for a bounded startup window. Do not invoke
                the reader again: its selected File object and async rendering must survive. */
             [250,700,1200,1800,2600,3800,5200].forEach(function(delay){
               setTimeout(function(){
                 var livePage=document.getElementById('cadpdf');
                 if(!livePage||!livePage.classList.contains('active'))activateReaderPage();
                 var target=document.getElementById((ext==='docx'||ext==='pptx')?'m10WordReaderView':(['xlsx','xls','csv'].indexOf(ext)>=0?'m10ExcelReaderView':(ext==='dxf'?'m10DxfCard':'m10ReaderCard')));
                 var cardNow=document.getElementById(cardId);
                 if(cardNow&&cardNow.scrollIntoView)cardNow.scrollIntoView({behavior:'auto',block:'start'});
                 if(target&&target.scrollIntoView)target.scrollIntoView({behavior:'auto',block:'nearest'});
               },delay);
             });
           }catch(e){toast('بازکردن فایل ناموفق بود: '+(e.message||e));}
         });
       }
     launchWhenVisible();return true;
   }catch(e){console.error('MILADGEO_INCOMING_FILE',e);toast('بازکردن فایل ناموفق بود: '+(e.message||e));return false;}
 };
})();
</script>
<style id="mg-ai-pins-v266-style">
#mgPinnedAIStack{display:flex;flex-direction:column;gap:8px;width:100%;margin:8px 0 14px;direction:rtl;box-sizing:border-box}
.mg-ai-pinned-row{width:100%;min-height:54px;box-sizing:border-box;display:flex;align-items:center;gap:12px;padding:10px 14px;border:1px solid rgba(145,205,255,.48);border-radius:15px;background:linear-gradient(115deg,rgba(18,39,73,.72),rgba(56,35,92,.60));color:#f5f9ff;box-shadow:inset 0 1px 0 rgba(255,255,255,.16),0 5px 18px rgba(0,0,0,.12);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);font:inherit;text-align:right;cursor:pointer}
.mg-ai-pinned-row .mg-ai-name{font-weight:800;flex:1;min-width:0}.mg-ai-pinned-row .mg-ai-open{font-size:12px;opacity:.72;white-space:nowrap}.mg-ai-unpin{border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.12);color:#fff;border-radius:9px;width:34px;height:34px;font-size:18px;flex:0 0 34px;cursor:pointer}
.mg-ai-pin-control{position:absolute;left:10px;top:50%;transform:translateY(-50%);z-index:4;display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:10px;border:1px solid #9bb4cf;background:#fff;color:#31435c;font-size:18px;line-height:1;cursor:pointer;box-shadow:0 2px 8px #0002}
.mg-ai-pin-control.is-pinned{background:#e4f7e9;border-color:#55a76a;color:#16763a}.mg-search-result{position:relative!important;padding-left:54px!important}
/* Show the pinned section even before any incoming audio dock is opened. */
#mgMusicDockSlot:has(#mgPinnedAIStack){display:block!important}
</style>
<script id="mg-ai-pins-v266">
(function(){
 'use strict';
 var KEY='miladgeo_ai_pinned_v263';
 var catalog=[
  {id:'chatgpt',name:'🤖 چت جی پی تی',url:'https://chatgpt.com/'},
  {id:'gemini',name:'💎 Gemini',url:'https://gemini.google.com/'},
  {id:'claude',name:'🟠 Claude',url:'https://claude.ai/'},
  {id:'copilot',name:'🔷 Microsoft Copilot',url:'https://copilot.microsoft.com/'},
  {id:'perplexity',name:'🔎 Perplexity',url:'https://www.perplexity.ai/'},
  {id:'deepseek',name:'🐋 DeepSeek',url:'https://chat.deepseek.com/'},
  {id:'grok',name:'✳️ Grok',url:'https://grok.com/'},
  {id:'esri',name:'🗺️ Esri ArcGIS Docs Assistant',url:'https://doc.esri.com/en/arcgis-online/latest/reference/doc-assistant.html'},
  {id:'civil3d',name:'📐 Civil 3D AI Copilot',url:'https://marketplace.autodesk.com/apps/495f090c-8645-4487-9f78-527f71bf7822'},
  {id:'aplitop',name:'📍 Aplitop tcpMDT 26 AI',url:'https://www.aplitop.com/tcpmdt26-upgrade-surveying-engineering-software'},
  {id:'bentley',name:'🏗️ Bentley Copilot',url:'https://docs.bentley.com/LiveContent/web/MicroStation-v2026.0.2/Help/en/topics/Concept/new_and_changed_in_microstation_2026.html'},
  {id:'wolfram',name:'🧮 Wolfram Alpha',url:'https://www.wolframalpha.com/'},
  {id:'forma',name:'🏢 Autodesk Forma AI',url:'https://app.autodeskforma.com/'}
 ];
 function read(){try{var a=JSON.parse(localStorage.getItem(KEY)||'[]');return Array.isArray(a)?a.filter(function(id,i){return catalog.some(function(x){return x.id===id;})&&a.indexOf(id)===i;}):[];}catch(e){return [];}}
 function save(a){try{localStorage.setItem(KEY,JSON.stringify(a));}catch(e){console.warn('AI pins could not be saved',e);}}
 function itemForText(t){var n=String(t||'').toLowerCase().replace(/[‌\s]/g,'');var tests=[
  ['esri',['esri','arcgis','آرکجی‌آی‌اس','آرک جی آی اس']],
  ['civil3d',['civil3d','civil3dcopilot','civil3dai','سیویل۳دی','سیویل3دی']],
  ['aplitop',['aplitop','tcpmdt','ایپلیتپ','تاپ‌سی‌ام‌دی‌تی']],
  ['bentley',['bentley','microstation','بنتلی','مایکرو استیشن']],
  ['wolfram',['wolfram','ولفرام','ولفرم']],
  ['forma',['forma','autodeskforma','اتودسک‌فرما','فرما']],
  ['chatgpt',['چتجیپی','چتجیپیتی','chatgpt','chat.openai']],
  ['gemini',['gemini','جمینای','جیمینای']],
  ['claude',['claude','کلود']],
  ['copilot',['copilot','کوپایلت']],
  ['perplexity',['perplexity','پرپلکسیتی']],
  ['deepseek',['deepseek','دیپ‌سیک','دیپسیک']],
  ['grok',['grok','گروک']]
 ];for(var i=0;i<tests.length;i++){if(tests[i][1].some(function(k){return n.indexOf(k)>=0;})){return catalog.find(function(x){return x.id===tests[i][0];})||null;}}return null;}
 function getStack(){var slot=document.getElementById('mgMusicDockSlot');if(!slot)return null;var stack=document.getElementById('mgPinnedAIStack');if(!stack){stack=document.createElement('div');stack.id='mgPinnedAIStack';stack.setAttribute('aria-label','هوش مصنوعی‌های سنجاق‌شده');slot.appendChild(stack);}return stack;}
 function render(){var stack=getStack();if(!stack)return;stack.innerHTML='';var ids=read();ids.forEach(function(id){var m=catalog.find(function(x){return x.id===id;});if(!m)return;var row=document.createElement('div');row.className='mg-ai-pinned-row';row.setAttribute('role','button');row.tabIndex=0;var name=document.createElement('span');name.className='mg-ai-name';name.textContent=m.name;var hint=document.createElement('span');hint.className='mg-ai-open';hint.textContent='باز کردن';var remove=document.createElement('button');remove.type='button';remove.className='mg-ai-unpin';remove.textContent='📌';remove.title='برداشتن سنجاق';remove.setAttribute('aria-label','برداشتن سنجاق '+m.name);remove.addEventListener('click',function(e){e.stopPropagation();save(read().filter(function(v){return v!==id;}));render();refreshPins();});row.append(name,hint,remove);function open(){window.location.href=m.url;}row.addEventListener('click',open);row.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();open();}});stack.appendChild(row);});}
 function toggle(id){var a=read(),i=a.indexOf(id);if(i>=0)a.splice(i,1);else a.push(id);save(a);render();refreshPins();}
 function refreshPins(){document.querySelectorAll('#mgToolSearchResults .mg-search-result').forEach(function(b){var m=itemForText(b.textContent);if(!m)return;var pin=b.querySelector('.mg-ai-pin-control');if(!pin){pin=document.createElement('span');pin.className='mg-ai-pin-control';pin.setAttribute('role','button');pin.setAttribute('tabindex','0');pin.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();toggle(m.id);});pin.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();e.stopPropagation();toggle(m.id);}});b.appendChild(pin);}var active=read().indexOf(m.id)>=0;pin.classList.toggle('is-pinned',active);pin.textContent=active?'📌':'＋';pin.title=active?'برداشتن از منوی اصلی':'سنجاق به منوی اصلی';pin.setAttribute('aria-label',pin.title);});}
 function start(){
  render();refreshPins();
  /* The search overlay is created lazily after page load, so observe body
     but react only to mutations belonging to the search-results area. */
  if(document.body&&window.MutationObserver){
   var pending=false;
   new MutationObserver(function(records){
    var relevant=records.some(function(record){
     var target=record.target;
     if(target&&target.nodeType===1&&target.closest&&target.closest('#mgToolSearchResults'))return true;
     return Array.prototype.some.call(record.addedNodes||[],function(node){
      return node.nodeType===1&&((node.id==='mgToolSearchOverlay')||(node.id==='mgToolSearchResults')||(node.querySelector&&node.querySelector('#mgToolSearchResults')));
     });
    });
    if(!relevant||pending)return;
    pending=true;
    requestAnimationFrame(function(){pending=false;refreshPins();});
   }).observe(document.body,{childList:true,subtree:true});
  }
  window.addEventListener('storage',function(e){if(e.key===KEY)render();});
  window.addEventListener('pageshow',render);
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>
<style id="mg-engineer-pins-v274">
#mgMusicDockSlot:has(#mgPinnedEngineerStack){display:block!important}
#menu20 .m20-grid .m20-card{position:relative}
#menu20 .m20-grid .m20-card>.mg-engineer-pin{position:absolute!important;top:7px!important;left:7px!important;right:auto!important;z-index:5!important;width:19px!important;min-width:19px!important;max-width:19px!important;height:19px!important;min-height:19px!important;max-height:19px!important;padding:0!important;margin:0!important;border-radius:6px!important;border:1px solid #6b9c79!important;background:#ffffffed!important;color:#173d27!important;font-size:11px!important;line-height:17px!important;font-weight:900!important;box-shadow:0 1px 4px #0002!important;display:grid!important;place-items:center!important;box-sizing:border-box!important}
#menu20 .m20-grid .m20-card>.mg-engineer-pin.active{background:#d7f3d8!important;border-color:#19854a!important;color:#087a38!important}
#mgMusicDockSlot{display:flex;flex-direction:column;gap:7px;margin:7px 0 10px;direction:rtl}
#mgPinnedEngineerStack,#mgPinnedMenu10Stack{display:flex;flex-direction:column;gap:7px;margin:0!important;direction:rtl}
#mgPinnedEngineerStack .mg-engineer-shortcut{position:relative;width:100%;min-height:54px;box-sizing:border-box;border:2px solid #699b70;border-radius:13px;background:linear-gradient(110deg,#edf8ed,#d6ecd8);color:#183d27;font:900 15px Tahoma,Arial,sans-serif;padding:10px 13px 10px 48px;text-align:right;display:flex;align-items:center;justify-content:space-between;gap:8px;cursor:pointer}
#mgPinnedEngineerStack .mg-engineer-shortcut small{font-size:11px;font-weight:700;opacity:.72}
#mgPinnedEngineerStack .mg-engineer-unpin{position:absolute;left:8px;top:50%;transform:translateY(-50%);width:28px;height:28px;min-width:28px;min-height:28px;padding:0;border:1px solid #a45b5b;border-radius:8px;background:#fff;color:#a32121;font-size:21px;font-weight:900;line-height:24px;cursor:pointer}
</style>
<script id="mg-engineer-pins-v274">
(function(){
'use strict';
var KEY='miladgeo_engineer_pins_v267';
function read(){try{var x=JSON.parse(localStorage.getItem(KEY)||'[]');return Array.isArray(x)?x:[]}catch(e){return[]}}
function write(a){try{localStorage.setItem(KEY,JSON.stringify(a))}catch(e){}}
function titleOf(card){var b=card.querySelector('b');if(!b)return 'دفتر مهندس';var t=(b.innerText||b.textContent||'').replace(/^[\s\d۰-۹۱-۹.]+/,'').trim();return t||'ابزار دفتر مهندس'}
function keyOf(card){var a=card.getAttribute('onclick')||'';var m=a.match(/m20Open\(['"]([^'"]+)['"]\)/);return m?m[1]:''}
function stack(){
 var slot=document.getElementById('mgMusicDockSlot');if(!slot)return null;
 var box=document.getElementById('mgPinnedEngineerStack');
 if(!box){box=document.createElement('div');box.id='mgPinnedEngineerStack';box.setAttribute('aria-label','ابزارهای سنجاق‌شده دفتر مهندس');slot.appendChild(box);}
 return box;
}
function render(){
 var box=stack();if(!box)return;box.innerHTML='';
 read().forEach(function(it){
  var b=document.createElement('div');b.className='mg-engineer-shortcut';b.setAttribute('role','button');b.tabIndex=0;
  var name=document.createElement('span');name.textContent='✍️ '+it.title;
  var hint=document.createElement('small');hint.textContent='دفتر مهندس · بازکردن';
  var remove=document.createElement('button');remove.type='button';remove.className='mg-engineer-unpin';remove.textContent='×';remove.title='برداشتن سنجاق';remove.setAttribute('aria-label','برداشتن سنجاق '+it.title);
  remove.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();write(read().filter(function(x){return x.key!==it.key;}));render();});
  function open(){if(typeof window.goPage==='function')window.goPage('menu20');setTimeout(function(){if(typeof window.m20Open==='function')window.m20Open(it.key)},80);}
  b.append(name,hint,remove);b.addEventListener('click',function(e){if(e.target!==remove)open();});b.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();open();}});
  box.appendChild(b);
 });
}
function setup(){
 var changed=false;
 var cards=document.querySelectorAll('#menu20 .m20-grid .m20-card');
 cards.forEach(function(card){
  var key=keyOf(card);if(!key)return;
  if(card.querySelector('.mg-engineer-pin'))return;
  var b=document.createElement('button');b.type='button';b.className='mg-engineer-pin';b.title='سنجاق به منوی اصلی';b.setAttribute('aria-label','سنجاق '+titleOf(card));b.textContent='＋';
  b.addEventListener('click',function(e){
   e.preventDefault();e.stopPropagation();
   var a=read(),idx=a.findIndex(function(x){return x.key===key});
   if(idx>=0){a.splice(idx,1);b.classList.remove('active');b.textContent='＋';b.title='سنجاق به منوی اصلی';}
   else{a.push({key:key,title:titleOf(card)});b.classList.add('active');b.textContent='📌';b.title='برداشتن سنجاق';}
   write(a);render();
  });
  var pinned=read().some(function(x){return x.key===key});
  if(pinned){b.classList.add('active');b.textContent='📌';b.title='برداشتن سنجاق';}
  card.appendChild(b);changed=true;
 });
 if(changed)render();
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',setup);else setup();
var obs=new MutationObserver(function(){var menu=document.getElementById('menu20');if(menu&&menu.querySelector('.m20-grid .m20-card:not(:has(.mg-engineer-pin))'))setup();});
obs.observe(document.documentElement,{childList:true,subtree:true});
window.addEventListener('pageshow',function(){setup();render();});
setTimeout(function(){setup();render();},0);
})();
</script>
<!-- V281: Menu 10 submenu pins. Added only at the real document end. -->
<style id="mg-menu10-pins-v281">
#mgMusicDockSlot:has(#mgPinnedMenu10Stack){display:block!important}
#cadpdf .m10-new-cards .m10-new-card{position:relative;padding-left:48px!important}
#cadpdf .m10-new-cards .mg-m10-pin{position:absolute!important;left:8px!important;top:50%!important;transform:translateY(-50%)!important;z-index:6!important;width:20px!important;height:20px!important;min-width:20px!important;min-height:20px!important;padding:0!important;margin:0!important;border-radius:6px!important;border:1px solid #6b9c79!important;background:#ffffffed!important;color:#173d27!important;font:900 11px Tahoma,Arial,sans-serif!important;display:grid!important;place-items:center!important;box-shadow:0 1px 4px #0002!important;box-sizing:border-box!important;cursor:pointer!important}
#cadpdf .m10-new-cards .mg-m10-pin.active{background:#d7f3d8!important;border-color:#19854a!important;color:#087a38!important}
#mgPinnedMenu10Stack{display:flex;flex-direction:column;gap:7px;margin:0!important;direction:rtl}
#mgPinnedMenu10Stack .mg-m10-shortcut{position:relative;width:100%;min-height:50px;box-sizing:border-box;border:2px solid #699b70;border-radius:13px;background:linear-gradient(110deg,#edf8ed,#d6ecd8);color:#183d27;font:900 14px Tahoma,Arial,sans-serif;padding:10px 13px 10px 48px;text-align:right;display:flex;align-items:center;justify-content:space-between;gap:8px;cursor:pointer}
#mgPinnedMenu10Stack .mg-m10-shortcut small{font-size:10px;font-weight:700;opacity:.72}
#mgPinnedMenu10Stack .mg-m10-unpin{position:absolute;left:8px;top:50%;transform:translateY(-50%);width:28px;height:28px;min-width:28px;min-height:28px;padding:0;border:1px solid #a45b5b;border-radius:8px;background:#fff;color:#a32121;font-size:21px;font-weight:900;line-height:24px;cursor:pointer}
</style>
<script id="mg-menu10-pins-v281">
(function(){
 'use strict';
 var KEY='miladgeo_menu10_submenu_pins_v281';
 var items=[
  {id:'m10-0',title:'DXF به PDF',index:0},
  {id:'m10-1',title:'PDF خوان',index:1},
  {id:'m10-2',title:'DXF خوان',index:2},
  {id:'m10-3',title:'Word خوان',index:3},
  {id:'m10-4',title:'Excel خوان',index:4}
 ];
 function read(){try{var a=JSON.parse(localStorage.getItem(KEY)||'[]');return Array.isArray(a)?a.filter(function(id,i){return items.some(function(x){return x.id===id})&&a.indexOf(id)===i;}):[];}catch(e){return[];}}
 function write(a){try{localStorage.setItem(KEY,JSON.stringify(a));}catch(e){}}
 function cards(){return document.querySelectorAll('#cadpdf .m10-new-cards .m10-new-card');}
 function slot(){return document.getElementById('mgMusicDockSlot');}
 function stack(){var host=slot();if(!host)return null;var box=document.getElementById('mgPinnedMenu10Stack');if(!box){box=document.createElement('div');box.id='mgPinnedMenu10Stack';box.setAttribute('aria-label','زیرمنوهای سنجاق‌شده منوی ۱۰');host.appendChild(box);}return box;}
 function targetFor(item){var card=cards()[item.index];var onclick=card&&card.getAttribute('onclick')||'';var match=onclick.match(/m10Scroll\(['\"]([^'\"]+)['\"]\)/);return match?match[1]:'';}
 function openItem(item){var target=targetFor(item);if(typeof window.goPage==='function')window.goPage('cadpdf');setTimeout(function(){if(target&&typeof window.m10Scroll==='function')window.m10Scroll(target);else if(target&&typeof window.scrollToId==='function')window.scrollToId(target);},120);}
 function render(){var box=stack();if(!box)return;box.innerHTML='';read().forEach(function(id){var item=items.find(function(x){return x.id===id;});if(!item)return;var row=document.createElement('div');row.className='mg-m10-shortcut';row.setAttribute('role','button');row.tabIndex=0;var name=document.createElement('span');name.textContent='📁 '+item.title;var hint=document.createElement('small');hint.textContent='منوی ۱۰ · بازکردن';var remove=document.createElement('button');remove.type='button';remove.className='mg-m10-unpin';remove.textContent='×';remove.title='برداشتن سنجاق';remove.setAttribute('aria-label','برداشتن سنجاق '+item.title);remove.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();write(read().filter(function(v){return v!==id;}));render();refresh();});row.append(name,hint,remove);row.addEventListener('click',function(e){if(e.target!==remove)openItem(item);});row.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();openItem(item);}});box.appendChild(row);});}
 function refresh(){var list=cards();list.forEach(function(card,index){var item=items[index];if(!item)return;var pin=card.querySelector('.mg-m10-pin');if(!pin){pin=document.createElement('span');pin.className='mg-m10-pin';pin.setAttribute('role','button');pin.tabIndex=0;pin.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();toggle(item);});pin.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();e.stopPropagation();toggle(item);}});card.appendChild(pin);}var active=read().indexOf(item.id)>=0;pin.classList.toggle('active',active);pin.textContent=active?'📌':'＋';pin.title=active?'برداشتن سنجاق':'سنجاق به منوی اصلی';pin.setAttribute('aria-label',pin.title+' '+item.title);});}
 function toggle(item){var a=read(),i=a.indexOf(item.id);if(i>=0)a.splice(i,1);else a.push(item.id);write(a);render();refresh();}
 function start(){refresh();render();window.addEventListener('pageshow',function(){refresh();render();});window.addEventListener('storage',function(e){if(e.key===KEY){refresh();render();}});}
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>
<script id="mg-project-address-launch-v286">
(function(){
 'use strict';
 var REQ='miladgeo_project_address_request';
 function notify(msg){if(typeof window.showToast==='function')window.showToast(msg);else alert(msg)}
 function launch(button){
  var body=document.getElementById('m20Body');
  if(!body||!body.querySelector('[data-p="name"]')){notify('ابتدا یک پرونده پروژه را باز کن.');return}
  var pid=body.getAttribute('data-project-id');
  if(!pid){notify('شناسه پرونده پیدا نشد؛ پرونده را دوباره باز کن.');return}
  var saveButton=document.getElementById('pm103save');
  if(saveButton)saveButton.click();
  try{localStorage.setItem(REQ,JSON.stringify({projectId:String(pid),mode:'pick',createdAt:Date.now()}))}
  catch(err){notify('ثبت درخواست انتخاب آدرس در حافظه گوشی ناموفق بود.');return}
  button.disabled=true;var oldText=button.textContent;button.textContent='در حال باز کردن نقشه…';
  try{
   if(typeof window.goPage==='function')window.goPage('menu17');
   else if(typeof window.showPage==='function')window.showPage('menu17');
   else throw new Error('navigation unavailable');
   setTimeout(function(){
    var map=document.getElementById('m17Map');
    if(!map){button.disabled=false;button.textContent=oldText;localStorage.removeItem(REQ);notify('نقشه منوی ۱۷ بارگذاری نشد.');return}
    if(typeof window.m17Init==='function')window.m17Init();
    if(typeof window.setDrawMode==='function')window.setDrawMode(null);
    notify('روی نقطه دلخواه در نقشه بزن؛ سپس دکمه سبز ثبت آدرس را انتخاب کن.');
   },350);
  }catch(err){button.disabled=false;button.textContent=oldText;localStorage.removeItem(REQ);notify('باز کردن نقشه ناموفق بود.')}
 }
 document.addEventListener('click',function(e){
  var button=e.target&&e.target.closest&&e.target.closest('#pm103m17');if(!button)return;
  e.preventDefault();e.stopPropagation();if(e.stopImmediatePropagation)e.stopImmediatePropagation();launch(button);
 },true);
})();
</script>
<!-- MILADGEO V12 IMAGE FIX: tutorial artwork embedded as offline data URIs -->
<style id="mg-v12-inline-tutorial-image-fix">#mgV11WelcomeHero img,.mg-v11-lesson img{object-fit:cover;background:#dce8d8}</style>
<!-- MILADGEO V12: tutorial moved into main MENU; lesson cards scroll to their detail -->
<div aria-label="خوش‌آمدگویی و آموزش میلادژئو" aria-modal="true" id="mgV11WelcomeOverlay" role="dialog">
<section id="mgV11WelcomePanel">
<button id="mgV11WelcomeClose" type="button" aria-label="بستن پنجره خوش‌آمدگویی" title="بستن">×</button>
<div id="mgV11WelcomeHero">
<img alt="نقشه‌بردار در حال کار با توتال‌استیشن در پروژه عمرانی" loading="eager" src="data:image/jpeg;base64,"/>
<div id="mgV11WelcomeBrand"><b>MILADGEO</b><span>همراه هوشمند مهندسی و نقشه‌برداری</span></div>
</div>
<div id="mgV11WelcomeBody">
<h2>به میلادژئو خوش آمدی 👋</h2>
<p class="mg-intro">آموزش‌ها دقیقاً بر اساس ترتیب منوهای میلادژئو چیده شده‌اند. منوهای ۱ تا ۲۰ در همین ترتیب قرار دارند و سه کارت پایانی نیز بخش استخدام، بازار تجهیزات و قیمت مصالح را آموزش می‌دهند. هر کارت را لمس کن تا راهنمای کامل همان بخش، مراحل کار، نکات مهندسی و تمرین آن نمایش داده شود.</p>
<div id="mgV11LessonGrid">
<button class="mg-v11-lesson" data-lesson="0" type="button"><img alt="۱. شبیه‌ساز لایکا، ایستگاه، توجیه، برداشت و پیاده‌سازی" loading="lazy" src="data:image/jpeg;base64,"/><span><b>۱. شبیه‌ساز لایکا</b><small>ایستگاه، توجیه، برداشت و پیاده‌سازی</small></span></button>
