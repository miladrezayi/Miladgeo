 if(asksIranUsd){var usdFound=false;try{await getIranMarket();usdFound=showIranItem('USD_IRR_FREE','💵 دلار بازار آزاد ایران','تومان');}catch(e){}if(!usdFound)errs.push('قیمت دلار بازار آزاد ایران دریافت نشد؛ نرخ تبدیل ارز جایگزین آن نمی‌شود.');}
 if(wantsFx&&!asksIranUsd){try{var fx=await mgV974Json('https://open.er-api.com/v6/latest/USD',9000);if(fx&&fx.result==='success'&&fx.rates){var r=fx.rates;out.push('💱 نرخ مرجع تبدیل ارز (نه بازار آزاد ایران):');['EUR','GBP','JPY','CHF','CAD'].forEach(function(c){if(r[c]!=null)out.push('• '+c+': '+mgV974Num(r[c],4));});out.push('منبع: open.er-api.com | به‌روزرسانی: '+(fx.time_last_update_utc||'اعلام نشده'));got=true;}}catch(e){errs.push('نرخ مرجع ارز در دسترس نبود.');}}
 if(wantsCrypto){try{var ids=[],map=[['bitcoin',/بیت.?کوین|bitcoin|\bbtc\b/i],['ethereum',/اتریوم|ethereum|\beth\b/i],['solana',/سولانا/i],['ripple',/ریپل/i],['dogecoin',/دوج.?کوین/i],['tether',/تتر/i],['tron',/ترون/i],['cardano',/کاردانو/i],['binancecoin',/بایننس کوین/i],['shiba-inu',/شیبا/i],['polkadot',/پولکادات/i],['litecoin',/لایت.?کوین/i]];map.forEach(function(x){if(x[1].test(q))ids.push(x[0]);});if(!ids.length)ids=['bitcoin','ethereum'];var cj=await mgV974Json('https://api.coingecko.com/api/v3/simple/price?ids='+encodeURIComponent(ids.join(','))+'&vs_currencies=usd,irr&include_24hr_change=true',10000);ids.forEach(function(id){var v=cj&&cj[id];if(v&&v.usd>0){out.push('🪙 '+id+': $'+mgV974Num(v.usd,4)+(v.irr?' | '+mgV974Num(v.irr,0)+' ریال':'')+(v.usd_24h_change!=null?' | تغییر ۲۴ساعته '+mgV974Num(v.usd_24h_change,2)+'٪':''));got=true;}});if(!got)errs.push('قیمت رمزارز دریافت نشد.');}catch(e){errs.push('قیمت رمزارز از منبع آنلاین دریافت نشد.');}}
