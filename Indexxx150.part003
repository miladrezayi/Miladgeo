    {terms:['esri','arcgis','آرک جی آی اس','آرک‌جی‌آی‌اس','دستیار arcgis','هوش مصنوعی gis'],title:'🗺️ Esri ArcGIS Docs Assistant',desc:'دستیار هوشمند مستندات ArcGIS',aiUrl:'https://doc.esri.com/en/arcgis-online/latest/reference/doc-assistant.html'},
