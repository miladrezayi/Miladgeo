|'مختصات معتبر پیدا نشد.');}}throw new Error('برای مختصات UTM، زون و نیم‌کره لازم است.');}throw new Error('ستون‌های مختصات پیدا نشد؛ سرستون‌های طول/عرض یا شرق/شمال را بررسی کن.');}var header=cols.start?rows[0].map(function(x){return x==null?'':String(x)}):rows[0].map(function(_,i){return 'Column_'+(i+1)});var normalized=rows.map(function(r){return r.map(function(v){return v==null?'':v})});
 if(binary){var txt=normalized.map(function(r){return r.map(function(v){return String(v==null?'':v).replace(/[\t\r\n]/g,' ')}).join('\t')}).join('\r\n')+'\r\n';add('موتور تبدیل فایل اجرا شد: '+file.name+'؛ '+rows.length+' ردیف خوانده شد. خروجی متنی با حفظ ترتیب ستون‌ها آماده است.','bot');addDownload('دریافت فایل TXT',new Blob(['\uFEFF'+txt],{type:'text/plain;charset=utf-8'}),file.name.replace(/\.(xlsx|xls)$/i,'')+'_converted.txt');
 }else{var xlsx=makeXlsx(normalized),baseName=file.name.replace(/\.(csv|tsv|txt|dat|xyz|asc|prn|log)$/i,'');add('موتور تبدیل فایل اجرا شد: '+file.name+'؛ '+rows.length+' ردیف خوانده شد. خروجی اکسل آماده است'+(xlsx.legacy?' (حالت سازگار آفلاین)':'')+'.','bot');addDownload('دریافت فایل اکسل',new Blob([xlsx.data],{type:xlsx.legacy?'application/vnd.ms-excel':'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}),baseName+(xlsx.legacy?'_converted.xls':'_converted.xlsx'));}
 var geographic=cols.lat>=0&&cols.lon>=0,projected=cols.e>=0&&cols.n>=0;if(geographic){var result=kmlFromRows(rows,cols,null,'N');if(result.count){add('مختصات طول/عرض جغرافیایی از سرستون‌ها تشخیص داده شد؛ فایل KML هم آماده است ('+result.count+' نقطه).','bot');addDownload('دریافت فایل KML',new Blob([result.text],{type:'application/vnd.google-earth.kml+xml;charset=utf-8'}),file.name.replace(/\.[^.]+$/,'')+'_converted.kml');}}
 else if(projected){add('ستون‌های شرقی/شمالی تشخیص داده شد، اما برای تبدیل درست به KML باید زون UTM و نیم‌کره مشخص باشد. مختصات را حدس نمی‌زنم.','bot');var zone=prompt('برای ساخت KML از مختصات UTM، زون را از 1 تا 60 وارد کن. اگر زون را نمی‌دانی، لغو را بزن؛ فایل TXT تبدیل‌شده آماده است.','');if(zone!==null&&/^([1-9]|[1-5][0-9]|60)$/.test(zone.trim())){var hemi=prompt('نیم‌کره مختصات UTM؟ N برای شمالی یا S برای جنوبی','N');if(hemi!==null&&/^[NS]$/i.test(hemi.trim())){var kr=kmlFromRows(rows,cols,Number(zone.trim()),hemi.trim().toUpperCase());if(kr.count){add('KML ساخته شد با زون UTM '+zone.trim()+' و نیم‌کره '+hemi.trim().toUpperCase()+'. لطفاً زون و نیم‌کره را با منبع نقشه‌برداری خودت کنترل کن. تعداد نقطه: '+kr.count+(kr.bad?'؛ ردیف ردشده: '+kr.bad:''),'bot');addDownload('دریافت فایل KML',new Blob([kr.text],{type:'application/vnd.google-earth.kml+xml;charset=utf-8'}),file.name.replace(/\.[^.]+$/,'')+'_UTM'+zone.trim()+hemi.trim().toUpperCase()+'.kml');}else add(kr.text,'bot');}}}
 }catch(err){console.error('MILADGEO_CONVERTER',err);add('تبدیل فایل ناموفق بود: '+(err&&err.message?err.message:'خطای نامشخص')+'. فایل اصلی تغییر نکرده است.','bot');}};if(binary)reader.readAsArrayBuffer(file);else reader.readAsText(file);fileInput.value='';});
}document.getElementById('miladBotChatClose').addEventListener('click',function(){panel.classList.remove('open')});
function mgSurveyCalc(raw){
 var original=String(raw||'');var s=original.replace(/[۰-۹]/g,function(c){return String('۰۱۲۳۴۵۶۷۸۹'.indexOf(c))}).replace(/[٠-٩]/g,function(c){return String('٠١٢٣٤٥٦٧٨٩'.indexOf(c))}).replace(/[٫]/g,'.').replace(/[٬،]/g,',').replace(/[−–—]/g,'-').replace(/\s+/g,' ').trim();
 var low=s.toLowerCase();function has(re){return re.test(low)}function fmt(n,d){return Number(n).toLocaleString('en-US',{maximumFractionDigits:d==null?4:d,minimumFractionDigits:0});}
 function out(title,body){return {title:title,text:'📐 '+title+'\n'+body};}
 // Unit conversion: lengths, areas, angles, volume, mass.
 var unitMap={m:{k:1,g:'length',n:'متر'},meter:{k:1,g:'length',n:'متر'},متر:{k:1,g:'length',n:'متر'},مترمربع:{k:1,g:'area',n:'مترمربع'},m2:{k:1,g:'area',n:'مترمربع'},مترمربع:{k:1,g:'area',n:'مترمربع'},km:{k:1000,g:'length',n:'کیلومتر'},کیلومتر:{k:1000,g:'length',n:'کیلومتر'},cm:{k:.01,g:'length',n:'سانتی‌متر'},سانتیمتر:{k:.01,g:'length',n:'سانتی‌متر'},mm:{k:.001,g:'length',n:'میلی‌متر'},میلیمتر:{k:.001,g:'length',n:'میلی‌متر'},ft:{k:.3048,g:'length',n:'فوت'},فوت:{k:.3048,g:'length',n:'فوت'},in:{k:.0254,g:'length',n:'اینچ'},inch:{k:.0254,g:'length',n:'اینچ'},mile:{k:1609.344,g:'length',n:'مایل'},مایل:{k:1609.344,g:'length',n:'مایل'},ha:{k:10000,g:'area',n:'هکتار'},هکتار:{k:10000,g:'area',n:'هکتار'},acre:{k:4046.8564224,g:'area',n:'acre'},جریب:{k:1000,g:'area',n:'جریب (با فرض ۱۰۰۰ مترمربع؛ واحد محلی متغیر است)'},km2:{k:1000000,g:'area',n:'کیلومترمربع'},کیلومترمربع:{k:1000000,g:'area',n:'کیلومترمربع'},deg:{k:1,g:'angle',n:'درجه'},درجه:{k:1,g:'angle',n:'درجه'},rad:{k:180/Math.PI,g:'angle',n:'رادیان'},رادیان:{k:180/Math.PI,g:'angle',n:'رادیان'},gon:{k:.9,g:'angle',n:'گون'},گراد:{k:.9,g:'angle',n:'گون'},l:{k:.001,g:'volume',n:'لیتر'},لیتر:{k:.001,g:'volume',n:'لیتر'},m3:{k:1,g:'volume',n:'مترمکعب'},مترمکعب:{k:1,g:'volume',n:'مترمکعب'},kg:{k:1,g:'mass',n:'کیلوگرم'},کیلوگرم:{k:1,g:'mass',n:'کیلوگرم'},g:{k:.001,g:'mass',n:'گرم'},گرم:{k:.001,g:'mass',n:'گرم'}};
 if(has(/تبدیل|چند\s*(?:متر|سانت|کیلومتر|هکتار|فوت|درجه|رادیان)|convert/)&&/\d/.test(s)){var um=s.match(/(-?\d+(?:\.\d+)?)\s*([a-zA-Z0-9²^\u0600-\u06FF]+)\s*(?:به|را\s*به|to)\s*([a-zA-Z0-9²^\u0600-\u06FF]+)/i);if(um){var un1=um[2].toLowerCase().replace(/[\s²^]/g,''),un2=um[3].toLowerCase().replace(/[\s²^]/g,'');if(un1==='مترمربع'||un1==='مترمربع')un1='مترمربع';if(un2==='مترمربع')un2='مترمربع';var u1=unitMap[un1],u2=unitMap[un2];if(u1&&u2){if(u1.g!==u2.g)return out('تبدیل واحد','این دو واحد از یک کمیت نیستند؛ تبدیل انجام نشد.');var val=Number(um[1])*u1.k/u2.k;return out('تبدیل واحد',fmt(Number(um[1]),6)+' '+u1.n+' = '+fmt(val,8)+' '+u2.n+'\nضریب تبدیل بر اساس واحدهای استاندارد اعمال شد.');}}}
 // Parse coordinate pairs: (X,Y), X=...,Y=... is not inferred; pair list must be explicit.
 var pairs=[],pairRe=/\(?\s*(-?\d+(?:\.\d+)?)\s*[;|/]\s*(-?\d+(?:\.\d+)?)\s*\)?|\(\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*\)/g,m;
 // Prefer parenthesized comma pairs, then semicolon/slash pairs. Avoid treating thousands of other numbers as coords.
 var reParen=/\(\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*\)/g;while((m=reParen.exec(s))!==null)pairs.push({x:Number(m[1]),y:Number(m[2])});
 if(pairs.length<2){pairs=[];var reSemi=/(-?\d+(?:\.\d+)?)\s*[;|/]\s*(-?\d+(?:\.\d+)?)/g;while((m=reSemi.exec(s))!==null)pairs.push({x:Number(m[1]),y:Number(m[2])});}
 var mentionsArea=has(/مساحت|متراژ|پلیگون|چند\s*متر\s*مربع|area/),mentionsAz=has(/آزیموت|azimuth|سمت\s*شبکه/),mentionsDist=has(/فاصله|طول\s*(?:خط|ضلع)?|distance|length/),mentionsCoord=has(/مختصات|مختصات\s*نقطه|coordinate/);
 // Accept two plain comma-separated coordinate pairs when the user explicitly labels first and second points.
 if(mentionsDist && pairs.length<2 && has(/(?:نقطه\s*)?اول/) && has(/(?:نقطه\s*)?دوم/)){var plainPairs=[...s.matchAll(/(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)/g)];if(plainPairs.length>=2){pairs=[{x:Number(plainPairs[0][1]),y:Number(plainPairs[0][2])},{x:Number(plainPairs[1][1]),y:Number(plainPairs[1][2])}];}}
 if(mentionsArea&&pairs.length>=3){var twice=0,per=0,rows=[];for(var i=0;i<pairs.length;i++){var j=(i+1)%pairs.length,dx=pairs[j].x-pairs[i].x,dy=pairs[j].y-pairs[i].y;twice+=pairs[i].x*pairs[j].y-pairs[j].x*pairs[i].y;var len=Math.hypot(dx,dy),az=(Math.atan2(dx,dy)*180/Math.PI+360)%360;per+=len;rows.push('ضلع '+(i+1)+': طول '+fmt(len,4)+' متر، آزیموت '+fmt(az,5)+'°');}var area=Math.abs(twice)/2;if(area<=0)return out('محاسبه مساحت','مساحت صفر یا نامعتبر است؛ ترتیب و مختصات نقاط را بررسی کن.');return out('مساحت پلیگون','تعداد رأس‌ها: '+pairs.length+'\nمساحت افقی: '+fmt(area,4)+' مترمربع\nهکتار: '+fmt(area/10000,6)+'\nمحیط: '+fmt(per,4)+' متر\n\n'+rows.join('\n')+'\n\nفرض: مختصات صفحه‌ای متری (E/X, N/Y) و اضلاع مستقیم هستند.');}
 if((mentionsDist||mentionsAz)&&pairs.length>=2){var a=pairs[0],b=pairs[1],dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy),az=(Math.atan2(dx,dy)*180/Math.PI+360)%360;if(d===0)return out('فاصله و آزیموت','دو نقطه یکسان هستند؛ آزیموت تعریف نمی‌شود.');return out('فاصله و آزیموت','نقطه A: X='+fmt(a.x,4)+', Y='+fmt(a.y,4)+'\nنقطه B: X='+fmt(b.x,4)+', Y='+fmt(b.y,4)+'\nΔX / ΔE: '+fmt(dx,4)+' متر\nΔY / ΔN: '+fmt(dy,4)+' متر\nفاصله افقی: '+fmt(d,4)+' متر\nآزیموت از شمال، ساعت‌گرد: '+fmt(az,6)+'°\nزاویه ربعی: '+fmt(Math.atan2(Math.abs(dx),Math.abs(dy))*180/Math.PI,5)+'°');}
 // Forward coordinate from start + distance + azimuth (azimuth clockwise from north).
 if(has(/مختصات|نقطه\s*جدید|پیدا\s*کن|محاسبه\s*نقطه/)&&has(/آزیموت|azimuth/)&&has(/فاصله|طول\s*خط|distance/)){var nums=(s.match(/-?\d+(?:\.\d+)?/g)||[]).map(Number);if(nums.length>=4){var x0=nums[0],y0=nums[1],dist=nums[2],az0=nums[3];if(dist>=0){var rr=az0*Math.PI/180;return out('مختصات نقطه جدید','مختصات شروع: X='+fmt(x0,4)+', Y='+fmt(y0,4)+'\nفاصله: '+fmt(dist,4)+' متر\nآزیموت: '+fmt((az0%360+360)%360,5)+'°\nΔX = d × sin(Az) = '+fmt(dist*Math.sin(rr),4)+' متر\nΔY = d × cos(Az) = '+fmt(dist*Math.cos(rr),4)+' متر\nمختصات مقصد: X='+fmt(x0+dist*Math.sin(rr),4)+', Y='+fmt(y0+dist*Math.cos(rr),4)+'\nفرض: آزیموت از شمال و در جهت ساعت‌گرد است.');}}}
 // UTM -> geographic conversion, explicit zone and hemisphere required.
 if(has(/utm/)&&has(/جغرافیایی|طول\s*و\s*عرض|lat|lon|درجه/)&&has(/زون|zone/)){var utmnums=(s.match(/-?\d+(?:\.\d+)?/g)||[]).map(Number);var zmatch=s.match(/(?:زون|zone)\s*(\d{1,2})/i);if(utmnums.length>=3&&zmatch){var zone=Number(zmatch[1]),east=utmnums[0],north=utmnums[1],northHem=!has(/نیمکره\s*جنوب|south|\bS\b/);if(zone<1||zone>60)return out('تبدیل مختصات','زون UTM باید بین ۱ تا ۶۰ باشد.');if(typeof utmToLatLon==='function'){var ll=utmToLatLon(east,north,zone,northHem);return out('تبدیل UTM به جغرافیایی','Easting: '+fmt(east,3)+' m\nNorthing: '+fmt(north,3)+' m\nزون: '+zone+' '+(northHem?'N (شمالی)':'S (جنوبی)')+'\nعرض جغرافیایی: '+fmt(ll.lat,8)+'°\nطول جغرافیایی: '+fmt(ll.lon,8)+'°\n\nبررسی کن دیتوم مختصات WGS84 باشد.');}}}
 // Geographic -> UTM, self-contained WGS84 Transverse Mercator.
 if(has(/تبدیل|مختصات/)&&has(/جغرافیایی|عرض|طول|lat|lon/)&&has(/utm|یو.?تی.?ام/)){var nums2=(s.match(/-?\d+(?:\.\d+)?/g)||[]).map(Number);if(nums2.length>=2){var lat=nums2[0],lon=nums2[1];if(Math.abs(lat)<=80&&Math.abs(lon)<=180){var aW=6378137,e2=.00669437999014,k=.9996,zone2=Math.floor((lon+180)/6)+1,lon0=((zone2-1)*6-180+3)*Math.PI/180,ph=lat*Math.PI/180,la=lon*Math.PI/180,ep=e2/(1-e2),N=aW/Math.sqrt(1-e2*Math.sin(ph)*Math.sin(ph)),T=Math.tan(ph)**2,C=ep*Math.cos(ph)**2,A=Math.cos(ph)*(la-lon0),M=aW*((1-e2/4-3*e2*e2/64-5*e2**3/256)*ph-(3*e2/8+3*e2*e2/32+45*e2**3/1024)*Math.sin(2*ph)+(15*e2*e2/256+45*e2**3/1024)*Math.sin(4*ph)-(35*e2**3/3072)*Math.sin(6*ph));var E=500000+k*N*(A+(1-T+C)*A**3/6+(5-18*T+T*T+72*C-58*ep)*A**5/120),NN=k*(M+N*Math.tan(ph)*(A*A/2+(5-T+9*C+4*C*C)*A**4/24+(61-58*T+T*T+600*C-330*ep)*A**6/720));if(lat<0)NN+=10000000;return out('تبدیل جغرافیایی به UTM','عرض: '+fmt(lat,8)+'°\nطول: '+fmt(lon,8)+'°\nEasting (X): '+fmt(E,3)+' m\nNorthing (Y): '+fmt(NN,3)+' m\nزون: '+zone2+' '+(lat>=0?'N':'S')+'\nدیتوم: WGS84');}}}
 // Advanced deterministic surveying calculations added in BUILD 930; BUILD 183 adds leveling quality evaluation.
 // Decimal degrees <-> DMS, slope/grade, slope distance, and Bowditch traverse adjustment.
 if(has(/(?:درجه\s*دقیقه\s*ثانیه|dms|درجهٔ?\s*اعشاری|درجه اعشاری)/)&&/\d/.test(s)){
   var dms=s.match(/(-?\d+(?:\.\d+)?)\s*(?:درجه|°|deg)\s*(\d+(?:\.\d+)?)?\s*(?:دقیقه|['′]|min)?\s*(\d+(?:\.\d+)?)?\s*(?:ثانیه|["″]|sec)?/i);
   if(dms){var deg=Number(dms[1]),mins=Number(dms[2]||0),secs=Number(dms[3]||0);if(mins>=60||secs>=60)return out('تبدیل زاویه','دقیقه و ثانیه باید کمتر از ۶۰ باشند.');var dec=Math.sign(deg||1)*(Math.abs(deg)+mins/60+secs/3600);if(has(/به درجه\s*اعشاری|درجه اعشاری|تبدیل.*اعشاری/))return out('تبدیل DMS به درجه اعشاری',fmt(dec,10)+'°\nفرمول: درجه + دقیقه÷۶۰ + ثانیه÷۳۶۰۰.');if(has(/به dms|به درجه\s*دقیقه|تبدیل.*dms/)){var ad=Math.abs(dec),dd=Math.floor(ad),mmf=(ad-dd)*60,mm=Math.floor(mmf),ss=(mmf-mm)*60;return out('تبدیل درجه اعشاری به DMS',(dec<0?'-':'')+dd+'° '+mm+'′ '+fmt(ss,4)+'″');}}
 }
 // Slope / grade from horizontal distance and height difference.
 if(has(/شیب|درصد.*ارتفاع|درصد.*فاصله|grade|slope/)&&has(/فاصله|ارتفاع|اختلاف تراز|افقی/)){
   var vals=(s.match(/-?\d+(?:\.\d+)?/g)||[]).map(Number);
   if(vals.length>=2){var horiz=vals[0],dh=vals[1];if(has(/فاصله مایل|شیب.*فاصله مایل/)&&vals.length>=2){/* values are still interpreted as horizontal distance and vertical difference unless explicitly stated otherwise */}
    if(horiz>0){var hyp=Math.hypot(horiz,dh),ang=Math.atan2(dh,horiz)*180/Math.PI;return out('محاسبه شیب و اختلاف ارتفاع','فاصله افقی: '+fmt(horiz,4)+' متر\nاختلاف ارتفاع (علامت‌دار): '+fmt(dh,4)+' متر\nشیب درصدی: '+fmt(100*dh/horiz,5)+'٪\nزاویه شیب: '+fmt(ang,6)+'°\nفاصله مایل متناظر: '+fmt(hyp,4)+' متر\nفرض: عدد اول فاصله افقی و عدد دوم اختلاف ارتفاع است.');}
    return out('محاسبه شیب','فاصله افقی باید بزرگ‌تر از صفر باشد.');}
 }
 // Slope distance + vertical angle -> horizontal distance and height difference.
 if(has(/فاصله مایل/)&&has(/زاویه|درجه|شیب/)&&has(/افقی|محاسبه|پیدا/)){
   var sv=(s.match(/-?\d+(?:\.\d+)?/g)||[]).map(Number);if(sv.length>=2){var sd=sv[0],va=sv[1];if(sd<0||Math.abs(va)>=90)return out('فاصله مایل','فاصله باید نامنفی و قدرمطلق زاویه قائم کمتر از ۹۰ درجه باشد.');return out('تبدیل فاصله مایل به افقی','فاصله مایل: '+fmt(sd,4)+' متر\nزاویه قائم نسبت به افق: '+fmt(va,5)+'°\nفاصله افقی = S × cos(v): '+fmt(sd*Math.cos(va*Math.PI/180),4)+' متر\nاختلاف ارتفاع = S × sin(v): '+fmt(sd*Math.sin(va*Math.PI/180),4)+' متر');}}
 // Bowditch (compass rule) adjustment. Input pairs are successive observed ΔE,ΔN vectors, e.g. (100,0),(0,100),(-99,-100).
 if(has(/بوودچ|bowditch|سرشکنی\s*(?:پیمایش|تراورس)|تعدیل\s*(?:پیمایش|تراورس)/)){
   var vecs=pairs.slice();var origin={x:0,y:0};var om=s.match(/(?:مبدأ|مبدا|شروع)\s*\(\s*(-?\d+(?:\.\d+)?)\s*[,;|/]\s*(-?\d+(?:\.\d+)?)\s*\)/i);
   if(om){origin={x:Number(om[1]),y:Number(om[2])};vecs=vecs.filter(function(q){return !(Math.abs(q.x-origin.x)<1e-10&&Math.abs(q.y-origin.y)<1e-10)});}
   if(vecs.length<2)return out('سرشکنی بوودچ','برای هر ضلع یک زوج (ΔE,ΔN) بفرست؛ مثال:\nسرشکنی بوودچ مبدأ (500,1000): (100,0)، (0,100)، (-99,-100)\nزوج‌ها باید تغییر مختصات هر ضلع باشند، نه مختصات رأس‌ها.');
   var lengths=vecs.map(function(v){return Math.hypot(v.x,v.y)}),perim=lengths.reduce(function(a,b){return a+b},0),sumE=vecs.reduce(function(a,v){return a+v.x},0),sumN=vecs.reduce(function(a,v){return a+v.y},0),close=Math.hypot(sumE,sumN);
   if(perim<=0)return out('سرشکنی بوودچ','مجموع طول اضلاع صفر است؛ داده‌ها را بررسی کن.');
   var cx=origin.x,cy=origin.y,table=[],sumCE=0,sumCN=0;
   for(var bi=0;bi<vecs.length;bi++){var ce=-sumE*lengths[bi]/perim,cn=-sumN*lengths[bi]/perim,ae=vecs[bi].x+ce,an=vecs[bi].y+cn;sumCE+=ce;sumCN+=cn;cx+=ae;cy+=an;table.push('ضلع '+(bi+1)+': طول '+fmt(lengths[bi],4)+' m | اصلاح ΔE '+fmt(ce,5)+' | اصلاح ΔN '+fmt(cn,5)+' | مختصات مقصد E='+fmt(cx,4)+', N='+fmt(cy,4));}
   return out('سرشکنی پیمایش به روش بوودچ','تعداد اضلاع: '+vecs.length+'\nمحیط پیمایش: '+fmt(perim,4)+' متر\nخطای بست شرق (ΣΔE): '+fmt(sumE,5)+' متر\nخطای بست شمال (ΣΔN): '+fmt(sumN,5)+' متر\nخطای بست خطی: '+fmt(close,5)+' متر\nنسبت تقریبی بست: 1 : '+(close>0?fmt(perim/close,0):'بی‌نهایت (بست دقیق)')+'\n\nاصلاحات و مختصات پس از تعدیل:\n'+table.join('\n')+'\n\nروش: توزیع خطای بست متناسب با طول هر ضلع (Bowditch/Compass Rule). فرض: ΔE مثبت به شرق و ΔN مثبت به شمال؛ مشاهدات و واحدها هم‌دستگاه‌اند. کنترل میدانی و معیار دقت پروژه همچنان لازم است.');
 }
 // BUILD 938: practical surveying calculation pack — leveling and earthwork volume.
 // Level book: known RL + backsight - foresight; input is explicit to avoid guessing.
 if(has(/ترازیابی|تراز.*نقطه|ارتفاع.*نقطه|کد ارتفاعی|rl|reduced level/)&&has(/قرائت|عقب|جلو|backsight|foresight|bs|fs/)){
   var lvl=s.match(/(?:rl|ارتفاع مبنا|تراز مبنا|ارتفاع شروع|تراز شروع)\s*[:=]?\s*(-?\d+(?:\.\d+)?).*?(?:bs|قرائت عقب|عقب)\s*[:=]?\s*(-?\d+(?:\.\d+)?).*?(?:fs|قرائت جلو|جلو)\s*[:=]?\s*(-?\d+(?:\.\d+)?)/i);
   if(!lvl) lvl=s.match(/(?:ترازیابی|تراز نقطه).*?(-?\d+(?:\.\d+)?).*?(?:عقب|bs)\s*[:=]?\s*(-?\d+(?:\.\d+)?).*?(?:جلو|fs)\s*[:=]?\s*(-?\d+(?:\.\d+)?)/i);
   if(lvl){var rl0=Number(lvl[1]),bs0=Number(lvl[2]),fs0=Number(lvl[3]);return out('محاسبه تراز به روش ارتفاع دستگاه','تراز مبنا (RL): '+fmt(rl0,4)+' متر\nقرائت عقب (BS): '+fmt(bs0,4)+' متر\nارتفاع دستگاه (HI = RL + BS): '+fmt(rl0+bs0,4)+' متر\nقرائت جلو (FS): '+fmt(fs0,4)+' متر\nتراز نقطه جدید (RL = HI − FS): '+fmt(rl0+bs0-fs0,4)+' متر\nفرض: قرائت‌ها و تراز مبنا بر حسب متر هستند و هر سه مقدار به ترتیب مشخص‌شده وارد شده‌اند. برای دفتر ترازیابی چندایستگاهی باید همه قرائت‌ها و نقاط تبدیل ارائه شوند.');}
   if(has(/ترازیابی|تراز.*نقطه|ارتفاع.*نقطه|rl|reduced level/))return out('اطلاعات ترازیابی ناقص است','برای محاسبه تراز با روش ارتفاع دستگاه، سه مقدار را مشخص کن؛ مثلاً: تراز مبنا 100.000، BS 1.425، FS 2.115. فرمول: HI = RL + BS و RL جدید = HI − FS.');
 }
 // Earthwork volume by average end-area method. Syntax: حجم خاک مقطع اول 12 مترمربع، مقطع دوم 18 مترمربع، فاصله 25 متر
 if(has(/حجم|خاکبرداری|خاک.?ریزی|earthwork|volume/)&&has(/مقطع|سطح|مساحت/)&&has(/فاصله|طول بین|بین دو مقطع/)){
   var areas=[...s.matchAll(/(?:مقطع\s*(?:اول|اولی|۱|1|A|a)|مساحت\s*(?:اول|اولی|۱|1)|سطح\s*(?:اول|اولی|۱|1))\s*[:=]?\s*(-?\d+(?:\.\d+)?)/gi)];
   var areas2=[...s.matchAll(/(?:مقطع\s*(?:دوم|دومی|۲|2|B|b)|مساحت\s*(?:دوم|دومی|۲|2)|سطح\s*(?:دوم|دومی|۲|2))\s*[:=]?\s*(-?\d+(?:\.\d+)?)/gi)];
   var distm=s.match(/(?:فاصله|طول بین|بین دو مقطع)\s*[:=]?\s*(-?\d+(?:\.\d+)?)/i);
   if(areas.length&&areas2.length&&distm){var ar1=Number(areas[0][1]),ar2=Number(areas2[0][1]),ld=Number(distm[1]);if(ar1<0||ar2<0||ld<0)return out('حجم عملیات خاکی','مساحت مقطع‌ها و فاصله باید نامنفی باشند.');var vv=(ar1+ar2)*ld/2;return out('حجم خاک به روش متوسط مساحت مقطع','مساحت مقطع اول: '+fmt(ar1,4)+' مترمربع\nمساحت مقطع دوم: '+fmt(ar2,4)+' مترمربع\nفاصله بین مقاطع: '+fmt(ld,4)+' متر\nحجم = (A₁ + A₂) ÷ 2 × L\nحجم برآوردی: '+fmt(vv,4)+' مترمکعب\nروش: متوسط مساحت دو مقطع انتهایی. برای مسیرهای دارای تغییرات زیاد، مقاطع میانی و روش مناسب پروژه لازم است.');}
   return out('اطلاعات حجم خاک ناقص است','مقادیر را روشن و با واحد وارد کن؛ مثلاً: حجم خاک، مقطع اول 12 مترمربع، مقطع دوم 18 مترمربع، فاصله 25 متر.');
 }
 // Clarify instead of guessing when a surveying task lacks the required data.
 if(mentionsArea&&pairs.length<3&&has(/\d/))return out('اطلاعات مساحت ناقص است','برای محاسبه دقیق، مختصات دست‌کم ۳ رأس را به این شکل بفرست:\nمساحت نقاط (0,0)، (10,0)، (10,10)، (0,10)\nمختصات باید X,Y و در یک دستگاه مختصات صفحه‌ای و یک واحد باشند.');
 if((mentionsDist||mentionsAz)&&pairs.length<2&&has(/\d/))return out('اطلاعات مختصات ناقص است','دو نقطه را به شکل (X1,Y1) و (X2,Y2) بفرست؛ مثلاً: فاصله و آزیموت از (0,0) به (100,100). آزیموت از شمال و ساعت‌گرد گزارش می‌شود.');
 return null;
}

function mgChatModeInstruction(message){
 var m=String(message||'').replace(/[يى]/g,'ی').replace(/ك/g,'ک').toLowerCase();
 var base='قواعد همیشگی دستیار میلادژئو: در گفتگوی دوستانه گرم، خودمانی و طبیعی باش؛ اگر فضا مناسب است شوخی کوتاه و محترمانه کن و گاهی با تناسب از کاربر یک سؤال سادهٔ مهندسی بپرس، اما پشت‌سرهم سؤال نکن. به پرسش‌های عمومی درباره علم، تاریخ، فرهنگ، شهرها و کشورها هم پاسخ بده؛ دربارهٔ شهر و کشور، موقعیت جغرافیایی، پایتخت، زبان‌ها، جاذبه‌ها و ویژگی‌های شناخته‌شده را با تفکیک واقعیت از تخمین توضیح بده. برای آب‌وهوا از ابزار زنده استفاده کن یا شفاف بگو دادهٔ زنده در دسترس نیست؛ هرگز وضعیت هوا را از حافظه حدس نزن. اطلاعات کاربران مختلف را به هم نسبت نده و ادعا نکن که از گفتگوهای دیگران خودت را آموزش داده‌ای؛ فقط دادهٔ تأییدشده و مجاز را از منبع مشترک معتبر استفاده کن. اگر داده‌ای متغیر یا تازه است، تاریخ و منبع معتبر لازم دارد و در نبود منبع باید محدودیت را روشن بگویی. در پرسش‌های جغرافیایی کشورها، هرگز جایگاه قاره‌ای یا منطقه‌ای را حدس نزن: یونان در جنوب شرقی اروپا است، نه خاورمیانه؛ ترکیه کشوری میان جنوب شرقی اروپا و غرب آسیاست. اگر از پاسخ مطمئن نیستی، عدم اطمینان را روشن کن و اطلاعات نادرست نساز. برای سؤال‌های ساده‌ای مانند «ترکیه کجاست؟» یا «ترکیه چطور کشوریه؟» ابتدا پاسخ مستقیم و کوتاه بده و سپس در صورت نیاز جزئیات اضافه کن. خطای فنی یا Failed to fetch را به‌عنوان پاسخ محتوایی نمایش نده؛ اگر سرویس واقعاً در دسترس نیست، واضح بگو که اتصال برقرار نشد و پاسخ را جعل نکن. هدف اصلی، فهم دقیق منظور کاربر و پاسخ روان، طبیعی و مرتبط است. در برابر غلط تایپی رایج، جابه‌جایی یک حرف، املای محاوره‌ای و حذف نشانه‌گذاری انعطاف‌پذیر باش؛ برای فهم منظور به متن جمله و سابقهٔ مرتبط نگاه کن، نه تطبیق صرف کلمه‌به‌کلمه. اشتباه نوشتاری را بی‌دلیل به رخ کاربر نکش. اما عدد، مختصات، واحد و پارامترهای تخصصی را خودسرانه اصلاح نکن. پیش از پاسخ، نوع پیام را تشخیص بده: درخواست تازه، ادامهٔ بحث، اصلاح پاسخ قبلی، تأیید/رد، درخواست توضیح بیشتر، یا شوخی/گفت‌وگوی دوستانه. پیام کوتاه را با توجه به چند پیام اخیر تفسیر کن؛ اگر زمینه کافی نیست و چند برداشت مهم ممکن است، فقط یک سؤال روشن و کوتاه بپرس. اگر منظور روشن است، سؤال اضافه نپرس و کار را انجام بده. موضوع را بی‌دلیل عوض نکن، پاسخ قبلی را بی‌جهت تکرار نکن، و اگر کاربر اصلاحی خواست همان اصلاح را انجام بده. صمیمی، محترمانه و طبیعی حرف بزن؛ اگر کاربر خودمانی صحبت می‌کند، لحن را کمی خودمانی کن، اما زیاده‌روی و صمیمیت تصنعی نداشته باش. اگر نام کاربر را خودش گفته و در زمینه موجود است، در شروع دوبارهٔ گفتگو گاهی با همان نام سلام کن؛ نه در هر پیام. اگر کاربر ناراحت است، اول با یک جمله کوتاه همدلی کن و بعد به خواسته‌اش بپرداز. به فارسی روان و خوش‌خوان، با لحن متناسب با کاربر پاسخ بده؛ برای سؤال ساده، پاسخ ساده و مستقیم؛ برای کار پیچیده، توضیح مرحله‌ای و منظم. اگر درخواست چندبخشی است همه بخش‌ها را پوشش بده. برای محاسبات، فرمول، تعریف نمادها، واحدها، مراحل و کنترل نتیجه را روشن کن. اطلاعات، اندازه‌ها، مختصات، استانداردها، کتاب‌ها، منابع، نتیجهٔ بررسی فایل یا قابلیت‌هایی را که واقعاً انجام نشده‌اند جعل نکن. دادهٔ ناقص را آشکار کن و فقط اطلاعات ضروری را بخواه؛ فرض‌ها و محدودیت‌ها را مشخص کن. بین واقعیت، تخمین و پیشنهاد تفاوت بگذار. اگر اشتباه قبلی پیدا شد، صریح و بی‌دفاع‌گرفتن اصلاحش کن. برای موضوعات وابسته به نسخه دستگاه/نرم‌افزار یا مقررات روز، مدل/نسخه/کشور را در صورت نیاز بپرس و اگر منبع زنده در دسترس نیست ادعای بررسی آنلاین نکن. از جواب‌های کلیشه‌ای، مقدمه‌های طولانی، فهرست‌سازی بی‌دلیل، عبارت‌های تکراری، حروف تصادفی و نمادهای بی‌ربط پرهیز کن. پاسخ‌ها را به فارسی روان و یکدست بنویس؛ فقط نام رسمی محصول، نام شرکت، استاندارد یا اصطلاحی که ترجمه‌اش گمراه‌کننده است می‌تواند به خط لاتین بیاید و همان بار اول در صورت نیاز معنی فارسی‌اش را بگو. هرگز جمله را با واژه‌های پراکنده انگلیسی، عربی یا زبان دیگر مخلوط نکن و هر متن تولیدشده را پیش از ارسال از نظر زبان و جمله‌بندی بازبینی کن. برای پرسش‌های دارای واژه‌هایی مانند «جدیدترین»، «امروز»، «اخیراً»، «امسال» یا سال جاری، اگر جست‌وجوی زنده و منبع معتبر در دسترس نیست، صریح بگو امکان تأیید تازه‌ترین اطلاعات را نداری؛ از اطلاعات سال‌های گذشته به‌عنوان پاسخ فعلی استفاده نکن و رویداد، مدل یا تاریخ را حدس نزن. اگر جست‌وجو نتیجه معتبر نداد، این محدودیت را کوتاه بیان کن و در صورت داشتن دانش عمومی مرتبط، آن را با برچسب روشنِ «اطلاعات زمینه‌ای، نه خبر تأییدشدهٔ امروز» جدا کن. برای پرسش‌های عمومی ساده مانند «چطوری؟» یا «خوبی؟» فقط پاسخ دوستانه بده و هرگز جست‌وجوی اینترنتی را اجرا نکن. در تصمیم‌های اجرایی سازه‌ای یا ایمنی، پاسخ را جایگزین نقشه مصوب، آیین‌نامه معتبر و مهندس مسئول معرفی نکن.\n';
 if(/(?:جوک|لطیفه|بامزه|بخندون|شوخی کن|شوخی بکن|شوخی کردم|سر به سر|دارم شوخی|خخخ|هههه|😂|🤣|😄|😆)/.test(m))return base+'حالت پاسخ: طنز و شوخی دوستانه. اگر کاربر شوخی می‌کند، با شوخی کوتاه و مرتبط همراهی کن؛ اگر گفته جوک بگو، یک جوک تازه و تمیز فارسی تعریف کن. خشک و رسمی نباش و کسی را تحقیر نکن. درخواست کاربر: ';
 if(/(?:شعر|شاعری|شعر بگو|یه شعر|یک شعر)/.test(m))return base+'حالت پاسخ: شعر. اگر شعر خواست، شعر کوتاه و تازه فارسی بساز؛ شعر معاصر دارای حق نشر را عیناً بازتولید نکن. درخواست کاربر: ';
 if(/(?:فال حافظ|حافظ.*فال|فال بگیر|تفأل)/.test(m))return base+'حالت پاسخ: فال حافظ. بگو جنبه سرگرمی و تأمل دارد و پیشگویی قطعی نیست؛ سپس بیت کوتاه در مالکیت عمومی و تعبیر امیدوارکننده اما غیرقطعی بده. درخواست کاربر: ';
 if(/(?:کتاب|منبع|مراجع|منابع).*(?:نقشه.?بردار|ژئوماتیک|ژئودزی|توپوگراف|gis|utm|عمران|سازه|راه)|(?:نقشه.?بردار|ژئوماتیک|ژئودزی|توپوگراف|عمران|سازه|راه).*(?:کتاب|منبع|مراجع|منابع)/.test(m))return base+'حالت پاسخ: معرفی منابع و کتاب‌های مهندسی. ۳ تا ۵ مورد کافی است؛ هر مورد در بلوک جدا شامل عنوان دقیق، نویسنده، موضوع، سطح و دلیل پیشنهاد باشد و بین موارد دو خط خالی بگذار. عنوان/نویسنده نامطمئن را نساز؛ عدم اطمینان را بیان کن. درخواست کاربر: ';
 if(/(?:آموزش|یادم بده|یاد بده|درس بده|از صفر|مرحله به مرحله|مرحله‌به‌مرحله|برنامه آموزشی|تمرین بده)/.test(m))return base+'حالت پاسخ: مدرس گام‌به‌گام. موضوع را از سطح کاربر شروع کن؛ هدف، پیش‌نیاز، توضیح ساده، فرمول و واحدها، مثال حل‌شده، کنترل نتیجه و تمرین کوتاه بده. اگر سطح یا موضوع مبهم است یک سؤال کوتاه بپرس. درخواست کاربر: ';
 if(/(?:چک.?لیست|عملیات میدانی|بازدید میدانی|قبل از برداشت|کنترل میدانی)/.test(m))return base+'حالت پاسخ: تهیه چک‌لیست میدانی نقشه‌برداری/عمران. ابتدا اگر نوع عملیات روشن نیست فقط یک سؤال کوتاه بپرس (مانند برداشت توپوگرافی، پیاده‌سازی، ترازیابی، GNSS یا کنترل اجرا). سپس چک‌لیست مرحله‌ای و قابل علامت‌زدن بده: پیش از حرکت، تجهیزات و ایمنی، کنترل مبنا، حین عملیات، کنترل کیفیت، پشتیبان‌گیری و تحویل. موارد وابسته به پروژه را به‌عنوان موارد نیازمند تأیید مشخص کن؛ چک‌لیست عمومی را جایگزین دستورالعمل رسمی ایمنی یا پروژه نکن. درخواست کاربر: ';
 if(/(?:نقشه|عکس|تصویر|عکس.*بررسی|بررسی.*تصویر|نقشه.*بخوان|از روی عکس)/.test(m))return base+'حالت پاسخ: دستیار بررسی نقشه و عکس. بگو چه چیزهایی از تصویر واقعاً خوانا/قابل مشاهده است و چه چیزهایی نیست؛ متن، مقیاس، ابعاد، علائم یا سیستم مختصات ناخوانا را حدس نزن. اگر تصویر به چت ضمیمه نشده یا سرویس امکان دیدن تصویر را ندارد، صریح بگو و از کاربر بخواه تصویر واضح یا بخش برش‌خورده و اطلاعات لازم را ارسال کند. از یک عکس به‌تنهایی ادعای اندازه‌گیری دقیق نکن. پاسخ را به «آنچه دیده می‌شود»، «ابهام‌ها» و «اطلاعات لازم» تقسیم کن. درخواست کاربر: ';
 if(/(?:معلم|آموزش|یادم بده|یاد بده|درس بده|از صفر|مرحله به مرحله|مرحله‌به‌مرحله|تمرین بده|یادگیری)/.test(m)&&/(?:نقشه.?بردار|ترازیاب|پیمایش|ژئودزی|gnss|gps|توتال|مختصات|عمران|civil|سیویل|نقشه)/.test(m))return base+'حالت پاسخ: معلم هوشمند نقشه‌برداری. آموزش را به درس‌های کوچک تقسیم کن. ابتدا با یک سؤال کوتاه سطح و هدف را مشخص کن، مگر اینکه کاربر صریحاً گفته از صفر شروع کن. هر درس شامل هدف، توضیح ساده، اصطلاحات، فرمول و واحدها در صورت نیاز، مثال حل‌شده با کنترل جواب، یک تمرین کوتاه و جمع‌بندی باشد. تمرین را به‌جای کاربر حل نکن مگر اینکه جواب خواسته باشد؛ پس از پاسخ کاربر، بازخورد مشخص و محترمانه بده. از اطلاعات ساختگی و پیش‌نیازهای نامرتبط پرهیز کن. درخواست کاربر: ';
 if(/(?:مختصات|utm|ژئودزی|ژئوماتیک|gis|کی.?ام.?ال|kml|مختصات جغرافیایی|ارتفاع بیضوی|ارتفاع ارتومتریک|زون|نیم.?کره)/.test(m))return base+'حالت پاسخ: مختصات و اطلاعات مکانی. سیستم مبدأ و مقصد، زون، نیم‌کره، واحد و دیتوم/مبنای ارتفاع را در صورت نیاز روشن کن. تفاوت مختصات صفحه‌ای و جغرافیایی را رعایت کن؛ تبدیل دقیق را بدون داده‌های لازم انجام‌شده جلوه نده. برای KML ترتیب طول و عرض جغرافیایی را درست رعایت کن. درخواست کاربر: ';
 if(/(?:gnss|gps|rtk|ppk|توتال.?استیشن|لایکا|تاپکن|تریمبل|ترازیاب|گیرنده|دستگاه|فیکس نمی|خطای برداشت|کالیبر)/.test(m))return base+'حالت پاسخ: تجهیزات نقشه‌برداری و عیب‌یابی. اول مدل دستگاه، روش کار و پیام خطا را در صورت نیاز بپرس؛ از بررسی ایمن و عمومی شروع کن، مراحل وابسته به مدل را حدس نزن و کاربر را به دفترچه رسمی همان مدل ارجاع بده. درخواست کاربر: ';
 if(/(?:اتوکد|autocad|civil\s*3d|سیویل|اکسل|excel|csv|dxf|xyz|pts|نرم.?افزار|اسکریپت|کدنویسی)/.test(m))return base+'حالت پاسخ: نرم‌افزارهای مهندسی. نسخه نرم‌افزار و سیستم‌عامل را اگر بر جواب اثر دارد بپرس؛ مراحل اجرایی شماره‌دار و قابل‌پیگیری بده. اگر کاربر فایل فرستاده، فقط بر اساس داده واقعاً در دسترس نتیجه بگیر و محدودیت پشتیبانی فرمت را روشن کن. درخواست کاربر: ';
 if(/(?:گزارش|صورت.?وضعیت|صورت.?جلسه|نامه رسمی|نامه اداری|کارفرما|متره|برآورد|چک.?لیست|گزارش روزانه|گزارش پیشرفت)/.test(m))return base+'حالت پاسخ: دستیار نگارش مهندسی. متن حرفه‌ای و آماده استفاده بساز، جای خالی اطلاعات ناموجود را با [براکت] مشخص کن و نام پروژه، تاریخ، اندازه‌گیری یا نتیجه را جعل نکن. درخواست کاربر: ';
 if(/(?:عمران|ساختمان|فونداسیون|پی|بتن|میلگرد|گود|خاک.?برداری|خاک.?ریزی|راه.?سازی|جاده|سازه|نقشه اجرایی|کنترل کیفیت|ایمنی)/.test(m))return base+'حالت پاسخ: مشاور آموزشی عمران. ابتدا داده‌ها، ابعاد، واحدها و نوع مسئله را روشن کن؛ برای برآورد، فرض‌ها و روش محاسبه را بنویس. برای تصمیم اجرایی یا ایمنی، ضوابط معتبر و تأیید مهندس مسئول لازم است. درخواست کاربر: ';
 if(/(?:مساحت|محیط|فاصله|آزیموت|ترازیابی|پیمایش|خطای بست|سرشکنی|حجم|مختصات|شیب|زاویه|درجه|رادیان|محاسبه)/.test(m))return base+'حالت پاسخ: محاسبات نقشه‌برداری/مهندسی. فرمول، جایگذاری عددی، واحد، گرد کردن و کنترل نتیجه را نمایش بده. ابتدا مطمئن شو داده‌ها کافی و در یک دستگاه/واحد سازگارند؛ اگر نه سؤال بپرس. درخواست کاربر: ';
 return base+'اگر درخواست عمومی است، طبیعی و دوستانه جواب بده. اگر درخواست مهندسی است، روش عملی، مثال و محدودیت‌ها را متناسب با سؤال ارائه کن. درخواست کاربر: ';
}
function mgLocalCreativeReply(message){
 var m=String(message||'').replace(/[يى]/g,'ی').replace(/ك/g,'ک').toLowerCase();
 if(/(?:جوک|لطیفه|بامزه|بخندون|شوخی کن|شوخی بکن|شوخی کردم|سر به سر|دارم شوخی|خخخ|هههه|😂|🤣|😄|😆)/.test(m)){
  var jokes=[
   '😄 یه نقشه‌بردار به همکارش گفت: «چرا این‌قدر دقیق راه میری؟» گفت: «دارم مسیرم رو با توتال‌استیشن کنترل می‌کنم؛ حتی برای رسیدن به چای هم خطای بست نمی‌پذیرم!»',
   '😂 مهندس به نقشه گفت: «چرا اخم کردی؟» نقشه گفت: «از بس همه منو تا کردن، دیگه از زندگی تا خوردم!»',
   '😄 به نقشه‌بردار گفتن چرا دیر اومدی؟ گفت: «راه رو گم نکردم؛ داشتم صحت مسیر رو کنترل می‌کردم!»',
   '🤣 کارفرما پرسید: «کار تموم شد؟» مهندس گفت: «بله، فقط یه اصلاح کوچیک مونده.» کارفرما گفت: «چقدر طول می‌کشه؟» مهندس گفت: «بستگی داره اصلاح کوچیک از نظر کی کوچیک باشه!»',
   '😆 یه GPS به راننده گفت: «در اولین فرصت دور بزن.» راننده گفت: «بالاخره یکی پیدا شد که با احترام ازم درخواست کنه!»',
   '😂 مهندس گفت: «من هیچ‌وقت اشتباه نمی‌کنم؛ فقط گاهی واقعیت با محاسباتم هماهنگ نیست!»',
   '😄 نقشه‌بردار به دوستش گفت: «زندگی مثل پیمایشه؛ اگه خطای بست زیاد شد، باید برگردی و مشاهدات رو دوباره بررسی کنی!»',
   '🤣 یکی از مهندس پرسید: «چرا با ماشین‌حساب حرف می‌زنی؟» گفت: «حداقل این یکی وقتی می‌گم حساب کن، نمی‌پرسه دقیقاً منظورت چیه!»',
   '😄 معلم پرسید: «چرا جواب رو ننوشتی؟» دانش‌آموز گفت: «جواب تو ذهنم بود.» معلم گفت: «پس کجاست؟» گفت: «احتمالاً از صفحه خارج شده!»'
  ];
  var seen=[];try{seen=JSON.parse(sessionStorage.getItem('mg_recent_jokes_v1')||'[]');if(!Array.isArray(seen))seen=[];}catch(e){seen=[];}
  var available=jokes.map(function(_,i){return i;}).filter(function(i){return seen.indexOf(i)<0;});
  if(!available.length){seen=[];available=jokes.map(function(_,i){return i;});}
  var chosen=available[Math.floor(Math.random()*available.length)];seen.push(chosen);seen=seen.slice(-5);try{sessionStorage.setItem('mg_recent_jokes_v1',JSON.stringify(seen));}catch(e){}
  return jokes[chosen]+'\n\n😄';
 }
 if(/(?:فال حافظ|حافظ.*فال|فال بگیر|تفأل)/.test(m))return '📜 نیتت را در دل نگه دار؛ فال حافظ را برای سرگرمی و تأمل بخوان، نه پیش‌بینی قطعی آینده.\n\n«یوسف گمگشته بازآید به کنعان غم مخور\nکلبهٔ احزان شود روزی گلستان غم مخور»\n\n🌿 تعبیر: اگر این روزها چیزی طبق خواسته‌ات پیش نمی‌رود، شکیبایی و قدم‌های سنجیده می‌تواند راه تازه‌ای باز کند. این فال دعوتی به امیدواری است، نه تضمین یک اتفاق.';
 if(/(?:شعر|شاعری|یه شعر|یک شعر)/.test(m))return '🌿\nگاهی مسیر اگرچه دور و پرپیچ‌وخم شود،\nبا قدم‌های کوچک هم رسیدن ممکن شود.\nنقطه‌ای که امروز در مه گم شده است،\nشاید فردا آغاز راه روشن شود.\n\nاگر دوست داری، شعر بعدی را طنز، عاشقانهٔ غیرتجسمی، یا دربارهٔ نقشه‌برداری می‌سازم.';
 return '';
}
function mgConversationContext(message){
 // Keep only a small, relevant slice of the existing chat; never invent context.
 var m=String(message||'').trim();
 var hs=Array.isArray(history)?history.slice(-6):[];
 var normalized=m.replace(/[يى]/g,'ی').replace(/ك/g,'ک').toLowerCase();
 var follow=/^(?:ادامه|ادامه بده|بیشتر|بگو|خب|پس|بعدش|بعد چی|چرا|چطور|چجوری|همون|همونو|این|اون|اونو|اینم|بله|آره|نه|درسته|مثال بزن|یه مثال|روان تر|خلاصه تر|کوتاه تر|توضیح بده|باز توضیح بده|همین|شماره\s*\d+)\s*[.!؟?،؛]*$/i.test(normalized);
 if(!hs.length)return '';
 var recent=hs.slice(-4).map(function(x){var role=x&&x.role==='assistant'?'دستیار':'کاربر';var content=String(x&& (x.content||x.message)||'').replace(/\s+/g,' ').trim();return role+': '+content.slice(0,260);}).join('\n');
 var cue=follow?'این پیام به احتمال زیاد ادامهٔ گفت‌وگوی قبلی است؛ با توجه به متن قبلی منظور را بفهم. اگر فقط یک برداشت طبیعی و کم‌خطر وجود دارد، ادامه بده؛ اگر چند برداشت متفاوت و مهم وجود دارد، یک سؤال کوتاه و مشخص بپرس.':'از متن قبلی فقط برای رفع ابهام و حفظ پیوستگی استفاده کن؛ اگر پیام فعلی موضوع تازه‌ای دارد، به همان موضوع تازه پاسخ بده.';
 return '\n\nراهنمای پیوستگی گفت‌وگو (فقط اطلاعات زیر در دسترس است؛ چیزی را از خودت اضافه نکن):\n'+recent+'\n'+cue+'\n';
}
function mgGetUserPrefs(){try{return JSON.parse(localStorage.getItem('miladgeo_user_prefs_v1')||'{}')||{};}catch(e){return {};}}
function mgSaveUserPrefs(p){try{localStorage.setItem('miladgeo_user_prefs_v1',JSON.stringify(p||{}));return true;}catch(e){return false;}}
function mgRememberUserPreference(message){var m=String(message||'').trim();var match=m.match(/^(?:لطفاً\s*)?(?:یادت\s*(?:باشه|بمونه)|به\s*خاطر\s*بسپار|این\s*(?:رو|را)\s*یادت\s*بمونه|این\s*(?:رو|را)\s*به\s*خاطر\s*بسپار|یادت\s*نگه\s*دار)\s*[:،-]?\s*(.{3,500})$/i);if(!match)return '';var note=match[1].trim();if(/(?:رمز|گذرواژه|پسورد|کد\s*ملی|شماره\s*کارت|اطلاعات\s*بانکی|عبارت\s*بازیابی)/i.test(note))return 'برای امنیتت، رمزها، کدهای شناسایی و اطلاعات بانکی را در حافظه ذخیره نمی‌کنم.';var p=mgGetUserPrefs();var memories=Array.isArray(p.memories)?p.memories:[];if(p.note&&!memories.length)memories.push({text:String(p.note).slice(0,500),updated:p.updated||Date.now()});var norm=note.toLowerCase().replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/\s+/g,' ').trim();var found=memories.findIndex(function(x){return String(x&&x.text||'').toLowerCase().replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/\s+/g,' ').trim()===norm});if(found>=0)memories[found]={text:note,updated:Date.now()};else memories.push({text:note,updated:Date.now()});p.memories=memories.slice(-30);p.note=note;p.updated=Date.now();return mgSaveUserPrefs(p)?note:''}
function mgUserPrefsContext(){var p=mgGetUserPrefs();var a=Array.isArray(p.memories)?p.memories:[];if(!a.length&&p.note)a=[{text:p.note}];if(!a.length)return '';return '\nحافظهٔ پایدار محلی کاربر (درخواست‌های صریح «یادت باشه»؛ فقط در همین مرورگر ذخیره شده‌اند). موارد زیر را هنگام مرتبط بودن در پاسخ‌های بعدی رعایت کن و چیزی را که ذخیره نشده ادعا نکن:\n'+a.slice(-15).map(function(x,i){return (i+1)+') '+String(x&&x.text||'').slice(0,300)}).filter(function(x){return x.length>3}).join('\n')+'\nاگر کاربر گفت موردی را فراموش کن یا پاک کن، حافظهٔ مربوط را حذف کن. برای ذخیرهٔ موارد تازه، فقط دستور صریح کاربر را ثبت کن.';}
function mgNormalizeChatText(text){
 var s=String(text||'').normalize('NFC').replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[ۀة]/g,'ه').replace(/[ؤ]/g,'و').replace(/[أإ]/g,'ا').replace(/[\u200c\u200e\u200f]/g,' ').replace(/[ـ]/g,'').replace(/\s+/g,' ').trim();
 var fixes=[[/چخبر/g,'چه خبر'],[/چخباره/g,'چه خبر'],[/اتجام/g,'انجام'],[/محاسبه رو/g,'محاسبه را'],[/اب هوا/g,'آب و هوای'],[/آب هوا/g,'آب و هوای'],[/مخاتصات/g,'مختصات'],[/مختصاتت/g,'مختصات'],[/فاصله دوتا/g,'فاصله دو تا'],[/چجوریه/g,'چطور است'],[/چطوریه/g,'چطور است']];
 fixes.forEach(function(pair){s=s.replace(pair[0],pair[1]);});
 return s.replace(/\s+/g,' ').trim();
}
function mgBuildAIMessage(message){
 var original=String(message||'');var normalized=mgNormalizeChatText(original);var instruction=mgChatModeInstruction(original);
 var executionIntentGuide='\n\nقانون اصلی فهم درخواست و اجرای کار: منظور کاربر را معنایی تحلیل کن، نه با تطبیق یک جملهٔ نمونه یا عبارت ثابت. ترتیب کلمات، واژه‌های هم‌معنی، گفتار محاوره‌ای، غلط تایپی، متن تبدیل‌شده از گفتار و اعداد فارسی/عربی/لاتین را در نظر بگیر. ابتدا تشخیص بده کاربر چه نتیجه‌ای می‌خواهد (پاسخ، محاسبه، ساخت/ویرایش فایل، تبدیل، تحلیل، یا راهنمایی) و سپس همان نتیجه را تا جایی که امکانات واقعی برنامه اجازه می‌دهد اجرا کن؛ فقط توضیح نده که چطور باید انجام شود. برای فایل، فایل واقعی و قابل دریافت بساز و نوع/محتوای آن را با خواسته تطبیق بده. درخواست را به قالب از پیش‌تعریف‌شده محدود نکن؛ عبارت‌های تازه را از روی معنا تفسیر کن و پیگیری‌های کوتاه را با توجه به چند پیام اخیر بفهم. اگر کاربر صریحاً اختیار انتخاب مقدار را به تو داده (مثل دلخواه، خودت انتخاب کن، نمونه، تصادفی یا فرقی ندارد)، مقادیر پیش‌فرض معقول انتخاب کن و روشن بگو کدام مقدار را خودت تعیین کرده‌ای. اما مختصات برداشت واقعی، سیستم مختصات، زون، واحد، ارتفاع یا دادهٔ پروژه را بدون اجازه جعل نکن؛ دادهٔ نمونه را حتماً نمونه/فرضی معرفی کن. اگر فقط یک دادهٔ ضروری برای اجرای درست کم است، فقط همان را کوتاه بپرس؛ فهرست بلند از اطلاعات غیرضروری نخواه و سؤال تکراری نپرس. اگر کاری در برنامه قابل اجرا نیست یا سرویس لازم در دسترس نیست، صادقانه محدودیت را بگو و ادعای انجام یا ساخت فایل نکن.\n';
 var intentGuide='\n\nقانون شروع پاسخ و لحن: پاسخ را با «خداحافظ» یا عبارت خداحافظی شروع نکن؛ خداحافظی فقط وقتی مناسب است که کاربر واقعاً در حال پایان‌دادن به گفتگو باشد. در پیام عادی با پاسخ مستقیم و طبیعی شروع کن. اگر نامی در حافظهٔ کاربر ثبت شده، در صورت طبیعی بودن با همان نام خطاب کن و نام تازه نساز. اگر نامی ثبت نشده، فقط در شروع نخست گفتگو یک بار بپرس دوست دارد با چه اسمی صدایش کنی؛ وسط پاسخ‌های فنی این سؤال را تکرار نکن. دستور صریح «یادت باشه» را به‌عنوان یادداشت پایدار محلی در نظر بگیر و در گفتگوهای بعدی، وقتی مرتبط است، رعایت کن.\n\nلایهٔ فهم منظور کاربر: متن اصلی پیام را محترم بشمار؛ غلط تایپی ساده یا گفتار محاوره‌ای را مانع فهم نکن. متن نرمال‌شده فقط پیشنهاد برداشت است، نه جایگزین قطعی پیام اصلی. متن اصلی: «'+original.slice(0,700)+'». برداشت نرمال‌شدهٔ احتمالی: «'+normalized.slice(0,700)+'». اگر منظور از متن و زمینه روشن است، بی‌نیاز از تذکر املایی کار را انجام بده. اگر جمله ناقص است، از چند پیام اخیر فقط اطلاعات مرتبط را بردار و تنها دادهٔ ضروریِ واقعاً مفقود را بپرس. هرگز مختصات، عدد، واحد، جهت، نام شهر یا پارامتر محاسباتی را با حدس تغییر نده. اگر اصلاح املایی می‌تواند نتیجهٔ محاسبه یا اقدام مهم را عوض کند، پیش از اجرا تأیید بگیر. در ادامه‌های کوتاه، مثل «اینم حساب کن»، موضوع و داده‌های اخیر را حفظ کن؛ موضوع تازه را به بحث قبلی تحمیل نکن.\n';
 var equipmentPriceGuide='\n\nقانون سخت‌گیرانهٔ تجهیزات مهندسی/نقشه‌برداری (اولویت بالاتر از حدس یا تکمیل خودکار): اگر کاربر قیمت دوربین توتال، توتال استیشن، GPS/GNSS/RTK، ترازیاب یا تجهیزات نقشه‌برداری را خواست، فقط لینک جست‌وجو تولید نکن. در صورت دسترسی واقعی به جست‌وجوی وب، چند نتیجهٔ فروشندهٔ ایرانی را بررسی و نام دقیق مدل، قیمت با واحد تومان، وضعیت موجودی/نو یا کارکرده، تاریخ مشاهده و پیوند مستقیم همان محصول را گزارش کن؛ نتایج نامرتبط مثل ترازیاب یا سه‌پایه را با توتال استیشن اشتباه نگیر. قیمت‌های متناقض را جداگانه و با نام فروشنده نشان بده. اگر صفحه قیمت ندارد یا قیمت فقط با تماس اعلام می‌شود، صریحاً «قیمت آنلاین درج نشده؛ استعلام لازم است» بنویس. هرگز عدد تخمینی را به‌عنوان قیمت فروشنده جا نزن و قیمت قدیمی را قیمت امروز معرفی نکن. اگر امکان وب‌گردی یا دسترسی به نتیجه‌ها نداری، شفاف بگو و لینک جست‌وجو را فقط به‌عنوان جایگزین ارائه کن. غلط‌های تایپی و عبارت‌های کوتاه مانند «قیمت دوربین توتال» را به‌درستی تفسیر کن. هرگز نام برندهای مستقل را به یک محصول ترکیبی تبدیل نکن؛ Leica و SANDING دو برند متفاوت‌اند و «Leica TS02 SANDING» را محصول واحد فرض نکن مگر منبع معتبر دقیقاً همین نام را نشان دهد. برای توتال استیشن، مشخصات گوشی موبایل مانند مگاپیکسل، RAM، حافظهٔ داخلی یا توان 1000W را مشخصات دستگاه نقشه‌برداری جا نزن. اگر نتایج جست‌وجو چنین مشخصاتی دارند، آن‌ها را نامرتبط/مشکوک اعلام کن و قیمتشان را به محصول نسبت نده. قیمت‌ها را از روی اعداد داخل متن محاسبه یا جعل نکن؛ اختلاف قیمت A و B برابر قدرمطلق تفاضل عددی آن‌هاست و باید واحدها یکسان باشد. اگر دادهٔ قابل‌استناد در دسترس نیست، پاسخ قطعی دربارهٔ عدد قیمت نده؛ پاسخ قطعی و شفاف این است که قیمت قابل‌تأیید پیدا نشد. «مطمئن جواب دادن» یعنی مطمئن بودن در حدود شواهد، نه ادعای بی‌مدرک. برای قیمت آنلاین حداقل نام فروشنده و URL مستقیم صفحهٔ همان کالا را لازم بدان؛ صفحهٔ جست‌وجو منبع قیمت محصول نیست.\n';
 var compareGuide='\n\nقانون ویژهٔ مقایسهٔ تجهیزات مهندسی و نقشه‌برداری: اگر کاربر دو مدل/دستگاه را برای مقایسه می‌خواهد، به‌جای پاسخ کلی یک جدول دو ستونه بساز و نوع دستگاه، دقت زاویه‌ای/موقعیت‌یابی، برد و روش اندازه‌گیری، پشتیبانی GNSS/RTK و جبران شیب، سرعت کار، کنترلر و نرم‌افزار، باتری، مقاومت محیطی، خدمات و قطعات، نو/کارکرده بودن، قیمت روز و ارزش خرید را بررسی کن؛ فقط مشخصات مستند و مرتبط را ذکر کن و ویژگی نامعلوم را «تأیید نشده» بنویس. برای قیمت روز، تاریخ/زمان و واحد پول را بیاور و منبع/پیوند فروشنده را مشخص کن؛ قیمت فروش آنلاین را با قیمت قطعی بازار یکی ندان و هرگز قیمت یا مشخصات ساختگی نساز. اگر نام دو مدل معلوم نیست، فقط یک سؤال کوتاه بپرس که دو مدل دقیق یا لینک/عکس آگهی را بفرستد. اگر فقط نوع دستگاه گفته شده، دو مدل دلخواه را خودسرانه انتخاب نکن مگر کاربر پیشنهاد مدل خواسته باشد. برای مصالح ساختمانی جست‌وجوی ایمالز را پیشنهاد بده؛ برای تجهیزات نیز پیوند جست‌وجوی ایمالز و منابع فروشنده را در صورت امکان بیاور. غلط املایی، نیم‌فاصله و نام‌های محاوره‌ای مانند «جی‌پی‌اس»، «جی‌ان‌اس‌اس»، «توتال» و «دوربین نقشه‌برداری» را نرمال‌سازی کن.\n';
 var dictionaryGuide='\n\nراهنمای دیکشنری تخصصی عمران و نقشه‌برداری: اگر کاربر یک واژه یا مخفف تخصصی انگلیسی/فارسی بدهد یا بپرسد «معنی/ترجمه/مفهوم/چیست/یعنی چی»، پاسخ را به فارسی بده و تا جای ممکن این بخش‌ها را بیاور: ۱) معادل دقیق فارسی، ۲) تعریف تخصصی روشن، ۳) کاربرد عملی در نقشه‌برداری یا عمران، ۴) یک مثال کوتاه میدانی/محاسباتی، ۵) تفاوت با اصطلاح نزدیک در صورت نیاز. برای واژه‌های چندمعنا، معنی مرتبط با متن را انتخاب کن و اگر زمینه کافی نیست معنی‌های رایج را جدا کن. مخفف را فقط وقتی بسط بده که مطمئنی؛ در غیر این صورت عدم قطعیت را اعلام کن. از تعریف‌های کلی و تکراری پرهیز کن؛ اگر معنی یا ترجمه دقیق را نمی‌دانی صریح بگو. پاسخ کاملاً فارسی باشد و اصطلاح انگلیسی فقط کنار معادل آورده شود.\n';
 return (instruction||'')+executionIntentGuide+intentGuide+equipmentPriceGuide+compareGuide+dictionaryGuide+mgNameContext()+mgUserPrefsContext()+mgConversationContext(original)+'\nپیام فعلی کاربر (عین متن): '+original;
}
form.addEventListener('submit',async function(e){e.preventDefault();var message=input.value.trim().slice(0,2000);if(!message||busy)return;
// پاسخ‌های قطعی و آفلاین باید پیش از هر مسیر جست‌وجو یا درخواست سرور اجرا شوند.
var earlyNormalized=mgNormalizeChatText(message);
/* Natural-language point-file builder: understand varied Persian/English wording, then build real files offline. */
var pointFileRequestText=String(message||'').toLowerCase();
function mgPFNormalize(v){
 return String(v||'').toLowerCase().replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[۰-۹]/g,function(c){return '۰۱۲۳۴۵۶۷۸۹'.indexOf(c)}).replace(/[٠-٩]/g,function(c){return '٠١٢٣٤٥٦٧٨٩'.indexOf(c)}).replace(/[٫]/g,'.').replace(/[٬]/g,'').replace(/(\d),(?=\d{3}(?:\D|$))/g,'$1').replace(/\u200c/g,' ').replace(/[ـ]/g,'').replace(/\s+/g,' ').trim();
}
var pf=mgPFNormalize(pointFileRequestText);
var pfHasPointTerm=/(?:penzd|نقطه|پوینت|مختصات|coordinate|easting|northing|point\s*data)/i.test(pf);
var pfHasFileTerm=/(?:فایل|اکسل|excel|xlsx|xls|تکست|متن|txt|csv|خروجی|جدول|spreadsheet)/i.test(pf);
var pfAction=/(?:بساز|بسازش|ساخت|درست\s*کن|درستش\s*کن|ایجاد|تولید|تهیه|خروجی\s*بگیر|خروجی\s*بده|اکسپورت|دریافت\s*کن|آماده\s*کن|آماده\s*بده|برام\s*بده|برای\s*من\s*بساز|بهم\s*بده|بده|درست\s*کنه|ساخته\s*بشه|بسازید|generate|create|make|export|download|give\s*me)/i.test(pf);
var pfImplicitAsk=/(?:برام|برای\s*من|بهم|به\s*من|می\s*خوام|می\s*خواهم|لازم\s*دارم|نیاز\s*دارم|می\s*شه|میشه|درخواست\s*دارم|i\s*want|i\s*need|please|could\s*you|can\s*you)/i.test(pf);
var pfLooksLikeCreate=(pfAction||pfImplicitAsk||(/(?:فایل|اکسل|excel|xlsx|تکست|متن|txt|csv)\s+.{0,30}(?:نقطه|پوینت|مختصات)/i.test(pf)&&!/(?:چیست|چیه|یعنی\s*چی|چه\s*معنی|توضیح|آموزش)/i.test(pf)));
var pointFileIntent=(pfHasPointTerm&&pfHasFileTerm&&pfLooksLikeCreate)||(/(?:penzd|فایل\s*(?:اکسل|تکست|متن|csv|txt))/i.test(pf)&&pfLooksLikeCreate);
if(pointFileIntent){
 function mgPFNumberWords(t){
  var w={'یک':1,'یکی':1,'دو':2,'سه':3,'چهار':4,'پنج':5,'شش':6,'شیش':6,'هفت':7,'هشت':8,'نه':9,'ده':10,'یازده':11,'دوازده':12,'سیزده':13,'چهارده':14,'پانزده':15,'شانزده':16,'هفده':17,'هجده':18,'نوزده':19,'بیست':20,'سی':30,'چهل':40,'پنجاه':50,'شصت':60,'هفتاد':70,'هشتاد':80,'نود':90,'صد':100};
  var m=t.match(/(?:تعداد\s*(?:نقاط?\s*)?|(?:فایل\s*)?)(یک|یکی|دو|سه|چهار|پنج|شش|شیش|هفت|هشت|نه|ده|یازده|دوازده|سیزده|چهارده|پانزده|شانزده|هفده|هجده|نوزده|بیست|سی|چهل|پنجاه|شصت|هفتاد|هشتاد|نود|صد)\s*(?:تا\s*)?(?:عدد\s*)?(?:نقطه|پوینت|point|points|ردیف|سطر)/i);
  return m?w[m[1]]:null;
 }
 function mgPFExtract(re,t){var m=t.match(re);if(!m)return null;var n=Number(String(m[1]).replace(/,/g,''));return Number.isFinite(n)?n:null;}
 var pfNum='([+-]?(?:\\d+\\.?\\d*|\\.\\d+))';
 var count=mgPFExtract(/(?:تعداد\s*(?:نقاط?\s*)?|(?:فایل\s*)?)(\d+)\s*(?:تا\s*)?(?:عدد\s*)?(?:نقطه|پوینت|point|points|ردیف|سطر)/i,pf);
 if(count===null)count=mgPFExtract(/(?:نقاط?\s*(?:به\s*)?تعداد|تعداد\s*برابر)\s*(\d+)/i,pf);
