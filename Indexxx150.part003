    if(gpsClose)gpsClose.addEventListener('click',hideGpsPrompt);
    window.m17OpenExternalFile=function(file){if(!file){showToast('فایل KML/GPX دریافت نشد');return false;}var ext=(file.name||'').toLowerCase();if(!/\.(kml|kmz|gpx|geojson|json|zip)$/i.test(ext)){showToast('فرمت نقشه پشتیبانی نمی‌شود');return false;}m17ImportFile(file);return true;};
    var importBtn=q('m17ImportBtn'),importFile=q('m17ImportFile');
