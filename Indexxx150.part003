  segs.forEach(function(s){[s.a,s.b].forEach(function(p){var x=Number(p.lng),y=Number(p.lat);if(x<minX)minX=x;if(x>maxX)maxX=x;if(y<minY)minY=y;if(y>maxY)maxY=y;});});
  var w=760,h=360,pad=28,dx=(maxX-minX)||1,dy=(maxY-minY)||1,scale=Math.min((w-2*pad)/dx,(h-2*pad)/dy),ox=(w-dx*scale)/2,oy=(h-dy*scale)/2;
