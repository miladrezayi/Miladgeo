<div id="m17StakeGeoFields" style="display:none">
<div class="m17-stake-grid">
<div class="m17-stake-field"><label for="m17StakeLng">Longitude / طول</label><input autocomplete="off" id="m17StakeLng" inputmode="decimal" placeholder="51.375337" type="text"/></div>
<div class="m17-stake-field"><label for="m17StakeLat">Latitude / عرض</label><input autocomplete="off" id="m17StakeLat" inputmode="decimal" placeholder="35.744841" type="text"/></div>
</div>
</div>
<div class="m17-stake-list" id="m17StakeList">No stake-out points yet.</div>
<div class="m17-stake-actions" style="margin-top:10px">
<button class="m17-stake-primary" id="m17StakeApply" type="button">✓ پیاده‌سازی</button>
<button class="m17-stake-close" id="m17StakeClear" type="button">پاک کردن</button>
<button class="m17-stake-close" id="m17StakeExport" type="button">📤 خروجی</button>
</div>
<button class="m17-stake-close" id="m17StakeClose" style="width:100%;margin-top:9px" type="button">بستن</button>
</div>
</div>
<div aria-hidden="true" id="m17LiveStakeModal">
<div aria-labelledby="m17LiveStakeTitle" aria-modal="true" class="m17-live-stake-shell" role="dialog">
<div class="m17-live-stake-map" id="m17LiveStakeMapArea">
<div class="m17-live-map-badge" id="m17LiveTargetBadge">🎯 هدف: —</div>
<div class="m17-live-map-legend"><span class="m17-live-dot target"></span> هدف <span class="m17-live-dot user"></span> موقعیت من</div>
<div class="m17-live-user-marker" id="m17LiveUserMarker"></div>
<div class="m17-live-target-marker" id="m17LiveTargetMarker">●</div>
<div class="m17-live-line" id="m17LiveGuideLine"></div>
</div>
<div class="m17-live-stake-card">
<div class="m17-live-head"><div class="m17-live-title" id="m17LiveStakeTitle">📍 پیاده‌سازی زنده</div><span class="m17-live-gps" id="m17LiveGpsState">GPS …</span></div>
<div class="m17-live-target-name" id="m17LiveTargetName">هدف فعلی: —</div>
<div class="m17-live-tolerance-row"><label for="m17LiveTolerance">تلرانس رسیدن (متر)</label><input id="m17LiveTolerance" inputmode="decimal" min="0.01" step="0.01" type="number" value="0.50"/></div>
<div class="m17-live-values">
<div><span>ΔE</span><b id="m17LiveDE">—</b><small>m</small></div>
<div><span>ΔN</span><b id="m17LiveDN">—</b><small>m</small></div>
<div><span>آزیموت تا هدف</span><b id="m17LiveAzimuth">—</b><small>g</small></div>
<div><span>فاصله تا نقطه</span><b id="m17LiveDist">—</b><small>m</small></div>
</div>
<div class="m17-live-direction" id="m17LiveDirection">منتظر موقعیت GPS…</div>
<div class="m17-live-status" id="m17LiveStatus">وضعیت: منتظر موقعیت GPS…</div>
<div class="m17-live-guidance" id="m17LiveGuidance">حرکت بعدی: منتظر موقعیت GPS…</div>
<div class="m17-live-accuracy" id="m17LiveAccuracy">Accuracy GPS: —</div>
<div class="m17-live-actions">
<button class="m17-live-finish" id="m17LiveFinish" type="button">✓ اتمام پیاده‌سازی</button>
<button class="m17-live-back" id="m17LiveBack" type="button">بازگشت بدون ثبت</button>
</div>
</div>
</div>
</div>
<div aria-label="Drawing options" id="m17DrawToolbar">
<button data-mode="point" type="button">📍 نقطه</button>
<button data-mode="line" type="button">〰️ خط</button>
<button data-mode="area" type="button">📐 مساحت</button>
<button data-mode="clear" type="button">🗑 پاک کردن ترسیم</button>
<button aria-label="ورود KML، KMZ، GeoJSON، GPX و Shapefile ZIP" class="m17-import-inline" id="m17ImportBtn" type="button">📥 ورود KML، KMZ، GeoJSON، GPX و...</button>
<input accept=".kml,.kmz,.geojson,.json,.gpx,.zip,application/vnd.google-earth.kml+xml,application/vnd.google-earth.kmz,application/geo+json,application/gpx+xml,application/zip" id="m17ImportFile" style="display:none" type="file"/>
<button aria-label="خروجی" class="m17-export-inline" id="m17ExportBtn" type="button">📤 خروجی</button>
</div>
<div id="m17DrawHint"></div>
<div id="m4ProfileConfirmBar"><button id="m4ProfileConfirmBtn" onclick="m4ConfirmProfileLine();return false;" type="button">✓ تأیید نقاط A و B و بازگشت به توپوگرافی</button></div>
<div aria-hidden="true" id="m17ExportModal">
<div aria-labelledby="m17ExportTitle" aria-modal="true" class="m17-export-card" role="dialog">
<div class="m17-export-title" id="m17ExportTitle">📤 خروجی‌های منوی ۱۷</div>
<div class="m17-export-sub">نقاط و ترسیم فعلی روی نقشه</div>
<div class="m17-export-grid">
<button id="m17OutKml" type="button">📄 KML</button>
<button id="m17OutTxt" type="button">📄 TXT</button>
<button id="m17OutCsv" type="button">📊 Excel / CSV</button>
<button id="m17OutPdf" type="button">📑 PDF گزارش</button>
<button id="m17OutCopy" type="button">🌍 Google Earth ↓ PDF</button>
<button id="m17OutJpg" type="button">🌍 Google Earth ↓ JPG</button>
<button id="m17OutGpx" type="button">🧭 GPX</button>
<button id="m17OutGeoJson" type="button">🗺️ GeoJSON</button>
</div>
<button class="m17-export-close" id="m17OutClose" type="button">↩️ بازگشت</button>
</div>
</div>
<section class="page" id="menu18">
<a class="btn gray back" href="#main" onclick="return goPage('main');">← منوی اصلی</a>
<header class="m18-pro-hero">
<img alt="قطب‌نمای واقعی روی نقشه توپوگرافی" class="m18-pro-hero-img" loading="eager" src="data:image/webp;base64,">
<div class="m18-pro-hero-shade"></div>
<div class="m18-pro-hero-copy">
<span class="m18-pro-kicker">MILADGEO · NAVIGATION SYSTEM</span>
<h1>مرکز جهت‌یابی</h1>
<p>قطب‌نمای زنده، تعیین آزیموت، هدف‌گذاری دقیق، کالیبراسیون حسگرها و ثبت مشاهدات میدانی</p>
<div class="m18-pro-tags"><span>COMPASS</span><span>AZIMUTH</span><span>SENSORS</span></div>
</div><div class="m18-pro-index">18</div>
</img></header>
<div class="m18-card-grid">
<button class="m18-menu-card active" data-m18-open="m18PanelCompass" onclick="if(window.m18OpenDirect){window.m18OpenDirect(this);}" ontouchend="if(window.m18OpenDirect){event.preventDefault();window.m18OpenDirect(this);}" type="button">
<span aria-label="قطب‌نمای زنده" class="m18-card-photo" role="img" style='background-image:url("data:image/webp;base64,")'></span><b>قطب‌نمای زنده</b><small>نمایش جهت و حرکت عقربه</small>
</button>
<button class="m18-menu-card" data-m18-open="m18PanelAzimuth" onclick="if(window.m18OpenDirect){window.m18OpenDirect(this);}" ontouchend="if(window.m18OpenDirect){event.preventDefault();window.m18OpenDirect(this);}" type="button">
<span aria-label="آزیموت و جهت" class="m18-card-photo" role="img" style='background-image:url("data:image/webp;base64,")'></span><b>آزیموت و جهت</b><small>درجه، DMS و جهت اصلی</small>
</button>
<button class="m18-menu-card" data-m18-open="m18PanelTarget" onclick="if(window.m18OpenDirect){window.m18OpenDirect(this);}" ontouchend="if(window.m18OpenDirect){event.preventDefault();window.m18OpenDirect(this);}" type="button">
<span aria-label="هدف آزیموت" class="m18-card-photo" role="img" style='background-image:url("data:image/webp;base64,")'></span><b>هدف آزیموت</b><small>ورود هدف و اختلاف با مسیر</small>
</button>
<button class="m18-menu-card" data-m18-open="m18PanelSensor" onclick="if(window.m18OpenDirect){window.m18OpenDirect(this);}" ontouchend="if(window.m18OpenDirect){event.preventDefault();window.m18OpenDirect(this);}" type="button">
<span aria-label="سنسور و کالیبراسیون" class="m18-card-photo" role="img" style='background-image:url("data:image/webp;base64,")'></span><b>سنسور و کالیبراسیون</b><small>دقت، تراز و کالیبراسیون</small>
</button>
<button class="m18-menu-card" data-m18-open="m18PanelFlash" onclick="if(window.m18OpenDirect){window.m18OpenDirect(this);}" ontouchend="if(window.m18OpenDirect){event.preventDefault();window.m18OpenDirect(this);}" type="button">
<span aria-label="چراغ‌قوه" class="m18-card-photo" role="img" style='background-image:url("data:image/webp;base64,")'></span><b>چراغ‌قوه</b><small>روشن و خاموش کردن چراغ LED</small>
</button>
<button class="m18-menu-card" data-m18-open="m18PanelRuler" onclick="if(window.m18OpenDirect){window.m18OpenDirect(this);}" ontouchend="if(window.m18OpenDirect){event.preventDefault();window.m18OpenDirect(this);}" type="button">
<span aria-label="خط‌کش دیجیتال" class="m18-card-photo" role="img" style='background-image:url("data:image/webp;base64,")'></span><b>خط‌کش دیجیتال</b><small>اندازه‌گیری با cm، mm و inch</small>
</button>
<button class="m18-menu-card" data-m18-open="m18PanelMetal" onclick="if(window.m18OpenDirect){window.m18OpenDirect(this);}" ontouchend="if(window.m18OpenDirect){event.preventDefault();window.m18OpenDirect(this);}" type="button">
<span aria-label="فلزیاب" class="m18-card-photo" role="img" style='background-image:url("data:image/webp;base64,")'></span><b>فلزیاب</b><small>تشخیص تغییر میدان مغناطیسی — فقط اندروید</small>
</button>
<button class="m18-menu-card" data-m18-open="m18PanelQibla" onclick="if(window.m18OpenDirect){window.m18OpenDirect(this);}" ontouchend="if(window.m18OpenDirect){event.preventDefault();window.m18OpenDirect(this);}" type="button">
<span aria-label="قبله‌نما" class="m18-card-photo" role="img" style='background-image:url("data:image/webp;base64,")'></span><b>قبله‌نما</b><small>جهت قبله با موقعیت GPS</small>
</button>
<button class="m18-menu-card" data-m18-open="m18PanelSpeed" onclick="if(window.m18OpenDirect){window.m18OpenDirect(this);}" ontouchend="if(window.m18OpenDirect){event.preventDefault();window.m18OpenDirect(this);}" type="button">
<span aria-label="سرعت‌سنج" class="m18-card-photo" role="img" style='background-image:url("data:image/webp;base64,")'></span><b>سرعت‌سنج</b><small>سرعت لحظه‌ای با GPS</small>
</button>
<button class="m18-menu-card" data-m18-open="m18PanelLevel" onclick="if(window.m18OpenDirect){window.m18OpenDirect(this);}" ontouchend="if(window.m18OpenDirect){event.preventDefault();window.m18OpenDirect(this);}" type="button">
<span aria-label="تراز دیجیتال" class="m18-card-photo" role="img" style='background-image:url("data:image/webp;base64,")'></span><b>تراز</b><small>تراز دیجیتال دو محوره</small>
</button>
</div>
<div class="m18-panel-card open" id="m18PanelCompass">
<div class="m18-panel-head"><span>🧭 قطب‌نمای زنده</span><em>۱</em></div>
<div class="m18-dial-wrap">
<div class="m18-dial" id="m18Dial">
<div class="m18-dir">N</div><div class="m18-dir south">S</div><div class="m18-east">E</div><div class="m18-west">W</div>
<div class="m18-needle"></div><div class="m18-center"></div>
</div>
</div>
<button class="m18-tool primary m18-wide" id="m18Start" type="button">🧭 شروع قطب‌نما</button>
<div class="m18-status" id="m18Status">برای شروع، دکمه «شروع قطب‌نما» را بزنید.</div>
</div>
<div class="m18-panel-card" id="m18PanelAzimuth">
<div class="m18-panel-head"><span>📐 آزیموت و جهت</span><em>۲</em></div>
<div class="m18-readout">
<div class="m18-value"><strong id="m18Azimuth">—°</strong><span>آزیموت</span><div class="m18-dms" id="m18Dms">—</div></div>
<div class="m18-value"><strong id="m18Direction">—</strong><span>جهت</span></div>
</div>
<button class="m18-tool" id="m18Lock" type="button">🔒 قفل آزیموت</button>
</div>
<div class="m18-panel-card" id="m18PanelTarget">
<div class="m18-panel-head"><span>🎯 هدف آزیموت</span><em>۳</em></div>
<div class="m18-target">
<div class="m18-target-title">آزیموت هدف</div>
<div class="m18-target-row"><input id="m18Target" max="359.9999" min="0" placeholder="۰٫۰۰۰°" step="0.001" type="number"/><button id="m18SetTarget" type="button">ثبت</button></div>
<div class="m18-delta" id="m18Delta">هنوز هدفی تعیین نشده است.</div>
</div>
</div>
<div class="m18-panel-card" id="m18PanelSensor">
<div class="m18-panel-head"><span>📱 سنسور و کالیبراسیون</span><em>۴</em></div>
<button class="m18-tool" id="m18Cal" type="button">↻ کالیبراسیون دستی</button>
<div class="m18-sensors">
<div class="m18-sensor">سنسور<b id="m18SensorState">منتظر</b></div>
<div class="m18-sensor">دقت<b id="m18Accuracy">—</b></div>
<div class="m18-sensor">تراز<b id="m18Level">—</b></div>
</div>
</div>
<div class="m18-panel-card" id="m18PanelFlash">
<div class="m18-panel-head"><span>🔦 چراغ‌قوه</span><em>۵</em></div>
<div class="m18-flash-box"><div class="m18-flash-lamp" id="m18FlashLamp">🔦</div><b id="m18FlashState">خاموش</b><small>در نسخه اندروید، کنترل چراغ با پل native انجام می‌شود؛ در مرورگر از قابلیت torch دوربین در صورت پشتیبانی استفاده می‌شود.</small></div>
<button class="m18-tool primary" id="m18FlashToggle" type="button">🔦 روشن کردن چراغ‌قوه</button>
<div class="m18-status" id="m18FlashStatus">چراغ‌قوه خاموش است.</div>
</div>
<div class="m18-panel-card" id="m18PanelRecords">
<div class="m18-panel-head"><span>📋 ثبت مشاهدات</span><em>۵</em></div>
<button class="m18-tool primary" id="m18Save" type="button">＋ ذخیره قرائت فعلی</button>
<div class="m18-records">
<div class="m18-records-title">قرائت‌های ذخیره‌شده</div>
<div id="m18Records"><div class="m18-empty">هنوز قرائتی ذخیره نشده است.</div></div>
<button class="m18-tool danger" id="m18ClearRecords" style="width:100%;margin-top:7px;min-height:38px" type="button">🗑 پاک کردن قرائت‌ها</button>
</div>
</div>
<div class="m18-panel-card" id="m18PanelRuler">
<div class="m18-panel-head"><span>📏 خط‌کش دیجیتال</span><em>۶</em></div>
<div class="m18-ruler-summary"><div><small>فاصله بین دو نشانگر</small><strong id="m18RulerValue">9.60 cm</strong></div><div class="m18-ruler-units"><button data-ruler-unit="inch" type="button">inch</button><button data-ruler-unit="mm" type="button">mm</button><button class="selected" data-ruler-unit="cm" type="button">cm</button></div></div>
<div class="m18-ruler-track" id="m18RulerTrack"><div class="m18-ruler-line"></div><div class="m18-ruler-ticks"></div><div aria-label="نشانگر اول" class="m18-ruler-marker first" id="m18RulerMarker1" role="slider" tabindex="0"><span>۱</span></div><div aria-label="نشانگر دوم" class="m18-ruler-marker second" id="m18RulerMarker2" role="slider" tabindex="0"><span>۲</span></div></div>
<div class="m18-ruler-controls"><label>نشانگر ۱ <input id="m18RulerPos1" max="100" min="0" step="0.1" type="range" value="10"/></label><label>نشانگر ۲ <input id="m18RulerPos2" max="100" min="0" step="0.1" type="range" value="90"/></label></div>
<div class="m18-ruler-calibration"><label for="m18RulerCalLength">طول واقعی کل کادر (cm، با خط‌کش فیزیکی اندازه بگیر)</label><input id="m18RulerCalLength" max="100" min="0.1" placeholder="12" step="0.01" type="number" value="12"/></div>
<div class="m18-status">برای دقت واقعی، ابتدا ارتفاع فیزیکی کل کادر را با خط‌کش اندازه بگیر و وارد کن. بدون کالیبراسیون، عدد فقط تخمینی است؛ اندازه فیزیکی صفحه در گوشی‌ها متفاوت است.</div>
</div>
<div class="m18-panel-card" id="m18PanelMetal">
<div class="m18-panel-head"><span>🧲 فلزیاب مغناطیسی اندروید</span><em>۷</em></div>
<div class="m18-readout"><div class="m18-value"><strong id="m18MetalValue">— µT</strong><span>شدت میدان مغناطیسی</span></div><div class="m18-value"><strong id="m18MetalDelta">— µT</strong><span>تغییر نسبت به مبنا</span></div></div>
<button class="m18-tool primary" id="m18MetalStart" type="button">🧲 شروع اسکن</button>
<button class="m18-tool" id="m18MetalCal" style="margin-top:7px" type="button">تنظیم مبنای محیط</button>
<div class="m18-status" id="m18MetalStatus">فقط اندروید؛ به حسگر مغناطیسی واقعی و پشتیبانی مرورگر نیاز دارد. فلزات غیرمغناطیسی را تضمینی تشخیص نمی‌دهد.</div>
</div>
<div class="m18-panel-card" id="m18PanelQibla">
<div class="m18-panel-head"><span>🕋 قبله‌نما</span><em>۸</em></div>
<div class="m18-readout">
<div class="m18-value"><strong id="m18QiblaAz">—°</strong><span>آزیموت قبله</span><div class="m18-dms" id="m18QiblaDir">—</div></div>
<div class="m18-value"><strong id="m18QiblaDiff">—</strong><span>اختلاف با گوشی</span></div>
</div>
<button class="m18-tool primary" id="m18QiblaStart" type="button">📍 دریافت موقعیت و محاسبه قبله</button>
<div class="m18-status" id="m18QiblaStatus">برای محاسبه جهت قبله، موقعیت GPS را دریافت کنید.</div>
</div>
<div class="m18-panel-card" id="m18PanelSpeed">
<div class="m18-panel-head"><span>🏃 سرعت‌سنج GPS</span><em>۹</em></div>
<div class="m18-readout">
<div class="m18-value"><strong id="m18Speed">—</strong><span>کیلومتر بر ساعت</span></div>
<div class="m18-value"><strong id="m18SpeedMs">—</strong><span>متر بر ثانیه</span></div>
</div>
<button class="m18-tool primary" id="m18SpeedStart" type="button">📍 شروع سرعت‌سنج GPS</button>
<div class="m18-status" id="m18SpeedStatus">سرعت فقط از GPS دستگاه خوانده می‌شود.</div>
</div>
<div class="m18-panel-card" id="m18PanelLevel">
<div class="m18-panel-head"><span>⚖️ تراز دیجیتال</span><em>۱۰</em></div>
<div class="m18-level-box" id="m18LevelBox"><div class="m18-level-bubble" id="m18LevelBubble"></div><div class="m18-level-cross"></div></div>
<div class="m18-readout">
<div class="m18-value"><strong id="m18Beta">—</strong><span>محور طولی</span></div>
<div class="m18-value"><strong id="m18Gamma">—</strong><span>محور عرضی</span></div>
</div>
<div class="m18-status" id="m18LevelStatus">گوشی را روی سطح قرار دهید تا تراز دیجیتال نمایش داده شود.</div>
</div>
</section>
<style id="m18v2-style">
#m18-hero-card{margin-top:8px}
.m18-hero-card{padding:16px 12px;text-align:center;border:2px solid #59665a;border-radius:16px;background:linear-gradient(145deg,#eef4eb,#d6e0d3);box-shadow:inset 0 1px #fff,0 4px 10px rgba(20,35,20,.16)}
.m18-hero-icon{font-size:40px;line-height:1}.m18-hero-title{font-size:24px;font-weight:1000;color:#1f2a20;margin-top:5px}.m18-hero-sub{font-size:10px;line-height:1.8;color:#566154;margin-top:4px}
.m18-card-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}
.m18-menu-card{min-height:104px;padding:10px 7px;border:2px solid #667365;border-radius:13px;background:linear-gradient(#f4f7f2,#dce5da);box-shadow:inset 0 1px #fff,0 3px 7px rgba(30,45,30,.14);cursor:pointer;color:#263126;text-align:center;font-family:inherit}
.m18-menu-card.active{border-color:#43804a;background:linear-gradient(#e9f6e7,#cfe6ce);box-shadow:0 0 0 2px rgba(67,128,74,.13),inset 0 1px #fff,0 4px 9px rgba(30,60,30,.16)}
.m18-card-icon{display:block;font-size:28px;line-height:1.1;margin-bottom:5px}.m18-menu-card b{display:block;font-size:14px}.m18-menu-card small{display:block;font-size:9px;line-height:1.55;color:#5b665a;margin-top:5px}
.m18-panel-card{display:none;margin-top:9px;padding:11px;border:2px solid #59655a;border-radius:14px;background:linear-gradient(145deg,#f2f6ef,#dce5d9);box-shadow:inset 0 1px #fff,0 3px 8px rgba(30,45,30,.13);scroll-margin-top:12px}
.m18-panel-card.open{display:block;animation:m18Open .18s ease-out}.m18-panel-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px;font-size:15px;font-weight:1000;color:#263126;direction:rtl}.m18-panel-head em{font-style:normal;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#485248;color:#fff;font-size:12px;direction:ltr}
@keyframes m18Open{from{opacity:.4;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}
.m18-dial-wrap{width:100%;max-width:350px;aspect-ratio:1/1;margin:7px auto 9px;position:relative}.m18-dial{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle,#f9fbf8 0 55%,#e2e8e0 56% 68%,#4b584b 69% 70%,#d9e0d6 71% 100%);border:6px solid #3e4b3e;box-shadow:inset 0 0 22px rgba(0,0,0,.18),0 6px 14px rgba(0,0,0,.27);transition:transform .12s linear;overflow:hidden}.m18-dial:before{content:'';position:absolute;inset:6%;border-radius:50%;background:repeating-conic-gradient(from 0deg,rgba(45,55,45,.75) 0deg 1deg,transparent 1deg 6deg);-webkit-mask:radial-gradient(circle,transparent 0 67%,#000 68% 70%,transparent 71%);mask:radial-gradient(circle,transparent 0 67%,#000 68% 70%,transparent 71%)}.m18-dial:after{content:'';position:absolute;inset:11%;border-radius:50%;border:1px solid rgba(50,60,50,.2);box-shadow:inset 0 0 0 12px rgba(255,255,255,.18)}
.m18-dir{position:absolute;inset:0;display:flex;align-items:flex-start;justify-content:center;padding-top:18px;font-size:27px;font-weight:1000;color:#bd1e1e;text-shadow:0 1px 1px #fff;z-index:2}.m18-dir.south{align-items:flex-end;padding-top:0;padding-bottom:18px;color:#202820}.m18-east,.m18-west{position:absolute;top:50%;transform:translateY(-50%);font-size:25px;font-weight:1000;color:#202820;z-index:2}.m18-east{right:18px;color:#1766d5}.m18-west{left:18px;color:#1766d5}.m18-needle{position:absolute;left:50%;top:50%;width:0;height:0;border-left:14px solid transparent;border-right:14px solid transparent;border-bottom:100px solid #e43824;transform:translate(-50%,-100%);filter:drop-shadow(0 2px 2px rgba(0,0,0,.4));z-index:4}.m18-needle:after{content:'';position:absolute;left:-14px;top:96px;border-left:14px solid transparent;border-right:14px solid transparent;border-top:100px solid #3a433a}.m18-center{position:absolute;left:50%;top:50%;width:38px;height:38px;border-radius:50%;background:#eef2ec;border:5px solid #313a31;transform:translate(-50%,-50%);z-index:5;box-shadow:0 2px 6px rgba(0,0,0,.35)}
.m18-readout{display:grid;grid-template-columns:1.35fr .65fr;gap:8px;margin:4px 0 9px}.m18-value{background:#182018;color:#f5f8f2;border-radius:11px;padding:8px 5px;border:2px solid #778274;text-align:center}.m18-value strong{display:block;font-size:25px;color:#a9f0a4;direction:ltr}.m18-value span{font-size:11px}.m18-dms{font-size:13px;color:#dfeadf;margin-top:2px;direction:ltr}.m18-tool{width:100%;border:2px solid #596657;border-radius:11px;background:linear-gradient(#f7faf6,#c8d1c5);min-height:45px;font-size:14px;font-weight:900;color:#182018;box-shadow:0 2px 5px rgba(0,0,0,.16);font-family:inherit}.m18-tool.primary{background:linear-gradient(#b6e99e,#70b35b)}.m18-tool.danger{background:linear-gradient(#f5dddd,#ddb5b5)}.m18-wide{margin-top:2px}.m18-target{padding:9px;border-radius:12px;background:rgba(255,255,255,.58);border:1px solid #a9b3a6}.m18-target-title{font-size:13px;font-weight:900;margin-bottom:6px}.m18-target-row{display:grid;grid-template-columns:1fr auto;gap:7px}.m18-target input{width:100%;box-sizing:border-box;border:2px solid #748070;border-radius:9px;padding:10px;text-align:center;font-size:18px;font-weight:900;direction:ltr;background:#fff}.m18-target button{border:0;border-radius:9px;padding:0 15px;font-weight:900;background:#283528;color:#fff;font-family:inherit}.m18-delta{margin-top:6px;font-weight:900;font-size:14px;min-height:20px;text-align:center}.m18-delta.ok{color:#187a25}.m18-delta.warn{color:#a34b00}.m18-sensors{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-top:9px}.m18-sensor{background:#f7f9f5;border:1px solid #aeb7aa;border-radius:9px;padding:7px 3px;font-size:10px;color:#4a5448;text-align:center}.m18-sensor b{display:block;font-size:12px;color:#182018;margin-top:2px;direction:rtl}.m18-status{margin-top:8px;font-size:12px;font-weight:800;color:#334033;min-height:20px;line-height:1.6;text-align:center}.m18-records{margin-top:9px;text-align:right;background:rgba(255,255,255,.58);border-radius:12px;padding:9px;border:1px solid #adb6aa}.m18-records-title{font-weight:900;font-size:13px;margin-bottom:6px}.m18-record{display:grid;grid-template-columns:.5fr 1fr 1fr 1fr;gap:4px;padding:6px 3px;border-top:1px solid #c5ccc1;font-size:10px;direction:ltr;text-align:center}.m18-record:first-of-type{border-top:0}.m18-record b{font-size:11px}.m18-empty{font-size:11px;color:#687166;text-align:center;padding:5px}.m18-note{margin-top:0;padding:10px;border-radius:9px;background:rgba(255,255,255,.5);font-size:11px;line-height:1.8;color:#394339}.m18-convert-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.m18-convert-grid label{font-size:11px;font-weight:900;color:#4b564a}.m18-convert-grid input{display:block;width:100%;box-sizing:border-box;margin-top:5px;height:43px;border:2px solid #788477;border-radius:9px;padding:8px;text-align:center;font-size:16px;font-weight:900;background:#fff;direction:ltr}.m18-guide{text-align:center}.m18-level-box{width:min(260px,80vw);aspect-ratio:1;margin:10px auto;border-radius:50%;border:6px solid #3f4b40;background:radial-gradient(circle,#f8faf7 0 34%,#d9e2d7 35% 62%,#59655a 63% 65%,#e9eee7 66%);position:relative;overflow:hidden;box-shadow:inset 0 0 20px rgba(0,0,0,.16),0 5px 12px rgba(0,0,0,.18)}.m18-level-bubble{position:absolute;left:50%;top:50%;width:42px;height:42px;border-radius:50%;background:#8bd36d;border:4px solid #2d5428;box-shadow:0 2px 7px rgba(0,0,0,.25);transform:translate(-50%,-50%);transition:transform .12s ease}.m18-level-cross{position:absolute;left:50%;top:50%;width:82%;height:2px;background:rgba(40,50,40,.38);transform:translate(-50%,-50%)}.m18-level-cross:after{content:'';position:absolute;left:50%;top:-40px;width:2px;height:82px;background:rgba(40,50,40,.38)}
.m18-ruler-summary{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px;border-radius:18px;background:#fff;margin:8px 0 12px}.m18-ruler-summary small{display:block;color:#7b8798;font-weight:800;font-size:11px}.m18-ruler-summary strong{display:block;color:#2563eb;font-size:26px;direction:ltr;text-align:right;margin-top:3px}.m18-ruler-units{display:flex;background:#f2f5fa;border-radius:28px;padding:4px;gap:2px}.m18-ruler-units button{border:0;border-radius:24px;padding:10px 12px;background:transparent;color:#667085;font-weight:900}.m18-ruler-units button.selected{background:#2563eb;color:white}.m18-ruler-track{height:clamp(566px,84.86dvh,1130px);min-height:566px;position:relative;overflow:hidden;background:#eff4ff;border-radius:8px;border:2px solid #e45b64;margin:8px -5px}.m18-ruler-line{position:absolute;inset:0;background:repeating-linear-gradient(to bottom,#64748b 0 1px,transparent 1px 10px);opacity:.55}.m18-ruler-ticks{position:absolute;inset:0;background:repeating-linear-gradient(to bottom,transparent 0 49px,#4b5563 49px 51px,transparent 51px 98px);pointer-events:none}.m18-ruler-marker{position:absolute;left:0;right:0;height:0;border-top:2px solid #ef4444;touch-action:none;cursor:ns-resize}.m18-ruler-marker.second{border-color:#3b82f6}.m18-ruler-marker span{position:absolute;top:-18px;left:0;width:36px;height:36px;border-radius:50%;background:#ef4444;color:white;display:grid;place-items:center;font-weight:900;box-shadow:0 2px 5px #0002}.m18-ruler-marker.second span{top:-18px;left:auto;right:0;background:#3b82f6}.m18-ruler-controls{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.m18-ruler-controls label{font-size:11px;font-weight:900}.m18-ruler-controls input{width:100%;accent-color:#2563eb}.m18-ruler-calibration{margin-top:10px;padding:9px;border-radius:10px;background:#fff}.m18-ruler-calibration label{display:block;font-size:11px;font-weight:900;margin-bottom:5px}.m18-ruler-calibration input{box-sizing:border-box;width:100%;padding:9px;border:1px solid #cbd5e1;border-radius:8px;font-size:16px;direction:ltr}
@media(max-width:420px){.m18-menu-card{min-height:98px}.m18-card-icon{font-size:25px}.m18-menu-card b{font-size:13px}.m18-menu-card small{font-size:8px}.m18-needle{border-bottom-width:88px}.m18-needle:after{top:84px;border-top-width:88px}}

/* BUILD 66: photographic navigation cards, fully offline */
.m18-card-grid{gap:10px}
.m18-menu-card{min-height:166px;padding:7px 7px 10px;display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;overflow:hidden;gap:5px}
.m18-card-photo{display:block;width:100%;height:88px;flex:0 0 88px;border-radius:9px;background-size:cover;background-position:center;border:1px solid rgba(35,55,35,.28);box-shadow:inset 0 -18px 22px rgba(0,0,0,.08)}
.m18-card-icon{font-size:20px;line-height:1;margin:0}
.m18-menu-card b{font-size:13px;line-height:1.3}
.m18-menu-card small{font-size:9px;line-height:1.45;margin-top:0}
.m18-menu-card.active .m18-card-photo{outline:2px solid #43804a;outline-offset:-2px}
@media(max-width:420px){.m18-menu-card{min-height:156px;padding:6px}.m18-card-photo{height:78px;flex-basis:78px}.m18-menu-card b{font-size:12px}.m18-menu-card small{font-size:8px}}
</style>
<style id="m18flash-magnify-style">
.m18-flash-box{text-align:center;padding:14px 10px;border-radius:13px;background:#182018;color:#f4f8f2;border:2px solid #6b7768}.m18-flash-lamp{font-size:58px;line-height:1;margin-bottom:6px;filter:grayscale(1)}.m18-flash-box.on .m18-flash-lamp{filter:none;text-shadow:0 0 18px #fff000}.m18-flash-box b{display:block;color:#a9f0a4;font-size:17px}.m18-flash-box small{display:block;color:#d8e3d5;font-size:9px;line-height:1.7;margin-top:6px}.m18-magnify-wrap{position:relative;width:100%;aspect-ratio:4/3;background:#101510;border:2px solid #596657;border-radius:13px;overflow:hidden}.m18-magnify-wrap video{width:100%;height:100%;object-fit:cover;display:block}.m18-magnify-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;color:#dce7da;font-size:13px;padding:20px}.m18-mag-controls{margin-top:9px;padding:9px;border:1px solid #aeb7aa;border-radius:10px;background:rgba(255,255,255,.55)}.m18-mag-controls label{display:block;font-size:12px;font-weight:900;text-align:center}.m18-mag-controls b{direction:ltr}.m18-mag-controls input{width:100%;margin-top:7px}
</style>
<style id="m19c-camera-style">
#m19cCamera .m19c-hero{padding:12px;border:2px solid #5d6b5a;border-radius:14px;background:linear-gradient(145deg,#eef3eb,#d5ded1);box-shadow:inset 0 1px #fff,0 3px 8px rgba(20,35,20,.15);text-align:center}
#m19cCamera .m19c-hero-title{font-size:19px;font-weight:1000;color:#243226}.m19c-hero-sub{font-size:10px;line-height:1.7;color:#566154;margin-top:5px}
#m19cCamera .m19c-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}.m19c-camera-card{min-height:104px;padding:12px;border:2px solid #647163;border-radius:12px;background:linear-gradient(#f1f4ef,#dbe3d8);box-shadow:inset 0 1px #fff,0 3px 7px rgba(30,45,30,.14);cursor:pointer;text-align:center;color:#253226}.m19c-camera-card b{display:block;font-size:15px;margin-bottom:6px}.m19c-camera-card span{display:block;font-size:10px;line-height:1.55;color:#566154}.m19c-camera-card.primary{border-color:#4b8a50;background:linear-gradient(#e8f5e6,#cfe4ce)}
#m19cCamera .m19c-panel{margin-top:9px;padding:11px;border:2px solid #59655a;border-radius:12px;background:rgba(235,240,231,.72)}.m19c-panel h3{margin:0 0 8px;font-size:14px}.m19c-point-grid{display:grid;grid-template-columns:1fr auto;gap:7px}.m19c-point-grid select{height:40px}.m19c-camera-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.m19c-photo-input{display:none}.m19c-photo-preview{margin-top:8px;border:2px solid #59655a;border-radius:10px;background:#111;overflow:hidden;text-align:center}.m19c-photo-preview img{display:block;width:100%;max-height:420px;object-fit:contain}.m19c-meta{font-size:10px;line-height:1.7;margin-top:7px;padding:8px;border:1px dashed #687364;border-radius:8px;background:rgba(255,255,255,.35)}
#m19cCamera .m19c-gallery{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.m19c-photo-card{border:2px solid #59655a;border-radius:10px;overflow:hidden;background:#e7ece4}.m19c-photo-card img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;background:#111}.m19c-photo-body{padding:7px;font-size:10px;line-height:1.55}.m19c-photo-body b{font-size:11px}.m19c-photo-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:6px}.m19c-photo-actions .btn{min-width:0;width:100%;box-sizing:border-box;white-space:normal;overflow-wrap:anywhere;padding-left:4px;padding-right:4px;line-height:1.25}.m19c-empty{text-align:center;padding:18px 8px;border:2px dashed #697467;font-size:11px;color:#596356}.m19c-note{font-size:9px;line-height:1.7;color:#5c665a;margin-top:8px;text-align:center}
#m19cCamera .m19c-marker-preview{position:relative;margin-top:8px;background:#111;border-radius:10px;overflow:hidden;touch-action:manipulation}.m19c-marker-stage{position:relative;width:100%;line-height:0;background:#111;overflow:hidden;cursor:crosshair;touch-action:none}.m19c-marker-stage img{display:block;width:100%;max-height:520px;object-fit:contain;margin:0 auto;user-select:none;-webkit-user-drag:none}.m19c-marker-dot{position:absolute;left:50%;top:50%;width:34px;height:34px;transform:translate(-50%,-50%);border:3px solid #ff3030;border-radius:50%;box-sizing:border-box;display:none;pointer-events:none;filter:drop-shadow(0 1px 2px #000)}.m19c-marker-dot:before,.m19c-marker-dot:after{content:"";position:absolute;left:50%;top:50%;background:#ff3030;transform:translate(-50%,-50%)}.m19c-marker-dot:before{width:46px;height:3px}.m19c-marker-dot:after{width:3px;height:46px}.m19c-marker-dot span{position:absolute;left:50%;top:-27px;transform:translateX(-50%);white-space:nowrap;background:rgba(0,0,0,.78);color:#fff;border-radius:7px;padding:4px 7px;font:900 11px Arial,Tahoma,sans-serif;direction:rtl}.m19c-marker-hint{padding:8px;background:rgba(0,0,0,.78);color:#fff;text-align:center;font:800 11px Arial,Tahoma,sans-serif;direction:rtl;line-height:1.6}.m19c-marker-label{padding:7px 9px;background:rgba(0,0,0,.72);color:#fff;font:900 12px Arial,Tahoma,sans-serif;text-align:center;direction:rtl}
@media(max-width:560px){#m19cCamera .m19c-grid{grid-template-columns:1fr}.m19c-camera-actions{grid-template-columns:1fr}.m19c-gallery{grid-template-columns:1fr 1fr!important}}
#m19cPhotoViewer{position:fixed;inset:0;z-index:2147483000;background:rgba(0,0,0,.94);display:none;align-items:center;justify-content:center;padding:14px;box-sizing:border-box;touch-action:none}#m19cPhotoViewer.open{display:flex}#m19cPhotoViewer .m19c-viewer-img{max-width:96vw;max-height:88vh;width:auto;height:auto;object-fit:contain;border-radius:8px;box-shadow:0 0 0 2px rgba(255,255,255,.18),0 12px 35px rgba(0,0,0,.55);user-select:none;-webkit-user-drag:none}#m19cPhotoViewer .m19c-viewer-close{position:absolute;top:12px;right:12px;width:46px;height:46px;border:2px solid #fff;border-radius:50%;background:rgba(0,0,0,.72);color:#fff;font-size:28px;font-weight:900;z-index:2}#m19cPhotoViewer .m19c-viewer-info{position:absolute;left:12px;right:12px;bottom:12px;padding:8px 10px;border-radius:9px;background:rgba(0,0,0,.72);color:#fff;text-align:center;font:800 11px/1.7 Arial,Tahoma,sans-serif;direction:rtl;max-height:25vh;overflow:auto}

/* V555 — Menu 19 Stage 1: professional annotation zoom / pan / marker drag */
#m19cCamera .m19c-zoom-tools{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;margin-top:7px}
#m19cCamera .m19c-zoom-tools .btn{min-width:0;min-height:42px;padding:6px 4px;font-size:11px;font-weight:900}
#m19cCamera .m19c-marker-mode{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:7px}
#m19cCamera .m19c-marker-mode .btn{min-height:40px;font-weight:900}
#m19cCamera .m19c-marker-mode .btn.active{outline:3px solid rgba(75,138,80,.28);border-color:#4b8a50;background:linear-gradient(#e8f5e6,#cfe4ce)}
#m19cCamera .m19c-marker-stage{position:relative;overflow:hidden;cursor:crosshair}
#m19cCamera .m19c-zoom-layer{position:relative;width:100%;transform-origin:0 0;will-change:transform;line-height:0}
#m19cCamera .m19c-zoom-layer img{width:100%;height:auto;display:block;max-height:none;object-fit:contain;user-select:none;-webkit-user-drag:none;pointer-events:none}
#m19cCamera .m19c-marker-stage.pan-mode{cursor:grab}
#m19cCamera .m19c-marker-stage.pan-mode:active{cursor:grabbing}
#m19cCamera .m19c-zoom-readout{font:900 10px Arial,Tahoma,sans-serif;text-align:center;color:#5c665a;margin-top:5px;direction:rtl}
@media(max-width:560px){#m19cCamera .m19c-zoom-tools{grid-template-columns:repeat(5,1fr)}#m19cCamera .m19c-zoom-tools .btn{font-size:10px}}
#m19cCamera .m19c-dashboard{margin-top:9px;padding:10px;border:2px solid #59655a;border-radius:12px;background:linear-gradient(145deg,#f3f6f0,#dfe7dc);box-shadow:inset 0 1px #fff,0 3px 7px rgba(30,45,30,.12)}
#m19cCamera .m19c-dashboard-title{font-size:14px;font-weight:1000;color:#253226;margin-bottom:8px;text-align:right;direction:rtl}
#m19cCamera .m19c-dashboard-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
#m19cCamera .m19c-dash-item{padding:8px 4px;border:1px solid #8a9785;border-radius:9px;background:rgba(255,255,255,.55);text-align:center;direction:rtl}
#m19cCamera .m19c-dash-item b{display:block;font-size:18px;line-height:1.1;color:#243226}.m19c-dash-item span{display:block;font-size:9px;color:#5b6659;margin-top:4px}
#m19cCamera .m19c-note-editor{margin-top:7px;padding-top:7px;border-top:1px dashed #7b8677}
#m19cCamera .m19c-note-editor textarea{width:100%;min-height:58px;resize:vertical;box-sizing:border-box;border:1px solid #7a8776;border-radius:8px;padding:7px;background:rgba(255,255,255,.75);font:700 11px/1.7 Arial,Tahoma,sans-serif;direction:rtl}
#m19cCamera .m19c-note-row{margin-top:5px}.m19c-note-row .btn{width:100%}

/* V558 — Menu 19 photo cards */
#m19cCamera .m19c-grid{grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch}
#m19cCamera .m19c-camera-card{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;gap:7px;min-width:0;min-height:178px;padding:8px;box-sizing:border-box;overflow:hidden}
#m19cCamera .m19c-camera-card .m19c-card-image{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;flex:0 0 auto;border:1px solid rgba(75,94,72,.42);border-radius:8px;background:#e4eadf}
#m19cCamera .m19c-camera-card b{display:block;margin:0;font-size:13px;line-height:1.55;font-weight:1000;overflow-wrap:anywhere}
#m19cCamera .m19c-camera-card span{display:block;font-size:10px;line-height:1.55;overflow-wrap:anywhere}
#m19cCamera #m19cBtnPhotoMeasure{grid-column:1/-1}
@media(max-width:560px){#m19cCamera .m19c-grid{grid-template-columns:repeat(2,minmax(0,1fr))}#m19cCamera .m19c-camera-card{min-height:160px;padding:7px;gap:6px}#m19cCamera .m19c-camera-card b{font-size:12px;line-height:1.45}#m19cCamera .m19c-camera-card span{font-size:9px;line-height:1.5}}
@media(max-width:340px){#m19cCamera .m19c-grid{grid-template-columns:1fr}#m19cCamera #m19cBtnPhotoMeasure{grid-column:auto}}


