  #training #m16lib .m16lib-card.main{padding:7px 7px 10px!important;border-radius:15px!important}
  #training #m16lib .m16lib-photo{height:96px!important;flex-basis:96px!important;border-radius:11px!important}
  #training #m16lib .m16lib-card b{font-size:12px!important;line-height:1.55!important}
