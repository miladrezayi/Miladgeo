<div class="m16lib-detail" id="m16lib-forms">
<h3>📝 فرم‌ها و جداول آماده نقشه‌برداری</h3>
<p>نوع فرم را انتخاب کن، اطلاعات پروژه را وارد کن و برای چاپ یا ذخیره به PDF از دکمه چاپ استفاده کن.</p>
<style>
.m16-form-tools{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.m16-form-tools select,.m16-form-tools input{min-width:0;flex:1;padding:10px;border:1px solid #9ba99d;border-radius:9px;background:#fff;color:#223}.m16-form-wrap{overflow-x:auto}.m16-form-table{width:100%;border-collapse:collapse;background:#fff;color:#222;min-width:600px}.m16-form-table th,.m16-form-table td{border:1px solid #89968c;padding:7px;text-align:center}.m16-form-table th{background:#e4ece5}.m16-form-table input{width:100%;min-width:65px;box-sizing:border-box;border:0;background:transparent;padding:5px;color:#222}.m16-form-brand{text-align:center;font-size:17px;font-weight:800;margin:0 0 10px;color:#111}.m16-form-meta{display:flex;justify-content:center;align-items:center;gap:24px;text-align:center!important;width:100%;margin:0 0 12px;font-size:12px}.m16-form-signatures{display:flex;justify-content:space-between;gap:30px;margin:25px 10px 0;page-break-inside:avoid;text-align:center}.m16-form-signature{width:45%;text-align:center;font-size:11px}.m16-form-sign-line{border-bottom:1px solid #555;height:24px;margin:6px 8px 0}.m16-form-note{font-size:13px;color:#536458;line-height:1.8}.m16-form-tools label{display:flex;flex-direction:column;gap:5px;font-weight:600}.m16-form-tools input:focus,.m16-form-tools select:focus{outline:2px solid #4b8b62;outline-offset:1px}.m16-form-table td input:focus{background:#f0f8f1;outline:1px solid #4b8b62}
@media print{@page{size:A4 portrait;margin:12mm}html,body{background:#fff!important;margin:0!important;padding:0!important}body *{visibility:hidden!important}#m16lib-forms{display:block!important;visibility:visible!important;position:absolute!important;left:0!important;top:0!important;width:100%!important;max-width:100%!important;box-sizing:border-box!important;background:#fff!important;color:#000!important;padding:0!important;margin:0!important;border:0!important;box-shadow:none!important}#m16lib-forms *{visibility:visible!important}#m16lib-forms>h3,#m16lib-forms>p,#m16lib-forms>.m16-form-tools,#m16lib-forms>.m16-form-actions,#m16lib-forms>.close,#m16lib-forms>.m16-form-note,#m16lib-forms .m16-form-tools,#m16lib-forms .m16-form-actions,#m16lib-forms .close,#m16lib-forms .m16-form-note{display:none!important;visibility:hidden!important;height:0!important;margin:0!important;padding:0!important}#m16ReadyFormTable{display:block!important;visibility:visible!important;width:100%!important;overflow:visible!important}#m16ReadyFormTable .m16-form-brand{display:block!important;visibility:visible!important;text-align:center!important;width:100%!important;margin:0 0 10px!important;font-size:17px!important;font-weight:800!important;color:#000!important}#m16ReadyFormTable h4{display:block!important;text-align:center!important;width:100%!important;margin:0 0 12px!important;font-size:16px!important;font-weight:700!important}#m16ReadyFormTable .m16-form-meta{display:flex!important;justify-content:center!important;align-items:center!important;gap:24px!important;text-align:center!important;width:100%!important;margin:0 0 12px!important;font-size:12px!important}#m16ReadyFormTable .m16-form-table{width:100%!important;min-width:0!important;border-collapse:collapse!important;font-size:10px!important}#m16ReadyFormTable .m16-form-table th,#m16ReadyFormTable .m16-form-table td{text-align:center!important;border:1px solid #555!important;padding:5px!important}#m16ReadyFormTable .m16-form-table input{min-width:0!important;width:100%!important;color:#000!important}#m16ReadyFormTable .m16-form-signatures{display:flex!important;justify-content:space-between!important;text-align:center!important;gap:30px!important;margin:25px 10px 0!important;page-break-inside:avoid!important}#m16ReadyFormTable .m16-form-signature{display:block!important;width:45%!important;text-align:center!important;font-size:11px!important}#m16ReadyFormTable .m16-form-sign-line{display:block!important;border-bottom:1px solid #555!important;height:24px!important;margin:6px 8px 0!important}}
</style>
<div class="m16-form-tools"><label style="flex:1;min-width:130px">نوع فرم<select id="m16ReadyFormType" onchange="m16ReadyFormRender()"><option value="coord">جدول مختصات نقاط</option><option value="field">فرم برداشت زمینی</option><option value="level">دفترچه ترازیابی</option><option value="check">چک‌لیست کنترل عملیات</option><option value="traverse">دفترچه پیمایش</option><option value="stake">جدول پیاده‌سازی</option><option value="area">جدول محاسبه مساحت</option><option value="equipment">چک‌لیست کنترل تجهیزات</option><option value="daily">گزارش روزانه عملیات</option></select></label><label style="flex:1;min-width:130px">نام پروژه<input id="m16ReadyProject" placeholder="نام پروژه"/></label><label style="flex:1;min-width:130px">تاریخ شمسی<input aria-label="تاریخ شمسی پروژه" id="m16ReadyDate" inputmode="numeric" placeholder="۱۴۰۵/۰۱/۰۱"/></label></div>
<div class="m16-form-wrap" id="m16ReadyFormTable"></div>
<p class="m16-form-note">تاریخ پیش‌فرض به تقویم شمسی و بر اساس تاریخ دستگاه تنظیم می‌شود. این فرم‌ها قالب خام برای ثبت میدانی هستند؛ مقادیر را کاربر وارد می‌کند و برنامه محاسبات یا داده‌های میدانی را حدس نمی‌زند.</p>
<div class="m16-form-tools m16-form-actions"><button class="btn green" onclick="m16ReadyFormAddRow()" type="button">＋ افزودن ردیف</button><button class="btn green" onclick="m16ReadyFormPrint()" type="button">🖨️ چاپ / ذخیره PDF</button><button class="btn gray" onclick="m16ReadyFormClear()" type="button">پاک‌کردن داده‌ها</button></div>
<button class="btn gray close" onclick="m16LibClose();return false;" type="button">↑ بازگشت به کارت‌های کتابخانه</button>
</div>
<script>
(function(){
var defs={coord:{title:'جدول مختصات نقاط',heads:['ردیف','نام نقطه','E / X','N / Y','ارتفاع Z','توضیحات']},field:{title:'فرم برداشت زمینی',heads:['ردیف','ایستگاه','نقطه / هدف','زاویه افقی','زاویه قائم','فاصله','ارتفاع منشور','توضیحات']},level:{title:'دفترچه ترازیابی',heads:['ردیف','نقطه','قرائت عقب BS','قرائت میانی IS','قرائت جلو FS','ارتفاع دستگاه HI','ارتفاع نقطه RL','توضیحات']},check:{title:'چک‌لیست کنترل عملیات',heads:['ردیف','مورد کنترل','وضعیت','مقدار / نتیجه','نام کنترل‌کننده','توضیحات']},traverse:{title:'دفترچه پیمایش',heads:['ردیف','نام ایستگاه','نام نقطه بعد','زاویه افقی','فاصله افقی','آزیموت','مختصات E','مختصات N','توضیحات']},stake:{title:'جدول پیاده‌سازی',heads:['ردیف','نام نقطه','E طرح','N طرح','E موجود','N موجود','اختلاف E','اختلاف N','وضعیت اجرا']},area:{title:'جدول محاسبه مساحت',heads:['ردیف','نام نقطه','مختصات E / X','مختصات N / Y','حاصل‌ضرب متقاطع ۱','حاصل‌ضرب متقاطع ۲','توضیحات']},equipment:{title:'چک‌لیست کنترل تجهیزات',heads:['ردیف','نام دستگاه / ابزار','شماره سریال','وضعیت ظاهری','کنترل کالیبراسیون','متعلقات','نتیجه','توضیحات']},daily:{title:'گزارش روزانه عملیات نقشه‌برداری',heads:['ردیف','ساعت','شرح فعالیت','محدوده / ایستگاه','تعداد نقاط','نام مسئول','مانع / مشکل','اقدام انجام‌شده']}};
window.m16ReadyFormRender=function(){var sel=document.getElementById('m16ReadyFormType'),box=document.getElementById('m16ReadyFormTable');if(!sel||!box)return;var d=defs[sel.value]||defs.coord;var html='<div class="m16-form-brand">کنترل عملیات نقشه‌برداری میلادژئو</div><h4>'+d.title+'</h4><p class="m16-form-meta"><span>پروژه: '+(document.getElementById('m16ReadyProject').value||'................')+'</span><span>تاریخ: '+(document.getElementById('m16ReadyDate').value||'................')+'</span></p><table class="m16-form-table"><thead><tr>'+d.heads.map(function(h){return '<th>'+h+'</th>'}).join('')+'</tr></thead><tbody>';for(var r=0;r<8;r++){html+='<tr>';d.heads.forEach(function(h,c){html+='<td>'+(c===0?(r+1):'<input aria-label="'+h+' ردیف '+(r+1)+'" placeholder="">')+'</td>'});html+='</tr>'}html+='</tbody></table><div class="m16-form-signatures"><div class="m16-form-signature"><div>امضا مهندس پیمانکار</div><div class="m16-form-sign-line"></div></div><div class="m16-form-signature"><div>امضا مهندس ناظر</div><div class="m16-form-sign-line"></div></div></div>';box.innerHTML=html;};
window.m16ReadyFormPrint=function(){try{var box=document.getElementById('m16ReadyFormTable');if(!box)return false;var clone=box.cloneNode(true);clone.querySelectorAll('input').forEach(function(inp){var td=inp.parentElement;td.textContent=inp.value||' ';td.style.minHeight='24px'});var project=(document.getElementById('m16ReadyProject').value||'................').replace(/[<>&\"']/g,function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','\"':'&quot;',"'":'&#39;'}[c]});var date=(document.getElementById('m16ReadyDate').value||'................').replace(/[<>&\"']/g,function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','\"':'&quot;',"'":'&#39;'}[c]});var meta='<div class="m16-print-meta"><span>پروژه: '+project+'</span><span>تاریخ: '+date+'</span></div>';var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><title>کنترل عملیات نقشه‌برداری میلادژئو</title><style>@page{size:A4 portrait;margin:12mm}*{box-sizing:border-box}body{font-family:Tahoma,Arial,sans-serif;color:#111;margin:0;font-size:11px}.m16-form-brand{text-align:center;font-size:17px;font-weight:800;margin:0 0 12px}.m16-form-meta{display:none!important}h4{text-align:center;font-size:15px;margin:0 0 12px}.m16-print-meta{display:flex;justify-content:center;align-items:center;gap:36px;text-align:center;width:100%;margin:0 0 12px;font-size:12px}.m16-form-table{width:100%;border-collapse:collapse;table-layout:auto;font-size:10px}.m16-form-table th,.m16-form-table td{border:1px solid #555;text-align:center;padding:5px;overflow-wrap:anywhere}.m16-form-table th{font-weight:bold;background:#eee}.m16-form-signatures{display:flex;justify-content:space-between;gap:30px;margin:25px 10px 0;page-break-inside:avoid;text-align:center}.m16-form-signature{width:45%;text-align:center;font-size:11px}.m16-form-sign-line{border-bottom:1px solid #555;height:24px;margin:6px 8px 0}</style></head><body>'+clone.querySelector('.m16-form-brand').outerHTML+clone.querySelector('h4').outerHTML+meta+clone.querySelector('.m16-form-table').outerHTML+clone.querySelector('.m16-form-signatures').outerHTML+'</body></html>';if(typeof window.miladgeoM17PrintHtml==='function'){window.miladgeoM17PrintHtml(html,'MiladGeo_Survey_Report.pdf');return false}showToast('موتور چاپ منو ۱۷ در دسترس نیست.');return false}catch(e){console.error('M16_READY_FORM_PRINT',e);if(typeof showToast==='function')showToast('ساخت PDF ناموفق بود');return false}};
document.addEventListener('input',function(e){if(e.target&& (e.target.id==='m16ReadyProject'||e.target.id==='m16ReadyDate')){var meta=document.querySelector('#m16ReadyFormTable .m16-form-meta');if(meta){var spans=meta.querySelectorAll('span');if(spans.length>1){spans[0].textContent='پروژه: '+(document.getElementById('m16ReadyProject').value||'................');spans[1].textContent='تاریخ: '+(document.getElementById('m16ReadyDate').value||'................')}}}});
window.m16ReadyFormAddRow=function(){var box=document.getElementById('m16ReadyFormTable'),tbody=box&&box.querySelector('tbody');if(!tbody)return;var type=document.getElementById('m16ReadyFormType').value,d=defs[type]||defs.coord,r=tbody.rows.length,tr=tbody.insertRow();d.heads.forEach(function(h,c){var td=tr.insertCell();if(c===0)td.textContent=String(r+1);else{var input=document.createElement('input');input.setAttribute('aria-label',h+' ردیف '+(r+1));td.appendChild(input)}})};
window.m16ReadyFormClear=function(){var box=document.getElementById('m16ReadyFormTable');if(box)box.querySelectorAll('input').forEach(function(x){x.value=''});};
function m16JalaliToday(){try{return new Intl.DateTimeFormat('fa-IR-u-ca-persian',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()).replace(/\u200e/g,'').replace(/\u200f/g,'').replace(/-/g,'/')}catch(e){return new Date().toLocaleDateString('fa-IR')}}
setTimeout(function(){var date=document.getElementById('m16ReadyDate');if(date&&!date.value)date.value=m16JalaliToday();m16ReadyFormRender();},0);
})();
</script>
<div class="m16lib-detail" id="m16lib-articles">
<h3>🌐 جست‌وجوی آنلاین مقالات علمی</h3>
<p>عنوان، نویسنده، DOI یا موضوع را وارد کن. نتایج از OpenAlex دریافت و چکیده از OpenAlex، Crossref و Semantic Scholar تکمیل می‌شود؛ در صورت نبود DOI نیز جست‌وجوی عنوان امتحان می‌شود. برای هر مقاله پیوند DOI، صفحه منبع، جست‌وجوی نسخه آزاد و فهرست منابع (در صورت ارائه ناشر) در دسترس است؛ متن کامل فقط از نسخه‌های آزاد یا پیوندهای معتبر باز می‌شود.</p>
<div class="m16-article-tools"><input autocomplete="off" id="m16ArticleQuery" onkeydown="if(event.key==='Enter')m16ArticleSearch()" placeholder="عنوان، نویسنده، DOI یا موضوع؛ مثال: GNSS RTK, LiDAR, cadastral survey" type="search"/><button onclick="m16ArticleSearch()" type="button">🔎 جست‌وجو</button></div>
<div class="m16-article-tools"><select aria-label="فیلتر سال انتشار" id="m16ArticleYear"><option value="">همه سال‌ها</option><option value="2026">۲۰۲۶</option><option value="2025">۲۰۲۵</option><option value="2024">۲۰۲۴</option><option value="2023">۲۰۲۳</option><option value="2020">۲۰۲۰ تا ۲۰۲۲</option></select><select aria-label="فیلتر دسترسی" id="m16ArticleAccess"><option value="all">همه مقالات</option><option value="oa">فقط دسترسی آزاد</option></select></div>
