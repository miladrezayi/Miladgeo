</section>
<script>
function cogoTab(n){
  n=Number(n)||1;
  document.querySelectorAll('#cogo .cogo-tab').forEach(function(b){b.classList.toggle('active',Number(b.getAttribute('data-cogo-tab'))===n);});
  document.querySelectorAll('#cogo .cogo-panel').forEach(function(p){p.classList.toggle('active',p.id==='cogoPanel'+n);});
}
(function(){
  var st=document.createElement('style');
  st.textContent='.cogo-form{display:grid;gap:7px}.cogo-row{display:grid;grid-template-columns:74px 1fr;gap:6px;align-items:center}.cogo-row label,.cogo-wide-label{font-size:11px;font-weight:800;color:#344238}.cogo-form input,.cogo-form select,.cogo-form textarea{width:100%;box-sizing:border-box;border:1px solid #9aaa9c;border-radius:7px;padding:7px;background:#fff;font-family:inherit;font-size:12px;direction:ltr;text-align:center}.cogo-form textarea{direction:ltr;text-align:left;resize:vertical}.cogo-result{min-height:34px;padding:7px;border-radius:7px;background:#f7faf6;border:1px solid #b9c7ba;color:#26342a;font-size:11px;line-height:1.8;text-align:center;font-weight:800}.cogo-form .btn{width:100%;margin-top:2px}.cogo-help{font-size:10px!important}';
  document.head.appendChild(st);
})();
function cgNum(id){var e=document.getElementById(id),v=e?parseFloat(e.value):NaN;return isFinite(v)?v:null;}
function cgFmt(v){return Number(v).toFixed(3);}
function cgOut(id,html){var e=document.getElementById(id);if(e)e.innerHTML=html;}
function cgAz(dx,dy){var a=Math.atan2(dx,dy)*180/Math.PI;if(a<0)a+=360;return a;}
function cogoMainCalc(){
  var dx=cgNum('c1dx'),dy=cgNum('c1dy'),dz=cgNum('c1dz')??0;
  if(dx===null||dy===null){cgOut('c1out','ΔX و ΔY را وارد کنید.');return;}
  var h=Math.hypot(dx,dy),s=Math.hypot(h,dz),az=cgAz(dx,dy),slope=h?dz/h*100:0;
  cgOut('c1out','فاصله افقی: '+cgFmt(h)+'<br>فاصله فضایی: '+cgFmt(s)+'<br>آزیموت: '+cgFmt(az)+'°<br>شیب: '+cgFmt(slope)+'٪');
}
function cogoDistAz(){
  var x1=cgNum('c2x1'),y1=cgNum('c2y1'),x2=cgNum('c2x2'),y2=cgNum('c2y2');
  if([x1,y1,x2,y2].some(function(v){return v===null;})){cgOut('c2out','هر چهار مختصات را وارد کنید.');return;}
  var dx=x2-x1,dy=y2-y1,d=Math.hypot(dx,dy),az=cgAz(dx,dy);
  cgOut('c2out','ΔX: '+cgFmt(dx)+'<br>ΔY: '+cgFmt(dy)+'<br>فاصله: '+cgFmt(d)+'<br>آزیموت: '+cgFmt(az)+'°');
}
function cogoNewPoint(){
  var x=cgNum('c3x'),y=cgNum('c3y'),az=cgNum('c3az'),d=cgNum('c3d');
  if([x,y,az,d].some(function(v){return v===null;})){cgOut('c3out','مختصات، آزیموت و فاصله را کامل کنید.');return;}
  var r=az*Math.PI/180,nx=x+d*Math.sin(r),ny=y+d*Math.cos(r);
  cgOut('c3out','X جدید: '+cgFmt(nx)+'<br>Y جدید: '+cgFmt(ny));
}
function cogoDeltas(){
  var x1=cgNum('c4x1'),y1=cgNum('c4y1'),z1=cgNum('c4z1')??0,x2=cgNum('c4x2'),y2=cgNum('c4y2'),z2=cgNum('c4z2')??0;
  if([x1,y1,x2,y2].some(function(v){return v===null;})){cgOut('c4out','مختصات X و Y هر دو نقطه را وارد کنید.');return;}
  var dx=x2-x1,dy=y2-y1,dz=z2-z1;
  cgOut('c4out','ΔX: '+cgFmt(dx)+'<br>ΔY: '+cgFmt(dy)+'<br>ΔZ: '+cgFmt(dz)+'<br>فاصله افقی: '+cgFmt(Math.hypot(dx,dy)));
}
function cogoLineIntersection(){
  var v=['c5x1','c5y1','c5x2','c5y2','c5x3','c5y3','c5x4','c5y4'].map(cgNum);
  if(v.some(function(x){return x===null;})){cgOut('c5out','هر هشت مختصات را وارد کنید.');return;}
  var x1=v[0],y1=v[1],x2=v[2],y2=v[3],x3=v[4],y3=v[5],x4=v[6],y4=v[7];
  var den=(x1-x2)*(y3-y4)-(y1-y2)*(x3-x4);
  if(Math.abs(den)<1e-12){cgOut('c5out','دو خط موازی یا منطبق هستند و تقاطع یکتا ندارند.');return;}
  var px=((x1*y2-y1*x2)*(x3-x4)-(x1-x2)*(x3*y4-y3*x4))/den;
  var py=((x1*y2-y1*x2)*(y3-y4)-(y1-y2)*(x3*y4-y3*x4))/den;
  cgOut('c5out','X تقاطع: '+cgFmt(px)+'<br>Y تقاطع: '+cgFmt(py));
}
function cogoStakeout(){
  var x=cgNum('c6x'),y=cgNum('c6y'),tx=cgNum('c6tx'),ty=cgNum('c6ty');
  if([x,y,tx,ty].some(function(v){return v===null;})){cgOut('c6out','مختصات ایستگاه و هدف را وارد کنید.');return;}
  var dx=tx-x,dy=ty-y;cgOut('c6out','فاصله هدف: '+cgFmt(Math.hypot(dx,dy))+'<br>آزیموت هدف: '+cgFmt(cgAz(dx,dy))+'°');
}
function cogoCircleIntersection(){
  var x1=cgNum('c7x1'),y1=cgNum('c7y1'),r1=cgNum('c7r1'),x2=cgNum('c7x2'),y2=cgNum('c7y2'),r2=cgNum('c7r2');
  if([x1,y1,r1,x2,y2,r2].some(function(v){return v===null;})||r1<0||r2<0){cgOut('c7out','مرکزها و شعاع‌های معتبر را وارد کنید.');return;}
  var dx=x2-x1,dy=y2-y1,d=Math.hypot(dx,dy);
  if(d===0||d>r1+r2||d<Math.abs(r1-r2)){cgOut('c7out','دو دایره تقاطع واقعی ندارند.');return;}
  var a=(r1*r1-r2*r2+d*d)/(2*d),h=Math.sqrt(Math.max(0,r1*r1-a*a)),xm=x1+a*dx/d,ym=y1+a*dy/d;
  var rx=-dy*h/d,ry=dx*h/d;
  cgOut('c7out','نقطه ۱: X='+cgFmt(xm+rx)+' ، Y='+cgFmt(ym+ry)+'<br>نقطه ۲: X='+cgFmt(xm-rx)+' ، Y='+cgFmt(ym-ry));
}
function cogoResultPoint(){
  var x=cgNum('c8x'),y=cgNum('c8y'),z=cgNum('c8z')??0,code=(document.getElementById('c8code')||{}).value||'COGO';
  if(x===null||y===null){cgOut('c8out','حداقل X و Y را وارد کنید.');return;}
  cgOut('c8out','نقطه آماده شد<br>کد: '+String(code).replace(/[<>&"]/g,'')+'<br>X: '+cgFmt(x)+'<br>Y: '+cgFmt(y)+'<br>Z: '+cgFmt(z));
}
function cogoXYPolar(){
  var x=cgNum('c9x'),y=cgNum('c9y');
  if(x===null||y===null){cgOut('c9out','X و Y را وارد کنید.');return;}
  cgOut('c9out','فاصله از مبدأ: '+cgFmt(Math.hypot(x,y))+'<br>آزیموت از مبدأ: '+cgFmt(cgAz(x,y))+'°');
}
function cogoAzBearing(){
  var az=cgNum('c10az');
  if(az===null){cgOut('c10out','آزیموت را وارد کنید.');return;}
  az=((az%360)+360)%360;
  var q='',b=0;
  if(az<90){q='شمال شرقی';b=az;}
  else if(az<180){q='جنوب شرقی';b=180-az;}
  else if(az<270){q='جنوب غربی';b=az-180;}
  else {q='شمال غربی';b=360-az;}
  cgOut('c10out','ربع: '+q+'<br>زاویه ربعی: '+cgFmt(b)+'°');
}
function cogoAngleConvert(){
  var v=cgNum('c11v'),u=(document.getElementById('c11u')||{}).value||'deg';
  if(v===null){cgOut('c11out','مقدار زاویه را وارد کنید.');return;}
  var deg=u==='gon'?v*0.9:u==='rad'?v*180/Math.PI:v;
  cgOut('c11out','درجه: '+cgFmt(deg)+'°<br>گون: '+cgFmt(deg/0.9)+' g<br>رادیان: '+cgFmt(deg*Math.PI/180));
}
function cogoDMS(){
  var v=cgNum('c12v');if(v===null){cgOut('c12out','زاویه اعشاری را وارد کنید.');return;}
  var sign=v<0?'-':'',a=Math.abs(v),d=Math.floor(a),m0=(a-d)*60,m=Math.floor(m0),sec=(m0-m)*60;
  cgOut('c12out',sign+d+'° '+m+'′ '+cgFmt(sec)+'″');
}
function cogoParsePts(id){
  var e=document.getElementById(id),lines=(e?e.value:'').trim().split(/\n+/),pts=[];
  lines.forEach(function(line){var a=line.trim().split(/[,; \t]+/).map(Number);if(a.length>=2&&isFinite(a[0])&&isFinite(a[1]))pts.push([a[0],a[1]]);});
  return pts;
}
function cogoAreaVal(pts){
  var s=0;for(var i=0;i<pts.length;i++){var j=(i+1)%pts.length;s+=pts[i][0]*pts[j][1]-pts[j][0]*pts[i][1];}return Math.abs(s)/2;
}
function cogoArea(){
  var p=cogoParsePts('c13pts');if(p.length<3){cgOut('c13out','حداقل سه نقطه وارد کنید.');return;}cgOut('c13out','تعداد نقاط: '+p.length+'<br>مساحت: '+cgFmt(cogoAreaVal(p))+' مترمربع');
}
function cogoPerimeter(){
  var p=cogoParsePts('c14pts');if(p.length<2){cgOut('c14out','حداقل دو نقطه وارد کنید.');return;}var s=0;for(var i=0;i<p.length;i++){var j=(i+1)%p.length;s+=Math.hypot(p[j][0]-p[i][0],p[j][1]-p[i][1]);}cgOut('c14out','تعداد نقاط: '+p.length+'<br>محیط: '+cgFmt(s)+' متر');
}
function cogo3DDistance(){
  var v=['c15x1','c15y1','c15z1','c15x2','c15y2','c15z2'].map(cgNum);if(v.slice(0,2).some(function(x){return x===null;})||v.slice(3,5).some(function(x){return x===null;})){cgOut('c15out','X و Y هر دو نقطه را وارد کنید.');return;}var dz=(v[5]??0)-(v[2]??0),h=Math.hypot(v[3]-v[0],v[4]-v[1]);cgOut('c15out','فاصله افقی: '+cgFmt(h)+'<br>ΔZ: '+cgFmt(dz)+'<br>فاصله فضایی: '+cgFmt(Math.hypot(h,dz)));
}
function cogoCentroid(){
  var p=cogoParsePts('c16pts');if(p.length<3){cgOut('c16out','حداقل سه نقطه وارد کنید.');return;}var A=0,cx=0,cy=0;for(var i=0;i<p.length;i++){var j=(i+1)%p.length,c=p[i][0]*p[j][1]-p[j][0]*p[i][1];A+=c;cx+=(p[i][0]+p[j][0])*c;cy+=(p[i][1]+p[j][1])*c;}if(Math.abs(A)<1e-12){cgOut('c16out','مساحت صفر است و مرکز هندسی قابل محاسبه نیست.');return;}A=A/2;cgOut('c16out','X مرکز: '+cgFmt(cx/(6*A))+'<br>Y مرکز: '+cgFmt(cy/(6*A)));}
</script>
