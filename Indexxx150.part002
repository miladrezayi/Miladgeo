.m16-logo-picker{border:1px solid #d3ddd5;border-radius:14px;padding:12px;margin:10px 0;background:#fff;color:#26382d}.m16-logo-picker b{display:block;margin-bottom:8px}.m16-logo-options{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.m16-logo-option{border:1px solid #cbd6ce;border-radius:10px;background:#f7faf7;padding:8px 4px;min-height:88px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;color:#254b35;font-weight:800;font-size:11px}.m16-logo-option.active{border:2px solid #26784a;background:#e8f4eb;box-shadow:0 0 0 2px #d2e9d8}.m16-logo-option svg{width:62px;height:48px}.m16-logo-upload{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:10px}.m16-logo-upload input{max-width:100%;font-size:13px}.m16-logo-preview{width:88px;height:72px;border:1px dashed #a8b7ac;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:5px}.m16-logo-preview img{max-width:100%;max-height:100%;object-fit:contain}@media(max-width:430px){.m16-logo-options{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
