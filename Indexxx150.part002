.m4-profile-metric b{display:block;font-size:12px;margin-top:3px}
.m4-profile-chart{background:#0b100b;border:1px solid #566256;border-radius:12px;padding:6px;overflow:hidden}
.m4-profile-chart svg{display:block;width:100%;height:auto}
.m4-profile-note{text-align:center;font-size:10px;color:#c4ccc2;line-height:1.8;margin-top:8px}
@media(max-width:420px){.m4-profile-metrics{grid-template-columns:repeat(2,1fr)}.m4-profile-title{font-size:18px}}
@media(max-width:420px){.m4-submenu-grid{grid-template-columns:1fr}.m4-submenu-btn{min-height:108px}.m4-submenu-btn b{font-size:17px}}

.m4-profile-stepcheck{display:flex;align-items:center;gap:9px;margin:7px 2px 12px;padding:10px 12px;border:1px solid #b9d9c0;border-radius:12px;background:#f0faf2;color:#28583a;font-size:13px;line-height:1.7;direction:rtl}
.m4-profile-stepcheck input{width:21px;height:21px;accent-color:#188348;flex:0 0 auto}
</style>
<style id="m4-workflow-modern-v815">
#m4TerrainSection{scroll-margin-top:10px}.m4-terrain-card{border:1px solid #b7c9ba!important;border-radius:22px!important;background:linear-gradient(160deg,#f8fcf8,#e8f3e9)!important;padding:15px!important;box-shadow:0 8px 24px rgba(18,70,35,.12)!important;color:#173d25}
.m4-terrain-title{font-size:22px!important;font-weight:1000!important;color:#14532d!important;text-align:center;margin:5px 0 8px!important}.m4-terrain-sub{font-size:13px!important;line-height:1.9!important;text-align:center;color:#476653!important;margin-bottom:14px!important}
.m4-terrain-actions{margin:10px 0!important}.m4-terrain-actions button{width:100%;min-height:50px;border-radius:14px!important;font-weight:900!important;font-size:14px!important;box-shadow:0 3px 8px #183a2220!important}
.m4-workflow-head{padding:12px;border-radius:16px;background:#14532d;color:#fff;text-align:center;margin:12px 0}.m4-workflow-head b{display:block;font-size:16px}.m4-workflow-head span{font-size:11px;opacity:.9;line-height:1.8}
.m4-workflow-steps{display:grid;grid-template-columns:1fr;gap:9px;margin:12px 0}.m4-workflow-step{display:flex;align-items:center;gap:11px;background:#fff;border:1px solid #cbd8cc;border-radius:15px;padding:11px;box-shadow:0 2px 7px #173a2010}.m4-workflow-num{width:27px;height:27px;flex:0 0 27px;border:2px solid #8bb99a;border-radius:6px;display:grid;place-items:center;background:#fff;color:#16803d;font-size:0;font-weight:1000;box-sizing:border-box}.m4-workflow-step b{display:block;font-size:13px;color:#183d25}.m4-workflow-step small{display:block;color:#637568;font-size:11px;line-height:1.6;margin-top:3px}.m4-workflow-step.done{border-color:#26934d;background:#effaf1}.m4-workflow-step.done .m4-workflow-num{background:#16803d;border-color:#16803d;color:white}.m4-workflow-step.done .m4-workflow-num:after{content:'✓';font-size:20px;line-height:1}.m4-workflow-step.done .m4-workflow-num{font-size:0}
.m4-terrain-field{background:#fff;border:1px solid #d6e1d7;border-radius:14px;padding:11px!important;margin:10px 0!important}.m4-terrain-field label{font-size:12px!important;font-weight:900!important;color:#28563a!important}.m4-terrain-selection-box,.m4-terrain-status{border-radius:12px!important;padding:12px!important;line-height:1.8!important;font-size:12px!important}.m4-terrain-status{background:#e8f3e9!important;border:1px solid #b8d5bf!important;color:#245333!important;font-weight:800!important;margin:12px 0!important}.m4-key-help{border-radius:12px!important}.m4-dxf-info{border-radius:14px!important;background:#f6fbf6!important;padding:12px!important;line-height:1.8!important}.m4-submenu{background:linear-gradient(145deg,#eff8f0,#d6e9d9)!important;border-color:#78a887!important}.m4-submenu-title{color:#14532d!important}.m4-submenu-btn{border:1px solid #8ab49a!important;border-radius:18px!important;background:linear-gradient(#fff,#e5f3e8)!important;color:#17452a!important;box-shadow:0 4px 12px #153b2115!important}.m4-submenu-btn span{font-size:11px!important}
#m4LevelingSection .m19-head{border:1px solid #b7c9ba;border-radius:20px;background:linear-gradient(160deg,#f8fcf8,#e8f3e9);padding:14px}#m4LevelingSection .m19-mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}#m4LevelingSection .m19-mode-grid button{min-height:49px;border-radius:13px;font-weight:900;font-size:12px;padding:8px}#m4LevelingSection .m19-mode-grid button:last-child{grid-column:1/-1}
@media(min-width:600px){.m4-workflow-steps{grid-template-columns:1fr 1fr}.m4-workflow-step{min-height:76px}}
</style>
<style id="m4-terrain-inputs-modern-v818">
/* Match the clean white/green input style used by the leveling section */
#m4TerrainSection .m4-terrain-field{background:linear-gradient(145deg,#ffffff,#f0f8f1)!important;border:1px solid #b8d5bf!important;border-radius:17px!important;box-shadow:0 4px 13px rgba(20,83,45,.07)!important;padding:13px!important}
#m4TerrainSection input:not([type=checkbox]),#m4TerrainSection select{box-sizing:border-box!important;width:100%!important;min-height:48px!important;border:1.5px solid #86b89a!important;border-radius:12px!important;background:linear-gradient(180deg,#fff,#edf8ef)!important;color:#173d25!important;padding:11px 13px!important;font-size:15px!important;font-weight:700!important;box-shadow:inset 0 1px 2px rgba(20,83,45,.05)!important;outline:none!important}
#m4TerrainSection input:not([type=checkbox]):focus,#m4TerrainSection select:focus{border-color:#16803d!important;box-shadow:0 0 0 3px rgba(22,128,61,.13)!important}
#m4TerrainSection .m4-key-wrap{display:flex;gap:7px;align-items:stretch}#m4TerrainSection .m4-key-wrap input{flex:1;min-width:0}
#m4TerrainSection .m4-key-toggle{min-width:50px!important;border:1px solid #83b495!important;border-radius:12px!important;background:linear-gradient(#fff,#e0f2e4)!important;color:#14532d!important;font-size:20px!important}
#m4TerrainSection .m4-key-help{width:100%;margin-top:9px!important;min-height:48px!important;border:1px solid #82b994!important;background:linear-gradient(145deg,#fff,#e5f5e8)!important;color:#18532d!important;box-shadow:0 3px 8px rgba(20,83,45,.08)!important;font-weight:900!important}
#m4TerrainSection .m4-key-guide{background:#f1f9f2!important;border:1px solid #c4dfca!important;border-radius:12px!important;color:#42664b!important;padding:10px!important;line-height:1.9!important}
#m4TerrainSection .m4-key-confirm{margin-top:10px;padding:11px 12px;border:1px solid #a8d2b2;border-radius:14px;background:linear-gradient(145deg,#f7fcf7,#e4f4e7);color:#174b2b}
#m4TerrainSection .m4-key-confirm-label{display:flex!important;align-items:center;gap:9px;font-size:13px!important;font-weight:900!important;line-height:1.8!important;cursor:pointer}
#m4TerrainSection .m4-key-confirm-label input[type=checkbox]{width:21px!important;height:21px!important;min-height:21px!important;flex:0 0 21px;accent-color:#16803d}
#m4TerrainSection .m4-key-count{font-size:12px;font-weight:900;margin-top:8px;padding:7px 9px;background:#fff;border:1px solid #d1e6d5;border-radius:9px;color:#14532d}
#m4TerrainSection .m4-key-confirm-note{font-size:11px;line-height:1.8;color:#58745e;margin-top:4px}
#m4TerrainSection .m4-terrain-actions button{border:1px solid #82b994!important;border-radius:13px!important;background:linear-gradient(145deg,#fff,#e2f3e5)!important;color:#174b2b!important;box-shadow:0 3px 9px rgba(20,83,45,.09)!important}
#m4TerrainSection .m4-terrain-actions button.btn.primary{background:linear-gradient(145deg,#23934a,#147238)!important;border-color:#12652f!important;color:#fff!important}
#m4TerrainSection .m4-terrain-actions button:disabled{opacity:.5!important}
#m4TerrainSection .m4-terrain-selection-box{background:#f0f9f1!important;border:1px solid #b8d9c0!important;color:#205b32!important}
</style>
<style id="m4-step-checks-v820">
#m4TerrainSection .m4-workflow-steps{display:block;margin:8px 0 13px!important}
#m4TerrainSection .m4-workflow-step{background:linear-gradient(145deg,#fff,#eff9f0)!important;border:1px solid #b8d9c0!important;border-radius:14px!important;padding:10px 12px!important;box-shadow:0 3px 10px rgba(20,83,45,.07)!important}
#m4TerrainSection .m4-workflow-step{display:flex!important;align-items:center!important;gap:12px!important;cursor:default!important}
#m4TerrainSection .m4-workflow-step .m4-workflow-num{border-radius:6px!important}
#m4TerrainSection .m4-workflow-step.done .m4-workflow-num{background:#16803d!important;border-color:#16803d!important;color:#fff!important}
#m4TerrainSection .m4-workflow-step.done b{color:#146b35!important}
#m4TerrainSection .m4-workflow-step small{line-height:1.85!important}
#m4TerrainSection .m4-workflow-step.done{background:linear-gradient(145deg,#e8f8eb,#d7f0dc)!important;border-color:#27934c!important}
#m4TerrainSection .m4-profile-stepcheck{display:flex!important;align-items:center!important;gap:10px!important;margin:8px 0 13px!important;padding:12px!important;border:1px solid #b8d9c0!important;border-radius:14px!important;background:linear-gradient(145deg,#fff,#eff9f0)!important;color:#285b38!important;font-size:12px!important;line-height:1.8!important;font-weight:800!important;box-shadow:0 3px 10px rgba(20,83,45,.06)!important}
#m4TerrainSection .m4-profile-stepcheck input[type=checkbox]{width:24px!important;height:24px!important;min-height:24px!important;flex:0 0 24px!important;accent-color:#16803d!important;margin:0!important}
#m4TerrainSection .m4-profile-stepcheck input[type=checkbox]:checked{accent-color:#16803d!important;filter:drop-shadow(0 0 2px rgba(22,128,61,.35))!important}
#m4TerrainSection .m4-profile-stepcheck:has(input:checked) input[type=checkbox]{accent-color:#16803d!important}
#m4TerrainSection .m4-profile-stepcheck:has(input:checked){background:linear-gradient(145deg,#e8f8eb,#d7f0dc)!important;border-color:#27934c!important}
#m4TerrainSection .m4-profile-btn{border:1.5px solid #16803d!important;border-radius:14px!important;background:linear-gradient(145deg,#dff5e4,#bfe8ca)!important;color:#14532d!important;box-shadow:0 3px 9px rgba(20,83,45,.16)!important}
#m4TerrainSection .m4-profile-btn:active{background:linear-gradient(145deg,#d8f1dd,#c7e8cf)!important}
#m4TerrainSection .m4-terrain-actions button.m4-dxf-btn{background:linear-gradient(145deg,#23934a,#147238)!important;border:1.5px solid #12652f!important;color:#fff!important;box-shadow:0 4px 12px rgba(20,83,45,.18)!important}
#m4TerrainSection .m4-terrain-actions button.m4-dxf-btn:active{background:linear-gradient(145deg,#187b3b,#0f5f2d)!important}
</style>
<style id="mg-menu2-menu4-photo-cards-v2">
/* V270: Activate the five existing, embedded photo assets on the live Menu 2 and Menu 4 cards. */
#realMeasure .real-action-grid .real-action-card{
  box-sizing:border-box!important;min-height:190px!important;justify-content:flex-start!important;
