.m4-profile-result{margin-top:12px;padding:12px;border-radius:18px;background:#111811;border:2px solid #687568;box-shadow:inset 0 0 0 1px #303a30;color:#fff;display:none}
.m4-profile-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:10px}
