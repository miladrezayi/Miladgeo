}
</style>
<style id="m4-offline-topography-v1">
#m4OfflineTerrainSection{scroll-margin-top:10px}
#m4OfflineTerrainSection .m4-offline-info{padding:11px 13px;border:1px solid #c6ddcb;border-radius:14px;background:#f2faf3;color:#315b3d;font-size:11px;line-height:1.9;margin:10px 0 13px}
#m4OfflineTerrainSection .m4-offline-file-meta{font-size:11px;color:#496650;line-height:1.8;margin-top:8px;overflow-wrap:anywhere}
#m4OfflineTerrainSection input[type=file]{display:block;width:100%;box-sizing:border-box;min-height:46px;padding:8px;border:1px dashed #72a984;border-radius:12px;background:#f8fcf8;color:#1b482c;font-size:12px}
#m4OfflineTerrainSection .m4-offline-map-title{font-weight:1000;color:#18552f;margin-bottom:9px}
#m4OfflineTerrainSection .m4-offline-mapping-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
#m4OfflineTerrainSection .m4-offline-mapping-grid label{display:block;font-size:11px;font-weight:900;color:#28563a}
#m4OfflineTerrainSection .m4-offline-mapping-grid select{margin-top:5px}
#m4OfflineTerrainSection .m4-offline-preview-table{overflow:auto;margin-top:10px;border:1px solid #cbdccb;border-radius:10px;background:#fff;max-width:100%}
#m4OfflineTerrainSection .m4-offline-preview-table table{border-collapse:collapse;width:100%;font-size:10px;direction:ltr}
#m4OfflineTerrainSection .m4-offline-preview-table th,#m4OfflineTerrainSection .m4-offline-preview-table td{padding:5px 7px;border:1px solid #d5e2d6;white-space:nowrap;text-align:center}
#m4OfflineTerrainSection .m4-offline-preview-table th{background:#e7f3e9;color:#194b2d}
#m4OfflineTerrainSection .m4-offline-settings{display:grid;grid-template-columns:1fr 1fr;gap:8px}
#m4OfflineTerrainSection .m4-offline-settings .m4-terrain-field{margin:6px 0!important}
#m4OfflineTerrainSection .m4-offline-check{display:flex;align-items:center;gap:9px;margin:8px 2px;padding:10px 12px;border:1px solid #c6ddcb;border-radius:12px;background:#f5fbf6;color:#28583a;font-size:12px;line-height:1.7;font-weight:800}
#m4OfflineTerrainSection .m4-offline-check input{width:20px;height:20px;flex:0 0 20px;accent-color:#16803d}
#m4OfflineTerrainSection .m4-offline-result{margin-top:14px}
#m4OfflineTerrainSection .m4-offline-preview{margin-top:12px;padding:10px;border:1px solid #bdd4c2;border-radius:16px;background:#102016;overflow:hidden}
#m4OfflineTerrainSection .m4-offline-preview svg{display:block;width:100%;height:auto;max-height:620px;background:#102016;border-radius:9px}
#m4OfflineTerrainSection .m4-offline-export-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:12px 0}
#m4OfflineTerrainSection .m4-offline-export-grid button{min-height:50px;border:1px solid #12652f;border-radius:13px;background:linear-gradient(145deg,#23934a,#147238);color:#fff;font-weight:900;font-size:13px}
#m4OfflineTerrainSection .m4-offline-export-grid button:disabled{opacity:.45}

@media(max-width:420px){#m4OfflineTerrainSection .m4-offline-mapping-grid,#m4OfflineTerrainSection .m4-offline-settings{grid-template-columns:1fr 1fr}#m4OfflineTerrainSection .m4-offline-export-grid{grid-template-columns:1fr}}

#m4OfflineTerrainSection .m4-offline-slider-card{width:100%;margin:9px 0 5px;padding:10px 12px;border:1px solid #b8d0bd;border-radius:12px;background:linear-gradient(145deg,#f7fbf7,#e5f0e6);color:#245333;box-sizing:border-box}
#m4OfflineTerrainSection .m4-offline-slider-card label{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:12px}
#m4OfflineTerrainSection .m4-offline-slider-card label span{direction:ltr;font:800 11px Arial,sans-serif;color:#176b37}
#m4OfflineTerrainSection .m4-offline-slider-card input[type=range]{display:block;width:100%;height:27px;margin:6px 0 0;accent-color:#16813c;direction:ltr;touch-action:pan-y}
#m4OfflineTerrainSection .m4-offline-slider-hints{display:flex;justify-content:space-between;font-size:10px;color:#64796a}
#m4OfflineTerrainSection .m4-offline-exaggeration{flex-basis:100%;background:linear-gradient(145deg,#f3f8ff,#e2ebf6);border-color:#b7c9df;color:#24476c}
#m4OfflineTerrainSection .m4-offline-exaggeration input[type=range]{accent-color:#2474b8}
</style>
<style id="m4-offline-preview-interaction-v2">
#m4OfflineTerrainSection .m4-offline-preview-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:7px;margin:10px 0 8px;padding:8px;border:1px solid #bdd4c2;border-radius:13px;background:linear-gradient(145deg,#f6fbf6,#e5f0e6)}
#m4OfflineTerrainSection .m4-offline-preview-toolbar button{min-width:42px;min-height:39px;padding:7px 10px;border:1px solid #4f795b;border-radius:10px;background:linear-gradient(145deg,#fff,#dcebdd);color:#194b2d;font-weight:900;font-size:12px;box-shadow:0 2px 5px rgba(20,70,35,.10)}
#m4OfflineTerrainSection .m4-offline-preview-toolbar button.active{background:linear-gradient(145deg,#218447,#126331);color:#fff;border-color:#0e5a2a}
#m4OfflineTerrainSection .m4-offline-preview-toolbar .m4-offline-zoom-value{margin-inline-start:auto;min-width:50px;text-align:center;color:#28583a;font:800 11px/1.4 Arial,sans-serif;direction:ltr}
#m4OfflineTerrainSection .m4-offline-preview-viewport{position:relative;width:100%;height:clamp(300px,62vw,560px);min-height:300px;overflow:hidden;border:1px solid #385b42;border-radius:12px;background:#102016;touch-action:none;user-select:none;-webkit-user-select:none;overscroll-behavior:contain}
#m4OfflineTerrainSection .m4-offline-svg-layer{position:absolute;inset:0;width:100%;height:100%;overflow:hidden}
#m4OfflineTerrainSection .m4-offline-svg-layer svg{display:block;width:100%!important;height:100%!important;max-height:none!important;background:#102016;touch-action:none;user-select:none;-webkit-user-select:none}
#m4OfflineTerrainSection .m4-offline-3d-controls{display:none;gap:6px;flex-wrap:wrap;margin:7px 0 0}
#m4OfflineTerrainSection .m4-offline-3d-controls.visible{display:flex}
#m4OfflineTerrainSection .m4-offline-3d-controls button{min-height:36px;padding:6px 10px;border:1px solid #557b5e;border-radius:9px;background:#e8f2e9;color:#1e5030;font-weight:800;font-size:11px}
#m4OfflineTerrainSection .m4-offline-view-tabs{justify-content:center;margin:10px 0 5px;padding:5px;background:transparent;border:0;box-shadow:none}
#m4OfflineTerrainSection .m4-offline-view-tabs button{min-width:104px}
#m4OfflineTerrainSection .m4-offline-zoom-toolbar{display:flex;align-items:center;justify-content:center;gap:9px;margin:4px 0 10px;padding:7px 10px;border-radius:12px;background:#e9f1e9;border:1px solid #c4d4c5}
#m4OfflineTerrainSection .m4-offline-zoom-toolbar button{width:42px;height:38px;border:1px solid #6d9273;border-radius:10px;background:linear-gradient(145deg,#fff,#dcebdd);color:#17482b;font-size:20px;font-weight:900}
#m4OfflineTerrainSection .m4-offline-zoom-toolbar .m4-offline-zoom-value{min-width:55px;text-align:center;color:#28583a;font:800 11px Arial,sans-serif;direction:ltr}
#m4OfflineTerrainSection .m4-offline-code-filter{margin:12px 0;padding:12px;border:1px solid #a9c5ad;border-radius:14px;background:linear-gradient(145deg,#f7fbf6,#e8f2e8);color:#1d4328}
#m4OfflineTerrainSection .m4-offline-code-head{display:flex;flex-direction:column;gap:4px;margin-bottom:9px}
#m4OfflineTerrainSection .m4-offline-code-head b{font-size:12px}
#m4OfflineTerrainSection .m4-offline-code-head span,#m4OfflineTerrainSection .m4-offline-code-note{font-size:10px;line-height:1.8;color:#526d57}
#m4OfflineTerrainSection .m4-offline-code-column{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:11px;font-weight:800}
#m4OfflineTerrainSection .m4-offline-code-column select{flex:1;min-width:130px;padding:8px;border:1px solid #9ab49d;border-radius:9px;background:white;color:#23452b}
#m4OfflineTerrainSection .m4-offline-code-actions{display:flex;gap:7px;margin:9px 0;flex-wrap:wrap}
#m4OfflineTerrainSection .m4-offline-code-actions button{border:1px solid #9ab49d;border-radius:8px;padding:6px 10px;background:#fff;color:#245433;font-size:10px;font-weight:800}
#m4OfflineTerrainSection .m4-offline-code-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(115px,1fr));gap:6px;max-height:190px;overflow:auto;padding:2px}
#m4OfflineTerrainSection .m4-offline-code-item{display:flex;align-items:center;gap:6px;padding:7px;border:1px solid #c4d5c6;border-radius:8px;background:#fff;font-size:11px;min-width:0}
#m4OfflineTerrainSection .m4-offline-code-item input{accent-color:#218447;width:16px;height:16px;flex:0 0 auto}
#m4OfflineTerrainSection .m4-offline-code-item span{overflow-wrap:anywhere}
#m4OfflineTerrainSection .m4-offline-preview-toolbar button:focus-visible,#m4OfflineTerrainSection .m4-offline-3d-controls button:focus-visible{outline:3px solid #e1b84f;outline-offset:2px}
</style>
