<div class="cogo-form">
<label class="cogo-wide-label">نقاط را خط‌به‌خط به صورت X,Y وارد کنید</label>
<textarea id="c16pts" placeholder="0,0
10,0
10,10
0,10" rows="5"></textarea>
<button class="btn primary" onclick="cogoCentroid()" type="button">محاسبه مرکز</button>
