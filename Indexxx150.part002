<div class="m16keys">
<button class="danger" onclick="m16Clear();return false;" type="button">AC</button><button onclick="m16Mem('mc');return false;" type="button">MC</button><button onclick="m16Mem('mr');return false;" type="button">MR</button><button onclick="m16Mem('m+');return false;" type="button">M+</button><button onclick="m16Mem('m-');return false;" type="button">M−</button>
<button onclick="m16Unary('acos');return false;" type="button">cos⁻¹</button><button onclick="m16Unary('asin');return false;" type="button">sin⁻¹</button><button onclick="m16Unary('atan');return false;" type="button">tan⁻¹</button><button onclick="m16Unary('cos');return false;" type="button">cos</button><button onclick="m16Unary('sin');return false;" type="button">sin</button>
<button onclick="m16Sign();return false;" type="button">−/+</button><button onclick="m16Unary('recip');return false;" type="button">x/1</button><button onclick="m16Unary('square');return false;" type="button">x²</button><button onclick="m16Unary('sqrt');return false;" type="button">√</button><button onclick="m16Unary('tan');return false;" type="button">tan</button>
<button onclick="m16Unary('ln');return false;" type="button">ln</button><button onclick="m16Unary('log');return false;" type="button">log</button><button class="ang" onclick="m16Mode('RAD');return false;" type="button">RAD</button><button class="ang" onclick="m16Mode('DEG');return false;" type="button">DEG</button><button class="ang" onclick="m16Dms();return false;" type="button">DMS</button>
<button onclick="m16Back();return false;" type="button">⌫</button><button onclick="m16Add('/');return false;" type="button">÷</button><button class="num" onclick="m16Add('9');return false;" type="button">9</button><button class="num" onclick="m16Add('8');return false;" type="button">8</button><button class="num" onclick="m16Add('7');return false;" type="button">7</button>
<button onclick="m16Percent();return false;" type="button">%</button><button onclick="m16Add('*');return false;" type="button">×</button><button class="num" onclick="m16Add('6');return false;" type="button">6</button><button class="num" onclick="m16Add('5');return false;" type="button">5</button><button class="num" onclick="m16Add('4');return false;" type="button">4</button>
<button onclick="m16Add('-');return false;" type="button">−</button><button onclick="m16Add('+');return false;" type="button">+</button><button class="num" onclick="m16Add('3');return false;" type="button">3</button><button class="num" onclick="m16Add('2');return false;" type="button">2</button><button class="num" onclick="m16Add('1');return false;" type="button">1</button>
<button onclick="m16Paren();return false;" type="button">()</button><button class="num" onclick="m16Add('.');return false;" type="button">.</button><button class="num zero" onclick="m16Add('0');return false;" type="button">0</button><button class="eq" onclick="m16Equals();return false;" type="button">=</button>
</div>
