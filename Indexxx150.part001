}

function qItem(q,o,c,e,cat){return {q:q,o:o,c:c,e:e,cat:cat};}
function buildSurveyQuizBank(){
 if(surveyQuizBank)return surveyQuizBank;
 var B=[], i, n, a, b, d, correct, opts;
 function add(q,opts,correct,e,cat){B.push(qItem(q,opts,correct,e,cat));}
 // 10 practical categories × 50 questions = 500 deterministic questions.
 for(i=1;i<=5;i++){
   n=1+i%9;
   add('کدام گزینه جزء وظیفه اصلی دوربین نقشه‌برداری/Total Station است؟',['اندازه‌گیری زاویه و فاصله','فقط ثبت عکس','فقط اندازه‌گیری دما','فقط تعیین فشار هوا'],0,'مبانی');
   add('در شماره‌گذاری نقاط برداشت، کدام روش برای جلوگیری از ابهام مناسب‌تر است؟',['شماره‌های یکتا و منظم','همه نقاط با یک شماره','شماره‌گذاری تصادفی بدون ثبت','حذف شماره نقطه'],0,'مبانی');
   add('قبل از شروع برداشت، کدام مورد باید با پروژه تطبیق داده شود؟',['واحدها و سیستم مختصات','رنگ سه‌پایه','مدل گوشی','نام شبکه Wi‑Fi'],0,'مبانی');
   add('برای اندازه‌گیری دقیق، پایدار بودن سه‌پایه چه اهمیتی دارد؟',['کاهش جابه‌جایی دستگاه','افزایش ظرفیت باتری','تغییر سیستم مختصات','افزایش تعداد نقاط'],0,'مبانی');
   add('اگر یک نقطه کنترل مختصات معلوم داشته باشیم، کاربرد آن چیست؟',['کنترل یا تعریف موقعیت/توجیه','افزایش ارتفاع آنتن','تغییر فرمت PDF','حذف نقاط'],0,'مبانی');
   add('در دفترچه برداشت، DP معمولاً برای چه چیزی مفید است؟',['توضیح یا کد نقطه','شماره سریال باتری','زاویه قائم دستگاه','شماره Zone'],0,'مبانی');
   add('کدام گزینه یک خطای انسانی رایج در برداشت است؟',['ورود اشتباه مختصات یا ارتفاع','گردش زمین','تغییر جاذبه در یک متر','تغییر رنگ منشور'],0,'مبانی');
   add('برای کنترل مستقل یک نقطه، چه کاری مناسب است؟',['اندازه‌گیری یا محاسبه مجدد با روش مستقل','کپی همان عدد بدون کنترل','حذف نقطه','تغییر نام پروژه'],0,'مبانی');
   add('مفهوم Backsight در توتال استیشن بیشتر به چه چیزی مربوط است؟',['توجیه جهت دستگاه با یک مرجع','اندازه‌گیری دمای هوا','ذخیره PDF','تغییر ارتفاع ژئوئید'],0,'مبانی');
   add('برای تحویل حرفه‌ای داده، کدام مورد مهم است؟',['کنترل داده و انتخاب فرمت مناسب','فقط تغییر فونت','فقط گرفتن اسکرین‌شات','حذف داده خام'],0,'مبانی');
 }
 for(i=1;i<=5;i++){
   d=(i%9)+1;
   add('در ترازیابی، هدف اصلی قرائت‌ها چیست؟',['تعیین اختلاف ارتفاع','تعیین نام پروژه','تعیین Zone','ساخت فایل DXF'],0,'ترازیابی');
   add('اگر ارتفاع نقطه A برابر '+(100+i)+' متر و اختلاف ارتفاع B نسبت به A برابر '+d+' متر باشد، ارتفاع B چقدر است؟',[String(100+i+d),String(100+i-d),String(100+i+d+10),String(d)],0,'ترازیابی');
   add('در روش ارتفاع دستگاه HI، رابطه ارتفاع نقطه با قرائت Staff چیست؟',['RL = HI − Reading','RL = HI + Reading','RL = Reading − HI','RL = HI × Reading'],0,'ترازیابی');
   add('برای کاهش اثر خطای کولیمیشن در ترازیابی، کدام کار مفید است؟',['متعادل کردن تقریبی طول دیدها','افزایش نام پروژه','حذف قرائت پشت','تغییر رنگ دفتر'],0,'ترازیابی');
   add('قرائت Back Sight معمولاً برای چه استفاده می‌شود؟',['محاسبه/تعیین ارتفاع دستگاه','تعیین نام نقطه جدید فقط','تولید KML','تغییر Datum'],0,'ترازیابی');
   add('قرائت Fore Sight معمولاً به چه نقطه‌ای مربوط است؟',['نقطه‌ای که ارتفاع آن تعیین می‌شود','فقط نقطه کنترل قبلی','نام Job','مرکز نقشه'],0,'ترازیابی');
   add('اگر HI= '+(110+i)+' و قرائت= '+d+' باشد، RL نقطه چیست؟',[String(110+i-d),String(110+i+d),String(d-(110+i)),String(110+i)],0,'ترازیابی');
   add('در ترازیابی رفت و برگشت، مقایسه نتایج برای چه مفید است؟',['کنترل خطای بسته‌شدن','افزایش سرعت اینترنت','ساخت تصویر','تغییر فرمت CSV'],0,'ترازیابی');
   add('برای قرائت میر (Staff)، دید واضح و قائم بودن میر چه اثری دارد؟',['کاهش خطای قرائت','تغییر سیستم مختصات','افزایش Zone','حذف نیاز به کنترل'],0,'ترازیابی');
   add('در یک شبکه ترازیابی، ثبت ترتیب نقاط چه اهمیتی دارد؟',['ردیابی مسیر و کنترل محاسبات','تغییر رنگ نقاط','ساخت خودکار پهپاد','تغییر نام دستگاه'],0,'ترازیابی');
 }
 for(i=1;i<=5;i++){
   d=(i%8)+2; a=(i*37)%360;
   add('در قرارداد رایج این شبیه‌ساز، برای آزیموت '+a+'° و فاصله '+d+' متر، ΔX از کدام رابطه به‌دست می‌آید؟',['d sin(Az)','d cos(Az)','d tan(Az)','d/Az'],0,'Total Station');
   add('اگر X=500 و Y=1000 و فاصله افقی '+d+' متر در آزیموت 0° باشد، X و Y جدید کدام است؟',['X=500 ، Y='+(1000+d),'X='+(500+d)+' ، Y=1000','X=500 ، Y='+(1000-d),'X='+(500-d)+' ، Y=1000'],0,'Total Station');
   add('قبل از Measure در شبیه‌ساز، کدام شرط لازم است؟',['Station و Orientation کامل باشد','فقط نام فایل باشد','فقط DP وارد شده باشد','فقط PDF ساخته شده باشد'],0,'Total Station');
   add('ارتفاع دستگاه HI در محاسبه ارتفاع نقطه چه نقشی دارد؟',['در انتقال ارتفاع به نقطه مشاهده‌شده','فقط در نام‌گذاری','فقط در DXF','هیچ نقشی ندارد'],0,'Total Station');
   add('Prism Height بیشتر به کدام بخش مربوط است؟',['ارتفاع مرکز منشور نسبت به نقطه زمینی','نام پروژه','شماره Zone','تعداد نقاط'],0,'Total Station');
   add('در توجیه با مختصات پشت‌دید، چه چیزی از Station و Backsight به‌دست می‌آید؟',['جهت/آزیموت مرجع','فقط فاصله قائم','فقط DP','فایل PDF'],0,'Total Station');
   add('اگر فاصله افقی صفر باشد، مختصات X و Y نقطه جدید نسبت به Station چه تغییری می‌کند؟',['تغییری نمی‌کند','همیشه ۱ متر زیاد می‌شود','همیشه ۱ متر کم می‌شود','به Zone تبدیل می‌شود'],0,'Total Station');
   add('برای برداشت نقطه جدید، ثبت Point Number چه مزیتی دارد؟',['ردیابی و ارجاع آسان به نقطه','افزایش دقت زاویه','تغییر Datum','تولید خودکار عکس'],0,'Total Station');
   add('در کنترل برداشت، مقایسه نقطه برداشت‌شده با نقطه معلوم چه چیزی را آشکار می‌کند؟',['خطا یا اختلاف موقعیت','رنگ دستگاه','نام کاربر','نسخه مرورگر'],0,'Total Station');
   add('اگر Orientation اشتباه باشد، چه چیزی ممکن است تحت تأثیر قرار گیرد؟',['جهت و مختصات نقاط برداشت‌شده','فقط نام PDF','فقط ارتفاع سه‌پایه','فقط اندازه فونت'],0,'Total Station');
 }
 for(i=1;i<=5;i++){
   a=(i*23)%360; d=(i%12)+5;
   add('آزیموت یک خط در نقشه‌برداری معمولاً نسبت به کدام جهت مرجع اندازه‌گیری می‌شود؟',['شمال با افزایش ساعتگرد','جنوب با افزایش پادساعتگرد','شرق با افزایش ساعتگرد','هر جهت بدون قرارداد'],0,'زاویه و مختصات');
   add('آزیموت '+a+'° در کدام بازه استاندارد قرار دارد؟',['0 تا کمتر از 360 درجه','0 تا 90 درجه فقط','90 تا 180 درجه فقط','180 تا 270 درجه فقط'],0,'زاویه و مختصات');
   add('برای خطی با ΔX مثبت و ΔY مثبت، جهت کلی خط در چارچوب X=Easting و Y=Northing در کدام ربع است؟',['ربع اول','ربع دوم','ربع سوم','ربع چهارم'],0,'زاویه و مختصات');
   add('اگر ΔX=0 و ΔY مثبت باشد، آزیموت خط چیست؟',['0°','90°','180°','270°'],0,'زاویه و مختصات');
   add('اگر ΔX مثبت و ΔY=0 باشد، آزیموت خط چیست؟',['90°','0°','180°','270°'],0,'زاویه و مختصات');
   add('اگر ΔX=0 و ΔY منفی باشد، آزیموت خط چیست؟',['180°','0°','90°','270°'],0,'زاویه و مختصات');
   add('اگر ΔX منفی و ΔY=0 باشد، آزیموت خط چیست؟',['270°','90°','180°','0°'],0,'زاویه و مختصات');
   add('طول افقی خط با ΔX='+d+' و ΔY='+(d+3)+' تقریباً از کدام رابطه به‌دست می‌آید؟',['√(ΔX²+ΔY²)','ΔX+ΔY فقط','ΔX−ΔY','ΔX×ΔY'],0,'زاویه و مختصات');
   add('برای تبدیل درجه اعشاری به درجه-دقیقه-ثانیه، بخش اعشاری درجه ابتدا در چه عددی ضرب می‌شود تا دقیقه به‌دست آید؟',['60','100','10','360'],0,'زاویه و مختصات');
   add('یک دور کامل افقی چند درجه است؟',['360°','180°','90°','400°'],0,'زاویه و مختصات');
 }
 for(i=1;i<=5;i++){
   a=i+2; b=i+5;
   add('مساحت مستطیلی با طول '+a+' و عرض '+b+' متر چقدر است؟',[String(a*b)+' m²',String(2*(a+b))+' m²',String(a+b)+' m²',String(a*b*2)+' m²'],0,'مساحت و حجم');
   add('محیط مستطیلی با طول '+a+' و عرض '+b+' متر چقدر است؟',[String(2*(a+b))+' m',String(a*b)+' m',String(a+b)+' m',String(a*b*2)+' m'],0,'مساحت و حجم');
   add('حجم منشوری با مساحت مقطع '+a+' m² و طول '+b+' m چقدر است؟',[String(a*b)+' m³',String(a+b)+' m³',String(2*(a+b))+' m³',String(b/a)+' m³'],0,'مساحت و حجم');
   add('در روش مختصات (Shoelace)، برای محاسبه مساحت چندضلعی چه داده‌ای لازم است؟',['مختصات رأس‌ها به ترتیب','فقط نام نقاط','فقط ارتفاع دستگاه','فقط DP'],0,'مساحت و حجم');
   add('برای محاسبه Cut/Fill بین سطح موجود و طرح، چه چیزی لازم است؟',['مقایسه ارتفاع‌های متناظر دو سطح','فقط شماره نقاط','فقط آزیموت','فقط طول خط'],0,'مساحت و حجم');
   add('اگر ارتفاع موجود 102 و ارتفاع طرح 100 باشد، مقدار اختلاف موجود−طرح چیست؟',['2 m','−2 m','202 m','0 m'],0,'مساحت و حجم');
   add('اگر مساحت 200 m² و ضخامت یکنواخت '+a+' m باشد، حجم تقریبی چیست؟',[String(200*a)+' m³',String(200+a)+' m³','200/a m³','a/200 m³'],0,'مساحت و حجم');
   add('در محاسبه محیط یک پلیگون، چه چیزی باید جمع شود؟',['طول تمام اضلاع','فقط مختصات X','فقط مختصات Y','ارتفاع‌ها'],0,'مساحت و حجم');
   add('برای پلیگون بسته، آخرین رأس معمولاً چگونه به اولی مرتبط می‌شود؟',['با یک ضلع بسته‌کننده','با حذف رأس اول','با تغییر Zone','با تبدیل به نقطه کنترل'],0,'مساحت و حجم');
   add('برای بررسی منطقی بودن مساحت، کدام کنترل ساده مفید است؟',['مقایسه با ابعاد و شکل زمین','تغییر نام Job','حذف نقاط','تغییر فرمت فایل'],0,'مساحت و حجم');
 }
 for(i=1;i<=5;i++){
   d=(i%7)+1;
   add('کدام عبارت درباره خطای سیستماتیک درست‌تر است؟',['الگوی قابل پیش‌بینی دارد','کاملاً تصادفی است','همیشه صفر است','فقط در PDF رخ می‌دهد'],0,'خطا و QC');
   add('خطای تصادفی معمولاً چگونه کاهش می‌یابد؟',['با تکرار و روش آماری مناسب','با حذف همه داده‌ها','با تغییر نام پروژه','با افزایش فونت'],0,'خطا و QC');
   add('کنترل بسته‌شدن تراورس برای چه انجام می‌شود؟',['ارزیابی سازگاری و خطای شبکه','تولید KML','تغییر ارتفاع آنتن','ساخت عکس'],0,'خطا و QC');
   add('اگر خطای بستگی از تلرانس پروژه بیشتر باشد، اقدام مناسب چیست؟',['بررسی مشاهدات و منابع خطا','نادیده گرفتن نتیجه','حذف نقطه کنترل','تغییر واحد بدون بررسی'],0,'خطا و QC');
   add('کدام مورد نمونه کنترل مستقل است؟',['اندازه‌گیری نقطه با مشاهده یا روش مستقل','کپی مختصات همان فایل','تغییر DP','تغییر رنگ نقطه'],0,'خطا و QC');
   add('ثبت نسخه پشتیبان داده خام چه فایده‌ای دارد؟',['امکان بازیابی و ممیزی','افزایش دقت سنسور','تغییر آزیموت','افزایش ظرفیت منشور'],0,'خطا و QC');
