/* V28 Excel engine guard */
window.addEventListener("error", function(ev){ try { if(String(ev.message||"").toLowerCase().indexOf("xlsx")>=0 && typeof window.XLSX === "undefined") { var s=document.getElementById("excelStatus"); if(s) s.textContent="Excel engine failed to initialize."; } } catch(e){} });
