 ['پیاده‌سازی نقطه چیست؟','انتقال موقعیت مختصات طراحی‌شده به محل واقعی روی زمین است.'],
 ['درون‌یابی چیست؟','تخمین مقدار یک کمیت در بین داده‌های معلوم است.'],
 ['یو‌تی‌ام چیست؟','یک سامانه تصویر نقشه‌ای با زون‌های طولی برای نمایش مختصات زمینی است.'],
 ['ارتفاع نقطه چگونه کنترل می‌شود؟','با روش اندازه‌گیری مستقل یا کنترل ترازیابی و مقایسه با مقدار مرجع.'],
 ['چرا شماره نقطه باید یکتا باشد؟','برای جلوگیری از ابهام و امکان ردیابی هر مشاهده و مختصات.'],
 ['شرح نقطه چه کاربردی دارد؟','برای ثبت توضیح، کد یا ویژگی مرتبط با نقطه استفاده می‌شود.'],
 ['قبل از تحویل داده چه کاری ضروری است؟','کنترل مختصات، واحدها، محاسبات، خطاها و قالب خروجی.']
];
// V585 — فلش‌کارت تکمیل‌شده؛ فقط این بخش تغییر کرده و منوهای ۱ تا ۲۰ دست‌نخورده‌اند.
(function(){
  var extraCards=[
  ["مبانی","ژئودزی چیست؟","دانش بررسی شکل، اندازه و میدان ثقل زمین و تعیین موقعیت دقیق نقاط روی آن است."],
  ["مبانی","توپوگرافی چیست؟","نمایش شکل زمین و عوارض طبیعی و مصنوعی همراه با اطلاعات ارتفاعی است."],
  ["مبانی","دقت و صحت چه تفاوتی دارند؟","دقت به تکرارپذیری نتایج نزدیک است؛ صحت به نزدیک‌بودن نتیجه به مقدار واقعی یا مرجع."],
  ["مبانی","کنترل مستقل چرا انجام می‌شود؟","برای ارزیابی کیفیت نتیجه بدون اینکه همان داده‌های اصلی دوباره مبنای کنترل باشند."],
  ["توتال‌استیشن","ارتفاع منشور چیست؟","فاصله قائم مرکز منشور تا نقطه‌ای که مختصات آن را محاسبه می‌کنیم، طبق قرارداد دستگاه."],
  ["توتال‌استیشن","HI مخفف چیست؟","ارتفاع دستگاه؛ فاصله قائم مرجع ارتفاعی نقطه استقرار تا محور اندازه‌گیری دستگاه."],
  ["توتال‌استیشن","HT چیست؟","ارتفاع تارگت یا منشور نسبت به نقطه هدف، طبق قرارداد ثبت پروژه."],
  ["توتال‌استیشن","چرا مرکز کردن دستگاه مهم است؟","چون خطای مرکزسازی مستقیماً می‌تواند مختصات و جهت برداشت را تحت تأثیر قرار دهد."],
  ["توتال‌استیشن","تراز کردن دستگاه چه هدفی دارد؟","قرار دادن محور قائم دستگاه در وضعیت صحیح نسبت به قائم واقعی برای اندازه‌گیری معتبر."],
  ["توتال‌استیشن","پشت‌دید چه نقشی دارد؟","ایجاد یا کنترل جهت مرجع دستگاه با استفاده از نقطه معلوم یا جهت معلوم."],
  ["COGO","ΔX چگونه محاسبه می‌شود؟","ΔX = X₂ − X₁."],
  ["COGO","ΔY چگونه محاسبه می‌شود؟","ΔY = Y₂ − Y₁."],
  ["COGO","فاصله افقی دو نقطه چگونه به‌دست می‌آید؟","D = √(ΔX² + ΔY²)."],
  ["COGO","برای مختصات قطبی، ΔX چیست؟","ΔX = D × sin(Az)، در قراردادی که آزیموت از شمال و ساعتگرد تعریف شده باشد."],
  ["COGO","برای مختصات قطبی، ΔY چیست؟","ΔY = D × cos(Az)، در همان قرارداد آزیموت."],
  ["COGO","مختصات نقطه جدید X چگونه محاسبه می‌شود؟","X₂ = X₁ + D sin(Az)."],
  ["COGO","مختصات نقطه جدید Y چگونه محاسبه می‌شود؟","Y₂ = Y₁ + D cos(Az)."],
  ["آزیموت","آزیموت معکوس چیست؟","جهت خط در جهت مخالف؛ معمولاً با افزودن یا کم‌کردن ۱۸۰ درجه و نگه‌داشتن نتیجه در بازه ۰ تا ۳۶۰ درجه."],
  ["آزیموت","اگر آزیموت ۳۵۰ درجه باشد، آزیموت معکوس چند است؟","۱۷۰ درجه."],
  ["آزیموت","اگر آزیموت ۱۲۰ درجه باشد، آزیموت معکوس چند است؟","۳۰۰ درجه."],
  ["آزیموت","چرا قرارداد آزیموت باید مشخص باشد؟","چون تعریف محور مرجع و جهت افزایش زاویه مستقیماً روی مختصات و نتایج محاسبات اثر می‌گذارد."],
  ["ترازیابی","BS چیست؟","قرائت پشت؛ معمولاً روی نقطه‌ای با ارتفاع معلوم یا نقطه مرجع برای تعیین ارتفاع دستگاه خوانده می‌شود."],
  ["ترازیابی","FS چیست؟","قرائت جلو؛ برای تعیین ارتفاع نقطه هدف یا انتقال ارتفاع استفاده می‌شود."],
  ["ترازیابی","HI در ترازیابی چگونه محاسبه می‌شود؟","HI = RL نقطه معلوم + BS."],
  ["ترازیابی","RL نقطه جدید چگونه محاسبه می‌شود؟","RL = HI − FS."],
  ["ترازیابی","Rise چیست؟","افزایش ارتفاع بین دو نقطه طبق قرارداد روش Rise & Fall."],
  ["ترازیابی","Fall چیست؟","کاهش ارتفاع بین دو نقطه طبق قرارداد روش Rise & Fall."],
  ["ترازیابی","چرا طول دیدها را متعادل می‌کنند؟","برای کاهش اثر برخی خطاهای وابسته به فاصله دید، به‌خصوص در ترازیابی دقیق."],
  ["GNSS","GNSS چیست؟","سامانه کلی ناوبری ماهواره‌ای جهانی که مجموعه سامانه‌هایی مانند GPS و دیگر منظومه‌ها را دربرمی‌گیرد."],
  ["GNSS","RTK چیست؟","روش تعیین موقعیت آنی با استفاده از اصلاحات و ارتباط بین ایستگاه مرجع و گیرنده متحرک برای رسیدن به دقت بالا."],
  ["GNSS","PPK چیست؟","روش پردازش پس از برداشت که داده‌های خام گیرنده و مرجع را بعداً پردازش می‌کند."],
  ["GNSS","Fix در RTK چه مفهومی دارد؟","نشان‌دهنده حل مناسب ابهام‌های فاز و دستیابی به وضعیت دقیق‌تر موقعیت، طبق وضعیت گیرنده."],
  ["GNSS","چرا موانع اطراف گیرنده GNSS مهم‌اند؟","چون می‌توانند دید ماهواره‌ای و کیفیت سیگنال را کاهش داده و خطا یا چندمسیری ایجاد کنند."],
  ["GNSS","PDOP چه چیزی را بیان می‌کند؟","شاخصی از هندسه توزیع ماهواره‌ها و اثر آن بر کیفیت هندسی تعیین موقعیت است."],
  ["مختصات","UTM چیست؟","یک سامانه مختصات صفحه‌ای بر پایه تقسیم زمین به زون‌های طولی است."],
  ["مختصات","زون UTM چند درجه طول جغرافیایی را پوشش می‌دهد؟","هر زون استاندارد UTM پهنای ۶ درجه طول جغرافیایی دارد."],
  ["مختصات","WGS84 چیست؟","یک چارچوب مرجع ژئودتیکی جهانی که در بسیاری از کاربردهای GNSS استفاده می‌شود."],
  ["مختصات","Datum چه نقشی دارد؟","چارچوب مرجع هندسی برای تعریف موقعیت روی زمین را مشخص می‌کند."],
  ["مختصات","Projection چیست؟","روشی برای تبدیل سطح خمیده زمین به نمایش صفحه‌ای با قواعد و اعوجاج‌های مشخص است."],
  ["مساحت","روش بندکفشی برای چه کاری است؟","برای محاسبه مساحت پلیگون از مختصات رأس‌های آن استفاده می‌شود."],
  ["مساحت","برای محاسبه مساحت پلیگون چه شرطی مهم است؟","ترتیب رأس‌ها باید پیوسته و مشخص باشد و مسیر در محاسبه به‌درستی بسته شود."],
  ["مساحت","واحد مساحت از چه چیزی به‌دست می‌آید؟","از حاصل‌ضرب دو واحد طول؛ مثلاً متر مربع از متر × متر."],
  ["حجم","حجم منشور قائم چگونه محاسبه می‌شود؟","V = A × h."],
  ["حجم","در محاسبه حجم بین دو مقطع، رابطه ذوزنقه‌ای ساده چیست؟","V = h × (A₁ + A₂) / 2."],
  ["خطا","خطای مطلق چیست؟","قدر مطلق اختلاف مقدار مشاهده‌شده و مقدار مرجع است."],
  ["خطا","خطای نسبی چیست؟","خطای مطلق تقسیم بر مقدار مرجع است، در صورتی که مقدار مرجع صفر نباشد."],
  ["خطا","درصد خطا چگونه محاسبه می‌شود؟","درصد خطا = خطای مطلق ÷ مقدار مرجع × ۱۰۰."],
  ["خطا","خطای بسته‌شدن مختصات چیست؟","اختلاف باقی‌مانده در مؤلفه‌های مختصاتی پس از طی یک مسیر یا شبکه که باید به مقدار مورد انتظار بسته شود."],
  ["کنترل کیفیت","قبل از تحویل نقاط چه چیزهایی باید کنترل شوند؟","شماره نقاط، مختصات، واحدها، ارتفاع‌ها، کدها، خطاها، تکراری نبودن نقاط و قالب خروجی."],
  ["کنترل کیفیت","چرا نقاط تکراری باید بررسی شوند؟","چون ممکن است باعث ابهام، خطای گزارش یا مشکل در پردازش و ترسیم شوند."],
  ["کنترل کیفیت","چرا چند نقطه نمونه را بعد از ورود Excel کنترل کنیم؟","برای تشخیص جابه‌جایی ستون‌ها، واحد اشتباه یا خواندن نادرست فایل قبل از استفاده از کل داده."],
  ["خروجی","KML بیشتر برای چه کاری مناسب است؟","نمایش و تبادل عوارض مکانی در نرم‌افزارهایی مانند Google Earth."],
  ["خروجی","DXF چه کاربردی دارد؟","تبادل داده ترسیمی و هندسی با نرم‌افزارهای CAD و نقشه‌کشی."],
  ["خروجی","CSV چیست؟","قالب متنی جدولی برای تبادل داده‌های ساختاریافته با جداکننده مشخص."],
  ["خروجی","چرا نام نقطه باید در خروجی حفظ شود؟","برای ردیابی، تطبیق داده میدانی و جلوگیری از ابهام در پردازش بعدی."],
  ["فتوگرامتری","فتوگرامتری چیست؟","استخراج اطلاعات هندسی و سه‌بعدی از تصاویر با استفاده از روابط تصویری و هندسی."],
  ["فتوگرامتری","همپوشانی تصاویر چرا مهم است؟","برای ایجاد ارتباط کافی بین تصاویر و امکان تطبیق و بازسازی هندسی."],
  ["GIS","GIS چیست؟","سامانه‌ای برای جمع‌آوری، مدیریت، تحلیل و نمایش داده‌های دارای مؤلفه مکانی."],
  ["GIS","لایه در GIS چیست؟","مجموعه‌ای از عوارض هم‌نوع یا مرتبط که به‌صورت یک موضوع مکانی مدیریت و نمایش داده می‌شود."],
  ["راه و عمران","شیب درصدی چگونه محاسبه می‌شود؟","شیب٪ = ΔZ ÷ D × ۱۰۰، با استفاده از اختلاف ارتفاع و فاصله افقی."],
  ["راه و عمران","شیب مثبت چه مفهومی دارد؟","در قرارداد رایج، افزایش ارتفاع در جهت حرکت یا افزایش مقدار Z را نشان می‌دهد."],
  ["راه و عمران","چرا واحدها باید یکسان باشند؟","چون ترکیب واحدهای متفاوت می‌تواند نتیجه محاسبه را به‌شدت اشتباه کند."],
  ["مقیاس","مقیاس ۱:۱۰۰۰ یعنی چه؟","هر واحد روی نقشه معادل ۱۰۰۰ واحد از همان نوع در واقعیت است."],
  ["مقیاس","اگر فاصله روی نقشه ۵ سانتی‌متر و مقیاس ۱:۱۰۰۰ باشد، فاصله واقعی چقدر است؟","۵۰ متر، چون ۵ سانتی‌متر × ۱۰۰۰ = ۵۰۰۰ سانتی‌متر = ۵۰ متر."],
  ["مبانی","چرا واحد پروژه باید از ابتدا مشخص باشد؟","برای جلوگیری از اشتباه در فاصله، مساحت، ارتفاع، خروجی و تبادل داده."],
  ["مبانی","Point Code یا DP چه کاربردی دارد؟","برای توصیف نوع عارضه یا کدگذاری نقطه و کمک به طبقه‌بندی و پردازش داده."],
  ["مبانی","چرا ثبت زمان و اطلاعات برداشت مفید است؟","برای ردیابی عملیات، کنترل کیفیت و بررسی شرایط برداشت در پروژه."],
  ["مبانی","Backup داده‌های میدانی چرا ضروری است؟","برای جلوگیری از از دست رفتن داده و امکان بازگشت به نسخه معتبر قبلی."],
  ];
  for(var i=0;i<extraCards.length;i++) flashcards.push([extraCards[i][1],extraCards[i][2],extraCards[i][0]]);
  // اتصال داده فلش‌کارت به بخش مستقل منوی ۱۶
  window.flashcards = flashcards;
})();
var fcLearnKey='miladgeo_fc_learning_v1_'+MILADGEO_ACCOUNT_KEY;
function fcLoad(){try{var x=JSON.parse(localStorage.getItem(fcLearnKey)||'{}');return x&&typeof x==='object'?x:{};}catch(e){return {};}}
function fcSave(d){try{localStorage.setItem(fcLearnKey,JSON.stringify(d));}catch(e){}}
function fcMark(kind){var d=fcLoad(),k=String(flashcardIndex);d[k]=kind;fcSave(d);return false;}
function fcCount(kind){var d=fcLoad(),n=0;Object.keys(d).forEach(function(k){if(d[k]===kind)n++;});return n;}
function fcReset(){try{localStorage.removeItem(fcLearnKey);}catch(e){}flashcardIndex=0;flashcardFlipped=false;return renderFlashcards();}
function fcMode(mode){var d=fcLoad();if(mode==='review'){var ids=Object.keys(d).filter(function(k){return d[k]==='review';}).map(Number).filter(function(i){return i>=0&&i<flashcards.length;});if(ids.length){flashcardIndex=ids[0];flashcardFlipped=false;window.fcReviewIds=ids;window.fcReviewPos=0;}else{showToast('هنوز کارتی برای مرور علامت نخورده است.');}}else{window.fcReviewIds=null;}return renderFlashcards();}
function fcNextReview(){var ids=window.fcReviewIds||[];if(!ids.length)return nextFlashcard();window.fcReviewPos=(Number(window.fcReviewPos)||0)+1;if(window.fcReviewPos>=ids.length)window.fcReviewPos=0;flashcardIndex=ids[window.fcReviewPos];flashcardFlipped=false;return renderFlashcards();}
function renderFlashcards(){
 var body=$('trainingBody'),prog=$('trainingProgress');if(!body)return false;
 if(!Array.isArray(flashcards)||!flashcards.length){
   if(prog)prog.innerHTML='<div class="result-line"><span>فلش‌کارت</span><b>۰ کارت</b></div>';
   body.innerHTML='<div class="training-panel-head"><button type="button" class="btn gray" onclick="trainingHome();return false;">← بازگشت</button><b>🗂 فلش‌کارت نقشه‌برداری</b></div><div class="elib-panel open"><div class="elib-head"><span>فلش‌کارت‌ها</span><em>خطا</em></div><div class="elib-note">کارت‌ها بارگذاری نشده‌اند.</div></div>';
   return false;
 }
 if(flashcardIndex<0||flashcardIndex>=flashcards.length)flashcardIndex=0;
 var c=flashcards[flashcardIndex]||['',''],shown=flashcardFlipped?c[1]:c[0],d=fcLoad(),state=d[String(flashcardIndex)]||'';
 if(prog)prog.innerHTML='<div class="result-line"><span>فلش‌کارت نقشه‌برداری</span><b>'+(flashcardIndex+1)+' / '+flashcards.length+'</b></div>';
 body.innerHTML='<div class="training-panel-head"><button type="button" class="btn gray" onclick="trainingHome();return false;">← بازگشت</button><b>🗂 فلش‌کارت نقشه‌برداری</b></div>'+
 '<div class="fc-toolbar"><span>بلدم: <b>'+fcCount('known')+'</b></span><span>نیاز به مرور: <b>'+fcCount('review')+'</b></span><button type="button" class="btn gray" onclick="fcMode(&quot;review&quot;);return false;">↻ مرور کارت‌های علامت‌خورده</button></div>'+
 '<div class="flashcard-wrap"><div class="flashcard '+(state==='known'?'fc-known':state==='review'?'fc-review':'')+'" onclick="flipFlashcard();return false;"><div class="fc-label">'+(flashcardFlipped?'پاسخ':'سؤال — برای دیدن پاسخ لمس کن')+'</div><div class="fc-text">'+escapeHTML(shown)+'</div><div class="fc-hint">لمس کارت = نمایش '+(flashcardFlipped?'سؤال':'پاسخ')+'</div></div>'+
 '<div class="btn-row" style="margin-top:8px"><button type="button" class="btn gray" onclick="prevFlashcard();return false;">← قبلی</button><button type="button" class="btn primary" onclick="nextFlashcard();return false;">بعدی →</button></div>'+
 '<div class="btn-row" style="margin-top:7px"><button type="button" class="btn primary" onclick="fcMark(&quot;known&quot;);renderFlashcards();return false;">✓ بلدم</button><button type="button" class="btn gray" onclick="fcMark(&quot;review&quot;);renderFlashcards();return false;">↻ نیاز به مرور</button></div>'+
 '<button type="button" class="btn gray" style="width:100%;margin-top:7px" onclick="fcReset();return false;">پاک‌کردن وضعیت فلش‌کارت‌ها</button></div>'+
 '<div class="fc-count-note">مجموع کارت‌ها: <b>'+flashcards.length+'</b> • دسته‌های آموزشی: <b>۱۶</b></div>'+renderQuizStats();return false;
}
var surveyFormulas=[
 ['مختصات از فاصله و آزیموت','ΔX = D × sin(Az)\nΔY = D × cos(Az)\nX₂ = X₁ + ΔX\nY₂ = Y₁ + ΔY','برای آزیموت از شمال و جهت ساعتگرد استفاده کن.'],
 ['فاصله افقی از مختصات','D = √((X₂−X₁)² + (Y₂−Y₁)²)','برای دو نقطه معلوم، اختلاف‌های X و Y را به‌دست بیاور.'],
 ['آزیموت از مختصات','Az = atan2(ΔX, ΔY)\nنتیجه را به بازه ۰ تا ۳۶۰ درجه تبدیل کن.','ترتیب ورودی‌ها مهم است: ΔX بر ΔY.'],
 ['شیب طولی','شیب(٪) = (ΔZ / D) × 100','ΔZ اختلاف ارتفاع و D فاصله افقی است.'],
 ['اختلاف ارتفاع با زاویه قائم','ΔZ = D × tan(V)','این رابطه برای زاویه قائم V نسبت به افق به‌کار می‌رود.'],
 ['ارتفاع دستگاه','HI = RL نقطه مرجع + قرائت پشت','واحد قرائت و ارتفاع باید یکسان باشد.'],
 ['ارتفاع نقطه با ارتفاع دستگاه','RL نقطه = HI − قرائت','در ترازیابی و محاسبات ارتفاعی کاربرد دارد.'],
 ['مساحت پلیگون؛ روش بندکفشی','A = ½ |Σ(XᵢYᵢ₊₁ − YᵢXᵢ₊₁)|','نقطه آخر باید به نقطه اول وصل شود.'],
 ['مساحت مثلث از سه ضلع','s = (a+b+c)/2\nA = √(s(s−a)(s−b)(s−c))','این رابطه زمانی مناسب است که سه ضلع معلوم باشند.'],
 ['تبدیل درجه به گون','گون = درجه × 10/9','هر ۹۰ درجه برابر ۱۰۰ گون است.'],
 ['تبدیل گون به درجه','درجه = گون × 0.9','برای تبدیل زاویه گون به درجه استفاده می‌شود.'],
 ['تبدیل درجه به رادیان','رادیان = درجه × π/180','برای محاسبات مثلثاتی برحسب رادیان کاربرد دارد.'],
 ['تبدیل رادیان به درجه','درجه = رادیان × 180/π','نتیجه را در صورت نیاز گرد کن.'],
 ['خطای بسته‌شدن مختصات','e = √(eX² + eY²)','eX و eY مؤلفه‌های خطای بسته‌شدن هستند.'],
 ['خطای نسبی بسته‌شدن','دقت نسبی ≈ طول کل مسیر / خطای بسته‌شدن','هرچه مقدار دقت نسبی بزرگ‌تر باشد، خطای نسبی کوچک‌تر است.'],
 ['اختلاف ارتفاع دو نقطه','ΔZ = Z₂ − Z₁','علامت اختلاف ارتفاع جهت افزایش یا کاهش را مشخص می‌کند.'],
 ['مساحت مستطیل','A = طول × عرض','واحد مساحت برابر حاصل‌ضرب واحدهای طول است.'],
 ['حجم منشور قائم','V = A × h','A مساحت قاعده و h ارتفاع است.'],
 ['حجم ذوزنقه‌ای ساده','V = h × (A₁ + A₂) / 2','برای دو مقطع با مساحت A₁ و A₂ و فاصله h.'],
 ['میانگین دو مشاهده','میانگین = (L₁ + L₂) / 2','برای دو مشاهده هم‌واحد و هم‌نوع استفاده می‌شود.'],
 ['خطای مطلق','خطای مطلق = |مقدار مشاهده‌شده − مقدار مرجع|','فقط بزرگی اختلاف را نشان می‌دهد.'],
 ['خطای نسبی','خطای نسبی = خطای مطلق / مقدار مرجع','برای بیان خطا به‌صورت نسبتی استفاده می‌شود.'],
 ['درصد خطا','درصد خطا = (خطای مطلق / مقدار مرجع) × 100','مقدار مرجع نباید صفر باشد.'],
 ['مختصات قطبی به دکارتی','X₂ = X₁ + D sin(Az)\nY₂ = Y₁ + D cos(Az)','مبدأ، فاصله و جهت باید در یک دستگاه مختصات باشند.'],
 ['کنترل اختلاف مختصات','ΔX = X₂ − X₁\nΔY = Y₂ − Y₁','این دو مؤلفه پایه محاسبه فاصله و جهت هستند.']
];
function renderSurveyFormulas(){
 var body=$('trainingBody'),prog=$('trainingProgress');if(!body)return false;
 if(prog)prog.innerHTML='<div class="result-line"><span>فرمول‌ها</span><b>'+surveyFormulas.length+' فرمول کاربردی</b></div>';
 var h='<div class="training-panel-head"><button type="button" class="btn gray" onclick="trainingHome();return false;">← منوی ۱۴</button><b><strong style="font-size:1.15em;font-weight:900">📐 فرمول‌های نقشه‌برداری</strong></b></div>';
 h+='<div class="subtitle">فرمول‌های پرکاربرد برای برداشت، توتال‌استیشن، ترازیابی، مختصات، مساحت، حجم و کنترل خطا.</div>';
 for(var i=0;i<surveyFormulas.length;i++){
   var f=surveyFormulas[i];
   h+='<div class="formula-card"><div class="formula-title">'+(i+1)+' — '+escapeHTML(f[0])+'</div><pre class="formula-text">'+escapeHTML(f[1])+'</pre><div class="formula-note">'+escapeHTML(f[2])+'</div></div>';
 }
 body.innerHTML=h;return false;
}
function renderTraining(key){
 if(key==='surveyLearn')return openTrainingMode('surveyLearn');
 if(key==='surveyQuiz')return openTrainingMode('surveyQuiz');
 if(key==='appLearn')return openTrainingMode('appLearn');
 if(key==='surveyFlashcards')return openTrainingMode('surveyFlashcards');
 if(key==='surveyFormulas')return openTrainingMode('surveyFormulas');
 return trainingHome();
}
function openTrainingMode(mode){
 var prog=$("trainingProgress"),body=$("trainingBody");
 if(!body)return false;
 var trainingLibraryPanel=$("trainingLibrary");
 if(mode!=='library' && trainingLibraryPanel) trainingLibraryPanel.style.display="none";
 if(mode==='home'){return trainingHome();}
 if(mode==='library'){var lib=$("trainingLibrary");if(lib){lib.style.display="block";setTimeout(function(){try{lib.scrollIntoView({behavior:"smooth",block:"start"});}catch(e){}},40);}if(prog)prog.innerHTML='<div class="result-line"><span>MODE</span><b>کتابخانه حرفه‌ای MiladGeo</b></div>';return false;}
 if(mode==='surveyLearn'){
  if(prog)prog.innerHTML='<div class="result-line"><span>MODE</span><b>آموزش نقشه‌برداری</b></div>';
  body.innerHTML='<div class="training-panel-head"><button type="button" class="btn gray" onclick="trainingHome();return false;">← بازگشت</button><b>آموزش کاربردی نقشه‌برداری</b></div>'+buildSurveyLessons();
  initSurveyLessonSearch();
  return false;
 }
 if(mode==='appLearn'){
  if(prog)prog.innerHTML='<div class="result-line"><span>MODE</span><b>آموزش مینی‌اپ MiladGeo</b></div>';
  body.innerHTML='<div class="training-panel-head"><button type="button" class="btn gray" onclick="trainingHome();return false;">← بازگشت</button><b>MiladGeo — راهنمای کاربری</b></div>'+buildAppLessons();
  return false;
 }
 if(mode==='surveyQuiz'){
  buildSurveyQuizBank(); quizMode='smart';quizOrder=shuffleArray(surveyQuizBank.map(function(_,i){return i;}));quizIndex=0;quizAnswered=false;quizScore=0;quizSeen=0;quizHistory=[];quizCurrentOptions=[];quizCurrentCorrect=0;
  if(prog)prog.innerHTML='<div class="result-line"><span>آزمون هوشمند</span><b>'+surveyQuizBank.length+' تست — ترتیب تصادفی</b></div><div class="result-line"><span>امتیاز این آزمون</span><b id="quizLiveScore">0 / 0</b></div>';
  renderQuiz(); return false;
 }
 if(mode==='surveyFlashcards'){flashcardIndex=0;flashcardFlipped=false;return renderFlashcards();}
 if(mode==='surveyFormulas'){return renderSurveyFormulas();}
 return trainingHome();
}
function buildSurveyLessons(){
 var L=[
 ['۱. نقشه‌برداری چیست؟','نقشه‌برداری مجموعه‌ای از اندازه‌گیری، محاسبه، کنترل و نمایش موقعیت عوارض است. در آغاز هر پروژه، هدف کار، دقت موردنیاز، دستگاه مختصات، واحدها و روش کنترل اندازه‌گیری‌ها را روشن کنید.'],
 ['۲. سیستم مختصات و واحدها','پیش از وارد کردن داده‌ها، مطمئن شوید محورهای X و Y چه جهتی دارند، مبدأ مختصات کجاست، طول و زاویه با چه واحدی ثبت می‌شوند و ارتفاع‌ها به کدام مرجع وابسته‌اند. اشتباه در انتخاب واحد ممکن است مختصات و اندازه‌های کل پروژه را نادرست کند.'],
 ['۳. مقیاس و دقت نقشه','مقیاس رابطه فاصله روی نقشه و فاصله واقعی است. دقت موردنیاز برداشت به هدف پروژه بستگی دارد. بزرگ‌تر کردن مقیاس نقشه، به‌تنهایی دقت اندازه‌گیری‌ها را افزایش نمی‌دهد.'],
 ['۴. مبانی زاویه و آزیموت','در این برنامه آزیموت از شمال و در جهت ساعتگرد در نظر گرفته می‌شود. پیش از شروع کار، شیوه نمایش زاویه در دستگاه و نرم‌افزار را با مشخصات پروژه تطبیق دهید تا جهت‌ها اشتباه ثبت نشوند.'],
 ['۵. فاصله افقی، شیب و اختلاف ارتفاع','فاصله افقی، فاصله مایل، شیب و اختلاف ارتفاع مفاهیم متفاوتی هستند؛ هنگام محاسبه باید بدانید هر عدد به کدام‌یک اشاره دارد. در محاسبات، واحد تمام داده‌های ورودی باید یکسان باشد. همچنین علامت مثبت یا منفی اختلاف ارتفاع را هنگام محاسبه تغییر ندهید.'],
 ['۶. استقرار Total Station','محل استقرار باید دید مناسب، پایداری و دسترسی کافی داشته باشد. دستگاه را روی سه‌پایه محکم کنید، آن را دقیقاً روی نقطه استقرار مرکز و تراز کنید و سپس مختصات ایستگاه و ارتفاع دستگاه (HI) را ثبت کنید.'],
 ['۷. کنترل Station و HI','مختصات X، Y و Z ایستگاه را با اطلاعات مرجع مقایسه کنید. ارتفاع دستگاه (HI) را طبق روش مشخص اندازه بگیرید و واحد آن را بررسی کنید؛ اشتباه در این مقدار، ارتفاع نقاط برداشت‌شده را نیز جابه‌جا می‌کند.'],
 ['۸. Orientation و Backsight','توجیه دستگاه با آزیموت معلوم یا نقطه پشت‌دید با مختصات معلوم انجام می‌شود. پس از توجیه، حتماً یک نقطه معلوم را کنترل کن و اگر اختلاف غیرمنطقی بود برداشت را ادامه نده.'],
 ['۹. برداشت نقطه با Total Station','برای هر نقطه، شماره‌ای یکتا و کدی روشن و قابل‌فهم ثبت کنید. فاصله، جهت و ارتفاع را کنترل کن و اگر مختصات حاصل با موقعیت واقعی سازگار نیست، همان لحظه اندازه‌گیری را تکرار کن.'],
 ['۱۰. کدگذاری عوارض و DP','کدهایی مثل ROAD، CURB، TREE، BLDG و CL باید برای تیم قابل فهم و ثابت باشند. کدگذاری منظم، ترسیم، جستجو و کنترل داده‌ها را سریع‌تر می‌کند.'],
 ['۱۱. مدیریت Point List','شماره، X، Y، Z و DP هر نقطه را کنترل کن. قبل از ویرایش یا حذف، وابستگی نقطه به مساحت، حجم، Stake Out یا خروجی‌ها را بررسی کن و نسخه پشتیبان داشته باش.'],
 ['۱۲. ترازیابی','در ترازیابی، قرائت‌های BS و FS برای تعیین اختلاف ارتفاع استفاده می‌شوند. طول دیدها، ثبت منظم قرائت‌ها و کنترل بسته‌شدن از مهم‌ترین اصول کنترل هستند.'],
 ['۱۳. ترازیابی مسیر و دفتر ترازیابی','برای هر ایستگاه، BS، FS، ارتفاع دستگاه، RL و فاصله‌ها را منظم ثبت کن. جمع‌بندی و کنترل اختلاف ارتفاع باید با داده‌های خام قابل ردیابی باشد.'],
 ['۱۴. COGO و محاسبات هندسی','فاصله، آزیموت، تقاطع، امتداد، مساحت و محیط از عملیات رایج COGO هستند. ترتیب نقاط و قرارداد محورهای مختصات در نتیجه محاسبات اهمیت مستقیم دارد.'],
 ['۱۵. محاسبه مختصات از فاصله و آزیموت','برای یک نقطه قطبی، در قرارداد این برنامه ΔX=d×sin(Az) و ΔY=d×cos(Az) است. سپس X₂=X₁+ΔX و Y₂=Y₁+ΔY. قبل از استفاده، قرارداد پروژه را کنترل کن.'],
 ['۱۶. مساحت پلیگون','برای مساحت مختصات، نقاط باید با ترتیب درست دور مرز قرار گرفته باشند و نقطه پایانی به نقطه ابتدایی برگردد. یک نقطه اشتباه یا ترتیب نادرست می‌تواند نتیجه مساحت را تغییر دهد.'],
 ['۱۷. Stake Out و پیاده‌سازی','ابتدا مختصات نقطه طراحی را کنترل کن. اختلاف مختصات، جهت و فاصله تا هدف را بخوان، نزدیک هدف گام‌ها را کوچک کن و در پایان یک کنترل مستقل یا As-Built انجام بده.'],
 ['۱۸. GNSS و انواع مشاهده','GNSS موقعیت را با استفاده از سامانه‌های ماهواره‌ای تعیین می‌کند. در RTK وضعیت FIX/FLOAT و تصحیحات مهم‌اند؛ در PPK بخشی از پردازش پس از برداشت انجام می‌شود.'],
 ['۱۹. کیفیت مشاهده GNSS','تعداد ماهواره، PDOP/HDOP، سن تصحیح، وضعیت FIX و موانع محیطی را هم‌زمان بررسی کن. هیچ شاخصی به‌تنهایی تضمین‌کننده دقت نهایی نیست؛ نقطه حساس را مستقل کنترل کن.'],
 ['۲۰. ارتفاع آنتن GNSS','روش اندازه‌گیری ارتفاع آنتن را مشخص و ثابت نگه دار. اشتباه در ارتفاع آنتن می‌تواند مستقیماً در مؤلفه Z وارد شود؛ نوع آنتن و روش اندازه‌گیری را در دفتر پروژه ثبت کن.'],
 ['۲۱. UAV و فتوگرامتری','در برداشت هوایی، محدوده، ارتفاع پرواز، همپوشانی تصاویر، نور، باد و موانع را کنترل کن. کیفیت خروجی به هندسه برداشت و کیفیت تصاویر وابسته است، نه فقط تعداد عکس‌ها.'],
 ['۲۲. GCP و Checkpoint','GCP برای کمک به تثبیت/کنترل مدل استفاده می‌شود و Checkpoint برای ارزیابی مستقل دقت مناسب است. توزیع مناسب نقاط کنترل در محدوده پروژه اهمیت دارد.'],
 ['۲۳. GIS و داده مکانی','در GIS، هندسه و اطلاعات توصیفی باید با سیستم مختصات درست همراه باشند. قبل از ترکیب لایه‌ها، CRS و واحدها را کنترل کن تا لایه‌ها روی هم قرار بگیرند.'],
 ['۲۴. کنترل کیفیت برداشت','کنترل مستقل نقطه معلوم، برداشت تکراری، کنترل بسته‌شدن، بررسی نقاط پرت و مقایسه با داده مرجع ابزارهای مهم QC هستند. حد مجاز خطا را بر اساس مشخصات همان پروژه یا استاندارد معتبر تعیین کنید.'],
 ['۲۵. خطاهای رایج نقشه‌برداری','واحد اشتباه، علامت اشتباه، Orientation نادرست، HI اشتباه، شماره تکراری، مختصات جابه‌جا و فایل با ستون‌های اشتباه از خطاهای رایج‌اند. قبل از اصلاح، علت خطا را پیدا کن.'],
 ['۲۶. ورود Excel و PENZD','قالب PENZD را دقیق کنترل کن: Point، Easting/X، Northing/Y، Elevation/Z و Description. جداکننده، اعشار، واحد و علامت منفی را بررسی و بعد از ورود چند نقطه را نمونه‌برداری کن.'],
 ['۲۷. کنترل نقشه گرافیکی','Graphic Map برای کنترل سریع شکل و موقعیت نسبی نقاط مفید است. نقاط دورافتاده، خطوط غیرطبیعی و جابه‌جایی احتمالی را بررسی کن، اما کنترل گرافیکی را جایگزین کنترل عددی نکن.'],
 ['۲۸. خروجی و تحویل پروژه','قبل از خروجی گرفتن، Job، تعداد نقاط، سیستم مختصات، واحدها و داده‌های کنترل را بررسی کن. بعد از Export، فایل خروجی را دوباره باز کن و چند رکورد را با داده داخلی تطبیق بده.'],
 ['۲۹. گردش‌کار حرفه‌ای یک پروژه','ترتیب پیشنهادی: تعریف پروژه → کنترل سیستم مختصات → کنترل نقاط مرجع → Station و Orientation → برداشت → کنترل حین کار → ویرایش و محاسبات → کنترل نهایی → خروجی و بایگانی.'],
 ['۳۰. چک‌لیست قبل از تحویل','□ Job صحیح  □ مختصات و واحدها صحیح  □ Station/Orientation کنترل شده  □ نقاط تکراری بررسی شده  □ کنترل مستقل انجام شده  □ محاسبات بازبینی شده  □ خروجی دوباره بررسی شده  □ نسخه پشتیبان نگهداری شده.'],
 ['۳۱. تمرین پیشنهادی ۱ — برداشت دو نقطه','یک Station فرضی انتخاب کن، یک Orientation مشخص کن و برای دو نقطه مختصات محاسبه کن. سپس فاصله و آزیموت بین دو نقطه را معکوس محاسبه کن و نتیجه را با مقدار اولیه مقایسه کن.'],
 ['۳۲. تمرین پیشنهادی ۲ — کنترل ارتفاع','دو نقطه با RL معلوم در نظر بگیر و یک مسیر ترازیابی کوتاه طراحی کن. BS و FS را ثبت کن، RLها را محاسبه کن و در پایان بسته‌شدن را کنترل کن.'],
 ['۳۳. تمرین پیشنهادی ۳ — کنترل پلیگون','چهار یا پنج نقطه یک پلیگون بساز، مساحت و محیط را محاسبه کن و سپس ترتیب دو نقطه را عمداً تغییر بده تا ببینی چرا نظم نقاط در مساحت اهمیت دارد.'],
 ['۳۴. تمرین پیشنهادی ۴ — کنترل کیفیت','برای یک برداشت فرضی سه خطا تعریف کن: واحد اشتباه، HI اشتباه و نقطه تکراری. برای هرکدام یک روش کشف و یک روش پیشگیری بنویس.'],
 ['۳۵. مسیر یادگیری پیشنهادی','برای یادگیری اصولی، ابتدا مبانی و مختصات را بخوان؛ سپس Station/Orientation و برداشت را تمرین کن؛ بعد ترازیابی، COGO، Stake Out و GNSS را یاد بگیر و در پایان QC، خروجی و تحویل را تمرین کن.'],
 ['۳۶. طراحی شبکه کنترل پروژه','پیش از برداشت جزئیات، نقاط کنترل را با دید مناسب، پایداری فیزیکی و پوشش متعادل محدوده انتخاب کن. برای هر نقطه شناسه، مختصات، تاریخ، روش تعیین مختصات و دقت/کیفیت ثبت کن. نقاط کنترل را با نقاط جزئیات یکی فرض نکن و برای کنترل نهایی، مشاهدات مستقل نگه دار.'],
 ['۳۷. شناخت مبنای افقی و قائم','Datum افقی، تصویر نقشه، زون، نیم‌کره و واحدها را در مشخصات پروژه ثبت کن. مبنای ارتفاعی نیز باید روشن باشد؛ ارتفاع GNSS نسبت به بیضوی با ارتفاع ارتومتریک یکی نیست. داده‌های دارای مبنای متفاوت را بدون تبدیل معتبر با هم ترکیب نکن.'],
 ['۳۸. تبدیل درجه، گون و رادیان','درجه و گون واحدهای متفاوت‌اند: ۳۶۰ درجه برابر ۴۰۰ گون است. پیش از ورود زاویه، واحد دستگاه و نرم‌افزار را بررسی کن. یک آزمون ساده با زاویه راست انجام بده: ۹۰ درجه برابر ۱۰۰ گون است. در گزارش، واحد زاویه را صریح بنویس.'],
 ['۳۹. محاسبه آزیموت از مختصات','ابتدا ΔX=X₂−X₁ و ΔY=Y₂−Y₁ را حساب کن. در قرارداد آزیموت از شمال و ساعت‌گرد، از atan2(ΔX,ΔY) استفاده و نتیجه را به بازه صفر تا ۳۶۰ درجه تبدیل کن. جهت محورهای پروژه را کنترل کن؛ جابه‌جایی X و Y یا استفاده از atan معمولی می‌تواند ربع زاویه را اشتباه کند.'],
 ['۴۰. پیمایش باز و بسته','پیمایش باز به کنترل انتهایی مستقل نیاز دارد و خطای بست آن معمولاً مستقیم از ابتدا تا انتها قابل محاسبه نیست. پیمایش بسته به نقطه شروع یا نقطه کنترل معلوم برمی‌گردد و امکان بررسی بست زاویه‌ای و مختصاتی را فراهم می‌کند. نوع پیمایش، روش تعدیل و تلرانس را پیش از کار تعیین کن.'],
 ['۴۱. خطای بست مختصاتی','پس از محاسبه مختصات پیمایش، اختلاف مختصات انتهای محاسباتی با مختصات کنترل را در مؤلفه‌های X و Y به دست آور. خطای بست افقی از ترکیب این دو مؤلفه محاسبه می‌شود. قبل از توزیع خطا، جهت‌ها، فاصله‌ها، واحد زاویه و مختصات نقاط کنترل را دوباره بررسی کن.'],
 ['۴۲. تعدیل خطای پیمایش','توزیع خطا یک مرحله محاسباتی است، نه راهی برای پنهان‌کردن مشاهده بد. روش‌هایی مانند بودیچ به طول اضلاع و فرض‌های مشخص وابسته‌اند. پیش از تعدیل، مقدار خطای بست را با معیار پروژه مقایسه کن و داده خام، خطای اولیه، روش تعدیل و نتایج نهایی را جداگانه نگه دار.'],
 ['۴۳. دفتر ترازیابی با روش ارتفاع دستگاه','اگر RL نقطه مبنا و قرائت پشت BS معلوم باشد، HI=RL+BS است. ارتفاع نقطه میانی یا جلو از RL=HI−قرائت به دست می‌آید. در نقطه تغییر، FS ایستگاه قبلی را ثبت و پس از جابه‌جایی دستگاه BS جدید را روی همان نقطه بخوان. محاسبات را با جمع BS و FS کنترل کن.'],
 ['۴۴. دفتر ترازیابی با روش افزایش و کاهش','در روش Rise and Fall، قرائت‌های متوالی را مقایسه کن تا افزایش یا کاهش ارتفاع تعیین شود. جمع افزایش‌ها منهای جمع کاهش‌ها باید با اختلاف RL انتهایی و ابتدایی سازگار باشد. هر قرائت را با شماره ایستگاه و نقطه تغییر ثبت کن؛ از حدس‌زدن یا اصلاح بی‌سند اعداد خودداری کن.'],
 ['۴۵. خطای بست ترازیابی','برای مسیر بسته، اختلاف RL انتهایی محاسبه‌شده با RL معلوم را به عنوان خطای بست بررسی کن. حد مجاز به طول مسیر، تعداد ایستگاه‌ها، کلاس ترازیابی و مشخصات پروژه وابسته است؛ یک تلرانس ثابت برای همه پروژه‌ها وجود ندارد. اگر خطا بیش از حد مجاز بود، مسیر یا قرائت‌های مشکوک را بازبینی و در صورت لزوم برداشت را تکرار کن.'],
 ['۴۶. ترازیابی طولی و عرضی مسیر','در مسیر راه یا کانال، زنجیره کیلومتراژ را با فاصله‌های منظم و نقاط شکست زمین ثبت کن. در نقاط تغییر شیب، آبرو، لبه مسیر و محل سازه‌ها قرائت‌های اضافی بگیر. مقاطع عرضی باید نسبت به محور و کیلومتراژ مشخص باشند تا برای محاسبه حجم خاکبرداری و خاکریزی قابل استفاده بمانند.'],
 ['۴۷. برداشت عوارض و کدگذاری','پیش از شروع، فهرست کدهای تیم را مشخص کن: محور، لبه آسفالت، جدول، ساختمان، درخت و شکست زمین. برای خطوط پیوسته، ترتیب برداشت و کدگذاری باید اجازه بازسازی هندسه را بدهد. کدهای مبهم و چندمعنا باعث اصلاح دستی و خطای ترسیم در دفتر می‌شوند.'],
 ['۴۸. برداشت جزئیات در محیط دشوار','در نزدیکی ساختمان، درخت یا موانع، کیفیت دید و امکان بازتاب منشور را بررسی کن. از برداشت نقاطی که دید مستقیم یا شرایط اندازه‌گیری مناسبی ندارند بدون ثبت روش جایگزین خودداری کن. نقاط حساس را از دو ایستگاه یا با روش مستقل کنترل کن و محدودیت مشاهده را در توضیحات ثبت کن.'],
 ['۴۹. ارتفاع منشور و ثابت منشور','نوع منشور، ثابت منشور و ارتفاع آن باید با تنظیمات دستگاه و روش اندازه‌گیری سازگار باشد. ارتفاع منشور را در تغییر وضعیت میله دوباره بررسی کن. مقدار اشتباه می‌تواند ارتفاع نقاط را جابه‌جا کند و تنظیم نادرست ثابت منشور می‌تواند روی فاصله اثر بگذارد؛ این تنظیمات را از حافظه حدس نزن.'],
 ['۵۰. کنترل کالیبراسیون و آزمون میدانی','پیش از کار حساس، وضعیت دستگاه، سه‌پایه، شاقول، ترازها، منشور و باتری را بررسی کن. آزمون میدانی می‌تواند خطاهای آشکار را نشان دهد اما جایگزین سرویس و کالیبراسیون رسمی نیست. تاریخ کنترل، دستگاه و نتیجه را ثبت کن و در صورت مشاهده رفتار غیرعادی، کار دقیق را متوقف کن.'],
 ['۵۱. برنامه‌ریزی برداشت GNSS','محدودیت دید آسمان، موانع، سطوح بازتابنده و شرایط محیطی را پیش از انتخاب محل ایستگاه بررسی کن. وضعیت FIX، سن تصحیح، هندسه ماهواره‌ها، ارتفاع آنتن و زمان مشاهده را ثبت کن. برای نقاط کلیدی، برداشت تکراری در زمان یا موقعیت مستقل انجام بده و صرفاً به یک نمایشگر سبز اکتفا نکن.'],
 ['۵۲. GCP و نقاط کنترل مستقل پهپاد','نقاط GCP باید در محدوده و در ارتفاعات/موقعیت‌های متنوع توزیع شوند و در تصاویر قابل تشخیص باشند. Checkpointها را از فرایند تنظیم مدل مستقل نگه دار تا ارزیابی دقت معنی‌دار باشد. تعداد بیشتر نقاط بدون توزیع مناسب یا اندازه‌گیری قابل اعتماد، به‌تنهایی کیفیت محصول را تضمین نمی‌کند.'],
 ['۵۳. مدل رقومی سطح و زمین','DSM معمولاً سطح شامل ساختمان و پوشش گیاهی را نشان می‌دهد؛ DTM برای نمایش زمین برهنه یا سطح زمین پالایش‌شده استفاده می‌شود. DEM اصطلاحی عمومی‌تر است و معنای دقیق آن به پروژه بستگی دارد. هنگام محاسبه حجم، نوع سطح، روش فیلترکردن عوارض و مرز محدوده را مشخص کن.'],
 ['۵۴. محاسبه حجم از مقاطع','در روش میانگین مساحت دو مقطع، حجم تقریبی برابر فاصله دو مقطع ضرب‌در میانگین مساحت آن‌هاست. هرچه تغییرات زمین سریع‌تر باشد، فاصله مقاطع باید با دقت بیشتری انتخاب شود. برای پروژه واقعی، روش محاسبه، سطح مبنا، واحدها و فرضیات را گزارش کن و نتیجه را با روش یا کنترل مستقل بسنج.'],
 ['۵۵. محاسبه حجم سطحی و دپو','حجم دپو به سطح مبنا و شکل واقعی توده وابسته است؛ تقریب هندسی فقط برآورد اولیه می‌دهد. برای محاسبه قابل اتکا، سطح زمین قبل/بعد یا مدل سه‌بعدی معتبر، مرز دپو و روش درون‌یابی لازم است. در گزارش، مقدار را تقریبی معرفی کن و دقت برداشت، تراکم نقاط و محدودیت‌های مدل را ذکر کن.'],
 ['۵۶. انتقال داده بین CSV و CAD','قبل از واردکردن فایل، ترتیب ستون‌ها، جداکننده، اعشار، واحد و سیستم مختصات را بررسی کن. در DXF یا CAD، واحد ترسیم و مبنای مختصات را با داده نقشه‌برداری هماهنگ کن. پس از انتقال، چند نقطه کنترل و یک فاصله شناخته‌شده را بررسی کن تا خطای مقیاس یا جابه‌جایی کشف شود.'],
 ['۵۷. تهیه گزارش فنی قابل دفاع','گزارش باید هدف، تاریخ، محدوده، دستگاه و روش برداشت، سیستم مختصات، نقاط کنترل، معیار پذیرش، نتایج کنترل و محدودیت‌ها را توضیح دهد. داده خام و فایل پردازش‌شده را جدا نگه دار و هر اصلاح یا تعدیل را مستند کن. نتیجه‌ای که روش تولید آن قابل ردیابی نیست، برای کنترل مستقل مناسب نیست.'],
 ['۵۸. سناریوی عملی کارگاه ساختمانی','سناریو: چهار گوشه فونداسیون باید پیاده شود. ابتدا سیستم مختصات و دو نقطه کنترل را بررسی کن؛ ایستگاه را مستقر و توجیه کن؛ مختصات طراحی چهار گوشه را وارد کن؛ هر گوشه را پیاده و اختلاف افقی/قائم را ثبت کن؛ سپس قطرهای مستطیل و مختصات نقاط را مستقل کنترل کن. تنها پس از پذیرش طبق تلرانس پروژه، نتیجه را تحویل بده.'],
 ['۵۹. سناریوی عملی راه‌سازی','سناریو: برداشت محور و مقاطع یک مسیر. کیلومتراژ و محور مرجع را تعریف کن، نقاط شکست و لبه‌ها را با کد ثابت برداشت کن، ترازیابی طولی را به نقاط مبنا ببند، مقاطع عرضی را در محل‌های مناسب بگیر و قبل از محاسبه حجم، پیوستگی خطوط و ارتفاع‌ها را کنترل کن. داده ناقص یا کدگذاری نامنظم را پیش از محاسبه اصلاح کن.'],
 ['۶۰. ارزیابی نهایی پیش از تحویل','پیش از تحویل از خودت بپرس: آیا مبنای افقی و قائم روشن است؟ آیا Station و Orientation کنترل مستقل دارند؟ آیا خطای بست قابل قبول است؟ آیا واحد و ارتفاع دستگاه/منشور درست ثبت شده؟ آیا نقاط پرت و تکراری بررسی شده‌اند؟ آیا فایل خروجی دوباره باز و نمونه‌برداری شده؟ پاسخ هر مورد را در چک‌لیست پروژه ثبت کن.']
 ];
 var intro='<div class="training-tip"><b>🎓 مسیر آموزش نقشه‌برداری</b><br>این بخش از مبانی شروع می‌شود و تا برداشت، ترازیابی، COGO، GNSS، فتوگرامتری، کنترل کیفیت و تحویل پروژه پیش می‌رود. هر درس را کوتاه و مرحله‌ای بخوان و بعد با ابزارهای برنامه تمرین کن.</div>';
 var html=intro; // درس‌ها در همه مسیرهای نمایش، همراه با جست‌وجوی مشترک ارائه می‌شوند.
 html+='<div class="training-search" style="position:sticky;top:0;z-index:5;background:#eef3e8;padding:10px;border:2px solid #596b50;border-radius:10px;margin:10px 0"><label for="surveyLessonSearch" style="display:block;font-weight:900;margin-bottom:6px">🔎 جست‌وجو در عنوان و متن درس‌ها</label><input id="surveyLessonSearch" type="search" placeholder="مثلاً ترازیابی، آزیموت، مختصات، مساحت، GNSS..." oninput="filterSurveyLessons(this.value)" style="width:100%;box-sizing:border-box;padding:12px;border:1px solid #59635a;border-radius:8px;font-size:16px;background:white;color:#172017"><div id="surveyLessonSearchStatus" aria-live="polite" style="padding-top:6px;font-size:13px">همه ۶۰ درس نمایش داده می‌شوند.</div></div><div id="surveyLessonResults">';
 html+=L.map(function(x){return '<div class="training-lesson"><h3>'+x[0]+'</h3><div>'+x[1]+'</div></div>';}).join('');
 html+='</div>'; return html;
}

// جست‌وجوی مقاوم برای WebView اندروید؛ یکسان‌سازی حروف فارسی/عربی و اعداد
function normalizeSurveySearchText(value){
 return String(value==null?'':value)
  .replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[ۀة]/g,'ه')
  .replace(/[أإٱ]/g,'ا').replace(/[۰-۹]/g,function(c){return '۰۱۲۳۴۵۶۷۸۹'.indexOf(c);})
  .replace(/[٠-٩]/g,function(c){return '٠١٢٣٤٥٦٧٨٩'.indexOf(c);})
  .toLowerCase().replace(/\s+/g,' ').trim();
}
function filterSurveyLessons(query){
 var root=document.getElementById('surveyLessonResults');
 var status=document.getElementById('surveyLessonSearchStatus');
 if(!root){console.warn('Survey search: lesson results container not found');return false;}
 if(!status){status=document.createElement('div');status.id='surveyLessonSearchStatus';status.setAttribute('aria-live','polite');root.parentNode.insertBefore(status,root);}
 var q=normalizeSurveySearchText(query);
 var lessons=root.querySelectorAll('.training-lesson');var shown=0;
 for(var i=0;i<lessons.length;i++){
  var text=normalizeSurveySearchText(lessons[i].innerText||lessons[i].textContent);
  var match=!q || text.indexOf(q)!==-1;
  lessons[i].style.display=match?'':'none';
  if(match)shown++;
 }
 status.textContent=q?(shown+' درس از '+lessons.length+' درس پیدا شد.'):('همه '+lessons.length+' درس نمایش داده می‌شوند.');
 return false;
}
function initSurveyLessonSearch(){
 var input=document.getElementById('surveyLessonSearch');
 if(!input || input.dataset.searchBound==='1')return;
 input.dataset.searchBound='1';
 input.addEventListener('input',function(){filterSurveyLessons(input.value);});
 input.addEventListener('search',function(){filterSurveyLessons(input.value);});
}
// Expose the lesson builder for the library button.
window.buildSurveyLessons = buildSurveyLessons;
window.filterSurveyLessons = filterSurveyLessons;
window.initSurveyLessonSearch = initSurveyLessonSearch;

function buildAppLessons(){
 var L=[
 ['۱. Job','ابتدا Job را بساز و نام پروژه را مشخص کن. هر برداشت را در Job درست نگه دار تا داده‌ها قاطی نشوند.'],
 ['۲. Station','مختصات X/Y/Z ایستگاه و HI را وارد و ذخیره کن. تا Setup کامل نباشد، Measure و Stake Out قفل هستند.'],
 ['۳. Orientation','روش توجیه را انتخاب کن؛ با آزیموت یا Backsight مختصاتی. بعد از ثبت، وضعیت توجیه را کنترل کن.'],
 ['۴. Measure','فاصله، آزیموت و ΔZ را وارد کن، DP و شماره نقطه را بررسی کن و سپس نقطه را ذخیره کن.'],
 ['۵. Stake Out','نقطه هدف را انتخاب کن. برنامه فاصله، Turn، Forward/Back، Right/Left و اختلاف ارتفاع را محاسبه می‌کند.'],
 ['۶. Points','لیست نقاط برای مشاهده، ویرایش و حذف داده‌هاست. قبل از پاک‌کردن، در پروژه واقعی نسخه پشتیبان داشته باش.'],
 ['۷. Area / Volume','برای مساحت، پلیگون را با نقاط درست بساز. برای Cut/Fill، ارتفاع‌های موجود و طرح را با واحد یکسان مقایسه کن.'],
 ['۸. Graphic Map','نقشه گرافیکی برای کنترل سریع شکل، جهت و موقعیت نسبی نقاط است و جایگزین کنترل عددی دقیق نیست.'],
 ['۹. Excel','فایل Excel را وارد کن، ستون‌های Point/X/Y/Z/DP را کنترل کن و چند نقطه نمونه را بررسی کن. بعد از Import موفق، خروجی‌ها فعال می‌شوند.'],
 ['۱۰. خروجی‌ها','STANDARD POINT EXPORT، POINT LIST PDF، DXF، KML، CSV و TXT برای انتقال/گزارش داده در اختیار تو هستند.'],
 ['۱۱. Library','برای مطالعه مفاهیم و اصطلاحات نقشه‌برداری از کتابخانه استفاده کن.'],
 ['۱۲. Training / تست','در همین بخش آموزش نقشه‌برداری، ۵۰۰ تست چهارگزینه‌ای و راهنمای کار با MiladGeo قرار دارد.']
 ];
 return '<div class="app-lesson-grid">'+L.map(function(x){return '<div class="app-lesson-card"><b>'+x[0]+'</b>'+x[1]+'</div>';}).join('')+'</div>';
}
function renderQuiz(){
 var body=$("trainingBody"),prog=$("trainingProgress"),base=surveyQuizBank[(quizOrder.length?quizOrder[quizIndex]:quizIndex)],q=base;
 if(!quizCurrentOptions.length||!quizAnswered){var idxs=shuffleArray([0,1,2,3]);quizCurrentOptions=idxs.map(function(i){return base.o[i];});quizCurrentCorrect=idxs.indexOf(base.c);q={q:base.q,o:quizCurrentOptions,c:quizCurrentCorrect,e:base.e,cat:base.cat};}else{q={q:base.q,o:quizCurrentOptions,c:quizCurrentCorrect,e:base.e,cat:base.cat};}
 if(!q||!body)return false;
 if(prog)prog.innerHTML='<div class="result-line"><span>تست</span><b>'+(quizIndex+1)+' / '+surveyQuizBank.length+'</b></div><div class="result-line"><span>دسته</span><b>'+escapeHTML(q.cat)+'</b></div><div class="result-line"><span>امتیاز</span><b id="quizLiveScore">'+quizScore+' / '+quizSeen+'</b></div>';
 var html='<div class="training-panel-head"><button type="button" class="btn gray" onclick="trainingHome();return false;">← منوی ۱۴</button><b>تست چهارگزینه‌ای</b></div>';
 html+='<div class="quiz-question"><div class="quiz-qtitle">'+(quizIndex+1)+') '+escapeHTML(q.q)+'</div>';
 for(var i=0;i<q.o.length;i++) html+='<label class="quiz-option"><input type="radio" name="surveyQuizAnswer" value="'+i+'"> '+String.fromCharCode(65+i)+') '+escapeHTML(q.o[i])+'</label>';
 html+='<button type="button" class="btn primary" onclick="answerQuiz();return false;">✓ ثبت پاسخ</button>';
 if(quizAnswered){html+='<div class="quiz-result">'+(quizLastCorrect?'<div class="quiz-correct">✓ پاسخ صحیح است.</div>':'<div class="quiz-wrong">✗ پاسخ ثبت شد.</div>')+'<div>پاسخ صحیح: <b>'+String.fromCharCode(65+q.c)+') '+escapeHTML(q.o[q.c])+'</b></div><div class="quiz-explain">'+escapeHTML(q.e)+'</div></div>';
 html+='<div class="btn-row" style="margin-top:8px"><button type="button" class="btn" onclick="showQuizReport();return false;">📋 صدور کارنامه</button><button type="button" class="btn primary" onclick="nextQuiz();return false;">تست بعدی →</button></div>';
 }
 html+='</div>'+renderQuizStats();
 body.innerHTML=html; return false;
}
var quizLastCorrect=false;
function answerQuiz(){
 if(quizAnswered)return false;
 var r=document.querySelector('input[name="surveyQuizAnswer"]:checked');
 if(!r){showToast('یک گزینه را انتخاب کن');return false;}
 var base=surveyQuizBank[(quizOrder.length?quizOrder[quizIndex]:quizIndex)],q={q:base.q,o:quizCurrentOptions,c:quizCurrentCorrect,e:base.e,cat:base.cat};quizAnswered=true;quizSeen++;quizLastCorrect=Number(r.value)===q.c;if(quizLastCorrect)quizScore++;quizHistory.push({n:quizSeen,cat:q.cat,q:q.q,selected:Number(r.value),correct:q.c,options:q.o,ok:quizLastCorrect});quizStatsRecordAnswer(quizLastCorrect);renderQuiz();return false;
}
function showQuizReport(){
 var body=$("trainingBody"),prog=$("trainingProgress");
 if(!body)return false;
 if(!quizHistory.length){showToast('حداقل یک تست را پاسخ بده');return false;}
 var pct=Math.round((quizScore/quizSeen)*1000)/10;
 if(prog)prog.innerHTML='<div class="result-line"><span>کارنامه</span><b>'+quizScore+' / '+quizSeen+' — '+pct+'٪</b></div>';
 var html='<div class="training-panel-head"><button type="button" class="btn gray" onclick="renderQuiz();return false;">← بازگشت به آزمون</button><b>📋 کارنامه آزمون نقشه‌برداری</b></div>';
 html+='<div class="quiz-result"><div><b>MILADGEO — کارنامه آزمون</b></div><div>تعداد پاسخ‌ها: <b>'+quizSeen+'</b></div><div>صحیح: <b class="quiz-correct">'+quizScore+'</b> &nbsp; غلط: <b class="quiz-wrong">'+(quizSeen-quizScore)+'</b></div><div>درصد: <b>'+pct+'٪</b></div></div>';
 html+='<div class="training-lesson" style="margin-top:8px"><b>جزئیات پاسخ‌ها</b>';
 quizHistory.forEach(function(h){html+='<div class="training-step"><b>'+h.n+'. '+escapeHTML(h.cat)+'</b><br>'+escapeHTML(h.q)+'<br>پاسخ شما: '+escapeHTML(String.fromCharCode(65+h.selected)+') '+h.options[h.selected])+'<br><span class="'+(h.ok?'quiz-correct':'quiz-wrong')+'">'+(h.ok?'✓ صحیح':'✗ غلط')+'</span> — پاسخ صحیح: '+escapeHTML(String.fromCharCode(65+h.correct)+') '+h.options[h.correct])+'</div>';});
 html+='</div><div class="btn-row" style="margin-top:10px"><button type="button" class="btn primary" onclick="printQuizReport();return false;">🖨 چاپ / ذخیره PDF</button></div>';body.innerHTML=html;return false;
}
function quizReportText(){
 var pct=Math.round((quizScore/quizSeen)*1000)/10,lines=[];
 lines.push('MILADGEO - SURVEYING QUIZ REPORT');lines.push('Answers: '+quizSeen);lines.push('Correct: '+quizScore);lines.push('Wrong: '+(quizSeen-quizScore));lines.push('Score: '+pct+'%');lines.push('');
 quizHistory.forEach(function(h){lines.push(h.n+'. '+h.cat);lines.push('Q: '+h.q);lines.push('Your answer: '+String.fromCharCode(65+h.selected)+') '+h.options[h.selected]);lines.push('Correct answer: '+String.fromCharCode(65+h.correct)+') '+h.options[h.correct]);lines.push('Result: '+(h.ok?'CORRECT':'WRONG'));lines.push('');});return lines.join('\n');
}
function printQuizReport(){
 var old=$("quizReportLayer"),stOld=$("quizReportStyle");if(old)old.remove();if(stOld)stOld.remove();
 var layer=document.createElement('div'),st=document.createElement('style');layer.id='quizReportLayer';st.id='quizReportStyle';
 st.textContent='@media print{body>*:not(#quizReportLayer){display:none!important}#quizReportLayer{display:block!important;position:static!important;background:#fff!important;color:#111!important;padding:12mm!important;font-family:Arial,sans-serif!important}#quizReportLayer .report-actions{display:none!important}#quizReportLayer table{width:100%;border-collapse:collapse}#quizReportLayer th,#quizReportLayer td{border:1px solid #555;padding:5px;font-size:9px;text-align:center}}@media screen{#quizReportLayer{position:fixed;inset:0;z-index:1000001;overflow:auto;background:#fff;color:#111;padding:18px;font-family:Arial,sans-serif}#quizReportLayer .report-wrap{max-width:1000px;margin:20px auto}#quizReportLayer table{width:100%;border-collapse:collapse}#quizReportLayer th,#quizReportLayer td{border:1px solid #777;padding:6px;font-size:11px;text-align:center}#quizReportLayer .report-actions{position:sticky;top:0;background:#fff;padding:8px 0;display:flex;gap:8px;flex-wrap:wrap}#quizReportLayer button{padding:10px 14px;border:1px solid #555;border-radius:8px;background:#e8eee8}}';
 document.head.appendChild(st);document.body.appendChild(layer);
 var pct=quizSeen?Math.round((quizScore/quizSeen)*1000)/10:0,html='<div class="report-wrap"><div class="report-actions"><button type="button" id="qrClose">بستن</button></div><h2>MILADGEO — '+(quizMode==='eng'?'کارنامه آزمون نظام مهندسی':'کارنامه آزمون نقشه‌برداری')+'</h2><p>تعداد پاسخ‌ها: <b>'+quizSeen+'</b> | صحیح: <b>'+quizScore+'</b> | غلط: <b>'+(quizSeen-quizScore)+'</b> | بی‌پاسخ: <b>'+(quizMode==='eng'?Math.max(0,engExamCount-quizSeen):0)+'</b> | درصد: <b>'+pct+'٪</b></p><table><thead><tr><th>ردیف</th><th>موضوع</th><th>سؤال</th><th>پاسخ شما</th><th>پاسخ صحیح</th><th>نتیجه</th></tr></thead><tbody>';
 quizHistory.forEach(function(h){html+='<tr><td>'+h.n+'</td><td>'+escapeHTML(h.cat)+'</td><td>'+escapeHTML(h.q)+'</td><td>'+escapeHTML(String.fromCharCode(65+h.selected)+') '+h.options[h.selected])+'</td><td>'+escapeHTML(String.fromCharCode(65+h.correct)+') '+h.options[h.correct])+'</td><td>'+(h.ok?'✓ صحیح':'✗ غلط')+'</td></tr>';});
 html+='</tbody></table><div class="report-actions" style="margin-top:14px"><button type="button" id="qrSave">🖨 چاپ / ذخیره PDF</button></div></div>';layer.innerHTML=html;
 $("qrSave").onclick=function(){
   window.focus();
   try{window.print();}catch(e){downloadQuizReportHTML();}
   return false;
 };
 var extra=document.createElement('button');extra.type='button';extra.textContent='⬇ دانلود کارنامه';extra.onclick=function(){downloadQuizReportHTML();return false;};
 $("qrSave").parentNode.appendChild(extra);
 $("qrClose").onclick=function(){layer.remove();st.remove();};
 window.addEventListener('afterprint',function(){if(layer.parentNode){layer.remove();st.remove();}},{once:true});return false;
}
function downloadQuizReportHTML(){
 if(!quizHistory.length){showToast('حداقل یک تست را پاسخ بده');return false;}
 var pct=Math.round((quizScore/quizSeen)*1000)/10,html='<!doctype html><html lang="fa" dir="rtl"><meta charset="utf-8"><title>کارنامه MiladGeo</title><style>body{font-family:Tahoma,Arial,sans-serif;padding:24px;color:#111}h1{font-size:22px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #777;padding:7px;font-size:12px}th{background:#e8ece6}@media print{button{display:none}}</style><h1>MiladGeo — کارنامه آزمون</h1><p>تعداد پاسخ‌ها: <b>'+quizSeen+'</b> | صحیح: <b>'+quizScore+'</b> | غلط: <b>'+(quizSeen-quizScore)+'</b> | بی‌پاسخ: <b>'+(quizMode==='eng'?Math.max(0,engExamCount-quizSeen):0)+'</b> | درصد: <b>'+pct+'٪</b></p><table><thead><tr><th>ردیف</th><th>موضوع</th><th>سؤال</th><th>پاسخ شما</th><th>پاسخ صحیح</th><th>نتیجه</th></tr></thead><tbody>';
 quizHistory.forEach(function(h){html+='<tr><td>'+h.n+'</td><td>'+escapeHTML(h.cat)+'</td><td>'+escapeHTML(h.q)+'</td><td>'+escapeHTML(String.fromCharCode(65+h.selected)+') '+h.options[h.selected])+'</td><td>'+escapeHTML(String.fromCharCode(65+h.correct)+') '+h.options[h.correct])+'</td><td>'+(h.ok?'✓ صحیح':'✗ غلط')+'</td></tr>';});
 html+='</tbody></table></html>';saveBlobFile('MILADGEO_Quiz_Report_'+quizSeen+'.html',new Blob([html],{type:'text/html;charset=utf-8'}));showToast('کارنامه دانلود شد ✓');return false;
}
function downloadQuizReportPDF(){
 if(!quizHistory.length){showToast('حداقل یک تست را پاسخ بده');return false;}
 try{var pageW=595,pageH=842,margin=32,rowH=42,rowsPerPage=Math.max(1,Math.floor((pageH-margin*2-105)/rowH)),pages=Math.ceil(quizHistory.length/rowsPerPage),all=[];all[1]='';all[2]='<< /Producer (MiladGeo) /Title (Surveying Quiz Report) >>';all[3]='<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>';all[4]='<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>';var pageNums=[];
 function esc(v){return pdfEsc(String(v==null?'':v).replace(/\s+/g,' ').slice(0,90));}
 for(var pg=0;pg<pages;pg++){var from=pg*rowsPerPage,to=Math.min(quizHistory.length,from+rowsPerPage),st='';function t(x,y,size,str,font){st+='BT /'+(font||'F1')+' '+size+' Tf '+x+' '+y+' Td ('+esc(str)+') Tj ET\n';}t(margin,pageH-margin-14,15,'MILADGEO - SURVEYING QUIZ REPORT','F2');t(margin,pageH-margin-32,9,'پاسخ‌ها: '+quizSeen+'   صحیح: '+quizScore+'   غلط: '+(quizSeen-quizScore)+'   درصد: '+(Math.round((quizScore/quizSeen)*1000)/10)+'٪');var y=pageH-margin-62;t(margin,y,8,'ردیف');t(margin+30,y,8,'موضوع');t(margin+125,y,8,'سؤال');t(margin+390,y,8,'پاسخ شما');t(margin+440,y,8,'پاسخ صحیح');t(margin+480,y,8,'نتیجه');y-=18;for(var i=from;i<to;i++){var h=quizHistory[i];t(margin,y,7,String(h.n));t(margin+30,y,7,h.cat);t(margin+125,y,7,h.q);t(margin+390,y,7,String.fromCharCode(65+h.selected));t(margin+440,y,7,String.fromCharCode(65+h.correct));t(margin+480,y,7,h.ok?'✓ صحیح':'✗ غلط');y-=rowH;}var cn=all.length;all.push('<< /Length '+st.length+' >>\nstream\n'+st+'endstream');var pn=all.length;all.push('<< /Type /Page /Parent 1 0 R /MediaBox [0 0 '+pageW+' '+pageH+'] /Resources << /Font << /F1 3 0 R /F2 4 0 R >> >> /Contents '+cn+' 0 R >>');pageNums.push(pn);}all[1]='<< /Type /Pages /Kids ['+pageNums.map(function(n){return n+' 0 R';}).join(' ')+'] /Count '+pageNums.length+' >>';var root=all.length;all.push('<< /Type /Catalog /Pages 1 0 R >>');var pdf='%PDF-1.4\n',offs=[0];for(var oi=1;oi<all.length;oi++){offs[oi]=pdf.length;pdf+=oi+' 0 obj\n'+all[oi]+'\nendobj\n';}var xref=pdf.length;pdf+='xref\n0 '+all.length+'\n0000000000 65535 f \n';for(var oi2=1;oi2<all.length;oi2++)pdf+=String(offs[oi2]).padStart(10,'0')+' 00000 n \n';pdf+='trailer\n<< /Size '+all.length+' /Root '+root+' 0 R /Info 2 0 R >>\nstartxref\n'+xref+'\n%%EOF';saveBlobFile('MILADGEO_Quiz_Report_'+quizSeen+'.pdf',new Blob([pdf],{type:'application/pdf'}));showToast('کارنامه PDF آماده شد ✓');}catch(e){console.error('QUIZ_REPORT_PDF',e);showToast('ساخت PDF ناموفق بود؛ از چاپ / ذخیره PDF استفاده کن');}return false;
}
function nextQuiz(){
 if(quizIndex<surveyQuizBank.length-1){quizIndex++;quizAnswered=false;quizCurrentOptions=[];renderQuiz();}
 else{quizStatsSaveSession();var body=$("trainingBody");if(body)body.innerHTML='<div class="quiz-score">🎉 همه ۵۰۰ تست این آزمون تمام شد.<br>امتیاز نهایی: '+quizScore+' / '+quizSeen+'</div><button type="button" class="btn primary" onclick="showQuizReport();return false;">📋 صدور کارنامه / پی‌دی‌اف</button><button type="button" class="btn gray" onclick="openTrainingMode(\'surveyQuiz\');return false;">آزمون جدید و تصادفی</button><button type="button" class="btn primary" onclick="trainingHome();return false;">بازگشت به منوی ۱۴</button>'+renderQuizStats(); }
 return false;
}
function startTraining(){return openTrainingMode('surveyLearn');}
function trainingNext(){return nextQuiz();}
function trainingPrev(){return trainingHome();}
function saveBlobLikeMenu17(name,blob){
 try{
  if(window.AndroidBridge&&typeof window.AndroidBridge.saveFile==='function'&&typeof directSaveBlob==='function')return directSaveBlob(name,blob);
  if(window.miladgeoNative&&typeof window.miladgeoNative.saveFile==='function'&&typeof directSaveBlob==='function')return directSaveBlob(name,blob);
 }catch(e){console.error('Menu17-style export bridge failed',e);}
 return saveBlobFile(name,blob);
}
function directSaveBlob(name,blob){
 name=String(name||'MILADGEO_EXPORT.bin').replace(/[\\/:*?"<>|]+/g,'_');
 try{
  if(window.AndroidBridge&&typeof window.AndroidBridge.saveFile==='function'&&blob){
   showToast('⏳ آماده‌سازی فایل...');
   var readPromise=(typeof blob.arrayBuffer==='function')
     ? blob.arrayBuffer()
     : new Promise(function(resolve,reject){try{var fr=new FileReader();fr.onload=function(){resolve(fr.result);};fr.onerror=reject;fr.readAsArrayBuffer(blob);}catch(e){reject(e);}});
   readPromise.then(function(buf){
     var bytes=new Uint8Array(buf), binary='', chunk=0x8000;
     for(var i=0;i<bytes.length;i+=chunk){binary+=String.fromCharCode.apply(null,bytes.subarray(i,Math.min(i+chunk,bytes.length)));}
     var base64=btoa(binary);
     return window.AndroidBridge.saveFile(name, blob.type||'application/octet-stream', base64);
   }).then(function(ok){
     if(ok!==false)showToast('✓ File saved: '+name);
     else showToast('Export cancelled');
   }).catch(function(e){
     console.error('Android save failed',e);
     browserSaveBlob(name,blob,false);
   });
   return true;
  }
  if(window.miladgeoNative&&typeof window.miladgeoNative.saveFile==='function'&&blob){
   showToast('⏳ آماده‌سازی فایل...');
   var readPromise2=(typeof blob.arrayBuffer==='function')
     ? blob.arrayBuffer()
     : new Promise(function(resolve,reject){try{var fr2=new FileReader();fr2.onload=function(){resolve(fr2.result);};fr2.onerror=reject;fr2.readAsArrayBuffer(blob);}catch(e){reject(e);}});
   readPromise2.then(function(buf){
     var bytes=Array.from(new Uint8Array(buf));
     return window.miladgeoNative.saveFile({name:name,bytes:bytes});
   }).then(function(ok){
     if(ok)showToast('✓ File saved: '+name);
     else showToast('Export cancelled');
   }).catch(function(e){
     console.error('Native save failed',e);
     browserSaveBlob(name,blob,false);
   });
   return true;
  }
  var url=URL.createObjectURL(blob),a=document.createElement('a');
  a.href=url;a.download=name;a.rel='noopener';a.style.display='none';
  document.body.appendChild(a);a.click();
  setTimeout(function(){try{a.remove();}catch(e){}try{URL.revokeObjectURL(url);}catch(e){}},15000);
  showToast('✓ '+name+' آماده شد');
  return true;
 }catch(e){console.error('Export failed',e);showToast('Export failed');return false;}
}
/* Public export bridge for isolated Menu 17 runtime.
   Menu 17 lives in a separate IIFE, so it cannot see the private export helpers above. */
window.miladgeoDirectSaveBlob=directSaveBlob;
window.miladgeoExportBlob=saveBlobFile;
function downloadText(filename,content,type){return saveBlobFile(filename,new Blob([content],{type:type||'text/plain;charset=utf-8'}));}
function exportSelected(){
 if(!job.name){showToast('Set Job first');return false;}
 if(!points.length){showToast('No points to export');return false;}
 var fmtv=$("exportFormat")?$("exportFormat").value:'csv';
 if(fmtv==='csv')return exportCSV();
 if(fmtv==='txt')return exportTXT();
 if(fmtv==='kml')return exportKML();
 if(fmtv==='kmz')return exportKMZ();
 if(fmtv==='dxf')return exportDXF();
 if(fmtv==='landxml')return exportLandXML();
 if(fmtv==='json')return exportJSON();
 if(fmtv==='code')return exportCodeTXT();
 return false;
}
function exportJobSelected(){
 if(!job.name){showToast('Set Job first');return false;}
 if(!points.length){showToast('No points to export');return false;}
 var fmtv=$("jobExportFormat")?$("jobExportFormat").value:'csv';
 if(fmtv==='csv')return exportCSV();
 if(fmtv==='txt')return exportTXT();
 if(fmtv==='kml')return exportKML();
 if(fmtv==='kmz')return exportKMZ();
 if(fmtv==='dxf')return exportDXF();
 if(fmtv==='landxml')return exportLandXML();
 if(fmtv==='json')return exportJSON();
 if(fmtv==='code')return exportCodeTXT();
 return false;
}
function exportCSV(){
 var csv='Point,DP,X,Y,Z,Distance,Azimuth\n',i,p;
 for(i=0;i<points.length;i++){p=points[i];csv+='"'+csvSafe(p.no)+'","'+csvSafe(p.dp||'')+'",'+p.x+','+p.y+','+p.z+','+(p.distance==null?'':p.distance)+','+(p.azimuth==null?'':p.azimuth)+(i===points.length-1?'':'\n');}
 saveBlobLikeMenu17(sanitizeFileName(job.name)+'_POINTS.csv',new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));return false;
}
function exportTXT(){
 var txt='JOB\t'+job.name+'\nPOINT\tDP\tX\tY\tZ\tDISTANCE\tAZIMUTH\n',i,p;
 for(i=0;i<points.length;i++){p=points[i];txt+=String(p.no||'')+'\t'+String(p.dp||'')+'\t'+p.x+'\t'+p.y+'\t'+p.z+'\t'+(p.distance==null?'':p.distance)+'\t'+(p.azimuth==null?'':p.azimuth)+'\n';}
 saveBlobLikeMenu17(sanitizeFileName(job.name)+'_POINTS.txt',new Blob([txt],{type:'text/plain;charset=utf-8'}));return false;
}
function xmlSafe(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;');}
function exportKML(){
 if(!points.length){showToast('No points to export');return false;}
 var usable=[],bad=0,i,p;
 for(i=0;i<points.length;i++){
   p=points[i];
   var x=Number(p.x),y=Number(p.y),z=Number(p.z)||0;
   if(!isFinite(x)||!isFinite(y)){bad++;continue;}
   usable.push({no:p.no,dp:p.dp||'',x:x,y:y,z:z});
 }
 if(!usable.length){showToast('No valid coordinate points');return false;}
 var geographic=true;
 for(i=0;i<usable.length;i++){
   if(Math.abs(usable[i].x)>180||Math.abs(usable[i].y)>90){geographic=false;break;}
 }
 var geoPts=[];
 if(geographic){
   for(i=0;i<usable.length;i++)geoPts.push(usable[i]);
 }else{
   var zone=window.prompt('مختصات بزرگ هستند و احتمالاً UTM هستند.\\nشماره زون UTM را وارد کنید (مثلاً 39):','39');
   if(zone===null)return false;
   zone=parseInt(zone,10);
   if(!isFinite(zone)||zone<1||zone>60){showToast('UTM Zone must be 1–60');return false;}
   var northern=window.confirm('آیا مختصات در نیمکره شمالی است؟\\nOK = شمالی / Cancel = جنوبی');
   var converted=[],skipped=0;
   for(i=0;i<usable.length;i++){
     var xx=usable[i].x,yy=usable[i].y;
     var e=xx,n=yy;
     if(!(e>=100000&&e<=900000&&n>=0&&n<=10000000)){
       if(yy>=100000&&yy<=900000&&xx>=0&&xx<=10000000){e=yy;n=xx;}
       else{skipped++;continue;}
     }
     var ll=utmToLatLon(e,n,zone,northern);
     if(!isFinite(ll.lat)||!isFinite(ll.lon)){skipped++;continue;}
     converted.push({no:usable[i].no,dp:usable[i].dp,x:ll.lon,y:ll.lat,z:usable[i].z});
   }
   if(!converted.length){showToast('No valid UTM points — check X/Y columns');return false;}
   geoPts=converted;
   bad+=skipped;
 }
 var k='<?xml version="1.0" encoding="UTF-8"?>\n<kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>'+xmlSafe(job.name)+'</name>\n';
 for(i=0;i<geoPts.length;i++){p=geoPts[i];k+='<Placemark><name>'+xmlSafe(p.no)+'</name><description>'+xmlSafe(p.dp)+'</description><Point><coordinates>'+p.x.toFixed(8)+','+p.y.toFixed(8)+','+p.z+'</coordinates></Point></Placemark>\n';}
 k+='</Document></kml>';
 var kmlBlob=new Blob([k],{type:'application/vnd.google-earth.kml+xml;charset=utf-8'}); if(isTelegramMiniApp())saveBlobFile(sanitizeFileName(job.name)+'_POINTS.kml',kmlBlob); else directSaveBlob(sanitizeFileName(job.name)+'_POINTS.kml',kmlBlob);
 showToast('KML آماده شد ✓'+(bad?' — '+bad+' point skipped':''));return false;
}
function dxfNum(v){return Number(v).toFixed(6);}
function exportDXF(){
 var d='0\nSECTION\n2\nHEADER\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n',i,p;
 for(i=0;i<points.length;i++){p=points[i];
  d+='0\nPOINT\n8\nPOINTS\n10\n'+dxfNum(p.x)+'\n20\n'+dxfNum(p.y)+'\n30\n'+dxfNum(p.z)+'\n';
  d+='0\nTEXT\n8\nPOINT_LABELS\n10\n'+dxfNum(p.x)+'\n20\n'+dxfNum(p.y)+'\n30\n'+dxfNum(p.z)+'\n40\n2.5\n1\n'+String(p.no||'').replace(/\r?\n/g,' ')+'\n';
 }
 d+='0\nENDSEC\n0\nEOF\n';
 saveBlobLikeMenu17(sanitizeFileName(job.name)+'_POINTS.dxf',new Blob([d],{type:'application/dxf;charset=utf-8'}));return false;
}
function gsi16DataWord(wi,info,sign,value){
 var raw=String(value==null?'':value);
 raw=raw.slice(0,16).padStart(16,'0');
 return '*'+String(wi).padStart(2,'0')+String(info==null?'00':info).padStart(4,'0')+String(sign||'+').slice(0,1)+raw;
}
function gsi16Scaled(v){
 var n=Number(v);
 if(!isFinite(n))return null;
 var scaled=Math.round(n*1000);
 var sign=scaled<0?'-':'+';
 var abs=Math.abs(scaled).toString();
 if(abs.length>16)return null;
 return {sign:sign,data:abs.padStart(16,'0')};
}
function gsi16PointId(v){
 var raw=String(v==null?'':v).trim();
 if(!raw)raw='0';
 raw=raw.replace(/\s+/g,'_').slice(0,16);
 return raw.padStart(16,'0');
}
// Leica GSI exporter adapted from the tested GSI converter in indexv40.html.
// JOB points are mapped to E/N/Z and exported as Leica fixed-coordinate records.
function mg180GsiField(wi,val,width,info,sign){
 var raw=String(val==null?'':val).replace(/[\r\n]/g,' ').slice(0,width).padStart(width,'0');
 return String(wi).padStart(2,'0')+String(info||'....').padEnd(4,'.').slice(0,4)+(sign||'+')+raw;
}
function mg180GsiCoordWord(wi,v,width){
 var n=Number(v);if(!isFinite(n))throw new Error('مختصات نامعتبر است (WI '+wi+')');
 var scaled=Math.round(Math.abs(n)*1000),data=String(scaled);
 if(data.length>width)throw new Error('مختصات برای '+(width===8?'GSI-8':'GSI-16')+' بزرگ است (WI '+wi+')');
 return String(wi).padStart(2,'0')+'....'+(n<0?'-':'+')+data.padStart(width,'0');
}
function mg180GsiFixedOpWord(width,blockNo){return '410'+String(blockNo).padStart(3,'0')+'+'+'9'.padStart(width,'0');}
function exportJobLeicaGSI(format){
 try{
  if(!job||!job.name){showToast('ابتدا JOB را فعال کن');return false;}
  if(!Array.isArray(points)||!points.length){showToast('نقطه‌ای برای خروجی وجود ندارد');return false;}
  var width=format==='GSI-8'?8:16,lines=[],valid=0;
  for(var i=0;i<points.length;i++){
   var p=points[i]||{},x=Number(p.x),y=Number(p.y),z=Number(p.z);
   if(!isFinite(x)||!isFinite(y)||!isFinite(z))continue;
   var id=String(p.no==null?'':p.no).trim()||String(i+1);
   // Match the tested Leica converter's control-point mask: 410 operation 9,
   // WI 42 point identifier, followed by WI 43/44/45 fixed E/N/Z coordinates.
   var words=[mg180GsiFixedOpWord(width,valid+1),mg180GsiField(42,id,width,'....','+'),
    mg180GsiCoordWord(43,x,width),mg180GsiCoordWord(44,y,width),mg180GsiCoordWord(45,z,width)];
   lines.push((width===16?'*':'')+words.join(' '));valid++;
  }
  if(!lines.length){showToast('هیچ نقطه معتبر برای خروجی GSI وجود ندارد');return false;}
  var ext=format==='GSI-8'?'GSI8':'GSI16';
  var filename=sanitizeFileName(job.name)+'_'+ext+'_CONTROL.gsi';
  saveBlobLikeMenu17(filename,new Blob([lines.join('\r\n')+'\r\n'],{type:'text/plain;charset=us-ascii'}));
  showToast('✓ خروجی Leica '+format+' آماده شد · '+valid+' نقطه');
 }catch(e){console.error('JOB_LEICA_GSI_EXPORT',e);showToast(e&&e.message?e.message:'ساخت فایل GSI ناموفق بود');}
 return false;
}

function exportSandingGSI(){
 if(!job||!job.name){showToast('ابتدا JOB را فعال کن');return false;}
 if(!Array.isArray(points)||!points.length){showToast('نقطه‌ای برای خروجی وجود ندارد');return false;}
 var lines=[],i,p,x,y,z,sx,sy,sz;
 for(i=0;i<points.length;i++){
   p=points[i]||{}; x=Number(p.x); y=Number(p.y); z=Number(p.z||0);
   if(!isFinite(x)||!isFinite(y)||!isFinite(z))continue;
   sx=gsi16Scaled(x); sy=gsi16Scaled(y); sz=gsi16Scaled(z);
   if(!sx||!sy||!sz){showToast('مختصات نقطه '+String(p.no||i+1)+' برای GSI16 بزرگ است');return false;}
   lines.push(gsi16DataWord('11','0001','+',gsi16PointId(p.no))+' '+
              gsi16DataWord('81','..00',sx.sign,sx.data)+' '+
              gsi16DataWord('82','..00',sy.sign,sy.data)+' '+
              gsi16DataWord('83','..00',sz.sign,sz.data));
 }
 if(!lines.length){showToast('نقطه معتبر برای GSI پیدا نشد');return false;}
 var name=sanitizeFileName(job.name)+'_SANDING_GSI.txt';
 saveBlobLikeMenu17(name,new Blob([lines.join('\r\n')+'\r\n'],{type:'text/plain;charset=ascii'}));
 showToast('✓ Sanding GSI آماده شد');
 return false;
}
function showPlannedTotalStationFormat(name){
 showToast(String(name)+' — فرمت به‌زودی عملیاتی می‌شود');
 return false;
}
function exportLeicaGSI16(){
 if(!job||!job.name){showToast('ابتدا JOB را فعال کن');return false;}
 if(!Array.isArray(points)||!points.length){showToast('نقطه‌ای برای خروجی وجود ندارد');return false;}
 var lines=[],i,p,x,y,z,sx,sy,sz;
 for(i=0;i<points.length;i++){
   p=points[i]||{};
   x=Number(p.x); y=Number(p.y); z=Number(p.z||0);
   if(!isFinite(x)||!isFinite(y)||!isFinite(z))continue;
   sx=gsi16Scaled(x); sy=gsi16Scaled(y); sz=gsi16Scaled(z);
   if(!sx||!sy||!sz){showToast('مختصات نقطه '+String(p.no||i+1)+' برای GSI16 بزرگ است');return false;}
   lines.push(gsi16DataWord('11','0001','+',gsi16PointId(p.no))+' '+
              gsi16DataWord('81','..00',sx.sign,sx.data)+' '+
              gsi16DataWord('82','..00',sy.sign,sy.data)+' '+
              gsi16DataWord('83','..00',sz.sign,sz.data));
 }
 if(!lines.length){showToast('نقطه معتبر برای GSI16 پیدا نشد');return false;}
 var name=sanitizeFileName(job.name)+'_GSI16.gsi';
 var blob=new Blob([lines.join('\r\n')+'\r\n'],{type:'text/plain;charset=ascii'});
 saveBlobLikeMenu17(name,blob);
 showToast('✓ Leica GSI16 آماده شد');
 return false;
}
function exportLandXML(){
 var x='<?xml version="1.0" encoding="UTF-8"?>\n<LandXML version="1.2" date="'+new Date().toISOString().slice(0,10)+'" time="'+new Date().toTimeString().slice(0,8)+'" xmlns="http://www.landxml.org/schema/LandXML-1.2" language="English" readOnly="false"><Project name="'+xmlSafe(job.name)+'"/><CgPoints>\n',i,p;
 for(i=0;i<points.length;i++){p=points[i];x+='<CgPoint name="'+xmlSafe(p.no)+'" oID="'+xmlSafe(p.no)+'" desc="'+xmlSafe(p.dp||'')+'">'+p.y+' '+p.x+' '+p.z+'</CgPoint>\n';}
 x+='</CgPoints></LandXML>';
 saveBlobLikeMenu17(sanitizeFileName(job.name)+'_POINTS.xml',new Blob([x],{type:'application/xml;charset=utf-8'}));return false;
}
function crc32(bytes){
 var table=crc32.table,crc=0xFFFFFFFF,i,j;
 if(!table){table=[];for(i=0;i<256;i++){var c=i;for(j=0;j<8;j++)c=(c&1)?(0xEDB88320^(c>>>1)):(c>>>1);table[i]=c>>>0;}crc32.table=table;}
 for(i=0;i<bytes.length;i++)crc=(table[(crc^bytes[i])&255]^(crc>>>8))>>>0;
 return (crc^0xFFFFFFFF)>>>0;
}
function putU16(a,o,v){a[o]=v&255;a[o+1]=(v>>>8)&255;}
function putU32(a,o,v){a[o]=v&255;a[o+1]=(v>>>8)&255;a[o+2]=(v>>>16)&255;a[o+3]=(v>>>24)&255;}
function makeKMZ(kml){
 var enc=new TextEncoder(),data=enc.encode(kml),name=enc.encode('doc.kml'),crc=crc32(data),n=data.length,total=30+name.length+n+46+name.length+22;
 var out=new Uint8Array(total),o=0;
 // Local file header
 putU32(out,o,0x04034b50);putU16(out,o+4,20);putU16(out,o+6,0);putU16(out,o+8,0);putU16(out,o+10,0);putU16(out,o+12,0);putU32(out,o+14,crc);putU32(out,o+18,n);putU32(out,o+22,n);putU16(out,o+26,name.length);putU16(out,o+28,0);o+=30;out.set(name,o);o+=name.length;out.set(data,o);o+=n;
 // Central directory
 var cd=o;putU32(out,o,0x02014b50);putU16(out,o+4,20);putU16(out,o+6,20);putU16(out,o+8,0);putU16(out,o+10,0);putU16(out,o+12,0);putU16(out,o+14,0);putU32(out,o+16,crc);putU32(out,o+20,n);putU32(out,o+24,n);putU16(out,o+28,name.length);putU16(out,o+30,0);putU16(out,o+32,0);putU16(out,o+34,0);putU16(out,o+36,0);putU32(out,o+38,0);putU32(out,o+42,0);o+=46;out.set(name,o);o+=name.length;
 // End of central directory
 putU32(out,o,0x06054b50);putU16(out,o+4,0);putU16(out,o+6,0);putU16(out,o+8,1);putU16(out,o+10,1);putU32(out,o+12,name.length+46);putU32(out,o+16,cd);putU16(out,o+20,0);
 return out;
}
function exportKMZ(){
 if(!points.length){showToast('No points to export');return false;}
 /* KMZ uses the same coordinate logic as KML: geographic stays as-is; UTM is converted. */
 var usable=[],i,p,bad=0;
 for(i=0;i<points.length;i++){p=points[i];var x=Number(p.x),y=Number(p.y);if(isFinite(x)&&isFinite(y))usable.push({no:p.no,dp:p.dp||'',x:x,y:y,z:Number(p.z)||0});else bad++;}
 if(!usable.length){showToast('No valid coordinate points');return false;}
 var geographic=true;for(i=0;i<usable.length;i++){if(Math.abs(usable[i].x)>180||Math.abs(usable[i].y)>90){geographic=false;break;}}
 var geoPts=[];
 if(geographic) geoPts=usable;
 else{
   var zone=window.prompt('مختصات بزرگ هستند و احتمالاً UTM هستند.\\nشماره زون UTM را وارد کنید (مثلاً 39):','39');if(zone===null)return false;zone=parseInt(zone,10);if(!isFinite(zone)||zone<1||zone>60){showToast('UTM Zone must be 1–60');return false;}
   var northern=window.confirm('آیا مختصات در نیمکره شمالی است؟\\nOK = شمالی / Cancel = جنوبی');
   for(i=0;i<usable.length;i++){var xx=usable[i].x,yy=usable[i].y,e=xx,n=yy;if(!(e>=100000&&e<=900000&&n>=0&&n<=10000000)){if(yy>=100000&&yy<=900000&&xx>=0&&xx<=10000000){e=yy;n=xx;}else{bad++;continue;}}var ll=utmToLatLon(e,n,zone,northern);if(isFinite(ll.lat)&&isFinite(ll.lon))geoPts.push({no:usable[i].no,dp:usable[i].dp,x:ll.lon,y:ll.lat,z:usable[i].z});else bad++;}
 }
 if(!geoPts.length){showToast('No valid points for KMZ');return false;}
 var k='<?xml version="1.0" encoding="UTF-8"?>\n<kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>'+xmlSafe(job.name)+'</name>\n';
 for(i=0;i<geoPts.length;i++){p=geoPts[i];k+='<Placemark><name>'+xmlSafe(p.no)+'</name><description>'+xmlSafe(p.dp)+'</description><Point><coordinates>'+p.x.toFixed(8)+','+p.y.toFixed(8)+','+p.z+'</coordinates></Point></Placemark>\n';}
 k+='</Document></kml>';
 if(typeof TextEncoder==='undefined'){showToast('KMZ not supported here — use KML');return false;}
 var bytes=makeKMZ(k),blob=new Blob([bytes],{type:'application/vnd.google-earth.kmz'});if(isTelegramMiniApp())saveBlobFile(sanitizeFileName(job.name)+'_POINTS.kmz',blob);else directSaveBlob(sanitizeFileName(job.name)+'_POINTS.kmz',blob);showToast('KMZ آماده شد ✓'+(bad?' — '+bad+' point skipped':''));return false;
}
function exportCodeTXT(){
 var txt='POINT\tDP\tX\tY\tZ\n',i,p;
 for(i=0;i<points.length;i++){p=points[i];txt+=String(p.no||'')+'\t'+String(p.dp||'')+'\t'+p.x+'\t'+p.y+'\t'+p.z+'\n';}
 saveBlobLikeMenu17(sanitizeFileName(job.name)+'_POINT_CODE.txt',new Blob([txt],{type:'text/plain;charset=utf-8'}));return false;
}
function exportJSON(){
 var payload={job:job,station:setup,points:points};
 saveBlobLikeMenu17(sanitizeFileName(job.name)+'_POINTS.json',new Blob([JSON.stringify(payload,null,2)],{type:'application/json;charset=utf-8'}));return false;
}

/* ===== V5 POINT TEXT IMPORT / FIELD EXPORT ===== */
var v5ImportText='';
var v5ImportedFileKeys={};
function v10HashText(text){var h=2166136261>>>0,i,c;for(i=0;i<text.length;i++){c=text.charCodeAt(i);h^=c;h=Math.imul(h,16777619)>>>0;}return ('00000000'+h.toString(16)).slice(-8);}
function v10ImportRegistryKey(){return v10HashText(String(v5ImportText||''));}
function v10LoadImportRegistry(){try{var raw=sessionStorage.getItem('miladgeo_v5_imported_files_'+JOB_KEY);if(raw){var a=JSON.parse(raw);if(a&&typeof a==='object')v5ImportedFileKeys=a;}}catch(e){v5ImportedFileKeys={};}}
function v10SaveImportRegistry(){try{sessionStorage.setItem('miladgeo_v5_imported_files_'+JOB_KEY,JSON.stringify(v5ImportedFileKeys));}catch(e){}}
v10LoadImportRegistry();
function v5LoadTextFile(input){
 try{var f=input&&input.files&&input.files[0];if(!f)return;var r=new FileReader();r.onload=function(e){v5ImportText=String(e.target.result||'').replace(/^\uFEFF/,'');var st=$("v5ImportStatus");if(st)st.innerHTML='<span class="v5-ok">✓ '+escapeHTML(f.name)+'</span> — '+v5ImportText.split(/\r?\n/).filter(function(x){return x.trim()!=='';}).length+' lines';v5PreviewImport();};r.onerror=function(){showToast('Could not read text file');};r.readAsText(f);}
 catch(e){showToast('Text file read error');}
}
function v5DetectDelimiter(line){
 if(line.indexOf('\t')>=0)return '\t';
 if(line.indexOf(',')>=0)return ',';
 if(line.indexOf(';')>=0)return ';';
 return 'space';
}
function v5Split(line,delim){
 line=String(line||'').trim();
 if(!line)return [];
 if(delim==='space')return line.split(/\s+/);
 return line.split(delim).map(function(x){return x.trim();});
}
function v5Num(v){var s=String(v==null?'':v).trim().replace(/^\(|\)$/g,'');if(s==='')return NaN;return Number(s.replace(/,/g,''));}
function v5LooksHeader(a){if(!a||a.length<3)return false;var z=a.slice(0,5).join(' ').toLowerCase();var headerWord=/\b(point|pointno|pointnumber|easting|northing|east|north|elev|elevation|height|code|desc|description|x|y|z)\b/.test(z);var numericCore=a.length>=4&&!isNaN(v5Num(a[1]))&&!isNaN(v5Num(a[2]))&&!isNaN(v5Num(a[3]));return headerWord&&!numericCore;}
function v5ParseText(text,forced){
 var lines=String(text||'').split(/\r?\n/).map(function(x){return x.trim();}).filter(function(x){return x!=='' && x.charAt(0)!=='#' && x.charAt(0)!==';'});
 if(!lines.length)return {rows:[],bad:0,delimiter:'-',format:'-'};
 var first=lines[0],delim=v5DetectDelimiter(first),format=forced&&forced!=='auto'?forced:'auto';
 var start=0,rows=[],bad=0;
 if(v5LooksHeader(v5Split(first,delim)))start=1;
 if(format==='auto'){
   var a=v5Split(lines[start]||'',delim), nums=a.map(v5Num);
   if(a.length>=5 && !isNaN(nums[1]) && !isNaN(nums[2]) && !isNaN(nums[3])){
     format='penzd';
     if(/north/i.test(a[1])||/northing/i.test(a[1]))format='pnezd';
   }else if(a.length>=4 && !isNaN(nums[1]) && !isNaN(nums[2]) && !isNaN(nums[3]))format='penzd';
   else if(a.length>=3 && !isNaN(nums[0]) && !isNaN(nums[1]) && !isNaN(nums[2]))format='xyz';
 }
 for(var i=start;i<lines.length;i++){
   var parts=v5Split(lines[i],delim);if(!parts.length)continue;
   var pno='',dp='',x=NaN,y=NaN,z=0;
   if(format==='penzd' || format==='pnezd'){
     if(parts.length<4){bad++;continue;}
     pno=parts[0];var a=v5Num(parts[1]),b=v5Num(parts[2]);z=v5Num(parts[3]);
     if(format==='penzd'){x=a;y=b;}else{y=a;x=b;}
     dp=parts.slice(4).join(delim==='space'?' ':' ');
   }else if(format==='nez' || format==='enz'){
     if(parts.length<3){bad++;continue;}var a2=v5Num(parts[0]),b2=v5Num(parts[1]);z=v5Num(parts[2]);
     if(format==='nez'){y=a2;x=b2;}else{x=a2;y=b2;}
     pno='P'+String(rows.length+1).padStart(3,'0');dp=parts.slice(3).join(' ');
   }else if(format==='xyz'){
     if(parts.length<3){bad++;continue;}x=v5Num(parts[0]);y=v5Num(parts[1]);z=v5Num(parts[2]);pno=parts[3]||('P'+String(rows.length+1).padStart(3,'0'));dp=parts.slice(4).join(' ');
   }else{bad++;continue;}
   if(!isFinite(x)||!isFinite(y)||!isFinite(z)){bad++;continue;}
   rows.push({no:pno||('P'+String(rows.length+1).padStart(3,'0')),dp:dp||'',x:x,y:y,z:z});
 }
 return {rows:rows,bad:bad,delimiter:delim,format:format,lines:lines.length};
}
function v5PreviewImport(){
 if(!v5ImportText){showToast('Choose a TXT/CSV file first');return false;}
 var f=$("v5ImportFormat")?$("v5ImportFormat").value:'auto',p=v5ParseText(v5ImportText,f),pre=$("v5ImportPreview"),st=$("v5ImportStatus");
 if(st)st.innerHTML='<span class="v5-ok">✓ DETECTED: '+escapeHTML(p.format.toUpperCase())+'</span> — delimiter: '+(p.delimiter==='space'?'SPACE':p.delimiter==='\t'?'TAB':escapeHTML(p.delimiter))+' — valid: '+p.rows.length+' — bad: '+p.bad;
 if(pre){pre.style.display='block';pre.textContent=p.rows.slice(0,20).map(function(r){return r.no+' | E/X '+r.x+' | N/Y '+r.y+' | Z '+r.z+(r.dp?' | '+r.dp:'');}).join('\n')+(p.rows.length>20?'\n...':'');}
 /* V13: Preview is also the import action. This keeps the workflow to two buttons:
    PREVIEW / IMPORT and CLEAR LIST, with no confusing second import button. */
 if(!p.rows.length){showToast('No valid survey points found');return false;}
 return v5ImportPoints();
}
function v9PointKey(no,x,y,z,dp){
 return [String(no||'').trim().toUpperCase(),Number(x).toFixed(6),Number(y).toFixed(6),Number(z).toFixed(6),String(dp||'').trim().toUpperCase()].join('|');
}
function v5ImportPoints(){
 if(!v5ImportText){showToast('Choose a TXT/CSV file first');return false;}
 var f=$("v5ImportFormat")?$("v5ImportFormat").value:'auto',p=v5ParseText(v5ImportText,f);
 if(!p.rows.length){showToast('No valid survey points found');return false;}
 var importKey=v10ImportRegistryKey();
 if(v5ImportedFileKeys[importKey]){showToast('این فایل قبلاً برای این JOB وارد شده است ✓');return false;}
 var autoNo=$("v5PointNoMode")&&$("v5PointNoMode").value==='auto',base=getNextPointNumber(),existingNo={},existingCoord={};
 for(var e=0;e<points.length;e++){var ep=points[e];existingNo[String(ep.no||'').trim().toUpperCase()]=true;existingCoord=[Number(ep.x).toFixed(6),Number(ep.y).toFixed(6),Number(ep.z).toFixed(6)].join('|');existingCoord=existingCoord;}
 /* Build coordinate keys separately; DP is intentionally ignored so the same survey point cannot be duplicated. */
 var coordSet={};
 for(var e2=0;e2<points.length;e2++){var ep2=points[e2];coordSet[[Number(ep2.x).toFixed(6),Number(ep2.y).toFixed(6),Number(ep2.z).toFixed(6)].join('|')]=true;}
 var added=0,dupes=0;
 for(var i=0;i<p.rows.length;i++){
   var r=p.rows[i],no=autoNo?'P'+String(base+added).padStart(3,'0'):String(r.no||('P'+String(base+added).padStart(3,'0')));
   var coordKey=[Number(r.x).toFixed(6),Number(r.y).toFixed(6),Number(r.z).toFixed(6)].join('|');
   var noKey=no.trim().toUpperCase();
   if(coordSet[coordKey] || existingNo[noKey]){dupes++;continue;}
   points.push({id:Date.now()+Math.floor(Math.random()*100000)+i,no:no,dp:r.dp||'',x:r.x,y:r.y,z:r.z,distance:null,azimuth:null,textImport:true});
   coordSet[coordKey]=true;existingNo[noKey]=true;added++;
 }
 v5ImportedFileKeys[importKey]=true;v10SaveImportRegistry();
 window.points=points;saveJSON(POINTS_KEY,points);refreshPoints();updateAllUI();try{window.m4pRender&&window.m4pRender();window.m4pRenderControl&&window.m4pRenderControl();window.m4pRenderStats&&window.m4pRenderStats();}catch(e){}
 showToast(added+' point(s) imported ✓'+(dupes?' — '+dupes+' duplicate point(s) skipped':'')+(p.bad?' — '+p.bad+' bad row(s) skipped':'')+(added===0?' — file marked as imported':'') );
 return false;
}

window.miladgeoImportTextIntoActiveJob=function(text){
 v5ImportText=String(text||'').replace(/^\uFEFF/,'');
 if(!v5ImportText.trim()){showToast('فایل خالی است');return false;}
 return v5ImportPoints();
};

function v5BuildDelimited(delim,mode){
 var out=[],i,p,head='';
 for(i=0;i<points.length;i++){p=points[i];var no=String(p.no||''),e=Number(p.x),n=Number(p.y),z=Number(p.z);if(mode==='pnezd')out.push([no,n.toFixed(4),e.toFixed(4),z.toFixed(4),String(p.dp||'')]);else out.push([no,e.toFixed(4),n.toFixed(4),z.toFixed(4),String(p.dp||'')]);}
 return out.map(function(a){return a.map(function(v){var s=String(v);if(delim===','&&/[",\n]/.test(s))s='"'+s.replace(/"/g,'""')+'"';return s;}).join(delim);}).join('\r\n')+'\r\n';
}
function exportPointsXLSX(){
 if(!Array.isArray(points)||!points.length){showToast('ابتدا نقاط را در منو ۱۰ بارگذاری کن');return false;}
 try{
  /* Build a standards-compliant XLSX package locally. XLSX is a ZIP package;
     using stored ZIP entries avoids a CDN/library dependency on Android WebView. */
  var rows=[['Point','Easting','Northing','Elevation','Description','Distance','Azimuth']];
  points.forEach(function(p){rows.push([p.no==null?'':p.no,p.x==null?'':Number(p.x),p.y==null?'':Number(p.y),p.z==null?'':Number(p.z),p.dp||'',p.distance==null?'':Number(p.distance),p.azimuth==null?'':Number(p.azimuth)]);});
  function xmlEsc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;');}
  function colName(n){var out='';while(n>0){var r=(n-1)%26;out=String.fromCharCode(65+r)+out;n=Math.floor((n-1)/26);}return out;}
  var sheetRows=rows.map(function(row,ri){var cells=row.map(function(v,ci){var ref=colName(ci+1)+(ri+1);if(typeof v==='number'&&isFinite(v))return '<c r="'+ref+'"><v>'+String(v)+'</v></c>';var str=String(v==null?'':v);return '<c r="'+ref+'" t="inlineStr"><is><t xml:space="preserve">'+xmlEsc(str)+'</t></is></c>';}).join('');return '<row r="'+(ri+1)+'">'+cells+'</row>';}).join('');
  var sheet='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><cols><col min="1" max="1" width="16" customWidth="1"/><col min="2" max="4" width="18" customWidth="1"/><col min="5" max="5" width="30" customWidth="1"/><col min="6" max="7" width="16" customWidth="1"/></cols><sheetData>'+sheetRows+'</sheetData></worksheet>';
  var files=[
   ['[Content_Types].xml','<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/></Types>'],
   ['_rels/.rels','<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>'],
   ['xl/workbook.xml','<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets><sheet name="Points" sheetId="1" r:id="rId1"/></sheets></workbook>'],
   ['xl/_rels/workbook.xml.rels','<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/></Relationships>'],
   ['xl/worksheets/sheet1.xml',sheet]
  ];
  function utf8(str){return new TextEncoder().encode(str);}
  function u16(n){return [n&255,(n>>>8)&255];}function u32(n){return [n&255,(n>>>8)&255,(n>>>16)&255,(n>>>24)&255];}
  var crcTable=exportPointsXLSX._crcTable;if(!crcTable){crcTable=[];for(var n=0;n<256;n++){var c=n;for(var k=0;k<8;k++)c=(c&1)?(0xEDB88320^(c>>>1)):(c>>>1);crcTable[n]=c>>>0;}exportPointsXLSX._crcTable=crcTable;}
  function crc32(bytes){var c=0xFFFFFFFF;for(var i=0;i<bytes.length;i++)c=crcTable[(c^bytes[i])&255]^(c>>>8);return (c^0xFFFFFFFF)>>>0;}
  var local=[],central=[],offset=0;
  files.forEach(function(f){var name=utf8(f[0]),data=utf8(f[1]),crc=crc32(data);var lh=[0x50,0x4b,3,4].concat(u16(20),u16(0),u16(0),u16(0),u16(0),u32(crc),u32(data.length),u32(data.length),u16(name.length),u16(0),Array.from(name));local.push(new Uint8Array(lh),data);var ch=[0x50,0x4b,1,2].concat(u16(20),u16(20),u16(0),u16(0),u16(0),u16(0),u32(crc),u32(data.length),u32(data.length),u16(name.length),u16(0),u16(0),u16(0),u16(0),u32(0),u32(offset),Array.from(name));central.push(new Uint8Array(ch));offset+=lh.length+data.length;});
  var centralSize=central.reduce(function(a,b){return a+b.length;},0),endRec=new Uint8Array([0x50,0x4b,5,6].concat(u16(0),u16(0),u16(files.length),u16(files.length),u32(centralSize),u32(offset),u16(0)));
  var blob=new Blob(local.concat(central,[endRec]),{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
  var fname=sanitizeFileName((typeof job!=='undefined'&&job&&job.name)||'MiladGeo')+'_POINTS.xlsx';
  saveBlobLikeMenu17(fname,blob);showToast('فایل اکسل واقعی XLSX آماده شد ✓');
 }catch(e){console.error('MENU10_REAL_XLSX_EXPORT',e);showToast('ساخت فایل اکسل ناموفق بود؛ گزارش خطا ثبت شد');}
 return false;
}
function exportPointsXLS(){if(!points.length){showToast('No points to export');return false;}if(typeof XLSX==='undefined'){showToast('Excel engine unavailable');return false;}try{var rows=points.map(function(p){return {Point:p.no||'',Easting:Number(p.x),Northing:Number(p.y),Elevation:Number(p.z),Description:p.dp||'',Distance:p.distance==null?'':Number(p.distance),Azimuth:p.azimuth==null?'':Number(p.azimuth)};}),ws=XLSX.utils.json_to_sheet(rows),wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Points');var out=XLSX.write(wb,{bookType:'xls',type:'array'});saveBlobLikeMenu17(sanitizeFileName(job.name)+'_POINTS.xls',new Blob([out],{type:'application/vnd.ms-excel'}));showToast('XLS آماده شد ✓');}catch(e){console.error('XLS_EXPORT',e);showToast('ساخت XLS ناموفق بود؛ XLSX را استفاده کن');}return false;}
function exportGeoJSON(){if(!points.length){showToast('No points to export');return false;}var features=points.map(function(p){return {type:'Feature',properties:{Point:p.no||'',Description:p.dp||'',Z:Number(p.z)||0},geometry:{type:'Point',coordinates:[Number(p.x),Number(p.y),Number(p.z)||0]}};}),geo={type:'FeatureCollection',name:job.name||'MiladGeo Points',features:features};downloadText(sanitizeFileName(job.name)+'_POINTS.geojson',JSON.stringify(geo,null,2),'application/geo+json;charset=utf-8');showToast('GeoJSON آماده شد ✓');return false;}
function miladgeoPointListPDF(){
 /* INDEX90 — Menu 5 PDF is sent only through Menu 17's shared print engine.
    Keep one report source (the main project points array) for every point-list PDF button. */
 try{
  if(!Array.isArray(points)||!points.length){showToast('برای ساخت PDF ابتدا نقاط پروژه را ثبت یا وارد کن.');return false;}
  var safe=function(v){
   if(typeof escapeHTML==='function')return escapeHTML(v==null?'':String(v));
   return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});
  };
  var rows=points.map(function(p){
   var x=Number(p.x),y=Number(p.y),z=Number(p.z);
   return '<tr><td>'+safe(p.no||'')+'</td><td>'+ (isFinite(x)?x.toFixed(4):'') +'</td><td>'+ (isFinite(y)?y.toFixed(4):'') +'</td><td>'+ (isFinite(z)?z.toFixed(4):'') +'</td><td>'+safe(p.dp||'')+'</td></tr>';
  }).join('');
  var jobName=(typeof job!=='undefined'&&job&&job.name)?job.name:'—';
  var html='<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MiladGeo — گزارش نقاط</title><style>'+
   '@page{size:A4 landscape;margin:10mm}*{box-sizing:border-box}html,body{margin:0;padding:0;background:#fff;color:#111}'+
   'body{font-family:Tahoma,Arial,sans-serif;font-size:10pt;direction:rtl;padding:4mm}h2{text-align:center;margin:0 0 7mm;font-size:16pt}'+
   '.meta{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin:0 0 4mm;font-size:9pt}'+
   'table{width:100%;border-collapse:collapse;direction:ltr;table-layout:auto;font-size:9pt}th,td{border:1px solid #555;padding:6px 5px;text-align:center;vertical-align:middle}'+
   'th{background:#e8ece4;font-weight:800}tbody tr:nth-child(even){background:#f6f8f5}thead{display:table-header-group}tr{break-inside:avoid;page-break-inside:avoid}'+
   '@media print{body{padding:0}h2{margin-top:0}}</style></head><body>'+
   '<h2>گزارش نقاط پروژه — MiladGeo</h2><div class="meta"><span>پروژه: '+safe(jobName)+'</span><span>تعداد نقاط: '+points.length+'</span><span>تاریخ: '+safe(new Date().toLocaleString())+'</span></div>'+
   '<table><thead><tr><th>Point</th><th>Easting / X</th><th>Northing / Y</th><th>Elevation / Z</th><th>Description</th></tr></thead><tbody>'+rows+'</tbody></table></body></html>';

  /* This is the exact public bridge exposed by Menu 17's m17PrintHtml(). */
  var menu17Printer=window.miladgeoM17PrintHtml;
  if(typeof menu17Printer!=='function'){
   showToast('موتور PDF منو ۱۷ بارگذاری نشده است؛ خروجی ساخته نشد.');
   console.error('MENU5_PDF: Menu 17 print bridge is unavailable');
   return false;
  }
  var accepted=menu17Printer.call(window,html,'MiladGeo_Menu5_Point_Report.pdf');
  if(accepted===true){
   showToast('گزارش نقاط با موتور PDF منو ۱۷ ارسال شد؛ ذخیره به‌صورت PDF را انتخاب کن.');
   return false;
  }
  showToast('موتور PDF منو ۱۷ نتوانست گزارش را باز کند؛ اجازه چاپ یا بازشدن پنجره را بررسی کن.');
  console.error('MENU5_PDF: Menu 17 print engine returned false');
  return false;
 }catch(e){
  console.error('MENU5_PDF_ENGINE',e);
  showToast('ساخت PDF نقاط ناموفق بود: '+(e&&e.message?e.message:'خطای نامشخص'));
  return false;
 }
}
/* Public aliases: every point-list PDF entry point calls the SAME engine. */
function printPointsPDF(){return miladgeoPointListPDF();}

function v5ExportFormat(mode){
 if(!points.length){showToast('No points to export');return false;}
 var name=sanitizeFileName(job.name),txt='',file='',mime='text/plain;charset=utf-8';
 if(mode==='penzd'){txt=v5BuildDelimited(',','penzd');file=name+'_PENZD.txt';}
 else if(mode==='pnezd'){txt=v5BuildDelimited(',','pnezd');file=name+'_PNEZD.txt';}
 else if(mode==='nez'){txt=points.map(function(p){return Number(p.y).toFixed(4)+' '+Number(p.x).toFixed(4)+' '+Number(p.z).toFixed(4);}).join('\r\n')+'\r\n';file=name+'_NEZ.txt';}
 else if(mode==='enz'){txt=points.map(function(p){return Number(p.x).toFixed(4)+' '+Number(p.y).toFixed(4)+' '+Number(p.z).toFixed(4);}).join('\r\n')+'\r\n';file=name+'_ENZ.txt';}
 else if(mode==='csv'){txt='Point,Easting,Northing,Elevation,Description\r\n'+v5BuildDelimited(',','penzd');file=name+'_PENZD.csv';mime='text/csv;charset=utf-8';}
 else if(mode==='leica_ascii'){txt='Point,Easting,Northing,Height,Code\r\n'+v5BuildDelimited(',','penzd');file=name+'_LEICA_ASCII.csv';mime='text/csv;charset=utf-8';}
 else return false;
 saveBlobLikeMenu17(file,new Blob(['\ufeff'+txt],{type:mime||'text/plain;charset=utf-8'}));showToast(mode.toUpperCase()+' export ready ✓');return false;
}

function exportPoints(){return exportCSV();}
function csvSafe(v){return String(v).replace(/"/g,'""');}
function sanitizeFileName(v){return String(v).replace(/[\\/:*?"<>|]/g,'_')||'MILADGEO_JOB';}
function renderStationSet(){var el=$("stationSetBox");if(el)el.innerHTML=setup.stationSet?'<div class="set-box"><div class="tick done">✓</div><div><div class="set-text done">STATION SET</div><div class="subtitle">'+escapeHTML(setup.stationName||'—')+' — X '+fmt(setup.sx,3)+' | Y '+fmt(setup.sy,3)+' | Z '+fmt(setup.sz,3)+' | HI '+fmt(setup.stationHI,3)+(setup.stationDP?' | DP '+escapeHTML(setup.stationDP):'')+'</div></div></div>':'<div class="set-box"><div class="tick">—</div><div class="set-text">STATION NOT SET</div></div>';var c=$("menu1StationCard"),st=$("menu1StationState");if(c){c.classList.toggle('ok',!!setup.stationSet);c.classList.toggle('off',!setup.stationSet);}if(st)st.textContent=setup.stationSet?'✓ SET':'NOT SET';var a=$("measureStationPill");if(a){a.classList.toggle('ok',!!setup.stationSet);a.querySelector('b').textContent=setup.stationSet?'✓ SET':'NOT SET';}var b=$("stakeStationPill");if(b){b.classList.toggle('ok',!!setup.stationSet);b.querySelector('b').textContent=setup.stationSet?'✓ SET':'NOT SET';}}
function renderOrientationSet(){var el=$("orientationSetBox");if(el)el.innerHTML=setup.orientationSet?'<div class="set-box"><div class="tick done">✓</div><div><div class="set-text done">ORIENTATION SET</div><div class="subtitle">'+(setup.orientationSource==='job'?'BACKSIGHT '+escapeHTML(setup.backName||'—')+' — ':'')+fmt(setup.azimuth,4)+'° | '+fmt(setup.orientationDistance,3)+' m</div></div></div>':'<div class="set-box"><div class="tick">—</div><div class="set-text">ORIENTATION NOT SET</div></div>';var c=$("menu1OrientationCard"),st=$("menu1OrientationState");if(c){c.classList.toggle('ok',!!setup.orientationSet);c.classList.toggle('off',!setup.orientationSet);}if(st)st.textContent=setup.orientationSet?'✓ SET':'NOT SET';var a=$("measureOrientationPill");if(a){a.classList.toggle('ok',!!setup.orientationSet);a.querySelector('b').textContent=setup.orientationSet?'✓ SET':'NOT SET';}var b=$("stakeOrientationPill");if(b){b.classList.toggle('ok',!!setup.orientationSet);b.querySelector('b').textContent=setup.orientationSet?'✓ SET':'NOT SET';}}
function setStatus(id,ok){if(!id)return;id.textContent=ok?'✓ SET':'NOT SET';id.className=ok?'ok':'not-ok';}
function updateAllUI(){var hs=$("headerStatus"),js=$("jobSummary"),jobSt=$("jobStatus"),stSt=$("stationStatus"),orSt=$("orientationStatus"),sms=$("stationMenuState"),mm=$("measureMenu"),ms=$("measureMenuState"),sm=$("stakeMenu"),ss=$("stakeMenuState"),pm=$("pointsMenuState");var jobNav=$("jobNavBtn");if(jobNav)jobNav.classList.toggle("job-ready",!!job.name);if(hs)hs.textContent=job.name||'JOB NAME';if(js)js.innerHTML=job.name?'<div class="result-line"><span>Job</span><b>'+escapeHTML(job.name)+'</b></div><div class="result-line"><span>Points</span><b>'+points.length+'</b></div>':'<span class="not-ok">No Job defined</span>';setStatus(jobSt,!!job.name);setStatus(stSt,!!setup.stationSet);setStatus(orSt,!!setup.orientationSet);if(sms)sms.textContent=setup.stationSet?'✓ SET':'NOT SET';if(mm)mm.classList.remove('locked');if(sm)sm.classList.remove('locked');if(ms)ms.textContent='✓ MAP READY';if(ss)ss.textContent='✓ GPS READY';if(pm)pm.textContent=points.length+' POINT'+(points.length===1?'':'S');var jn=$("jobNavBtn");if(jn){jn.classList.toggle("job-ready",!!job.name);jn.textContent=job.name?"🟢 JOB: "+job.name:"🔴 INPUT JOB";}var sj=$("setJobBtn");if(sj){sj.textContent=job.name?"✓ UPDATE JOB":"✓ SET JOB";}var mjn=$("menu1JobName"),mjt=$("menu1JobTick");if(mjn){mjn.textContent=job.name||'JOB NOT SET';}if(mjt){mjt.textContent=job.name?'✓':'—';}refreshMenu1JobPointSelects();refreshLeicaLineSelects();renderStationSet();renderOrientationSet();renderReferenceLineUI();renderLeicaLineUI();if(typeof updateJobOutput363==="function")updateJobOutput363();}
function fmt(v,n){if(n==null)n=3;var x=Number(v);return isFinite(x)?x.toFixed(n):'-';}
function escapeHTML(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
function showToast(m){var t=$("toast");if(!t)return;t.textContent=m;t.classList.add('show');clearTimeout(window.miladToastTimer);window.miladToastTimer=setTimeout(function(){t.classList.remove('show');},1900);}
window.showToast=showToast;
window.areaSplitExportExcel=areaSplitExportExcel;window.areaSplitExportDXF=areaSplitExportDXF;window.areaSplitExportKML=areaSplitExportKML;window.areaSplitExportCSV=areaSplitExportCSV;window.areaSplitExportTXT=areaSplitExportTXT;window.areaSplitPrintReport=areaSplitPrintReport;window.addAreaPoint=addAreaPoint;window.removeAreaPoint=removeAreaPoint;window.calculateArea=calculateArea;window.clearAreaPoints=clearAreaPoints;window.areaSetSource=areaSetSource;window.areaAddJobPoint=areaAddJobPoint;window.areaImportFile=areaImportFile;window.areaExportCSV=areaExportCSV;window.areaExportTXT=areaExportTXT;window.areaPrintReport=areaPrintReport;window.areaOffset=areaOffset;window.areaSplit=areaSplit;window.areaSplitByArea=areaSplitByArea;window.exportAreaDXF=exportAreaDXF;window.exportAreaExcel=exportAreaExcel;window.exportAreaKML=exportAreaKML;window.drawAreaSketch=drawAreaSketch;window.saveJob=saveJob;window.setStation=setStation;window.setOrientation=setOrientation;window.changeOrientationMethod=changeOrientationMethod;window.openMeasure=openMeasure;window.openStake=openStake;window.saveCalculatedPoint=saveCalculatedPoint;window.editPoint=editPoint;window.deletePoint=deletePoint;window.clearAllPoints=clearAllPoints;window.updatePoint=updatePoint;window.loadStakePoint=loadStakePoint;window.calculateStake=calculateStake;window.calculatePoint=calculatePoint;window.exportPoints=exportPoints;window.exportSelected=exportSelected;window.exportCSV=exportCSV;window.exportTXT=exportTXT;window.exportKML=exportKML;window.exportDXF=exportDXF;window.exportLandXML=exportLandXML;window.exportLeicaGSI16=exportLeicaGSI16;window.exportJobLeicaGSI=exportJobLeicaGSI;window.exportSandingGSI=exportSandingGSI;window.showPlannedTotalStationFormat=showPlannedTotalStationFormat;window.exportJSON=exportJSON;window.setStakeMode=setStakeMode;window.calculateStakePolar=calculateStakePolar;window.exportKMZ=exportKMZ;window.exportCodeTXT=exportCodeTXT;window.printSurveyMap=printSurveyMap;window.v5LoadTextFile=v5LoadTextFile;window.v5PreviewImport=v5PreviewImport;window.v5ImportPoints=v5ImportPoints;window.v5ExportFormat=v5ExportFormat;window.addPENZDPoint=addPENZDPoint;window.clearPENZDInput=clearPENZDInput;window.exportPointsXLSX=exportPointsXLSX;window.exportPointsXLS=exportPointsXLS;window.exportGeoJSON=exportGeoJSON;window.printPointsPDF=printPointsPDF;window.updateJobOutput363=updateJobOutput363;
var v8Points=[],v8SurfaceCount=3,v8Last={mode:'',cut:0,fill:0,net:0,total:0,area:0,points:[]};
function v8Num(v){var x=Number(String(v==null?'':v).replace(/,/g,''));return isFinite(x)?x:NaN;}
function v8Mode(mode){var ids=['points','surfaces','grid','base','earth'];ids.forEach(function(x){var p=$('v8'+x.charAt(0).toUpperCase()+x.slice(1)+'Panel');if(p)p.style.display=x===mode?'block':'none';});document.querySelectorAll('.v8-tab').forEach(function(b){b.classList.remove('active')});var ix=ids.indexOf(mode);var tabs=document.querySelectorAll('.v8-tab');if(tabs[ix])tabs[ix].classList.add('active');if(mode==='earth')v8RenderEarth();return false;}
function v8PointRow(p,i){p=p||{};return '<div class="v8-point-row"><div class="v8-pno">P'+i+'</div><input id="v8x'+i+'" type="number" step="any" value="'+(p.x==null?'':p.x)+'" placeholder="X"><input id="v8y'+i+'" type="number" step="any" value="'+(p.y==null?'':p.y)+'" placeholder="Y"><input id="v8z'+i+'" type="number" step="any" value="'+(p.z==null?'':p.z)+'" placeholder="Z"><button class="v8-btn v8-remove" type="button" onclick="v8RemovePoint('+i+');return false;">×</button></div>';}
function v8RenderPoints(){var b=$('v8Points');if(!b)return;b.innerHTML=v8Points.map(function(p,i){return v8PointRow(p,i+1)}).join('');}
function v8ReadPoints(){var out=[],i,x,y,z;for(i=1;i<=v8Points.length;i++){x=v8Num($('v8x'+i).value);y=v8Num($('v8y'+i).value);z=v8Num($('v8z'+i).value);if(!isFinite(x)||!isFinite(y)||!isFinite(z))continue;out.push({no:i,x:x,y:y,z:z});}return out;}
function v8AddPoint(){v8Points.push({x:'',y:'',z:''});v8RenderPoints();var e=$('v8x'+v8Points.length);if(e)e.focus();return false;}
function v8RemovePoint(i){if(v8Points.length<=3){showToast('حداقل ۳ نقطه لازم است');return false;}v8Points.splice(i-1,1);v8RenderPoints();return false;}
function v8ClearPoints(){v8Points=[{},{},{}];v8RenderPoints();$('v8Result').innerHTML='<div class="v8-empty">داده‌ها پاک شدند.</div>';v8Draw([]);return false;}
function v8LoadJob(){try{var src=(Array.isArray(points)?points:[]);if(!src.length){try{var raw=localStorage.getItem(POINTS_KEY);if(raw){var parsed=JSON.parse(raw);if(Array.isArray(parsed))src=parsed;}}catch(_e){}}if(!src.length){showToast('در جاب نقطه‌ای وجود ندارد');return false;}var a=src.map(function(p,i){return {x:v8Num(p.x),y:v8Num(p.y),z:v8Num(p.z),no:p.no||p.name||('P'+(i+1))}}).filter(function(p){return isFinite(p.x)&&isFinite(p.y)&&isFinite(p.z)});if(a.length<3){showToast('حداقل ۳ نقطه معتبر لازم است');return false;}v8Points=a;v8RenderPoints();showToast(a.length+' نقطه از جاب وارد شد ✓');return false;}catch(e){console.error('V8_LOAD_JOB',e);showToast('ورود از جاب انجام نشد');return false;}}
function v8ImportFile(input){var f=input&&input.files&&input.files[0];if(!f)return false;var r=new FileReader();r.onload=function(ev){try{var rows=[];if(/\.(xlsx|xls)$/i.test(f.name)&&window.XLSX){var wb=XLSX.read(new Uint8Array(ev.target.result),{type:'array'}),ws=wb.Sheets[wb.SheetNames[0]];rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});}else rows=String(ev.target.result||'').split(/\r?\n/).filter(Boolean).map(function(l){return l.split(/[;,\t, ]+/)});var out=[];rows.forEach(function(row,i){var vals=row.map(v=>v);var nums=vals.map(v=>v8Num(v)).filter(function(x){return isFinite(x)});if(nums.length>=3){var x=v8Num(row[1]),y=v8Num(row[2]),z=v8Num(row[3]);if(!isFinite(x)||!isFinite(y)||!isFinite(z)){x=v8Num(row[0]);y=v8Num(row[1]);z=v8Num(row[2]);}if(isFinite(x)&&isFinite(y)&&isFinite(z))out.push({x:x,y:y,z:z,no:i+1});}});if(out.length<3){showToast('حداقل ۳ نقطه X/Y/Z معتبر لازم است');return;}v8Points=out;v8RenderPoints();showToast(out.length+' نقطه وارد شد ✓');}catch(e){console.error('V8_IMPORT',e);showToast('خواندن فایل انجام نشد');}};if(/\.(xlsx|xls)$/i.test(f.name))r.readAsArrayBuffer(f);else r.readAsText(f);return false;}
function v8PolyArea(a){var s=0,i,j;for(i=0;i<a.length;i++){j=(i+1)%a.length;s+=a[i].x*a[j].y-a[j].x*a[i].y;}return Math.abs(s)/2;}
function v8Tri(a,b,c){return Math.abs((b.x-a.x)*(c.y-a.y)-(c.x-a.x)*(b.y-a.y))/2;}
function v8CalcBase(){var a=v8ReadPoints();var rl=v8Num($('v8BaseRL').value);if(a.length<3||!isFinite(rl)){showToast('حداقل ۳ نقطه و RL معتبر لازم است');return false;}var area=v8PolyArea(a),cut=0,fill=0,vol=0;for(var i=1;i<a.length-1;i++){var ar=v8Tri(a[0],a[i],a[i+1]);var d=((a[0].z-rl)+(a[i].z-rl)+(a[i+1].z-rl))/3;var v=ar*Math.abs(d);vol+=v;if(d>0)cut+=v;else if(d<0)fill+=v;}v8Last={mode:'سطح مبنا',cut:cut,fill:fill,net:cut-fill,total:vol,area:area,points:a,rl:rl};v8ShowResult('حجم نسبت به سطح مبنا',area,vol,cut,fill,cut-fill,a.length);v8Draw(a);v8RenderEarth();return false;}
function v8CopyBaseAndCalc(){var v=$('v8BaseRL2').value;if($('v8BaseRL'))$('v8BaseRL').value=v;v8Mode('points');return v8CalcBase();}
function v8RenderSurfaceRows(){var a=[],i;for(i=1;i<=v8SurfaceCount;i++){a.push('<div class="v8-surface-row"><b>P'+i+'</b><input id="v8ex'+i+'" type="number" step="any" placeholder="X"><input id="v8ey'+i+'" type="number" step="any" placeholder="Y"><input id="v8ez'+i+'" type="number" step="any" placeholder="Z"></div>');}var d=a.join('');if($('v8Existing'))$('v8Existing').innerHTML=d;if($('v8Design'))$('v8Design').innerHTML=a.map(function(_,i){return '<div class="v8-surface-row"><b>P'+(i+1)+'</b><input id="v8dx'+(i+1)+'" type="number" step="any" placeholder="X"><input id="v8dy'+(i+1)+'" type="number" step="any" placeholder="Y"><input id="v8dz'+(i+1)+'" type="number" step="any" placeholder="Z"></div>'}).join('');}
function v8AddSurfaceRow(){v8SurfaceCount++;v8RenderSurfaceRows();return false;}
function v8ClearSurfaces(){v8SurfaceCount=3;v8RenderSurfaceRows();return false;}
function v8CalcSurfaces(){var a=[],b=[],i;for(i=1;i<=v8SurfaceCount;i++){var p={x:v8Num($('v8ex'+i).value),y:v8Num($('v8ey'+i).value),z:v8Num($('v8ez'+i).value)},q={x:v8Num($('v8dx'+i).value),y:v8Num($('v8dy'+i).value),z:v8Num($('v8dz'+i).value)};if(!isFinite(p.x)||!isFinite(p.y)||!isFinite(p.z)||!isFinite(q.x)||!isFinite(q.y)||!isFinite(q.z)){showToast('همه مختصات دو سطح را وارد کن');return false;}a.push(p);b.push(q);}var cut=0,fill=0,total=0,area=v8PolyArea(a);for(i=1;i<a.length-1;i++){var ar=(v8Tri(a[0],a[i],a[i+1])+v8Tri(b[0],b[i],b[i+1]))/2;var d=((a[0].z-b[0].z)+(a[i].z-b[i].z)+(a[i+1].z-b[i+1].z))/3;var v=ar*Math.abs(d);total+=v;if(d>0)cut+=v;else if(d<0)fill+=v;}v8Last={mode:'دو سطح',cut:cut,fill:fill,net:cut-fill,total:total,area:area,points:a,design:b};v8ShowResult('حجم بین دو سطح',area,total,cut,fill,cut-fill,a.length);v8Draw(a);v8RenderEarth();return false;}
function v8BuildGrid(){var c=Math.max(1,Math.min(20,parseInt($('v8Cols').value)||1)),r=Math.max(1,Math.min(20,parseInt($('v8Rows').value)||1)),h='';h+='<table class="v8-grid-table"><tr><th>ردیف / ستون</th>';for(var j=0;j<=c;j++)h+='<th>'+j+'</th>';h+='</tr>';for(var i=0;i<=r;i++){h+='<tr><th>'+i+'</th>';for(j=0;j<=c;j++)h+='<td><input id="v8g'+i+'_'+j+'" type="number" step="any" placeholder="Z"></td>';h+='</tr>';}h+='</table>';$('v8GridInputs').innerHTML=h;return false;}
function v8CalcGrid(){var c=Math.max(1,parseInt($('v8Cols').value)||1),r=Math.max(1,parseInt($('v8Rows').value)||1),w=v8Num($('v8CellW').value),h=v8Num($('v8CellH').value),rl=v8Num($('v8GridRL').value);if(!isFinite(w)||!isFinite(h)||!isFinite(rl)){showToast('ابعاد سلول و RL معتبر لازم است');return false;}var cut=0,fill=0,total=0;for(var i=0;i<r;i++)for(var j=0;j<c;j++){var z=[v8Num($('v8g'+i+'_'+j).value),v8Num($('v8g'+(i+1)+'_'+j).value),v8Num($('v8g'+i+'_'+(j+1)).value),v8Num($('v8g'+(i+1)+'_'+(j+1)).value)];if(z.some(function(x){return !isFinite(x)})){showToast('ارتفاع همه گره‌های شبکه را وارد کن');return false;}var d=(z[0]+z[1]+z[2]+z[3])/4-rl,v=w*h*Math.abs(d);total+=v;if(d>0)cut+=v;else if(d<0)fill+=v;}v8Last={mode:'شبکه',cut:cut,fill:fill,net:cut-fill,total:total,area:c*r*w*h,points:[]};v8ShowResult('حجم شبکه',c*r*w*h,total,cut,fill,cut-fill,c*r);v8RenderEarth();return false;}
function v8ShowResult(title,area,total,cut,fill,net,count){$('v8Result').innerHTML='<div class="v8-panel-title">✓ '+title+'</div><div class="v8-main-number">'+fmt(total,3)+' <small>m³</small></div><div class="v8-stat-grid"><div class="v8-stat"><small>مساحت</small><b>'+fmt(area,3)+' m²</b></div><div class="v8-stat"><small>خاکبرداری</small><b>'+fmt(cut,3)+' m³</b></div><div class="v8-stat"><small>خاکریزی</small><b>'+fmt(fill,3)+' m³</b></div><div class="v8-stat"><small>خالص</small><b>'+fmt(net,3)+' m³</b></div></div><div style="text-align:center;font-size:9px;margin-top:7px">تعداد داده: '+count+' — روش: '+title+'</div>';showToast('محاسبه حجم انجام شد ✓');}
function v8RenderEarth(){var e=$('v8EarthSummary');if(!e)return;e.innerHTML='<div class="v8-earth-box"><small>خاکبرداری CUT</small><b>'+fmt(v8Last.cut||0,3)+' m³</b></div><div class="v8-earth-box"><small>خاکریزی FILL</small><b>'+fmt(v8Last.fill||0,3)+' m³</b></div><div class="v8-earth-box"><small>حجم خالص</small><b>'+fmt(v8Last.net||0,3)+' m³</b></div>';}
function v8Draw(a){var svg=$('v8Sketch');if(!svg)return;if(!a||a.length<1){svg.innerHTML='';return;}var minx=Math.min.apply(null,a.map(function(p){return p.x})),maxx=Math.max.apply(null,a.map(function(p){return p.x})),miny=Math.min.apply(null,a.map(function(p){return p.y})),maxy=Math.max.apply(null,a.map(function(p){return p.y})),w=maxx-minx||1,h=maxy-miny||1,pad=45;function X(x){return pad+(x-minx)/(w)*(700-2*pad)}function Y(y){return 360-pad-(y-miny)/(h)*(360-2*pad)}var pts=a.map(function(p){return X(p.x)+','+Y(p.y)}).join(' ');svg.innerHTML='<text x="20" y="28">N</text><line x1="25" y1="60" x2="25" y2="28" stroke="#596b5a" stroke-width="2"/><polygon class="poly" points="'+pts+'"></polygon>'+a.map(function(p,i){return '<circle class="pt" cx="'+X(p.x)+'" cy="'+Y(p.y)+'" r="5"></circle><text x="'+(X(p.x)+7)+'" y="'+(Y(p.y)-7)+'">P'+(i+1)+'</text>'}).join('');}
function v8ReportHtml(){var j=(typeof job!=='undefined'&&job&&job.name)?job.name:'—';return '<!doctype html><html dir="rtl"><meta charset="utf-8"><style>body{font-family:Arial,Tahoma,sans-serif;padding:24px;color:#172018}h1{font-size:24px}table{width:100%;border-collapse:collapse;margin-top:14px}td,th{border:1px solid #bbb;padding:8px;text-align:center}th{background:#e1eadf}.box{padding:14px;border:1px solid #8ea08c;border-radius:10px;margin:10px 0}</style><h1>گزارش حرفه‌ای حجم — MiladGeo</h1><div class="box">JOB: '+escapeHTML(j)+'<br>روش: '+escapeHTML(v8Last.mode||'—')+'<br>تعداد داده: '+(v8Last.points||[]).length+'</div><table><tr><th>مورد</th><th>مقدار</th></tr><tr><td>حجم کل</td><td>'+fmt(v8Last.total||0,3)+' m³</td></tr><tr><td>خاکبرداری</td><td>'+fmt(v8Last.cut||0,3)+' m³</td></tr><tr><td>خاکریزی</td><td>'+fmt(v8Last.fill||0,3)+' m³</td></tr><tr><td>حجم خالص</td><td>'+fmt(v8Last.net||0,3)+' m³</td></tr></table></html>';}
function v8ExportPDF(){if(!v8Last.mode){showToast('ابتدا یک محاسبه انجام بده');return false;}var h=v8ReportHtml();try{if(typeof window.miladgeoM17PrintHtml==='function'){window.miladgeoM17PrintHtml(h,'MiladGeo — گزارش حجم');return false;}}catch(e){console.error('V8_PDF',e)}showToast('موتور PDF آماده نیست');return false;}
function v8ExportCSV(){if(!v8Last.mode){showToast('ابتدا یک محاسبه انجام بده');return false;}var rows=['نوع,شماره,X,Y,Z'];(v8Last.points||[]).forEach(function(p){rows.push('Point,'+(p.no||'')+','+p.x+','+p.y+','+p.z)});rows.push('Result,,,,');rows.push('Total Volume,,,'+(v8Last.total||0));rows.push('Cut,,,'+(v8Last.cut||0));rows.push('Fill,,,'+(v8Last.fill||0));return saveBlobLikeMenu17('MiladGeo_Volume.csv',new Blob(['\uFEFF'+rows.join('\n')],{type:'text/csv;charset=utf-8'}));}
function v8ExportTXT(){if(!v8Last.mode){showToast('ابتدا یک محاسبه انجام بده');return false;}var t='MILADGEO — VOLUME REPORT\nJOB: '+((typeof job!=='undefined'&&job&&job.name)||'—')+'\nMETHOD: '+v8Last.mode+'\nTOTAL VOLUME: '+fmt(v8Last.total||0,3)+' m3\nCUT: '+fmt(v8Last.cut||0,3)+' m3\nFILL: '+fmt(v8Last.fill||0,3)+' m3\nNET: '+fmt(v8Last.net||0,3)+' m3\n';return saveBlobLikeMenu17('MiladGeo_Volume.txt',new Blob([t],{type:'text/plain;charset=utf-8'}));}
function v8ExportExcel(){if(!v8Last.mode||typeof XLSX==='undefined'){showToast('ابتدا محاسبه کن و موتور Excel را بررسی کن');return false;}var rows=(v8Last.points||[]).map(function(p){return {Point:p.no||'',X:p.x,Y:p.y,Z:p.z}});rows.push({Point:'TOTAL VOLUME',X:v8Last.total||0,Y:'',Z:''},{Point:'CUT',X:v8Last.cut||0,Y:'',Z:''},{Point:'FILL',X:v8Last.fill||0,Y:'',Z:''},{Point:'NET',X:v8Last.net||0,Y:'',Z:''});var ws=XLSX.utils.json_to_sheet(rows),wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Volume');var out=XLSX.write(wb,{bookType:'xlsx',type:'array'});return saveBlobLikeMenu17('MiladGeo_Volume.xlsx',new Blob([out],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}));}
function v8ExportDXF(){var a=v8Last.points||[];if(a.length<2){showToast('برای DXF حداقل ۲ نقطه لازم است');return false;}var d='0\\nSECTION\\n2\\nENTITIES\\n';a.forEach(function(p,i){var q=a[(i+1)%a.length];d+='0\\nLINE\\n8\\nVOLUME\\n10\\n'+p.x+'\\n20\\n'+p.y+'\\n30\\n'+p.z+'\\n11\\n'+q.x+'\\n21\\n'+q.y+'\\n31\\n'+q.z+'\\n'});d+='0\\nENDSEC\\n0\\nEOF\\n';return saveBlobLikeMenu17('MiladGeo_Volume.dxf',new Blob([d],{type:'application/dxf'}));}
function v8ExportKML(){var a=v8Last.points||[];if(a.length<3){showToast('برای KML حداقل ۳ نقطه لازم است');return false;}var zone=v8Num($('v8KmlZone')&&$('v8KmlZone').value),hem=$('v8KmlHem')?$('v8KmlHem').value:'N';if(!isFinite(zone)||zone<1||zone>60){showToast('زون UTM معتبر برای KML وارد کن');return false;}if(typeof window.m17ConvertUtmToWgs84!=='function'){showToast('مبدل مختصات KML آماده نیست');return false;}var coords=[];try{a.forEach(function(p){var c=window.m17UtmToWgs84?window.m17UtmToWgs84(p.x,p.y,zone,hem):window.m17ConvertUtmToWgs84(p.x,p.y,zone);coords.push(Number(c.lng).toFixed(8)+','+Number(c.lat).toFixed(8)+','+Number(p.z||0).toFixed(3));});coords.push(coords[0]);}catch(e){console.error('V8_KML',e);showToast('تبدیل مختصات KML ناموفق بود');return false;}var k='<?xml version="1.0" encoding="UTF-8"?><kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>MiladGeo Volume</name><Placemark><Polygon><outerBoundaryIs><LinearRing><coordinates>'+coords.join(' ')+'</coordinates></LinearRing></outerBoundaryIs></Polygon></Placemark></Document></kml>';return saveBlobLikeMenu17('MiladGeo_Volume.kml',new Blob([k],{type:'application/vnd.google-earth.kml+xml;charset=utf-8'}));}
window.v8Mode=v8Mode;window.v8LoadJob=v8LoadJob;window.v8ImportFile=v8ImportFile;window.v8AddPoint=v8AddPoint;window.v8RemovePoint=v8RemovePoint;window.v8ClearPoints=v8ClearPoints;window.v8CalcBase=v8CalcBase;window.v8CopyBaseAndCalc=v8CopyBaseAndCalc;window.v8AddSurfaceRow=v8AddSurfaceRow;window.v8ClearSurfaces=v8ClearSurfaces;window.v8CalcSurfaces=v8CalcSurfaces;window.v8BuildGrid=v8BuildGrid;window.v8CalcGrid=v8CalcGrid;window.v8ExportPDF=v8ExportPDF;window.v8ExportCSV=v8ExportCSV;window.v8ExportTXT=v8ExportTXT;window.v8ExportExcel=v8ExportExcel;window.v8ExportDXF=v8ExportDXF;window.v8ExportKML=v8ExportKML;
setTimeout(function(){v8Points=[{},{},{}];v8RenderPoints();v8RenderSurfaceRows();v8BuildGrid();},0);

function goBack(){var h=(location.hash||'').replace(/^#/,'');var target='main';if(h==='edit')target='points';else if(h==='measure'||h==='stake')target='leica';else if(h==='realMeasure'||h==='realStake'||h==='station'||h==='orientation'||h==='points'||h==='area'||h==='volume'||h==='graphicmap'||h==='uav'||h==='training'||h==='menu17'||h==='menu18')target='main';else if(h==='main'||!h){showToast('MAIN MENU');return false;}goPage(target);return false;}
window.goBack=goBack;window.saveJob=saveJob;window.setStation=setStation;window.setOrientation=setOrientation;window.changeOrientationMethod=changeOrientationMethod;window.openMeasure=openMeasure;window.openStake=openStake;window.calculatePoint=calculatePoint;window.saveCalculatedPoint=saveCalculatedPoint;window.calculateStake=calculateStake;window.calculateStakePolar=calculateStakePolar;window.setStakeMode=setStakeMode;window.loadStakePoint=loadStakePoint;window.addManualPoint=addManualPoint;window.prepareManualPoint=prepareManualPoint;window.clearAllPoints=clearAllPoints;window.editPoint=editPoint;window.deletePoint=deletePoint;window.updatePoint=updatePoint;window.exportSelected=exportSelected;window.exportJobSelected=exportJobSelected;window.addAreaPoint=addAreaPoint;window.removeAreaPoint=removeAreaPoint;window.calculateArea=calculateArea;window.clearAreaPoints=clearAreaPoints;




function m6eTab(name){var tabs=document.querySelectorAll('.m6e-tab'),panels=document.querySelectorAll('.m6e-panel');for(var i=0;i<tabs.length;i++){var on=tabs[i].getAttribute('data-tab')===name;tabs[i].classList.toggle('active',on);}for(var j=0;j<panels.length;j++){var show=panels[j].id==='m6e-'+name;panels[j].classList.toggle('active',show);panels[j].style.display=show?'block':'none';}if(name==='review'){try{previewExcelRows();}catch(e){}}m6eSync();return false;}
window.m6eTab=m6eTab;
window.m6eFilePicked=m6eFilePicked;
function m6eFilePicked(input){var f=input&&input.files&&input.files[0],n=$('m6eFileName'),info=$('m6ePickedInfo');if(!f){if(n)n.textContent='انتخاب نشده';if(info)info.textContent='فایلی انتخاب نشده است.';return;}if(n)n.textContent=f.name;if(info)info.textContent=f.name+' — '+Math.max(1,Math.round(f.size/1024))+' KB';m6eTab('import');}
function m6eSync(){var n=$('m6eCount'),pc=$('m6ePointCount'),state=$('m6eState'),sc=$('m6eSheetCount');if(n)n.textContent=(typeof points!=='undefined'?points.length:0)+' POINT';if(pc)pc.textContent=(typeof points!=='undefined'?points.length:0);if(sc&&typeof excelWorkbook!=='undefined'&&excelWorkbook)sc.textContent=(excelWorkbook.SheetNames||[]).length;try{var f=$('excelFile')&&$('excelFile').files[0];if(f&&$('m6eFileName'))$('m6eFileName').textContent=f.name;}catch(e){}if(state)state.textContent=(typeof excelWorkbook!=='undefined'&&excelWorkbook)?'فایل آماده':'آماده';}

var excelWorkbook=null,excelRows=[],excelHeaders=[],excelImportedIds=[],excelDelimiter=',';
var excelEngineLoading=false;
function excelNorm(v){return String(v==null?'':v).trim().toLowerCase().replace(/[\s_\-\/]+/g,'');}
function excelPickHeader(headers,keys,exclude){var i,j,h,n;for(i=0;i<headers.length;i++){h=String(headers[i]);n=excelNorm(h);if(exclude&&exclude.indexOf(i)>=0)continue;for(j=0;j<keys.length;j++){if(n===excelNorm(keys[j])||n.indexOf(excelNorm(keys[j]))>=0)return i;}}return -1;}
function fillExcelSelect(id,selected,allowNone){var el=$(id);if(!el)return;var out=allowNone?'<option value="-1">— NONE —</option>':'';for(var i=0;i<excelHeaders.length;i++)out+='<option value="'+i+'">'+escapeHTML(String(excelHeaders[i]))+'</option>';el.innerHTML=out;if(selected>=0&&selected<excelHeaders.length)el.value=String(selected);}
function setupExcelMapping(){
  /* V48: no manual column selectors. Standard survey formats are handled
     automatically. With headers, names are detected first; without headers,
     the selected survey format is interpreted positionally. */
  if(!excelHeaders.length)return;
  var fmt=$('excelFormat')?$('excelFormat').value:'PENZD';
  var hm=$('excelHeaderMode')?$('excelHeaderMode').value:'YES';
  var note='Format: '+fmt+' — automatic column detection';
  if(hm==='NO')note+=' — positional/raw data';
  if($('excelStatus')&&excelWorkbook)$('excelStatus').setAttribute('data-mapping',note);
}
function applyExcelFormat(){setupExcelMapping();}
function excelCurrentRows(){return excelRows||[];}
function excelCell(row,idx){return idx>=0?row[idx]:'';}
/* V481: robust numeric parsing for Excel cells exported with Persian/Arabic digits,
   localized decimal separators, or non-breaking spaces. */
function excelNum(v){
 if(typeof v==='number')return isFinite(v)?v:NaN;
 var s=String(v==null?'':v).trim();if(!s)return NaN;
 var fa='۰۱۲۳۴۵۶۷۸۹',ar='٠١٢٣٤٥٦٧٨٩';
 s=s.replace(/[۰-۹]/g,function(c){return String(fa.indexOf(c));}).replace(/[٠-٩]/g,function(c){return String(ar.indexOf(c));});
 s=s.replace(/[٬   ]/g,'');
 /* Treat comma as decimal when it is the only separator; otherwise as thousands separator. */
 if(s.indexOf(',')>=0&&s.indexOf('.')<0){var parts=s.split(',');s=parts.length===2&&parts[1].length!==3?parts[0]+'.'+parts[1]:parts.join('');}
 else s=s.replace(/,/g,'');
 s=s.replace(/[٫]/g,'.').replace(/[−–]/g,'-');
 var n=Number(s);return isFinite(n)?n:NaN;
}
var excelWorkMode='TABLE';
function excelResolveMode(){
 var requested=$('excelViewMode')?$('excelViewMode').value:'AUTO';
 if(requested==='TABLE')return 'TABLE';
 if(requested==='SURVEY')return 'SURVEY';
 /* AUTO is intentionally conservative: only explicit Easting/X AND Northing/Y
    headers classify a workbook as surveying. Ordinary numeric ledgers stay tables. */
 var hasE=false,hasN=false;
 for(var i=0;i<excelHeaders.length;i++){var role=excelHeaderRole(excelHeaders[i]||'');if(role==='E')hasE=true;if(role==='N')hasN=true;}
 return hasE&&hasN?'SURVEY':'TABLE';
}
function excelSetModeUI(){
 var table=excelWorkMode==='TABLE',actions=$('excelTableActions');
 if(actions)actions.style.display=table?'block':'none';
 var note=$('m6eOutputStatus');if(note)note.textContent=table?'حالت اکسل معمولی فعال است؛ جدول اصلی بدون تبدیل PENZD نمایش داده می‌شود.':'حالت نقشه‌برداری فعال است؛ خروجی‌ها از داده‌های تشخیص‌داده‌شده ساخته می‌شوند.';
 var ids=['excelOutStandard','excelOutPDF','excelOutPENZD','excelOutPNEZD','excelOutNEZ','excelOutENZ','excelOutLEICA','excelOutKML','excelOutKMZ','excelOutDXF','excelOutLandXML','excelOutGeoJSON','excelOutCode','excelOutJSON','excelOutTXT'];
 for(var j=0;j<ids.length;j++){var b=$(ids[j]);if(b)b.disabled=table;}
 var x=$('excelOutXLSX'),xl=$('excelOutXLS'),csv=$('excelOutCSV');
 if(x)x.disabled=table?false:!(typeof points!=='undefined'&&points.length);
 if(xl)xl.disabled=table?true:!(typeof points!=='undefined'&&points.length);
 if(csv)csv.disabled=table?true:!(typeof points!=='undefined'&&points.length);
}
function applyExcelViewMode(){
 if(!excelWorkbook)return false;
 excelWorkMode=excelResolveMode();
 if(excelWorkMode==='SURVEY'){
   previewExcelRows();var parsed=excelRowsToPoints();
   if(parsed.points&&parsed.points.length){importExcelPoints(true);setExcelOutputsEnabled(true);}
   if($('excelStatus'))$('excelStatus').textContent='حالت نقشه‌برداری فعال شد؛ '+(parsed.points?parsed.points.length:0)+' نقطه شناسایی شد.';
 }else{
   if($('excelPreview'))excelRenderTablePreview();
   setExcelOutputsEnabled(false);excelSetModeUI();
   if($('excelStatus'))$('excelStatus').textContent='حالت اکسل معمولی فعال شد؛ اطلاعات اصلی بدون تبدیل به نقاط نمایش داده می‌شود.';
 }
 m6eSync();return false;
}
function excelRenderTablePreview(){
 var box=$('excelPreview');if(!box)return;
 var rows=excelRows||[],heads=excelHeaders||[],maxCols=heads.length;
 for(var i=0;i<rows.length;i++)maxCols=Math.max(maxCols,(rows[i]||[]).length);
 var html='<div class="m6e-note"><b>نمایش اکسل معمولی</b><br>ساختار و ترتیب ستون‌ها حفظ شده است. هیچ داده‌ای به PENZD تبدیل نمی‌شود.<br><small>'+rows.length+' ردیف داده | '+maxCols+' ستون | '+(excelWorkbook&&excelWorkbook.SheetNames?excelWorkbook.SheetNames.length:0)+' Sheet</small></div><div class="m6e-table-scroll"><table><thead><tr>';
 for(var c=0;c<maxCols;c++)html+='<th>'+escapeHTML(String(heads[c]||('ستون '+(c+1))))+'</th>';
 html+='<th class="m6e-row-actions-head">عملیات</th></tr></thead><tbody>';
 var limit=Math.min(rows.length,250);
 for(var r=0;r<limit;r++){
  html+='<tr>';
  for(var k=0;k<maxCols;k++){var val=rows[r]&&rows[r][k]!=null?rows[r][k]:'';html+='<td>'+escapeHTML(String(val))+'</td>';}
  html+='<td class="m6e-row-actions-cell"><button type="button" class="m6e-row-action" onclick="return m6eEditRow('+r+');">✎ ویرایش</button><button type="button" class="m6e-row-action delete" onclick="return m6eDeleteRow('+r+');">حذف</button></td></tr>';
 }
 html+='</tbody></table></div><div class="subtitle m6e-preview-note">'+rows.length+' ردیف'+(rows.length>limit?' — نمایش '+limit+' ردیف اول':'')+'</div>';
 box.innerHTML=html;
 if($('m6eReviewStatus'))$('m6eReviewStatus').textContent='جدول اصلی آماده مشاهده است؛ هر ردیف از همین‌جا قابل ویرایش یا حذف است.';
 excelSetModeUI();
}
function excelExportOriginalWorkbook(){
 if(!excelWorkbook||typeof XLSX==='undefined'){showToast('فایل اکسل فعالی وجود ندارد');return false;}
 try{var out=XLSX.write(excelWorkbook,{bookType:'xlsx',type:'array'});var f=$('excelFile')&&$('excelFile').files[0],base=f?f.name.replace(/\.(xlsx|xls|csv)$/i,''):'MiladGeo_Table';var blob=new Blob([out],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});saveBlobLikeMenu17(base+'_original.xlsx',blob);showToast('فایل Excel اصلی آماده شد ✓');}catch(e){console.error('EXCEL_TABLE_EXPORT',e);showToast('خروجی Excel ناموفق بود');}return false;
}
function excelExportCurrentCSV(){
 if(!excelWorkbook||typeof XLSX==='undefined'){showToast('فایل اکسل فعالی وجود ندارد');return false;}
 try{var name=$('excelSheet')?$('excelSheet').value:excelWorkbook.SheetNames[0],ws=excelWorkbook.Sheets[name];var csv=XLSX.utils.sheet_to_csv(ws,{FS:',',RS:'\r\n'});var blob=new Blob(['\ufeff',csv],{type:'text/csv;charset=utf-8'});var f=$('excelFile')&&$('excelFile').files[0],base=f?f.name.replace(/\.(xlsx|xls|csv)$/i,''):'MiladGeo_Table';saveBlobLikeMenu17(base+'_'+name+'.csv',blob);showToast('CSV آماده شد ✓');}catch(e){console.error('EXCEL_CSV_EXPORT',e);showToast('خروجی CSV ناموفق بود');}return false;
}
function switchExcelSheet(){
 if(!excelWorkbook)return false;
 try{
  var name=$('excelSheet').value;
  var ws=excelWorkbook.Sheets[name];
  if(!ws)throw new Error('Sheet not found');
  var raw=XLSX.utils.sheet_to_json(ws,{header:1,defval:'',raw:true});
  if(!raw.length){excelHeaders=[];excelRows=[];if($('excelStatus'))$('excelStatus').textContent='Sheet انتخاب‌شده خالی است.';return false;}
  var hm=$('excelHeaderMode')?$('excelHeaderMode').value:'YES';
  if(hm==='NO'){excelHeaders=(raw[0]||[]).map(function(v,i){return 'COL_'+(i+1);});excelRows=raw;}
  else{excelHeaders=(raw[0]||[]).map(function(v,i){return String(v==null||v===''?'COL_'+(i+1):v);});excelRows=raw.slice(1);}
  setupExcelMapping();
  excelWorkMode=excelResolveMode();
  if(excelWorkMode==='TABLE')excelRenderTablePreview();else previewExcelRows();
  if($('m6eReviewStatus'))$('m6eReviewStatus').textContent=excelWorkMode==='TABLE'?'جدول معمولی خوانده شد؛ پیش‌نمایش آماده است.':'فایل نقشه‌برداری خوانده شد؛ پیش‌نمایش PENZD آماده است.';
  m6eSync();
  return true;
 }catch(e){
  console.error('EXCEL_SHEET',e);
  if($('excelStatus'))$('excelStatus').textContent='خطا در خواندن Sheet: '+(e.message||String(e));
  return false;
 }
}

function detectCSVDelimiter(data){try{var txt=new TextDecoder('utf-8').decode(data).replace(/^\uFEFF/,'');var lines=txt.split(/\r?\n/).filter(function(x){return x.trim()!=='';}).slice(0,8);var ds=[',',';','\t','|'];var best=',',bestScore=-1;for(var d=0;d<ds.length;d++){var sep=ds[d],score=0;for(var i=0;i<lines.length;i++){var c=0,inQ=false;for(var j=0;j<lines[i].length;j++){var ch=lines[i][j];if(ch==='\"'){inQ=!inQ;}else if(ch===sep&&!inQ)c++;}score+=c;}if(score>bestScore){bestScore=score;best=sep;}}return bestScore>0?best:',';}catch(e){return ',';}}
function loadExcelFile(){
 var f=$('excelFile')&&$('excelFile').files[0];
 if(!f){showToast('فایل Excel را انتخاب کن');return false;}
 if(typeof XLSX==='undefined' || !window.XLSX || typeof window.XLSX.read!=='function' || !window.XLSX.utils || typeof window.XLSX.utils.sheet_to_json!=='function'){
  if(typeof window.ensureMiladGeoXLSX==='function'&&!excelEngineLoading){
   excelEngineLoading=true;
   if($('excelStatus'))$('excelStatus').textContent='در حال راه‌اندازی موتور پشتیبان Excel...';
   window.ensureMiladGeoXLSX().then(function(engine){
    excelEngineLoading=false;
    if(!engine||!engine.read||!engine.utils||!engine.utils.sheet_to_json){if($('excelStatus'))$('excelStatus').textContent='موتور Excel بارگذاری نشد؛ فایل اصلی تغییر نکرده است.';showToast('موتور Excel در دسترس نیست');return;}
    window.XLSX=engine;
    try{XLSX=engine;}catch(assignErr){}
    loadExcelFile();
   }).catch(function(engineErr){excelEngineLoading=false;console.error('M6_XLSX_FALLBACK',engineErr);if($('excelStatus'))$('excelStatus').textContent='راه‌اندازی موتور Excel ناموفق بود: '+(engineErr.message||engineErr);showToast('خطا در راه‌اندازی Excel');});
   return false;
  }
  if($('excelStatus'))$('excelStatus').textContent='موتور Excel در دسترس نیست؛ اتصال یا بسته آفلاین را بررسی کن.';
  showToast('Excel engine unavailable');return false;
 }
 if($('excelStatus'))$('excelStatus').textContent='در حال خواندن فایل...';
 try{
  var reader=new FileReader();
  reader.onload=function(e){
   try{
    var data=new Uint8Array(e.target.result);
    excelDelimiter=/\.csv$/i.test(f.name)?detectCSVDelimiter(data):',';
    excelWorkbook=XLSX.read(data,{type:'array',cellDates:false,FS:excelDelimiter});
    var names=excelWorkbook.SheetNames||[];
    if(!names.length)throw new Error('No sheets');
    var sel=$('excelSheet');
    if(!sel)throw new Error('Excel sheet control not found');
    sel.innerHTML='';
    names.forEach(function(n){var o=document.createElement('option');o.value=n;o.textContent=n;sel.appendChild(o);});
    $('excelControls').style.display='block';
    if($('excelOutputs'))$('excelOutputs').style.display='block';
    switchExcelSheet();
    /* Dual-mode reader: ordinary workbooks remain untouched tables;
       only explicit X/E + Y/N headers enter the surveying importer in AUTO mode. */
    excelWorkMode=excelResolveMode();
    if(excelWorkMode==='SURVEY'){
      var autoParsed=excelRowsToPoints();
      if(autoParsed.points&&autoParsed.points.length){importExcelPoints(true);setExcelOutputsEnabled(true);}
      else setExcelOutputsEnabled(false);
      excelSetModeUI();
      if($('excelStatus'))$('excelStatus').innerHTML='<span class="excel-ok">✓ فایل نقشه‌برداری خوانده شد؛ '+(autoParsed.points?autoParsed.points.length:0)+' نقطه شناسایی شد — '+names.length+' Sheet</span>';
      if($('m6eReviewStatus'))$('m6eReviewStatus').textContent=autoParsed.points&&autoParsed.points.length?'نقاط شناسایی شدند؛ پیش‌نمایش PENZD آماده است.':'فایل خوانده شد، اما ردیف مختصات معتبر پیدا نشد.';
      showToast(autoParsed.points&&autoParsed.points.length?'فایل نقشه‌برداری شناسایی شد ✓':'فایل خوانده شد؛ مختصات معتبر پیدا نشد');
    }else{
      setExcelOutputsEnabled(false);excelRenderTablePreview();excelSetModeUI();
      if($('excelStatus'))$('excelStatus').innerHTML='<span class="excel-ok">✓ فایل اکسل معمولی خوانده شد؛ '+excelRows.length+' ردیف و '+names.length+' Sheet — بدون تبدیل به PENZD</span>';
      if($('m6eReviewStatus'))$('m6eReviewStatus').textContent='جدول اصلی آماده مشاهده است؛ هیچ نقطه‌ای به پروژه اضافه نشده است.';
      showToast('اکسل معمولی خوانده شد ✓');
    }
    m6eSync();
   }catch(err){
    console.error('EXCEL_READ',err);
    if($('excelStatus'))$('excelStatus').innerHTML='<span class="excel-bad">خطا در خواندن Excel: '+escapeHTML(err.message||String(err))+'</span>';
    showToast('Excel read failed');
   }
  };
  reader.onerror=function(){if($('excelStatus'))$('excelStatus').textContent='خطا در بازکردن فایل.';showToast('خطا در خواندن فایل');};
  reader.readAsArrayBuffer(f);
 }catch(err){console.error('EXCEL_FILE',err);showToast('خطا در خواندن فایل');}
 return false;
}

/* V482: infer PENZD by whole-column patterns, never by digit-count alone for P or Z. */
var excelDetectedMapping=null;
function excelHeaderRole(h){
 var n=excelNorm(h).replace(/[آأإ]/g,'ا');
 if(/^(p|pt|point|pointno|pointnumber|pointid|station|stationid|counter|count|no|number|id|شماره|شمارنده|شماره‌نقطه|شمارهنقطه|نقطه|شناسه)$/.test(n))return 'P';
 if(/^(x|e|easting|east|xcoord|xcoordinate|مختصاتx|مختصاتشرقی|شرقی)$/.test(n))return 'E';
 if(/^(y|n|northing|north|ycoord|ycoordinate|مختصاتy|مختصاتشمالی|شمالی)$/.test(n))return 'N';
 if(/^(z|elevation|elev|height|level|rl|ارتفاع|تراز)$/.test(n))return 'Z';
 if(/^(dp|description|desc|code|pointcode|type|کد|شرح|توضیحات|توصیحات)$/.test(n))return 'D';
 return '';
}
function excelColumnStats(col,rows){
 var vals=[],nums=[],ints=[],uniq={},seq=0,inc=0,digits=[],diffs=[],i,v,n,prev;
 for(i=0;i<rows.length;i++){v=rows[i]&&rows[i][col]!=null?rows[i][col]:'';if(String(v).trim()==='')continue;vals.push(v);n=excelNum(v);if(isFinite(n)){nums.push(n);if(Math.abs(n-Math.round(n))<1e-9)ints.push(n);uniq[String(v).trim()]=1;}}
 for(i=0;i<ints.length;i++){var a=Math.abs(ints[i]);digits.push(a===0?1:String(Math.floor(a)).length);if(i){var d=ints[i]-ints[i-1];diffs.push(d);if(d>0)inc++;if(d===1)seq++;}}
 var sorted=nums.slice().sort(function(a,b){return a-b;}),median=sorted.length?sorted[Math.floor(sorted.length/2)]:NaN;
 var avgDigits=digits.length?digits.reduce(function(a,b){return a+b;},0)/digits.length:0,stepConsistency=0,medianStep=NaN;if(diffs.length){var absDiffs=diffs.map(function(x){return Math.abs(x);}).sort(function(a,b){return a-b;});medianStep=absDiffs[Math.floor(absDiffs.length/2)];var stepCounts={};for(i=0;i<diffs.length;i++){var sk=String(Math.round(diffs[i]*1000)/1000);stepCounts[sk]=(stepCounts[sk]||0)+1;}stepConsistency=Math.max.apply(null,Object.keys(stepCounts).map(function(k){return stepCounts[k];}))/diffs.length;}
 return {index:col,values:vals.length,nums:nums.length,numRatio:vals.length?nums.length/vals.length:0,intRatio:nums.length?ints.length/nums.length:0,uniqueRatio:ints.length?Object.keys(uniq).length/ints.length:0,seqRatio:ints.length>1?seq/(ints.length-1):0,incRatio:ints.length>1?inc/(ints.length-1):0,stepConsistency:stepConsistency,medianStep:medianStep,median:median,digits:avgDigits,unique:Object.keys(uniq).length};
}
function excelDetectColumns(){
 var rows=excelRows||[],headers=excelHeaders||[],count=headers.length;
 for(var ri=0;ri<rows.length;ri++)count=Math.max(count,(rows[ri]||[]).length);
 var stats=[],used={},map={P:-1,E:-1,N:-1,Z:-1,D:-1},source={},i,role;
 for(i=0;i<count;i++){
  stats[i]=excelColumnStats(i,rows);
  role=($('excelHeaderMode')&&$('excelHeaderMode').value==='YES')?excelHeaderRole(headers[i]||''):'';
  if(role&&map[role]===-1){map[role]=i;used[i]=true;source[role]='عنوان ستون';}
 }
 function best(candidates,scoreFn){var bi=-1,bs=-1e9;for(var k=0;k<candidates.length;k++){var ix=candidates[k],sc=scoreFn(stats[ix]);if(sc>bs){bs=sc;bi=ix;}}return bi;}
 var available=[];for(i=0;i<count;i++)if(!used[i]&&stats[i].values)available.push(i);
 /* P is identified by counter/sequence behaviour and uniqueness, not digit length. */
 if(map.P<0){var p=best(available,function(a){return 4*a.intRatio+3*a.uniqueRatio+4*a.seqRatio+1.5*a.incRatio-0.15*Math.max(0,a.digits-7);});if(p>=0&&stats[p].numRatio>=0.75&&stats[p].intRatio>=0.75&&stats[p].uniqueRatio>=0.55&&(stats[p].seqRatio>=0.5||(stats[p].stepConsistency>=0.85&&stats[p].medianStep<=100&&stats[p].digits<=5))){map.P=p;used[p]=true;source.P='الگوی شمارنده';}}
 available=[];for(i=0;i<count;i++)if(!used[i]&&stats[i].values)available.push(i);
 /* Coordinate columns: six-digit Easting and seven-digit Northing are clues, not hard rules. */
 if(map.E<0&&available.length){var e=best(available,function(a){var digitFit=Math.max(0,1-Math.abs(a.digits-6)/4);var mag=isFinite(a.median)?Math.max(0,1-Math.abs(Math.log10(Math.max(1,Math.abs(a.median)))-5.7)/2):0;return 3*a.numRatio+2*a.intRatio+2*digitFit+mag;});if(e>=0&&stats[e].numRatio>=0.65){map.E=e;used[e]=true;source.E='الگوی مختصات شرقی';}}
 available=[];for(i=0;i<count;i++)if(!used[i]&&stats[i].values)available.push(i);
 if(map.N<0&&available.length){var n=best(available,function(a){var digitFit=Math.max(0,1-Math.abs(a.digits-7)/4);var mag=isFinite(a.median)?Math.max(0,1-Math.abs(Math.log10(Math.max(1,Math.abs(a.median)))-6.5)/2):0;return 3*a.numRatio+2*a.intRatio+2*digitFit+mag;});if(n>=0&&stats[n].numRatio>=0.65){map.N=n;used[n]=true;source.N='الگوی مختصات شمالی';}}
 available=[];for(i=0;i<count;i++)if(!used[i]&&stats[i].values)available.push(i);
 /* Z is the remaining numeric measurement; its digit count is deliberately ignored. */
 if(map.Z<0&&available.length){var z=best(available,function(a){var magnitude=isFinite(a.median)?Math.abs(Math.log10(Math.max(1,Math.abs(a.median)))):99;return 4*a.numRatio+2*a.intRatio-0.55*magnitude;});if(z>=0&&stats[z].numRatio>=0.45){map.Z=z;used[z]=true;source.Z='ستون عددی باقی‌مانده / ارتفاع';}}
 available=[];for(i=0;i<count;i++)if(!used[i]&&stats[i].values)available.push(i);
 if(map.D<0&&available.length){var d=best(available,function(a){return 4*(1-a.numRatio)+a.values/Math.max(1,rows.length);});map.D=d;used[d]=true;source.D='متن / کد باقی‌مانده';}
 /* Positional format is a last-resort fallback only for roles still unresolved. */
 var fmt=$('excelFormat')?$('excelFormat').value:'PENZD',pos={PENZD:[0,1,2,3,4],PNEZD:[0,2,1,3,4],NEZD:[-1,1,0,2,3],ENZD:[-1,0,1,2,3]}[fmt]||[0,1,2,3,4];
 var roles=['P','E','N','Z','D'];
 for(i=0;i<roles.length;i++){role=roles[i];if(map[role]<0&&pos[i]>=0&&pos[i]<count&&!used[pos[i]]){map[role]=pos[i];used[pos[i]]=true;source[role]='ترتیب قالب انتخابی (پیشنهادی)';}}
 map.stats=stats;map.source=source;map.confidence=['P','E','N','Z'].filter(function(k){return map[k]>=0&&source[k]&&source[k]!=='ترتیب قالب انتخابی (پیشنهادی)';}).length;
 excelDetectedMapping=map;return map;
}
function excelMappingLabel(m){var names={P:'شماره نقطه',E:'X / E',N:'Y / N',Z:'ارتفاع Z',D:'توضیحات'};return ['P','E','N','Z','D'].map(function(k){var ix=m[k];return names[k]+': '+(ix>=0?String(excelHeaders[ix]||('ستون '+(ix+1)))+' ('+(ix+1)+')':'تولید/خالی');}).join('  |  ');}
function excelRowsToPoints(){
 var m=excelDetectColumns(),ciNo=m.P,ciX=m.E,ciY=m.N,ciZ=m.Z,ciDP=m.D,out=[],bad=0;
 for(var i=0;i<excelRows.length;i++){
  var r=excelRows[i]||[],x=excelNum(excelCell(r,ciX)),y=excelNum(excelCell(r,ciY)),z=ciZ>=0?excelNum(excelCell(r,ciZ)):0;
  if(!isFinite(x)||!isFinite(y)){if(r.some(function(v){return String(v).trim()!=='';}))bad++;continue;}
  if(!isFinite(z))z=0;
  var no=ciNo>=0?String(excelCell(r,ciNo)).trim():'';
  if(!no)no='P'+('000'+(getNextPointNumber()+out.length)).slice(-3);
  var dp=ciDP>=0?String(excelCell(r,ciDP)).trim():'';
  out.push({id:Date.now()+i+Math.floor(Math.random()*1000),no:no,dp:dp,x:x,y:y,z:z,distance:null,azimuth:null,excelImported:true,excelSourceRowIndex:i});
 }
 return {points:out,bad:bad,mapping:m,confidence:m.confidence};
}
function previewExcelRows(){
 if(excelWorkbook&&excelWorkMode==='TABLE'){excelRenderTablePreview();return;}
 var box=$('excelPreview');if(!box)return;
 var parsed=excelRowsToPoints(),a=parsed.points,m=parsed.mapping;
 var html='<div class="m6e-note" style="margin-bottom:8px"><b>تشخیص هوشمند ستون‌ها</b><br>'+escapeHTML(excelMappingLabel(m))+'<br><small>شماره نقطه با الگوی شمارنده تشخیص داده می‌شود؛ ارتفاع فقط از تعداد رقم تعیین نمی‌شود.</small></div><div class="m6e-table-scroll"><table><thead><tr><th>NO</th><th>X</th><th>Y</th><th>Z</th><th>DP</th><th class="m6e-row-actions-head">عملیات</th></tr></thead><tbody>';
 var n=Math.min(a.length,100);
 for(var i=0;i<n;i++){
  var p=a[i],ri=Number(p.excelSourceRowIndex);
  html+='<tr><td>'+escapeHTML(p.no)+'</td><td>'+p.x+'</td><td>'+p.y+'</td><td>'+p.z+'</td><td>'+escapeHTML(p.dp||'-')+'</td><td class="m6e-row-actions-cell"><button type="button" class="m6e-row-action" onclick="return m6eEditRow('+ri+');">✎ ویرایش</button><button type="button" class="m6e-row-action delete" onclick="return m6eDeleteRow('+ri+');">حذف</button></td></tr>';
 }
 html+='</tbody></table></div><div class="subtitle m6e-preview-note">'+a.length+' نقطه معتبر'+(parsed.bad?' — '+parsed.bad+' ردیف نامعتبر':'')+(a.length>100?' — نمایش ۱۰۰ ردیف اول':'')+'</div>';
 box.innerHTML=html;
 if($('m6eReviewStatus'))$('m6eReviewStatus').textContent='تشخیص ستون‌ها انجام شد؛ هر نقطه از همین‌جا قابل ویرایش یا حذف است.';
}

/* Indexxx94 · Menu 6 row editing, deletion, new project and FAB inset. */
var m6eManualCurrentMode='SURVEY';
var m6eManualEditIndex=-1;
var m6eManualCurrentMap=null;
var m6eManualCurrentCols=0;
function m6eManualEnsureSurveyBase(){
 if(!excelWorkbook&&!excelHeaders.length&&!excelRows.length){
  excelHeaders=['Point','X','Y','Z','Description'];
  excelRows=[];
  excelWorkMode='SURVEY';
  if($('excelHeaderMode'))$('excelHeaderMode').value='YES';
  if($('excelFormat'))$('excelFormat').value='PENZD';
  if($('excelViewMode'))$('excelViewMode').value='SURVEY';
 }
}
function m6eOpenManualEntry(editIndex){
 m6eManualEnsureSurveyBase();
 if(!excelWorkbook&&excelWorkMode!=='SURVEY'&&excelWorkMode!=='TABLE')excelWorkMode='SURVEY';
 m6eTab('review');
 m6eManualEditIndex=(typeof editIndex==='number'&&editIndex>=0&&editIndex<excelRows.length)?editIndex:-1;
 m6eManualCurrentMode=(excelWorkMode==='TABLE'&&(excelWorkbook||excelHeaders.length))?'TABLE':'SURVEY';
 var fields=$('m6eManualFields'),hint=$('m6eManualHint'),modal=$('m6eManualModal');
 if(!fields||!modal)return false;
 var html='',i,label,idx;
 if(m6eManualCurrentMode==='TABLE'){
  var count=(excelHeaders||[]).length;
  for(i=0;i<(excelRows||[]).length;i++)count=Math.max(count,(excelRows[i]||[]).length);
  m6eManualCurrentCols=count;
  if(!count){showToast('ابتدا یک جدول با ستون مشخص باز کن.');return false;}
  for(i=0;i<count;i++){
   label=String(excelHeaders[i]||('ستون '+(i+1)));
   if(/^COL_\d+$/i.test(label))label='ستون '+(i+1);
   html+='<label class="m6e-manual-field'+(count===1?' full':'')+'"><span>'+escapeHTML(label)+'</span><input type="text" id="m6eManualCell_'+i+'" data-m6e-index="'+i+'" autocomplete="off" dir="auto" placeholder="'+escapeHTML(label)+'"></label>';
  }
  if(hint)hint.textContent='حالت جدول معمولی: هر مقدار در ستون هم‌نام خودش ثبت می‌شود و ترتیب ستون‌ها تغییر نمی‌کند.';
 }else{
  m6eManualCurrentMap=excelDetectColumns();
  var m=m6eManualCurrentMap;
  m6eManualCurrentCols=Math.max((excelHeaders||[]).length,0);
  for(i=0;i<(excelRows||[]).length;i++)m6eManualCurrentCols=Math.max(m6eManualCurrentCols,(excelRows[i]||[]).length);
  var defs=[
   {role:'P',label:'شماره نقطه',placeholder:'مثلاً P001'},
   {role:'E',label:'مختصات X / Easting',placeholder:'مقدار X'},
   {role:'N',label:'مختصات Y / Northing',placeholder:'مقدار Y'},
   {role:'Z',label:'ارتفاع Z',placeholder:'مقدار ارتفاع'},
   {role:'D',label:'شرح / کد نقطه',placeholder:'مثلاً ROAD یا CURB'}
  ];
  for(i=0;i<defs.length;i++){
   idx=m[defs[i].role];
   if(idx<0){if(defs[i].role==='P')continue;}
   html+='<label class="m6e-manual-field'+(defs[i].role==='D'?' full':'')+'"><span>'+defs[i].label+(defs[i].role==='E'||defs[i].role==='N'?' *':'')+'</span><input type="text" id="m6eManualRole_'+defs[i].role+'" data-m6e-role="'+defs[i].role+'" data-m6e-index="'+idx+'" autocomplete="off" inputmode="'+(defs[i].role==='D'?'text':'decimal')+'" dir="auto" placeholder="'+defs[i].placeholder+'"'+((defs[i].role==='E'||defs[i].role==='N')?' required':'')+'></label>';
  }
  if(hint)hint.textContent='حالت نقشه‌برداری: X و Y الزامی‌اند؛ Z در صورت خالی بودن صفر ثبت می‌شود. داده پس از ثبت با تشخیص PENZD و موتور فعلی نقاط بررسی می‌شود.';
 }
 fields.innerHTML=html;
 if(m6eManualEditIndex>=0){
  var existing=excelRows[m6eManualEditIndex]||[];
  if(m6eManualCurrentMode==='TABLE'){
   for(i=0;i<m6eManualCurrentCols;i++){var editCell=$('m6eManualCell_'+i);if(editCell)editCell.value=existing[i]==null?'':String(existing[i]);}
  }else{
   var em=m6eManualCurrentMap||excelDetectColumns();
   var roleIndexes={P:em.P,E:em.E,N:em.N,Z:em.Z,D:em.D};
   for(var role in roleIndexes){if(Object.prototype.hasOwnProperty.call(roleIndexes,role)&&roleIndexes[role]>=0){var roleEl=$('m6eManualRole_'+role);if(roleEl)roleEl.value=existing[roleIndexes[role]]==null?'':String(existing[roleIndexes[role]]);}}
  }
 }
 var title=$('m6eManualTitle'),saveBtn=$('m6eManualSaveBtn');
 if(title)title.textContent=m6eManualEditIndex>=0?'ویرایش اطلاعات ردیف':'افزودن دستی به جدول';
 if(saveBtn)saveBtn.textContent=m6eManualEditIndex>=0?'ذخیره ویرایش':'ثبت در جدول';
 modal.style.display='flex';
 var first=fields.querySelector('input');if(first){try{first.focus({preventScroll:true});}catch(e){first.focus();}}
 return false;
}
function m6eCloseManualEntry(){var modal=$('m6eManualModal');if(modal)modal.style.display='none';return false;}
function m6eManualBackdropClose(ev){if(ev&&ev.target===ev.currentTarget)return m6eCloseManualEntry();return false;}
function m6eAppendManualRowToWorkbook(row,numericIndexes){
 if(!excelWorkbook||typeof XLSX==='undefined')return;
 try{
  var name=$('excelSheet')?$('excelSheet').value:(excelWorkbook.SheetNames||[])[0];
  var ws=excelWorkbook.Sheets[name];if(!ws)return;
  var range=ws['!ref']?XLSX.utils.decode_range(ws['!ref']):{s:{r:0,c:0},e:{r:-1,c:-1}};
  var targetRow=range.e.r+1;if(targetRow<0)targetRow=0;
  var maxCols=Math.max(row.length,(excelHeaders||[]).length);
  for(var c=0;c<maxCols;c++){
   var value=row[c]==null?'':row[c];
   if(value==='')continue;
   var address=XLSX.utils.encode_cell({r:targetRow,c:c});
   if(numericIndexes&&numericIndexes.indexOf(c)>=0){
    var number=excelNum(value);if(!isFinite(number))continue;
    ws[address]={t:'n',v:number};
   }else ws[address]={t:'s',v:String(value)};
  }
  if(range.e.r<targetRow)range.e.r=targetRow;
  if(range.e.c<maxCols-1)range.e.c=maxCols-1;
  if(range.e.r>=0&&range.e.c>=0)ws['!ref']=XLSX.utils.encode_range(range);
 }catch(e){console.warn('M6E_MANUAL_WORKBOOK_SYNC',e);}
}
function m6eWorkbookSheet(){
 if(!excelWorkbook||typeof XLSX==='undefined')return null;
 var name=$('excelSheet')?$('excelSheet').value:(excelWorkbook.SheetNames||[])[0];
 return excelWorkbook.Sheets[name]||null;
}
function m6eWorkbookRowNumber(dataIndex){
 var headerMode=$('excelHeaderMode')?$('excelHeaderMode').value:'YES';
 return dataIndex+(headerMode==='YES'?1:0);
}
function m6eWriteWorkbookRow(dataIndex,row){
 var ws=m6eWorkbookSheet();if(!ws||typeof XLSX==='undefined')return;
 try{
  var rr=m6eWorkbookRowNumber(dataIndex),max=Math.max(row.length,(excelHeaders||[]).length),range=ws['!ref']?XLSX.utils.decode_range(ws['!ref']):{s:{r:0,c:0},e:{r:rr,c:max-1}};
  for(var c=0;c<max;c++){
   var addr=XLSX.utils.encode_cell({r:rr,c:c}),v=row[c]==null?'':row[c],old=ws[addr];
   if(String(v).trim()===''){delete ws[addr];continue;}
   if(old&&old.t==='n'&&isFinite(excelNum(v)))ws[addr]={t:'n',v:excelNum(v)};
   else if(m6eManualCurrentMode==='SURVEY'){
    var map=excelDetectColumns();
    if((c===map.E||c===map.N||c===map.Z)&&String(v).trim()!==''&&isFinite(excelNum(v)))ws[addr]={t:'n',v:excelNum(v)};
    else ws[addr]={t:'s',v:String(v)};
   }else ws[addr]={t:'s',v:String(v)};
  }
  if(rr>range.e.r)range.e.r=rr;
  if(max-1>range.e.c)range.e.c=max-1;
  ws['!ref']=XLSX.utils.encode_range(range);
 }catch(e){console.warn('M6E_WORKBOOK_ROW_UPDATE',e);}
}
function m6eDeleteWorkbookRow(dataIndex){
 var ws=m6eWorkbookSheet();if(!ws||typeof XLSX==='undefined')return;
 try{
  var target=m6eWorkbookRowNumber(dataIndex),moves=[],keys=Object.keys(ws),range=ws['!ref']?XLSX.utils.decode_range(ws['!ref']):null;
  for(var i=0;i<keys.length;i++){
   var key=keys[i];if(key.charAt(0)==='!')continue;
   var cell=XLSX.utils.decode_cell(key);
   if(cell.r===target)delete ws[key];
   else if(cell.r>target){moves.push({oldKey:key,newKey:XLSX.utils.encode_cell({r:cell.r-1,c:cell.c}),value:ws[key]});delete ws[key];}
  }
  for(i=0;i<moves.length;i++)ws[moves[i].newKey]=moves[i].value;
  if(range){range.e.r=Math.max(range.s.r,range.e.r-1);ws['!ref']=XLSX.utils.encode_range(range);}
 }catch(e){console.warn('M6E_WORKBOOK_ROW_DELETE',e);}
}
function m6eRefreshMainPoints(){
 window.points=points;
 saveJSON(POINTS_KEY,points);
 refreshPoints();updateAllUI();
 try{window.m4pRender&&window.m4pRender();window.m4pRenderControl&&window.m4pRenderControl();window.m4pRenderStats&&window.m4pRenderStats();}catch(e){}
}
function m6eRemoveImportedSurveyRow(rowIndex,shiftAfter){
 var removed=false,kept=[],tracked=excelImportedIds||[];
 for(var i=0;i<points.length;i++){
  var p=points[i],trackedPoint=p&&tracked.indexOf(p.id)>=0;
  if(trackedPoint&&p.excelImported&&p.excelSourceRowIndex===rowIndex){removed=true;continue;}
  if(shiftAfter&&trackedPoint&&p.excelImported&&typeof p.excelSourceRowIndex==='number'&&p.excelSourceRowIndex>rowIndex)p.excelSourceRowIndex--;
  kept.push(p);
 }
 points=kept;
 if(removed){
  var still=[];for(i=0;i<tracked.length;i++){var found=false;for(var j=0;j<points.length;j++)if(points[j].id===tracked[i]){found=true;break;}if(found)still.push(tracked[i]);}
  excelImportedIds=still;
  m6eRefreshMainPoints();
 }
 return removed;
}
function m6eSyncImportedSurveyRow(rowIndex){
 var wasImported=m6eRemoveImportedSurveyRow(rowIndex,false);
 if(!wasImported)return false;
 var parsed=excelRowsToPoints(),fresh=null;
 for(var i=0;i<parsed.points.length;i++)if(parsed.points[i].excelSourceRowIndex===rowIndex){fresh=parsed.points[i];break;}
 if(fresh){
  var no=String(fresh.no||'').trim().toUpperCase(),coord=[Number(fresh.x).toFixed(6),Number(fresh.y).toFixed(6),Number(fresh.z).toFixed(6)].join('|'),duplicate=false;
  for(i=0;i<points.length;i++){
   var p=points[i],pno=String(p.no||'').trim().toUpperCase(),pc=[Number(p.x).toFixed(6),Number(p.y).toFixed(6),Number(p.z).toFixed(6)].join('|');
   if((no&&pno===no)||pc===coord){duplicate=true;break;}
  }
  if(!duplicate){fresh.id=Date.now()+Math.floor(Math.random()*100000);points.push(fresh);excelImportedIds.push(fresh.id);}
 }
 m6eRefreshMainPoints();return true;
}
function m6eEditRow(rowIndex){return m6eOpenManualEntry(Number(rowIndex));}
function m6eDeleteRow(rowIndex){
 rowIndex=Number(rowIndex);
 if(!isFinite(rowIndex)||rowIndex<0||rowIndex>=excelRows.length)return false;
 if(!window.confirm('این ردیف از جدول حذف شود؟ این کار قابل بازگشت نیست.'))return false;
 if(excelWorkMode==='SURVEY')m6eRemoveImportedSurveyRow(rowIndex,true);
 m6eDeleteWorkbookRow(rowIndex);
 excelRows.splice(rowIndex,1);
 if(excelWorkMode==='TABLE')excelRenderTablePreview();else previewExcelRows();
 excelSetModeUI();m6eSync();
 if($('m6eReviewStatus'))$('m6eReviewStatus').textContent='ردیف انتخاب‌شده حذف شد.';
 showToast('ردیف حذف شد ✓');return false;
}
function m6eCreateNewProject(){
 if(!window.confirm('اطلاعات جدول فعلی پاک شود و یک جدول / پروژه خالی ساخته شود؟\\nاین عملیات قابل بازگشت نیست.'))return false;
 var wasTable=excelWorkMode==='TABLE',headers=(excelHeaders||[]).slice();
 var tracked=(excelImportedIds||[]).slice(),kept=[];
 for(var i=0;i<points.length;i++)if(tracked.indexOf(points[i]&&points[i].id)<0)kept.push(points[i]);
 if(kept.length!==points.length){points=kept;m6eRefreshMainPoints();}
 excelImportedIds=[];
 excelRows=[];excelWorkbook=null;excelDelimiter=',';
 var excelFileInput=$('excelFile');if(excelFileInput)excelFileInput.value='';
 if(wasTable&&headers.length&&typeof XLSX!=='undefined'&&XLSX.utils&&XLSX.utils.book_new){
  excelHeaders=headers;
  excelWorkbook=XLSX.utils.book_new();
  var freshSheet=XLSX.utils.aoa_to_sheet([headers]);
  XLSX.utils.book_append_sheet(excelWorkbook,freshSheet,'Sheet1');
  excelWorkbook.SheetNames=['Sheet1'];
  if($('excelSheet')){$('excelSheet').innerHTML='<option value="Sheet1">Sheet1</option>';$('excelSheet').value='Sheet1';}
  excelWorkMode='TABLE';
  if($('excelHeaderMode'))$('excelHeaderMode').value='YES';
  if($('excelViewMode'))$('excelViewMode').value='TABLE';
  if($('excelControls'))$('excelControls').style.display='block';
  excelRenderTablePreview();
 }else{
  excelHeaders=['Point','X','Y','Z','Description'];
  excelWorkMode='SURVEY';
  if($('excelViewMode'))$('excelViewMode').value='SURVEY';
  if($('excelFormat'))$('excelFormat').value='PENZD';
  if($('excelHeaderMode'))$('excelHeaderMode').value='YES';
  if($('excelControls'))$('excelControls').style.display='none';
  previewExcelRows();
 }
 if($('excelStatus'))$('excelStatus').textContent='پروژه جدید آماده ورود اطلاعات است.';
 if($('m6eReviewStatus'))$('m6eReviewStatus').textContent='جدول خالی جدید ساخته شد؛ با دکمه + اطلاعات تازه وارد کن.';
 setExcelOutputsEnabled(false);excelSetModeUI();m6eSync();
 showToast('جدول / پروژه جدید آماده است ✓');return false;
}
function m6eSaveManualRow(){
 var row=[],numericIndexes=[],i,hasValue=false,editing=m6eManualEditIndex>=0;
 if(m6eManualCurrentMode==='TABLE'){
  for(i=0;i<m6eManualCurrentCols;i++){
   var cell=$('m6eManualCell_'+i),value=cell?String(cell.value||'').trim():'';
   row[i]=value;if(value!=='')hasValue=true;
  }
  if(!hasValue){showToast('حداقل یک مقدار در ردیف وارد کن.');return false;}
  if(editing){excelRows[m6eManualEditIndex]=row;m6eWriteWorkbookRow(m6eManualEditIndex,row);}
  else{excelRows.push(row);m6eAppendManualRowToWorkbook(row,[]);}
  excelRenderTablePreview();excelSetModeUI();m6eSync();
  if($('m6eReviewStatus'))$('m6eReviewStatus').textContent=editing?'ویرایش ردیف در جدول ذخیره شد.':'یک ردیف دستی به جدول اصلی اضافه شد؛ ساختار ستون‌ها حفظ شده است.';
  m6eManualEditIndex=-1;m6eCloseManualEntry();showToast(editing?'ویرایش ردیف ذخیره شد ✓':'ردیف دستی به جدول اضافه شد ✓');
  return false;
 }
 var m=m6eManualCurrentMap||excelDetectColumns();
 var xField=$('m6eManualRole_E'),yField=$('m6eManualRole_N'),zField=$('m6eManualRole_Z'),pField=$('m6eManualRole_P'),dField=$('m6eManualRole_D');
 var x=excelNum(xField?xField.value:''),y=excelNum(yField?yField.value:''),zText=zField?String(zField.value||'').trim():'',z=zText===''?0:excelNum(zText);
 if(!isFinite(x)||!isFinite(y)){showToast('مختصات X و Y را به‌صورت عددی وارد کن.');return false;}
 if(!isFinite(z)){showToast('مقدار ارتفاع Z معتبر نیست.');return false;}
 var maxCols=Math.max(m6eManualCurrentCols,(excelHeaders||[]).length);
 for(i=0;i<(excelRows||[]).length;i++)maxCols=Math.max(maxCols,(excelRows[i]||[]).length);
 for(i=0;i<maxCols;i++)row[i]='';
 var no=pField?String(pField.value||'').trim():'';
 if(!no&&m.P>=0)no='P'+('000'+getNextPointNumber()).slice(-3);
 if(m.P>=0)row[m.P]=no;
 if(m.E<0||m.N<0){showToast('ستون‌های X و Y در قالب فعلی پیدا نشدند؛ قالب PENZD را انتخاب کن.');return false;}
 row[m.E]=x;row[m.N]=y;numericIndexes.push(m.E,m.N);
 if(m.Z>=0){row[m.Z]=z;numericIndexes.push(m.Z);}
 if(m.D>=0)row[m.D]=dField?String(dField.value||'').trim():'';
 if(!row.some(function(v){return String(v==null?'':v).trim()!=='';})){showToast('اطلاعات ردیف خالی است.');return false;}
 if(editing){excelRows[m6eManualEditIndex]=row;m6eWriteWorkbookRow(m6eManualEditIndex,row);}
 else{excelRows.push(row);m6eAppendManualRowToWorkbook(row,numericIndexes);}
 if(editing)m6eSyncImportedSurveyRow(m6eManualEditIndex);
 else{var parsed=excelRowsToPoints();if(parsed.points&&parsed.points.length){importExcelPoints(true);setExcelOutputsEnabled(true);}}
 previewExcelRows();excelSetModeUI();m6eSync();
 if($('m6eReviewStatus'))$('m6eReviewStatus').textContent=editing?'ویرایش مختصات در جدول ذخیره شد و نقطه واردشده نیز همگام‌سازی شد.':'مختصات دستی به جدول بررسی افزوده شد و از مسیر اصلی PENZD پردازش شد.';
 if($('excelStatus'))$('excelStatus').textContent=editing?'ویرایش مختصات ذخیره شد.':'ردیف مختصات دستی به داده‌های Excel اضافه شد.';
 m6eManualEditIndex=-1;m6eCloseManualEntry();showToast(editing?'ویرایش مختصات ذخیره شد ✓':'مختصات دستی به بررسی اضافه شد ✓');
 return false;
}

/* Expose the modal actions: Menu 6 is inside the app's main IIFE,
   while the HTML controls use inline onclick handlers. */
window.m6eOpenManualEntry=m6eOpenManualEntry;
window.m6eCloseManualEntry=m6eCloseManualEntry;
window.m6eManualBackdropClose=m6eManualBackdropClose;
window.m6eSaveManualRow=m6eSaveManualRow;
window.m6eEditRow=m6eEditRow;
window.m6eDeleteRow=m6eDeleteRow;
window.m6eCreateNewProject=m6eCreateNewProject;

function setExcelOutputsEnabled(enabled){
 var ids=['excelOutStandard','excelOutPDF','excelOutPENZD','excelOutPNEZD','excelOutNEZ','excelOutENZ','excelOutCSV','excelOutLEICA','excelOutKML','excelOutKMZ','excelOutXLSX','excelOutXLS','excelOutDXF','excelOutLandXML','excelOutGeoJSON','excelOutCode','excelOutJSON','excelOutTXT'];
 for(var i=0;i<ids.length;i++){var b=$(ids[i]);if(b)b.disabled=!enabled;}
 var box=$('excelOutputs');if(box)box.classList.toggle('excel-ready',!!enabled);
}
function importExcelPoints(silent){
 silent=!!silent;
 var parsed=excelRowsToPoints(),a=parsed.points;
 if(!a.length){if(!silent)showToast('No valid X / Y rows found');return false;}
 /* V479: Excel import is additive. Preview never changes MAIN POINT LIST.
    A row is duplicate only when its point number OR its exact X/Y/Z already exists.
    New rows are always appended and immediately saved/refreshed. */
 var existingNo={},existingCoord={},seenNo={},seenCoord={},clean=[];
 for(var ei=0;ei<points.length;ei++){
   var ep=points[ei],eno=String(ep.no||'').trim().toUpperCase();
   var ecoord=[Number(ep.x).toFixed(6),Number(ep.y).toFixed(6),Number(ep.z).toFixed(6)].join('|');
   if(eno)existingNo[eno]=true;
   existingCoord[ecoord]=true;
 }
 for(var di=0;di<a.length;di++){
   var ap0=a[di],no0=String(ap0.no||'').trim().toUpperCase();
   var coord0=[Number(ap0.x).toFixed(6),Number(ap0.y).toFixed(6),Number(ap0.z).toFixed(6)].join('|');
   if((no0&&seenNo[no0])||seenCoord[coord0])continue;
   seenNo[no0]=true;seenCoord[coord0]=true;clean.push(ap0);
 }
 a=clean;
 var added=0,dupes=0,conflicts=0;
 for(var i=0;i<a.length;i++){
   var ap=a[i],noKey=String(ap.no||'').trim().toUpperCase();
   var coordKey=[Number(ap.x).toFixed(6),Number(ap.y).toFixed(6),Number(ap.z).toFixed(6)].join('|');
   if(existingCoord[coordKey]){dupes++;continue;}
   if(noKey&&existingNo[noKey]){conflicts++;continue;}
   points.push(ap);
   excelImportedIds.push(ap.id);
   if(noKey)existingNo[noKey]=true;
   existingCoord[coordKey]=true;
   added++;
 }
 window.points=points;
 if(added>0)saveJSON(POINTS_KEY,points);
 refreshPoints();updateAllUI();
 try{window.m4pRender&&window.m4pRender();window.m4pRenderControl&&window.m4pRenderControl();window.m4pRenderStats&&window.m4pRenderStats();}catch(e){}
 setExcelOutputsEnabled(true);
 if($('excelOutputs'))$('excelOutputs').style.display='block';
 if(typeof m6eSync==='function')m6eSync();
 if(added){
   if($('excelStatus'))$('excelStatus').innerHTML='<span class="excel-ok">✓ '+added+' نقطه جدید به MAIN POINT LIST اضافه شد'+(dupes?' — '+dupes+' تکراری':'')+(conflicts?' — '+conflicts+' شماره تکراری':'')+(parsed.bad?' — '+parsed.bad+' ردیف نامعتبر':'')+'</span>';
   if(!silent)showToast(added+' نقطه جدید وارد شد ✓'+(dupes?' — '+dupes+' تکراری':'')+(conflicts?' — '+conflicts+' شماره تکراری':''));
 }else{
   if($('excelStatus'))$('excelStatus').innerHTML='<span class="excel-ok">✓ نقطه جدیدی برای افزودن باقی نمانده است'+(dupes?' — '+dupes+' تکراری':'')+(conflicts?' — '+conflicts+' شماره تکراری':'')+'</span>';
   if(!silent)showToast('نقطه جدیدی وارد نشد — تکراری یا شماره تکراری');
 }
 return false;
}
function clearExcelImport(){excelWorkbook=null;excelRows=[];excelHeaders=[];excelImportedIds=[];excelWorkMode='TABLE';excelDelimiter=',';if($('excelFile'))$('excelFile').value='';if($('excelControls'))$('excelControls').style.display='none';setExcelOutputsEnabled(false);if($('excelOutputs'))$('excelOutputs').style.display='block';if($('excelPreview'))$('excelPreview').innerHTML='';if($('excelTableActions'))$('excelTableActions').style.display='none';if($('excelStatus'))$('excelStatus').textContent='فایل Excel را انتخاب کن.';m6eSync();}
function uniquePointRecords(arr){var out=[],seen={},i,p,sig;for(i=0;i<(arr||[]).length;i++){p=arr[i]||{};sig=String(p.no||'').trim().toUpperCase()+'|'+p.x+'|'+p.y+'|'+p.z+'|'+String(p.dp||'').trim().toUpperCase();if(!seen[sig]){seen[sig]=true;out.push(p);}}return out;}
function downloadImportedPointListPDF(){
 /* V200: Excel menu does NOT build its own PDF. Once Excel points are imported,
    they live in the same MAIN POINT LIST and use the same central PDF engine. */
 return miladgeoPointListPDF();
}

function downloadImportedDXF(){return exportDXF();}
function downloadImportedKML(){return exportKML();}
function downloadImportedCSV(){return exportCSV();}
function downloadImportedTXT(){return exportTXT();}
window.loadExcelFile=loadExcelFile;window.switchExcelSheet=switchExcelSheet;window.previewExcelRows=previewExcelRows;window.importExcelPoints=importExcelPoints;window.clearExcelImport=clearExcelImport;window.applyExcelViewMode=applyExcelViewMode;window.excelExportOriginalWorkbook=excelExportOriginalWorkbook;window.excelExportCurrentCSV=excelExportCurrentCSV;window.downloadImportedPointListPDF=downloadImportedPointListPDF;window.downloadImportedDXF=downloadImportedDXF;window.downloadImportedKML=downloadImportedKML;window.downloadImportedCSV=downloadImportedCSV;window.downloadImportedTXT=downloadImportedTXT;

var cadEntities=[];
function dxfPairs(text){var a=text.replace(/\r/g,'').split('\n'),out=[];for(var i=0;i<a.length-1;i+=2){out.push({code:a[i].trim(),value:a[i+1].trim()});}return out;}
function parseDXF(text){
 var p=dxfPairs(text),ents=[],ent=null,poly=null;
 for(var i=0;i<p.length;i++){
  var c=p[i].code,v=p[i].value;
  if(c==='0'){
   if(ent){
    if(ent.type!=='VERTEX')ents.push(ent);
    ent=null;
   }
   if(v==='POINT')ent={type:'POINT',pts:[],layer:'',z:0};
   else if(v==='LINE')ent={type:'LINE',pts:[],layer:'',z:0};
   else if(v==='LWPOLYLINE')ent={type:'LWPOLYLINE',pts:[],closed:false,layer:'',z:0};
   else if(v==='POLYLINE')ent={type:'POLYLINE',pts:[],closed:false,layer:'',z:0};
   else if(v==='SEQEND'){if(poly){ents.push(poly);poly=null;}}
   else if(v==='VERTEX')ent={type:'VERTEX',pts:[],layer:'',z:0};
  }else if(ent){
   if(c==='8')ent.layer=String(v);
   else if(c==='10')ent._x=parseFloat(v);
   else if(c==='20')ent._y=parseFloat(v);
   else if(c==='30')ent._z=parseFloat(v);
   else if(c==='38')ent._z=parseFloat(v);
   else if(c==='11')ent._x2=parseFloat(v);
   else if(c==='21')ent._y2=parseFloat(v);
   else if(c==='31')ent._z2=parseFloat(v);
   else if(c==='70')ent.closed=((parseInt(v)||0)&1)?true:false;
   if((ent.type==='LWPOLYLINE'||ent.type==='VERTEX')&&c==='10'){
    ent.pts.push({x:parseFloat(v),y:NaN,z:0});
   }
   if((ent.type==='LWPOLYLINE'||ent.type==='VERTEX')&&c==='20'&&ent.pts.length){
    ent.pts[ent.pts.length-1].y=parseFloat(v);
   }
   if((ent.type==='LWPOLYLINE'||ent.type==='VERTEX')&&c==='30'&&ent.pts.length){
    ent.pts[ent.pts.length-1].z=parseFloat(v);
   }
   if(ent.type==='POINT'&&c==='20'){
    ent.pts=[{x:ent._x,y:parseFloat(v),z:Number.isFinite(ent._z)?ent._z:0}];
   }
   if(ent.type==='LINE'&&c==='21'){
    ent.pts=[{x:ent._x,y:ent._y,z:Number.isFinite(ent._z)?ent._z:0},{x:ent._x2,y:parseFloat(v),z:Number.isFinite(ent._z2)?ent._z2:0}];
   }
  }
 }
 if(ent&&ent.type!=='VERTEX')ents.push(ent);
 return ents.filter(function(e){return e.pts&&e.pts.length;});
}
function cadBounds(ents){var xs=[],ys=[];ents.forEach(function(e){e.pts.forEach(function(p){if(Number.isFinite(p.x)&&Number.isFinite(p.y)){xs.push(p.x);ys.push(p.y);}})});if(!xs.length)return null;var minX=Math.min.apply(null,xs),maxX=Math.max.apply(null,xs),minY=Math.min.apply(null,ys),maxY=Math.max.apply(null,ys);if(minX===maxX){minX-=1;maxX+=1;}if(minY===maxY){minY-=1;maxY+=1;}return {minX:minX,maxX:maxX,minY:minY,maxY:maxY};}
function cadSVG(ents,view){var b=cadBounds(ents);if(!b)return '';var W=800,H=520,pad=35,sx=(W-2*pad)/(b.maxX-b.minX),sy=(H-2*pad)/(b.maxY-b.minY),sc=Math.min(sx,sy);function X(x){return pad+(x-b.minX)*sc;}function Y(y){return H-pad-(y-b.minY)*sc;}var svg='<rect x="0" y="0" width="800" height="520" fill="#eef0eb"/>';ents.forEach(function(e){if(e.type==='POINT'){e.pts.forEach(function(p){svg+='<circle cx="'+X(p.x)+'" cy="'+Y(p.y)+'" r="3" fill="#1e5b2a"/>';});}else if(e.pts.length>=2){var pts=e.pts.map(function(p){return X(p.x)+','+Y(p.y);}).join(' ');if(e.type==='LINE')svg+='<line x1="'+X(e.pts[0].x)+'" y1="'+Y(e.pts[0].y)+'" x2="'+X(e.pts[1].x)+'" y2="'+Y(e.pts[1].y)+'" stroke="#1d3b22" stroke-width="1.5"/>';else svg+='<polyline points="'+pts+(e.closed?' '+X(e.pts[0].x)+','+Y(e.pts[0].y):'')+'" fill="none" stroke="#1d3b22" stroke-width="1.5"/>';}});return svg;}
function loadCADForPDF(){var f=$("cadFile")&&$("cadFile").files[0];if(!f){showToast('Choose a CAD file');return false;}if(/\.dwg$/i.test(f.name)){ $("cadStatus").textContent='DWG: تبدیل مستقیم در مرورگر این نسخه پشتیبانی نمی‌شود؛ فایل DXF را انتخاب کن.';showToast('DWG needs a CAD parser');return false;}var r=new FileReader();r.onload=function(){cadEntities=parseDXF(r.result);if(!cadEntities.length){$("cadStatus").textContent='DXF entity قابل نمایش پیدا نشد.';return;}$("cadPreview").innerHTML=cadSVG(cadEntities);$("cadStatus").textContent='Loaded: '+cadEntities.length+' entities — READY TO PRINT';showToast('DXF loaded ✓');};r.readAsText(f);return false;}
function cadPrintCanvas(ents){
 var c=document.createElement('canvas'),W=1600,H=1040,pad=70,b=cadBounds(ents);
 c.width=W;c.height=H;var ctx=c.getContext('2d');
 ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);
 if(!b)return c.toDataURL('image/png');
 var sx=(W-2*pad)/(b.maxX-b.minX),sy=(H-2*pad)/(b.maxY-b.minY),sc=Math.min(sx,sy);
 var ox=pad+(W-2*pad-(b.maxX-b.minX)*sc)/2,oy=pad+(H-2*pad-(b.maxY-b.minY)*sc)/2;
 function X(x){return ox+(x-b.minX)*sc;} function Y(y){return H-(oy+(y-b.minY)*sc);}
 ctx.lineCap='round';ctx.lineJoin='round';
 ents.forEach(function(e){
  if(e.type==='POINT'){
   e.pts.forEach(function(p){ctx.beginPath();ctx.arc(X(p.x),Y(p.y),5,0,Math.PI*2);ctx.fillStyle='#111';ctx.fill();});
  }else if(e.pts.length>=2){
   ctx.beginPath();ctx.moveTo(X(e.pts[0].x),Y(e.pts[0].y));
   for(var i=1;i<e.pts.length;i++)ctx.lineTo(X(e.pts[i].x),Y(e.pts[i].y));
   if(e.closed)ctx.closePath();ctx.strokeStyle='#111';ctx.lineWidth=3;ctx.stroke();
  }
 });
 return c.toDataURL('image/png');
}

function getCADPointList(){
 var pts=[],i,j,e;
 for(i=0;i<cadEntities.length;i++){
  e=cadEntities[i];
  if(e.type==='POINT'){
   for(j=0;j<e.pts.length;j++)pts.push({no:'P'+('000'+(pts.length+1)).slice(-3),type:'POINT',layer:e.layer||'',x:e.pts[j].x,y:e.pts[j].y,z:Number.isFinite(e.pts[j].z)?e.pts[j].z:0});
  }
 }
 if(!pts.length){
  for(i=0;i<cadEntities.length;i++){
   e=cadEntities[i];
   if(e.type==='LWPOLYLINE'||e.type==='POLYLINE'){
    for(j=0;j<e.pts.length;j++)pts.push({no:'V'+('000'+(pts.length+1)).slice(-3),type:'VERTEX',layer:e.layer||'',x:e.pts[j].x,y:e.pts[j].y,z:Number.isFinite(e.pts[j].z)?e.pts[j].z:0});
   }
  }
 }
 return pts;
}
function pdfEsc(v){/* V52: keep generated PDF content ASCII-safe so byte Length matches and standard Helvetica renders reliably. */return String(v==null?'':v).replace(/[^\x20-\x7E]/g,'?').replace(/\\/g,'\\\\').replace(/\(/g,'\\(').replace(/\)/g,'\\)');}
function makePointListPDF(){
 /* V382: Menu 10 uses the same HTML/native print-PDF delivery path as Menu 6.
    The data source remains the loaded CAD point/vertex list. */
 var pts=getCADPointList();
 if(!pts.length){showToast('No CAD points found');return null;}
 var rows=pts.map(function(p){
   return '<tr><td>'+pdfEsc(p.no||'')+'</td><td>'+pdfEsc(p.type||'')+'</td><td>'+pdfEsc(p.layer||'-')+'</td><td>'+Number(p.x).toFixed(4)+'</td><td>'+Number(p.y).toFixed(4)+'</td><td>'+Number(p.z).toFixed(4)+'</td></tr>';
 }).join('');
 var fileName=(($('cadFile')&&$('cadFile').files[0])?$('cadFile').files[0].name:'DXF');
 return '<!doctype html><html dir="ltr"><head><meta charset="utf-8"><title>MiladGeo - DXF Point List</title><style>'+
   '@page{size:A4 landscape;margin:10mm}html,body{background:#fff;color:#111}body{font-family:Arial,Tahoma,sans-serif;margin:0;padding:12px}h2{margin:0 0 6px;font-size:18px}.meta{font-size:11px;margin:0 0 12px;color:#333}table{border-collapse:collapse;width:100%;font-size:10px}th,td{border:1px solid #777;padding:5px 4px;text-align:center;word-break:break-word}th{background:#e8ece4;font-weight:700}@media print{body{padding:0}}'+
   '</style></head><body><h2>MILADGEO — DXF POINT LIST</h2><div class="meta">Source: '+pdfEsc(fileName)+' &nbsp; | &nbsp; Points: '+pts.length+' &nbsp; | &nbsp; '+new Date().toLocaleString()+'</div><table><thead><tr><th>NO</th><th>TYPE</th><th>LAYER</th><th>X</th><th>Y</th><th>Z</th></tr></thead><tbody>'+rows+'</tbody></table></body></html>';
}
function downloadCADPointListPDF(){
 if(!cadEntities.length){showToast('Load DXF first');return false;}
 var pts=getCADPointList();if(!pts.length){showToast('No CAD points found');return false;}
 var html=makePointListPDF();
 if(!html)return false;
 try{
   /* Same delivery logic as Menu 6: native Android print/PDF first, browser print fallback. */
   if(typeof window.miladgeoM17PrintHtml==='function'){
     window.miladgeoM17PrintHtml(html,'MiladGeo DXF Point List');
     showToast('PDF point list آماده است ✓');
     return false;
   }
 }catch(e){console.error('CAD_POINT_PDF_NATIVE',e);}
 try{
   var w=window.open('','_blank');
   if(!w){showToast('پنجره PDF توسط مرورگر مسدود شده است');return false;}
   w.document.open();w.document.write(html);w.document.close();
   setTimeout(function(){try{w.focus();w.print();}catch(e){}},700);
 }catch(e2){console.error('CAD_POINT_PDF_BROWSER',e2);showToast('ساخت PDF ناموفق بود');}
 return false;
}
function downloadCADPointListCSV(){
 if(!cadEntities.length){showToast('Load DXF first');return false;}
 var pts=getCADPointList();if(!pts.length){showToast('No CAD points found');return false;}
 var csv='No,Type,Layer,X,Y,Z\n',i,p;
 for(i=0;i<pts.length;i++){p=pts[i];csv+=p.no+','+csvSafe(p.type)+','+csvSafe(p.layer||'')+','+p.x+','+p.y+','+p.z+(i===pts.length-1?'':'\n');}
 downloadTextFile((($('cadFile')&&$('cadFile').files[0])?$('cadFile').files[0].name.replace(/\.[^.]+$/,''):'MILADGEO')+'_POINT_LIST.csv','\ufeff'+csv,'text/csv;charset=utf-8');return false;
}
function printCADPDF(){
 if(!cadEntities.length){showToast('Load DXF first');return false;}
 var title=$("pdfTitle").value||'MILADGEO SURVEY MAP',paper=$("pdfPaper").value,ori=$("pdfOrient").value,scale=$("pdfScale").value;
 var w=ori==='landscape'?'landscape':'portrait';
 var imgData=cadPrintCanvas(cadEntities);
 var html='<!doctype html><html><head><meta charset="utf-8"><title>'+escapeHTML(title)+'</title><style>'+
   '@page{size:'+paper+' '+w+';margin:10mm}html,body{background:#fff;color:#111}body{font-family:Arial,Tahoma,sans-serif;margin:0;padding:0}h2{font-size:16px;margin:0 0 3mm}.meta{font-size:10px;margin-bottom:4mm}.map{width:100%;border:1px solid #333;box-sizing:border-box}.map img{display:block;width:100%;height:auto}'+
   '@media print{body{padding:0}.map{break-inside:avoid;page-break-inside:avoid}}'+
   '</style></head><body><h2>'+escapeHTML(title)+'</h2><div class="meta">MiladGeo • '+escapeHTML(paper)+' • '+escapeHTML(w)+' • Scale: '+escapeHTML(scale)+'</div><div class="map"><img src="'+imgData+'" alt="Survey map"></div></body></html>';
 try{
   /* V382: same Menu 6 / central native PDF delivery path; no early window.open(). */
   if(typeof window.miladgeoM17PrintHtml==='function'){
     window.miladgeoM17PrintHtml(html,title);
     showToast('PDF آماده چاپ / ذخیره است ✓');
     return false;
   }
 }catch(e){console.error('CAD_MAP_PDF_NATIVE',e);}
 try{
   var win=window.open('','_blank');
   if(!win){showToast('پنجره PDF توسط مرورگر مسدود شده است');return false;}
   win.document.open();win.document.write(html);win.document.close();
   setTimeout(function(){try{win.focus();win.print();}catch(e){}},700);
   return false;
 }catch(e2){console.error('CAD_MAP_PDF_BROWSER',e2);showToast('ساخت PDF ناموفق بود');return false;}
}
function nval(id){var v=parseFloat($(id).value);return Number.isFinite(v)?v:null;}
function cogoInverse(){var x1=nval('c1x'),y1=nval('c1y'),x2=nval('c2x'),y2=nval('c2y');if([x1,y1,x2,y2].some(function(v){return v===null;})){showToast('Enter all coordinates');return false;}var dx=x2-x1,dy=y2-y1,d=Math.hypot(dx,dy),az=normalizeAzimuth(Math.atan2(dx,dy)*180/Math.PI);$('cogoInverseOut').innerHTML='<div class="result-line"><span>Distance</span><b>'+fmt(d,4)+' m</b></div><div class="result-line"><span>Azimuth</span><b>'+fmt(az,4)+'°</b></div><div class="result-line"><span>ΔX</span><b>'+fmt(dx,4)+'</b></div><div class="result-line"><span>ΔY</span><b>'+fmt(dy,4)+'</b></div>';return false;}
function cogoPolar(){var x=nval('p1x'),y=nval('p1y'),az=nval('pAz'),d=nval('pDist');if([x,y,az,d].some(function(v){return v===null;})){showToast('Enter start, azimuth and distance');return false;}az=normalizeAzimuth(az);var X=x+d*Math.sin(az*Math.PI/180),Y=y+d*Math.cos(az*Math.PI/180);$('cogoPolarOut').innerHTML='<div class="result-line"><span>Target X</span><b>'+fmt(X,4)+'</b></div><div class="result-line"><span>Target Y</span><b>'+fmt(Y,4)+'</b></div>';return false;}
function bearingToAz(){var s=($('bearingDms').value||'').trim().toUpperCase().replace(/\s+/g,'');var m=s.match(/^([NS])(\d+(?:-\d+(?:-\d+(?:\.\d+)?)?)?)([EW])$/);if(!m){showToast('Use N 35-20-15 E');return false;}var q=m[2].split('-').map(Number),deg=q[0]+(q[1]||0)/60+(q[2]||0)/3600,az;if(m[1]==='N'&&m[3]==='E')az=deg;else if(m[1]==='S'&&m[3]==='E')az=180-deg;else if(m[1]==='S'&&m[3]==='W')az=180+deg;else az=360-deg;$('cogoBearingOut').textContent='Azimuth = '+fmt(normalizeAzimuth(az),6)+'°';return false;}
function azToBear(){var a=nval('azToBearing');if(a===null){showToast('Enter azimuth');return false;}a=normalizeAzimuth(a);var s;if(a<90)s='N '+fmt(a,4)+' E';else if(a<180)s='S '+fmt(180-a,4)+' E';else if(a<270)s='S '+fmt(a-180,4)+' W';else s='N '+fmt(360-a,4)+' W';$('cogoBearingOut').textContent='Bearing = '+s;return false;}
function cogoIntersection(){var ax=nval('iAx'),ay=nval('iAy'),aa=nval('iAa'),bx=nval('iBx'),by=nval('iBy'),ba=nval('iBa');if([ax,ay,aa,bx,by,ba].some(function(v){return v===null;})){showToast('Enter both lines');return false;}var ar=aa*Math.PI/180,br=ba*Math.PI/180,dx=Math.sin(ar),dy=Math.cos(ar),ex=Math.sin(br),ey=Math.cos(br),den=dx*ey-dy*ex;if(Math.abs(den)<1e-12){showToast('Lines are parallel');return false;}var t=((bx-ax)*ey-(by-ay)*ex)/den,X=ax+t*dx,Y=ay+t*dy;$('cogoIntersectionOut').innerHTML='<div class="result-line"><span>Intersection X</span><b>'+fmt(X,4)+'</b></div><div class="result-line"><span>Intersection Y</span><b>'+fmt(Y,4)+'</b></div>';return false;}
window.loadCADForPDF=loadCADForPDF;window.printCADPDF=printCADPDF;window.downloadCADPointListPDF=downloadCADPointListPDF;window.downloadCADPointListCSV=downloadCADPointListCSV;window.cogoInverse=cogoInverse;window.cogoPolar=cogoPolar;window.bearingToAz=bearingToAz;window.azToBear=azToBear;window.cogoIntersection=cogoIntersection;

/* V366 — JOB output center + total station formats */
function updateJobOutput363(){
  try{
    var n=(job&&job.name)?String(job.name):'JOB فعال نیست';
    var c=Array.isArray(points)?points.length:0;
    var a=$("jobOutputName363"),b=$("jobOutputCount363"),st=$("jobOutputStatus363");
    if(a)a.textContent=n;
    if(b)b.textContent=c+' نقطه';
    if(st)st.textContent='';
  }catch(e){}
}
/* V362.3 — JOB archive bridge to the real application state */
window.miladGeoGetJobState=function(){
  return {
    job: JSON.parse(JSON.stringify(job||{})),
    setup: JSON.parse(JSON.stringify(setup||{})),
    points: JSON.parse(JSON.stringify(points||[]))
  };
};
window.miladGeoApplyJobState=function(st){
  st=st||{};
  job=st.job&&typeof st.job==='object'?JSON.parse(JSON.stringify(st.job)):{name:"",created:""};
  setup=st.setup&&typeof st.setup==='object'?JSON.parse(JSON.stringify(st.setup)):{stationSet:false,orientationSet:false};
  points=Array.isArray(st.points)?JSON.parse(JSON.stringify(st.points)):[];
  saveJSON(JOB_KEY,job);
  saveJSON(SETUP_KEY,setup);
  saveJSON(POINTS_KEY,points);
  updateAllUI();
  refreshPoints();
  return true;
};
/* V369 — single source of truth for points added by Measure / Stake Out. */
window.miladGeoGetPoints=function(){ return points; };
window.miladGeoReplacePoints=function(arr){
  points=Array.isArray(arr)?arr:[];
  saveJSON(POINTS_KEY,points);
  refreshPoints();
  updateAllUI();
  return points;
};
window.miladGeoAddPointToJob=function(p){
  try{
    p=p||{};
    var x=Number(p.x),y=Number(p.y),z=Number(p.z==null?0:p.z);
    if((!isFinite(x)||!isFinite(y)) && isFinite(Number(p.lat)) && isFinite(Number(p.lng)) && typeof window.m17Wgs84ToUtm==='function'){
      var u=window.m17Wgs84ToUtm(Number(p.lat),Number(p.lng));
      x=Number(u.x); y=Number(u.y);
    }
    if(!isFinite(x)||!isFinite(y))return false;
    var no=String(p.no||p.name||'').trim()||('P'+(points.length+1));
    var noKey=no.toUpperCase(),coordKey=[x.toFixed(6),y.toFixed(6),z.toFixed(6)].join('|');
    for(var i=0;i<points.length;i++){
      var q=points[i]||{};
      if(String(q.no||'').trim().toUpperCase()===noKey)return q;
      var qk=[Number(q.x).toFixed(6),Number(q.y).toFixed(6),Number(q.z||0).toFixed(6)].join('|');
      if(qk===coordKey)return q;
    }
    var item={id:Date.now()+Math.floor(Math.random()*100000),no:no,dp:String(p.dp||'').trim(),x:x,y:y,z:z,distance:p.distance==null?null:Number(p.distance),azimuth:p.azimuth==null?null:Number(p.azimuth)};
    points.push(item);
    saveJSON(POINTS_KEY,points);
    refreshPoints();
    updateAllUI();
    try{if(window.miladJobAutoSync362)window.miladJobAutoSync362(POINTS_KEY);}catch(e){}
    return item;
  }catch(e){ console.error('JOB_ADD_POINT',e); return false; }
};

function init(){loadData();if($("jobName"))$("jobName").value="";if(setup.stationSet){$("stationName").value=setup.stationName||'';$("sx").value=setup.sx==null?'':setup.sx;$("sy").value=setup.sy==null?'':setup.sy;$("sz").value=setup.sz==null?'':setup.sz;$("stationHI").value=setup.stationHI==null?'':setup.stationHI;$("stationDP").value=setup.stationDP||'';}$("orientMethod").value=setup.orientationMethod||'azimuth';changeOrientationMethod();if(setup.orientationMethod==='azimuth'&&finite(Number(setup.azimuth)))$("manualAz").value=setup.azimuth;var od=$("orientationDistance");if(od&&finite(Number(setup.orientationDistance)))od.value=setup.orientationDistance;if(setup.orientationMethod==='coordinates'){$("backName").value=setup.backName||'BS01';$("bx").value=setup.bx==null?'':setup.bx;$("by").value=setup.by==null?'':setup.by;$("bz").value=setup.bz==null?'':setup.bz;}updateAllUI();renderAreaPoints();renderVolumePoints();prepareManualPoint();var h=(location.hash||'').replace(/^#/,'');if($(h))showPage(h);else showPage('main');}
window.addEventListener('hashchange',function(){var h=(location.hash||'').replace(/^#/,'');if($(h))showPage(h);else showPage('main');});
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();

var unitDefs={
length:{'mm':1e-3,'cm':1e-2,'m':1,'km':1e3,'in':0.0254,'ft':0.3048,'US survey ft':1200/3937,'yd':0.9144,'mile':1609.344},
area:{'mm²':1e-6,'cm²':1e-4,'m²':1,'km²':1e6,'ha':1e4,'are':100,'acre':4046.8564224,'ft²':0.09290304,'US survey ft²':(1200/3937)**2},
volume:{'cm³':1e-6,'L':1e-3,'m³':1,'ft³':0.028316846592,'US gal':0.003785411784,'US survey ft³':(1200/3937)**3},
angle:{'degree':1,'gon':0.9,'radian':180/Math.PI,'arcmin':1/60,'arcsec':1/3600},
mass:{'mg':1e-6,'g':1e-3,'kg':1,'tonne':1000,'lb':0.45359237},
slope:{}
};
var unitLabels={length:{'mm':'mm','cm':'cm','m':'m','km':'km','in':'in','ft':'ft','US survey ft':'US Survey ft','yd':'yd','mile':'mile'},area:{'mm²':'mm²','cm²':'cm²','m²':'m²','km²':'km²','ha':'hectare (ha)','are':'are','acre':'acre','ft²':'ft²','US survey ft²':'US Survey ft²'},volume:{'cm³':'cm³','L':'liter (L)','m³':'m³','ft³':'ft³','US gal':'US gallon','US survey ft³':'US Survey ft³'},angle:{'degree':'Degree (°)','gon':'Gon / Grad','radian':'Radian','arcmin':'Arcmin','arcsec':'Arcsec'},mass:{'mg':'mg','g':'g','kg':'kg','tonne':'Tonne','lb':'Pound (lb)'}};
function populateUnitSelect(id,items){var el=$(id);if(!el)return;el.innerHTML='';items.forEach(function(k){var o=document.createElement('option');o.value=k;o.textContent=(unitLabels[$('unitCategory').value]||{})[k]||k;el.appendChild(o);});}
function updateUnitConverter(){var cat=$('unitCategory')?.value||'length',f=$('unitFrom'),t=$('unitTo');if(!f||!t)return;if(cat==='slope'){f.innerHTML='<option value="percent">Percent (%)</option><option value="ratio">Ratio (1:n)</option><option value="degree">Degree (°)</option>';t.innerHTML=f.innerHTML; t.value='degree';}else{var keys=Object.keys(unitDefs[cat]);populateUnitSelect('unitFrom',keys);populateUnitSelect('unitTo',keys);if(keys.includes('m'))t.value='ft';else if(keys.includes('m²'))t.value='ha';else if(keys.includes('m³'))t.value='L';else if(keys.includes('degree'))t.value='gon';else if(keys.includes('kg'))t.value='lb';}}
function convertUnits(){var cat=$('unitCategory').value,v=parseFloat($('unitValue').value),from=$('unitFrom').value,to=$('unitTo').value;if(!Number.isFinite(v)){showToast('Enter a valid value');return false;}var r;if(cat==='slope'){r=convertSlope(v,from,to);}else{var base=v*unitDefs[cat][from];r=base/unitDefs[cat][to];}var out=r.toLocaleString('en-US',{maximumFractionDigits:10});$('unitResult').textContent=v+' '+from+' = '+out+' '+to;return false;}
function convertSlope(v,from,to){var deg;if(from==='percent')deg=Math.atan(v/100)*180/Math.PI;else if(from==='ratio')deg=Math.atan(1/v)*180/Math.PI;else deg=v;if(to==='degree')return deg;if(to==='percent')return Math.tan(deg*Math.PI/180)*100;if(to==='ratio'){var tan=Math.tan(deg*Math.PI/180);return Math.abs(tan)<1e-15?Infinity:1/tan;}}
function swapUnits(){var f=$('unitFrom'),t=$('unitTo');if(!f||!t)return false;var x=f.value;f.value=t.value;t.value=x;convertUnits();return false;}
function copyUnitResult(){var txt=$('unitResult')?.textContent||'';if(!txt)return false;navigator.clipboard?.writeText(txt).then(function(){showToast('Copied ✓');}).catch(function(){showToast('Copy not available');});return false;}
window.updateUnitConverter=updateUnitConverter;window.convertUnits=convertUnits;window.swapUnits=swapUnits;window.copyUnitResult=copyUnitResult;
/* V115 — ENGINEERING MODULE JS */
var engExamActive=false,engExamCount=20,engExamMinutes=30,engExamEnd=0,engExamTimer=null,engExamAnswers={},engExamSkipped=0;
var engChecklistState=[];
var ENG_CHECKS=['نام و مشخصات پروژه کنترل شده است','سیستم مختصات و Datum مشخص است','واحدهای X/Y/Z و ارتفاع کنترل شده‌اند','مختصات نقاط کنترل بازبینی شده‌اند','نقاط تکراری یا مشکوک بررسی شده‌اند','Station و Orientation کنترل شده‌اند','ابعاد و طول اضلاع کنترل شده‌اند','مساحت پلیگون با داده پروژه تطبیق داده شده است','بسته‌شدن پلیگون و خطای بستگی بررسی شده است','حدود اربعه و اطلاعات ملک کنترل شده است','فایل‌های برداشت و مدارک ضروری کامل هستند','خروجی نهایی قبل از تحویل بازبینی شده است'];
function engineeringMode(mode){
 var b=$("engineeringBody");if(!b)return false;
 if(mode==='home')return engineeringHome();
 if(mode==='exam')return engineeringExamSetup();
 if(mode==='map')return engineeringMapCheck();
 if(mode==='check')return engineeringChecklist();
 if(mode==='report')return engineeringFinalReport();
 return engineeringHome();
}
function engineeringHome(){
 var b=$("engineeringBody");if(!b)return false;
 if(engExamTimer){clearInterval(engExamTimer);engExamTimer=null;}
 b.innerHTML='<div class="eng-section"><div class="training-panel-head"><b>آزمون شبیه‌ساز هوشمند نظام مهندسی</b></div><div class="subtitle">فعلاً فقط بخش آزمون فعال است. آزمون‌ها زمان‌دار و تصادفی هستند و در پایان کارنامه و مرور پاسخ‌ها نمایش داده می‌شود.</div><button class="eng-home-btn" type="button" style="width:100%;margin-top:10px" onclick="engineeringMode(\'exam\');return false;"><b>۱ — آزمون شبیه‌ساز هوشمند</b><span>انتخاب تعداد سؤال، زمان و مبحث + ترتیب تصادفی + کارنامه</span></button></div>';
 return false;
}
function engineeringTopicSetup(){
 var b=$("engineeringBody");if(!b)return false;
 buildSurveyQuizBank();
 var cats=[],seen={};
 surveyQuizBank.forEach(function(q){if(q.cat&&!seen[q.cat]){seen[q.cat]=true;cats.push(q.cat);}});
 var cards=cats.map(function(c,i){return '<button type="button" class="eng-topic-card" onclick="selectEngineeringTopic('+JSON.stringify(c)+');return false;"><span>📚</span><b>'+escapeHTML(c)+'</b><small>تمرین سؤال‌های این مبحث</small></button>';}).join('');
 b.innerHTML='<div class="eng-section eng-topic-setup" id="engineeringTopicPanel"><div class="training-panel-head"><button type="button" class="btn gray" onclick="engineeringHome();return false;">← منوی ۱۵</button><b>آزمون مبحثی نقشه‌برداری</b></div><div class="subtitle">مبحث را انتخاب کن؛ سپس تعداد سؤال و زمان آزمون را تعیین کن.</div><div class="eng-topic-grid">'+cards+'</div><div class="eng-topic-options"><div><label>تعداد سؤال</label><select id="engExamCount"><option value="10">۱۰ سؤال — تمرینی</option><option value="20" selected>۲۰ سؤال — استاندارد</option><option value="30">۳۰ سؤال — کامل</option><option value="40">۴۰ سؤال — فشرده</option></select></div><div><label>زمان آزمون</label><select id="engExamMinutes"><option value="10">۱۰ دقیقه — سریع</option><option value="15">۱۵ دقیقه</option><option value="20">۲۰ دقیقه</option><option value="30" selected>۳۰ دقیقه</option><option value="45">۴۵ دقیقه</option><option value="60">۶۰ دقیقه</option><option value="90">۹۰ دقیقه — جامع</option></select></div></div><div id="engSelectedTopic" class="eng-selected-topic">هنوز مبحثی انتخاب نشده است</div><button type="button" class="btn primary" onclick="startEngineeringTopicExam();return false;">🚀 شروع آزمون مبحثی</button></div>';
 engineeringScrollTo('#engineeringTopicPanel');
 return false;
}
function selectEngineeringTopic(topic){
 var el=$("engSelectedTopic");if(el){el.textContent='مبحث انتخاب‌شده: '+topic;el.dataset.topic=topic;el.classList.add('selected');}
 var cards=document.querySelectorAll('.eng-topic-card');for(var i=0;i<cards.length;i++){cards[i].classList.toggle('selected',cards[i].textContent.indexOf(topic)>=0);}
 return false;
}
function startEngineeringTopicExam(){
 var el=$("engSelectedTopic"),topic=el&&el.dataset?el.dataset.topic:'';
 if(!topic){showToast('ابتدا یک مبحث را انتخاب کن');return false;}
 var hidden=document.createElement('select');hidden.id='engExamTopic';hidden.innerHTML='<option value="'+escapeHTML(topic)+'" selected>'+escapeHTML(topic)+'</option>';hidden.style.display='none';document.body.appendChild(hidden);
 var ok=startEngineeringExam();
 hidden.remove();
 return ok;
}
function engineeringExamSetup(){
 var b=$("engineeringBody");if(!b)return false;
 buildSurveyQuizBank();
 var cats={},firstCat='';
 surveyQuizBank.forEach(function(q){if(!cats[q.cat]){cats[q.cat]=true;if(!firstCat)firstCat=q.cat;}});
 var opts='<option value="" selected>همه مباحث — آزمون جامع</option>'+Object.keys(cats).map(function(c){return '<option value="'+escapeHTML(c)+'">'+escapeHTML(c)+'</option>';}).join('');
 b.innerHTML='<div class="eng-section"><div class="training-panel-head"><button type="button" class="btn gray" onclick="engineeringHome();return false;">← منوی ۱۵</button><b>آزمون شبیه‌ساز هوشمند نظام مهندسی</b></div>'+ 
 '<div class="subtitle">تعداد سؤال، زمان و مبحث را انتخاب کن. سؤال‌ها و گزینه‌ها داخل همان مبحث به‌صورت تصادفی انتخاب می‌شوند.</div>'+ 
 '<div class="row"><div><label>تعداد سؤال</label><select id="engExamCount"><option value="10">۱۰ سؤال — تمرینی</option><option value="20" selected>۲۰ سؤال — استاندارد</option><option value="40">۴۰ سؤال — فشرده</option><option value="60">۶۰ سؤال — کامل</option></select></div><div><label>زمان آزمون</label><select id="engExamMinutes"><option value="15">۱۵ دقیقه</option><option value="30" selected>۳۰ دقیقه</option><option value="45">۴۵ دقیقه</option><option value="60">۶۰ دقیقه</option></select></div></div>'+ 
 '<label>مبحث</label><select id="engExamTopic">'+opts+'</select>'+ 
 '<div class="eng-section"><b>قواعد آزمون</b><div class="training-step">• ترتیب سؤال‌ها تصادفی است.</div><div class="training-step">• ترتیب گزینه‌ها تصادفی است.</div><div class="training-step">• بعد از ثبت پاسخ، سؤال بعدی باز می‌شود.</div><div class="training-step">• با پایان زمان، آزمون خودکار پایان می‌یابد.</div><div class="training-step">• با انتخاب «همه مباحث»، آزمون جامع از کل بانک سؤال ساخته می‌شود.</div><div class="training-step">• در پایان، درصد و کارنامه قابل مشاهده است.</div></div>'+ 
 '<button type="button" class="btn primary" style="margin-top:9px" onclick="startEngineeringExam();return false;">🚀 شروع آزمون</button></div>';
 return false;
}
function startEngineeringExam(){
 buildSurveyQuizBank();
 var countEl=$("engExamCount"),minEl=$("engExamMinutes"),topicEl=$("engExamTopic");
 engExamCount=Number(countEl&&countEl.value)||20;engExamMinutes=Number(minEl&&minEl.value)||30;
 var topic=topicEl?topicEl.value:'';
 var pool=surveyQuizBank.map(function(_,i){return i;}).filter(function(i){return !topic||surveyQuizBank[i].cat===topic;});
 pool=shuffleArray(pool);if(pool.length>engExamCount)pool=pool.slice(0,engExamCount);
 if(!pool.length){showToast('برای این مبحث سؤال پیدا نشد');return false;}
 quizMode='eng';quizOrder=pool;quizIndex=0;quizAnswered=false;quizScore=0;quizSeen=0;quizHistory=[];quizCurrentOptions=[];quizCurrentCorrect=0;engExamAnswers={};engExamSkipped=0;engExamActive=true;engExamEnd=Date.now()+engExamMinutes*60000;
 if(engExamTimer)clearInterval(engExamTimer);engExamTimer=setInterval(updateEngineeringTimer,1000);
 renderEngineeringExamQuestion();updateEngineeringTimer();return false;
}
function updateEngineeringTimer(){if(!engExamActive)return;if(Date.now()>=engExamEnd){finishEngineeringExam(true);return;}var sec=Math.max(0,Math.floor((engExamEnd-Date.now())/1000)),m=Math.floor(sec/60),s=sec%60;var el=$("engExamTimer");if(el)el.textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');}
function finishEngineeringExam(timeUp){
 engExamActive=false;if(engExamTimer){clearInterval(engExamTimer);engExamTimer=null;}quizStatsSaveSession();
 var b=$("engineeringBody");if(b){b.innerHTML='<div class="eng-exam-box"><div class="eng-timer">'+(timeUp?'⏱ زمان تمام شد':'آزمون پایان یافت')+'</div><div class="quiz-score" style="margin-top:8px">امتیاز: '+quizScore+' / '+quizSeen+'<br>درصد: '+(quizSeen?Math.round(quizScore/quizSeen*1000)/10:0)+'٪</div><button type="button" class="btn primary" onclick="showEngineeringExamReport();return false;">📋 مشاهده کارنامه</button><button type="button" class="btn gray" onclick="engineeringExamSetup();return false;">آزمون جدید</button></div>';}
 return false;
}
function renderEngineeringExamQuestion(){
 var b=$("engineeringBody"),total=quizOrder.length,base=surveyQuizBank[quizOrder[quizIndex]];if(!b||!base)return false;
 var idxs=shuffleArray([0,1,2,3]);quizCurrentOptions=idxs.map(function(i){return base.o[i];});quizCurrentCorrect=idxs.indexOf(base.c);quizAnswered=false;
 var answeredCount=Object.keys(engExamAnswers).length;
 var html='<div class="eng-section"><div class="training-panel-head"><button type="button" class="btn gray" onclick="if(confirm(\'خروج از آزمون؟ نتیجه فعلی حفظ می‌شود.\')){finishEngineeringExam(false);}return false;">← پایان</button><b>آزمون '+(quizIndex+1)+' از '+total+'</b></div><div id="engExamTimer" class="eng-timer">--:--</div>';
 html+='<div class="quiz-question" style="margin-top:8px"><div class="quiz-qtitle">'+(quizIndex+1)+') '+escapeHTML(base.q)+'</div>';
 for(var i=0;i<quizCurrentOptions.length;i++){html+='<label class="quiz-option"><input type="radio" name="engineeringExamAnswer" value="'+i+'"> '+String.fromCharCode(65+i)+') '+escapeHTML(quizCurrentOptions[i])+'</label>';}
 html+='<button type="button" class="btn primary" onclick="answerEngineeringExam();return false;">✓ ثبت پاسخ و ادامه</button>';
 html+='<div class="eng-review">پاسخ‌داده‌شده: '+answeredCount+' | باقی‌مانده: '+(total-quizIndex-1)+'</div></div></div>';
 b.innerHTML=html;updateEngineeringTimer();return false;
}
function answerEngineeringExam(){
 if(!engExamActive)return false;
 var r=document.querySelector('input[name="engineeringExamAnswer"]:checked');if(!r){showToast('یک گزینه را انتخاب کن');return false;}
 var base=surveyQuizBank[quizOrder[quizIndex]],sel=Number(r.value),ok=sel===quizCurrentCorrect;
 engExamAnswers[quizIndex]=sel;quizSeen++;if(ok)quizScore++;
 quizHistory.push({n:quizSeen,cat:base.cat,q:base.q,selected:sel,correct:quizCurrentCorrect,options:quizCurrentOptions.slice(),ok:ok,e:base.e});
 quizStatsRecordAnswer(ok);
 if(quizIndex<quizOrder.length-1){quizIndex++;quizCurrentOptions=[];quizCurrentCorrect=0;renderEngineeringExamQuestion();}else{finishEngineeringExam(false);}return false;
}
function showEngineeringExamReport(){
 var b=$("engineeringBody"),pct=quizSeen?Math.round(quizScore/quizSeen*1000)/10:0;if(!b)return false;
 var html='<div class="eng-section eng-report"><div class="training-panel-head"><button type="button" class="btn gray" onclick="engineeringMode(\'exam\');return false;">← آزمون جدید</button><b>📋 کارنامه شبیه‌ساز</b></div><div class="eng-stat-grid"><div class="eng-stat">تعداد<b>'+quizSeen+'</b></div><div class="eng-stat">صحیح<b class="eng-pass">'+quizScore+'</b></div><div class="eng-stat">غلط<b class="eng-fail">'+(quizSeen-quizScore)+'</b></div><div class="eng-stat">درصد<b>'+pct+'٪</b></div></div><h3>مرور پاسخ‌ها</h3>';
 quizHistory.forEach(function(h){html+='<div class="eng-section"><b>'+h.n+' — '+escapeHTML(h.cat)+'</b><br>'+escapeHTML(h.q)+'<br>پاسخ شما: '+escapeHTML(String.fromCharCode(65+h.selected)+') '+h.options[h.selected])+'<br><span class="'+(h.ok?'eng-pass':'eng-fail')+'">'+(h.ok?'✓ صحیح':'✗ غلط')+'</span> | پاسخ صحیح: '+escapeHTML(String.fromCharCode(65+h.correct)+') '+h.options[h.correct])+'<div class="eng-review">'+escapeHTML(h.e||'')+'</div></div>';});
 html+='<div class="btn-row" style="margin-top:10px"><button type="button" class="btn primary" onclick="printQuizReport();return false;">🖨 چاپ / ذخیره PDF</button></div></div>';b.innerHTML=html;return false;
}
function engineeringMapCheck(){
 var b=$("engineeringBody"),ps=points||[],dups={},dupList=[];ps.forEach(function(p){var k=Number(p.x).toFixed(4)+'|'+Number(p.y).toFixed(4);dups[k]=(dups[k]||0)+1;});Object.keys(dups).forEach(function(k){if(dups[k]>1)dupList.push(k+' × '+dups[k]);});
 var area=0,closed='—';if(ps.length>=3){for(var i=0;i<ps.length;i++){var a=ps[i],c=ps[(i+1)%ps.length];area+=Number(a.x)*Number(c.y)-Number(c.x)*Number(a.y);}area=Math.abs(area)/2;closed='قابل محاسبه با '+ps.length+' نقطه';}
 var xs=ps.map(function(p){return Number(p.x);}),ys=ps.map(function(p){return Number(p.y);});var range=(ps.length?('ΔX = '+fmt(Math.max.apply(null,xs)-Math.min.apply(null,xs),3)+' | ΔY = '+fmt(Math.max.apply(null,ys)-Math.min.apply(null,ys),3)):'—');
 b.innerHTML='<div class="eng-section"><div class="training-panel-head"><button type="button" class="btn gray" onclick="engineeringHome();return false;">← منوی ۱۵</button><b>کنترل و بررسی نقشه</b></div><div class="eng-stat-grid"><div class="eng-stat">تعداد نقاط<b>'+ps.length+'</b></div><div class="eng-stat">تکراری<b class="'+(dupList.length?'eng-fail':'eng-pass')+'">'+dupList.length+'</b></div><div class="eng-stat">مساحت<b>'+fmt(area,3)+'</b></div></div><div class="eng-section"><b>کنترل دامنه مختصات</b><div class="training-step">'+escapeHTML(range)+'</div><div class="training-step">پلیگون: '+closed+'</div><div class="training-step">تکراری‌ها: '+(dupList.length?escapeHTML(dupList.join(' ، ')):'موردی پیدا نشد ✓')+'</div></div><button type="button" class="btn primary" onclick="engineeringMapCheck();return false;">↻ اجرای دوباره کنترل</button></div>';return false;
}
function engineeringChecklist(){
 var b=$("engineeringBody");if(!engChecklistState.length)engChecklistState=new Array(ENG_CHECKS.length).fill(false);
 var done=engChecklistState.filter(Boolean).length,pct=Math.round(done/ENG_CHECKS.length*100);var html='<div class="eng-section"><div class="training-panel-head"><button type="button" class="btn gray" onclick="engineeringHome();return false;">← منوی ۱۵</button><b>چک‌لیست کنترل نظام مهندسی</b></div><div class="eng-timer" style="font-size:18px">'+done+' / '+ENG_CHECKS.length+' — '+pct+'٪ تکمیل</div><div style="margin-top:8px">';
 ENG_CHECKS.forEach(function(x,i){html+='<label class="eng-check"><input type="checkbox" '+(engChecklistState[i]?'checked':'')+' onchange="engChecklistState['+i+']=this.checked;engineeringChecklist();"> '+escapeHTML(x)+'</label>';});
 html+='</div><button type="button" class="btn gray" style="margin-top:9px" onclick="engChecklistState=new Array(ENG_CHECKS.length).fill(false);engineeringChecklist();return false;">پاک‌کردن تیک‌ها</button></div>';b.innerHTML=html;return false;
}
function engineeringFinalReport(){
 var b=$("engineeringBody"),ps=points||[],done=engChecklistState.filter(Boolean).length,pct=quizSeen?Math.round(quizScore/quizSeen*1000)/10:null,issues=[];
 if(ps.length<3)issues.push('کمتر از ۳ نقطه برای کنترل هندسی');if(dupPointCount()>0)issues.push('وجود نقطه تکراری');if(done<ENG_CHECKS.length)issues.push((ENG_CHECKS.length-done)+' مورد از چک‌لیست تکمیل نشده');
 var status=issues.length?'نیازمند بررسی':'آماده بررسی نهایی';
 b.innerHTML='<div class="eng-section eng-report"><div class="training-panel-head"><button type="button" class="btn gray" onclick="engineeringHome();return false;">← منوی ۱۵</button><b>گزارش و ارزیابی نهایی</b></div><div class="eng-stat-grid"><div class="eng-stat">نقاط<b>'+ps.length+'</b></div><div class="eng-stat">چک‌لیست<b>'+done+'/'+ENG_CHECKS.length+'</b></div><div class="eng-stat">آزمون<b>'+(pct===null?'—':pct+'٪')+'</b></div></div><div class="eng-section"><div class="eng-report-row"><span>وضعیت</span><b class="'+(issues.length?'eng-warn':'eng-pass')+'">'+status+'</b></div><div class="eng-report-row"><span>موارد نیازمند بررسی</span><b>'+issues.length+'</b></div></div><div class="eng-section">'+(issues.length?issues.map(function(x){return '<div class="training-step">⚠ '+escapeHTML(x)+'</div>';}).join(''):'<div class="eng-pass">✓ مورد هشدار اولیه‌ای ثبت نشده است.</div>')+'</div><button type="button" class="btn primary" onclick="exportEngineeringReport();return false;">⬇ خروجی گزارش TXT</button></div>';return false;
}
function dupPointCount(){var d={},n=0;(points||[]).forEach(function(p){var k=Number(p.x).toFixed(4)+'|'+Number(p.y).toFixed(4);d[k]=(d[k]||0)+1;});Object.keys(d).forEach(function(k){if(d[k]>1)n+=d[k]-1;});return n;}
function exportEngineeringReport(){var done=engChecklistState.filter(Boolean).length,pct=quizSeen?Math.round(quizScore/quizSeen*1000)/10:null,lines=['MILADGEO — ENGINEERING FINAL REPORT','JOB: '+(job.name||'-'),'POINTS: '+(points||[]).length,'CHECKLIST: '+done+'/'+ENG_CHECKS.length,'QUIZ: '+(pct===null?'NOT RUN':pct+'%'),'DUPLICATE POINTS: '+dupPointCount(),'DATE: '+new Date().toLocaleString('fa-IR'),''];ENG_CHECKS.forEach(function(x,i){lines.push((engChecklistState[i]?'[✓] ':'[ ] ')+x);});saveBlobFile('MiladGeo_Engineering_Report.txt',new Blob([lines.join('\n')],{type:'text/plain;charset=utf-8'}));showToast('گزارش نظام مهندسی آماده شد ✓');return false;}

function initLibrary(){filterLibraryCategory('all');}
function filterLibraryCategory(cat){
  window.libraryCategory=cat||'all';
  var q=(document.getElementById('librarySearch')?.value||'').trim().toLowerCase();
  var items=document.querySelectorAll('#libraryDetails .library-detail'),cards=document.getElementById('libraryList');
  if(!cards)return;
  cards.innerHTML=''; var shown=0;
  items.forEach(function(el){
    var title=(el.querySelector('.card-title')?.textContent||'').trim(), text=(el.textContent||'').trim(), t=(title+' '+text).toLowerCase();
    var itemCat=el.getAttribute('data-category')||'survey';
    var okCat=(window.libraryCategory==='all'||window.libraryCategory===itemCat),okQ=!q||t.indexOf(q)>=0;
    var a=document.createElement('a');a.className='library-item';a.href='#'+el.id;a.dataset.hidden=(okCat&&okQ)?'0':'1';
    a.innerHTML='<b>'+title+'</b><span>'+((text.replace(title,'')).trim().replace(/\s+/g,' ').slice(0,110))+'...</span>';
    if(okCat&&okQ){cards.appendChild(a);shown++;}
  });
  document.getElementById('libraryCount').textContent=shown+' مطلب';
  document.getElementById('libraryEmpty').style.display=shown?'none':'block';
  document.querySelectorAll('.library-tab').forEach(function(btn){btn.classList.remove('active');});
}
function filterLibrary(){filterLibraryCategory(window.libraryCategory||'all');}

window.initLibrary=initLibrary;window.filterLibrary=filterLibrary;window.filterLibraryCategory=filterLibraryCategory;
window.showQuizReport=showQuizReport;window.printQuizReport=printQuizReport;window.downloadQuizReportPDF=downloadQuizReportPDF;window.renderQuiz=renderQuiz;window.renderSurveyMap=renderSurveyMap;window.mapFitAll=mapFitAll;window.mapZoomIn=mapZoomIn;window.mapZoomOut=mapZoomOut;window.mapSelectPoint=mapSelectPoint;window.mapManualPointAdd=mapManualPointAdd;window.mapManualPointPrepare=mapManualPointPrepare;window.bindGraphicMapControls=bindGraphicMapControls;window.mapClearSelection=mapClearSelection;window.loadPointsExcel=loadPointsExcel;window.clearPointsExcel=clearPointsExcel;window.calculateUAV=calculateUAV;window.addGCP=addGCP;window.renderGCP=renderGCP;window.uavChecklist=uavChecklist;window.exportUAVReport=exportUAVReport;window.setGNSSMode=setGNSSMode;window.simulateGNSS=simulateGNSS;window.gnssConvert=gnssConvert;window.gnssMeasurePoint=gnssMeasurePoint;window.gnssStakeSelected=gnssStakeSelected;window.loadTrainingTopic=loadTrainingTopic;window.startTraining=startTraining;window.trainingNext=trainingNext;window.trainingPrev=trainingPrev;window.trainingData=trainingData;window.renderFlashcards=renderFlashcards;window.flipFlashcard=flipFlashcard;window.nextFlashcard=nextFlashcard;window.prevFlashcard=prevFlashcard;window.quizStatsReset=quizStatsReset;window.quizStatsResetForJob=quizStatsResetForJob;window.checkTrainingQuiz=checkTrainingQuiz;window.trainingHome=trainingHome;window.openTrainingMode=openTrainingMode;window.engineeringMode=engineeringMode;window.engineeringHome=engineeringHome;window.engineeringExamSetup=engineeringExamSetup;window.startEngineeringExam=startEngineeringExam;window.answerEngineeringExam=answerEngineeringExam;window.showEngineeringExamReport=showEngineeringExamReport;window.exportEngineeringReport=exportEngineeringReport;window.answerQuiz=answerQuiz;window.nextQuiz=nextQuiz;window.renderTraining=renderTraining;

initLibrary();
setExcelOutputsEnabled(false);
updateUnitConverter();
setGNSSMode('rtk');
renderGCP();
renderTraining('home');
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){bindGraphicMapControls();mapManualPointPrepare();});}else{setTimeout(function(){bindGraphicMapControls();mapManualPointPrepare();},0);}

})();
</script>
