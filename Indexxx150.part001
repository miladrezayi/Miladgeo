/* MENU 17 — Google Earth satellite map only */
#m17LayerToggle{position:absolute;z-index:82;top:2px;left:50%;transform:translateX(-50%);height:2mm;min-height:2mm;box-sizing:border-box;border:1px solid #b7d5e5;border-radius:3px;background:rgba(10,28,40,.94);color:#fff;padding:0 16px;font:800 10px Tahoma,Arial,sans-serif;line-height:2mm;box-shadow:0 3px 12px #0008;white-space:nowrap;touch-action:manipulation;overflow:visible}#m17HistoricalToggle{position:absolute;z-index:82;top:2px;left:calc(50% - 112px);transform:translateX(0);height:2mm;min-height:2mm;box-sizing:border-box;border:1px solid #d5bd76;border-radius:3px;background:rgba(52,39,10,.95);color:#fff;padding:0 10px;font:800 10px Tahoma,Arial,sans-serif;line-height:2mm;box-shadow:0 3px 12px #0008;white-space:nowrap;touch-action:manipulation;overflow:visible}#m17LayerControl{position:absolute;z-index:81;top:48px;left:50%;transform:translate(-50%,-8px);display:flex;flex-wrap:wrap;justify-content:center;gap:5px;max-width:min(94%,520px);direction:rtl;background:rgba(10,20,28,.94);padding:6px;border:1px solid rgba(255,255,255,.28);border-radius:12px;box-shadow:0 3px 14px #0008;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .16s ease,transform .16s ease,visibility .16s}#m17LayerControl.m17-layer-open{opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0)}#m17LayerControl button{border:1px solid #8ca2b0;border-radius:8px;background:#263744;color:#fff;padding:7px 9px;font:700 12px Tahoma,Arial,sans-serif;white-space:nowrap}#m17LayerControl button.active{background:#11a86b;border-color:#8dffd0;color:#fff}#m17LayerControl .m17-layer-title{width:100%;color:#e7f5ff;font:700 11px Tahoma,Arial,sans-serif;padding:0 3px 2px}@media(max-width:480px){#m17LayerControl{max-width:calc(100% - 16px);gap:4px;padding:5px;top:28px}#m17LayerToggle{top:2px;height:2mm;min-height:2mm;font-size:10px;line-height:2mm;padding:0 14px}#m17HistoricalToggle{top:2px;left:calc(50% - 108px);height:2mm;min-height:2mm;font-size:10px;line-height:2mm;padding:0 7px}#m17LayerControl button{font-size:11px;padding:6px 7px}}

#m17RouteToggle{position:absolute;z-index:82;top:2px;left:calc(50% + 55px);transform:translateX(0);height:2mm;min-height:2mm;box-sizing:border-box;border:1px solid #8bd9b2;border-radius:3px;background:rgba(8,55,37,.96);color:#fff;padding:0 9px;font:800 10px Tahoma,Arial,sans-serif;line-height:2mm;box-shadow:0 3px 12px #0008;white-space:nowrap;touch-action:manipulation;overflow:visible}
#m17RouteSvg{position:absolute;inset:0;width:100%;height:100%;z-index:6;pointer-events:none;overflow:visible}#m17RouteSvg .m17-route-line{fill:none;stroke:#00e676;stroke-width:6;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 1px 3px #000)}#m17RouteSvg .m17-route-start{fill:#1687ff;stroke:#fff;stroke-width:3}#m17RouteSvg .m17-route-end{fill:#e53935;stroke:#fff;stroke-width:3}#m17RouteSvg .m17-route-label{fill:#fff;font:900 12px Tahoma,Arial,sans-serif;paint-order:stroke;stroke:#111;stroke-width:3px;stroke-linejoin:round;text-anchor:middle}
#m17RouteModal{position:fixed;inset:0;z-index:9999;display:none;align-items:stretch;justify-content:center;padding:0;box-sizing:border-box;background:transparent;pointer-events:none}#m17RouteModal.show{display:flex}#m17RoutePanel{width:100%;max-width:none;height:100%;max-height:none;overflow:auto;position:relative;pointer-events:none;border:0;border-radius:0;background:transparent;color:#15231b;box-shadow:none;direction:rtl;font-family:Tahoma,Arial,sans-serif;display:flex;flex-direction:column;justify-content:space-between}#m17RouteHead{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px;background:rgba(7,54,37,.96);color:white;font-weight:900;pointer-events:auto;box-shadow:0 2px 12px #0007}#m17RouteClose{border:1px solid #fff8;border-radius:7px;background:#b3261e;color:#fff;padding:7px 10px;font-weight:800}#m17RouteForm{pointer-events:auto;margin:10px 10px 18px;padding:12px;max-width:560px;align-self:center;width:calc(100% - 44px);box-sizing:border-box;border:1px solid #8bd9b2;border-radius:14px;background:rgba(246,251,248,.96);color:#15231b;box-shadow:0 8px 30px #0008;max-height:48vh;overflow:auto}#m17RouteForm label{display:block;font-weight:800;margin:10px 0 5px}#m17RouteDestination{width:100%;box-sizing:border-box;padding:12px;border:1px solid #a6b9ae;border-radius:9px;font:16px Tahoma,Arial,sans-serif;background:#fff;color:#111}#m17RouteStatus{padding:9px;margin-top:9px;border-radius:8px;background:#e7f0eb;font-size:13px;line-height:1.7}#m17RouteResults{margin-top:10px}#m17RouteResults[hidden]{display:none!important}.m17-route-stat{display:flex;justify-content:space-between;gap:10px;padding:10px 8px;border-bottom:1px solid #d2ded6}.m17-route-stat b{color:#086b3d}.m17-route-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.m17-route-actions button{flex:1;min-width:120px;border:0;border-radius:9px;padding:11px 9px;background:#087d48;color:#fff;font:800 13px Tahoma,Arial,sans-serif}.m17-route-actions button+button{background:#31556a}.m17-route-help{font-size:12px;line-height:1.7;color:#43534a;margin:5px 0}
@media(max-width:480px){#m17RouteToggle{left:calc(50% + 52px);top:2px;height:2mm;min-height:2mm;font-size:9px;line-height:2mm;padding:0 5px}#m17RouteForm{width:calc(100% - 20px);margin:6px 10px 12px;padding:9px;max-height:52vh}#m17RouteHead{font-size:13px;padding:9px}}

#m17HistoricalModal{position:absolute;inset:0;z-index:150;display:none;align-items:center;justify-content:center;padding:12px;box-sizing:border-box;background:rgba(0,0,0,.82)}#m17HistoricalModal.show{display:flex}#m17HistoricalPanel{position:relative;width:100%;height:100%;max-width:1200px;max-height:900px;display:flex;flex-direction:column;overflow:hidden;border:1px solid #b7d5e5;border-radius:12px;background:#101820;box-shadow:0 8px 30px #000b}#m17HistoricalHead{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 10px;background:#132c3b;color:#fff;font:700 13px Tahoma,Arial,sans-serif}#m17HistoricalClose{border:1px solid #fff8;border-radius:7px;background:#b3261e;color:#fff;font:700 13px Tahoma,Arial,sans-serif;padding:6px 12px;cursor:pointer}#m17HistoricalFrame{flex:1;width:100%;min-height:0;border:0;background:#fff}#m17HistoricalNote{padding:5px 8px;background:#fff8d6;color:#473b11;font:12px Tahoma,Arial,sans-serif;text-align:center}@media(max-width:480px){#m17HistoricalModal{padding:4px}#m17HistoricalPanel{border-radius:8px}#m17HistoricalHead{font-size:12px;padding:7px}#m17HistoricalNote{font-size:10px}}

#m17Map{position:relative;width:100%;height:calc(100vh - 92px);min-height:420px;overflow:hidden;background:#000;touch-action:none;user-select:none;-webkit-user-select:none}
#m17MiladTower{position:absolute;left:0;top:0;z-index:5;display:block;transform:translate(-50%,-100%);pointer-events:none;text-align:center;filter:drop-shadow(0 2px 4px rgba(0,0,0,.55))}
#m17MiladTower .m17-tower-icon{display:block;font-size:28px;line-height:28px;text-shadow:0 1px 2px #fff}
#m17MiladTower .m17-tower-label{display:inline-block;margin-top:2px;padding:2px 7px;border-radius:8px;background:rgba(0,0,0,.72);color:#fff;font:800 12px Tahoma,Arial,sans-serif;white-space:nowrap;direction:rtl}
/* V188: My Location control + marker */
/* V192: clean Google-Maps-style blue My Location control. Keep the working GPS logic from V191 unchanged. */
#m17MyLocationBtn{position:absolute;right:12px;top:52%;transform:translateY(-50%);z-index:60;width:58px;height:58px;padding:0;border:2px solid rgba(70,78,70,.35);border-radius:50%;background:#fff;box-shadow:0 3px 12px rgba(0,0,0,.48),inset 0 1px 2px rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center;cursor:pointer;touch-action:manipulation;overflow:hidden;pointer-events:auto}
#m17MyLocationBtn:active{transform:translateY(-50%) scale(.93);background:#f3f6fb}
.m17-location-icon{position:relative;width:31px;height:31px;border:3px solid #4285f4;border-radius:50%;box-sizing:border-box;background:#fff;box-shadow:0 0 0 1px rgba(66,133,244,.12)}
.m17-location-icon:before{content:'';position:absolute;left:50%;top:50%;width:9px;height:9px;transform:translate(-50%,-50%);border-radius:50%;background:#4285f4;border:2px solid #fff;box-sizing:border-box;z-index:2}
.m17-location-icon:after{content:'';position:absolute;left:50%;top:50%;width:45px;height:45px;transform:translate(-50%,-50%);background:linear-gradient(#4285f4,#4285f4) center/3px 100% no-repeat,linear-gradient(90deg,#4285f4,#4285f4) center/100% 3px no-repeat;opacity:.95;z-index:1}
#m17UserLocation{position:absolute;left:0;top:0;z-index:8;width:34px;height:34px;display:none;transform:translate(-50%,-50%);border-radius:50% 50% 50% 0;background:#4285f4;border:3px solid #fff;box-shadow:0 2px 9px rgba(0,0,0,.6);pointer-events:none;rotate:-45deg}
#m17UserLocation:after{content:'';position:absolute;left:50%;top:50%;width:9px;height:9px;transform:translate(-50%,-50%) rotate(45deg);border-radius:50%;background:#fff}
/* V192: Undo is above every map layer and physically isolated from map pointer events. */
#m17UndoPointBtn{position:absolute;right:17px;top:calc(52% - 128px);z-index:70;width:50px;height:50px;padding:0;border:2px solid rgba(255,255,255,.98);border-radius:50%;background:#343b35;color:#fff;font-size:26px;font-weight:900;line-height:1;box-shadow:0 3px 12px rgba(0,0,0,.62),inset 0 1px 2px rgba(255,255,255,.25);display:none;align-items:center;justify-content:center;cursor:pointer;touch-action:none;pointer-events:auto;user-select:none;-webkit-user-select:none}
#m17UndoPointBtn.show{display:flex}
#m17UndoPointBtn:active{transform:scale(.91);background:#536e52}
#m17UndoPointBtn span{display:block;transform:translateY(-1px);pointer-events:none}
#m17TapMarker{position:absolute;left:0;top:0;width:24px;height:24px;border-radius:50%;background:#e53935;border:3px solid #fff;box-shadow:0 2px 7px rgba(0,0,0,.55);z-index:6;display:none;transform:translate(-50%,-50%);pointer-events:none}
#m17TapMarker:after{content:'';position:absolute;left:50%;top:50%;width:6px;height:6px;border-radius:50%;background:#fff;transform:translate(-50%,-50%)}
#m17Tiles{position:absolute;inset:0;overflow:hidden;background:#000}
#m17Tiles img{position:absolute;width:256px;height:256px;max-width:none;display:block;user-select:none;-webkit-user-drag:none;pointer-events:none}
#m17GridSvg{position:absolute;inset:0;width:100%;height:100%;z-index:4;pointer-events:none;overflow:hidden;display:none}
#m17GridSvg .m17-grid-line{fill:none;stroke:rgba(0,235,255,.88);stroke-width:1.2;stroke-dasharray:5 4;vector-effect:non-scaling-stroke}
#m17GridSvg .m17-grid-label{font:700 11px Arial,Tahoma,sans-serif;fill:#fff;paint-order:stroke;stroke:#09232c;stroke-width:3px;stroke-linejoin:round}
#m17GoogleMark{position:absolute;right:7px;bottom:7px;padding:2px 5px;border-radius:3px;background:rgba(255,255,255,.88);font:700 12px Arial,sans-serif;color:#555;letter-spacing:.1px;pointer-events:none}
#m17CoordBox{position:absolute;left:10px;top:10px;z-index:5;width:min(460px,calc(100% - 20px));box-sizing:border-box;padding:9px 12px;border-radius:10px;background:rgba(0,0,0,.74);color:#fff;font:700 13px Arial,Tahoma,sans-serif;direction:rtl;text-align:center;pointer-events:none;box-shadow:0 2px 8px rgba(0,0,0,.3);line-height:1.65}
.m17-coord-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:center;direction:rtl}
.m17-coord-row>div{white-space:nowrap;overflow:visible;text-overflow:clip;min-width:0}
.m17-utm-row{text-align:center;font-weight:900;margin-top:3px;padding-top:2px;border-top:1px solid rgba(255,255,255,.22)}
#m17GpsPrompt{display:none;position:absolute;inset:0;z-index:30;align-items:center;justify-content:center;background:rgba(0,0,0,.48);direction:rtl}
#m17GpsPrompt.show{display:flex}
.m17-gps-card{width:min(88%,390px);box-sizing:border-box;padding:20px;border-radius:18px;background:#3f3f43;color:#fff;box-shadow:0 10px 35px rgba(0,0,0,.45);text-align:center}
.m17-gps-title{font-size:20px;font-weight:800;margin-bottom:12px}
.m17-gps-text{font-size:15px;line-height:1.9;color:#eee;margin-bottom:18px}
.m17-gps-actions{display:flex;gap:10px;justify-content:center}
.m17-gps-actions button{border:0;border-radius:12px;padding:12px 18px;font-weight:800;font-size:15px;cursor:pointer}
#m17GpsSettings{background:#4285f4;color:#fff}
#m17GpsClose{background:#666;color:#fff}
</style>
<style id="v261-real-tools-css">
.leica-hero,.real-action-hero{background:linear-gradient(145deg,#eef2ec,#cbd4c8);border:3px solid #687468;border-radius:16px;box-shadow:inset 0 0 0 2px #fff,0 5px 16px rgba(0,0,0,.24)}
.leica-sim-grid,.real-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:9px}
/* V361: Leica sub-pages — unified visual language, logic preserved */
.leica-subpage-title{margin-top:0!important}
.leica-subpage-shell{margin-top:8px}
.leica-panel{border:2px solid #5e6959;border-radius:18px;background:linear-gradient(180deg,rgba(235,240,230,.94),rgba(205,213,198,.92));box-shadow:0 5px 14px rgba(30,45,30,.14);padding:11px;margin-top:8px}
.leica-panel .card-title{font-size:16px;text-align:center}
.leica-panel .subtitle{font-size:11px;line-height:1.65;text-align:center}
.leica-panel .menu1-section-title{text-align:center}
.leica-panel .btn{font-weight:1000}
.leica-status-strip{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}
.leica-status-pill{padding:8px 5px;text-align:center;border:1px solid #8b9585;border-radius:12px;background:rgba(255,255,255,.62);font-size:10px;font-weight:900}
.leica-status-pill b{display:block;font-size:12px;margin-top:2px}
.leica-status-pill.ok{background:#dcefd8;border-color:#67935d;color:#245a20}
@media(max-width:420px){.leica-status-strip{grid-template-columns:1fr 1fr}.leica-panel{padding:10px}}
.leica-sim-card,.real-action-card{min-height:125px;border:3px solid #60705f;border-radius:15px;background:linear-gradient(#e9eee7,#bfc9bc);color:#152015;box-shadow:inset 0 1px #fff,0 4px 10px rgba(0,0,0,.22);font-weight:900;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:10px;text-align:center}
.leica-sim-card:active,.real-action-card:active{transform:scale(.98);background:linear-gradient(#b7dca2,#83b86a)}
.leica-sim-num{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#23552c;color:#fff;border:2px solid #a8c7a6;box-shadow:0 2px 5px rgba(0,0,0,.3);font-size:18px}
.leica-sim-card b,.real-action-card b{font-size:18px}.leica-sim-card small,.real-action-card small{font-size:10px;font-weight:700;line-height:1.5;opacity:.78}
.real-action-card{min-height:135px}.real-action-card span{font-size:30px}.real-action-card.point{background:linear-gradient(#edf5ea,#c8d9c3)}.real-action-card.line{background:linear-gradient(#eef3ec,#c5d2c2)}.real-action-card.area{background:linear-gradient(#e9efe8,#c1cec0)}
.leica-note,.real-hint{margin-top:9px;text-align:center}.real-stake-card{margin-top:8px}
@media(max-width:420px){.leica-sim-card{min-height:112px}.real-action-card{min-height:128px;padding:7px 5px}.leica-sim-card b,.real-action-card b{font-size:15px}.real-action-card small{font-size:9px}.real-action-card span{font-size:27px}}
</style>
<style id="menu18-css">
#menu18{padding:8px 8px 22px;}
.m18-card{background:linear-gradient(145deg,#eef2ec,#cbd4c8);border:3px solid #687468;border-radius:18px;padding:12px;box-shadow:inset 0 0 0 2px #fff,0 5px 16px rgba(0,0,0,.24);text-align:center;overflow:hidden;}
.m18-title{font-size:24px;font-weight:900;color:#182018;margin:2px 0 2px}.m18-sub{font-size:12px;color:#465046;margin-bottom:8px}
.m18-dial-wrap{width:100%;max-width:350px;aspect-ratio:1/1;margin:7px auto 9px;position:relative}.m18-dial{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle,#f9fbf8 0 55%,#e2e8e0 56% 68%,#4b584b 69% 70%,#d9e0d6 71% 100%);border:6px solid #3e4b3e;box-shadow:inset 0 0 22px rgba(0,0,0,.18),0 6px 14px rgba(0,0,0,.27);transition:transform .12s linear;overflow:hidden}.m18-dial:before{content:'';position:absolute;inset:6%;border-radius:50%;background:repeating-conic-gradient(from 0deg,rgba(45,55,45,.75) 0deg 1deg,transparent 1deg 6deg);-webkit-mask:radial-gradient(circle,transparent 0 67%,#000 68% 70%,transparent 71%);mask:radial-gradient(circle,transparent 0 67%,#000 68% 70%,transparent 71%);}.m18-dial:after{content:'';position:absolute;inset:11%;border-radius:50%;border:1px solid rgba(50,60,50,.2);box-shadow:inset 0 0 0 12px rgba(255,255,255,.18)}
.m18-dir{position:absolute;inset:0;display:flex;align-items:flex-start;justify-content:center;padding-top:18px;font-size:27px;font-weight:1000;color:#bd1e1e;text-shadow:0 1px 1px #fff;z-index:2}.m18-dir.south{align-items:flex-end;padding-top:0;padding-bottom:18px;color:#202820}.m18-east,.m18-west{position:absolute;top:50%;transform:translateY(-50%);font-size:25px;font-weight:1000;color:#202820;z-index:2}.m18-east{right:18px;color:#1766d5}.m18-west{left:18px;color:#1766d5}
.m18-needle{position:absolute;left:50%;top:50%;width:0;height:0;border-left:14px solid transparent;border-right:14px solid transparent;border-bottom:100px solid #e43824;transform:translate(-50%,-100%);filter:drop-shadow(0 2px 2px rgba(0,0,0,.4));z-index:4}.m18-needle:after{content:'';position:absolute;left:-14px;top:96px;border-left:14px solid transparent;border-right:14px solid transparent;border-top:100px solid #3a433a}.m18-center{position:absolute;left:50%;top:50%;width:38px;height:38px;border-radius:50%;background:#eef2ec;border:5px solid #313a31;transform:translate(-50%,-50%);z-index:5;box-shadow:0 2px 6px rgba(0,0,0,.35)}
.m18-readout{display:grid;grid-template-columns:1.35fr .65fr;gap:8px;margin:4px 0 9px}.m18-value{background:#182018;color:#f5f8f2;border-radius:11px;padding:8px 5px;border:2px solid #778274}.m18-value strong{display:block;font-size:25px;color:#a9f0a4;direction:ltr}.m18-value span{font-size:11px}.m18-dms{font-size:13px;color:#dfeadf;margin-top:2px;direction:ltr}
.m18-tools{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.m18-tool{border:2px solid #596657;border-radius:11px;background:linear-gradient(#f7faf6,#c8d1c5);min-height:45px;font-size:14px;font-weight:900;color:#182018;box-shadow:0 2px 5px rgba(0,0,0,.16)}.m18-tool.primary{background:linear-gradient(#b6e99e,#70b35b)}.m18-tool.danger{background:linear-gradient(#f5dddd,#ddb5b5)}
.m18-target{margin-top:9px;padding:9px;border-radius:12px;background:rgba(255,255,255,.58);border:1px solid #a9b3a6}.m18-target-title{font-size:13px;font-weight:900;margin-bottom:6px}.m18-target-row{display:grid;grid-template-columns:1fr auto;gap:7px}.m18-target input{width:100%;box-sizing:border-box;border:2px solid #748070;border-radius:9px;padding:10px;text-align:center;font-size:18px;font-weight:900;direction:ltr;background:#fff}.m18-target button{border:0;border-radius:9px;padding:0 13px;font-weight:900;background:#283528;color:#fff}.m18-delta{margin-top:6px;font-weight:900;font-size:14px;min-height:20px}.m18-delta.ok{color:#187a25}.m18-delta.warn{color:#a34b00}
.m18-sensors{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-top:9px}.m18-sensor{background:#f7f9f5;border:1px solid #aeb7aa;border-radius:9px;padding:6px 3px;font-size:10px;color:#4a5448}.m18-sensor b{display:block;font-size:12px;color:#182018;margin-top:2px;direction:ltr}.m18-status{margin-top:8px;font-size:12px;font-weight:800;color:#334033;min-height:20px;line-height:1.6}.m18-note{margin-top:7px;padding:8px;border-radius:9px;background:rgba(255,255,255,.5);font-size:11px;line-height:1.7;color:#394339}
.m18-records{margin-top:10px;text-align:right;background:rgba(255,255,255,.58);border-radius:12px;padding:9px;border:1px solid #adb6aa}.m18-records-title{font-weight:900;font-size:13px;margin-bottom:6px}.m18-record{display:grid;grid-template-columns:.5fr 1fr 1fr 1fr;gap:4px;padding:6px 3px;border-top:1px solid #c5ccc1;font-size:10px;direction:ltr;text-align:center}.m18-record:first-of-type{border-top:0}.m18-record b{font-size:11px}.m18-empty{font-size:11px;color:#687166;text-align:center;padding:5px}
@media(max-width:420px){.m18-title{font-size:21px}.m18-dir{font-size:23px}.m18-east,.m18-west{font-size:21px}.m18-needle{border-bottom-width:88px}.m18-needle:after{top:84px;border-top-width:88px}.m18-tools button{font-size:13px}}
</style>
<style id="v275-real-measure-dashboard">
.m275-dashboard{margin-top:12px}.m2-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:9px}.m2-summary>button{padding:8px 7px;border:1px solid #9ca79a;border-radius:11px;background:#edf1ea;text-align:center;min-width:0;font-family:inherit;cursor:pointer;box-shadow:none}.m2-summary>button:active{transform:scale(.98)}.m2-summary>button.active{background:#dcebd9;border:2px solid #5f8f5c;box-shadow:inset 0 0 0 1px #b7d2b2}.m2-summary span{display:block;font-size:11px;opacity:.78}.m2-summary b{display:block;margin-top:2px;font-size:16px}.m2-measure-details{margin-top:8px;display:grid;gap:6px}.m2-detail-title{font-size:12px;font-weight:1000;text-align:center;padding:5px 0}.m2-detail-empty{padding:9px;text-align:center;border:1px solid #aeb7aa;border-radius:10px;background:#e7ece4;font-size:11px}.m2-detail-item{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:7px;width:100%;padding:8px 9px;border:1px solid #9ca79a;border-radius:10px;background:#edf1ea;font-family:inherit;cursor:pointer;text-align:right}.m2-detail-item b{direction:ltr}.m2-detail-item small{font-size:9px;opacity:.7}.m2-detail-item.active{background:#dcebd9;border:2px solid #5f8f5c;box-shadow:inset 0 0 0 1px #b7d2b2}.m2-legend{display:flex;flex-wrap:wrap;justify-content:center;gap:7px 12px;margin-top:8px;padding:7px 8px;border:1px solid #aeb7aa;border-radius:10px;background:#e7ece4;font-size:10px;font-weight:900}.m2-legend-item{display:inline-flex;align-items:center;gap:5px;white-space:nowrap}.m2-legend-dot{width:9px;height:9px;border-radius:50%;background:#4d9b55;border:2px solid #173d1d;display:inline-block}.m2-legend-line{width:22px;height:0;border-top:3px solid #2e6b35;display:inline-block}.m2-legend-area{width:18px;height:10px;border:2px solid #2e6b35;background:rgba(75,125,78,.18);display:inline-block;border-radius:2px}.m2-live-result{padding:10px 12px;border:2px solid #879181;border-radius:12px;background:#e9eee7;font-weight:900;text-align:center;min-height:20px}.m2-quick-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.m2-quick-actions .btn{margin:0;min-height:42px}@media(max-width:520px){.m2-summary span{font-size:10px}.m2-summary b{font-size:14px}}.m275-title{font-weight:1000;font-size:17px;margin:0 0 8px;display:flex;justify-content:space-between;align-items:center;gap:8px}.m275-badge{display:inline-flex;min-width:28px;height:24px;padding:0 8px;border-radius:12px;align-items:center;justify-content:center;background:#234f2b;color:#fff;font-size:12px}.m275-sketch{padding:8px;border:2px solid #7d8a78;border-radius:16px;background:linear-gradient(145deg,#eef2ea,#dfe6dd)}#m275Sketch{display:block;width:100%;height:215px;border:1px solid #7c8678;border-radius:12px;background:#edf2e9}.m275-table-wrap{overflow:auto;border:2px solid #879181;border-radius:14px;background:#f5f7f2}.m275-table{width:100%;border-collapse:collapse;min-width:590px;font-size:11px}.m275-table th,.m275-table td{border-bottom:1px solid #c8cec5;padding:8px 5px;text-align:center;white-space:nowrap}.m275-table th{background:#dfe6dc;font-weight:1000}.m275-table tr:last-child td{border-bottom:0}.m275-output-list{display:grid;gap:7px}.m275-output{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 10px;border:1px solid #9ca79a;border-radius:11px;background:#e9eee7;min-width:0;box-sizing:border-box}.m275-output>div{min-width:0;flex:1 1 auto;overflow:hidden}.m275-output-name{font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.m275-output-desc{font-size:10px;opacity:.72;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.m275-output .btn{margin:0;padding:8px 9px;min-width:72px;flex:0 0 72px;font-size:11px;box-sizing:border-box;white-space:nowrap}@media(max-width:520px){#m275Sketch{height:195px}.m275-table{min-width:560px}.m275-output{align-items:center;padding:8px}.m275-output .btn{min-width:68px;flex-basis:68px;font-size:10px}}.m277-area-bar{margin-top:8px;padding:10px 12px;border:2px solid #879181;border-radius:12px;background:#e5ebe2;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:13px}.m277-area-bar b{font-size:15px;color:#234f2b;direction:ltr}.m277-clear-btn{width:100%;margin-top:9px;min-height:44px;font-size:13px}@media(max-width:520px){.m277-area-bar{font-size:12px}.m277-area-bar b{font-size:14px}}

/* V280 — Menu 3 real Stake Out import/list system */
.stake3-import-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.stake3-import-btn{min-height:48px;font-size:13px}.stake3-zone-row{display:grid;grid-template-columns:1.15fr .45fr;gap:7px;align-items:center;margin-top:9px;padding:9px 10px;border:1px solid #9ca79a;border-radius:12px;background:#e8eee6}.stake3-zone-row label{font-size:11px;font-weight:900}.stake3-zone-row input{width:100%;box-sizing:border-box;text-align:center;border:2px solid #879181;border-radius:9px;padding:8px;background:#f7f8f5;font-weight:900}.stake3-zone-row span{grid-column:1/-1;font-size:10px;opacity:.7}.stake3-progress{margin-top:9px;padding:10px;border:2px solid #879181;border-radius:12px;background:#e5ebe2;text-align:center;font-weight:1000;color:#234f2b}.stake3-list{margin-top:9px;border:2px solid #879181;border-radius:13px;background:#f4f6f1;overflow:hidden}.stake3-row{display:grid;grid-template-columns:40px 1fr 1.2fr 82px;gap:5px;align-items:center;padding:9px 8px;border-bottom:1px solid #c8cec5;font-size:11px}.stake3-row:last-child{border-bottom:0}.stake3-row.active{background:#dcebd8;box-shadow:inset 4px 0 0 #3d7d42}.stake3-row.done{opacity:.68}.stake3-status{font-size:16px;text-align:center}.stake3-point{font-weight:1000}.stake3-coord{direction:ltr;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:monospace}.stake3-go{min-height:34px!important;padding:5px 6px!important;font-size:10px!important}.stake3-empty{padding:16px;text-align:center;opacity:.7}.stake3-clear{width:100%;margin-top:9px;min-height:44px}.stake3-manual-title{margin-top:13px;padding-top:11px;border-top:2px solid #879181;font-weight:1000;font-size:14px}.stake3-live-launch{margin-top:10px!important}.stake3-importing{opacity:.65;pointer-events:none}@media(max-width:520px){.stake3-import-grid{grid-template-columns:1fr}.stake3-row{grid-template-columns:34px 1fr 1.35fr 72px;font-size:10px}.stake3-zone-row{grid-template-columns:1fr .5fr}}
</style>
<style id="m6e-final-layout-v470">
.m6e-tabs{display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;gap:5px!important;width:100%!important;max-width:100%!important;min-width:0!important;overflow:hidden!important;box-sizing:border-box!important;}
.m6e-tab{flex:1 1 0!important;width:auto!important;min-width:0!important;max-width:none!important;margin:0!important;padding:3px 1px!important;height:50px!important;min-height:50px!important;box-sizing:border-box!important;overflow:hidden!important;white-space:normal!important;}
.m6e-tab small{display:block!important;max-width:100%!important;overflow:hidden!important;white-space:nowrap!important;text-overflow:ellipsis!important;font-size:8px!important;line-height:1.1!important;}
.m6e-preview{height:360px!important;max-height:360px!important;overflow-x:auto!important;overflow-y:scroll!important;-webkit-overflow-scrolling:touch!important;touch-action:pan-x pan-y!important;overscroll-behavior:contain!important;box-sizing:border-box!important;width:100%!important;max-width:100%!important;} .m6e-preview table{width:max-content!important;min-width:620px!important;margin:0!important;}
</style>
<style id="m6e-v478-fix">
/* V478: only CSS; Excel/SheetJS JavaScript is unchanged from V475. */
.m6e-shell,.m6e-shell *{box-sizing:border-box;}
.m6e-shell{width:100%;max-width:100%;min-width:0;overflow:hidden;}
.m6e-tabs{display:grid!important;grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:4px!important;width:100%!important;max-width:100%!important;min-width:0!important;overflow:hidden!important;}
.m6e-tabs>.m6e-tab{width:100%!important;min-width:0!important;max-width:100%!important;overflow:hidden!important;padding:4px 1px!important;white-space:nowrap!important;text-overflow:ellipsis!important;}
.m6e-tabs>.m6e-tab small{display:block!important;max-width:100%!important;overflow:hidden!important;white-space:nowrap!important;text-overflow:ellipsis!important;font-size:8px!important;}
.m6e-panel{width:100%;max-width:100%;min-width:0;overflow:hidden;}
.m6e-preview{width:100%!important;max-width:100%!important;min-width:0!important;height:360px!important;max-height:360px!important;overflow:auto!important;-webkit-overflow-scrolling:touch!important;touch-action:pan-x pan-y!important;overscroll-behavior:contain!important;}
.m6e-preview table{width:max-content!important;min-width:760px!important;max-width:none!important;}
@media(max-width:560px){.m6e-tabs{grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:3px!important;}.m6e-tabs>.m6e-tab{min-height:50px!important;font-size:10px!important;}.m6e-tabs>.m6e-tab small{font-size:7px!important;}}
</style>
<style id="miladgeo-menu11-v2-style">
/* MENU 11 — rebuilt from zero */
.m11v2{direction:rtl;background:linear-gradient(145deg,#f7fbf3,#e8f1e3);border:1px solid #b9cbb2;border-radius:22px;padding:12px;box-shadow:0 12px 30px rgba(44,65,40,.13);margin:0 auto 18px;max-width:1100px}
.m11v2-head{background:linear-gradient(135deg,#ffffff,#eaf3e6);border:1px solid #c9d9c2;border-radius:17px;padding:16px 14px;text-align:center;margin-bottom:10px}
.m11v2-kicker{font-size:10px;font-weight:900;letter-spacing:.8px;color:#70866b}.m11v2-title{font-size:22px;font-weight:950;color:#2f5435;margin-top:4px}.m11v2-sub{font-size:11px;color:#6a776b;margin-top:5px;line-height:1.7}
.m11v2-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:9px auto;max-width:620px;justify-content:center}.m11v2-tab{border:1px solid #c3d4bc;background:#fff;color:#465a48;border-radius:12px;padding:10px 5px;font-weight:900;font-size:11px;cursor:pointer}.m11v2-tab span{display:inline-flex;width:22px;height:22px;border-radius:50%;align-items:center;justify-content:center;background:#e7f0e3;margin-left:4px;color:#4c7047}.m11v2-tab.active{background:#d9e9d4;border-color:#8ead84;color:#294f30;box-shadow:inset 0 -3px 0 #67935e}.m11v2-panel{display:none}.m11v2-panel.active{display:block}
.m11v2-card{background:#fff;border:1px solid #ccdcca;border-radius:17px;padding:13px;margin-top:8px;box-shadow:0 6px 18px rgba(45,66,42,.07)}.m11v2-card h3{margin:0;color:#315638;font-size:17px}.m11v2-card p{margin:4px 0 12px;color:#758076;font-size:11px}.m11v2-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.m11v2-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.m11v2-field label{display:block;font-size:10px;font-weight:900;color:#5c6c5d;margin-bottom:4px}.m11v2 input,.m11v2 select{width:100%;box-sizing:border-box;border:1px solid #c5d5bf;background:#fbfdf9;border-radius:9px;padding:9px 8px;color:#304334;font-size:12px;outline:none}.m11v2 input:focus,.m11v2 select:focus{border-color:#80a875;box-shadow:0 0 0 3px #edf5e9}.m11v2-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.m11v2-btn{border:0;border-radius:10px;padding:9px 13px;font-weight:900;font-size:11px;cursor:pointer}.m11v2-btn.main{background:#68945f;color:#fff}.m11v2-btn.alt{background:#e1eedc;color:#3d633b;border:1px solid #bfd3b9}.m11v2-btn.light{background:#f5f8f3;color:#536255;border:1px solid #d4dfd1}.m11v2-note{background:#f2f8ef;border-right:4px solid #7fa875;border-radius:9px;padding:9px;margin-top:9px;color:#59695b;font-size:10px;line-height:1.8}.m11v2-tablewrap{overflow:auto;border:1px solid #d6e1d2;border-radius:11px;margin-top:10px}.m11v2-table{width:100%;border-collapse:collapse;min-width:760px}.m11v2-table th{background:#e9f2e5;color:#486448;font-size:10px;padding:8px;white-space:nowrap}.m11v2-table td{border-top:1px solid #edf1eb;padding:5px;text-align:center;font-size:10px}.m11v2-table td input,.m11v2-table td select{padding:6px 5px;font-size:10px}.m11v2-badge{display:inline-block;padding:3px 7px;border-radius:20px;background:#e8f2e4;color:#4d7048;font-weight:900}.m11v2-status{background:#f5f9f3;border:1px dashed #b5c9ae;border-radius:10px;padding:10px;color:#687569;font-size:11px;margin-top:9px;white-space:pre-line;line-height:1.8}.m11v2-file{display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:#f5f9f3;border:1px dashed #abc2a4;border-radius:11px;padding:9px;color:#667367;font-size:10px}.m11v2-file input{width:auto;border:0;background:none;padding:0}.m11v2-hidden{display:none!important}.m11v2-small{font-size:10px;color:#7a857b}.m11v2-kmlbox{min-height:50px}.m11v2-danger{color:#8a4d4d}.m11v2 .ltr{direction:ltr;text-align:left}
@media(max-width:700px){.m11v2-tabs{grid-template-columns:repeat(2,1fr)}.m11v2-grid,.m11v2-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.m11v2-title{font-size:19px}.m11v2-card{padding:11px}.m11v2-actions .m11v2-btn{flex:1 1 auto}}

/* MiladGeo M11 v501 */
.m11v2-list-status-hidden{display:none!important}
.m11v2-resultbox{
  max-height:320px!important;
  overflow:auto!important;
  -webkit-overflow-scrolling:touch!important;
  overscroll-behavior:contain;
}
.m11v2-resultbox .m11v2-table{
  width:max-content!important;
  min-width:760px!important;
}
.m11v2-resultbox .m11v2-table thead th{
  position:sticky;
  top:0;
  z-index:2;
}
.m11v2-output-actions-below{
  margin-top:10px!important;
  display:grid!important;
  grid-template-columns:1fr 1fr;
  gap:7px!important;
}
.m11v2-output-actions-below .m11v2-btn{
  min-height:42px;
}
.m11v2-output-actions-below .m11v2-convert-big{
  grid-column:1/-1;
  min-height:50px!important;
  padding:12px 18px!important;
  font-size:13px!important;
  border-radius:12px!important;
}
@media(max-width:700px){
  .m11v2-output-actions-below .m11v2-btn{flex:initial!important}
}

/* MiladGeo M11 v502 */
.m11v2-output-actions-below{
  grid-template-columns:1fr 1fr!important;
}
.m11v2-output-actions-below .m11v2-convert-big{
  grid-column:1/-1!important;
}

/* MiladGeo M11 v503 */
.m11v2-output-actions-below .m11v2-btn{min-height:44px}
.m11v2-manual-middle-actions{margin:10px 0 0!important;display:grid!important;grid-template-columns:1fr 1fr 1fr;gap:7px!important}.m11v2-manual-middle-actions .m11v2-btn{min-height:44px}@media(max-width:700px){.m11v2-manual-middle-actions .m11v2-btn{min-width:0;padding:9px 6px}}

/* MiladGeo M11 v505 — force clean list-conversion system area */
#m11v2p1 .m11v2-sysrow + p,
#m11v2p1 .m11v2-sysrow + .m11v2-note,
#m11v2p1 .m11v2-sysrow + .m11v2-help,
#m11v2p1 .m11v2-sysrow + .m11v2-status{
  display:none!important;
}

/* M11 v506: remove only the explanatory note under the fixed PENZD mapping */
#m11v2p1 .m11v2-note,
#m11v2p1 .m11v2-help,
#m11v2p1 .m11v2-explain,
#m11v2p1 .m11v2-desc-note,
#m11v2p1 .m11v2-small-note{
  display:none!important;
}
</style>
<style id="m20-note-style">
#m20Desk{direction:rtl;color:#243226}
#m20Desk .m20-hero{padding:14px;border:2px solid #6f7f3b;border-radius:16px;background:linear-gradient(145deg,#dce8b5,#b9cc86);box-shadow:inset 0 1px rgba(255,255,255,.8),0 4px 10px rgba(20,35,20,.16);text-align:center}
#m20Desk .m20-hero-title{font-size:21px;font-weight:1000}.m20-hero-sub{font-size:10px;line-height:1.8;color:#596457;margin-top:5px}
#m20Desk .m20-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
#m20Desk .m20-card.wide{grid-column:1 / -1;min-height:92px}
#m20Desk .m20-card{min-height:105px;border:2px solid #657264;border-radius:13px;background:linear-gradient(#f3f6f1,#dfe7dc);box-shadow:inset 0 1px #fff,0 3px 8px rgba(25,40,25,.12);padding:12px;color:#253226;text-align:center;font-family:inherit;cursor:pointer;touch-action:manipulation}
#m20Desk .m20-card.primary{border-color:#4b8a50;background:linear-gradient(#e7f4e5,#cfe4ce)}
#m20Desk .m20-card:active{transform:scale(.985)}
#m20Desk .m20-card b{display:block;font-size:15px;margin-bottom:6px}.m20-card span{display:block;font-size:10px;line-height:1.6;color:#596457}.m20-card .m20-num{display:inline-flex;align-items:center;justify-content:center;min-width:25px;height:25px;border-radius:50%;background:#4b514a;color:#fff;font:900 11px Arial;margin-left:6px;vertical-align:middle}
#m20Desk .m20-panel{margin-top:10px;padding:11px;border:2px solid #59655a;border-radius:13px;background:rgba(237,242,233,.82)}
#m20Desk .m20-panel h3{margin:0 0 9px;font-size:15px}.m20-row{display:flex;gap:7px;flex-wrap:wrap}.m20-row>*{flex:1;min-width:110px}
#m20Desk input,#m20Desk textarea,#m20Desk select{width:100%;box-sizing:border-box;border:1px solid #7b8778;border-radius:9px;background:rgba(255,255,255,.86);padding:9px;font:700 12px/1.6 Arial,Tahoma,sans-serif;color:#202a22}
#m20Desk textarea{min-height:78px;resize:vertical}.m20-btns{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-top:8px}.m20-btns .btn{min-height:43px}
#m20Desk .m20-canvas-wrap{margin-top:8px;border:2px solid #586558;border-radius:12px;overflow:hidden;background:#fff;position:relative;touch-action:none;height:min(500px,60vh);min-height:320px}.m20-sketch-tools{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;align-items:center;margin:9px 0 4px;padding:8px;border:1px solid #9aa795;border-radius:12px;background:#e8eee5}.m20-sketch-tools .btn{min-width:0;width:100%;white-space:nowrap;font-size:12px;padding:8px 3px}.m20-sketch-tools span{font-size:11px;text-align:center;color:#174c3a;font-weight:900;background:#fff;border-radius:8px;padding:10px 2px}.m20-sketch-tools .btn{min-height:40px}.m20-sketch-tools span{font-size:10px;text-align:center;color:#596558;font-weight:800}
#m20Canvas{display:block;width:100%;height:470px;background:#fff;touch-action:none}
#m20Desk .m20-toolbar{display:grid;grid-template-columns:repeat(6,1fr);gap:5px;margin-top:7px}.m20-toolbar .btn{min-width:0;min-height:42px;padding:5px 3px;font-size:10px;font-weight:900}.m20-toolbar .active{outline:3px solid rgba(75,138,80,.25);border-color:#4b8a50;background:#dcebd9}
#m20Desk .m20-color{height:42px;padding:4px}.m20-meta{font-size:10px;line-height:1.7;color:#5c665a;margin-top:7px}.m20-note-list{display:grid;gap:7px;margin-top:8px}.m20-note-item{padding:9px;border:1px solid #7d897a;border-radius:10px;background:rgba(255,255,255,.62)}.m20-note-item b{display:block;font-size:12px}.m20-note-item small{display:block;color:#687367;margin-top:3px}.m20-note-item .m20-preview{margin-top:5px;white-space:pre-wrap;font-size:10px;line-height:1.6;max-height:65px;overflow:hidden}
#m20Desk .m20-check{display:grid;gap:6px;margin-top:8px}.m20-check label{display:flex;align-items:center;gap:7px;padding:8px;border:1px solid #879185;border-radius:8px;background:rgba(255,255,255,.55);font-size:11px}.m20-check input{width:auto}
#m20Desk .m20-report{background:#fff;border:1px solid #909990;border-radius:10px;padding:12px;line-height:1.9;font-size:11px;white-space:pre-wrap}.m20-hidden{display:none!important}
#m20Desk .m20-photo-box{border:2px dashed #71806f;border-radius:10px;padding:12px;text-align:center;background:rgba(255,255,255,.45)}
#m20Desk .m20-photo-box img{max-width:100%;max-height:360px;border-radius:8px;display:block;margin:8px auto 0}.m20-photo-input{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
#m20Desk .m20-sketch-pro-tools{display:grid;gap:7px;margin-top:8px;padding:9px;border:1px solid #879181;border-radius:11px;background:#e8eee5}.m20-sketch-toolrow{display:grid;grid-template-columns:auto minmax(90px,1fr) auto minmax(80px,.8fr);gap:6px;align-items:center}.m20-sketch-toolrow label{font-size:10px;font-weight:900;white-space:nowrap}.m20-sketch-toolrow select{min-width:0;height:39px;padding:5px}.m20-sketch-toolrow input[type=color]{width:100%;height:39px;padding:3px}.m20-sketch-toolrow button{min-height:39px;padding:5px}.m20-infinite-wrap{height:min(64vh,650px)!important;min-height:390px!important;background-color:#fff!important;overflow:hidden!important;overscroll-behavior:contain}.m20-infinite-wrap canvas{position:absolute;inset:0;width:100%;height:100%}.m20-infinite-hint{position:absolute;bottom:7px;left:7px;z-index:2;pointer-events:none;padding:4px 7px;border-radius:7px;background:rgba(255,255,255,.82);font-size:9px;color:#596558}@media(max-width:560px){.m20-sketch-toolrow{grid-template-columns:auto minmax(0,1fr) auto minmax(0,1fr)}.m20-infinite-wrap{height:58vh!important;min-height:350px!important}.m20-sketch-tools{grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;padding:6px}.m20-sketch-tools .btn{font-size:10px;padding:7px 1px;min-height:38px}.m20-sketch-tools span{font-size:10px;padding:8px 1px}}
@media(max-width:560px){#m20Desk .m20-grid{grid-template-columns:1fr 1fr}.m20-card.wide{grid-column:1 / -1}.m20-card{min-height:118px!important;padding:10px 7px!important}.m20-card b{font-size:13px!important}.m20-card span{font-size:9px!important}.m20-toolbar{grid-template-columns:repeat(3,1fr)!important}#m20Canvas{height:430px}.m20-btns{grid-template-columns:1fr}}
</style>
<style id="market-mini-link-style">
.market-mini-link{display:flex;align-items:center;gap:10px;margin:8px 0 2px;padding:9px 12px;min-height:54px;box-sizing:border-box;text-decoration:none;color:#243427;direction:rtl;border:2px solid #657b64;border-radius:13px;background:linear-gradient(145deg,#e8eee3,#c7d5c2);box-shadow:inset 0 1px 0 rgba(255,255,255,.95),0 3px 7px rgba(14,35,18,.22);font-family:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
.market-mini-link:active{transform:scale(.99);box-shadow:inset 0 2px 5px rgba(20,40,20,.15)}.market-mini-icon{width:39px;height:39px;flex:0 0 39px;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:22px;background:linear-gradient(145deg,#2c7140,#17472b);box-shadow:inset 0 1px 2px rgba(255,255,255,.45),0 2px 5px rgba(0,0,0,.2)}.market-mini-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px;text-align:center;align-items:center}.market-mini-copy strong{font-size:13px;line-height:1.45;font-weight:900}.market-mini-copy small{font-size:10px;line-height:1.4;color:#526351;display:flex;align-items:center;justify-content:center;gap:5px;text-align:center;width:100%}.market-mini-dot{display:inline-block;width:8px;height:8px;flex:0 0 8px;border-radius:50%;background:#8a9488;box-shadow:0 0 0 2px rgba(90,110,90,.12)}.market-mini-arrow{font-size:22px;font-weight:900;color:#315d37;padding:0 3px}

/* v858: equal-size employment and online materials market buttons */
.market-mini-link{height:78px;min-height:78px;}
</style>
<style id="miladgeo-v11-welcome-css">

/* MiladGeo V11 — first-install welcome + visual field academy */
#mgV11WelcomeOverlay{position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;padding:12px;background:rgba(7,14,9,.82);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);direction:rtl;font-family:inherit}
#mgV11WelcomeOverlay.mg-open{display:flex}
#mgV11WelcomePanel{position:relative}
#mgV11WelcomeClose{position:absolute;z-index:20;top:9px;left:9px;width:30px;height:30px;min-width:30px;min-height:30px;padding:0;border:1px solid rgba(255,255,255,.8);border-radius:50%;background:rgba(20,32,23,.72);color:#fff;font:700 21px/27px Tahoma,Arial,sans-serif;display:grid;place-items:center;cursor:pointer;box-shadow:0 2px 8px #0005}
#mgV11WelcomeClose:active{transform:scale(.94)}
#mgV11WelcomePanel{width:min(760px,100%);height:min(72vh,760px);min-height:430px;display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(202,224,194,.7);border-radius:22px;background:linear-gradient(145deg,#f5f8f2,#dce7d7);box-shadow:0 24px 80px rgba(0,0,0,.48);color:#172319}
#mgV11WelcomeHero{position:relative;flex:0 0 36%;min-height:140px;background:#17251b;overflow:hidden}
#mgV11WelcomeHero img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;display:block;opacity:.94}
#mgV11WelcomeHero:after{content:"";position:absolute;inset:35% 0 0;background:linear-gradient(transparent,rgba(5,16,9,.84))}
#mgV11WelcomeBrand{position:absolute;z-index:1;right:18px;bottom:14px;color:#fff;text-shadow:0 2px 8px #000}
#mgV11WelcomeBrand b{display:block;font-size:clamp(22px,5vw,34px);font-weight:1000;letter-spacing:.4px}
#mgV11WelcomeBrand span{font-size:12px;font-weight:800;color:#e3f1df}
#mgV11WelcomeBody{padding:14px 16px 12px;overflow:auto;min-height:0;flex:1}
#mgV11WelcomeBody h2{font-size:18px;margin:0 0 5px;color:#183a20}
#mgV11WelcomeBody .mg-intro{font-size:12px;line-height:1.8;color:#435044;margin:0 0 10px}
#mgV11LessonGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.mg-v11-lesson{display:flex;align-items:center;gap:9px;min-width:0;text-align:right;border:1px solid #a9b9a3;border-radius:13px;padding:6px;background:rgba(255,255,255,.72);color:#203322;cursor:pointer}
.mg-v11-lesson:active{transform:scale(.985)}
.mg-v11-lesson img{width:76px;height:55px;flex:0 0 76px;object-fit:cover;border-radius:9px;background:#d6dfd2}
.mg-v11-lesson b{display:block;font-size:12px;line-height:1.4}
.mg-v11-lesson small{display:block;color:#637064;font-size:9px;margin-top:3px;line-height:1.45}
#mgV11LessonDetail{display:none;margin-top:12px;padding:14px 15px;border-radius:14px;background:linear-gradient(145deg,#f0f6ec,#e1eddd);border:1px solid #91a88b;font-size:12px;line-height:2;color:#263b29;box-shadow:0 3px 12px #244b2512}
#mgV11LessonDetail.mg-show{display:block}
#mgV11LessonDetail .mg-lesson-title{display:block;font-size:15px;color:#174d27;margin-bottom:7px}
#mgV11LessonDetail .mg-lesson-intro{margin:0 0 9px}
#mgV11LessonDetail .mg-lesson-subtitle{display:block;margin:8px 0 3px;color:#1f5c30;font-weight:900}
#mgV11LessonDetail ol{margin:3px 0 8px;padding-right:20px}
#mgV11LessonDetail li{padding-right:2px;margin:2px 0}
#mgV11LessonDetail .mg-lesson-tip,#mgV11LessonDetail .mg-lesson-practice{margin-top:8px;padding:8px 10px;border-radius:10px;background:#ffffffb8;border-right:3px solid #43814a}
#mgV11LessonGrid{grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch}
.mg-v11-lesson{min-height:72px}
.mg-v11-lesson img{object-fit:cover}

#mgV11LessonDetail.mg-show{display:block}
#mgV11WelcomeActions{display:flex;gap:8px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));border-top:1px solid #c3d0be;background:#edf3e9}
#mgV11WelcomeActions button{flex:1;min-height:42px;border:0;border-radius:12px;font-weight:1000;font-size:12px;cursor:pointer}
#mgV11StartBtn{background:linear-gradient(135deg,#287b39,#145327);color:white;box-shadow:0 4px 10px #245d3238}
#mgV11TutorialBtn{background:#fff;color:#24532b;border:1px solid #8ba486!important}
/* V12: tutorial entry lives inside the main MENU, not as a floating button. */
@media(max-width:480px){#mgV11WelcomeOverlay{padding:8px}#mgV11WelcomePanel{height:72vh;min-height:390px;border-radius:18px}#mgV11WelcomeHero{flex-basis:31%;min-height:115px}#mgV11WelcomeBody{padding:10px}#mgV11LessonGrid{gap:6px}.mg-v11-lesson{gap:6px;padding:5px}.mg-v11-lesson img{width:62px;height:48px;flex-basis:62px}.mg-v11-lesson b{font-size:11px}.mg-v11-lesson small{font-size:8px}#mgV11WelcomeActions{padding:8px 10px calc(8px + env(safe-area-inset-bottom))}}

</style>
<style id="m10-card-photo-icon-size">
/* منوی ۱۰: عکس‌ها در جای آیکن کارت، نه به‌صورت تصویر بزرگ */
.m10-new-card .m10-card-photo{
  display:flex !important;
  align-items:center;
  justify-content:center;
  width:66px !important;
  height:66px !important;
  min-width:66px;
  flex:0 0 66px !important;
  overflow:hidden;
  border-radius:15px;
  border:1px solid #bfd2bd;
  background:#e3eee2;
  box-shadow:0 2px 7px rgba(35,75,42,.12);
}
.m10-new-card .m10-card-photo img{
  display:block;
  width:100% !important;
  height:100% !important;
  object-fit:cover;
  border-radius:13px;
}
.m10-new-card-main .m10-card-photo{
  width:76px !important;
  height:76px !important;
  min-width:76px;
  flex-basis:76px !important;
  border-radius:17px;
}
.m10-new-card-main .m10-card-photo img{border-radius:15px}
@media(max-width:420px){
  .m10-new-card .m10-card-photo{
    width:60px !important;height:60px !important;min-width:60px;flex-basis:60px !important;
  }
  .m10-new-card-main .m10-card-photo{
    width:68px !important;height:68px !important;min-width:68px;flex-basis:68px !important;
  }
}
</style>
<style id="menu3-modern-redesign-v1">
/* Menu 3 redesign. Scoped only to #realStake; all original interaction IDs remain intact. */
#realStake{direction:rtl;color:#14251a;padding-bottom:14px}
#realStake>.back{display:inline-flex;align-items:center;justify-content:center;min-height:42px;margin:2px 0 10px;padding:0 16px;border:1px solid #536a56;border-radius:13px;background:linear-gradient(180deg,#f1f5ee,#c8d4c7);color:#17351f;font-weight:1000;box-shadow:0 3px 8px rgba(0,0,0,.18)}
#realStake>.title{display:none}
#realStake .m3-stake-hero{position:relative;isolation:isolate;min-height:190px;overflow:hidden;border:2px solid #dce8d9;border-radius:22px;background:#193d29;box-shadow:0 7px 18px rgba(12,28,17,.28);margin:0 0 12px}
#realStake .m3-stake-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 48%;z-index:-2}
#realStake .m3-stake-hero-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(7,24,15,.88),rgba(9,35,19,.55) 62%,rgba(8,27,15,.14));}
#realStake .m3-stake-hero-copy{position:relative;z-index:1;max-width:82%;padding:19px 17px 17px;color:#f5fff2;text-shadow:0 2px 5px rgba(0,0,0,.55)}
#realStake .m3-stake-kicker{display:inline-block;font:900 9px Arial,sans-serif;letter-spacing:1.4px;color:#d5f4cf;border:1px solid rgba(223,255,218,.5);background:rgba(13,53,26,.52);padding:5px 9px;border-radius:20px}
#realStake .m3-stake-hero h1{font-family:Tahoma,Arial,sans-serif;font-size:25px;line-height:1.35;font-weight:1000;margin:10px 0 5px;color:#fff}
#realStake .m3-stake-hero p{font-family:Tahoma,Arial,sans-serif;font-size:11px;line-height:1.9;margin:0;max-width:410px;color:#edf7e9}
#realStake .m3-stake-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
#realStake .m3-stake-tags span{font:900 9px Arial,Tahoma,sans-serif;padding:5px 9px;border-radius:20px;background:rgba(235,248,232,.17);border:1px solid rgba(234,255,228,.56);color:#fff}
#realStake .m3-stake-hero-index{position:absolute;left:13px;bottom:8px;font:1000 52px/1 Arial,sans-serif;color:rgba(255,255,255,.23);letter-spacing:-4px}
#realStake .m3-stake-flow{display:grid;grid-template-columns:1fr 16px 1fr 16px 1fr;align-items:center;gap:4px;margin:0 0 12px;padding:9px 7px;border:1px solid #a7b8a3;border-radius:15px;background:linear-gradient(140deg,#f0f5ed,#d5e1d2);box-shadow:inset 0 1px #fff,0 3px 9px rgba(18,35,20,.10)}
#realStake .m3-stake-flow>div{display:flex;align-items:center;justify-content:center;gap:6px;min-width:0}
#realStake .m3-stake-flow b{display:inline-flex;flex:0 0 25px;width:25px;height:25px;align-items:center;justify-content:center;border-radius:50%;background:linear-gradient(145deg,#24683d,#123e25);color:#fff;font:900 9px Arial,sans-serif;box-shadow:0 2px 5px rgba(0,0,0,.2)}
#realStake .m3-stake-flow span{font:900 10px Tahoma,Arial,sans-serif;color:#21442a;white-space:nowrap}
#realStake .m3-stake-flow>i{height:2px;background:linear-gradient(90deg,#a5b59f,#527b59);border-radius:2px}
#realStake .m3-stake-panel{box-sizing:border-box;min-width:0;margin:0 0 12px;padding:13px;border:1px solid #899b87;border-radius:19px;background:linear-gradient(145deg,rgba(246,250,243,.97),rgba(211,224,208,.95));box-shadow:0 4px 12px rgba(15,32,17,.14),inset 0 1px rgba(255,255,255,.95);color:#172b1c}
#realStake .m3-stake-panel-heading{display:flex;align-items:center;gap:10px;margin-bottom:5px}
#realStake .m3-stake-heading-symbol{display:inline-flex;align-items:center;justify-content:center;flex:0 0 40px;width:40px;height:40px;border-radius:13px;background:linear-gradient(145deg,#266c40,#124127);color:#fff;font:900 29px/1 Arial,sans-serif;box-shadow:0 3px 7px rgba(16,55,27,.2)}
#realStake .m3-stake-eyebrow{display:block;font:900 8px Arial,sans-serif;letter-spacing:1.2px;color:#63806a;margin-bottom:3px}
#realStake .stake3-search-title{font-family:Tahoma,Arial,sans-serif;font-size:16px;font-weight:1000;text-align:right;margin:0;color:#173d24}
#realStake .m3-stake-pill{margin-right:auto;font:900 9px Tahoma,Arial,sans-serif;padding:6px 9px;border:1px solid #9ab39a;border-radius:20px;color:#2a6035;background:#e1eddd;white-space:nowrap}
#realStake .stake3-search-card{margin:0 0 12px;padding:13px;border:1px solid #879b85;border-radius:19px;background:linear-gradient(145deg,#f3f7ef,#d6e2d3);box-shadow:0 4px 12px rgba(15,32,17,.14)}
#realStake .stake3-search-help{font-family:Tahoma,Arial,sans-serif;font-size:10px;text-align:right;line-height:1.8;opacity:.8;margin:2px 0 9px;padding-right:50px}
#realStake .stake3-search-row{grid-template-columns:minmax(0,1fr) 105px;gap:8px}
#realStake .stake3-search-row input{min-width:0;height:46px;box-sizing:border-box;border:1px solid #95a591;border-radius:12px;background:#fff;color:#162d1b;text-align:center;font:800 16px Arial,sans-serif;box-shadow:inset 0 1px 3px rgba(0,0,0,.08)}
#realStake .stake3-search-btn{border:1px solid #1e5b31!important;border-radius:12px!important;background:linear-gradient(180deg,#347d49,#18522e)!important;color:#fff!important;box-shadow:0 3px 7px rgba(14,54,25,.22)!important}
#realStake .m3-stake-work-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:stretch}
#realStake .m3-stake-work-grid>.m3-stake-panel{margin:0;height:100%}
#realStake .m3-stake-feature-head{display:grid;grid-template-columns:92px minmax(0,1fr);gap:10px;align-items:center;margin:-1px -1px 10px;padding-bottom:10px;border-bottom:1px solid #c1cfbd}
#realStake .m3-stake-feature-head img{display:block;width:92px;height:84px;object-fit:cover;border-radius:13px;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.2)}
#realStake .m3-stake-feature-head h2,#realStake .m3-stake-target-head h2,#realStake .m3-stake-report-copy h2{font-family:Tahoma,Arial,sans-serif;font-size:15px;line-height:1.5;font-weight:1000;margin:2px 0 3px;color:#163d23}
#realStake .m3-stake-feature-head p,#realStake .m3-stake-target-head p,#realStake .m3-stake-report-copy p{font-family:Tahoma,Arial,sans-serif;font-size:9px;line-height:1.8;margin:0;color:#536958}
#realStake .stake3-manual-box,#realStake .stake3-file-box{margin:0;padding:10px;border:1px solid #b2c3ae;border-radius:14px;background:rgba(255,255,255,.46)}
#realStake .stake3-section-title{font-family:Tahoma,Arial,sans-serif;font-size:12px;font-weight:1000;margin:0 0 8px;text-align:right;color:#315a38}
#realStake .stake3-live-methods{gap:7px;margin-bottom:10px}
#realStake .stake3-live-methods .m17-stake-method{min-height:44px;padding:6px 5px;border:1px solid #a0af9c;border-radius:11px;background:linear-gradient(180deg,#f6f8f4,#dce5d9);font-family:Tahoma,Arial,sans-serif;font-size:11px;color:#24422b;box-shadow:0 2px 4px rgba(0,0,0,.08)}
#realStake .stake3-live-methods .m17-stake-method.active{border:1px solid #276b3d;background:linear-gradient(180deg,#9ed18d,#5c9b57);color:#102a17;box-shadow:inset 0 1px rgba(255,255,255,.7),0 2px 5px rgba(29,87,42,.2)}
#realStake .stake3-live-grid{gap:8px}
#realStake .stake3-live-grid .m17-stake-field label{font:900 10px Tahoma,Arial,sans-serif;color:#425b45;margin-bottom:4px}
#realStake .stake3-live-grid .m17-stake-field input{min-height:43px;padding:7px 9px;border:1px solid #9ba997;border-radius:10px;background:#fff;font:800 15px Arial,sans-serif;box-shadow:inset 0 1px 3px rgba(0,0,0,.06)}
#realStake .stake3-live-launch{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;min-height:54px;margin:11px 0 0!important;border:1px solid #14542b;border-radius:13px;background:linear-gradient(180deg,#57a866,#206b3b)!important;color:#fff!important;font:1000 15px Tahoma,Arial,sans-serif;box-shadow:0 4px 9px rgba(16,70,31,.25),inset 0 1px rgba(255,255,255,.25)}
#realStake .stake3-live-launch span{display:inline-flex;align-items:center;justify-content:center;font-size:22px}
#realStake .m3-stake-note{font:9px/1.8 Tahoma,Arial,sans-serif;color:#657568;text-align:center;margin:9px 2px 0}
#realStake .stake3-file-help{font:9px/1.8 Tahoma,Arial,sans-serif;text-align:right;color:#647366;opacity:1;margin:0 0 9px}
#realStake .stake3-import-grid{grid-template-columns:1fr;gap:8px;margin:0 0 9px}
#realStake .m3-stake-import-card{display:grid!important;grid-template-columns:64px minmax(0,1fr) 20px;align-items:center;gap:9px;width:100%;min-width:0;min-height:72px!important;margin:0!important;padding:6px!important;border:1px solid #a6b5a2!important;border-radius:13px!important;background:linear-gradient(145deg,#f8faf6,#e1e9de)!important;color:#193c24!important;text-align:right!important;box-shadow:0 2px 6px rgba(21,52,27,.09)!important}
#realStake .m3-stake-import-card img{width:64px;height:58px;object-fit:cover;border-radius:9px;border:1px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.15)}
#realStake .m3-import-card-copy{display:block;min-width:0}
#realStake .m3-import-card-copy b{display:block;font:1000 12px Arial,Tahoma,sans-serif;color:#1d4d2b}
#realStake .m3-import-card-copy small{display:block;margin-top:4px;font:9px/1.5 Tahoma,Arial,sans-serif;color:#67776a;white-space:normal}
#realStake .m3-import-card-arrow{font:1000 18px Arial,sans-serif;color:#4f8856;text-align:center}
#realStake .stake3-load-btn{width:100%;min-height:45px!important;margin:0 0 8px!important;border:1px solid #255c34!important;border-radius:11px!important;background:linear-gradient(180deg,#d6e8d1,#a9c9a2)!important;color:#173a20!important;font:1000 12px Tahoma,Arial,sans-serif!important;box-shadow:0 2px 5px rgba(20,60,28,.12)!important}
#realStake .stake3-zone-row{grid-template-columns:minmax(0,1fr) 70px;gap:6px;margin-top:8px;padding:8px;border:1px solid #bfccba;border-radius:11px;background:#eef3eb}
#realStake .stake3-zone-row label{font:900 9px Tahoma,Arial,sans-serif;color:#4c654f}
#realStake .stake3-zone-row input{min-height:38px;border:1px solid #a0af9d;border-radius:9px;background:#fff;font:900 14px Arial,sans-serif}
#realStake .stake3-zone-row span{font:9px/1.6 Tahoma,Arial,sans-serif;color:#68776a;grid-column:1/-1;overflow-wrap:anywhere}
#realStake .m3-stake-target-panel{margin-top:12px}
#realStake .m3-stake-target-head{display:flex;align-items:center;gap:11px;margin-bottom:9px}
#realStake .m3-stake-target-icon{flex:0 0 48px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:14px;background:linear-gradient(145deg,#286c40,#164327);color:#fff;font:1000 31px Arial,sans-serif;box-shadow:0 3px 8px rgba(18,65,31,.2)}
#realStake .stake3-progress{margin:0 0 8px;padding:10px;border:1px solid #9eb39a;border-radius:12px;background:linear-gradient(90deg,#e3efe0,#f5f8f2);font:1000 12px Tahoma,Arial,sans-serif;color:#225531}
#realStake .stake3-list{margin:0;border:1px solid #b1c0ad;border-radius:13px;background:#f8faf6;overflow:hidden}
#realStake .stake3-row{grid-template-columns:31px minmax(0,1fr) minmax(0,1.25fr) 67px;gap:5px;padding:9px 6px;font:10px Tahoma,Arial,sans-serif;color:#1d3022}
#realStake .stake3-row.active{background:#e0efdc;box-shadow:inset -4px 0 0 #39834a}
#realStake .stake3-go{min-height:35px!important;border-radius:9px!important;background:linear-gradient(180deg,#dcebd8,#b7d2b1)!important;color:#174125!important;border:1px solid #8eab88!important;font-weight:1000!important}
#realStake .stake3-clear{width:100%;min-height:43px;margin-top:9px;border:1px solid #a7b4a4;border-radius:11px;background:linear-gradient(180deg,#edf1eb,#d3dbd0);color:#5e302c;font:900 11px Tahoma,Arial,sans-serif}
#realStake .m3-stake-report-panel{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px}
#realStake .m3-stake-report-panel .btn{flex:0 0 auto;min-height:44px;padding:0 13px;border:1px solid #225c32;border-radius:11px;background:linear-gradient(180deg,#4d995c,#216b3b);color:#fff;font:1000 11px Tahoma,Arial,sans-serif;box-shadow:0 3px 7px rgba(20,65,30,.19)}
#realStake .m3-stake-report-copy{min-width:0}
#realStake .stake3-selected-grid{gap:6px}
#realStake .stake3-selected-cell{border:1px solid #c0cec0;border-radius:9px;background:#edf3ea;padding:8px 5px}
#realStake .stake3-selected-cell b{font:900 11px Arial,sans-serif;color:#1d3f26}
#realStake .stake3-search-result{border:1px solid #aac0a7;border-radius:12px;background:#f7faf4}
@media(max-width:700px){#realStake .m3-stake-work-grid{grid-template-columns:1fr}#realStake .m3-stake-work-grid>.m3-stake-panel{height:auto}}
@media(max-width:430px){#realStake .m3-stake-hero{min-height:178px}#realStake .m3-stake-hero-copy{max-width:88%;padding:16px 13px}#realStake .m3-stake-hero h1{font-size:21px}#realStake .m3-stake-flow{gap:2px;padding:8px 4px}#realStake .m3-stake-flow>div{gap:4px}#realStake .m3-stake-flow b{width:22px;height:22px;flex-basis:22px;font-size:8px}#realStake .m3-stake-flow span{font-size:9px}#realStake .m3-stake-feature-head{grid-template-columns:78px minmax(0,1fr)}#realStake .m3-stake-feature-head img{width:78px;height:75px}#realStake .stake3-search-row{grid-template-columns:minmax(0,1fr) 92px}#realStake .m3-stake-report-panel{align-items:stretch;flex-direction:column}#realStake .m3-stake-report-panel .btn{width:100%}}
</style>
<style id="m275-output-copy-polish">
/* Indexxx97: clearer, readable output cards in Menu 2 */
.m275-output{gap:10px;padding:11px 10px;align-items:center}
.m275-output>div.m275-output-copy{min-width:0;flex:1 1 auto;overflow:hidden}
.m275-output-title{font-size:13px;font-weight:1000;line-height:1.55;color:#21462b;white-space:normal;overflow-wrap:anywhere}
.m275-output-desc{font-size:11px;line-height:1.65;opacity:.82;margin-top:2px;white-space:normal;overflow:visible;text-overflow:clip}
.m275-output-file{font-size:9px;line-height:1.4;margin-top:3px;color:#667565;opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:left;font-family:Arial,sans-serif}
.m275-output .btn{min-width:88px;flex:0 0 88px;font-size:10px;white-space:normal;line-height:1.45;padding:8px 5px}
@media(max-width:520px){
 .m275-output{gap:8px;padding:9px 8px}
 .m275-output-title{font-size:12px}
 .m275-output-desc{font-size:10px;line-height:1.55}
 .m275-output .btn{min-width:82px;flex-basis:82px;font-size:10px}
}
</style>
<style id="miladgeo-v132-photo-headers">
/* V132: Bring Menu 18 and Menu 20 to the same photographic hero language as Menu 2 and Menu 3. */
.m18-pro-hero,.m20-pro-hero{position:relative;isolation:isolate;min-height:190px;overflow:hidden;border:2px solid #dce8d9;border-radius:22px;background:#193d29;box-shadow:0 7px 18px rgba(12,28,17,.28);margin:0 0 12px}
#menu18 .m18-pro-hero-img,#menu20 .m20-pro-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 48%;z-index:-2}
#menu18 .m18-pro-hero-shade,#menu20 .m20-pro-hero-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(7,24,15,.88),rgba(9,35,19,.55) 62%,rgba(8,27,15,.14))}
#menu18 .m18-pro-hero-copy,#menu20 .m20-pro-hero-copy{position:relative;z-index:1;max-width:84%;padding:19px 17px 17px;color:#f5fff2;text-shadow:0 2px 5px rgba(0,0,0,.55)}
.m18-pro-kicker,.m20-pro-kicker{display:inline-block;font:900 9px Arial,sans-serif;letter-spacing:1.4px;color:#d5f4cf;border:1px solid rgba(223,255,218,.5);background:rgba(13,53,26,.52);padding:5px 9px;border-radius:20px}
.m18-pro-hero h1,.m20-pro-hero h1{font-family:Tahoma,Arial,sans-serif;font-size:25px;line-height:1.35;font-weight:1000;margin:10px 0 5px;color:#fff}
.m18-pro-hero p,.m20-pro-hero p{font-family:Tahoma,Arial,sans-serif;font-size:11px;line-height:1.9;margin:0;max-width:440px;color:#edf7e9}
.m18-pro-tags,.m20-pro-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.m18-pro-tags span,.m20-pro-tags span{font:900 9px Arial,Tahoma,sans-serif;padding:5px 9px;border-radius:20px;background:rgba(235,248,232,.17);border:1px solid rgba(234,255,228,.56);color:#fff}
.m18-pro-index,.m20-pro-index{position:absolute;left:13px;bottom:8px;font:1000 52px/1 Arial,sans-serif;color:rgba(255,255,255,.23);letter-spacing:-4px}
@media(max-width:420px){.m18-pro-hero,.m20-pro-hero{min-height:178px}#menu18 .m18-pro-hero-copy,#menu20 .m20-pro-hero-copy{max-width:90%;padding:16px 13px 15px}.m18-pro-hero h1,.m20-pro-hero h1{font-size:22px}.m18-pro-hero p,.m20-pro-hero p{font-size:10px;line-height:1.8}}
</style>
<style id="m10-m16-pro-photo-headers-v1">
#cadpdf .m10-pro-hero,#training .m16-pro-hero{position:relative;isolation:isolate;min-height:190px;overflow:hidden;border:2px solid #dce8d9;border-radius:22px;background:#193d29;box-shadow:0 7px 18px rgba(12,28,17,.28);margin:0 0 12px}
#cadpdf .m10-pro-hero-img,#training .m16-pro-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 48%;z-index:-2}
#cadpdf .m10-pro-hero-shade,#training .m16-pro-hero-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(7,24,15,.88),rgba(9,35,19,.55) 62%,rgba(8,27,15,.14))}
#cadpdf .m10-pro-hero-copy,#training .m16-pro-hero-copy{position:relative;z-index:1;max-width:86%;padding:19px 17px 17px;color:#f5fff2;text-shadow:0 2px 5px rgba(0,0,0,.55)}
#cadpdf .m10-pro-hero-kicker,#training .m16-pro-hero-kicker{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border:1px solid rgba(255,255,255,.42);border-radius:999px;background:rgba(5,20,12,.36);font:900 9px/1.4 Arial,Tahoma,sans-serif;letter-spacing:1.1px;color:#fff}
#cadpdf .m10-pro-hero h1,#training .m16-pro-hero h1{font-family:Tahoma,Arial,sans-serif;font-size:25px;line-height:1.35;font-weight:1000;margin:10px 0 5px;color:#fff}
#cadpdf .m10-pro-hero p,#training .m16-pro-hero p{font-family:Tahoma,Arial,sans-serif;font-size:11px;line-height:1.9;margin:0;max-width:450px;color:#edf7e9}
