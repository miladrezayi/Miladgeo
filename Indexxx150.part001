<style id="miladgeo-v136-menu1-photo-header-and-simulator-entry">
/* V136: Leica Menu 1 photographic hero plus an unmistakable entry card for the external TS02 simulator. */
#leica .leica-photo-pro-hero{position:relative;isolation:isolate;min-height:190px;overflow:hidden;border:2px solid #dce8d9;border-radius:22px;background:#193d29;box-shadow:0 7px 18px rgba(12,28,17,.28);margin:0 0 12px}
#leica .leica-photo-pro-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 48%;z-index:-2}
#leica .leica-photo-pro-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(7,24,15,.88),rgba(9,35,19,.55) 62%,rgba(8,27,15,.14))}
#leica .leica-photo-pro-copy{position:relative;z-index:1;max-width:88%;padding:19px 17px 17px;color:#f5fff2;text-shadow:0 2px 5px rgba(0,0,0,.55)}
#leica .leica-photo-pro-kicker{display:inline-block;font:900 9px Arial,sans-serif;letter-spacing:1.2px;color:#d5f4cf;border:1px solid rgba(223,255,218,.5);background:rgba(13,53,26,.52);padding:5px 9px;border-radius:20px}
#leica .leica-photo-pro-hero h1{font-family:Tahoma,Arial,sans-serif;font-size:25px;line-height:1.35;font-weight:1000;margin:10px 0 5px;color:#fff}
#leica .leica-photo-pro-hero p{font-family:Tahoma,Arial,sans-serif;font-size:11px;line-height:1.9;margin:0;max-width:470px;color:#edf7e9}
#leica .leica-photo-pro-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
#leica .leica-photo-pro-tags span{font:900 9px Arial,Tahoma,sans-serif;padding:5px 9px;border-radius:20px;background:rgba(235,248,232,.17);border:1px solid rgba(234,255,228,.56);color:#fff}
#leica .leica-photo-pro-index{position:absolute;left:13px;bottom:8px;font:1000 52px/1 Arial,sans-serif;color:rgba(255,255,255,.23);letter-spacing:-3px;pointer-events:none}
#leica .leica-v36-featured{grid-column:1/-1;position:relative;min-height:154px!important;padding:12px 12px 13px!important;gap:5px!important;border:2px solid #d2b66a!important;border-radius:17px!important;background:linear-gradient(135deg,#183b28 0%,#245b36 58%,#173824 100%)!important;color:#fff!important;box-shadow:0 5px 14px rgba(14,43,24,.28),inset 0 1px rgba(255,255,255,.2)!important}
#leica .leica-v36-featured:active{transform:scale(.985);background:linear-gradient(135deg,#285f3b,#143321)!important}
#leica .leica-v36-featured .leica-sim-num{width:30px;height:30px;flex:0 0 30px;background:#d8b85f!important;color:#172b1d!important;border:2px solid #fff1be!important;font-size:16px!important;box-shadow:0 2px 6px rgba(0,0,0,.28)}
#leica .leica-v36-eyebrow{font:900 8px/1.4 Arial,Tahoma,sans-serif;letter-spacing:1.2px;color:#f4df9b;padding:3px 8px;border:1px solid rgba(244,223,155,.48);border-radius:20px;background:rgba(0,0,0,.16)}
#leica .leica-v36-featured b{font:1000 18px/1.3 Arial,Tahoma,sans-serif!important;letter-spacing:.3px;color:#fff!important}
#leica .leica-v36-featured small{font:800 10px/1.5 Tahoma,Arial,sans-serif!important;color:#e5f1e3!important;opacity:1!important}
#leica .leica-v36-entry{display:flex;align-items:center;justify-content:center;gap:8px;width:min(100%,340px);min-height:37px;margin-top:4px;padding:6px 12px;border:1px solid #ead28b;border-radius:11px;background:linear-gradient(180deg,#f0d88f,#d2ad50);color:#26351e;font:1000 11px/1.4 Tahoma,Arial,sans-serif;box-shadow:0 2px 5px rgba(0,0,0,.22),inset 0 1px rgba(255,255,255,.45)}
#leica .leica-v36-entry-icon{font:1000 17px/1 Arial,sans-serif}
@media(max-width:430px){#leica .leica-photo-pro-hero{min-height:178px}#leica .leica-photo-pro-copy{max-width:94%;padding:16px 13px 15px}#leica .leica-photo-pro-hero h1{font-size:21px}#leica .leica-photo-pro-hero p{font-size:10px;line-height:1.8}#leica .leica-photo-pro-kicker{font-size:8px}#leica .leica-photo-pro-tags span{font-size:7px}#leica .leica-v36-featured{min-height:148px!important}#leica .leica-v36-featured b{font-size:16px!important}#leica .leica-v36-entry{font-size:10px;min-height:35px}}
</style>

<style id="miladgeo-137-unified-rtl-hero">

/* Indexxx137: unify RTL alignment for every photographic/pro hero header */
header[class*="hero"] > div[class*="hero-copy"],
header[class*="hero"] > div[class*="photo-pro-copy"],
header[class*="hero"] > div[class*="pro-copy"] {
  direction: rtl !important;
  text-align: right !important;
  margin-left: auto !important;
  margin-right: 0 !important;
  max-width: 84% !important;
  box-sizing: border-box;
}
header[class*="hero"] > div[class*="hero-copy"] h1,
header[class*="hero"] > div[class*="photo-pro-copy"] h1,
header[class*="hero"] > div[class*="pro-copy"] h1,
header[class*="hero"] > div[class*="hero-copy"] p,
header[class*="hero"] > div[class*="photo-pro-copy"] p,
header[class*="hero"] > div[class*="pro-copy"] p {
  direction: rtl !important;
  text-align: right !important;
  margin-right: 0 !important;
  margin-left: auto !important;
}
header[class*="hero"] > div[class*="hero-copy"] [class*="tags"],
header[class*="hero"] > div[class*="photo-pro-copy"] [class*="tags"],
header[class*="hero"] > div[class*="pro-copy"] [class*="tags"] {
  direction: rtl !important;
  justify-content: flex-start !important;
}
@media (max-width: 420px) {
  header[class*="hero"] > div[class*="hero-copy"],
  header[class*="hero"] > div[class*="photo-pro-copy"],
  header[class*="hero"] > div[class*="pro-copy"] {
    max-width: 88% !important;
    padding-right: 15px !important;
    padding-left: 15px !important;
  }
}

</style>
</head>
