<style>
/* X6: load real Persian web fonts (requires network on first use). */
@import url("https://fonts.googleapis.com/css2?family=Estedad:wght@100..900&family=Vazirmatn:wght@100..900&display=swap");

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0;width:100%;min-height:100%;background:#222722}
body{font-family:"Courier New",monospace;color:#11170f;overflow-x:hidden}
button,input,select,a{font:inherit}a{text-decoration:none;color:inherit}

.app{
 width:100%;
 max-width:100%;
 min-height:100vh;
 padding:7px;
 background:linear-gradient(145deg,#c5cbbf,#7d8879 7%,#4b574b 13%,#222a22 18%,#171c17 82%,#4e594d 90%,#aab3a4);
}
.device{
 width:100%;
 min-height:calc(100vh - 14px);
 padding:7px;
 border:3px solid #394238;
 border-radius:25px;
 background:linear-gradient(145deg,#a9b89f,#70806b 18%,#4f5c4c 80%,#9eaa96);
 box-shadow:inset 0 0 0 2px #c7d0bf,inset 0 0 20px #1d241d,0 4px 15px #000;
}
.screenFrame{
 width:100%;
 min-height:calc(100vh - 28px);
 padding:7px;
 background:#282d27;
 border:4px solid #171b17;
 box-shadow:inset 0 0 0 2px #555a51;
}
.screen{
 width:100%;
 min-height:calc(100vh - 42px);
 padding:10px;
 background:
  repeating-linear-gradient(0deg,rgba(20,28,18,.025) 0 1px,transparent 1px 4px),
  radial-gradient(ellipse at 50% 20%,rgba(230,235,215,.32),transparent 58%),
  #aeb6a0;
 border:2px solid #4e544a;
 box-shadow:inset 0 0 22px rgba(20,25,18,.28);
}

.header{
 display:flex;justify-content:space-between;align-items:center;
 min-height:34px;padding:3px 2px 8px;
 border-bottom:2px solid #4b5147;font-weight:bold;font-size:14px
}
.logo{letter-spacing:1px}.status{font-size:10px}

.page{display:none}.page.active{display:block}
.title{font-size:17px;font-weight:bold;padding:12px 0 7px;border-bottom:2px solid #4b5147;margin-bottom:10px}
.subtitle{font-size:10px;margin:4px 0 9px;color:#414b3e}

.card{
 padding:9px;margin-bottom:9px;
 border:2px solid #4d5349;
 background:rgba(190,196,177,.38);
 box-shadow:inset 0 0 9px rgba(255,255,255,.12)
}
.card-title{font-weight:bold;font-size:13px;margin-bottom:8px}

.menu-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.menu-btn{
 min-width:0;
 cursor:pointer;touch-action:manipulation;min-height:66px;padding:8px;text-align:center;
 border:2px solid #3d433b;border-radius:4px;
 background:linear-gradient(#d3d6cb,#a9aea3);
 color:#10160f;font-weight:bold;
 box-shadow:inset 0 1px #f4f5ef,0 2px #20251f;
 display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;overflow:hidden
}
.menu-btn.locked{opacity:.43}
.menu-num{font-size:18px;margin-right:0;line-height:1.05;display:inline-block}
.menu-label{display:inline-block;font-size:18px;line-height:1.15;text-align:center}
.menu-state{display:block;margin:5px 0 0;font-size:9px;line-height:1.2;text-align:center}
.menu16-state{font-size:18px!important;line-height:1.15!important;margin-top:3px!important}


.setup-status{display:grid;gap:3px}
/* V356 — Professional Leica-style Menu 1 / Reference Line */

/* V356 — Integrated Leica workflow / Job-driven Station-Orientation-Measure-Line */
.leica-sim-grid{grid-template-columns:1fr 1fr}
.leica-sim-card.line{background:linear-gradient(#e9eee7,#bfc9bc)}
.leica-sim-card.leica-v36-card{grid-column:1 / -1;}
@media(max-width:420px){.leica-sim-card.leica-v36-card{grid-column:1 / -1;}}
.menu1-job-card{margin-top:8px;padding:11px 12px;border:2px solid #687468;border-radius:14px;background:linear-gradient(145deg,#f0f3ed,#d6ddd2);box-shadow:inset 0 1px #fff,0 3px 9px rgba(30,45,30,.18)}
.menu1-job-card .job-line{display:flex;align-items:center;justify-content:space-between;gap:8px}.menu1-job-card .job-name{font-size:19px;font-weight:1000;direction:ltr;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.menu1-job-card .job-tick{font-size:20px;color:#216b2a;font-weight:1000}.menu1-job-card .job-sub{font-size:10px;margin-top:5px;color:#4d584b}
.menu1-point-select{margin-top:7px;padding:9px;border:1px solid #8c9687;border-radius:11px;background:rgba(255,255,255,.72)}.menu1-point-select .select-title{font-weight:1000;font-size:11px;margin-bottom:5px}.menu1-point-select .select-row{display:grid;grid-template-columns:1fr auto;gap:7px}.menu1-point-select .select-row .btn{min-width:96px}
.menu1-derived{margin-top:7px;padding:8px;border-radius:10px;background:#eef2ec;border:1px solid #a5afa1;font-size:10px;line-height:1.7;text-align:center;direction:rtl}.menu1-derived b{direction:ltr;display:inline-block}
.menu1-manual-note{margin-top:6px;font-size:9px;opacity:.72;text-align:center}
.leica-flow-card{margin-top:9px}.leica-flow-card .card-title{font-size:15px}.leica-flow-card .subtitle{line-height:1.7}
.leica-line-result{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:8px}.leica-line-result>div{padding:8px 3px;text-align:center;background:#edf1ea;border:1px solid #9aa394;border-radius:9px}.leica-line-result small{display:block;font-size:8px}.leica-line-result b{display:block;font-size:11px;margin-top:2px;direction:ltr}
@media(max-width:560px){.leica-line-result{grid-template-columns:1fr 1fr}.menu1-point-select .select-row{grid-template-columns:1fr}.menu1-point-select .select-row .btn{width:100%}}

.menu1-pro{border:2px solid #5e6959;border-radius:18px;background:linear-gradient(180deg,rgba(235,240,230,.92),rgba(205,213,198,.9));box-shadow:0 5px 14px rgba(30,45,30,.14);padding:11px;margin-top:8px}
.menu1-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:2px 2px 9px;border-bottom:1px solid #8b9585}
.menu1-head b{font-size:18px;letter-spacing:.4px}.menu1-badge{padding:5px 9px;border-radius:12px;background:#eef3eb;border:1px solid #8a9684;font-weight:900;font-size:11px}
.menu1-status-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:9px 0}.menu1-status-card{padding:8px 5px;text-align:center;border:1px solid #8b9585;border-radius:12px;background:rgba(255,255,255,.62)}.menu1-status-card small{display:block;font-size:9px;font-weight:900}.menu1-status-card b{display:block;margin-top:3px;font-size:12px}.menu1-status-card.ok{background:#dcefd8;border-color:#67935d;color:#245a20}.menu1-status-card.off{background:#f0f1ed;color:#626a60}
.menu1-section{margin-top:9px;padding:10px;border:1px solid #8c9687;border-radius:14px;background:rgba(250,252,248,.62)}.menu1-section-title{font-weight:1000;font-size:14px;margin-bottom:7px}.menu1-section-sub{font-size:10px;line-height:1.55;color:#4d584b;margin:-2px 0 8px}.menu1-ref-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.menu1-ref-result{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:8px}.menu1-ref-result div{padding:7px 3px;text-align:center;background:#edf1ea;border:1px solid #9aa394;border-radius:9px}.menu1-ref-result small{display:block;font-size:8px}.menu1-ref-result b{display:block;font-size:11px;margin-top:2px;direction:ltr}.menu1-ref-active{margin-top:8px;padding:8px;border-radius:11px;text-align:center;font-weight:1000;background:#dcefd8;border:1px solid #67935d;color:#245a20}.menu1-ref-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.menu1-current{margin-top:8px;padding:8px 10px;border-radius:11px;background:rgba(255,255,255,.7);border:1px dashed #7f897a;font-size:10px;line-height:1.7;text-align:center}
@media(max-width:560px){.menu1-status-grid{grid-template-columns:1fr 1fr}.menu1-status-grid .menu1-status-card:last-child{grid-column:1/-1}.menu1-ref-result{grid-template-columns:1fr 1fr}.menu1-ref-actions{grid-template-columns:1fr}}
.setup-line{display:flex;justify-content:space-between;padding:6px 2px;border-bottom:1px dotted #73796c;font-size:11px}
.ok{color:#1b5e25;font-weight:bold}.not-ok{color:#596153}

label{display:block;font-size:10px;margin:7px 0 3px}
input,select{
 width:100%;height:37px;padding:0 7px;
 color:#11170f;background:#adb5a1;
 border:2px solid #4a5147;border-radius:3px;
 outline:none;box-shadow:inset 0 2px 6px rgba(0,0,0,.16)
}
.row{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.row3{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.btn-row{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px}
.btn{
 width:100%;min-height:38px;padding:6px;
 color:#11170f;font-weight:bold;
 background:linear-gradient(#d5d8ce,#a7ada1);
 border:2px solid #3d433b;border-radius:4px;
 box-shadow:inset 0 1px #f5f6ef,0 2px #20251f
}
.btn.primary{background:linear-gradient(#dfe2d8,#b5bbae)}
.btn.danger{background:linear-gradient(#c6c6bc,#9ea298)}
.btn.gray{background:#a6aba1}
.back{margin-bottom:7px}

.set-box{
 display:flex;align-items:center;gap:7px;
 padding:7px;margin-top:8px;border:2px solid #4d5349;
 background:rgba(168,176,158,.4)
}
.tick{
 flex:0 0 23px;width:23px;height:23px;border-radius:50%;
 display:flex;align-items:center;justify-content:center;
 border:2px solid #5a6255;color:#555d50
}
.tick.done{background:#3a713e;border-color:#1d4324;color:#eef4e9}
.set-text{font-size:10px}.set-text.done{color:#1b5e25;font-weight:bold}

.result{
 padding:8px;margin-top:8px;border:2px solid #4b5147;
 background:rgba(181,188,168,.35)
}
.result-line{display:flex;justify-content:space-between;gap:8px;padding:6px 0;border-bottom:1px dotted #73796c;font-size:11px}
.result-line:last-child{border-bottom:0}
.result-label{color:#3d473a}.result-value{font-weight:bold;color:#162017;text-align:right}
.az{text-align:center;font-size:20px;font-weight:bold;padding:6px;color:#172219}

.point{
 margin-bottom:7px;border:2px solid #4b5147;background:rgba(184,191,171,.4)
}
.point-head{display:flex;justify-content:space-between;gap:5px;padding:7px;background:rgba(100,111,94,.28)}
.point-name{font-weight:bold}
.point-body{padding:7px}
.coord{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
.coord div{padding:5px;text-align:center;background:rgba(130,140,120,.25)}
.coord span{display:block;font-size:9px;color:#4d574a}.coord b{font-size:10px}
.point-actions{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:6px}
.small-btn{min-height:32px;border:2px solid #42483f;background:linear-gradient(#d0d3c9,#a8ada2);font-weight:bold}
.small-btn.delete{background:linear-gradient(#c2c2b8,#9fa198)}

.empty{text-align:center;padding:22px 7px;border:2px dashed #687061;color:#535d50;font-size:11px}
 .contact-box{margin-top:14px;padding:12px 10px;border:2px solid #4b5a45;background:#10170d;text-align:center;color:#b8c4b1}
 .contact-title{font-size:13px;margin-bottom:8px;color:#d1d9c9}
 .contact-line{font-size:11px;line-height:1.9}
 .contact-line a{color:#b8c4b1;text-decoration:none}
 .contact-note{font-size:9px;margin-top:6px;color:#7f8b78}
/* V530 — راه‌های ارتباطی: تصویر جایگزین کامل کادر قبلی، بدون تغییر ابعاد عرضی کادر */
.contact-box-image{padding:0!important;overflow:hidden!important;line-height:0!important}
.contact-box-image .contact-image{display:block;width:100%;max-width:100%;height:auto;margin:0;padding:0;border:0;object-fit:contain}

 .footer{display:none!important;height:0!important;min-height:0!important;padding:0!important;margin:0!important;border:0!important;font-size:0!important;line-height:0!important}
.bottom-nav{position:fixed;left:0;right:0;bottom:0;z-index:80;display:flex;justify-content:space-between;gap:8px;padding:5px 10px calc(5px + env(safe-area-inset-bottom));background:rgba(22,26,22,.96);border-top:1px solid #596354;box-shadow:0 -2px 6px rgba(0,0,0,.25)}
.bottom-nav button{width:48%;min-height:44px;border:2px solid #6b7567;border-radius:8px;background:linear-gradient(#cfd4ca,#9fa69b);color:#11170f;font-weight:900;font-size:14px;box-shadow:inset 0 1px #f4f6ef,0 2px #111511}
.bottom-nav .nav-menu{text-align:left;padding-left:16px}.bottom-nav .nav-back{text-align:right;padding-right:16px}
body{padding-bottom:62px}

.toast{
 position:fixed;left:50%;bottom:15px;transform:translate(-50%,80px);
 max-width:90%;padding:9px 13px;background:#3d493b;color:#f0f3e9;
 border:2px solid #aeb8a3;border-radius:4px;opacity:0;transition:.2s;z-index:99;
 font-size:11px;text-align:center
}
.toast.show{opacity:1;transform:translate(-50%,0)}

@media(max-width:380px){
 .screen{padding:8px}.menu-grid{gap:5px}.menu-btn{min-height:61px;padding:6px}
 .title{font-size:15px}.row3{gap:4px}.row{gap:5px}
}

/* NO-JS FALLBACK: hash targets still give visible SET feedback */
body:has(#job-set:target) #jobFallbackTick{display:flex}
body:has(#station-set:target) #stationFallbackTick{display:flex}
body:has(#orientation-set:target) #orientationFallbackTick{display:flex}
.fallback-tick{display:none;align-items:center;gap:8px;margin-top:8px;padding:8px;border:1px solid #6d7b66;background:#dfe8d9;color:#165b20;font-weight:800;border-radius:8px}


.area-point{display:grid;grid-template-columns:48px minmax(0,1.25fr) minmax(0,1.25fr) 30px;gap:6px;align-items:end;margin-bottom:7px;padding:8px;border:1px solid #667263;border-radius:9px;background:rgba(255,255,255,.06)}
.area-point .pt-label{font-weight:900;text-align:center;padding-bottom:10px}.area-point input{min-width:0;width:100%;font-size:16px;padding:11px 9px;box-sizing:border-box;letter-spacing:-.2px;}.area-remove{min-height:34px!important;height:34px!important;width:30px!important;padding:2px!important;font-size:18px!important;font-weight:900;line-height:1}.area-export-card{margin-top:12px;padding:12px;border:2px solid #59655a;border-radius:10px;background:rgba(255,255,255,.06)}.area-export-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:8px}.export-btn{font-weight:900;font-size:13px;min-height:48px}.area-export-note{font-size:11px;line-height:1.5;margin-top:8px;opacity:.82}@media(max-width:560px){.area-export-grid{grid-template-columns:1fr}.export-btn{font-size:14px}}
.area-result{margin-top:10px;padding:14px;border:2px solid #35b96b;border-radius:10px;background:#e5efdf;color:#17351b}.area-result .area-value{font-size:26px;font-weight:900}.area-result .area-unit{font-size:16px;font-weight:800}.area-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}
.export-choice-box{margin-top:10px;padding:14px;border:2px solid #1f9d55;border-radius:12px;background:rgba(30,70,45,.28);}
.export-title{font-size:20px;font-weight:900;letter-spacing:.3px;margin-bottom:5px;}
.export-help{font-size:15px;font-weight:700;margin-bottom:10px;}
.export-format{font-size:17px!important;font-weight:800!important;min-height:48px;border:2px solid #35b96b!important;}
.export-big{font-size:18px!important;font-weight:900!important;min-height:52px;padding:12px 16px!important;border:2px solid #9ff0bd!important;box-shadow:0 2px 0 rgba(0,0,0,.25);}

/* V26 additions */
.job-summary-box{min-height:30px;padding:6px 0}.job-nav-wrap{display:flex;justify-content:center;margin-top:8px}.job-nav-wrap .job-nav{display:block;width:auto;min-width:150px;text-align:center;margin:0}
.manual-point-card{margin-top:10px;padding:12px;border:2px solid #59655a;border-radius:10px;background:rgba(255,255,255,.06)}
.manual-point-title{font-size:15px;font-weight:900;margin-bottom:6px}.manual-point-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}
.volume-point{display:grid;grid-template-columns:42px minmax(0,1fr) minmax(0,1fr) minmax(0,1fr) 30px;gap:6px;align-items:end;margin-bottom:7px;padding:8px;border:1px solid #667263;border-radius:9px;background:rgba(255,255,255,.06)}
.volume-point .pt-label{font-weight:900;text-align:center;padding-bottom:10px}.volume-point input{min-width:0;width:100%;font-size:16px;padding:11px 8px;box-sizing:border-box;letter-spacing:-.2px}.volume-remove{min-height:34px!important;height:34px!important;width:30px!important;padding:2px!important;font-size:18px!important;font-weight:900;line-height:1}
.volume-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}.volume-result{margin-top:10px;padding:14px;border:2px solid #35b96b;border-radius:10px;background:#e5efdf;color:#17351b}.volume-result .volume-value{font-size:25px;font-weight:900}.volume-summary{margin-top:10px;padding:10px;border:1px solid #59655a;border-radius:9px}.volume-summary-row{padding:5px 0;border-bottom:1px dotted #697467}.volume-summary-row:last-child{border-bottom:0}.volume-note{font-size:11px;line-height:1.5;margin-top:7px;opacity:.82}
@media(max-width:560px){.volume-point{grid-template-columns:34px minmax(0,1fr) minmax(0,1fr) minmax(0,1fr) 30px;gap:4px}.volume-point input{font-size:15px;padding:10px 6px}.manual-point-actions{grid-template-columns:1fr}}

.library-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.library-card{display:block;padding:10px;border:2px solid #4d5349;border-radius:5px;background:rgba(190,196,177,.22);color:inherit;text-decoration:none;box-shadow:inset 0 1px rgba(255,255,255,.12)}
.library-card b{display:block;font-size:11px;margin-bottom:5px}.library-card span{display:block;font-size:9px;line-height:1.5;opacity:.85}
.library-lesson p{font-size:11px;line-height:1.65;margin:6px 0}.library-lesson{scroll-margin-top:8px}
@media(max-width:560px){.library-grid{grid-template-columns:1fr}}

/* LIBRARY V2 */
.library-head{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.library-search{flex:1;min-width:190px}.library-search input{margin:0;width:100%;box-sizing:border-box}
.library-count{font-size:10px;opacity:.8;padding:7px 9px;border:1px solid #59655a;border-radius:7px;background:rgba(255,255,255,.05)}
.library-tabs{display:flex;gap:5px;overflow-x:auto;padding:6px 0 2px;scrollbar-width:none}.library-tabs::-webkit-scrollbar{display:none}.library-tab{white-space:nowrap;min-height:34px;padding:5px 9px!important;font-size:11px!important}
.library-list{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:7px}.library-item{display:block;padding:11px;border:2px solid #4d5349;border-radius:8px;background:rgba(190,196,177,.18);color:inherit;text-decoration:none;min-height:72px}.library-item b{display:block;font-size:12px;margin-bottom:4px}.library-item span{display:block;font-size:9px;line-height:1.5;opacity:.82}.library-item[data-hidden="1"]{display:none}
.library-category{font-size:12px;font-weight:900;margin:12px 0 5px;padding-bottom:5px;border-bottom:1px solid #59655a}.library-detail{scroll-margin-top:8px}.library-detail p{font-size:11px;line-height:1.7;margin:6px 0}.library-detail .formula{padding:7px;border-radius:7px;background:rgba(0,0,0,.16);font-family:monospace;direction:ltr;text-align:left;font-size:10px}.library-back{margin-top:7px}
.library-empty{display:none;text-align:center;padding:14px;font-size:11px;opacity:.8;border:1px dashed #59655a;border-radius:8px;margin-top:7px}
@media(max-width:560px){.library-list{grid-template-columns:1fr}.library-item{min-height:58px}.library-search{min-width:100%}.library-head{display:block}.library-count{margin-top:6px;text-align:center}}

/* V85 LIBRARY + TRAINING PRO */
.library-tabs{flex-wrap:wrap}.library-tab.active{font-weight:900;box-shadow:inset 0 -3px 0 #17351b}.library-section-note{font-size:10px;line-height:1.6;margin:6px 0 2px;opacity:.8}.library-detail h4{font-size:11px;margin:9px 0 4px}.library-detail ul{margin:5px 0 7px 18px;padding:0;font-size:10px;line-height:1.65}.library-detail li{margin:2px 0}.library-detail .warning{padding:7px;border-left:3px solid #8a5a00;background:rgba(138,90,0,.08);font-size:10px;line-height:1.55}.library-detail .protip{padding:7px;border-left:3px solid #17652a;background:rgba(23,101,42,.08);font-size:10px;line-height:1.55}.library-detail .mini-table{width:100%;border-collapse:collapse;font-size:9px;margin-top:6px}.library-detail .mini-table th,.library-detail .mini-table td{border:1px solid #7b8478;padding:4px;text-align:left}.library-detail .mini-table th{background:rgba(0,0,0,.08)}
.training-topics{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;margin-top:8px}.training-topic-card{padding:9px;border:1px solid #5e685b;border-radius:8px;background:rgba(255,255,255,.08);font-size:10px}.training-topic-card b{display:block;font-size:11px;margin-bottom:3px}.training-checklist{margin-top:8px}.training-check{display:flex;gap:7px;align-items:flex-start;padding:7px 0;border-bottom:1px dotted #697262;font-size:10px;line-height:1.5}.training-check input{margin-top:3px;accent-color:#2d8b46}.training-tip{padding:8px;margin-top:8px;border:1px solid #687263;border-radius:8px;background:rgba(20,28,18,.10);font-size:10px;line-height:1.55}.training-quiz{margin-top:9px;padding:10px;border:2px solid #59655a;border-radius:9px}.training-quiz .q{font-size:11px;font-weight:900;margin:7px 0 4px}.training-quiz button{margin-top:7px}.training-score{font-weight:900;font-size:13px;padding:8px;text-align:center}.training-flow{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}.training-flow .flow{padding:8px;border:1px solid #697262;border-radius:7px;font-size:10px}.training-flow .flow b{display:block;font-size:11px;margin-bottom:3px}.training-reference{font-size:9px;line-height:1.55;opacity:.82;margin-top:7px}@media(max-width:560px){.training-topics,.training-flow{grid-template-columns:1fr}}

/* UNIT CONVERTER */
.unit-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.unit-result{font-size:21px;font-weight:900;text-align:center;padding:14px;border:2px solid #68726a;border-radius:9px;background:rgba(20,28,18,.55);word-break:break-word}.unit-swap{min-width:58px}.unit-note{font-size:12px;opacity:.8;line-height:1.6;margin-top:8px}
@media(max-width:520px){.unit-grid{grid-template-columns:1fr 1fr}.unit-result{font-size:18px}}

.excel-preview{display:block;width:100%;max-width:100%;height:360px;max-height:360px;overflow-x:auto!important;overflow-y:auto!important;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;touch-action:pan-x pan-y;border:1px solid #5b6558;border-radius:8px;background:#f5f6f2;color:#111;font-family:"Courier New",monospace;box-sizing:border-box}.excel-preview table{width:max-content!important;min-width:900px!important;max-width:none!important;border-collapse:collapse}
.excel-preview table{width:100%;border-collapse:collapse;min-width:520px;font-size:11px}.excel-preview th,.excel-preview td{border:1px solid #aeb5aa;padding:5px 6px;text-align:left;white-space:nowrap}.excel-preview th{background:#d9ddd5;position:sticky;top:0;z-index:1}.excel-ok{color:#164d20;font-weight:bold}.excel-bad{color:#8b1717;font-weight:bold}.excel-outputs-ready{border-color:#394b38}.excel-output-disabled{opacity:.55;filter:grayscale(1)}#excelOutputs button:disabled{opacity:.48;filter:grayscale(1);cursor:not-allowed;pointer-events:none}#excelOutputs.excel-ready button:not(:disabled){opacity:1;filter:none;cursor:pointer;pointer-events:auto}

.map-wrap{width:100%;min-height:300px;border:2px solid #394238;background:#d7ddcf;overflow:hidden;border-radius:8px;touch-action:manipulation}
/* V115 GRAPHIC MAP — compact controls / manual entry */
.map-wrap{position:relative;touch-action:none}.map-wrap svg{touch-action:none;user-select:none;-webkit-user-select:none}
.map-manual{margin-top:7px;padding:8px;border:2px solid #59635a;border-radius:9px;background:rgba(190,196,177,.48)}
.map-manual-title{font-weight:900;font-size:12px;margin-bottom:7px}.map-manual-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}.map-manual-grid input{min-width:0}.map-manual-grid .map-point-no{display:none}.map-manual-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:7px}.map-manual-note{font-size:9px;opacity:.78;margin-top:6px;line-height:1.5}
#surveyMap{display:block;width:100%;height:auto;min-height:300px;background:repeating-linear-gradient(0deg,rgba(30,45,25,.05) 0 1px,transparent 1px 20px),repeating-linear-gradient(90deg,rgba(30,45,25,.05) 0 1px,transparent 1px 20px)}
.map-grid-line{stroke:#8d9888;stroke-width:1;opacity:.45}.map-axis{stroke:#4f5a4c;stroke-width:1.5}.map-point{fill:#1f7b39;stroke:#102d17;stroke-width:3;cursor:pointer;pointer-events:all;touch-action:manipulation}.map-point.selected{fill:#e0a400;stroke:#5c4500;stroke-width:4}.map-station{fill:#173d23;stroke:#0b1b0e;stroke-width:3}.map-orient{stroke:#a02c1f;stroke-width:3;stroke-dasharray:8 5}.map-label{font:700 18px Courier New,monospace;fill:#182217;pointer-events:none}.map-arrow{fill:#a02c1f}.map-target{fill:none;stroke:#b13a25;stroke-width:3;stroke-dasharray:7 5}.map-bg{fill:#dfe5d8}.map-border{fill:none;stroke:#455043;stroke-width:2}.map-grid-line{stroke:#879382;stroke-width:1;opacity:.42}.map-axis-label{font:600 10px Courier New,monospace;fill:#52604f}.map-track{fill:none;stroke:#1d6b32;stroke-width:2.5;stroke-dasharray:5 3;opacity:.72}.map-hit{fill:transparent;stroke:transparent;cursor:pointer;pointer-events:all}.map-coord-label{font:600 9px Courier New,monospace;fill:#33452f;pointer-events:none}.map-north text{font:900 15px Courier New,monospace;fill:#1d2b1d}.map-north line{stroke:#1d6b32;stroke-width:3}.map-status{font:700 10px Courier New,monospace;fill:#344332}.map-scale{stroke:#263525;stroke-width:3}.map-scale-label{font:700 9px Courier New,monospace;fill:#33412f}.map-controls{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:7px}.map-controls .btn{min-height:40px}.map-help{margin-top:6px;padding:6px 8px;border:1px dashed #667261;background:rgba(255,255,255,.16);font-size:9px;line-height:1.6;text-align:center}.map-info-head{display:flex;justify-content:space-between;gap:8px;padding-bottom:7px;margin-bottom:7px;border-bottom:1px dotted #697262;font-size:12px}.map-info-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.map-info-grid div{padding:7px 4px;text-align:center;background:rgba(120,135,112,.18);border:1px solid #77806f}.map-info-grid small{display:block;font-size:9px;color:#536050}.map-info-grid b{display:block;font-size:10px;margin-top:3px;word-break:break-all}@media(max-width:560px){.map-controls{grid-template-columns:1fr 1fr}.map-info-grid{grid-template-columns:1fr 1fr}}.training-body{margin-top:9px;padding:12px;border:2px solid #4b5147;background:rgba(190,196,177,.45);line-height:1.65;font-size:12px}
.formula-card{margin-top:8px;padding:10px;border:2px solid #59635a;border-radius:9px;background:rgba(255,255,255,.11)}.formula-title{font-weight:900;font-size:12px;margin-bottom:7px}.formula-text{white-space:pre-wrap;margin:0;padding:9px;border:1px solid #697262;border-radius:7px;background:rgba(20,28,18,.08);font-family:Courier New,monospace;font-size:11px;line-height:1.7;direction:ltr;text-align:left}.formula-note{margin-top:6px;font-size:10px;line-height:1.6;opacity:.82}.flashcard-wrap{margin-top:9px}.flashcard{min-height:150px;border:3px solid #59635a;border-radius:12px;background:linear-gradient(#d6dacd,#adb5a9);box-shadow:inset 0 1px 0 #eef1e9,0 3px 7px rgba(0,0,0,.2);padding:18px;text-align:center;display:flex;flex-direction:column;justify-content:center;align-items:center;cursor:pointer}.flashcard .fc-label{font-size:10px;opacity:.7;margin-bottom:9px}.flashcard .fc-text{font-size:16px;font-weight:900;line-height:1.8}.flashcard .fc-hint{font-size:10px;margin-top:10px;opacity:.72}.quiz-stats{margin-top:10px;padding:10px;border:2px solid #59635a;border-radius:9px;background:rgba(255,255,255,.11)}.quiz-stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;margin-top:7px}.quiz-stat{padding:7px;border:1px solid #697262;border-radius:7px;text-align:center}.quiz-stat b{display:block;font-size:15px;margin-top:2px}
.training-home-grid{display:grid;grid-template-columns:1fr;gap:9px;margin-top:8px}.training-home-btn{width:100%;min-height:62px;text-align:left;padding:10px 12px;border:2px solid #4d564b;border-radius:9px;background:linear-gradient(#c9cec3,#9da59a);box-shadow:inset 0 1px 0 #edf0e8,0 2px 4px rgba(0,0,0,.18);cursor:pointer}.training-home-btn b{display:block;font-size:13px;margin-bottom:4px}.training-home-btn span{font-size:10px;opacity:.8}.training-panel-head{display:flex;justify-content:space-between;gap:6px;align-items:center;flex-wrap:wrap}.training-counter{font-weight:900;font-size:11px}.training-lesson{padding:10px;border:2px solid #59635a;border-radius:9px;background:rgba(255,255,255,.13);line-height:1.8;font-size:11px}.training-lesson h3{margin:0 0 7px;font-size:14px}.training-lesson ul{margin:6px 0 0;padding-right:18px}.quiz-question{padding:10px;border:2px solid #59635a;border-radius:9px;background:rgba(255,255,255,.10);line-height:1.7}.quiz-qtitle{font-weight:900;font-size:12px;margin-bottom:9px}.quiz-option{display:block;padding:8px 7px;margin:5px 0;border:1px solid #737c70;border-radius:7px;background:rgba(255,255,255,.14);cursor:pointer;font-size:11px}.quiz-option input{margin-left:7px}.quiz-result{margin-top:9px;padding:9px;border:2px solid #586258;border-radius:8px;background:rgba(205,214,198,.55);font-size:11px;line-height:1.7}.quiz-correct{font-weight:900;color:#145e23}.quiz-wrong{font-weight:900;color:#8a231b}.quiz-explain{margin-top:5px}.quiz-score{font-size:12px;font-weight:900;text-align:center;padding:8px}.app-lesson-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}.app-lesson-card{padding:8px;border:1px solid #697262;border-radius:7px;background:rgba(255,255,255,.10);font-size:10px;line-height:1.55}.app-lesson-card b{display:block;font-size:11px;margin-bottom:3px}@media(max-width:560px){.app-lesson-grid{grid-template-columns:1fr}}.training-step{padding:8px 0;border-bottom:1px dotted #697262}.training-step:last-child{border-bottom:0}.status-fixed{font-weight:900;color:#135e24}.status-float{font-weight:900;color:#7a5b00}.status-bad{font-weight:900;color:#8a231b}.metric-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:5px}.metric{padding:8px;border:1px solid #697262;background:rgba(255,255,255,.12)}.metric b{display:block;font-size:15px;margin-top:3px}.gcp-row{display:grid;grid-template-columns:1fr 1fr 1fr 1fr 70px;gap:5px;padding:7px;border:1px solid #687263;margin-bottom:5px;font-size:10px;align-items:center}.gcp-row button{min-height:30px}.check-ok{color:#145e23;font-weight:900}.check-warn{color:#795700;font-weight:900}@media(max-width:560px){.gcp-row{grid-template-columns:1fr 1fr 1fr}.gcp-row button{grid-column:1/-1}.map-wrap{min-height:270px}.metric-grid{grid-template-columns:1fr 1fr}}


/* V99 - larger/bold quiz text and smart/formula menu items */
.quiz-question, .question-text, .quiz-title, .quiz-q { font-size: 1.18rem !important; font-weight: 800 !important; line-height: 1.75 !important; }
.quiz-option, .quiz-option label, .option-label, .quiz-choice { font-size: 1.08rem !important; font-weight: 800 !important; line-height: 1.65 !important; }

/* V101 - slightly larger Training menu text */
.training-home-btn b{
  font-size:1.12rem !important;
  font-weight:900 !important;
}
.training-home-btn span{
  font-size:1.02rem !important;
}


/* V103 - centered Training menu cards */
.training-home-btn{
  text-align:center !important;
  direction:rtl;
}
.training-home-btn b,
.training-home-btn span{
  display:block;
  width:100%;
  text-align:center !important;
}


/* V115 — ENGINEERING MODULE */
.eng-home-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}
.eng-home-btn{min-height:92px;padding:14px;border:2px solid #6f9879;border-radius:12px;background:linear-gradient(145deg,#f8fbf7,#e7efe8 58%,#dce8df);box-shadow:inset 0 1px 0 rgba(255,255,255,.95),0 3px 7px rgba(50,70,55,.20);color:#253126;text-align:center;font-weight:900;cursor:pointer;text-shadow:none}
.eng-home-btn b{display:block;font-size:15px;margin-bottom:7px;color:#243329}.eng-home-btn span{display:block;font-size:10px;line-height:1.55;color:#536157;opacity:1}
.eng-section{margin-top:9px;padding:11px;border:2px solid #6b8f73;border-radius:12px;background:linear-gradient(145deg,#f7faf6,#e7eee7 62%,#dce7dd);box-shadow:inset 0 1px 0 rgba(255,255,255,.92),0 3px 8px rgba(50,70,55,.14);color:#29352c}
.eng-section h3{margin:0 0 8px;font-size:14px}.eng-stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.eng-stat{padding:8px;border:1px solid #88a38c;border-radius:9px;text-align:center;background:rgba(255,255,255,.62);box-shadow:inset 0 1px 0 rgba(255,255,255,.9)}.eng-stat b{display:block;font-size:16px;margin-top:3px;color:#243329}
.eng-topic-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}.eng-check{display:flex;gap:7px;align-items:center;padding:8px;border:1px solid #687364;border-radius:7px;background:rgba(255,255,255,.08);font-size:10px}.eng-check input{width:auto;height:auto;accent-color:#2d7b3c}
.eng-exam-box{padding:12px;border:2px solid #4e5a4c;border-radius:9px;background:rgba(255,255,255,.11)}.eng-timer{font-size:24px;font-weight:900;text-align:center;padding:9px;border:2px solid #4f604e;border-radius:8px;background:#dfe6d9;letter-spacing:2px}.eng-qnav{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.eng-qnav button{min-width:40px!important;width:auto!important}.eng-review{margin-top:8px;padding:8px;border:1px dashed #687364;border-radius:7px;font-size:10px;line-height:1.6}.eng-report{font-size:11px;line-height:1.7}.eng-report h3{font-size:14px;margin:10px 0 5px}.eng-report-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px dotted #727b70}.eng-pass{color:#145e23;font-weight:900}.eng-warn{color:#795700;font-weight:900}.eng-fail{color:#8a231b;font-weight:900}
@media(max-width:560px){.eng-home-grid{grid-template-columns:1fr}.eng-stat-grid{grid-template-columns:1fr 1fr}.eng-topic-grid{grid-template-columns:1fr}}

/* MENU 16 — FULL WORKING ENGINEERING & SURVEYING CALCULATOR */
.m16{margin-top:8px}.m16 .short{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:8px}.m16 .short button{min-height:62px;border:2px solid #17633a;border-radius:12px;background:linear-gradient(145deg,#10331f,#081a10);color:#b8ff9f;font-weight:900;font-size:10px}.m16 .short b{display:block;font-size:20px;margin-bottom:3px}.m16disp{background:#020706;border:2px solid #287244;border-radius:17px;padding:8px 11px;margin-bottom:7px;color:#f2fff1}.m16expr{height:20px;color:#71907b;direction:ltr;text-align:left;overflow:hidden}.m16val{height:48px;font-size:31px;font-weight:900;direction:ltr;text-align:right;overflow:hidden;white-space:nowrap}.m16stat{display:flex;justify-content:space-between;color:#74f04c;font-size:10px;direction:ltr}.m16keys{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}.m16keys button{min-height:45px;border-radius:11px;border:2px solid #193c28;background:linear-gradient(#123621,#0b2115);color:#baffaa;font-size:14px;font-weight:900}.m16keys .num{background:linear-gradient(#273032,#171e20);border-color:#3c4748;color:#f5f7f5}.m16keys .ang{background:linear-gradient(#183b4c,#102a35);border-color:#2c6075;color:#aee9ff}.m16keys .danger{background:linear-gradient(#5a292d,#31171a);border-color:#8a3d43;color:#ffb2b2}.m16keys .eq{background:linear-gradient(#86fb50,#3bbd35);border-color:#a0ff80;color:#071006;font-size:20px}.m16keys .zero{grid-column:span 2}.m16panel{display:none;margin-top:8px;padding:9px;border:2px solid #245d3c;background:#09140e;border-radius:12px;color:#e9f7e8}.m16panel.show{display:block}.m16g2{display:grid;grid-template-columns:1fr 1fr;gap:6px}.m16panel input{width:100%;height:38px;background:#06100a;color:#f2fff1;border:1px solid #316846;border-radius:7px;padding:5px;direction:ltr}.m16panel button{margin-top:7px;min-height:38px;width:100%}.m16out{margin-top:7px;padding:7px;background:#030805;border:1px solid #20452e;border-radius:7px;line-height:1.8;font-size:11px;direction:ltr;text-align:left}.m16note{text-align:center;font-size:8px;color:#708678;margin-top:7px}
@media(max-width:380px){.m16 .short button{font-size:8px}}
/* MENU 16 REPORT QUICK BUTTON — V134 */
.m16-report-quick{display:block!important;width:100%!important;min-height:34px!important;height:34px!important;margin:7px 0 0!important;padding:0 8px!important;border:2px solid #a88922!important;border-radius:9px!important;background:linear-gradient(180deg,#f2d96b 0%,#c7a83b 48%,#9c7b20 100%)!important;color:#171405!important;box-shadow:inset 0 1px 1px rgba(255,255,255,.65),0 2px 4px rgba(0,0,0,.35)!important;font-size:10px!important;font-weight:900!important;line-height:30px!important;text-align:center!important;box-sizing:border-box!important}
.m16-report-quick:active{transform:translateY(1px);box-shadow:inset 0 1px 2px rgba(0,0,0,.25)!important}
@media(max-width:380px){.m16-report-quick{height:32px!important;min-height:32px!important;line-height:28px!important;font-size:9px!important}}
.menu-grid .menu-btn{text-align:center;align-items:center;justify-content:center}
.menu-grid .menu-num,.menu-grid .menu-label,.menu-grid .menu-state{width:100%;text-align:center;display:block}
.menu-grid .menu-label{line-height:1.12;white-space:normal}
.menu-grid .menu-state{margin-top:5px}
.menu-grid .menu-btn:nth-child(14),.menu-grid .menu-btn:nth-child(15){min-height:66px}
.menu-grid .menu-btn:nth-child(15) .menu-label{font-size:18px;line-height:1.05;margin-top:4px}
.menu-grid .menu-btn:nth-child(14) .menu-label{font-size:18px;line-height:1.05;margin-top:4px}
.menu-grid .menu-btn:nth-child(14) .menu16-state{font-size:16px!important;margin-top:5px!important}
.m16-report-head{font-size:14px;font-weight:900;margin-bottom:7px}.m16-report-meta{font-size:10px;line-height:1.7;padding:7px;border:1px solid #315b3d;border-radius:7px;background:#07100a;margin-bottom:7px}.m16-report-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:7px}.m16-report-actions button{margin-top:0!important}.m16-report-list{max-height:340px;overflow:auto}.m16-report-item{padding:7px 3px;border-bottom:1px dotted #315b3d;line-height:1.6}
@media(max-width:380px){.m16-report-actions{grid-template-columns:1fr}}
/* MENU 16 V127 fixes — isolated to menu16 */
#m16quick .m16quick-grid{display:grid;grid-template-columns:1fr!important;gap:8px!important}
#m16quick .m16quick-box{width:100%}
#m16quick .m16quick-box input{display:block;width:100%}
#m16quick .m16quick-out{min-height:42px}
#m16survey,#m16coord,#m16quick,#m16report{scroll-margin-top:8px}


/* ===== MILADGEO WINDOWS V5 — PROFESSIONAL DESKTOP MENU ===== */
html.desktop-windows body{background:#0b100d!important}
@media(min-width:1000px){
 html.desktop-windows .screen{max-width:1500px!important;margin:0 auto!important;padding:18px 24px 28px!important}
 html.desktop-windows .title{font-size:24px!important;letter-spacing:.4px!important}
 html.desktop-windows .menu-grid{grid-template-columns:repeat(4,minmax(220px,1fr))!important;gap:14px!important;max-width:1450px!important;margin:14px auto!important}
 html.desktop-windows .menu-btn{min-height:118px!important;padding:14px!important;border:1px solid #3f4d40!important;border-radius:14px!important;background:linear-gradient(145deg,#202a22,#121813)!important;box-shadow:0 7px 18px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.07)!important;display:flex!important;flex-direction:column!important;justify-content:center!important;align-items:center!important;gap:5px!important;color:#edf2e9!important;position:relative!important;overflow:hidden!important}
 html.desktop-windows .menu-btn:before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,rgba(184,204,72,.10),transparent 45%,rgba(255,190,0,.06));pointer-events:none}
 html.desktop-windows .menu-num{position:absolute!important;top:9px!important;left:10px!important;width:28px!important;height:28px!important;line-height:28px!important;border-radius:50%!important;background:#b7cf39!important;color:#10150e!important;font-weight:1000!important;font-size:13px!important;text-align:center!important;box-shadow:0 2px 6px rgba(0,0,0,.35)!important}
 html.desktop-windows .menu-btn .menu-label,html.desktop-windows .menu-btn:not(.locked){font-size:18px!important;font-weight:1000!important}
 html.desktop-windows .menu-state{font-size:11px!important;color:#b8c5b4!important;letter-spacing:.3px!important}
 html.desktop-windows .menu-btn:hover{transform:translateY(-3px)!important;border-color:#b7cf39!important;box-shadow:0 10px 24px rgba(0,0,0,.48),0 0 0 1px rgba(183,207,57,.16)!important;filter:none!important}
 html.desktop-windows .menu-btn.locked{opacity:.48!important}
 html.desktop-windows #points .card{max-width:1250px;margin-left:auto;margin-right:auto}
 html.desktop-windows .point-import-export-v5{display:grid!important;grid-template-columns:1.1fr .9fr!important;gap:14px!important}
}
@media(min-width:1450px){html.desktop-windows .menu-grid{grid-template-columns:repeat(4,minmax(260px,1fr))!important}}
.point-import-export-v5{margin-top:12px}
.v5-import-card,.v5-export-card{padding:13px;border:1px solid #59655a;border-radius:12px;background:rgba(255,255,255,.055);box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}
.v5-card-title{font-weight:1000;font-size:14px;margin-bottom:6px}.v5-help{font-size:10px;line-height:1.7;opacity:.82;margin-bottom:9px}.v5-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.v5-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.v5-actions .btn{min-height:44px}.v5-preview{margin-top:8px;max-height:170px;overflow:auto;border:1px solid #667263;border-radius:8px;background:rgba(0,0,0,.12);font:11px/1.6 Courier New,monospace;direction:ltr;text-align:left;padding:8px;white-space:pre}.v5-format-note{font-size:10px;line-height:1.65;margin-top:7px;padding:7px;border:1px dashed #667263;border-radius:7px;opacity:.86}.v5-ok{font-weight:900}.v5-bad{font-weight:900}.v5-format-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.v5-format-grid .btn{min-height:46px;font-size:11px}.v5-file-name{margin-top:7px;font-size:10px;opacity:.78;word-break:break-all}@media(max-width:700px){.point-import-export-v5{grid-template-columns:1fr}.v5-row,.v5-actions,.v5-format-grid{grid-template-columns:1fr}}

/* V24: requested UI updates */
.v9-import-actions{display:grid!important;grid-template-columns:1fr 1fr!important;gap:8px!important}
.v9-import-actions .btn{width:100%;min-width:0}
#surveyMap{background:#000!important}
.map-wrap{background:#000!important;border-color:#5b6558!important}
.map-grid-line{stroke:#333!important}.map-axis{stroke:#777!important}
.map-point{fill:#fff!important;stroke:#00ff66!important}
#graphicmap .card{background:linear-gradient(145deg,#12351d,#0b2413 55%,#07180c)!important;color:#eef6ed!important;border:2px solid #3f7b4c!important;box-shadow:inset 0 0 0 1px rgba(137,188,137,.18),0 8px 22px rgba(8,35,14,.38)!important}

/* MENU 17 — drawing toolbar */
#m17DrawSvg{position:absolute;inset:0;width:100%;height:100%;z-index:7;pointer-events:none;overflow:visible}
#m17DrawSvg .m17-line{fill:none;stroke:#ffeb3b;stroke-width:4;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 1px 2px rgba(0,0,0,.7))}
#m17DrawSvg .m17-poly{fill:rgba(255,235,59,.18);stroke:#ffeb3b;stroke-width:4;stroke-linejoin:round;filter:drop-shadow(0 1px 2px rgba(0,0,0,.7))}
#m17DrawSvg .m17-point{fill:#1976d2;stroke:#fff;stroke-width:3;filter:drop-shadow(0 1px 2px rgba(0,0,0,.7))}
#m17DrawSvg .m17-distance-text{fill:#fff;font:900 13px Arial,Tahoma,sans-serif;paint-order:stroke;stroke:#111;stroke-width:2.5px;stroke-linejoin:round;dominant-baseline:middle;text-anchor:middle}
#m17DrawSvg .m17-circle{fill:rgba(255,235,59,.14);stroke:#ffeb3b;stroke-width:4;filter:drop-shadow(0 1px 2px rgba(0,0,0,.7))}

/* MENU 17 — Output panel */
#m17ExportBtn{border:2px solid #7b856f;border-radius:8px;background:linear-gradient(#e0e4dc,#aeb7a9);color:#10170e;font-weight:900;font-size:12px;padding:0 6px;box-shadow:inset 0 1px #f4f6ef;cursor:pointer}
#m17ExportBtn:active{transform:scale(.98);background:linear-gradient(#a7c991,#6fa552)}
#m17ExportModal{position:fixed;inset:0;z-index:120;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.58);padding:18px;box-sizing:border-box;direction:rtl}
#m17ExportModal.show{display:flex}
.m17-export-card{width:min(420px,94vw);background:linear-gradient(#dce1d9,#aeb8aa);border:3px solid #5d6858;border-radius:16px;box-shadow:0 8px 28px rgba(0,0,0,.55);padding:14px;box-sizing:border-box;color:#10150f}
.m17-export-title{font-size:20px;font-weight:900;text-align:center;margin:2px 0 12px}
.m17-export-sub{font-size:12px;text-align:center;opacity:.78;margin:-5px 0 12px}
.m17-export-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.m17-export-grid button,.m17-export-close{min-height:48px;border:2px solid #687263;border-radius:10px;background:linear-gradient(#edf0eb,#c1c8be);color:#10150f;font-weight:900;font-size:13px;box-shadow:inset 0 1px #fff;cursor:pointer}
.m17-export-grid button:active,.m17-export-close:active{background:linear-gradient(#a8cd90,#78a75d)}
.m17-export-close{width:100%;margin-top:10px}
@media(max-width:360px){.m17-export-grid{grid-template-columns:1fr}.m17-export-title{font-size:18px}}
#m17DrawToolbar{position:fixed;left:8px;right:8px;bottom:82px;z-index:79;display:none;flex-wrap:wrap;gap:5px;padding:6px;background:rgba(22,26,22,.94);border:1px solid #66705f;border-radius:10px;box-shadow:0 -2px 10px rgba(0,0,0,.3);direction:rtl}
#m17DrawToolbar button{flex:0 0 calc((100% - 15px)/4);min-width:0;min-height:42px;border:2px solid #6b7567;border-radius:8px;background:linear-gradient(#d7dbd3,#aeb5aa);color:#11170f;font-weight:900;font-size:12px;box-shadow:inset 0 1px #f4f6ef;white-space:nowrap;padding:0 5px}
#m17DrawToolbar button.active{background:linear-gradient(#9bc27f,#659a4c);border-color:#d7efca}
#m17DrawToolbar .m17-import-inline,#m17DrawToolbar .m17-export-inline{flex:0 0 100%;min-width:100%;min-height:30px;height:30px;font-size:11px;padding:0 5px}
/* V186 Android: keep the full Menu 17 toolbar clearly above MENU/BACK and Android navigation. */
@media(max-width:600px){#m17DrawToolbar{bottom:102px;max-height:calc(100vh - 132px);overflow:visible}}
#m17AreaBox{display:none;margin-top:6px;padding:7px 10px;border-radius:9px;background:rgba(20,130,42,.94);color:#fff;font:800 15px Arial,sans-serif;direction:rtl;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.35);pointer-events:none;border:1px solid rgba(190,255,190,.35);min-height:18px;box-sizing:border-box;}
#m17DrawHint{position:fixed;left:50%;transform:translateX(-50%);top:92px;bottom:auto;z-index:78;display:none;width:min(92vw,560px);box-sizing:border-box;padding:6px 10px;border-radius:8px;background:rgba(0,0,0,.76);color:#fff;font-size:12px;font-weight:800;line-height:1.55;text-align:center;direction:rtl;white-space:normal;pointer-events:none}
#m4ProfileConfirmBar{position:fixed;left:10px;right:10px;bottom:86px;z-index:95;display:none;padding:8px;background:rgba(20,24,20,.94);border:2px solid #667263;border-radius:12px;box-shadow:0 -2px 12px rgba(0,0,0,.45);direction:rtl}
#m4ProfileConfirmBar button{width:100%;min-height:50px;border:2px solid #397a2c;border-radius:10px;background:linear-gradient(#a8d787,#68aa52);color:#111;font-weight:1000;font-size:16px;box-shadow:inset 0 1px #fff;opacity:.45}
#m4ProfileConfirmBar button.enabled{opacity:1}
@media(max-width:600px){#m4ProfileConfirmBar{bottom:156px;left:7px;right:7px;z-index:99999}}

/* MENU 13 — HEIGHT & LEVELLING */
.m19-mode-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-top:8px}.m19-table{width:100%;border-collapse:collapse;font-size:11px}.m19-table th,.m19-table td{border:1px solid #59655a;padding:6px;text-align:center}.m19-table th{background:rgba(0,0,0,.12)}.m19-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.m19-ok{font-weight:900}.m19-bad{font-weight:900}.m19-note{font-size:10px;line-height:1.6;opacity:.82;margin-top:7px}.m19-project-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-top:8px}
.m19-project-grid>div{min-width:0}
.m19-project-grid label{display:block;margin-bottom:4px;font-weight:800}
.m19-project-grid input{width:100%;box-sizing:border-box}
.m19-report-head{border:2px solid #4f5c50;border-radius:10px;background:linear-gradient(135deg,rgba(255,255,255,.88),rgba(220,226,218,.82));padding:11px;margin-bottom:9px}
.m19-report-title{font-size:19px;font-weight:900;text-align:center;color:#18351d;margin-bottom:5px}
.m19-report-sub{text-align:center;font-size:11px;color:#39443b}
.m19-meta-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:9px}
.m19-meta-cell{border:1px solid #8a938b;border-radius:7px;padding:6px;background:rgba(255,255,255,.65);font-size:10px}
.m19-meta-cell b{display:block;font-size:12px;margin-top:2px}
.m19-summary-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin:8px 0}
.m19-summary-item{border:1px solid #68736a;border-radius:7px;padding:7px;text-align:center;background:rgba(255,255,255,.72);font-size:10px}
.m19-summary-item b{display:block;font-size:13px;margin-top:3px}
.m19-control-box{border:2px solid #5a675b;border-radius:8px;padding:9px;background:rgba(255,255,255,.7);line-height:1.9;margin:8px 0}
.m19-control-ok{border-color:#357a43!important;background:#e7f2e8!important}
.m19-control-warn{border-color:#a87818!important;background:#fff6dc!important}
.m19-sign-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
.m19-sign{border-top:1px solid #777;text-align:center;padding-top:7px;min-height:30px;font-size:10px}
@media(max-width:700px){.m19-project-grid,.m19-meta-grid{grid-template-columns:1fr 1fr}.m19-summary-grid{grid-template-columns:1fr 1fr}.m19-sign-grid{grid-template-columns:1fr}.m19-book{overflow-x:auto}.m19-book table{min-width:760px}}
@media(max-width:560px){.m19-mode-grid{grid-template-columns:1fr}}.m19-book{overflow:auto;border:2px solid #59655a;border-radius:10px;margin-top:10px;background:#f7f8f4;color:#111}.m19-book table{min-width:720px;width:100%;border-collapse:collapse;font-size:11px}.m19-book th,.m19-book td{border:1px solid #70786d;padding:6px 5px;text-align:center;white-space:nowrap}.m19-book th{background:#dfe5da;font-weight:900}.m19-book tr:nth-child(even) td{background:#f1f3ed}.m19-book .sum td{background:#d7e4d2!important;font-weight:900}.m19-input-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;align-items:end}
/* V212: align F.S and horizontal distance fields on the same row */
@media(max-width:700px){.m19-input-grid{grid-template-columns:1fr 1fr;gap:7px;align-items:end}.m19-input-grid>div:nth-child(1){grid-column:1/-1}.m19-input-grid>div:nth-child(4),.m19-input-grid>div:nth-child(5){grid-column:auto}.m19-input-grid>div:nth-child(6){grid-column:1}.m19-input-grid>div:nth-child(7){grid-column:2}.m19-input-grid input,.m19-input-grid select{height:46px;box-sizing:border-box}.m19-input-grid>div:nth-child(4) input,.m19-input-grid>div:nth-child(5) input{height:46px}}.m19-input-grid>div{min-width:0}.m19-input-grid input{width:100%;box-sizing:border-box}.m19-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:8px}.m19-kpi{padding:8px;border:1px solid #687263;border-radius:8px;background:rgba(255,255,255,.08);text-align:center}.m19-kpi b{display:block;font-size:15px;margin-top:3px}.m19-status{margin-top:8px;padding:9px;border-radius:8px;border:2px solid #59655a;background:rgba(255,255,255,.08);font-size:11px;line-height:1.6}.m19-mini{font-size:10px;opacity:.78;line-height:1.55;margin-top:6px}.m19-export{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:8px}.m19-export .btn{min-height:44px;font-weight:900}@media(max-width:700px){.m19-input-grid{grid-template-columns:repeat(2,1fr)}.m19-input-grid>div:first-child{grid-column:1/-1}.m19-kpis{grid-template-columns:1fr 1fr}.m19-export{grid-template-columns:1fr}.m19-book table{font-size:10px}}

/* V252 — Stake Out control and modal */
#m17StakeBtn{position:absolute;right:17px;top:calc(52% + 50px);z-index:70;width:50px;height:50px;padding:0;border:2px solid rgba(255,255,255,.98);border-radius:50%;background:#fff;color:#1769d2;font-size:36px;font-weight:500;line-height:1;box-shadow:0 3px 12px rgba(0,0,0,.42),inset 0 1px 2px rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center;cursor:pointer;touch-action:none;pointer-events:auto;user-select:none;-webkit-user-select:none}
#m17StakeBtn.m17-finish-mode{background:linear-gradient(#a7d879,#65ad4b);color:#10200d;border-color:#e9f7e1;font-size:13px;font-weight:900;white-space:nowrap;text-shadow:0 1px rgba(255,255,255,.35)}
#m17StakeBtn.m17-finish-mode:active{background:linear-gradient(#8fc666,#5b9d43)}
#m17StakeBtn:active{transform:scale(.93);background:#f3f6fb}
#m17StakeModal{display:none;position:fixed;inset:0;z-index:300;background:rgba(0,0,0,.66);align-items:center;justify-content:center;padding:18px;box-sizing:border-box;direction:rtl}
#m17StakeModal.show{display:flex}
.m17-stake-card{width:min(94vw,610px);max-height:88vh;overflow:auto;background:linear-gradient(145deg,#eef2eb,#cbd2c9);border:3px solid #566254;border-radius:22px;box-shadow:0 14px 40px rgba(0,0,0,.55);padding:20px;box-sizing:border-box;color:#182018}
.m17-stake-title{text-align:center;font-size:24px;font-weight:1000;margin-bottom:6px}.m17-stake-sub{text-align:center;font-size:14px;line-height:1.8;margin-bottom:14px}
.m17-stake-methods{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:12px}.m17-stake-method{min-height:52px;border:2px solid #778273;border-radius:12px;background:linear-gradient(#eef1ec,#c3c9c1);font-weight:1000;font-size:16px;cursor:pointer}.m17-stake-method.active{background:linear-gradient(#9fd37f,#67aa50);border-color:#397a2c}
.m17-stake-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.m17-stake-field label{display:block;font-weight:900;margin:0 0 5px}.m17-stake-field input{width:100%;box-sizing:border-box;min-height:50px;border:2px solid #7b8578;border-radius:12px;background:#fff;font:700 18px Arial,sans-serif;text-align:left;direction:ltr;padding:8px 12px}.m17-stake-field input::placeholder{color:#8b918b;opacity:1}
.m17-stake-note{margin:12px 0;padding:10px;border-radius:12px;background:#e0e5df;border:1px solid #a8b0a5;font-size:13px;line-height:1.7}.m17-stake-actions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px}.m17-stake-actions button{min-height:52px;border:2px solid #6c7869;border-radius:12px;font-weight:1000;font-size:16px;cursor:pointer}.m17-stake-primary{background:linear-gradient(#a5db83,#6aae52)}.m17-stake-close{background:linear-gradient(#eef1ec,#c3c9c1)}
.m17-stake-list{margin-top:12px;padding:9px;border-radius:12px;background:#f4f6f2;border:1px solid #a5ada2;max-height:170px;overflow:auto;font:700 13px Arial,Tahoma,sans-serif;direction:ltr;text-align:left}.m17-stake-list div{padding:6px 4px;border-bottom:1px solid #d1d6ce}.m17-stake-list div:last-child{border-bottom:0}
@media(max-width:600px){.m17-stake-card{padding:15px}.m17-stake-title{font-size:21px}.m17-stake-grid{grid-template-columns:1fr}.m17-stake-methods{grid-template-columns:1fr 1fr}.m17-stake-actions{grid-template-columns:1fr 1fr 1fr}.m17-stake-actions button{font-size:14px;padding:0 4px}}
#m17DrawSvg .m17-stake-point{fill:#e53935;stroke:#fff;stroke-width:3;filter:drop-shadow(0 1px 2px rgba(0,0,0,.75))}
#m17DrawSvg .m17-stake-label{fill:#fff;font:900 15px Arial,Tahoma,sans-serif;paint-order:stroke;stroke:#111;stroke-width:4px;stroke-linejoin:round}


/* V351 — MENU 3 PROFESSIONAL POINT SEARCH / SELECT CARD */
.stake3-search-card{margin-top:11px;padding:12px;border:2px solid #59655a;border-radius:13px;background:linear-gradient(145deg,rgba(255,255,255,.24),rgba(150,160,145,.16));}
.stake3-search-title{font-size:15px;font-weight:1000;text-align:center;margin-bottom:7px}
.stake3-search-help{font-size:10px;text-align:center;line-height:1.55;opacity:.78;margin-bottom:8px}
.stake3-search-row{display:grid;grid-template-columns:minmax(0,1fr) 108px;gap:7px}
.stake3-search-row input{height:45px;font-size:17px;font-weight:900;text-align:center;background:#eef1eb}
.stake3-search-btn{min-height:45px!important;font-size:14px!important;font-weight:1000!important}
.stake3-search-result{display:none;margin-top:9px;padding:10px;border:2px solid #687463;border-radius:10px;background:#f2f5ef;color:#172017}
.stake3-search-result.show{display:block}
.stake3-selected-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:7px}
.stake3-selected-name{font-size:18px;font-weight:1000}
.stake3-selected-badge{font-size:10px;font-weight:900;padding:4px 7px;border-radius:7px;background:#dcebd7;color:#1b5e25;border:1px solid #72906c}
.stake3-selected-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}
.stake3-selected-cell{padding:7px 4px;text-align:center;border:1px solid #a1aaa0;border-radius:6px;background:#e5e9e2}
.stake3-selected-cell small{display:block;font-size:9px;color:#566154}
.stake3-selected-cell b{display:block;font-size:11px;margin-top:3px;direction:ltr}
.stake3-selected-action{margin-top:8px}
.stake3-selected-action .btn{min-height:45px;font-size:14px}
.stake3-search-notfound{font-size:11px;font-weight:900;text-align:center;padding:8px;color:#8a231b}
@media(max-width:420px){.stake3-search-row{grid-template-columns:1fr 96px}.stake3-selected-grid{grid-template-columns:1fr 1fr}.stake3-selected-name{font-size:16px}}

.stake3-manual-box,.stake3-file-box{margin-top:11px;padding:12px;border:2px solid #879181;border-radius:13px;background:rgba(255,255,255,.08)}.stake3-section-title{font-size:15px;font-weight:1000;margin-bottom:7px;text-align:center}.stake3-file-help{font-size:10px;line-height:1.6;text-align:center;opacity:.78;margin:4px 0 9px}.stake3-load-btn{min-height:54px!important;font-size:18px!important;font-weight:1000!important;margin-bottom:8px}.stake3-file-box .stake3-import-grid{margin-top:0}.stake3-file-box .stake3-import-btn{min-height:43px;font-size:12px}.stake3-manual-box .stake3-live-methods{margin-bottom:9px}.stake3-manual-box .stake3-live-launch{margin-top:9px!important}@media(max-width:520px){.stake3-file-box .stake3-import-grid{grid-template-columns:1fr 1fr}.stake3-file-box .stake3-import-btn{font-size:11px}}.stake-live-entry-card{margin-top:12px}.stake-live-entry-sub{text-align:center;font-size:14px;line-height:1.8;margin:-2px 0 12px;opacity:.82}.stake3-live-methods{margin-bottom:12px}.stake3-live-grid{grid-template-columns:1fr 1fr}.stake3-live-launch{margin:12px 0 0;min-height:60px;font-size:19px} .stake3-map-launch{margin-top:8px!important;background:linear-gradient(180deg,#e5e9e3,#c5cbc3)!important;color:#182018!important}
@media(max-width:600px){.stake3-live-grid{grid-template-columns:1fr}.stake-live-entry-sub{font-size:13px}}
.m17-live-launch{width:100%;min-height:58px;margin:12px 0 10px;border:2px solid #397a2c;border-radius:12px;background:linear-gradient(#a5db83,#6aae52);color:#182018;font-weight:1000;font-size:18px;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,.18)}
.m17-live-launch:active{transform:scale(.985)}
#m17LiveStakeModal{display:none;position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.18);align-items:flex-end;justify-content:center;box-sizing:border-box;direction:rtl;pointer-events:none}
#m17LiveStakeModal.show{display:flex}
/* V257: while live stake-out is open, temporarily hide the base map markers/overlays
   so only the dedicated live target + live user markers remain visible. */
#m17Map.m17-live-active #m17UserLocation,
#m17Map.m17-live-active #m17TapMarker,
#m17Map.m17-live-active #m17DrawSvg,
#m17Map.m17-live-active #m17CoordBox{display:none!important}
.m17-live-stake-shell{position:relative;width:100%;height:100%;overflow:hidden;pointer-events:none}
.m17-live-stake-map{position:absolute;inset:0;pointer-events:none}
.m17-live-map-badge{position:absolute;top:18px;right:18px;z-index:12;padding:8px 13px;border-radius:12px;background:rgba(255,255,255,.94);border:2px solid #566254;color:#182018;font-weight:1000;box-shadow:0 3px 12px rgba(0,0,0,.35)}
.m17-live-map-legend{position:absolute;top:18px;left:18px;z-index:12;padding:7px 10px;border-radius:11px;background:rgba(5,8,5,.96);border:1px solid #9aa39a;color:#182018;font:800 12px Tahoma,Arial,sans-serif;box-shadow:0 3px 10px rgba(0,0,0,.28)}
.m17-live-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin:0 3px 0 7px;vertical-align:middle}.m17-live-dot.target{background:#e53935}.m17-live-dot.user{background:#4285f4}
.m17-live-user-marker,.m17-live-target-marker{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);z-index:10;display:none;pointer-events:none}
.m17-live-user-marker{width:28px;height:28px;border-radius:50%;background:#4285f4;border:4px solid #fff;box-shadow:0 2px 10px rgba(0,0,0,.6)}
.m17-live-user-marker:after{content:'';position:absolute;left:50%;top:50%;width:8px;height:8px;transform:translate(-50%,-50%);border-radius:50%;background:#fff}
.m17-live-target-marker{width:32px;height:32px;border-radius:50% 50% 50% 0;background:#e53935;border:3px solid #fff;color:#fff;font-size:0;box-shadow:0 2px 10px rgba(0,0,0,.6);rotate:-45deg}
.m17-live-target-marker:after{content:'';position:absolute;left:50%;top:50%;width:9px;height:9px;transform:translate(-50%,-50%) rotate(45deg);border-radius:50%;background:#fff}
.m17-live-line{position:absolute;left:50%;top:42%;height:3px;background:#e53935;transform-origin:left center;z-index:8;display:none;box-shadow:0 1px 3px rgba(0,0,0,.5)}
.m17-live-stake-card{position:absolute;left:50%;bottom:calc(12px + env(safe-area-inset-bottom, 0px));transform:translateX(-50%);width:min(94vw,610px);box-sizing:border-box;padding:14px 16px 16px;border:3px solid #566254;border-radius:22px;background:linear-gradient(145deg,rgba(245,248,242,.98),rgba(210,218,207,.98));box-shadow:0 10px 35px rgba(0,0,0,.58);color:#182018;pointer-events:auto}
.m17-live-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.m17-live-title{font-size:23px;font-weight:1000}.m17-live-gps{padding:5px 9px;border-radius:10px;background:#d9e8d3;border:1px solid #7a9b70;font:900 12px Arial,Tahoma,sans-serif;direction:ltr}.m17-live-target-name{text-align:center;margin:6px 0 9px;font-weight:900;font-size:15px}
.m17-live-values{display:grid;grid-template-columns:1fr 1fr;gap:8px}.m17-live-values>div{min-height:74px;padding:8px;border:2px solid #a5ada2;border-radius:14px;background:rgba(255,255,255,.78);text-align:center;box-sizing:border-box}.m17-live-values>div.wide{grid-column:1/-1;min-height:70px}.m17-live-values span{display:block;font-weight:900;font-size:13px}.m17-live-values b{font:1000 27px Arial,sans-serif;direction:ltr}.m17-live-values small{font-weight:900;margin-right:4px}.m17-live-direction{margin-top:9px;padding:9px;border-radius:12px;background:#e3efdf;text-align:center;font-size:18px;font-weight:1000}.m17-live-status{margin-top:7px;padding:8px;border-radius:10px;background:#eef2ec;border:1px solid #a4ada1;text-align:center;font-size:14px;font-weight:1000}.m17-live-status.on{background:#dcefd8;border-color:#6f9a66}.m17-live-accuracy{text-align:center;margin:8px 0 6px;font:700 13px Arial,Tahoma,sans-serif;direction:ltr}.m17-live-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.m17-live-actions button{min-height:52px;border:2px solid #6c7869;border-radius:12px;font-weight:1000;font-size:16px;cursor:pointer}.m17-live-finish{background:linear-gradient(#a5db83,#6aae52);border-color:#397a2c!important}.m17-live-back{background:linear-gradient(#eef1ec,#c3c9c1)}
@media(max-width:600px){.m17-live-stake-card{bottom:calc(14px + env(safe-area-inset-bottom, 0px));padding:12px}.m17-live-title{font-size:20px}.m17-live-values b{font-size:24px}.m17-live-map-badge{top:10px;right:10px}.m17-live-map-legend{top:10px;left:10px}.m17-live-actions button{font-size:14px}}
.m17-live-tolerance-row{display:grid;grid-template-columns:1fr 118px;gap:8px;align-items:center;margin:7px 0 8px;padding:7px 9px;border:1px solid #a4ada1;border-radius:11px;background:rgba(255,255,255,.62)}.m17-live-tolerance-row label{margin:0;font-size:12px;font-weight:1000}.m17-live-tolerance-row input{height:34px;text-align:center;font-weight:1000;background:#fff;border:2px solid #7b8878}.m17-live-status.ok{background:#d9efd3;border-color:#4f9145;color:#245c1f}.m17-live-status.warn{background:#fff0c8;border-color:#c59a35;color:#765500}.m17-live-status.bad{background:#f7dddd;border-color:#bd5b5b;color:#7b2222}.m17-live-finish:disabled{opacity:.45;filter:grayscale(1);cursor:not-allowed}.m17-live-guidance{margin-top:7px;padding:8px 10px;border-radius:11px;background:#eaf0e6;border:1px solid #9da89a;text-align:center;font-size:13px;font-weight:1000}

/* AREA PRO V2 — white/green cards + bounded point/result panels */
.area-pro-shell{display:grid;gap:10px}.area-pro-hero{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 15px;border-radius:18px;background:linear-gradient(145deg,#eef2ea 0%,#d3dbce 48%,#aebbad 100%);border:2px solid #4d5b4d;box-shadow:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -2px 0 rgba(50,60,50,.15),0 5px 12px rgba(20,30,20,.22)}.area-pro-hero b{display:block;font-size:19px;color:#172018}.area-pro-hero span{display:block;margin-top:4px;font-size:10px;color:#687168}.area-badge{padding:8px 10px;border-radius:12px;background:#f5f7f4;border:1px solid #cdd5cc;font-weight:900;font-size:11px;box-shadow:0 2px 6px rgba(0,0,0,.08)}
.area-pro-card{padding:13px;border-radius:16px;background:linear-gradient(145deg,#eef2ea 0%,#d3dbce 48%,#aebbad 100%);border:2px solid #4d5b4d;box-shadow:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -2px 0 rgba(50,60,50,.12),0 5px 12px rgba(20,30,20,.22);box-sizing:border-box}.area-pro-card-title{font-size:15px;font-weight:1000;color:#172018;margin-bottom:6px}.area-pro-help{font-size:10px;line-height:1.65;color:#4d584b;margin-bottom:8px}.area-source-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.area-source-btn,.area-action,.area-export-pro,.area-future-btn{border:2px solid #4d5b4d;border-radius:11px;background:linear-gradient(145deg,#f5f8f3 0%,#e1e9de 50%,#cbd6c8 100%);color:#172018;font-weight:900;box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 3px 8px rgba(35,45,35,.12);min-height:44px;padding:8px}.area-source-btn.active{background:linear-gradient(145deg,#ffffff 0%,#e5f1e4 55%,#cbdcc7 100%);border-color:#4f7650;box-shadow:inset 0 0 0 1px #a9c9a6,0 3px 8px rgba(35,45,35,.12)}.area-picker{margin-top:9px;padding:10px;border-radius:12px;background:linear-gradient(145deg,#f8fbf7,#e2ebdf);border:1px solid #9eaa9b}.area-point{display:grid;grid-template-columns:45px minmax(0,1fr) minmax(0,1fr) 34px;gap:6px;align-items:end;margin-top:8px;padding:9px;border-radius:12px;background:linear-gradient(145deg,#f8fbf7,#e4ece1);border:1px solid #a8b3a5;box-shadow:0 2px 7px rgba(35,45,35,.08)}.area-point .pt-label{font-weight:1000;text-align:center;padding-bottom:10px;color:#273329}.area-point input{background:#fff;border:1px solid #cbd3ca;border-radius:9px;height:40px;box-shadow:inset 0 1px 4px rgba(0,0,0,.05)}.area-remove{height:34px!important;min-height:34px!important;width:34px!important;padding:0!important;border-radius:9px!important}.area-main-actions{display:grid;grid-template-columns:1fr 1.2fr 1fr;gap:7px;margin-top:10px}.area-action.calc{background:linear-gradient(145deg,#ffffff,#e4f1e1,#c9ddc5);border-color:#527b53}.area-action.clear{background:linear-gradient(145deg,#f5f7f3,#dfe6dc)}.area-validation{padding:11px;border-radius:11px;font-size:11px;line-height:1.7;border:1px solid #d5dbd4;background:#f7f9f6}.area-validation.ok{background:#edf7eb;border-color:#9bc497;color:#28572a}.area-validation.bad{background:#fff0ed;border-color:#e1aaa0;color:#7b2d24}.area-validation.warn{background:#fff8e8;border-color:#dfc783;color:#725719}.area-result-pro{padding:11px;border-radius:12px;background:linear-gradient(145deg,#f8fbf7,#e1eadf);border:1px solid #9eaa9b;min-height:0;max-height:175px;overflow:auto;box-sizing:border-box}.area-result-main{font-size:29px;font-weight:1000;text-align:center;color:#1c5124;padding:8px}.area-result-main small{font-size:13px}.area-stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:8px}.area-stat{padding:9px 4px;text-align:center;border-radius:10px;background:linear-gradient(#ffffff,#e7eee4);border:1px solid #aeb9aa}.area-stat small{display:block;font-size:8px;color:#727b72}.area-stat b{display:block;font-size:11px;margin-top:3px}.area-unit-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:7px}.area-unit-item{padding:8px;text-align:center;border-radius:9px;background:linear-gradient(#ffffff,#e1e9de);border:1px solid #aeb9aa;font-size:9px}.area-unit-item b{display:block;font-size:11px;margin-top:3px}.area-table-wrap{overflow:auto}.area-table{width:100%;border-collapse:collapse;min-width:500px;font-size:10px}.area-table th,.area-table td{padding:8px 6px;border-bottom:1px solid #e0e4df;text-align:center}.area-table th{background:#dfe8dc;font-weight:1000}.area-table td{background:#f9fbf8}.area-sketch-pro-wrap{padding:8px;border-radius:13px;background:linear-gradient(145deg,#f8fbf7,#e1eadf);border:1px solid #9eaa9b;overflow:hidden}.area-sketch-pro{display:block;width:100%;height:230px;min-height:0}.area-sketch-pro .poly{fill:#b9d8b7!important;fill-opacity:.48!important;stroke:#2f6435!important;stroke-width:3!important;stroke-linejoin:round!important}.area-extra-offset{fill:none;stroke:#4d7b50;stroke-width:3;stroke-dasharray:9 6}.area-extra-split{fill:none;stroke:#668a68;stroke-width:2;stroke-dasharray:6 5}.area-sketch-pro .side{stroke:#49684a;stroke-width:2}.area-sketch-pro text{font-family:Arial,Tahoma,sans-serif}.area-map-legend{display:flex;justify-content:space-between;gap:5px;flex-wrap:wrap;font-size:9px;color:#59635b;padding:6px 2px 0}.area-export-pro-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.area-export-pro{min-height:64px;font-size:13px}.area-export-pro small{font-size:8px;color:#6b746c}.area-crs-box{margin-top:10px;padding:11px;border-radius:12px;background:linear-gradient(145deg,#f8fbf7,#e1eadf);border:1px solid #9eaa9b}.area-crs-box .row{margin-bottom:7px}.area-crs-box select,.area-crs-box input{background:#fff;border:1px solid #cbd3ca;border-radius:9px}.area-future-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.area-future-btn{min-height:48px;background:linear-gradient(145deg,#f5f8f3,#e1e9de,#cbd6c8)}.area-empty-result{text-align:center;padding:15px;font-size:10px;color:#59645a}
#area{overflow-x:hidden!important}#area .area-pro-shell,#area .area-pro-card,#area .area-point,#area input,#area select,#area button{box-sizing:border-box;max-width:100%;}#area .area-point{min-width:0;}#area .area-point>*{min-width:0;}@media(max-width:560px){.page#area{overflow-x:hidden!important}.area-pro-shell,.area-pro-card,.area-pro-hero,.area-picker,#areaPoints,#areaSides{width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important}.area-source-grid{grid-template-columns:1fr}.area-main-actions{grid-template-columns:1fr}.area-stat-grid{grid-template-columns:1fr 1fr}.area-unit-grid{grid-template-columns:1fr 1fr}.area-export-pro-grid{grid-template-columns:1fr 1fr}.area-pro-card #areaPoints{max-height:360px;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;padding-right:2px}.area-point{width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important;grid-template-columns:34px minmax(0,1fr) minmax(0,1fr) 30px!important;gap:5px!important;padding:8px!important;overflow:hidden!important}.area-point>div{min-width:0!important;max-width:100%!important;overflow:hidden!important}.area-point label{display:block;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:9px!important}.area-point input{min-width:0!important;max-width:100%!important;width:100%!important;box-sizing:border-box!important;font-size:14px!important;padding:9px 6px!important}.area-remove{width:30px!important;max-width:30px!important}.area-pro-card #areaSides{max-height:300px;overflow:auto}.area-unit-grid{min-height:0}}

/* ===== MENU 8 — PROFESSIONAL VOLUME / EARTHWORK ===== */
.v8-shell{display:grid;gap:10px}.v8-hero,.v8-panel{padding:13px;border-radius:16px;background:linear-gradient(145deg,#eef2ea 0%,#d3dbce 48%,#aebbad 100%);border:2px solid #4d5b4d;box-shadow:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -2px 0 rgba(50,60,50,.12),0 5px 12px rgba(20,30,20,.22);box-sizing:border-box}.v8-hero{display:flex;align-items:center;justify-content:space-between;gap:10px}.v8-hero b{display:block;font-size:19px;color:#172018}.v8-hero span{display:block;margin-top:4px;font-size:10px;color:#687168}.v8-badge{padding:8px 10px;border-radius:12px;background:#f5f7f4;border:1px solid #cdd5cc;font-weight:900;font-size:10px}.v8-tabs{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.v8-tab{border:2px solid #4d5b4d;border-radius:11px;background:linear-gradient(145deg,#f5f8f3,#e1e9de,#cbd6c8);color:#172018;font-weight:900;min-height:52px;padding:5px;box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 3px 8px rgba(35,45,35,.12)}.v8-tab.active{background:linear-gradient(145deg,#fff,#e5f1e4,#cbdcc7);border-color:#4f7650;box-shadow:inset 0 0 0 1px #a9c9a6,0 3px 8px rgba(35,45,35,.12)}.v8-tab small{font-size:10px}.v8-panel-title{font-size:15px;font-weight:1000;color:#172018;margin-bottom:6px}.v8-help{font-size:10px;line-height:1.7;color:#4d584b;margin-bottom:8px}.v8-source-grid,.v8-export-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.v8-btn,.v8-export{border:2px solid #4d5b4d;border-radius:11px;background:linear-gradient(145deg,#f5f8f3 0%,#e1e9de 50%,#cbd6c8 100%);color:#172018;font-weight:900;box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 3px 8px rgba(35,45,35,.12);min-height:44px;padding:8px}.v8-btn.calc{background:linear-gradient(145deg,#fff,#e4f1e1,#c9ddc5);border-color:#527b53}.v8-btn.clear{background:linear-gradient(145deg,#f5f7f3,#dfe6dc)}.v8-btn.file-btn{display:flex;align-items:center;justify-content:center;text-align:center;cursor:pointer}.v8-btn.file-btn input{display:none}.v8-point-head,.v8-point-row{display:grid;grid-template-columns:42px 1fr 1fr 1fr 34px;gap:5px;align-items:end}.v8-point-head{margin-top:9px;font-size:9px;font-weight:900;text-align:center;color:#59635b}.v8-point-row{margin-top:7px;padding:8px;border-radius:12px;background:linear-gradient(145deg,#f8fbf7,#e4ece1);border:1px solid #a8b3a5;box-shadow:0 2px 7px rgba(35,45,35,.08)}.v8-point-row .v8-pno{text-align:center;font-weight:1000;padding-bottom:10px}.v8-point-row input,.v8-grid-config input,.v8-base-row input,.v8-base-big input{width:100%;min-width:0;background:#fff;border:1px solid #cbd3ca;border-radius:9px;height:40px;box-sizing:border-box;padding:8px}.v8-remove{height:34px!important;min-height:34px!important;width:34px!important;padding:0!important;border-radius:9px!important}.v8-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:7px;margin-top:9px}.v8-base-row,.v8-base-big{display:grid;grid-template-columns:1fr 1.3fr;gap:7px;align-items:center;margin-top:8px}.v8-base-big{grid-template-columns:1fr 1fr auto}.v8-base-row label,.v8-base-big label,.v8-grid-config label{font-size:10px;font-weight:900}.v8-surface-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.v8-mini-title{font-size:12px;font-weight:1000;margin-bottom:5px}.v8-surface-row{display:grid;grid-template-columns:35px 1fr 1fr 1fr;gap:4px;margin-bottom:5px}.v8-surface-row input{width:100%;box-sizing:border-box;height:36px;border:1px solid #cbd3ca;border-radius:8px;background:#fff}.v8-grid-config{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:8px}.v8-grid-inputs{overflow:auto;margin-top:8px}.v8-grid-table{border-collapse:collapse;width:100%;min-width:480px;font-size:10px}.v8-grid-table th,.v8-grid-table td{border:1px solid #aeb9aa;padding:5px;text-align:center}.v8-grid-table th{background:#dfe8dc}.v8-grid-table input{width:72px;max-width:100%;height:34px;border:1px solid #cbd3ca;border-radius:7px;text-align:center}.v8-summary-note{padding:10px;border-radius:10px;background:#f5f8f3;border:1px solid #cbd5c8;font-size:10px;line-height:1.7}.v8-result{padding:12px;border-radius:14px;background:linear-gradient(145deg,#f8fbf7,#e1eadf);border:2px solid #527b53;min-height:65px}.v8-empty{text-align:center;padding:13px;color:#59645a;font-size:10px}.v8-main-number{text-align:center;font-size:29px;font-weight:1000;color:#1c5124;padding:7px}.v8-stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.v8-stat{padding:9px 4px;text-align:center;border-radius:10px;background:linear-gradient(#fff,#e7eee4);border:1px solid #aeb9aa}.v8-stat small{display:block;font-size:8px;color:#727b72}.v8-stat b{display:block;font-size:11px;margin-top:3px}.v8-earth-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.v8-earth-box{padding:12px;text-align:center;border-radius:11px;background:linear-gradient(#fff,#e4ece1);border:1px solid #aeb9aa}.v8-earth-box small{display:block;font-size:9px}.v8-earth-box b{display:block;font-size:17px;margin-top:4px}.v8-sketch{display:block;width:100%;height:230px;background:#f3f7f1;border:1px solid #9eaa9b;border-radius:10px}.v8-sketch .poly{fill:#b9d8b7;fill-opacity:.45;stroke:#2f6435;stroke-width:3}.v8-sketch .pt{fill:#2f6435;stroke:#fff;stroke-width:2}.v8-sketch text{font-family:Arial,Tahoma,sans-serif;font-size:11px;font-weight:800;fill:#253226}.v8-legend{font-size:9px;color:#59635b;padding-top:6px;text-align:center}.v8-kml-row{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:8px}.v8-kml-row label{display:block;font-size:9px;font-weight:900;margin-bottom:4px}.v8-kml-row input,.v8-kml-row select{width:100%;height:40px;border:1px solid #cbd3ca;border-radius:9px;background:#fff;box-sizing:border-box;padding:8px}.v8-export{min-height:64px;font-size:13px}.v8-export small{font-size:8px;color:#6b746c}@media(max-width:560px){.v8-tabs{grid-template-columns:repeat(5,minmax(64px,1fr));overflow:auto}.v8-source-grid{grid-template-columns:1fr}.v8-surface-grid{grid-template-columns:1fr}.v8-grid-config{grid-template-columns:1fr 1fr}.v8-actions{grid-template-columns:1fr}.v8-base-big,.v8-base-row{grid-template-columns:1fr}.v8-stat-grid{grid-template-columns:1fr 1fr}.v8-earth-summary{grid-template-columns:1fr}.v8-export-grid{grid-template-columns:1fr 1fr}.v8-point-row{grid-template-columns:30px minmax(0,1fr) minmax(0,1fr) minmax(0,1fr) 30px}.v8-point-row input{font-size:13px}.v8-panel{max-width:100%;overflow:hidden}}

/* PDF POINT BUTTON TOUCH FIX — only this button */
.m4-point-pdf-btn{position:relative!important;z-index:1000!important;pointer-events:auto!important;touch-action:manipulation!important;cursor:pointer!important;-webkit-tap-highlight-color:rgba(20,120,50,.25)!important;}

/* V468 — Excel professional shell: same visual language as Menu 4 / Points */
.m6e-shell{display:grid;gap:10px;padding:10px;border-radius:16px;background:linear-gradient(145deg,#eef2ea 0%,#d3dbce 48%,#aebbad 100%);border:2px solid #4d5b4d;box-shadow:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -2px 0 rgba(50,60,50,.12),0 5px 12px rgba(20,30,20,.22);box-sizing:border-box}
.m6e-hero{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:4px 2px 2px}.m6e-hero b{display:block;font-size:19px;color:#172018}.m6e-hero span{display:block;margin-top:4px;font-size:10px;color:#687168}.m6e-badge{padding:8px 10px;border-radius:12px;background:#f5f7f4;border:1px solid #cdd5cc;font-weight:900;font-size:10px;white-space:nowrap}
.m6e-tabs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px}.m6e-tab{border:2px solid #4d5b4d;border-radius:11px;background:linear-gradient(145deg,#f5f8f3,#e1e9de,#cbd6c8);color:#172018;font-weight:900;min-height:52px;padding:5px;box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 3px 8px rgba(35,45,35,.12);cursor:pointer;touch-action:manipulation}.m6e-tab.active{background:linear-gradient(145deg,#fff,#e5f1e4,#cbdcc7);border-color:#4f7650;box-shadow:inset 0 0 0 1px #a9c9a6,0 3px 8px rgba(35,45,35,.12)}.m6e-tab small{font-size:10px;font-weight:900}
.m6e-panel{padding:11px;border-radius:14px;background:linear-gradient(145deg,#f8fbf7,#e1eadf);border:1px solid #9eaa9b;display:none;box-sizing:border-box}.m6e-panel.active{display:block}.m6e-panel-title{font-size:15px;font-weight:1000;color:#172018;margin-bottom:6px}.m6e-panel-title.small{font-size:13px}.m6e-help{font-size:10px;line-height:1.7;color:#4d584b;margin-bottom:8px}
.m6e-grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.m6e-grid2>div{min-width:0}.m6e-stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:9px 0}.m6e-stat-grid>div{padding:9px 5px;text-align:center;border-radius:10px;background:linear-gradient(#fff,#e7eee4);border:1px solid #aeb9aa}.m6e-stat-grid span{display:block;font-size:8px;color:#727b72}.m6e-stat-grid b{display:block;margin-top:4px;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#172018}
.m6e-actions,.m6e-review-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:9px}.m6e-btn{border:2px solid #4d5b4d;background:linear-gradient(145deg,#f5f8f3,#e1e9de,#cbd6c8);color:#172018;border-radius:11px;padding:10px 8px;font-weight:900;box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 3px 8px rgba(35,45,35,.12);cursor:pointer;touch-action:manipulation}.m6e-btn.calc{background:linear-gradient(145deg,#fff,#e4f1e1,#c9ddc5);border-color:#527b53}.m6e-btn.clear{background:linear-gradient(145deg,#f5f7f3,#dfe6dc)}
.m6e-file-btn{display:block;text-align:center;border:2px dashed #789078;border-radius:11px;padding:14px 8px;background:linear-gradient(145deg,#fff,#edf4eb);color:#172018;font-weight:900;cursor:pointer;touch-action:manipulation}.m6e-file-btn input{display:none}.m6e-file-info,.m6e-note{margin-top:8px;padding:9px;border:1px solid #aeb9aa;border-radius:10px;background:#f5f8f3;font-size:10px;color:#59635b;line-height:1.7}
.m6e-tool-grid,.m6e-output-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:9px}.m6e-tool,.m6e-output{border:2px solid #4d5b4d;background:linear-gradient(145deg,#f5f8f3,#e1e9de,#cbd6c8);color:#172018;border-radius:11px;padding:11px 8px;font-weight:900;min-height:62px;cursor:pointer;touch-action:manipulation}.m6e-tool small,.m6e-output small{display:block;margin-top:4px;font-size:8px;color:#6b746c;font-weight:700}.m6e-output:disabled{opacity:.48;cursor:not-allowed}.m6e-output.primary{background:linear-gradient(145deg,#fff,#e4f1e1,#c9ddc5);border-color:#527b53}.m6e-preview{margin-top:9px;display:block;width:100%;max-width:100%;height:360px;max-height:360px;overflow-x:auto;overflow-y:scroll;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;box-sizing:border-box;border:1px solid #667263;border-radius:10px;background:#fff;touch-action:pan-x pan-y;scrollbar-width:auto}.m6e-preview::-webkit-scrollbar{width:9px;height:9px}.m6e-preview::-webkit-scrollbar-thumb{background:#7d8b7b;border-radius:8px}.m6e-preview::-webkit-scrollbar-track{background:#e4e9e2}.m6e-preview table{min-width:620px;width:max-content;background:#fff;margin:0}
@media(max-width:560px){.m6e-tabs{grid-template-columns:repeat(5,minmax(64px,1fr));overflow-x:auto;padding-bottom:2px}.m6e-stat-grid{grid-template-columns:1fr 1fr}.m6e-grid2{grid-template-columns:1fr}.m6e-tool-grid,.m6e-output-grid{grid-template-columns:1fr 1fr}.m6e-hero b{font-size:16px}.m6e-hero span{font-size:9px}.m6e-tab{min-height:50px}.m6e-tab small{font-size:8px}}


/* Indexxx97 · Menu 2 schematic return and mode synchronization */
.m6e-row-actions-head,.m6e-row-actions-cell{min-width:132px!important;text-align:center!important}
.m6e-row-actions-cell{white-space:normal!important}
.m6e-row-action{display:inline-flex;align-items:center;justify-content:center;min-height:30px;margin:2px;padding:5px 9px;border:1px solid #72866d;border-radius:8px;background:linear-gradient(145deg,#fff,#e5f0e1);color:#23482a;font-size:11px;font-weight:900;cursor:pointer}
.m6e-row-action.delete{border-color:#ba8c82;background:linear-gradient(145deg,#fff,#f7e5e0);color:#8b2f24}
.m6e-new-project-wrap{display:flex;justify-content:center;margin:12px 0 4px}
.m6e-new-project-btn{width:100%;min-height:48px;border:2px solid #526f4f;border-radius:13px;background:linear-gradient(145deg,#fff,#e7f1e3,#d0e3ca);color:#1d4325;font-weight:900;font-size:14px;box-shadow:0 3px 9px rgba(31,65,34,.13);cursor:pointer}
.m6e-new-project-btn:active,.m6e-row-action:active{transform:scale(.985)}

/* Indexxx91 · Menu 6 manual row entry, attached to the existing review table */
.m6e-add-fab{display:none;position:fixed;left:57px;right:auto;bottom:calc(104px + env(safe-area-inset-bottom,0px));z-index:95;width:58px;height:58px;border:2px solid #47734a;border-radius:50%;align-items:center;justify-content:center;background:linear-gradient(145deg,#ffffff,#e5f3e2,#bad6b6);color:#17371b;font-size:36px;font-weight:900;line-height:1;box-shadow:0 5px 16px rgba(18,45,22,.30),inset 0 1px 0 #fff;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
#excel.active .m6e-add-fab{display:flex}
.m6e-add-fab:active{transform:scale(.94)}
.m6e-manual-backdrop{position:fixed;inset:0;z-index:10050;display:none;align-items:center;justify-content:center;padding:14px;padding-bottom:calc(14px + env(safe-area-inset-bottom,0px));box-sizing:border-box;background:rgba(13,24,15,.58);overflow-y:auto}
.m6e-manual-dialog{width:100%;max-width:520px;max-height:88vh;overflow-y:auto;-webkit-overflow-scrolling:touch;box-sizing:border-box;padding:15px;border:1px solid #9baa97;border-radius:18px;background:linear-gradient(145deg,#fbfdf9,#e3eddf);box-shadow:0 16px 48px rgba(0,0,0,.32);color:#172018}
.m6e-manual-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:8px}
.m6e-manual-head b{display:block;font-size:16px;font-weight:1000}
.m6e-manual-head small{display:block;margin-top:4px;font-size:10px;line-height:1.7;color:#657064}
.m6e-manual-close{width:34px;height:34px;flex:0 0 34px;border:1px solid #aab6a6;border-radius:10px;background:#f7faf5;color:#344334;font-size:22px;font-weight:700;cursor:pointer}
.m6e-manual-hint{margin:8px 0 10px;padding:9px 10px;border:1px solid #c0ceb9;border-radius:10px;background:rgba(255,255,255,.72);font-size:10px;line-height:1.75;color:#52604f}
.m6e-manual-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.m6e-manual-field{display:block;min-width:0}
.m6e-manual-field.full{grid-column:1/-1}
.m6e-manual-field span{display:block;margin:0 0 5px;font-size:11px;font-weight:900;color:#30402f}
.m6e-manual-field input{display:block;width:100%;min-width:0;box-sizing:border-box;padding:11px 10px;border:1px solid #aab8a4;border-radius:10px;background:#fff;color:#172018;font-size:14px;outline:none;direction:auto}
.m6e-manual-field input:focus{border-color:#548452;box-shadow:0 0 0 2px rgba(84,132,82,.14)}
.m6e-manual-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:13px}
.m6e-manual-actions button{min-height:44px;border:1px solid #567852;border-radius:11px;background:linear-gradient(145deg,#fff,#e5f2e2,#c9dfc5);color:#1b351c;font-weight:900;cursor:pointer}
.m6e-manual-actions button.secondary{border-color:#aab6a6;background:linear-gradient(145deg,#fff,#edf1eb,#dce4d8);color:#3e493d}
@media(max-width:420px){.m6e-manual-dialog{padding:12px}.m6e-manual-fields{grid-template-columns:1fr}.m6e-manual-field.full{grid-column:auto}.m6e-add-fab{left:51px;right:auto;bottom:calc(100px + env(safe-area-inset-bottom,0px));width:54px;height:54px}}


/* M11 v509 — KML result table: vertical scrolling */
#m11v2p3 .m11v2-tablewrap{
  max-height:52vh!important;
  overflow-y:auto!important;
  overflow-x:auto!important;
  -webkit-overflow-scrolling:touch!important;
  border-radius:14px;
}
#m11v2p2 .m11v2-tablewrap table{margin:0!important;}

/* M11 v510 — manual transfer result */
#m11v2ManualResult{
  margin-top:10px;
  padding:10px;
  border:1px solid rgba(105,150,95,.28);
  border-radius:14px;
  background:rgba(255,255,255,.72);
}
#m11v2ManualResult .m11v2-result-title{
  font-weight:700;
  font-size:17px;
  margin:0 0 8px;
  text-align:right;
}
#m11v2ManualResult .m11v2-manual-result-scroll{
  max-height:42vh!important;
  overflow-y:auto!important;
  overflow-x:auto!important;
  -webkit-overflow-scrolling:touch!important;
}
#m11v2ManualResult table{min-width:620px!important;}

/* M11 v512 — manual transfer: 3 initial rows + outputs below result */
.m11v2-manual-output-actions{
  margin-top:10px!important;
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:8px!important;
}
.m11v2-manual-output-actions .m11v2-btn{min-height:46px!important;}

@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;700&family=Estedad:wght@100..900&family=Vazirmatn:wght@100..900&family=Noto+Kufi+Arabic:wght@400;700&family=Noto+Nastaliq+Urdu:wght@400;700&display=swap');
/* X7 real Persian fonts: online font files, device fallbacks offline. */
/* X4/X5: apply font stacks to nested Persian text too, while preserving icon fonts. */
html[data-mg-font="vazirbold"] body :not(i):not([class*="icon"]):not([class*="Icon"]):not(.material-icons):not(svg):not(path) { font-family: "Vazirmatn", Tahoma, sans-serif !important; font-weight: 800 !important; }
html[data-mg-font="estedad"] body :not(i):not([class*="icon"]):not([class*="Icon"]):not(.material-icons):not(svg):not(path) { font-family: "Estedad", Tahoma, sans-serif !important; }
html[data-mg-font="kufi"] body :not(i):not([class*="icon"]):not([class*="Icon"]):not(.material-icons):not(svg):not(path) { font-family: "Noto Sans Arabic","Vazirmatn",Tahoma,sans-serif !important; }
html[data-mg-font="tahoma"] body :not(i):not([class*="icon"]):not([class*="Icon"]):not(.material-icons):not(svg):not(path) { font-family: Tahoma, Arial, sans-serif !important; }
html[data-mg-font="handwrite"] body :not(i):not([class*="icon"]):not([class*="Icon"]):not(.material-icons):not(svg):not(path) { font-family: "Noto Nastaliq Urdu","Noto Sans Arabic",Tahoma,serif !important; line-height: 2 !important; }
html[data-mg-font="estedadneon"] body :not(i):not([class*="icon"]):not([class*="Icon"]):not(.material-icons):not(svg):not(path) { font-family: "Estedad", Tahoma, sans-serif !important; text-shadow: 0 0 1px #fff, 0 0 3px #b7ffd0, 0 0 6px rgba(60,255,145,.75) !important; }
/* White neon edge/glow for readable text across the app. */
body :not(i):not([class*="icon"]):not([class*="Icon"]):not(.material-icons):not(svg):not(path) { text-shadow: 0 0 1px rgba(255,255,255,.98), 0 0 2px rgba(255,255,255,.78), 0 0 5px rgba(255,255,255,.48); }
/* The Kufi choice adds a stronger neon treatment to the lettering. */
html[data-mg-font="kufi"] body :not(i):not([class*="icon"]):not([class*="Icon"]):not(.material-icons):not(svg):not(path) { text-shadow: 0 0 1px #fff, 0 0 3px #fff, 0 0 7px rgba(255,255,255,.95), 0 0 12px rgba(255,255,255,.7); }
/* X18: font-specific baseline sizes, then user size presets relative to each baseline. */
html[data-mg-font="kufi"] body #main .menu-label { font-size:15px !important; }
html[data-mg-font="nastaliq"] body #main .menu-label { font-size:17px !important; line-height:1.8 !important; }
html[data-mg-font="vazirbold"] body #main .menu-label { font-size:18px !important; }
html[data-mg-font="estedad"] body #main .menu-label, html[data-mg-font="estedadneon"] body #main .menu-label { font-size:18px !important; }
/* X17: four fixed choices relative to the original 18px menu title; descriptions never scale up. */
html[data-mg-font-size="normal"] body #main .menu-label { font-size:18px !important; line-height:1.15 !important; }
html[data-mg-font="estedadneon"][data-mg-font-size="normal"] body #main .menu-label { font-size:14.58px !important; }
html[data-mg-font-size="large"] body #main .menu-label { font-size:19.8px !important; line-height:1.15 !important; }
html[data-mg-font-size="minus5"] body #main .menu-label { font-size:17.1px !important; line-height:1.15 !important; }
html[data-mg-font-size="minus10"] body #main .menu-label { font-size:16.2px !important; line-height:1.15 !important; }
/* Fix: 10% smaller must be relative to Estedad Neon standard (16.2px). */
html[data-mg-font="estedadneon"][data-mg-font-size="minus10"] body #main .menu-label { font-size:13.122px !important; line-height:1.15 !important; }
/* تنظیم دستی اندازه نوشته؛ از ۱۵٪ کمتر تا ۱۵٪ بیشتر با گام‌های ۲٪ */
html[data-mg-font-size^="manual-"] body #main .menu-label { font-size: calc(var(--mg-manual-font-base, 18px) * var(--mg-manual-font-scale, 1)) !important; line-height:1.22 !important; }
html[data-mg-font-size] body #main .menu-state { font-size:9px !important; line-height:1.2 !important; }
/* Keep page descriptions, labels and detailed text at their authored sizes. */
html[data-mg-font-size] body #main .menu-btn, html[data-mg-font-size] body #main .menu-label, html[data-mg-font-size] body #main .menu-state, html[data-mg-font-size] body .page button, html[data-mg-font-size] body .page .card-title {min-width:0;max-width:100%;overflow-wrap:anywhere;word-break:normal;}
html[data-mg-font-size] body #main .menu-label, html[data-mg-font-size] body .page button, html[data-mg-font-size] body .page .card-title {line-height:1.22;}
html[data-mg-font-size] body #main .menu-btn {box-sizing:border-box;}



</style>
<style id="miladgeo-job-card-v230">
#main .job-summary-box{
  margin-top:2px!important;
  padding:6px 10px 2px!important;
  min-height:64px!important;
  border:0!important;
  background:transparent!important;
  font-family:Georgia,"Times New Roman",serif!important;
  font-size:16px!important;
}
#main .job-summary-box .result-line{
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  min-height:31px!important;
  padding:0 0 5px!important;
  margin:0 0 3px!important;
  border-bottom:1px dotted rgba(55,68,55,.42)!important;
  color:#5a6359!important;
}
#main .job-summary-box .result-line:last-child{
  border-bottom:0!important;
  margin-bottom:0!important;
}
#main .job-summary-box .result-line b{
  color:#202820!important;
  font-weight:900!important;
  letter-spacing:.4px!important;
}
#main .job-nav-wrap{
  margin-top:7px!important;
  padding-bottom:2px!important;
}
#main .job-nav-wrap .job-nav{
  position:relative!important;
  min-width:210px!important;
  min-height:54px!important;
  padding:9px 20px 9px 48px!important;
  box-sizing:border-box!important;
  border:2px solid #535b53!important;
  border-radius:9px!important;
  background:linear-gradient(145deg,#f0f3ed 0%,#d5dbd1 48%,#b9c1b7 100%)!important;
  color:#1d241e!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -2px 0 rgba(50,60,50,.16),0 4px 7px rgba(20,28,20,.30)!important;
  font-family:Georgia,"Times New Roman",serif!important;
  font-size:20px!important;
  font-weight:900!important;
  letter-spacing:.8px!important;
  line-height:1.1!important;
  text-align:center!important;
}
#main .job-nav-wrap .job-nav:before{
  content:""!important;
  position:absolute!important;
  left:13px!important;
  top:50%!important;
  transform:translateY(-50%)!important;
  width:31px!important;
  height:31px!important;
  border-radius:50%!important;
  background:radial-gradient(circle at 35% 30%,#72ffc0 0%,#16d879 42%,#07904e 72%,#075f38 100%)!important;
  border:1px solid #078a4a!important;
  box-shadow:0 0 0 2px rgba(67,107,72,.25),0 2px 5px rgba(0,0,0,.28),inset 0 1px 2px rgba(255,255,255,.7)!important;
}
#main .job-nav-wrap .job-nav.job-ready{
  border-color:#535b53!important;
  background:linear-gradient(145deg,#f3f5f0 0%,#d9ded6 50%,#bcc4ba 100%)!important;
}
#main .job-nav-wrap .job-nav:not(.job-ready):before{
  background:radial-gradient(circle at 35% 30%,#ff8b8b 0%,#e43b3b 43%,#a51010 75%,#680909 100%)!important;
  border-color:#a51a1a!important;
}
#main .job-nav-wrap .job-nav:hover{
  transform:translateY(-1px)!important;
  filter:brightness(1.035)!important;
}
#main .job-nav-wrap .job-nav:active{
  transform:translateY(1px)!important;
  box-shadow:inset 0 2px 4px rgba(0,0,0,.22)!important;
}
@media(max-width:420px){
  #main .job-nav-wrap .job-nav{min-width:190px!important;font-size:18px!important;padding-left:46px!important;}
  #main .job-nav-wrap .job-nav:before{width:29px!important;height:29px!important;left:11px!important;}
}
</style>
<style id="miladgeo-job-card-v232">
/* V232: make CURRENT JOB container visually match the main menu cards */
#main .main-job-card{
  position:relative!important;
  margin-bottom:12px!important;
  padding:18px 16px 16px!important;
  border:2px solid #59665a!important;
  border-radius:15px!important;
  background:linear-gradient(145deg,#eef2ea 0%,#d3dbce 48%,#aebbad 100%)!important;
  color:#172018!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -2px 0 rgba(50,60,50,.15),0 5px 12px rgba(20,30,20,.30)!important;
  overflow:hidden!important;
}
#main .main-job-card:before{
  content:""!important;
  position:absolute!important;
  left:0!important;right:0!important;top:0!important;height:6px!important;
  background:linear-gradient(90deg,#1e5130,#8fbe62,#1e5130)!important;
}
#main .main-job-card .card-title{
  position:relative!important;
  margin-bottom:9px!important;
  color:#172018!important;
  font-weight:1000!important;
}
#main .main-job-card .job-summary-box{
  padding:4px 10px 2px!important;
}
#main .main-job-card .job-nav-wrap{
  margin-top:10px!important;
}
</style>
<style id="miladgeo-main-menu-v229">
/* MAIN MENU V229 — ONLY visual layer for cards 1–18 */
#main .menu-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important;margin-top:12px!important}
#main .menu-grid .menu-btn{position:relative!important;min-height:104px!important;padding:18px 10px 10px!important;border:2px solid #4d5b4d!important;border-radius:15px!important;background:linear-gradient(145deg,#eef2ea 0%,#d3dbce 48%,#aebbad 100%)!important;color:#172018!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -2px 0 rgba(50,60,50,.15),0 5px 12px rgba(20,30,20,.30)!important;overflow:hidden!important;transition:.12s ease!important}
#main .menu-grid .menu-btn:after{content:"";position:absolute;left:0;right:0;top:0;height:5px;background:linear-gradient(90deg,#1e5130,#8fbe62,#1e5130)!important}
#main .menu-grid .menu-num{width:34px!important;height:34px!important;margin:0 auto 5px!important;border-radius:50%!important;display:flex!important;align-items:center!important;justify-content:center!important;background:linear-gradient(145deg,#315b39,#173622)!important;color:#eff8ed!important;border:2px solid #87a97d!important;font-size:15px!important;font-weight:1000!important;line-height:1!important;box-shadow:0 3px 6px rgba(0,0,0,.28)!important}
#main .menu-grid .menu-label{font-size:16px!important;line-height:1.15!important;font-weight:1000!important;letter-spacing:.1px!important}
#main .menu-grid .menu-state{margin-top:7px!important;padding:4px 7px!important;border-radius:8px!important;background:rgba(38,65,43,.11)!important;color:#435246!important;font-size:9px!important;font-weight:900!important;line-height:1.2!important}
#main .menu-grid .menu-btn:hover{transform:translateY(-3px)!important;border-color:#6d9b5e!important;box-shadow:inset 0 1px 0 #fff,0 9px 18px rgba(25,45,27,.34),0 0 0 1px rgba(109,155,94,.18)!important}
#main .menu-grid .menu-btn:active{transform:translateY(1px)!important}
#main .menu-grid .menu-btn.locked{opacity:.62!important;filter:saturate(.65)!important}
#main .menu-grid .menu-btn:nth-child(1),#main .menu-grid .menu-btn:nth-child(2),#main .menu-grid .menu-btn:nth-child(3){background:linear-gradient(145deg,#edf5e9,#cbdcc7 50%,#a7bea3)!important;border-color:#4c7650!important}
#main .menu-grid .menu-btn:nth-child(4),#main .menu-grid .menu-btn:nth-child(5),#main .menu-grid .menu-btn:nth-child(6),#main .menu-grid .menu-btn:nth-child(7),#main .menu-grid .menu-btn:nth-child(8){background:linear-gradient(145deg,#eef0e9,#d2d7cc 50%,#b2bbae)!important}
#main .menu-grid .menu-btn:nth-child(9),#main .menu-grid .menu-btn:nth-child(10),#main .menu-grid .menu-btn:nth-child(11),#main .menu-grid .menu-btn:nth-child(12){background:linear-gradient(145deg,#e9ece4,#d5d8cc 50%,#b9c0b2)!important}
#main .menu-grid .menu-btn:nth-child(13),#main .menu-grid .menu-btn:nth-child(14),#main .menu-grid .menu-btn:nth-child(15),#main .menu-grid .menu-btn:nth-child(16){background:linear-gradient(145deg,#e8f0e3,#c8d8c3 50%,#a9bda5)!important;border-color:#56765b!important}
#main .menu-grid .menu-btn:nth-child(17),#main .menu-grid .menu-btn:nth-child(18){background:linear-gradient(145deg,#e9eee8,#cdd6cc 50%,#adb9ae)!important}
@media(max-width:420px){#main .menu-grid{gap:7px!important}#main .menu-grid .menu-btn{min-height:94px!important;padding:15px 7px 8px!important}#main .menu-grid .menu-label{font-size:14px!important}#main .menu-grid .menu-state{font-size:8px!important;margin-top:5px!important}.menu-grid .menu-btn:nth-child(14),.menu-grid .menu-btn:nth-child(15){min-height:94px!important}}
@media(min-width:1000px){html.desktop-windows #main .menu-grid .menu-btn{min-height:128px!important;padding:18px!important;border-radius:16px!important;background:linear-gradient(145deg,#202b22,#121913)!important;color:#edf4eb!important;border-color:#425342!important;box-shadow:0 8px 20px rgba(0,0,0,.38),inset 0 1px 0 rgba(255,255,255,.08)!important}html.desktop-windows #main .menu-grid .menu-label{font-size:18px!important}html.desktop-windows #main .menu-grid .menu-state{font-size:11px!important;color:#b9c6b5!important;background:rgba(255,255,255,.05)!important}html.desktop-windows #main .menu-grid .menu-num{background:#2e5935!important;color:#eff8ed!important;border-color:#86aa78!important}}
</style>
<style>
.area-sketch-wrap{margin-top:12px;background:#d9ddd5;border:2px solid #5c665d;border-radius:8px;padding:8px}.area-sketch-title{font-weight:800;font-size:15px;margin-bottom:6px}.area-sketch{width:100%;height:250px;display:block;background:#eef0eb;border:1px solid #7b847b;border-radius:5px}.area-sketch-note{font-size:12px;margin-top:5px;opacity:.8}.area-sketch polygon{fill:rgba(50,90,55,.18);stroke:#263d2b;stroke-width:2}.area-sketch line{stroke:#263d2b;stroke-width:1}.area-sketch circle{fill:#3d6b46;stroke:#fff;stroke-width:1.5}.area-sketch text{font-family:Arial,sans-serif;font-weight:800;fill:#162019;font-size:12px}.area-sketch .axis{stroke:#899189;stroke-width:1;stroke-dasharray:4 4}
</style>
<script id="miladgeo-telegram-deferred">
/* V612: Telegram SDK must never block first paint/startup.
   It is loaded only after the local UI has started, and only when the URL
   actually looks like a Telegram Mini App launch. */
(function(){
  function isTgLaunch(){
    try{
      var raw=(location.hash||'')+'\n'+(location.search||'');
      return /tgWebAppData|tgWebAppVersion|tgWebAppPlatform|tgWebAppStartParam/i.test(raw);
    }catch(e){return false}
  }
  function loadTelegram(){
    if(!isTgLaunch() || window.Telegram) return;
    var sc=document.createElement('script');
    sc.src='https://telegram.org/js/telegram-web-app.js?63';
    sc.async=true;
    sc.onerror=function(){console.warn('MiladGeo: Telegram SDK unavailable; offline/local mode continues.')};
    document.head.appendChild(sc);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',function(){setTimeout(loadTelegram,900)},{once:true});
  else setTimeout(loadTelegram,900);
})();
</script>
<script>
function m19ProfessionalReport(){
  const el=document.getElementById('m19ReportSummary'); if(!el) return;
  const rows=Array.isArray(window.m19Rows)?window.m19Rows:[];
  const nums=v=>{const n=parseFloat(v); return Number.isFinite(n)?n:0};
  let bs=0,is=0,fs=0,tp=0;
  rows.forEach(r=>{bs+=nums(r.bs);is+=nums(r.is);fs+=nums(r.fs); if(String(r.type||'').toUpperCase().includes('TP')) tp++;});
  const start=nums(document.getElementById('m19LStart')?.value);
  const end=nums(document.getElementById('m19LEnd')?.value);
  const d=end-start, control=(bs-fs)-d;
  el.innerHTML=`<div><b>تعداد ردیف:</b> ${rows.length} &nbsp; | &nbsp; <b>تعداد TP:</b> ${tp}</div><div><b>Σ B.S:</b> ${bs.toFixed(3)} m &nbsp; <b>Σ I.S:</b> ${is.toFixed(3)} m &nbsp; <b>Σ F.S:</b> ${fs.toFixed(3)} m</div><div><b>RL شروع:</b> ${start.toFixed(3)} m &nbsp; <b>RL پایان:</b> ${end.toFixed(3)} m &nbsp; <b>ΔRL:</b> ${d.toFixed(3)} m</div><div><b>خطای کنترل:</b> ${control.toFixed(3)} m</div>`;
}

</script>
