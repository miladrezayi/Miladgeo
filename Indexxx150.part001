<script>
(function(){
/* V84: each Telegram account gets its own clean data space.
   We intentionally do NOT read the old shared V3 keys, so an existing job/points
   list cannot leak into a first run or another Telegram account. */
function miladGeoAccountKey(){
  try{
    var tg=window.Telegram&&window.Telegram.WebApp;
    var u=tg&&tg.initDataUnsafe&&tg.initDataUnsafe.user;
    if(u&&u.id!=null)return String(u.id);
  }catch(e){}
  /* V612: read Telegram's launch payload locally so storage isolation does not
     wait for the remote Telegram SDK to download. */
  try{
    var raw=(location.hash||'').replace(/^#/,'');
    var m=raw.match(/(?:^|&)tgWebAppData=([^&]*)/);
    if(!m){
      var qs=(location.search||'').replace(/^\?/,'');
      m=qs.match(/(?:^|&)tgWebAppData=([^&]*)/);
    }
    if(m){
      var data=decodeURIComponent(m[1]);
      var um=data.match(/(?:^|&)user=([^&]*)/);
      if(um){
        var user=JSON.parse(decodeURIComponent(um[1]));
        if(user&&user.id!=null)return String(user.id);
      }
    }
  }catch(e){}
  /* Windows V13 uses a fresh storage namespace so old demo/test JOB data is not carried forward. */
  return "windows_v116";
}
var MILADGEO_ACCOUNT_KEY=miladGeoAccountKey();
var JOB_KEY="miladgeo_job_v85_"+MILADGEO_ACCOUNT_KEY, SETUP_KEY="miladgeo_setup_v85_"+MILADGEO_ACCOUNT_KEY, POINTS_KEY="miladgeo_points_v85_"+MILADGEO_ACCOUNT_KEY;
function $(id){return document.getElementById(id);}
var job={name:"",created:""};
var setup={stationSet:false,orientationSet:false,stationName:"",sx:null,sy:null,sz:null,stationHI:null,stationDP:"",orientationMethod:"azimuth",azimuth:null,orientationDistance:null,backName:"",bx:null,by:null,bz:null};
var points=[]; var lastCalculatedPoint=null;
function finite(v){return typeof v==='number' && isFinite(v);}
function num(v){var n=parseFloat(v);return isFinite(n)?n:NaN;}
function loadData(){try{var j=localStorage.getItem(JOB_KEY),s=localStorage.getItem(SETUP_KEY),p=localStorage.getItem(POINTS_KEY);if(j)job=JSON.parse(j);if(s)setup=JSON.parse(s);if(p)points=JSON.parse(p);if(!job||typeof job!=='object')job={name:"",created:""};if(!setup||typeof setup!=='object')setup={stationSet:false,orientationSet:false};if(!points||!Array.isArray(points))points=[];}catch(e){}}
function saveJSON(k,v){try{localStorage.setItem(k,JSON.stringify(v));}catch(e){}try{if(window.miladJobAutoSync362 && (k===JOB_KEY || k===SETUP_KEY || k===POINTS_KEY))window.miladJobAutoSync362(k);}catch(e){}}
function showPage(id){var pages=document.querySelectorAll('.page'),i,target=$(id);if(!target)return false;for(i=0;i<pages.length;i++)pages[i].classList.remove('active');target.classList.add('active');try{window.scrollTo(0,0);}catch(e){}if(id==='points')refreshPoints();if(id==='station'){renderStationSet();renderOrientationSet();}if(id==='measure'){renderStationSet();renderOrientationSet();}if(id==='stake'){renderStationSet();renderOrientationSet();}if(id==='line')renderLeicaLineUI();if(id==='stake')updateStakeSelect();if(id==='area')renderAreaPoints();if(id==='volume')renderVolumePoints();if(id==='graphicmap')renderSurveyMap();if(id==='uav')renderGCP();if(id==='training')trainingHome();if(id==='main')updateAllUI();var tb=document.getElementById('m17DrawToolbar'),th=document.getElementById('m17DrawHint');if(tb){tb.style.display=id==='menu17'?'flex':'none';tb.style.visibility=id==='menu17'?'visible':'hidden';}if(th){th.style.display='none';th.style.visibility='hidden';}if(id!=='menu17'){window.m17FromMeasureMenu2=false;}if(id==='menu17'){if(th)th.style.visibility='hidden';m17Init();if(typeof m17SetMapLayer==='function')m17SetMapLayer('hybrid');if(typeof window.m17ShowIntroLayers==='function')window.m17ShowIntroLayers();if(typeof window.m17UpdateEntryButton==='function')window.m17UpdateEntryButton();}if(id==='realMeasure'&&typeof window.m275Refresh==='function')setTimeout(window.m275Refresh,80);if(id==='menu18'){if(typeof m18Init==='function')m18Init();}else{if(typeof m18Stop==='function')m18Stop();}if(id==='menu19'){if(typeof m19cCamInit==='function')m19cCamInit();}return false;}
function goPage(id){try{history.replaceState(null,'','#'+id);}catch(e){}showPage(id);return false;}
window.goPage=goPage;
/* V389 — Menu 2 -> Menu 17 transient finish action.  The normal Menu 17
   stake-out button stays as + unless this entry came directly from Menu 2. */
window.m17FromMeasureMenu2=false;
window.m17UpdateEntryButton=function(){
  try{
    var b=document.getElementById('m17StakeBtn');
    if(!b)return;
    var on=window.m17FromMeasureMenu2===true;
    b.classList.toggle('m17-finish-mode',on);
    if(on){
      b.textContent='اتمام ✓';
      b.setAttribute('aria-label','اتمام برداشت و بازگشت به منوی ۲');
      b.setAttribute('title','اتمام برداشت و بازگشت به منوی ۲');
    }else{
      b.textContent='＋';
      b.setAttribute('aria-label','پیاده سازی نقطه');
      b.setAttribute('title','پیاده سازی نقطه');
    }
  }catch(e){}
};
window.m17FinishMeasureEntry=function(){
  try{
    if(window.m17FromMeasureMenu2!==true)return false;
    /* Lock the exact operation selected in Menu 2 before leaving Menu 17.
       m2SketchMode is the fallback for entry paths that did not set m2RealMode. */
    var mode=window.m2RealMode||window.m2SketchMode||'point';
    if(mode!=='line'&&mode!=='area')mode='point';
    window.m2RealMode=mode;
    window.m2SketchMode=mode;
    /* Finalize the in-progress line/area before returning to Menu 2. */
    if((mode==='line'||mode==='area') && typeof window.m17FinishCurrentDrawing==='function'){
      var pts=(window.m17GetDrawPoints?window.m17GetDrawPoints():[]);
      var min=mode==='area'?3:2;
      if(pts.length>0 && pts.length<min){showToast(mode==='area'?'برای اتمام مساحت حداقل سه نقطه لازم است':'برای اتمام خط حداقل دو نقطه لازم است');return false;}
      if(pts.length>=min)window.m17FinishCurrentDrawing();
    }
    window.m17FromMeasureMenu2=false;
    showPage('realMeasure');
    /* Restore the matching schematic mode, redraw from the finished Menu 17
       snapshot, then bring the entire schematic card into view on Android. */
    setTimeout(function(){
      try{
        if(typeof window.m2ReturnToSchematic==='function')window.m2ReturnToSchematic(mode);
        else if(typeof window.m275Refresh==='function')window.m275Refresh();
      }catch(e){console.error('M2_RETURN_SCHEMATIC',e);}
    },120);
  }catch(e){console.error('M17_FINISH_MEASURE_ENTRY',e);showToast('بازگشت به منوی ۲ انجام نشد');}
  return false;
};
/* V261 — real field Measure / Stake Out entry points. */
function realMeasurePoint(){
  window.m2RealMode='point';
  window.m2SketchMode='point';
  window.m17FromMeasureMenu2=true;
  try{
    showPage('menu17');
    setTimeout(function(){try{if(typeof m17Init==='function')m17Init();if(typeof setDrawMode==='function')setDrawMode('point');}catch(e){console.error('realMeasurePoint',e);showToast('ورود به برداشت نقطه انجام نشد');}},180);
  }catch(e){console.error('realMeasurePoint',e);showToast('ورود به برداشت نقطه انجام نشد');}
  return false;
}
function realMeasureLine(){
  window.m2RealMode='line';
  window.m2SketchMode='line';
  window.m17FromMeasureMenu2=true;
  try{
    showPage('menu17');
