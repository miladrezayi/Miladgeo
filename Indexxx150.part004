<style id="mgV11-female-voice-hint-style">#mgV11VoiceHint{display:block;text-align:center;font:11px/1.7 Tahoma,Arial,sans-serif;color:#516b55;padding:2px 10px}#mgV11WelcomeActions #mgV11VoiceBtn{background:#e4edf9;color:#203e63;border:1px solid #9bb8dc}#mgV11WelcomeActions button{min-width:0}</style><audio id="mgV11WelcomeVoice" playsinline="" preload="none" src="https://resource2.heygen.ai/text_to_speech/cb92a2034a5346c8b567fa71bbbe69dc/eae6fca42aae4b78b992533e96ab43c9/id=0a08adc8ef9c4ced933854f3680ae3f1.mp3"></audio><span aria-live="polite" class="mg-v11-voice-hint" id="mgV11VoiceHint"></span>
<script id="miladgeo-v13-welcome-script">
(function(){
 'use strict';
 var KEY='miladgeo_v11_first_install_welcome_seen';
 var overlay=document.getElementById('mgV11WelcomeOverlay');
 var detail=document.getElementById('mgV11LessonDetail');
 if(!overlay||!detail)return;
 var lessons=[{"title":"۱. شبیه‌ساز لایکا","sub":"ایستگاه، توجیه، برداشت و پیاده‌سازی","intro":"محیط تمرینی برای یادگیری گردش‌کار توتال‌استیشن است. ابتدا منطق استقرار و توجیه را یاد بگیر و سپس وارد شبیه‌ساز کامل Leica TS02 شو. اعداد تمرینی را با داده اجرایی اشتباه نگیر.","steps":["از کارت ۱ وارد شو و «ایستگاه و توجیه» را باز کن.","نقطه استقرار و ارتفاع دستگاه را تعریف کن؛ واحدها را یکسان نگه دار.","نقطه پشت‌نگاه را انتخاب و جهت دستگاه را تعیین کن؛ آزیموت و باقیمانده را کنترل کن.","در بخش برداشت، ارتفاع منشور، شماره نقطه و کد عارضه را وارد و چند مشاهده ثبت کن.","در پیاده‌سازی، نقطه هدف را انتخاب و اختلاف زاویه و فاصله را دنبال کن.","خط مرجع A→B را تمرین و در پایان مشاهدات را دوباره کنترل کن.","برای تمرین پیشرفته، FlexField را باز و همین مراحل را تکرار کن."],"tip":"شبیه‌ساز جایگزین کنترل دستگاه واقعی نیست. مرکزسازی، تراز، ارتفاع دستگاه و منشور و پشت‌نگاه باید مستقل کنترل شوند.","practice":"یک ایستگاه و پشت‌نگاه فرضی تعریف کن، سه نقطه برداشت کن و یکی را پیاده‌سازی کن."},{"title":"۲. برداشت","sub":"ثبت نقطه، خط، مسیر و محدوده روی نقشه","intro":"این منو برای ثبت عوارض مکانی با موقعیت واقعی نقشه است. نقطه منفرد، مسیر چندنقطه‌ای و محدوده مساحتی را جداگانه ثبت و سپس روی نقشه یا در فهرست بازبینی کن.","steps":["مجوز مکان‌یابی را در صورت درخواست تأیید و منوی برداشت را باز کن.","«برداشت نقطه» را بزن؛ پس از تثبیت GPS نقطه را ثبت و توضیح آن را وارد کن.","برای مسیر، «برداشت خط/مسیر» را انتخاب و در طول مسیر نقاط متوالی ثبت کن.","برای مساحت، گوشه‌های محدوده را به ترتیب دور بزن و پلی‌گون را ببند.","از «نقشه» برای مشاهده عوارض و از «لیست» برای مرور رکوردها استفاده کن.","شمارنده نقاط، خطوط و مساحت‌ها را کنترل و رکورد اشتباه را با دقت حذف کن."],"tip":"GPS گوشی معمولاً دقت توتال‌استیشن یا RTK را ندارد؛ دقت، شرایط آسمان و محدودیت چندمسیری را در گزارش ذکر کن.","practice":"سه نقطه، یک مسیر کوتاه و یک محدوده چهارگوش ثبت و تعداد رکوردها را تطبیق بده."},{"title":"۳. پیاده‌سازی","sub":"مختصات طرح، فایل نقاط و راهنمای زنده","intro":"این بخش مختصات طراحی‌شده را به محل واقعی هدایت می‌کند. نقطه را با شناسه پیدا کن، مختصات UTM یا جغرافیایی وارد کن یا فهرست نقاط را از فایل بارگذاری کن.","steps":["نقطه هدف را با شماره یا شناسه جست‌وجو کن.","حالت UTM یا طول/عرض را درست انتخاب و در UTM زون را کنترل کن.","برای ورود گروهی، فایل نقاط را بارگذاری و ترتیب ستون‌ها و زون را بررسی کن.","«پیاده‌سازی زنده» را اجرا و راهنمای فاصله و جهت را دنبال کن.","در محل هدف علامت بگذار و در صورت امکان موقعیت اجراشده را دوباره برداشت کن.","گزارش PDF یا خروجی Excel/PENZD و KML/KMZ را تهیه کن."],"tip":"ترتیب X/Y، زون، نیم‌کره و Datum را با فایل طرح تطبیق بده؛ قطب‌نمای گوشی مبنای توجیه دقیق نیست.","practice":"دو نقطه وارد کن، یکی را انتخاب و گزارش آزمایشی پیاده‌سازی بساز."},{"title":"۴. ترازیابی و توپوگرافی","sub":"دفتر ترازیابی، خطای بست، پروفیل و خطوط میزان","intro":"منوی ۴ دو مسیر دارد: ترازیابی برای قرائت‌ها و محاسبات ارتفاعی، و توپوگرافی برای تحلیل DEM و تولید خطوط میزان و خروجی CAD.","steps":["مشخص کن کار تو ترازیابی است یا توپوگرافی.","در دفتر ترازیابی قرائت عقب، میانی و جلو را به ترتیب و با ارتفاع مبنای درست وارد کن.","محاسبات را اجرا، تراز نقاط و خطای بست را کنترل و با تلرانس پروژه مقایسه کن.","برای پروفیل، خط A→B را روی نقشه انتخاب و پروفیل طولی را بساز.","در توپوگرافی محدوده، منبع DEM و فاصله خطوط میزان را انتخاب کن.","در صورت استفاده از OpenTopography کلید API را وارد، محدوده را بررسی و تحلیل را اجرا کن.","خروجی DXF یا PDF را تولید و قبل از تحویل بازبینی کن."],"tip":"ترتیب قرائت و ارتفاع مبنا را کنترل کن؛ وضوح و تاریخ DEM بر جزئیات سطح اثر می‌گذارد.","practice":"یک دفتر سه‌ایستگاهی بساز، خطای بست را بررسی و یک پروفیل تمرینی تولید کن."},{"title":"۵. نقاط و TXT","sub":"ثبت، ورود فایل، کنترل و خروجی بانک نقاط","intro":"این منو بانک نقاط پروژه است. هر رکورد شماره، کد عارضه و مختصات X/Y/Z دارد؛ ورود دستی و گروهی و خروجی برای دستگاه‌ها و نرم‌افزارهای دیگر فراهم است.","steps":["در مدیریت، فهرست را جست‌وجو و شماره یا کد نقطه را پیدا کن.","در ورود دستی شماره، CODE/DP، X، Y و Z را وارد و ثبت کن.","برای ورود گروهی TXT/CSV/ASCII را انتخاب و قالب و شیوه شماره‌گذاری را مشخص کن.","پیش‌نمایش را ببین و جداکننده و ترتیب ستون‌ها را کنترل کن.","کنترل نقاط را اجرا و رکورد تکراری، مختصات نامعتبر یا کد خالی را اصلاح کن.","در عملیات شماره یا کد را تغییر بده یا مختصات را منتقل کن.","خروجی TXT، CSV، Excel، PDF، DXF یا KML را بگیر و دوباره باز کن."],"tip":"ترتیب PENZD و PNEZD یکسان نیست؛ ستون‌ها را حدس نزن، چون جابه‌جایی مختصات کل برداشت را خراب می‌کند.","practice":"پنج نقطه بساز، یک CSV وارد و خروجی DXF و KML تولید کن."},{"title":"۶. اکسل","sub":"ورود، تشخیص ستون، کنترل داده و خروجی نقشه‌برداری","intro":"منوی ۶ برای تبادل داده Excel/CSV با قالب‌های نقشه‌برداری است. داده را بخوان، Sheet و ستون‌ها را مشخص کن، ردیف‌های نامعتبر را کنترل و قالب مقصد را انتخاب کن.","steps":["فایل XLSX یا CSV را انتخاب و بخوان.","Sheet و وجود یا نبود سطر عنوان ستون‌ها را تعیین کن.","ستون‌های Point، Code، X، Y و Z را تشخیص بده و پیش‌نمایش بگیر.","کنترل داده را اجرا و ردیف ناقص، مختصات غیرعددی و شماره تکراری را اصلاح کن.","قالب مقصد را انتخاب و تبدیل را اجرا کن.","خروجی PENZD، PNEZD، NEZ، ENZ، Leica ASCII، LandXML یا GeoJSON را متناسب با مقصد بگیر.","تعداد رکوردهای خروجی را با ورودی مقایسه کن."],"tip":"قبل از تبدیل گروهی یک فایل کوچک آزمایشی را در نرم‌افزار مقصد باز کن؛ تشخیص نام ستون به‌تنهایی ترتیب مختصات را تضمین نمی‌کند.","practice":"یک جدول پنج‌نقطه‌ای وارد و خروجی PENZD و KML تولید کن."},{"title":"۷. مساحت و چندضلعی","sub":"محاسبه مساحت، Offset و تقسیم زمین","intro":"نقاط مرزی را دستی، از JOB یا Excel وارد کن؛ مساحت و محیط را محاسبه کن و در صورت نیاز محدوده را Buffer یا به قطعات مساوی/با مساحت دلخواه تقسیم کن.","steps":["روش ورود دستی، JOB یا Excel را انتخاب کن.","رأس‌ها را به ترتیب دور محدوده وارد کن و از نقطه تکراری یا پرش بین رأس‌ها پرهیز کن.","محاسبه را اجرا و مساحت، محیط و شکل محدوده را کنترل کن.","خروجی DXF، Excel، KML، PDF، CSV یا TXT بگیر.","برای Offset/Buffer فاصله و سمت جابه‌جایی را با واحد روشن وارد کن.","تقسیم مساوی یا تقسیم با مساحت دلخواه را اجرا و قطعات را بررسی کن.","جمع مساحت قطعات را با مساحت اولیه تطبیق بده."],"tip":"مساحت به ترتیب رأس‌ها و سیستم مختصات وابسته است؛ برای زمین بزرگ روش محاسبه و تصویر نقشه‌ای را در نظر بگیر.","practice":"یک چهارضلعی را محاسبه و به دو قطعه تقسیم کن."},{"title":"۸. حجم عملیات خاکی و 3D","sub":"PENZD، سطح زمین، پروفیل و Cut/Fill","intro":"داده ارتفاعی به مدل سطح تبدیل می‌شود و سپس می‌توان سطح موجود و طرح را مقایسه و حجم خاک‌برداری و خاک‌ریزی را برآورد کرد. کیفیت خروجی به صحت و توزیع نقاط وابسته است.","steps":["فایل PENZD را وارد و ترتیب ستون‌ها، واحد و ارتفاع را کنترل کن.","نقاط پرت، تکراری و خارج محدوده را بررسی کن.","سطح موجود را بساز و مثلث‌بندی و حفره‌های مدل را بازبینی کن.","سطح طرح را وارد یا تعریف و مبنای ارتفاعی دو سطح را یکسان کن.","تحلیل Cut/Fill را اجرا و حجم‌ها و تراز مبنا را بررسی کن.","پروفیل طولی و مقاطع عرضی را در محورهای لازم بساز.","گزارش و خروجی PDF/DXF/Excel را ذخیره کن."],"tip":"دو سطح باید سیستم افقی، Datum ارتفاعی، واحد و محدوده مشترک داشته باشند؛ حجم نهایی را با کنترل مستقل بسنج.","practice":"یک فایل PENZD کوچک وارد و حجم بین سطح موجود و طرح ساده را گزارش کن."},{"title":"۹. Mini AutoCAD","sub":"ترسیم، لایه‌بندی، متن و خروجی CAD","intro":"محیط ترسیم و ویرایش دوبعدی برای بازکردن یا ساخت نقشه است. با ابزارهای پایه ترسیم، لایه‌ها، متن فارسی و اندازه‌گذاری نقشه فنی را آماده کن.","steps":["فایل DWG/DXF را باز کن یا نقشه جدید بساز.","واحد و محدوده ترسیم و مبنای مختصات را تعیین کن.","با LINE، PLINE، CIRCLE، RECTANGLE و POINT هندسه را رسم کن.","برای حدود، عوارض، نوشته و اندازه‌گذاری لایه‌های جدا بساز.","اجزا را انتخاب و ویرایش کن؛ پیش از تغییر گروهی نسخه پشتیبان بگیر.","متن فارسی/انگلیسی و برچسب نقطه اضافه و فونت را کنترل کن.","DXF را ذخیره و در صورت نیاز PDF، Excel، TXT یا KML خروجی بگیر."],"tip":"مختصات واقعی و واحد ترسیم را حفظ کن؛ PDF یا تصویر جایگزین فایل CAD قابل ویرایش نیست.","practice":"پلان ساده چهارضلعی با دایره، سه نقطه، دو لایه و متن فارسی بساز."},{"title":"۱۰. مرکز فایل و چاپ","sub":"DXF→PDF، PDF خوان، DXF خوان، Word و Excel","intro":"منوی ۱۰ پنج ابزار مستقل دارد. علاوه بر تبدیل DXF به PDF، خواندن PDF و DXF، بازکردن و ویرایش سند Word و نمایش و ویرایش فایل Excel را انجام می‌دهد.","steps":["در DXF→PDF فایل را باز و پیش‌نمایش را با زوم بررسی کن.","کاغذ، جهت، مقیاس، جای‌گیری، حاشیه، عنوان، نام پروژه، تهیه‌کننده و شماره نقشه را تنظیم کن.","PDF نقشه، فهرست نقاط، PDF کامل، Excel مهندسی یا CSV را انتخاب و خروجی را کنترل کن.","در PDF خوان فایل را داخل نمایشگر داخلی باز کن و صفحه‌ها و خوانایی را بررسی کن.","در DXF خوان نقشه را پردازش کن؛ POINT، X/Y، MEAS، Area و PLINE را برای نقاط و اندازه‌گیری به‌کار ببر.","در Word خوان DOCX را باز کن؛ قالب‌بندی، جست‌وجو/جایگزینی، جدول، سربرگ، پابرگ، امضا، ذخیره DOCX و خروجی PDF را استفاده کن.","در Excel خوان فایل و Sheet را انتخاب؛ سلول را لمس و مقدار را ویرایش کن. پنل اکسل پیشرفته را برای واردکردن فرمول باز و سپس Excel/PDF خروجی بگیر."],"tip":"منوی ۶ برای تبدیل بانک نقاط است؛ منوی ۱۰ برای نمایشگر و کار با فایل‌های اداری/CAD. مقیاس چاپ، کادر، ضخامت خطوط و فونت فارسی PDF را کنترل کن.","practice":"یک DXF را اندازه‌گیری و PDF کامل کن؛ سپس یک سلول Excel را تغییر بده و خروجی بگیر."},{"title":"۱۱. تبدیل مختصات","sub":"انتقال دستی، لیست نقاط و استخراج KML/KMZ","intro":"سه مسیر دارد: انتقال دستی چند نقطه، تبدیل لیست نقاط و استخراج مختصات از KML/KMZ. در همه آن‌ها سیستم مبدأ و مقصد، زون و ترتیب محور را مشخص کن.","steps":["سیستم مبدأ و مقصد و زون‌های UTM را انتخاب کن.","نقاط را با X/Y وارد و در صورت نیاز نقطه‌های بیشتری اضافه کن.","انتقال را اجرا و با نقطه کنترل معلوم نتیجه را بسنج.","برای لیست، فایل را انتخاب و قالب PENZD و زون را مشخص کن.","تبدیل لیست را اجرا و تعداد و ترتیب ستون‌ها را کنترل کن.","برای KML/KMZ فایل را انتخاب و مختصات را استخراج کن.","خروجی Excel، TXT، KML یا PDF را بگیر و در نرم‌افزار مقصد باز کن."],"tip":"Datum، زون، نیم‌کره، واحد و ترتیب محور باید معلوم باشند؛ تغییر عنوان ستون‌ها تبدیل مختصات نیست.","practice":"دو نقطه UTM را تبدیل و خروجی KML را روی نقشه کنترل کن."},{"title":"۱۲. تبدیل واحدها","sub":"طول، مساحت، حجم، زاویه، شیب و مختصات","intro":"شش گروه کمیت را پوشش می‌دهد. تبدیل واحد طول یا مساحت را با تبدیل سیستم مرجع مکانی اشتباه نگیر و همیشه واحد مبدأ و مقصد را کنار عدد بخوان.","steps":["گروه طول، مساحت، حجم، زاویه، شیب یا مختصات را انتخاب کن.","مقدار و واحد مبدأ را دقیق وارد کن.","واحد مقصد را انتخاب و تبدیل را اجرا کن.","در زاویه تفاوت درجه، دقیقه، ثانیه و رادیان را رعایت کن.","در شیب، درصد و نسبت را با هم اشتباه نگیر.","نتیجه و واحد را با تبدیل دستی یا ابزار مستقل کنترل کن."],"tip":"تبدیل متر به فوت فقط واحد را عوض می‌کند؛ Datum، زون یا تصویر نقشه‌ای تغییر نمی‌کند.","practice":"۱٫۵ هکتار را به مترمربع و ۲۵ درجه را به رادیان تبدیل کن."},{"title":"۱۳. محاسبات نقشه‌برداری COGO","sub":"فاصله، آزیموت، تقاطع، مختصات و هندسه","intro":"COGO برای حل مسائل هندسی نقشه‌برداری است: اختلاف مؤلفه‌ها، فاصله و آزیموت دو نقطه، مختصات نقطه از مبنا، تقاطع‌ها و مساحت.","steps":["در محاسبات اصلی ΔX، ΔY و ΔZ را وارد کن.","برای فاصله و آزیموت مختصات دو نقطه را وارد و محاسبه کن.","برای مختصات نقطه از مبنا، X/Y مبنا، آزیموت و فاصله را بده.","در تقاطع، داده‌های نقاط و شعاع‌ها را وارد و جواب هندسی سازگار را انتخاب کن.","برای مساحت، رأس‌ها را به ترتیب پیرامونی وارد کن.","برای آماده‌سازی نقطه، X/Y/Z و کد را ثبت کن.","نتیجه و ورودی‌ها را در گزارش پروژه ثبت کن."],"tip":"قرارداد آزیموت، جهت محور و واحد را ثابت نگه دار؛ مسئله ممکن است بیش از یک جواب هندسی داشته باشد.","practice":"فاصله و آزیموت دو نقطه را محاسبه و نقطه دوم را از مبدا بازسازی کن."},{"title":"۱۴. ماشین‌حساب مهندسی","sub":"توابع مثلثاتی، حافظه، DEG/RAD و گزارش","intro":"ماشین‌حساب شامل چهار عمل اصلی، توابع مثلثاتی و معکوس، توان، ریشه، لگاریتم و حافظه است. ابزارهای محاسبات نقشه‌برداری نیز از همین محیط قابل دسترسی‌اند.","steps":["پیش از محاسبه زاویه‌ای حالت DEG یا RAD را مشخص کن.","عبارت را با پرانتز کامل وارد و از AC برای شروع تازه استفاده کن.","sin، cos، tan و توابع معکوس را با واحد زاویه درست به‌کار ببر.","توان، ریشه، ln و log را با دامنه معتبر محاسبه کن.","MC، MR، M+ و M− را برای حافظه استفاده و پیش از محاسبه بعدی پاک کن.","از کارت‌های فاصله، آزیموت، ΔX/ΔY و اختلاف ارتفاع استفاده کن.","گزارش را مرور و مقادیر مهم را با روش دوم کنترل کن."],"tip":"حالت DEG/RAD منبع رایج خطاست؛ نتیجه بدون واحد و روش را وارد گزارش اجرایی نکن.","practice":"sin 30°، cos 60°، √625 و فاصله با ΔX=30 و ΔY=40 را حساب کن."},{"title":"۱۵. سرگرمی مهندس","sub":"بازی‌ها، سطح دشواری و رکوردها","intro":"این بخش برای استراحت کوتاه و تمرین تمرکز و حل مسئله است. بازی را از فهرست انتخاب کن، حالت و دشواری را تنظیم کن و امتیاز یا رکورد خود را دنبال کن.","steps":["مرکز سرگرمی را باز و بازی‌های موجود را مرور کن.","بازی موردنظر و سطح یا حالت آن را انتخاب کن.","راهنمای کنترل‌ها را بخوان و یک دور تمرینی انجام بده.","هدف مرحله و شرط پایان را بررسی کن.","پس از پایان امتیاز را با رکورد قبلی مقایسه کن.","با کنترل بازگشت خود بازی به فهرست برگرد."],"tip":"امتیاز بازی ابزار ارزیابی مهارت اجرایی یا دقت محاسبات مهندسی نیست.","practice":"یک مرحله را کامل کن و همان مرحله را دوباره انجام بده و نتیجه را مقایسه کن."},{"title":"۱۶. کتابخانه مهندسی","sub":"۸ مرجع آموزشی و تخصصی","intro":"کتابخانه شامل دیکشنری ۱۱۰۰+ واژه، فرم‌ها، آموزش، فلش‌کارت، فرمول‌نامه، تعرفه‌های ۱۴۰۵، اصطلاحات و جست‌وجوی مقالات علمی است.","steps":["در دیکشنری واژه فارسی/انگلیسی را جست‌وجو و تعریف تخصصی را بخوان.","در فرم‌ها نوع فرم مثل مختصات، برداشت، دفتر ترازیابی یا چک‌لیست را انتخاب؛ پروژه و تاریخ را وارد و PDF بگیر.","در آموزش نقشه‌برداری موضوع را از مبانی تا کار میدانی دنبال کن.","در فلش‌کارت پاسخ را پیش از نمایش حدس بزن و موارد دشوار را مرور کن.","در فرمول‌نامه رابطه را پیدا و در صورت وجود ابزار محاسبه، ورودی و واحد را وارد کن.","تعرفه‌های ۱۴۰۵ را برای برآورد اولیه ببین و تاریخ/شرایط را بررسی کن.","در اصطلاحات مخفف‌ها را جست‌وجو و در جست‌وجوی علمی موضوع یا DOI را وارد کن؛ چکیده و منبع را بخوان."],"tip":"تعرفه و مقاله نیازمند بررسی تاریخ و منبع اصلی است؛ فرمول را با واحد و فرض‌های مسئله تطبیق بده.","practice":"فرم دفتر ترازیابی را تکمیل و PDF بگیر، سپس یک واژه GNSS و فلش‌کارت مرتبط را پیدا کن."},{"title":"۱۷. گوگل ارث و نقشه","sub":"لایه‌ها، شبکه مختصات، GPS و مسیر","intro":"این محیط نقشه و کره زمین را با لایه‌های خیابانی، توپوگرافی، پستی‌وبلندی و ماهواره‌ای نمایش می‌دهد. شبکه مختصات، جست‌وجو، مسیر و ابزار تاریخی نیز در دسترس است.","steps":["مجوز مکان‌یابی را تأیید و در صورت نیاز GPS دستگاه را روشن کن.","از لایه‌ها بین خیابانی، توپوگرافی، پستی‌وبلندی، ماهواره‌ای و ترکیبی جابه‌جا شو.","شبکه طول/عرض جغرافیایی یا UTM را روشن کن.","مکان یا مختصات را جست‌وجو و زون و سیستم را هنگام تفسیر کنترل کن.","بخش تاریخی را در صورت وجود داده برای محدوده بررسی کن.","مقصد را وارد، یافتن مسیر را بزن و مسیر پیشنهادی را بازبینی کن.","پس از کار وضعیت GPS و لایه‌ها را به حالت موردنیاز برگردان."],"tip":"تصویر ماهواره‌ای مرجع برداشت دقیق یا تعیین مرز ثبتی نیست؛ تاریخ و دقت لایه‌ها متفاوت است.","practice":"یک نقطه را جست‌وجو، لایه ماهواره‌ای/توپوگرافی را مقایسه و شبکه UTM را فعال کن."},{"title":"۱۸. مرکز جهت‌یابی","sub":"قطب‌نما، آزیموت و حسگرهای گوشی","intro":"قطب‌نمای گوشی ابزار کمکی جهت‌یابی است و از حسگر مغناطیسی استفاده می‌کند. فلز، خودرو و میدان‌های الکترومغناطیسی می‌توانند قرائت را منحرف کنند.","steps":["در فضای باز و دور از خودرو و اجسام فلزی منو را باز کن.","گوشی را در وضعیت مناسب بگیر و در صورت ناپایداری حسگر را کالیبره کن.","جهت و آزیموت را بخوان و مرجع شمال را مشخص کن.","اگر آزیموت شبکه‌ای لازم است، تصحیح‌های معتبر را از مرجع مناسب اعمال کن.","جهت را با امتداد شناخته‌شده یا ابزار مستقل کنترل و چند بار تکرار کن.","روش و مرجع شمال را در گزارش ثبت کن."],"tip":"قطب‌نما نزدیک سازه فولادی یا توتال‌استیشن قابل اتکا نیست؛ توجیه دقیق باید با نقاط کنترل انجام شود.","practice":"سه جهت را در فضای باز ثبت و تغییر قرائت نزدیک جسم فلزی را مشاهده کن."},{"title":"۱۹. دوربین نقشه‌برداری","sub":"۵ ابزار ثبت، نشانه‌گذاری، گالری و اندازه‌گیری","intro":"این منو پنج ابزار دارد: ثبت عکس نقطه، عکس و نشانه‌گذاری، عکس‌های پروژه، گالری پروژه و اندازه‌گیری روی عکس. تصویر را به نقطه و پروژه پیوند بده تا مستندات قابل پیگیری باشند.","steps":["در ثبت عکس نقطه، نقطه را انتخاب، دوربین را باز و عکس را به همان نقطه متصل کن.","در عکس و نشانه‌گذاری شماره نقطه، X/Y/Z و توضیح اضافه و با فلش عارضه را مشخص کن.","در عکس‌های پروژه ارتباط هر تصویر با نقطه را بررسی کن.","در گالری پروژه تصاویر را مرور و پیش از حذف از نگهداری نسخه لازم مطمئن شو.","برای اندازه‌گیری روی عکس یک فاصله مرجع معلوم تعیین و مقدار واقعی را وارد کن.","پس از مقیاس‌گذاری، فاصله عوارض دیگر را اندازه بگیر و نتیجه را برآورد تصویری ثبت کن.","تصاویر را با تاریخ، شماره نقطه و نام پروژه دسته‌بندی کن."],"tip":"پرسپکتیو، زاویه دوربین و اعوجاج لنز بر اندازه‌گیری تصویری اثر دارند؛ نتیجه را برداشت دقیق زمینی تلقی نکن.","practice":"یک عکس نقطه ثبت، توضیح و نشانه اضافه و با فاصله مرجع یک اندازه آزمایشی بگیر."},{"title":"۲۰. دفتر مهندس","sub":"۱۳ ابزار برای دفترکار و مدیریت پروژه نقشه‌برداری","intro":"دفتر مهندس فقط یادداشت نیست؛ سررسید، یادداشت دست‌نویس، آرشیو، کروکی، عکس حاشیه‌نویسی‌شده، سربرگ، کارت ویزیت، کارت بانکی، قرارداد، فاکتور، حسابداری و مدیریت پروژه را یکجا دارد.","steps":["۱) سررسید ۱۴۰۵ تا ۱۴۱۰: قرار بازدید، جلسه، موعد تحویل و یادآور را در تاریخ درست ثبت و کارهای باز را روزانه مرور کن.","۲) یادداشت جدید: با انگشت یا S Pen بنویس، متن و هایلایت اضافه، عنوان/تاریخ/پروژه را مشخص و ذخیره کن.","۳) یادداشت قبلی: آرشیو را جست‌وجو، یادداشت را باز و اصلاح و نسخه جدید را با تاریخ نگه دار.","۴) کروکی آزاد: مسیر دسترسی، محل استقرار و جزئیات کارگاه را رسم؛ شمال، ابعاد و نقاط مرجع را بنویس.","۵) عکس + دست‌نویس: عکس پروژه را وارد و فلش، علامت و توضیح و شماره نقطه روی آن اضافه کن.","۶) سربرگ شرکت: مشخصات، لوگو، امضا/مهر و قالب متن را تنظیم و نامه A4 یا PDF بساز.","۷) کارت ویزیت: قالب، رنگ، عکس و اطلاعات تماس را تنظیم و JPEG بگیر.","۸) شماره کارت: اطلاعات بانکی لازم را در کارت تصویری درج و JPEG بساز؛ فقط اطلاعات ضروری را به اشتراک بگذار.","۹) آرشیو فعالیت‌ها: یادداشت‌ها و اسناد را جست‌وجو و با نام پروژه و تاریخ دسته‌بندی کن.","۱۰) قرارداد نقشه‌برداری: طرفین، محدوده، روش تحویل، زمان، مبلغ، پرداخت، تعهدات و تلرانس را تکمیل و Word/PDF بگیر؛ قبل امضا بازبینی کن.","۱۱) فاکتور: خدمات، مقدار، واحد، نرخ، کسورات و جمع را ثبت و با قرارداد تطبیق بده؛ PDF بگیر.","۱۲) حسابدار مهندس: درآمد، هزینه، پرداخت، بدهی، دستمزد و هزینه تجهیزات هر پروژه را با تاریخ و شرح ثبت و مانده را کنترل کن.","۱۳) مدیریت پروژه: پرونده، کارفرما، زمان‌بندی، اکیپ، تجهیزات، وظایف، گزارش روزانه و کنترل مالی را تکمیل و پیشرفت را با برنامه مقایسه کن."],"tip":"قرارداد، فاکتور و اطلاعات بانکی را پیش از ارسال/امضا خودت کنترل کن؛ برای داده محرمانه پروژه نسخه پشتیبان امن نگه دار.","practice":"یک پروژه آزمایشی بساز، بازدید را در سررسید ثبت، یادداشت و کروکی ذخیره و قرارداد، فاکتور و وظیفه‌ای در مدیریت پروژه ایجاد کن."},{"title":"۲۱. استخدام و رزومه","sub":"آگهی شغلی، رزومه، چت و ارسال فایل","intro":"این بخش ارتباط کارجو و کارفرما را فراهم می‌کند. مهندس رزومه منتشر می‌کند و فرصت‌ها را می‌بیند؛ کارفرما آگهی ثبت می‌کند و گفتگو و فایل از طریق پیام داخلی پیگیری می‌شود.","steps":["وارد بخش استخدام شو و حساب کاربری را تکمیل کن.","آگهی‌ها را بر اساس عنوان، شهر، تخصص و شرایط همکاری بررسی کن.","رزومه را با سوابق، مهارت‌ها، نرم‌افزارها و دستگاه‌های قابل استفاده کامل کن.","در آگهی استخدام شرح وظایف، شهر، شرایط احراز و نوع همکاری را روشن بنویس.","پیام‌های دریافتی و چت داخلی را برای پیگیری بررسی و فایل لازم را ارسال کن.","پیش از پذیرش، هویت کارفرما، مبلغ، محل و شرایط پرداخت را مکتوب کن.","آگهی مشکوک را گزارش کن و اطلاعات حساس را منتشر نکن."],"tip":"شماره ملی، اطلاعات بانکی و نشانی منزل را در رزومه عمومی قرار نده؛ شرایط مالی و ایمنی را پیش از شروع روشن کن.","practice":"یک رزومه نمونه با تخصص، نرم‌افزار و تجربه آماده و یک آگهی را ارزیابی کن."},{"title":"۲۲. بازار تجهیزات نقشه‌برداری","sub":"آگهی خرید و فروش، فیلتر شهر و قیمت","intro":"بازار تخصصی تجهیزات و اقلام مهندسی است. آگهی می‌تواند چند عکس، قیمت ثابت یا توافقی، شهر، برند و دسته‌بندی داشته باشد. پیش از معامله مشخصات و وضعیت دستگاه را بررسی کن.","steps":["دسته تجهیز مانند توتال‌استیشن، GNSS، ترازیاب یا لوازم جانبی را انتخاب کن.","با فیلتر شهر، برند و بازه قیمت آگهی‌ها را محدود کن.","مدل، تصاویر، وضعیت، لوازم همراه و توضیحات فروشنده را بخوان.","برای فروش عنوان، دسته، برند، شهر، وضعیت، قیمت و تصاویر واقعی را وارد کن.","روش تماس یا پیام داخلی را تنظیم و پرسش فنی را پاسخ بده.","پیش از خرید کالیبراسیون، سرویس، باتری، شارژر و عملکرد دستگاه را تست کن.","رسید و توافق را نگه دار و وضعیت آگهی را به‌روز کن."],"tip":"ظاهر سالم کافی نیست؛ گواهی کالیبراسیون و تست میدانی و متعلقات را بررسی کن.","practice":"یک آگهی GNSS نمونه بساز و چک‌لیست بررسی پیش از پرداخت تهیه کن."},{"title":"۲۳. بازار آنلاین قیمت مصالح","sub":"مقایسه قیمت، واحد، شهر و زمان استعلام","intro":"این بخش برای مشاهده و مقایسه قیمت مصالح است. شهر، واحد فروش، برند، کیفیت، حمل و تاریخ استعلام بر قیمت تمام‌شده اثر دارند؛ داده را برای برآورد اولیه به‌کار ببر و پیش از خرید استعلام روز بگیر.","steps":["گروه کالای موردنظر را انتخاب و نام یا مشخصات را جست‌وجو کن.","قیمت‌ها را بر اساس شهر، برند و واحد فروش مقایسه کن.","تاریخ به‌روزرسانی، مالیات و هزینه حمل را بررسی کن.","مشخصات فنی، رده، ابعاد، وزن و استاندارد کالاهای مشابه را تطبیق بده.","مقدار موردنیاز، پرت، حمل و هزینه اجرا را جداگانه در برآورد ثبت کن.","پیش از سفارش موجودی، تحویل، پرداخت و اعتبار پیش‌فاکتور را تأیید کن."],"tip":"قیمت آنلاین لزوماً قیمت قطعی معامله نیست؛ تاریخ، شهر، واحد، کیفیت و حمل را کنار هر عدد ثبت کن.","practice":"سه قلم مصالح را در جدول مقایسه کن و قیمت تمام‌شده را با حمل محاسبه کن."}];
 var welcomeVoice=document.getElementById('mgV11WelcomeVoice');
 var voicePlayed=false,voiceBusy=false;
 var welcomeText='سلام! به میلادژئو خوش آمدید. اینجا همراه هوشمند شما برای کارهای مهندسی و نقشه‌برداری است. از بخش آموزش کار با اپ می‌توانید با ابزارها آشنا شوید. برای شروع، منوی موردنظرتان را انتخاب کنید. امیدواریم تجربه خوبی داشته باشید.';
 function markVoicePlayed(){voicePlayed=true;voiceBusy=false;try{localStorage.setItem(KEY+'_voice','1')}catch(e){}var hint=document.getElementById('mgV11VoiceHint');if(hint)hint.textContent='خوش‌آمدگویی صوتی پخش شد ✓';}
 function speakFallback(){
  if(voicePlayed||voiceBusy)return;
  if(!('speechSynthesis' in window)||!window.SpeechSynthesisUtterance){var h=document.getElementById('mgV11VoiceHint');if(h)h.textContent='پخش صدا در این دستگاه پشتیبانی نمی‌شود.';return;}
  try{
   voiceBusy=true;var synth=window.speechSynthesis;var voices=synth.getVoices?synth.getVoices():[];
   var avatar='classic';try{avatar=localStorage.getItem('miladgeo_bot_head_style_v117')||'classic'}catch(e){}
   var fa=voices.filter(function(v){return /^fa([_-]|$)/i.test(v.lang||'')});
   if(avatar==='girl'&&!fa.length){voiceBusy=false;var h=document.getElementById('mgV11VoiceHint');if(h)h.textContent='برای صدای فارسی، موتور و صدای فارسی را در تنظیمات گفتار گوشی فعال کن.';return;}
   var female=fa.find(function(v){return /female|woman|girl|darya|دریا|زنانه/i.test((v.name||'')+' '+(v.voiceURI||''))})||fa[0]||null;
   var u=new SpeechSynthesisUtterance(welcomeText);u.lang=female?(female.lang||'fa-IR'):'fa-IR';if(female)u.voice=female;
   u.rate=.92;u.pitch=avatar==='girl'?1.22:1;u.volume=1;
   u.onend=markVoicePlayed;u.onerror=function(){voiceBusy=false;var h=document.getElementById('mgV11VoiceHint');if(h)h.textContent='صدای فارسی گوشی اجرا نشد؛ تنظیمات تبدیل نوشتار به گفتار را بررسی کن.';};
   synth.cancel();synth.resume&&synth.resume();synth.speak(u);
   setTimeout(function(){if(voiceBusy&&!(synth.speaking||synth.pending)){voiceBusy=false;}},2500);
  }catch(e){voiceBusy=false;}
 }
 function playWelcomeVoice(){
  if(voicePlayed||voiceBusy)return;
  if(!welcomeVoice){speakFallback();return;}
  try{
   welcomeVoice.pause();welcomeVoice.currentTime=0;
   welcomeVoice.onended=markVoicePlayed;
   welcomeVoice.onerror=function(){voiceBusy=false;speakFallback();};
   var p=welcomeVoice.play();
   if(p&&typeof p.then==='function')p.then(function(){voiceBusy=true;var h=document.getElementById('mgV11VoiceHint');if(h)h.textContent='در حال پخش خوش‌آمدگویی…';}).catch(function(){voiceBusy=false;var h=document.getElementById('mgV11VoiceHint');if(h)h.textContent='برای شنیدن خوش‌آمدگویی، دکمه «شنیدن خوش‌آمدگویی» را لمس کن.';});
   else{voiceBusy=true;}
  }catch(e){voiceBusy=false;speakFallback();}
 }
 function open(){overlay.classList.add('mg-open');document.body.style.overflow='hidden';var voiceDone=false;try{voiceDone=localStorage.getItem(KEY+'_voice')==='1';}catch(e){}if(!voiceDone){voicePlayed=false;playWelcomeVoice();}}
 function close(markSeen){
  overlay.classList.remove('mg-open');
  document.body.style.overflow='';
  if(welcomeVoice){try{welcomeVoice.pause();welcomeVoice.currentTime=0;}catch(e){}}
  if(window.speechSynthesis&&typeof window.speechSynthesis.cancel==='function'){try{window.speechSynthesis.cancel();}catch(e){}}
  voiceBusy=false;
  if(markSeen){try{localStorage.setItem(KEY,'1');}catch(e){}}
 }
 function esc(v){return String(v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
 function selectLesson(i){
   var L=lessons[i];if(!L)return;
   detail.innerHTML='<strong class="mg-lesson-title">'+esc(L.title)+'</strong>'+
    '<p class="mg-lesson-intro">'+esc(L.intro)+'</p>'+'<div class="mg-lesson-tip"><strong>محدوده آموزش:</strong> '+esc(L.sub)+'</div>'+
    '<strong class="mg-lesson-subtitle">مراحل پیشنهادی کار</strong><ol>'+L.steps.map(function(x){return '<li>'+esc(x)+'</li>';}).join('')+'</ol>'+
    '<div class="mg-lesson-tip"><strong>نکته مهندسی:</strong> '+esc(L.tip)+'</div>'+
    '<div class="mg-lesson-practice"><strong>تمرین کوتاه:</strong> '+esc(L.practice)+'</div>';
   detail.classList.add('mg-show');
   setTimeout(function(){var body=document.getElementById('mgV11WelcomeBody');if(body){var top=detail.offsetTop-body.offsetTop+body.scrollTop;body.scrollTo({top:Math.max(0,top-8),behavior:'smooth'});}else{detail.scrollIntoView({block:'nearest',behavior:'smooth'});}},60);
 }
 overlay.querySelectorAll('[data-lesson]').forEach(function(btn){
   btn.addEventListener('click',function(){selectLesson(Number(btn.getAttribute('data-lesson')));});
 });
 var closeBtn=document.getElementById('mgV11WelcomeClose');
 if(closeBtn)closeBtn.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();close(true);});
 var start=document.getElementById('mgV11StartBtn');
 if(start)start.addEventListener('click',function(){close(true);});
 var tutorial=document.getElementById('mgV11TutorialBtn');
 if(tutorial)tutorial.addEventListener('click',function(){selectLesson(0);});
 var voiceBtn=document.getElementById('mgV11VoiceBtn');
 if(voiceBtn)voiceBtn.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();if(voicePlayed){try{localStorage.removeItem(KEY+'_voice')}catch(err){}voicePlayed=false;}voiceBusy=false;playWelcomeVoice();if(!voiceBusy&&!voicePlayed){setTimeout(function(){if(!voiceBusy&&!voicePlayed)speakFallback();},350);}});
 overlay.addEventListener('click',function(e){if(e.target===overlay)close(true);});
 function firstLaunch(){var seen=false;try{seen=localStorage.getItem(KEY)==='1';}catch(e){seen=false;}if(!seen)open();}
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(firstLaunch,650);},{once:true});else setTimeout(firstLaunch,650);
 window.miladGeoOpenTutorialV11=open;
})();
</script>
<style id="mg-v16-card-sounds-style">
#main .miladgeo-lang-panel .mg-card-sound-option{grid-column:1/-1;min-height:42px;white-space:normal;line-height:1.45;font:700 13px Tahoma,Arial,sans-serif}
#main .miladgeo-lang-panel .mg-card-sound-option[aria-pressed="true"]{outline:2px solid #245d32!important;border:2px solid #245d32!important;background:#dcebd9!important;box-shadow:inset 0 0 0 1px #fff!important}
#main .miladgeo-lang-panel .mg-card-sound-note{grid-column:1/-1;text-align:center;font:11px Tahoma,Arial,sans-serif;line-height:1.8;color:#435346;padding:3px 5px}
</style>
<script id="mg-v16-card-sounds-runtime">
(function(){
 'use strict';
 var KEY='miladgeo_card_touch_sound_v1';
 var VALID=['off','soft','bright'];
 function selected(){try{var v=localStorage.getItem(KEY)||'off';return VALID.indexOf(v)>=0?v:'off';}catch(e){return 'off';}}
 function save(v){if(VALID.indexOf(v)<0)v='off';try{localStorage.setItem(KEY,v);}catch(e){}refreshButtons();}
 function play(v){
  if(v==='off')return;
  try{
   var AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;
   var ctx=window.__mgCardTouchAudio;if(!ctx){ctx=new AC();window.__mgCardTouchAudio=ctx;}
   var begin=function(){var t=ctx.currentTime;
    function note(freq,delay,duration,volume,wave){var o=ctx.createOscillator(),g=ctx.createGain();o.type=wave;o.frequency.setValueAtTime(freq,t+delay);g.gain.setValueAtTime(.0001,t+delay);g.gain.exponentialRampToValueAtTime(volume,t+delay+.01);g.gain.exponentialRampToValueAtTime(.0001,t+delay+duration);o.connect(g);g.connect(ctx.destination);o.start(t+delay);o.stop(t+delay+duration+.02);}
    if(v==='soft')note(660,0,.075,.035,'sine');
    if(v==='bright'){note(880,0,.055,.032,'triangle');note(1175,.05,.075,.028,'sine');}
   };
   if(ctx.state==='suspended'){var p=ctx.resume();if(p&&p.then)p.then(begin).catch(function(){});else begin();}else begin();
  }catch(e){}
 }
 function refreshButtons(){var panel=document.querySelector('#main .miladgeo-lang-panel');if(!panel)return;var v=selected();panel.querySelectorAll('[data-mg-card-sound]').forEach(function(b){b.setAttribute('aria-pressed',b.getAttribute('data-mg-card-sound')===v?'true':'false');});}
 function addControls(){
  var panel=document.querySelector('#main .miladgeo-lang-panel');if(!panel||panel.querySelector('[data-mg-card-sound]'))return;
  var h=document.createElement('div');h.className='mg-theme-heading';h.textContent='صدای لمس کارت‌های منو';panel.appendChild(h);
  var note=document.createElement('div');note.className='mg-card-sound-note';note.textContent='حالت پیش‌فرض بی‌صدا است. برای شنیدن نمونه، یکی از دو صدا را انتخاب کن.';panel.appendChild(note);
  [{id:'off',label:'🔇 بدون صدا'},{id:'soft',label:'🔉 صدای ۱ · ملایم'},{id:'bright',label:'🔔 صدای ۲ · شفاف'}].forEach(function(x){
   var b=document.createElement('button');b.type='button';b.className='mg-card-sound-option';b.textContent=x.label;b.setAttribute('data-mg-card-sound',x.id);b.setAttribute('aria-pressed','false');
   b.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();save(x.id);if(x.id!=='off')play(x.id);});panel.appendChild(b);
  });
  refreshButtons();
 }
 function bind(){
  if(document.documentElement.dataset.mgCardTouchSoundBound==='1')return;
  document.documentElement.dataset.mgCardTouchSoundBound='1';
  document.addEventListener('click',function(e){
   var target=e.target;
   if(!target||!target.closest)return;
   /* Apply the chosen touch sound to main-menu cards and all nested submenu cards,
      tabs, options and action buttons, including dynamically-created panels. */
   if(target.closest('[data-mg-card-sound]'))return;
   var item=target.closest('button,a,[role="button"],.menu-btn,.card,[class*="-card"],[class*="-option"],[class*="-tab"],[class*="-tool"],[class*="-action"]');
   if(!item)return;
   if(item.disabled||item.getAttribute('aria-disabled')==='true')return;
   if(item.matches('input,select,textarea,label'))return;
   play(selected());
  },true);
 }
 function init(){addControls();bind();refreshButtons();}
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
 if(window.MutationObserver){var mo=new MutationObserver(function(){addControls();bind();});mo.observe(document.documentElement,{childList:true,subtree:true});}
})();
</script>
<!-- MILADGEO CUSTOM MENU ARTWORK — generated specifically for menus 1, 5, 7, 10, 12 and 17; fully offline -->
<style id="miladgeo-custom-menu-artwork-20261114-style">
#main .menu-grid>.menu-btn .mg-menu-tutorial-image{pointer-events:none!important;user-select:none;-webkit-user-drag:none;
  display:none;width:100%;height:96px!important;flex:0 0 96px!important;
  object-fit:cover;object-position:center;border-radius:10px;
  border:1px solid rgba(35,70,38,.4);background:#17251b;
  box-shadow:0 2px 7px rgba(0,0,0,.18)
}
#main.mg-image-menu .menu-grid>.menu-btn .mg-menu-tutorial-image{display:block}
@media(max-width:420px){
  #main .menu-grid>.menu-btn .mg-menu-tutorial-image{pointer-events:none!important;user-select:none;-webkit-user-drag:none;height:88px!important;flex-basis:88px!important}
}
/* Native menu numbering remains visible; artwork contains no menu numbers. */
</style>
<script id="miladgeo-custom-menu-artwork-20261114-runtime">
(function(){
 'use strict';
 var ART={
    1: {alt:"دوربین توتال استیشن لایکا",src:"data:image/jpeg;base64,"},
    5: {alt:"TXT و برداشت نقاط؛ تصویر مرجع نسخه ۲۶",src:"data:image/jpeg;base64,"},
    7: {alt:"محاسبه مساحت زمین و چندضلعی",src:"data:image/jpeg;base64,"},
    10: {alt:"نماد PDF و چاپ نقشه",src:"data:image/jpeg;base64,"},
    12: {alt:"تبدیل واحدها؛ تصویر مرجع نسخه ۲۶",src:"data:image/jpeg;base64,"},
    17: {alt:"Google Earth و کره زمین",src:"data:image/jpeg;base64,"}
 };
 function apply(){
  var main=document.getElementById('main');
  var grid=main&&main.querySelector('.menu-grid');
  if(!main||!grid)return;
  var buttons=grid.querySelectorAll(':scope > .menu-btn');
  Object.keys(ART).forEach(function(key){
   var menu=Number(key),btn=buttons[menu-1],item=ART[key];
   if(!btn)return;
   var img=btn.querySelector('.mg-menu-tutorial-image');
   if(!img){
    img=document.createElement('img');
    img.className='mg-menu-tutorial-image';
    var number=btn.querySelector('.menu-num');
    btn.insertBefore(img,number||btn.firstChild);
   }
   img.removeAttribute('srcset');
   img.removeAttribute('sizes');
   img.src=item.src;
   img.alt=item.alt;
   img.loading='eager';
   img.decoding='async';
   img.setAttribute('data-mg-custom-art','1');
   btn.setAttribute('data-mg-menu-visual',String(menu));
   btn.removeAttribute('data-mg-menu-art-number');
   var tag=btn.querySelector('.mg-menu-image-tag');
   if(tag)tag.remove();
  });
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',apply,{once:true});
 else apply();
})();
</script>
<!-- V24: menu artwork imported from Indexxx23; images are click-through safe -->
<style id="miladgeo-v24-menu-image-touch-fix">
#main .menu-grid>.menu-btn .mg-menu-tutorial-image{pointer-events:none!important;touch-action:none!important}
#main .menu-grid>.menu-btn{touch-action:manipulation}
</style>
<style id="miladgeo-job-card-refresh-safe-v301">
/* Safe visual-only refresh: no overlays, no pointer interception, no layout clipping */
